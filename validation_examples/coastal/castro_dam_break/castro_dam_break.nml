! Castro et al. (2011) circular dam break benchmark
! Domain: [-5, 5] x [-5, 5], Gaussian bump bathymetry
! IC: circular water column (r <= 0.6: eta=3, r > 0.6: eta=1)
! No friction, wall BCs, t_end = 1.0 s
!
! Override nx/ny for different resolutions:
!   100x100   (dx = 0.1)
!   200x200   (dx = 0.05)
!   400x400   (dx = 0.025)
!   800x800   (dx = 0.0125)
!   1600x1600 (dx = 0.00625)
!   2000x2000 (dx = 0.005)

&grid_nml
  nx = 200
  ny = 200
  dx = 0.05
  dy = 0.05
  nghost = 2
/

&time_nml
  t_end = 0.5
  cfl = 0.9
  dt_max = 1.0
/

&physics_nml
  manning_n = 0.0
  dry_threshold = 1.0e-6
  wind_stress_x = 0.0
  wind_stress_y = 0.0
/

&output_nml
  output_to_file = .false.
  output_dir = "./output"
  output_interval = 0.0
/

&boundary_nml
  bc_west  = "wall"
  bc_east  = "wall"
  bc_south = "wall"
  bc_north = "wall"
/

&initial_condition_nml
  init_condition = "castro_dam_break"
/

&logging_nml
  log_level = "info"
  status_interval = 0.1
/
