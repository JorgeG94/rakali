tmp_local_artifacts/

test*.nml
*.gif
_deps/*
CMakeFiles/*
benchmarks/CMakeFiles/*
tests/CMakeFiles/*
tests/generated/*
local_docs/*
examples/tasman_validation/make_bathy.py

# --- Local scratch (keeps `git add -A` from sweeping it into a commit) ---
# Deliberately conservative: only UNAMBIGUOUS throwaway.  Pending work that
# might still be committed (docs/ plans, examples/, validation_examples/,
# tools/) is intentionally NOT ignored -- the no-bulk-adds hook guards those.
out_*/
local_archive/
local_mres/
myenv/
my_output
.vscode/
Testing/
*.mp4
*.npz
