# Prerequisites
*.d
*.log
*.nc
*.png
build/*
build_validate/*
# CMake build trees (gfortran CPU, NVHPC GPU, per-toolchain scratch builds)
another_build/
*_build/
# Build-dir NAMING RULE (2026-07-27, post git-store corruption): new build
# trees must be named `build_<toolchain>` (build_serial, build_cc90, ...).
# `build*/` + `*_build/` together cover both the rule and the legacy names;
# an unignored build tree in a `git add -A` is how the object store got
# poisoned.  non_mpi/ was the other stray.
build*/
non_mpi/
nvhpc_*/
*.nsys-rep
*.sqlite
*output*/*
*.dat
*.csv
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Python
__pycache__/
*.pyc
*.egg-info/

# Jupyter — chapters are tracked as Jupytext-paired .md files; the .ipynb
# renders and checkpoint dirs are regenerated locally on demand
# (jupytext --sync */chapter.md).
*.ipynb
.ipynb_checkpoints/

# Mac os
.DS_Store

# Claude
.claude/

# Local/throwaway artifacts (prototypes, scratch scripts, generated data,
