 c , s , cnt real ( wp ) :: inv_nsub inv_nsub = 1.0_wp / real ( nsub , wp ) do concurrent ( c = 1 : nco ) local ( s , cnt ) cnt = 0 do s = 1 , nsub if ( eta ( c ) >= b_sub ( s , c )) cnt = cnt + 1 end do a_cell ( c ) = real ( cnt , wp ) * inv_nsub end do end subroutine si_unstr_wetdry_wetfrac","tags":"","url":"proc/si_unstr_wetdry_wetfrac.html"},{"title":"delaunay_diag_bl_tr – Rakali","text":"private pure function delaunay_diag_bl_tr(xbl, ybl, xbr, ybr, xtr, ytr, xtl, ytl) result(use_bl_tr) In-circle test choosing the Delaunay diagonal of the quad\n(bl, br, tr, tl) CCW.  Returns .true. to split along bl–tr (the\ndiagonal that keeps both triangles Delaunay), .false. for br–tl. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: xbl real(kind=wp), intent(in) :: ybl real(kind=wp), intent(in) :: xbr real(kind=wp), intent(in) :: ybr real(kind=wp), intent(in) :: xtr real(kind=wp), intent(in) :: ytr real(kind=wp), intent(in) :: xtl real(kind=wp), intent(in) :: ytl Return Value logical Called by proc~~delaunay_diag_bl_tr~~CalledByGraph proc~delaunay_diag_bl_tr delaunay_diag_bl_tr proc~gen_delaunay_triangulation gen_delaunay_triangulation proc~gen_delaunay_triangulation->proc~delaunay_diag_bl_tr proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~gen_delaunay_triangulation proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: ax real(kind=wp), private :: ay real(kind=wp), private :: bx real(kind=wp), private :: by real(kind=wp), private :: cx real(kind=wp), private :: cy real(kind=wp), private :: incirc Source Code pure function delaunay_diag_bl_tr ( xbl , ybl , xbr , ybr , xtr , ytr , xtl , ytl ) & result ( use_bl_tr ) !! In-circle test choosing the Delaunay diagonal of the quad !! (bl, br, tr, tl) CCW.  Returns .true. to split along bl--tr (the !! diagonal that keeps both triangles Delaunay), .false. for br--tl. real ( wp ), intent ( in ) :: xbl , ybl , xbr , ybr , xtr , ytr , xtl , ytl logical :: use_bl_tr real ( wp ) :: ax , ay , bx , by , cx , cy , incirc ax = xbl - xtl ay = ybl - ytl bx = xbr - xtl by = ybr - ytl cx = xtr - xtl cy = ytr - ytl incirc = ( ax * ax + ay * ay ) * ( bx * cy - cx * by ) & - ( bx * bx + by * by ) * ( ax * cy - cx * ay ) & + ( cx * cx + cy * cy ) * ( ax * by - bx * ay ) ! (bl,br,tr) CCW => incirc > 0 means tl is inside the circumcircle => ! flip to br--tl; else keep bl--tr. use_bl_tr = ( incirc <= 0.0_wp ) end function delaunay_diag_bl_tr","tags":"","url":"proc/delaunay_diag_bl_tr.html"},{"title":"hash01 – Rakali","text":"private pure function hash01(i, j, s) result(r) Deterministic pseudo-random value in [0,1) from a 3-integer key. Arguments Type Intent Optional Attributes Name integer, intent(in) :: i integer, intent(in) :: j integer, intent(in) :: s Return Value real(kind=wp) Called by proc~~hash01~~CalledByGraph proc~hash01 hash01 proc~gen_delaunay_triangulation gen_delaunay_triangulation proc~gen_delaunay_triangulation->proc~hash01 proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~gen_delaunay_triangulation proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=8), private :: h Source Code pure function hash01 ( i , j , s ) result ( r ) !! Deterministic pseudo-random value in [0,1) from a 3-integer key. integer , intent ( in ) :: i , j , s real ( wp ) :: r integer ( kind = 8 ) :: h h = int ( i , 8 ) * 73856093_8 + int ( j , 8 ) * 19349663_8 + int ( s , 8 ) * 83492791_8 h = iand ( h , 2147483647_8 ) r = real ( modulo ( h , 100003_8 ), wp ) / 10000 3.0_wp end function hash01","tags":"","url":"proc/hash01.html"},{"title":"gen_delaunay_triangulation – Rakali","text":"public  subroutine gen_delaunay_triangulation(nx, ny, lx, ly, vert_x, vert_y, tri_v) Acute-Delaunay variant of gen_regular_triangulation for the\nsemi-implicit (TPFA) path.  The plain right-triangle split puts\neach circumcentre ON the shared hypotenuse midpoint — the two\ntriangles of a quad get COINCIDENT circumcentres, edge_delta = 0 ,\nand the SI mesh-quality gate rightly rejects the mesh.  Here the\ninterior vertices are jittered (deterministic hash — reproducible)\nand each quad is split along its locally-Delaunay diagonal\n(in-circle test), so circumcentres sit strictly inside the acute\ntriangles and edge_delta > 0 everywhere.  Boundary vertices stay\nON the box so the domain is exactly rectangular for the wall BC. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx Number of cells in x / y (>= 1). integer, intent(in) :: ny Number of cells in x / y (>= 1). real(kind=wp), intent(in) :: lx Domain extents in x / y (m). real(kind=wp), intent(in) :: ly Domain extents in x / y (m). real(kind=wp), intent(out), allocatable :: vert_x (:) real(kind=wp), intent(out), allocatable :: vert_y (:) integer, intent(out), allocatable :: tri_v (:,:) Triangle connectivity, shape (3, 2 nx ny); 1-based vertex ids. Calls proc~~gen_delaunay_triangulation~~CallsGraph proc~gen_delaunay_triangulation gen_delaunay_triangulation proc~delaunay_diag_bl_tr delaunay_diag_bl_tr proc~gen_delaunay_triangulation->proc~delaunay_diag_bl_tr proc~hash01 hash01 proc~gen_delaunay_triangulation->proc~hash01 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~gen_delaunay_triangulation~~CalledByGraph proc~gen_delaunay_triangulation gen_delaunay_triangulation proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~gen_delaunay_triangulation proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: JIT = 0.28_wp real(kind=wp), private :: dx real(kind=wp), private :: dy integer, private :: i integer, private :: j real(kind=wp), private :: jx real(kind=wp), private :: jy integer, private :: ntri integer, private :: nverts integer, private :: tid integer, private :: v00 integer, private :: v01 integer, private :: v10 integer, private :: v11 integer, private :: vid Source Code subroutine gen_delaunay_triangulation ( nx , ny , lx , ly , vert_x , vert_y , tri_v ) !! Acute-Delaunay variant of `gen_regular_triangulation` for the !! semi-implicit (TPFA) path.  The plain right-triangle split puts !! each circumcentre ON the shared hypotenuse midpoint — the two !! triangles of a quad get COINCIDENT circumcentres, `edge_delta = 0`, !! and the SI mesh-quality gate rightly rejects the mesh.  Here the !! interior vertices are jittered (deterministic hash — reproducible) !! and each quad is split along its locally-Delaunay diagonal !! (in-circle test), so circumcentres sit strictly inside the acute !! triangles and `edge_delta > 0` everywhere.  Boundary vertices stay !! ON the box so the domain is exactly rectangular for the wall BC. integer , intent ( in ) :: nx , ny !! Number of cells in x / y (>= 1). real ( wp ), intent ( in ) :: lx , ly !! Domain extents in x / y (m). real ( wp ), allocatable , intent ( out ) :: vert_x (:), vert_y (:) integer , allocatable , intent ( out ) :: tri_v (:, :) !! Triangle connectivity, shape (3, 2*nx*ny); 1-based vertex ids. real ( wp ), parameter :: JIT = 0.28_wp integer :: nverts , ntri , i , j , vid , tid integer :: v00 , v10 , v01 , v11 real ( wp ) :: dx , dy , jx , jy nverts = ( nx + 1 ) * ( ny + 1 ) ntri = 2 * nx * ny allocate ( vert_x ( nverts ), vert_y ( nverts )) allocate ( tri_v ( 3 , ntri )) dx = lx / real ( nx , wp ) dy = ly / real ( ny , wp ) do j = 0 , ny do i = 0 , nx vid = j * ( nx + 1 ) + i + 1 jx = 0.0_wp jy = 0.0_wp ! Jitter interior vertices only (keep the boundary on the box). if ( i > 0 . and . i < nx ) jx = JIT * dx * ( hash01 ( i , j , 1 ) - 0.5_wp ) if ( j > 0 . and . j < ny ) jy = JIT * dy * ( hash01 ( i , j , 2 ) - 0.5_wp ) vert_x ( vid ) = real ( i , wp ) * dx + jx vert_y ( vid ) = real ( j , wp ) * dy + jy end do end do tid = 0 do j = 0 , ny - 1 do i = 0 , nx - 1 v00 = j * ( nx + 1 ) + i + 1 ! (i,   j)   bl v10 = j * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j)   br v01 = ( j + 1 ) * ( nx + 1 ) + i + 1 ! (i,   j+1) tl v11 = ( j + 1 ) * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j+1) tr if ( delaunay_diag_bl_tr ( vert_x ( v00 ), vert_y ( v00 ), & vert_x ( v10 ), vert_y ( v10 ), & vert_x ( v11 ), vert_y ( v11 ), & vert_x ( v01 ), vert_y ( v01 ))) then tid = tid + 1 tri_v (:, tid ) = [ v00 , v10 , v11 ] tid = tid + 1 tri_v (:, tid ) = [ v00 , v11 , v01 ] else tid = tid + 1 tri_v (:, tid ) = [ v00 , v10 , v01 ] tid = tid + 1 tri_v (:, tid ) = [ v10 , v11 , v01 ] end if end do end do end subroutine gen_delaunay_triangulation","tags":"","url":"proc/gen_delaunay_triangulation.html"},{"title":"gen_regular_triangulation – Rakali","text":"public  subroutine gen_regular_triangulation(nx, ny, lx, ly, vert_x, vert_y, tri_v) Regular rectangular triangulation of [0,lx] x [0,ly]: an\n(nx+1) x (ny+1) vertex grid, each quad split into two CCW\ntriangles (a lower (v00,v10,v01) + an upper (v10,v11,v01)).\nYields (nx+1)(ny+1) vertices and 2 nx ny triangles.  Vertices are\nnumbered row-major (i fastest); the triangulation tiles the\nrectangle exactly with positively-oriented triangles. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx Number of cells in x / y (>= 1). integer, intent(in) :: ny Number of cells in x / y (>= 1). real(kind=wp), intent(in) :: lx Domain extents in x / y (m). real(kind=wp), intent(in) :: ly Domain extents in x / y (m). real(kind=wp), intent(out), allocatable :: vert_x (:) real(kind=wp), intent(out), allocatable :: vert_y (:) integer, intent(out), allocatable :: tri_v (:,:) Triangle connectivity, shape (3, 2 nx ny); 1-based vertex ids. Called by proc~~gen_regular_triangulation~~CalledByGraph proc~gen_regular_triangulation gen_regular_triangulation proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~gen_regular_triangulation proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dx real(kind=wp), private :: dy integer, private :: i integer, private :: j integer, private :: ntri integer, private :: nverts integer, private :: tid integer, private :: v00 integer, private :: v01 integer, private :: v10 integer, private :: v11 integer, private :: vid Source Code subroutine gen_regular_triangulation ( nx , ny , lx , ly , vert_x , vert_y , tri_v ) !! Regular rectangular triangulation of [0,lx] x [0,ly]: an !! (nx+1) x (ny+1) vertex grid, each quad split into two CCW !! triangles (a lower (v00,v10,v01) + an upper (v10,v11,v01)). !! Yields (nx+1)(ny+1) vertices and 2*nx*ny triangles.  Vertices are !! numbered row-major (i fastest); the triangulation tiles the !! rectangle exactly with positively-oriented triangles. integer , intent ( in ) :: nx , ny !! Number of cells in x / y (>= 1). real ( wp ), intent ( in ) :: lx , ly !! Domain extents in x / y (m). real ( wp ), allocatable , intent ( out ) :: vert_x (:), vert_y (:) integer , allocatable , intent ( out ) :: tri_v (:, :) !! Triangle connectivity, shape (3, 2*nx*ny); 1-based vertex ids. integer :: nverts , ntri integer :: i , j , vid , tid integer :: v00 , v10 , v01 , v11 real ( wp ) :: dx , dy nverts = ( nx + 1 ) * ( ny + 1 ) ntri = 2 * nx * ny allocate ( vert_x ( nverts ), vert_y ( nverts )) allocate ( tri_v ( 3 , ntri )) dx = lx / real ( nx , wp ) dy = ly / real ( ny , wp ) ! Vertices: row-major, i fastest.  vid(i,j) = j*(nx+1) + i + 1. do j = 0 , ny do i = 0 , nx vid = j * ( nx + 1 ) + i + 1 vert_x ( vid ) = real ( i , wp ) * dx vert_y ( vid ) = real ( j , wp ) * dy end do end do ! Each quad -> two CCW triangles. tid = 0 do j = 0 , ny - 1 do i = 0 , nx - 1 v00 = j * ( nx + 1 ) + i + 1 ! (i,   j) v10 = j * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j) v01 = ( j + 1 ) * ( nx + 1 ) + i + 1 ! (i,   j+1) v11 = ( j + 1 ) * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j+1) tid = tid + 1 tri_v ( 1 , tid ) = v00 tri_v ( 2 , tid ) = v10 tri_v ( 3 , tid ) = v01 tid = tid + 1 tri_v ( 1 , tid ) = v10 tri_v ( 2 , tid ) = v11 tri_v ( 3 , tid ) = v01 end do end do end subroutine gen_regular_triangulation","tags":"","url":"proc/gen_regular_triangulation.html"},{"title":"ml_vertical_viscosity – Rakali","text":"public pure subroutine ml_vertical_viscosity(h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, grid, nz, dt) Ri-dependent vertical viscosity for momentum (Pacanowski-Philander 1981).\nComputes gradient Richardson number at each interface and applies\nturbulent diffusive