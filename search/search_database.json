ion a. !! V convex => plain Newton converges monotonically (no line search). !! !! The FROZEN-Hf step (rules R1-R5): !!   0. fill b_sub/b_min from bed; save U&#94;n; eta&#94;n = stage; !!   1. freeze Hf by the gated-mean/sill rule (+ Dirichlet ghost); !!   2. edge predictor U* (dead edges => exactly 0; U&#94;n zeroed on dead !!      edges — R3 is STRUCTURAL here: the RHS consumes per-edge !!      transports directly, so no reconstruction masking is needed); !!   3. rhs_d = v(eta&#94;n) - dt*div[theta*U* + (1-theta)*U&#94;n] (+ ghost); !!   4. Newton: a,v,F at eta&#94;k; converged (frozen active set + small !!      residual)? else CG-solve J*dz = -F from zero, eta += dz !!      (dry cells settle below bed — never clamped); !!   5. back-sub with the SAME frozen Hf (R2); !!   6. stage = eta; h = max(eta - b, 0); cell momenta. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct , nco , n_bc real ( wp ), intent ( in ) :: dt , theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt integer , intent ( out ) :: iter_out !! Inner CG iterations summed over the Newton outers. integer :: k , i , kn , nit , cg_it , cg_it_total , wetcount , wetcount_prev real ( wp ) :: inv_delta , dgdn , tau_n real ( wp ) :: rhs2 , f2 , tol2 , mass_res logical :: converged associate ( si => state % si , baro => state % barotropic ) ! ---- 0. Sub-bottom table; save U&#94;n; eta&#94;n = stage; height ---- call si_unstr_wetdry_fill_bsub ( mesh , si % n_sub , nct , nco , baro % bed_cv , & si % bsub_fill , si % b_sub , si % b_min ) do concurrent ( k = 1 : nco ) local ( i ) do i = 1 , EDGES_PER_TRI si % u_n_edge ( i , k ) = si % u_edge ( i , k ) end do baro % height_cv ( k ) = max ( baro % stage_cv ( k ) - baro % bed_cv ( k ), 0.0_wp ) si % eta ( k ) = baro % stage_cv ( k ) end do ! ---- 1. Freeze Hf (gated-mean/sill rule) + Dirichlet ghost ---- call si_unstr_wetdry_face_depths ( mesh , nct , nco , n_bc , si % eta , & si % b_min , state % bc_type , & state % bc_eta_ext , si % Hf_edge , & si % eta_ghost_edge ) ! ---- 2. EDGE predictor (dead edges => exactly 0) + wind (R3) ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn , tau_n ) do i = 1 , EDGES_PER_TRI if ( si % Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta_ghost_edge ( i , k ), inv_delta ) end if tau_n = ( baro % wind_tau_x * mesh % edge_n1 ( i , k ) & + baro % wind_tau_y * mesh % edge_n2 ( i , k )) / RHO_WATER si % u_star ( i , k ) = si % u_n_edge ( i , k ) - g_omtheta_dt * dgdn & + dt * tau_n else si % u_star ( i , k ) = 0.0_wp si % u_n_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 3. rhs_d = v(eta&#94;n) - dt*div[blend] (+ Dirichlet fold) ---- ! Reuse the linear RHS (leading eta&#94;n + ghost fold via the frozen ! Hf) then swap the leading term for v(eta&#94;n). call si_unstr_compute_rhs ( mesh , nct , nco , si % eta , si % u_star , & si % u_n_edge , si % eta_r , dt , theta , & si % Hf_edge , si % eta_ghost_edge , g_theta2_dt2 ) call si_unstr_wetdry_volume ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % v_cell ) do concurrent ( k = 1 : nco ) si % rhs_d ( k ) = si % eta_r ( k ) + ( si % v_cell ( k ) - si % eta ( k )) end do ! ---- 4. Newton outer loop ---- rhs2 = 0.0_wp do concurrent ( k = 1 : nco ) reduce ( + : rhs2 ) rhs2 = rhs2 + si % rhs_d ( k ) * si % rhs_d ( k ) end do tol2 = max ( SI_UNSTR_NEWTON_TOL * SI_UNSTR_NEWTON_TOL * rhs2 , 1.0e-60_wp ) cg_it_total = 0 cg_it = 0 mass_res = 0.0_wp wetcount_prev = - 1 converged = . false . do nit = 1 , SI_UNSTR_NEWTON_MAX call si_unstr_wetdry_wetfrac ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % a_wet ) call si_unstr_wetdry_volume ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % v_cell ) call si_unstr_wetdry_mass_diag ( nct , nco , si % a_wet , si % Hf_edge , & si % mass_diag ) call si_unstr_apply_helmholtz ( mesh , nct , nco , si % eta , si % newton_Jeta , & si % Hf_edge , g_theta2_dt2 , & mass_diag = si % mass_diag ) call si_unstr_wetdry_newton_residual ( nct , nco , si % eta , si % newton_Jeta , & si % mass_diag , si % v_cell , & si % rhs_d , si % newton_F , f2 ) call si_unstr_wetdry_wetcount ( si % n_sub , nct , nco , si % eta , si % b_sub , & wetcount ) if ( nit > 1 . and . wetcount == wetcount_prev . and . f2 < tol2 ) then converged = . true . exit end if wetcount_prev = wetcount ! Solve J*dz = -F from zero (full-array zero so the ghost band ! of the search space stays 0); eta += dz. do concurrent ( k = 1 : nct ) si % newton_dz ( k ) = 0.0_wp end do do concurrent ( k = 1 : nco ) si % eta_r ( k ) = - si % newton_F ( k ) end do call si_unstr_cg_solve ( mesh , nct , nco , si % newton_dz , si % eta_r , & si % eta_p , si % eta_Ap , si % eta_z , si % eta_diag , & si % Hf_edge , g_theta2_dt2 , si % precond , & si % rtol , cg_it , mass_res , & mass_diag = si % mass_diag ) cg_it_total = cg_it_total + cg_it do concurrent ( k = 1 : nco ) si % eta ( k ) = si % eta ( k ) + si % newton_dz ( k ) end do end do si % newton_iters = min ( nit , SI_UNSTR_NEWTON_MAX ) si % mass_res = mass_res if (. not . converged ) then call global_logger % warning ( \"si_unstr_advance_wetdry: Newton did \" // & \"not converge in the iteration cap; last ||F||&#94;2 above tol.\" ) end if ! ---- 5. EDGE back-substitution with the SAME frozen Hf (R2) ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn ) do i = 1 , EDGES_PER_TRI if ( si % Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta_ghost_edge ( i , k ), inv_delta ) end if si % u_edge ( i , k ) = si % u_star ( i , k ) - gtheta_dt * dgdn else si % u_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 6. Cell momenta + thickness (dry cells clamp h to 0) ---- call si_unstr_reconstruct_cell_momenta ( mesh , nct , nco , si % u_edge , & baro % xmom_cv , baro % ymom_cv ) do concurrent ( k = 1 : nco ) baro % stage_cv ( k ) = si % eta ( k ) baro % height_cv ( k ) = max ( si % eta ( k ) - baro % bed_cv ( k ), 0.0_wp ) end do end associate iter_out = cg_it_total end subroutine si_unstr_advance_wetdry","tags":"","url":"proc/si_unstr_advance_wetdry.html"},{"title":"si_unstr_advect_tracer_dsig – Rakali","text":"public pure subroutine si_unstr_advect_tracer_dsig(mesh, nz, nct, nco, n_bc, dsig, h_layer, mass_flux_edge, tr_bc_ext, hTr_old, hTr, dt) Depth-proportional, race-free, first-order-upwind tracer advection\nfor the sigma SI path — the structured si_ml_advect_tracer_dsig ,\nedge-wise (cell-centric double-visit).  The per-layer edge flux is\nEXACTLY dsig_k * mass_flux_e * len_e * T_upwind — the only split\nconsistent with the dsig-slaved thickness update, so a uniform\ntracer stays uniform PER LAYER to CG tolerance and total tracer is\nconserved to round-off (interior edge fluxes are bit-exactly\nantisymmetric between the two visits; dead edges carry 0). Upwind values read the PRE-STEP snapshot hTr_old + the pre-update h_layer ONLY (no read-neighbour/write-own hazard — the explicit\npath’s in-place update leaks conservation on sequential backends at\nSI step sizes).  Outflow (flux > 0, leaving the cell) upwinds the\nOWN cell; inflow through a Dirichlet boundary edge carries the\nper-group external tracer tr_bc_ext(group) (the clamped-inflow\nconvention of the explicit unstructured path). FLAT-IMPL for the registry outer shim: hTr_old / hTr are plain\nexplicit-shape arrays — the step module loops tracers(:) on the\nhost and passes tracers(it)%hTr etc. (array-of-derived-types\ndevice rule). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz Number of layers. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. integer, intent(in) :: n_bc BC group table size. real(kind=wp), intent(in) :: dsig (nz) Sigma layer fractions. real(kind=wp), intent(in) :: h_layer (nz,nct) PRE-update layer thicknesses (time n) — upwind T denominators. real(kind=wp), intent(in) :: mass_flux_edge (EDGES_PER_TRI,nct) Blended column edge flux [m&#94;2/s], + outward. real(kind=wp), intent(in) :: tr_bc_ext (n_bc) Per-group external tracer value for Dirichlet inflow. real(kind=wp), intent(in) :: hTr_old (nz,nct) Pre-step tracer snapshot (upwind source; never written here). real(kind=wp), intent(inout) :: hTr (nz,nct) Tracer field updated in place (each cell writes only itself). real(kind=wp), intent(in) :: dt Calls proc~~si_unstr_advect_tracer_dsig~~CallsGraph proc~si_unstr_advect_tracer_dsig si_unstr_advect_tracer_dsig local local proc~si_unstr_advect_tracer_dsig->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_advect_tracer_dsig~~CalledByGraph proc~si_unstr_advect_tracer_dsig si_unstr_advect_tracer_dsig proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_advect_tracer_dsig proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c real(kind=wp), private :: div_sum real(kind=wp), private :: flux_c integer, private :: g real(kind=wp), private :: h_dn real(kind=wp), private :: h_up integer, private :: i real(kind=wp), private :: inv_area integer, private :: k integer, private :: kn real(kind=wp), private :: tr_up Source Code pure subroutine si_unstr_advect_tracer_dsig ( mesh , nz , nct , nco , n_bc , dsig , & h_layer , mass_flux_edge , & tr_bc_ext , hTr_old , hTr , dt ) !! Depth-proportional, race-free, first-order-upwind tracer advection !! for the sigma SI path — the structured `si_ml_advect_tracer_dsig`, !! edge-wise (cell-centric double-visit).  The per-layer edge flux is !! EXACTLY `dsig_k * mass_flux_e * len_e * T_upwind` — the only split !! consistent with the dsig-slaved thickness update, so a uniform !! tracer stays uniform PER LAYER to CG tolerance and total tracer is !! conserved to round-off (interior edge fluxes are bit-exactly !! antisymmetric between the two visits; dead edges carry 0). !! !! Upwind values read the PRE-STEP snapshot `hTr_old` + the pre-update !! `h_layer` ONLY (no read-neighbour/write-own hazard — the explicit !! path's in-place update leaks conservation on sequential backends at !! SI step sizes).  Outflow (flux > 0, leaving the cell) upwinds the !! OWN cell; inflow through a Dirichlet boundary edge carries the !! per-group external tracer `tr_bc_ext(group)` (the clamped-inflow !! convention of the explicit unstructured path). !! !! FLAT-IMPL for the registry outer shim: `hTr_old`/`hTr` are plain !! explicit-shape arrays — the step module loops `tracers(:)` on the !! host and passes `tracers(it)%hTr` etc. (array-of-derived-types !! device rule). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size. real ( wp ), intent ( in ) :: dsig ( nz ) !! Sigma layer fractions. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! PRE-update layer thicknesses (time n) — upwind T denominators. real ( wp ), intent ( in ) :: mass_flux_edge ( EDGES_PER_TRI , nct ) !! Blended column edge flux [m&#94;2/s], + outward. real ( wp ), intent ( in ) :: tr_bc_ext ( n_bc ) !! Per-group external tracer value for Dirichlet inflow. real ( wp ), intent ( in ) :: hTr_old ( nz , nct ) !! Pre-step tracer snapshot (upwind source; never written here). real ( wp ), intent ( inout ) :: hTr ( nz , nct ) !! Tracer field updated in place (each cell writes only itself). real ( wp ), intent ( in ) :: dt integer :: c , i , k , kn , g real ( wp ) :: flux_c , tr_up , h_up , h_dn , div_sum , inv_area ! WET-SIDE FALLBACK at dry edges (the Q8 ML+wet/dry front lesson): a ! freshly-flooded edge can carry a transient REVERSED theta-blend flux ! whose upwind layer was EMPTY at time n (the just-wetted cell sloshing ! back).  A bare tr_up = 0 there moves real water with no tracer — ! measured ~1.7 PSU freshening over a flood tide.  When the upwind ! layer is empty the water physically originates from the SAME-step ! inflow off the wet side, so the DOWNWIND side's concentration is the ! consistent value.  Both double-visits of the edge then read the SAME ! (wet-side) tr_up — antisymmetry and conservation hold exactly, a ! uniform tracer stays uniform, and any resolved upwind layer ! (h > DRY_TOLERANCE) is bit-identical to plain upwinding. do concurrent ( c = 1 : nco ) & local ( i , k , kn , g , flux_c , tr_up , h_up , h_dn , div_sum , inv_area ) inv_area = 1.0_wp / mesh % area ( c ) do k = 1 , nz div_sum = 0.0_wp do i = 1 , EDGES_PER_TRI flux_c = dsig ( k ) * mass_flux_edge ( i , c ) * mesh % edge_len ( i , c ) if ( flux_c > 0.0_wp ) then ! Outflow: upwind the OWN cell; empty own => the downwind ! (neighbour / Dirichlet reservoir) concentration. h_up = h_layer ( k , c ) if ( h_up > DRY_TOLERANCE ) then tr_up = hTr_old ( k , c ) / h_up else kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then h_dn = h_layer ( k , kn ) tr_up = merge ( hTr_old ( k , kn ) / h_dn , 0.0_wp , & h_dn > DRY_TOLERANCE ) else g = mesh % bc_group ( i , c ) if ( g >= 1 . and . g <= n_bc ) then tr_up = tr_bc_ext ( g ) else tr_up = 0.0_wp end if end if end if else if ( flux_c < 0.0_wp ) then kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then ! Inflow: upwind the neighbour; empty neighbour => the ! downwind (own) concentration. h_up = h_layer ( k , kn ) if ( h_up > DRY_TOLERANCE ) then tr_up = hTr_old ( k , kn ) / h_up else h_dn = h_layer ( k , c ) tr_up = merge ( hTr_old ( k , c ) / h_dn , 0.0_wp , & h_dn > DRY_TOLERANCE ) end if else ! Dirichlet inflow: the per-group external tracer. g = mesh % bc_group ( i , c ) if ( g >= 1 . and . g <= n_bc ) then tr_up = tr_bc_ext ( g ) else tr_up = 0.0_wp end if end if else tr_up = 0.0_wp end if div_sum = div_sum + flux_c * tr_up end do hTr ( k , c ) = hTr_old ( k , c ) - dt * div_sum * inv_area end do end do end subroutine si_unstr_advect_tracer_dsig","tags":"","url":"proc/si_unstr_advect_tracer_dsig.html"},{"title":"si_unstr_apply_wind_top_layer – Rakali","text":"public pure subroutine si_unstr_apply_wind_top_layer(nz, nct, nco, h_layer, hu_layer, hv_layer, wind_tau_x, wind_tau_y, dt) Surface wind stress into the TOP layer (k = nz) transport:\ndt*tau/RHO_WATER — the explicit forcing that rides the pure-u&#94;n\npredictor into G_k (by linearity R_k / Hhat / the Helmholtz\noperator are untouched; zero wind => bit-identical).  The\nunstructured wind is the uniform scalar pair on the barotropic\nstate ( wind_tau_x/y ), so this is a trivially cheap kernel.\nGated on a wet surface layer. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) real(kind=wp), intent(inout) :: hu_layer (nz,nct) real(kind=wp), intent(inout) :: hv_layer (nz,nct) real(kind=wp), intent(in) :: wind_tau_x Uniform surface wind stress [Pa]. real(kind=wp), intent(in) :: wind_tau_y Uniform surface wind stress [Pa]. real(kind=wp), intent(in) :: dt Called by proc~~si_unstr_apply_wind_top_layer~~CalledByGraph proc~si_unstr_apply_wind_top_layer si_unstr_apply_wind_top_layer proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_apply_wind_top_layer proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c Source Code pure subroutine si_unstr_apply_wind_top_layer ( nz , nct , nco , h_layer , & hu_layer , hv_layer , & wind_tau_x , wind_tau_y , dt ) !! Surface wind stress into the TOP layer (k = nz) transport: !! dt*tau/RHO_WATER — the explicit forcing that rides the pure-u&#94;n !! predictor into G_k (by linearity R_k / Hhat / the Helmholtz !! operator are untouched; zero wind => bit-identical).  The !! unstructured wind is the uniform scalar pair on the barotropic !! state (`wind_tau_x/y`), so this is a trivially cheap kernel. !! Gated on a wet surface layer. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) real ( wp ), intent ( inout ) :: hu_layer ( nz , nct ), hv_layer ( nz , nct ) real ( wp ), intent ( in ) :: wind_tau_x , wind_tau_y !! Uniform surface wind stress [Pa]. real ( wp ), intent ( in ) :: dt integer :: c do concurrent ( c = 1 : nco ) if ( h_layer ( nz , c ) > H_VANISHED ) then hu_layer ( nz , c ) = hu_layer ( nz , c ) + dt * wind_tau_x / RHO_WATER hv_layer ( nz , c ) = hv_layer ( nz , c ) + dt * wind_tau_y / RHO_WATER end if end do end subroutine si_unstr_apply_wind_top_layer","tags":"","url":"proc/si_unstr_apply_wind_top_layer.html"},{"title":"si_unstr_build_nu_interface – Rakali","text":"public pure subroutine si_unstr_build_nu_interface(nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, nu_iface) PP81 Richardson-number interface viscosity, per cell (mirror of the\nstructured si_build_nu_interface , (nz, ncells) order):\n  nu_iface(1, c)      = 0   (bed interface)\n  nu_iface(k+1, c)    = nu between layers k and k+1\n  nu_iface(nz+1, c)   = 0   (surface interface)\nRi = g (drho/rho_0) h_avg / |du|&#94;2 (floored at 0);\nnu = nu_max/(1 + ri_alpha*Ri)&#94;2 + nu_bg; vanished layers decouple. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (the interface-array leading dim, explicit-shape). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up (k=1 bed). real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s]. real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(in) :: rho_layer (nz,nct) Layer densities [kg/m&#94;3]. real(kind=wp), intent(in) :: rho_0 Reference density [kg/m&#94;3]. real(kind=wp), intent(in) :: nu_max Maximum (convective) eddy viscosity [m&#94;2/s]. real(kind=wp), intent(in) :: nu_bg Background viscosity floor [m&#94;2/s]. real(kind=wp), intent(in) :: ri_alpha Richardson tuning coefficient (PP81: 5.0). real(kind=wp), intent(out) :: nu_iface (nzp1,nct) Interface viscosity [m&#94;2/s], vdiff convention. Calls proc~~si_unstr_build_nu_interface~~CallsGraph proc~si_unstr_build_nu_interface si_unstr_build_nu_interface local local proc~si_unstr_build_nu_interface->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_build_nu_interface~~CalledByGraph proc~si_unstr_build_nu_interface si_unstr_build_nu_interface proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_build_nu_interface proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c real(kind=wp), private :: denom real(kind=wp), private :: drho real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: h_avg real(kind=wp), private :: hk real(kind=wp), private :: hkp1 integer, private :: k real(kind=wp), private :: nu_t real(kind=wp), private :: ri_num real(kind=wp), private :: shear2 real(kind=wp), private :: uk real(kind=wp), private :: ukp1 real(kind=wp), private :: vk real(kind=wp), private :: vkp1 Source Code pure subroutine si_unstr_build_nu_interface ( nz , nzp1 , nct , nco , h_layer , & hu_layer , hv_layer , rho_layer , & rho_0 , nu_max , nu_bg , ri_alpha , & nu_iface ) !! PP81 Richardson-number interface viscosity, per cell (mirror of the !! structured `si_build_nu_interface`, `(nz, ncells)` order): !!   nu_iface(1, c)      = 0   (bed interface) !!   nu_iface(k+1, c)    = nu between layers k and k+1 !!   nu_iface(nz+1, c)   = 0   (surface interface) !! Ri = g*(drho/rho_0)*h_avg / |du|&#94;2 (floored at 0); !! nu = nu_max/(1 + ri_alpha*Ri)&#94;2 + nu_bg; vanished layers decouple. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (the interface-array leading dim, explicit-shape). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up (k=1 bed). real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! Maximum (convective) eddy viscosity [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_bg !! Background viscosity floor [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! Richardson tuning coefficient (PP81: 5.0). real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s], vdiff convention. integer :: c , k real ( wp ) :: hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , shear2 , ri_num , denom , nu_t do concurrent ( c = 1 : nco ) & local ( k , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , du , dv , drho , & shear2 , ri_num , denom , nu_t ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) if ( hk <= H_VANISHED . or . hkp1 <= H_VANISHED ) then nu_iface ( k + 1 , c ) = 0.0_wp else h_avg = 0.5_wp * ( hk + hkp1 ) uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) shear2 = du * du + dv * dv + 1.0e-20_wp ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / shear2 if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom = 1.0_wp + ri_alpha * ri_num nu_t = nu_max / ( denom * denom ) + nu_bg nu_iface ( k + 1 , c ) = nu_t end if end do end do end subroutine si_unstr_build_nu_interface","tags":"","url":"proc/si_unstr_build_nu_interface.html"},{"title":"si_unstr_column_solve – Rakali","text":"public pure subroutine si_unstr_column_solve(nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, nu_iface, manning_n, dt, g_col_u, g_col_v, r_col, Hhat_cell, Gbar_cell_x, Gbar_cell_y) Per-column semi-implicit solve — the structured si_column_solve ported per-cell ( (nz, ncells) order).  Predictor: PLAIN old-time\nvelocity u&#94;n_k = hu_k/max(h_k, H_VANISHED) — NO surface PGF (the\nedge-based PGF split: by linearity of the tridiagonal, all surface\nPGF applies at edges via the -1 response R_k).  Bottom drag:\nManning quadratic on the bed row (the unstructured barotropic\nstate carries no linear-drag knob):\n  cf = g n&#94;2 / H_total&#94;{1/3};  lambda = cf |u_bed| / h_1\nfolded into the bed diagonal as +dt*lambda.  Tridiagonal, Thomas\nfactorisation, three back-solves (u&#94;n, v&#94;n, -1), then\n  Gbar = sum_k h_k G_k,  Hhat = -sum_k h_k R_k  (>= 0).\nR_k is axis-independent (u and v share the matrix). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (the interface-array leading dim, explicit-shape). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up. real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s] (predictor tendencies already folded). real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(in) :: nu_iface (nzp1,nct) Interface viscosity [m&#94;2/s] (vdiff convention). real(kind=wp), intent(in) :: manning_n Manning roughness n [s/m&#94;{1/3}]; <= 0 disables bottom drag. real(kind=wp), intent(in) :: dt Time step [s]. real(kind=wp), intent(out) :: g_col_u (nz,nct) Column velocity response to u&#94;n (G_k&#94;u) [m/s]. real(kind=wp), intent(out) :: g_col_v (nz,nct) Column velocity response to v&#94;n (G_k&#94;v) [m/s]. real(kind=wp), intent(out) :: r_col (nz,nct) Column velocity response to -1 (R_k) [m/s] (<= 0). real(kind=wp), intent(out) :: Hhat_cell (nct) Effective column depth Hhat = -sum_k h_k R_k [m] (>= 0). real(kind=wp), intent(out) :: Gbar_cell_x (nct) Column-integrated predictor transport sum_k h_k G_k&#94;u [m&#94;2/s]. real(kind=wp), intent(out) :: Gbar_cell_y (nct) Column-integrated y predictor transport [m&#94;2/s]. Calls proc~~si_unstr_column_solve~~CallsGraph proc~si_unstr_column_solve si_unstr_column_solve local local proc~si_unstr_column_solve->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_column_solve~~CalledByGraph proc~si_unstr_column_solve si_unstr_column_solve proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_column_solve proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure 