32-bit real attribute to a variable.  NetCDF rejects a _FillValue whose type differs from the variable’s, so a variable\ndefined with NC_R4 must have its _FillValue / missing_value written through here, not through nc_put_att_real (real64). Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid character(len=*), intent(in) :: name real(kind=real32), intent(in) :: value public  subroutine nc_put_var_2d (ncid, varid, data) Write a full 2D array Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=wp), intent(in) :: data (:,:) public  subroutine nc_put_var_3d_slice (ncid, varid, data, time_index) Write a 2D slice into a 3D variable at a given time index Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=wp), intent(in) :: data (:,:) integer, intent(in) :: time_index public  subroutine nc_put_var_3d_slice_r4 (ncid, varid, data, time_index) Write a 32-bit 2D slice into a 3D variable at a given time index.\nThe real32 twin of nc_put_var_3d_slice : handing real64 data to\nan NF90_FLOAT variable is legal (netcdf converts) but writes the\nsame bytes at twice the host->library traffic, so the diag writer\nstages the conversion itself and calls this. Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=real32), intent(in) :: data (:,:) integer, intent(in) :: time_index public  subroutine nc_put_var_4d_slice (ncid, varid, data, time_index) Write a 3D slice into a 4D variable at a given time index Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=wp), intent(in) :: data (:,:,:) integer, intent(in) :: time_index public  subroutine nc_put_var_4d_slice_r4 (ncid, varid, data, time_index) Write a 32-bit 3D slice into a 4D variable at a given time index.\nThe real32 twin of nc_put_var_4d_slice . Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=real32), intent(in) :: data (:,:,:) integer, intent(in) :: time_index public  subroutine rki_def_var_1d (ncid, name, dimid, varid, deflate_level) Define a 1D variable with working precision type Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid character(len=*), intent(in) :: name integer, intent(in) :: dimid integer, intent(out) :: varid integer, intent(in), optional :: deflate_level Compression level (0=none, 1-9=deflate). Enables shuffle when > 0. public  subroutine rki_put_var_1d (ncid, varid, data) Write a full 1D array Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=wp), intent(in) :: data (:) public  subroutine rki_put_var_2d_slice (ncid, varid, data, time_index) Write a 1D slice into a 2D variable at a given time index Arguments Type Intent Optional Attributes Name integer, intent(in) :: ncid integer, intent(in) :: varid real(kind=wp), intent(in) :: data (:) integer, intent(in) :: time_index","tags":"","url":"module/rki_io_netcdf.html"},{"title":"rki_banner – Rakali","text":"Uses pic_knowledge pic_logger module~~rki_banner~~UsesGraph module~rki_banner rki_banner pic_knowledge pic_knowledge module~rki_banner->pic_knowledge pic_logger pic_logger module~rki_banner->pic_logger Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_banner~~UsedByGraph module~rki_banner rki_banner module~rki_api rki_api module~rki_api->module~rki_banner module~rki_api_unstr rki_api_unstr module~rki_api_unstr->module~rki_banner module~rki_driver rki_driver module~rki_driver->module~rki_banner Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Subroutines public  subroutine print_banner (sim_type) Print a cute banner to the console when the simulation starts. sim_type is accepted (and ignored) so callers can pass the\nconfigured regime tag without branching. Arguments Type Intent Optional Attributes Name character(len=*), intent(in), optional :: sim_type","tags":"","url":"module/rki_banner.html"},{"title":"rki_si_unstr_mg – Rakali","text":"Aggregation (agglomeration) multigrid V(2,2)-cycle preconditioner for the\nTRIANGLE semi-implicit free-surface Helmholtz system — geometric MG has no\ntriangle hierarchy, so we coarsen the CELL GRAPH by greedy pairwise\naggregation instead.  The design is\nnumpy-prototype-validated ( local_archive/prototypes/q12_agglom_mg ,\nSTRONG GO: plain-CG plateau of thousands -> tens of MG-PCG iters). WHAT IT PRECONDITIONS.  The Fortran CG ( si_unstr_cg_solve ) runs the\nAREA-WEIGHTED PCG on the operator A ( si_unstr_apply_helmholtz ), inner\nproduct <x,y>_area = sum_c area_c x_c y_c .  This module works in the\ngenuinely-SYMMETRIC space Ahat = diag(area)*A (SPD M-matrix):\n  Ahat[c,c]   = area_c + coef sum_e K_e      (coef = g theta&#94;2 dt&#94;2)\n  Ahat[c,nbr] = -coef K_e ,   K_e = Hf_e*len_e/delta_e\nThe Jacobi preconditioner the code already ships is, in this space,\nexactly z = Ahat_diag&#94;{-1} (area*r) ; the MG apply is the direct\ngeneralisation z = Vcycle_Ahat(area*r) — one V(2,2) cycle from a zero\nguess (SPD + linear => a valid CG preconditioner).  Passing area*r (not r ) into the symmetric V-cycle is what makes it consistent with the\narea-weighted outer PCG (prototype driver §Ahat). HIERARCHY.  Cell graph coarsened ~2x/level by greedy pairwise\naggregation (strongest-transmissibility partner).  Built ONCE at init\n(static mesh).  Every level’s operator is stored in a COMPACT\nvariable-valence edge form nbr(mv,nc) / ke(mv,nc) / diag(nc) ; a\ncoarse level’s operator is the GALERKIN P&#94;T Ahat P with a 0/1\npiecewise-constant P — which for aggregation equals a rediscretized\nagglomerate-TPFA (coarse mass = sum member areas, coarse transmissibility\n= sum of fine transmissibilities across the cut) EXACTLY, so the coarse\nSTENCIL DOES NOT GROW (prototype: Galerkin == rediscretized to\nround-off).  Transfers are P (inject) / R = P&#94;T (sum-gather) — exact\ntranspose by construction, no scaling factor. REFRESH.  Only the transmissibilities ke + diagonals depend on the\nper-step frozen Hf (coef is fixed).  The STRUCTURE (aggregates, coarse\nadjacency, member lists) is static; ke / diag / dinv are rebuilt ONCE\nPER STEP on the HOST (fine level from the mesh geometry + current Hf,\ncoarse levels by the Galerkin cascade) and pushed to the device — the\nsame host-side per-step operator refresh the structured MG uses.  NOT per\nV-cycle. GPU.  Each level owns explicit-shape device arrays + enter/exit_data.\nThe level loop runs on the HOST; every device kernel (apply / damped-\nJacobi smooth / residual / restrict / prolong) is called with FLAT\nEXPLICIT-SHAPE arguments — the level array is NEVER dereferenced inside a do concurrent (the array-of-derived-types device-indirection gotcha).\nKernels are cell-centric (each cell writes only its own row / entry;\nrestriction sums a coarse cell’s own members) — no neighbour scatter, no\natomics.  Damped Jacobi ping-pongs (read old, write new) — race-free.\nSingle-rank v1 (no per-cycle halo). Uses rki_mesh_unstr rki_constants pic_logger module~~rki_si_unstr_mg~~UsesGraph module~rki_si_unstr_mg rki_si_unstr_mg module~rki_constants rki_constants module~rki_si_unstr_mg->module~rki_constants module~rki_mesh_unstr rki_mesh_unstr module~rki_si_unstr_mg->module~rki_mesh_unstr pic_logger pic_logger module~rki_si_unstr_mg->pic_logger pic_types pic_types module~rki_constants->pic_types module~rki_mesh_unstr->module~rki_constants module~rki_mesh_unstr->pic_logger pic_io pic_io module~rki_mesh_unstr->pic_io module~rki_mesh_unstr->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_si_unstr_mg~~UsedByGraph module~rki_si_unstr_mg rki_si_unstr_mg module~rki_si_unstr_helmholtz rki_si_unstr_helmholtz module~rki_si_unstr_helmholtz->module~rki_si_unstr_mg module~rki_si_unstr_state rki_si_unstr_state module~rki_si_unstr_state->module~rki_si_unstr_mg module~rki_si_unstr_step rki_si_unstr_step module~rki_si_unstr_step->module~rki_si_unstr_mg module~rki_si_unstr_step->module~rki_si_unstr_helmholtz module~rki_si_unstr_step->module~rki_si_unstr_state module~rki_state_unstr rki_state_unstr module~rki_si_unstr_step->module~rki_state_unstr module~rki_driver rki_driver module~rki_driver->module~rki_si_unstr_state module~rki_solver_unstr rki_solver_unstr module~rki_driver->module~rki_solver_unstr module~rki_driver->module~rki_state_unstr module~rki_si_unstr_step_ml rki_si_unstr_step_ml module~rki_si_unstr_step_ml->module~rki_si_unstr_helmholtz module~rki_si_unstr_step_ml->module~rki_si_unst