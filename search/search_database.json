efore the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! One-way nesting from a coarser parent domain module rki_nesting !! Reads solution (h, hu, hv) from a parent domain NetCDF output file !! and fills ghost cells on BC_NESTED edges using Flather radiation with !! spatially-varying external values. Parent file: dims (x, y, time), !! variables h/hu/hv(x,y,time) + coordinate variables. Interpolation is !! linear along each edge in space and between bracketing snapshots in time. use rki_constants , only : wp , GRAVITY use rki_config , only : config_t use rki_state , only : state_t use rki_boundary_types , only : bc_params_t , BC_NESTED use rki_io_netcdf , only : nc_check , nc_open_read , nc_close , & nc_get_dim_len , nc_get_varid use netcdf , only : nf90_get_var use pic_logger , only : logger => global_logger use pic_strings , only : to_string implicit none private public :: nesting_t public :: nesting_init public :: nesting_init_from_config public :: nesting_update public :: nesting_destroy type :: nesting_t !! Container for parent domain data and interpolation state ! NetCDF file handle integer :: ncid = - 1 !! NetCDF file ID (kept open for lazy reads) logical :: active = . false . !! Whether nesting is enabled ! Parent grid coordinates integer :: p_nx = 0 !! Number of x-points in parent file integer :: p_ny = 0 !! Number of y-points in parent file integer :: p_nt = 0 !! Number of time steps in parent file real ( wp ), allocatable :: p_x (:) !! Parent x-coordinates (m) real ( wp ), allocatable :: p_y (:) !! Parent y-coordinates (m) real ( wp ), allocatable :: p_time (:) !! Parent time coordinates (s) ! Variable IDs integer :: varid_h = - 1 integer :: varid_hu = - 1 integer :: varid_hv = - 1 ! Two time-bracketing snapshots on parent grid integer :: idx_lo = 0 integer :: idx_hi = 0 real ( wp ), allocatable :: h_lo (:, :), h_hi (:, :) real ( wp ), allocatable :: hu_lo (:, :), hu_hi (:, :) real ( wp ), allocatable :: hv_lo (:, :), hv_hi (:, :) ! Child-to-parent coordinate offset real ( wp ) :: x_origin = 0.0_wp !! Child grid x-origin in parent coordinates real ( wp ) :: y_origin = 0.0_wp !! Child grid y-origin in parent coordinates ! Precomputed interpolation indices and weights for each boundary edge ! West/East edges: indexed by child j (1:ny_total) integer , allocatable :: we_ix0 (:) !! Parent x-index for west/east edge interpolation real ( wp ), allocatable :: we_wx (:) !! Parent x-weight for west/east edge integer , allocatable :: we_iy0 (:) !! Lower parent y-index per child j real ( wp ), allocatable :: we_wy (:) !! Parent y-weight per child j ! South/North edges: indexed by child i (1:nx_total) integer , allocatable :: sn_iy0 (:) !! Parent y-index for south/north edge interpolation real ( wp ), allocatable :: sn_wy (:) !! Parent y-weight for south/north edge integer , allocatable :: sn_ix0 (:) !! Lower parent x-index per child i real ( wp ), allocatable :: sn_wx (:) !! Parent x-weight per child i ! Parent x-indices for west and east edges integer :: ix_west = 1 real ( wp ) :: wx_west = 0.0_wp integer :: ix_east = 1 real ( wp ) :: wx_east = 0.0_wp ! Parent y-indices for south and north edges integer :: iy_south = 1 real ( wp ) :: wy_south = 0.0_wp integer :: iy_north = 1 real ( wp ) :: wy_north = 0.0_wp end type nesting_t contains subroutine nesting_init ( nest , filename , state , x_origin , y_origin ) !! Initialise nesting from a parent domain NetCDF file. !! Public only for the unit-test suite. type ( nesting_t ), intent ( inout ) :: nest character ( len =* ), intent ( in ) :: filename type ( state_t ), intent ( in ) :: state real ( wp ), intent ( in ), optional :: x_origin real ( wp ), intent ( in ), optional :: y_origin integer :: ncid if ( len_trim ( filename ) == 0 ) return nest % x_origin = 0.0_wp nest % y_origin = 0.0_wp if ( present ( x_origin )) nest % x_origin = x_origin if ( present ( y_origin )) nest % y_origin = y_origin call logger % info ( \"Loading nesting data from: \" // trim ( filename )) call nc_open_read ( filename , ncid ) nest % ncid = ncid ! Read parent grid call read_parent_grid ( nest , ncid ) ! Find variable IDs call nc_get_varid ( ncid , \"h\" , nest % varid_h ) call nc_get_varid ( ncid , \"hu\" , nest % varid_hu ) call nc_get_varid ( ncid , \"hv\" , nest % varid_hv ) ! Allocate snapshot arrays call allocate_parent_snapshots ( nest ) ! Precompute interpolation weights for boundary edges call compute_edge_weights ( nest , state ) ! Load first two snapshots if ( nest % p_nt >= 2 ) then nest % idx_lo = 1 nest % idx_hi = 2 call load_parent_snapshot ( nest , ncid , 1 , & nest % h_lo , nest % hu_lo , nest % hv_lo ) call load_parent_snapshot ( nest , ncid , 2 , & nest % h_hi , nest % hu_hi , nest % hv_hi ) else if ( nest % p_nt == 1 ) then nest % idx_lo = 1 nest % idx_hi = 1 call load_parent_snapshot ( nest , ncid , 1 , & nest % h_lo , nest % hu_lo , nest % hv_lo ) nest % h_hi = nest % h_lo nest % hu_hi = nest % hu_lo nest % hv_hi = nest % hv_lo end if nest % active = . true . call logger % info ( \"Parent grid: \" // to_string ( nest % p_nx ) // \" x \" // & to_string ( nest % p_ny ) // \", \" // & to_string ( nest % p_nt ) // \" time steps\" ) call logger % info ( \"Parent time range: \" // to_string ( nest % p_time ( 1 )) // & \" to \" // to_string ( nest % p_time ( nest % p_nt )) // \" s\" ) end subroutine nesting_init subroutine nesting_init_from_config ( nest , cfg , state ) !! Initialise nesting from config parameters type ( nesting_t ), intent ( inout ) :: nest type ( config_t ), intent ( in ) :: cfg type ( state_t ), intent ( in ) :: state call nesting_init ( nest , trim ( cfg % nesting_file ), state , & cfg % nesting_x_origin , cfg % nesting_y_origin ) end subroutine nesting_init_from_config subroutine nesting_update ( nest , state , sim_time ) !! Fill ghost cells on nested edges by interpolating from the parent, !! using Flather radiation with spatially-varying external values. type ( nesting_t ), intent ( inout ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: sim_time real ( wp ) :: alpha if (. not . nest % active ) return ! Check if any edge is nested if ( state % bc % west /= BC_NESTED . and . state % bc % east /= BC_NESTED . and . & state % bc % south /= BC_NESTED . and . state % bc % north /= BC_NESTED ) return ! Advance time bracket call advance_parent_bracket ( nest , sim_time ) ! Temporal interpolation weight if ( nest % idx_lo == nest % idx_hi ) then alpha = 0.0_wp else alpha = ( sim_time - nest % p_time ( nest % idx_lo )) / & ( nest % p_time ( nest % idx_hi ) - nest % p_time ( nest % idx_lo )) alpha = max ( 0.0_wp , min ( 1.0_wp , alpha )) end if ! Apply nested BCs per edge if ( state % bc % west == BC_NESTED ) then call apply_nested_west ( nest , state , alpha ) end if if ( state % bc % east == BC_NESTED ) then call apply_nested_east ( nest , state , alpha ) end if if ( state % bc % south == BC_NESTED ) then call apply_nested_south ( nest , state , alpha ) end if if ( state % bc % north == BC_NESTED ) then call apply_nested_north ( nest , state , alpha ) end if end subroutine nesting_update subroutine nesting_destroy ( nest ) !! Clean up nesting state and close file type ( nesting_t ), intent ( inout ) :: nest if ( nest % ncid >= 0 ) then call nc_close ( nest % ncid ) nest % ncid = - 1 end if if ( allocated ( nest % p_x )) deallocate ( nest % p_x ) if ( allocated ( nest % p_y )) deallocate ( nest % p_y ) if ( allocated ( nest % p_time )) deallocate ( nest % p_time ) if ( allocated ( nest % h_lo )) deallocate ( nest % h_lo ) if ( allocated ( nest % h_hi )) deallocate ( nest % h_hi ) if ( allocated ( nest % hu_lo )) deallocate ( nest % hu_lo ) if ( allocated ( nest % hu_hi )) deallocate ( nest % hu_hi ) if ( allocated ( nest % hv_lo )) deallocate ( nest % hv_lo ) if ( allocated ( nest % hv_hi )) deallocate ( nest % hv_hi ) if ( allocated ( nest % we_iy0 )) deallocate ( nest % we_iy0 ) if ( allocated ( nest % we_wy )) deallocate ( nest % we_wy ) if ( allocated ( nest % sn_ix0 )) deallocate ( nest % sn_ix0 ) if ( allocated ( nest % sn_wx )) deallocate ( nest % sn_wx ) nest % active = . false . end subroutine nesting_destroy ! ================================================================ ! Private helpers ! ================================================================ subroutine read_parent_grid ( nest , ncid ) type ( nesting_t ), intent ( inout ) :: nest integer , intent ( in ) :: ncid integer :: varid call nc_get_dim_len ( ncid , \"x\" , nest % p_nx ) call nc_get_dim_len ( ncid , \"y\" , nest % p_ny ) call nc_get_dim_len ( ncid , \"time\" , nest % p_nt ) allocate ( nest % p_x ( nest % p_nx )) allocate ( nest % p_y ( nest % p_ny )) allocate ( nest % p_time ( nest % p_nt )) call nc_get_varid ( ncid , \"x\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_x ), \"reading parent x\" ) call nc_get_varid ( ncid , \"y\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_y ), \"reading parent y\" ) call nc_get_varid ( ncid , \"time\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_time ), \"reading parent time\" ) end subroutine read_parent_grid subroutine allocate_parent_snapshots ( nest ) type ( nesting_t ), intent ( inout ) :: nest integer :: nx , ny nx = nest % p_nx ny = nest % p_ny allocate ( nest % h_lo ( nx , ny ), source = 0.0_wp ) allocate ( nest % h_hi ( nx , ny ), source = 0.0_wp ) allocate ( nest % hu_lo ( nx , ny ), source = 0.0_wp ) allocate ( nest % hu_hi ( nx , ny ), source = 0.0_wp ) allocate ( nest % hv_lo ( nx , ny ), source = 0.0_wp ) allocate ( nest % hv_hi ( nx , ny ), source = 0.0_wp ) end subroutine allocate_parent_snapshots subroutine compute_edge_weights ( nest , state ) !! Precompute interpolation weights mapping child edge cells to parent grid type ( nesting_t ), intent ( inout ) :: nest type ( state_t ), intent ( in ) :: state integer :: i , j , nx , ny , ng real ( wp ) :: x_child , y_child nx = state % grid % nx_total ny = state % grid % ny_total ng = state % grid % nghost ! West/East edges: need y-interpolation along j, and x-position for the edge allocate ( nest % we_iy0 ( ny ), source = 1 ) allocate ( nest % we_wy ( ny ), source = 0.0_wp ) do j = 1 , ny y_child = nest % y_origin + ( real ( j - ng , wp ) - 0.5_wp ) * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % we_iy0 ( j ), nest % we_wy ( j )) end do ! x-position for west edge (first physical cell centre) x_child = nest % x_origin + 0.5_wp * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % ix_west , nest % wx_west ) ! x-position for east edge (last physical cell centre) x_child = nest % x_origin + ( real ( state % grid % nx_phys , wp ) - 0.5_wp ) * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % ix_east , nest % wx_east ) ! South/North edges: need x-interpolation along i, and y-position for the edge allocate ( nest % sn_ix0 ( nx ), source = 1 ) allocate ( nest % sn_wx ( nx ), source = 0.0_wp ) do i = 1 , nx x_child = nest % x_origin + ( real ( i - ng , wp ) - 0.5_wp ) * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % sn_ix0 ( i ), nest % sn_wx ( i )) end do ! y-position for south edge y_child = nest % y_origin + 0.5_wp * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % iy_south , nest % wy_south ) ! y-position for north edge y_child = nest % y_origin + ( real ( state % grid % ny_phys , wp ) - 0.5_wp ) * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % iy_north , nest % wy_north ) end subroutine compute_edge_weights pure subroutine find_bracket_1d ( coords , n , val , idx , frac ) !! Find bracketing interval: coords(idx) <= val < coords(idx+1) real ( wp ), intent ( in ) :: coords (:) integer , intent ( in ) :: n real ( wp ), intent ( in ) :: val integer , intent ( out ) :: idx real ( wp ), intent ( out ) :: frac integer :: k if ( n <= 1 ) then idx = 1 frac = 0.0_wp return end if if ( val <= coords ( 1 )) then idx = 1 frac = 0.0_wp return end if if ( val >= coords ( n )) then idx = n frac = 0.0_wp return end if do k = 1 , n - 1 if ( val >= coords ( k ) . and . val < coords ( k + 1 )) then idx = k frac = ( val - coords ( k )) / ( coords ( k + 1 ) - coords ( k )) return end if end do idx = n - 1 frac = 1.0_wp end subroutine find_bracket_1d subroutine load_parent_snapshot ( nest , ncid , tidx , h , hu , hv ) type ( nesting_t ), intent ( in ) :: nest integer , intent ( in ) :: ncid , tidx real ( wp ), intent ( out ) :: h (:, :), hu (:, :), hv (:, :) integer :: start3 ( 3 ), count3 ( 3 ) start3 = [ 1 , 1 , tidx ] count3 = [ nest % p_nx , nest % p_ny , 1 ] call nc_check ( nf90_get_var ( ncid , nest % varid_h , h , & start = start3 , count = count3 ), \"reading parent h\" ) call nc_check ( nf90_get_var ( ncid , nest % varid_hu , hu , & start = start3 , count = count3 ), \"reading parent hu\" ) call nc_check ( nf90_get_var ( ncid , nest % varid_hv , hv , & start = start3 , count = count3 ), \"reading parent hv\" ) end subroutine load_parent_snapshot subroutine advance_parent_bracket ( nest , sim_time ) type ( nesting_t ), intent ( inout ) :: nest real ( wp ), intent ( in ) :: sim_time do while ( nest % idx_hi < nest % p_nt . and . & sim_time >= nest % p_time ( nest % idx_hi )) nest % idx_lo = nest % idx_hi nest % h_lo = nest % h_hi nest % hu_lo = nest % hu_hi nest % hv_lo = nest % hv_hi nest % idx_hi = nest % idx_hi + 1 call load_parent_snapshot ( nest , nest % ncid , nest % idx_hi , & nest % h_hi , nest % hu_hi , nest % hv_hi ) end do end subroutine advance_parent_bracket pure function interp_parent ( fld_lo , fld_hi , ix , iy , wx , wy , alpha , pnx , pny ) result ( val ) !! Bilinear spatial + linear temporal interpolation of parent field real ( wp ), intent ( in ) :: fld_lo (:, :), fld_hi (:, :) integer , intent ( in ) :: ix , iy , pnx , pny real ( wp ), intent ( in ) :: wx , wy , alpha real ( wp ) :: val integer :: ix1 , iy1 real ( wp ) :: v_lo , v_hi ix1 = min ( ix + 1 , pnx ) iy1 = min ( iy + 1 , pny ) v_lo = ( 1.0_wp - wx ) * ( 1.0_wp - wy ) * fld_lo ( ix , iy ) + & wx * ( 1.0_wp - wy ) * fld_lo ( ix1 , iy ) + & ( 1.0_wp - wx ) * wy * fld_lo ( ix , iy1 ) + & wx * wy * fld_lo ( ix1 , iy1 ) v_hi = ( 1.0_wp - wx ) * ( 1.0_wp - wy ) * fld_hi ( ix , iy ) + & wx * ( 1.0_wp - wy ) * fld_hi ( ix1 , iy ) + & ( 1.0_wp - wx ) * wy * fld_hi ( ix , iy1 ) + & wx * wy * fld_hi ( ix1 , iy1 ) val = ( 1.0_wp - alpha ) * v_lo + alpha * v_hi end function interp_parent subroutine apply_nested_west ( nest , state , alpha ) !! Fill west ghost cells using Flather with parent values: eta_ext !! prescribed from parent, h_ghost = max(0, eta_ext - b_ghost), !! hu_ghost = h_ghost * (u_int - c*(eta_int - eta_ext)). type ( nesting_t ), intent ( in ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: alpha integer :: j , k , ng , ny , i_first integer :: iy0 , pnx , pny real ( wp ) :: wy_j , h_ext , hu_ext , hv_ext , eta_ext real ( wp ) :: h_int , eta_int , speed ng = state % grid % nghost ny = state % grid % ny_total i_first = ng + 1 pnx = nest % p_nx pny = nest % p_ny do j = 1 , ny iy0 = nest % we_iy0 ( j ) wy_j = nest % we_wy ( j ) ! Interpolate parent values at west edge h_ext = interp_parent ( nest % h_lo , nest % h_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i_first , j ) ! Interior values h_int = state % barotropic % h ( i_first , j ) eta_int = h_int + state % barotropic % b ( i_first , j ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) ! Fill ghost cells with Flather BC do k = 1 , ng state % barotropic % h ( i_first - k , j ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i_first - k , j )) state % barotropic % hu ( i_first - k , j ) = state % barotropic % h ( i_first - k , j ) * & ( hu_ext / max ( h_ext , 1.0e-6_wp ) - & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) state % barotropic % hv ( i_first - k , j ) = hv_ext end do end do end subroutine apply_nested_west subroutine apply_nested_east ( nest , state , alpha ) !! Fill east ghost cells using Flather with parent values type ( nesting_t ), intent ( in ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: alpha integer :: j , k , ng , ny , nx , i_last integer :: iy0 , pnx , pny real ( wp ) :: wy_j , h_ext , hu_ext , hv_ext , eta_ext real ( wp ) :: h_int , eta_int , speed ng = state % grid % nghost nx = state % grid % nx_total ny = state % grid % ny_total i_last = nx - ng pnx = nest % p_nx pny = nest % p_ny do j = 1 , ny iy0 = nest % we_iy0 ( j ) wy_j = nest % we_wy ( j ) h_ext = interp_parent ( nest % h_lo , nest % h_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i_last , j ) h_int = state % barotropic % h ( i_last , j ) eta_int = h_int + state % barotropic % b ( i_last , j ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) do k = 1 , ng state % barotropic % h ( i_last + k , j ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i_last + k , j )) state % barotropic % hu ( i_last + k , j ) = state % barotropic % h ( i_last + k , j ) * & ( hu_ext / max ( h_ext , 1.0e-6_wp ) + & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) state % barotropic % hv ( i_last + k , j ) = hv_ext end do end do end subroutine apply_nested_east subroutine apply_nested_south ( nest , state , alpha ) !! Fill south ghost cells using Flather with parent values type ( nesting_t ), intent ( in ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: alpha integer :: i , k , ng , nx , j_first integer :: ix0 , pnx , pny real ( wp ) :: wx_i , h_ext , hu_ext , hv_ext , eta_ext real ( wp ) :: h_int , eta_int , speed ng = state % grid % nghost nx = state % grid % nx_total j_first = ng + 1 pnx = nest % p_nx pny = nest % p_ny do i = 1 , nx ix0 = nest % sn_ix0 ( i ) wx_i = nest % sn_wx ( i ) h_ext = interp_parent ( nest % h_lo , nest % h_hi , & ix0 , nest % iy_south , wx_i , nest % wy_south , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & ix0 , nest % iy_south , wx_i , nest % wy_south , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & ix0 , nest % iy_south , wx_i , nest % wy_south , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i , j_first ) h_int = state % barotropic % h ( i , j_first ) eta_int = h_int + state % barotropic % b ( i , j_first ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) do k = 1 , ng state % barotropic % h ( i , j_first - k ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i , j_first - k )) state % barotropic % hu ( i , j_first - k ) = hu_ext state % barotropic % hv ( i , j_first - k ) = state % barotropic % h ( i , j_first - k ) * & ( hv_ext / max ( h_ext , 1.0e-6_wp ) - & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) end do end do end subroutine apply_nested_south subroutine apply_nested_north ( nest , state , alpha ) !! Fill north ghost cells using Flather with parent values type ( nesting_t ), intent ( in ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: alpha integer :: i , k , ng , nx , ny , j_last integer :: ix0 , pnx , pny real ( wp ) :: wx_i , h_ext , hu_ext , hv_ext , eta_ext real ( wp ) :: h_int , eta_int , speed ng = state % grid % nghost nx = state % grid % nx_total ny = state % grid % ny_total j_last = ny - ng pnx = nest % p_nx pny = nest % p_ny do i = 1 , nx ix0 = nest % sn_ix0 ( i ) wx_i = nest % sn_wx ( i ) h_ext = interp_parent ( nest % h_lo , nest % h_hi , & ix0 , nest % iy_north , wx_i , nest % wy_north , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & ix0 , nest % iy_north , wx_i , nest % wy_north , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & ix0 , nest % iy_north , wx_i , nest % wy_north , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i , j_last ) h_int = state % barotropic % h ( i , j_last ) eta_int = h_int + state % barotropic % b ( i , j_last ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) do k = 1 , ng state % barotropic % h ( i , j_last + k ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i , j_last + k )) state % barotropic % hu ( i , j_last + k ) = hu_ext state % barotropic % hv ( i , j_last + k ) = state % barotropic % h ( i , j_last + k ) * & ( hv_ext / max ( h_ext , 1.0e-6_wp ) + & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) end do end do end subroutine apply_nested_north end module rki_nesting","tags":"","url":"sourcefile/rki_nesting.f90.html"},{"title":"rki_ml_kpp.F90 – Rakali","text":"KPP (Large, McWilliams & Doney 1994) surface-boundary-layer mixing\nfor the structured coastal multilayer path (A-grid). This file depends on sourcefile~~rki_ml_kpp.f90~~EfferentGraph sourcefile~rki_ml_kpp.f90 rki_ml_kpp.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_kpp.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_ml_kpp.f90->sourcefile~rki_grid.f90 sourcefile~rki_ml_common.f90 rki_ml_common.F90 sourcefile~rki_ml_kpp.f90->sourcefile~rki_ml_common.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_ml_kpp.f90~~AfferentGraph sourcefile~rki_ml_kpp.f90 rki_ml_kpp.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_ml_kpp.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! KPP (Large, McWilliams & Doney 1994) surface-boundary-layer mixing !! for the structured coastal multilayer path (A-grid). module rki_ml_kpp !! KPP surface-boundary-layer mixing for the coastal A-grid. Unlike the !! ocean path (implicit Thomas solve), the coastal path has no implicit !! vertical-diffusion solver, so the KPP overlay is fused with the explicit !! CFL-clamped diffusive-flux apply: !!   * `ml_kpp_boundary_layer` — per column u_*, surface buoyancy flux B_0, !!     and bulk-Ri boundary-layer depth h_b (LMD94 eq-23 V_t&#94;2 term); !!     `bl_depth` persists across steps to seed V_t&#94;2 (self-bootstrapping). !!   * `ml_kpp_viscosity` — momentum: nu_t = max(PP81 interior, KPP overlay !!     h_b·w_s·G(sigma)), explicit flux to hu/hv. !!   * `ml_kpp_diffusion_tracers` — S+T: same overlay + non-local !!     counter-gradient transport under destabilizing forcing. !! !! Overlay inactive (w_s=0) ⇒ falls through to bit-identical PP81. `vmix_use_kpp` !! off (default) leaves all results unchanged. Bottom-up layers (k=1 bed, !! k=nz surface); interface \"k\" sits between layer k and k+1. use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE use rki_grid , only : hgrid_t use rki_ml_common , only : ML_MIN_DEPTH , VANISHING_LAYER_TOL implicit none private public :: ml_kpp_boundary_layer public :: ml_kpp_viscosity public :: ml_kpp_diffusion_tracers public :: kpp_shape real ( wp ), parameter :: EPS = 1.0e-20_wp !! Shear² floor in the interior gradient-Ri (matches PP81 kernels). real ( wp ), parameter :: SHEAR2_FLOOR = 1.0e-10_wp !! Velocity-difference floor in the bulk-Ri denominator (matches !! `rki_ocean_vmix`); stops Ri_bulk blowing up in quiescent water. contains pure function kpp_shape ( sigma ) result ( g ) !! KPP cubic shape function G(sigma) = sigma·(1-sigma)² (LMD94), valid for !! 0 <= sigma <= 1. Exposed only for unit tests; hot kernels inline the !! one-line form to avoid a device cross-call. real ( wp ), intent ( in ) :: sigma real ( wp ) :: g g = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) end function kpp_shape pure subroutine ml_kpp_boundary_layer ( h_layer , hu_layer , hv_layer , rho_layer , & hS_layer , rho_0 , alpha_T , beta_S , cp , & wind_x , wind_y , heat_flux , evap_minus_precip , & ri_crit , c_vt2 , & u_star , buoy_flux , bl_depth , & grid , nz ) !! Pass 1: per-column u_*, B_0, and bulk-Ri boundary-layer depth h_b. !!   u_* = sqrt(|tau|/rho_0), tau = surface wind stress (Pa). !!   B_0 = g·(alpha_T·F_T - beta_S·F_S), kinematic fluxes !!         F_T = Q_heat/(rho_0·cp), F_S = (E-P)·S_top; B_0 < 0 destabilizing. !!   h_b : top-down bulk-Ri sweep; crossing of `ri_crit` interpolated. !!         V_t²(d) = (c_vt2/ri_crit)·d·N(d)·w_s uses lagged `bl_depth` !!         (zero on first call ⇒ self-bootstrapping). No crossing ⇒ h_b = H. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 , alpha_T , beta_S , cp real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: ri_crit , c_vt2 real ( wp ), intent ( inout ) :: u_star ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: buoy_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: bl_depth ( grid % nx_total , grid % ny_total ) integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us real ( wp ) :: u_ref , v_ref , b_ref , d_centre_ref real ( wp ) :: h_b_lagged , wstar3_lagged , w_s_col real ( wp ) :: u_k , v_k , b_k , d_centre_k , delta_d , delta_b real ( wp ) :: n_brunt , vt2 , shear2 , ri_bulk , ri_prev , d_prev real ( wp ) :: denom , frac , h_b , h_k , h_k1 logical :: crossing_found nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us , & u_ref , v_ref , b_ref , d_centre_ref , h_b_lagged , & wstar3_lagged , w_s_col , u_k , v_k , b_k , d_centre_k , & delta_d , delta_b , n_brunt , vt2 , shear2 , ri_bulk , ri_prev , & d_prev , denom , frac , h_b , h_k , h_k1 , crossing_found ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col <= ML_MIN_DEPTH ) then u_star ( i , j ) = 0.0_wp buoy_flux ( i , j ) = 0.0_wp bl_depth ( i , j ) = 0.0_wp cycle end if ! Surface friction velocity (A-grid wind stress is at the cell ! centre, so no face averaging). us = sqrt ( sqrt ( wind_x ( i , j ) * wind_x ( i , j ) + wind_y ( i , j ) * wind_y ( i , j )) / rho_0 ) ! Surface buoyancy flux. h_top = h_layer ( i , j , nz ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( i , j , nz ) / h_top u_ref = hu_layer ( i , j , nz ) / h_top v_ref = hv_layer ( i , j , nz ) / h_top else s_top = 0.0_wp u_ref = 0.0_wp v_ref = 0.0_wp end if f_t_kin = heat_flux ( i , j ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( i , j ) * s_top ! Buoyancy flux from the *dimensional* coastal EOS derivatives: ! b = -g*rho/rho_0, drho = -alpha_T*dT + beta_S*dS (kg/m&#94;3 per ! degC / PSU), so B_0 = (g/rho_0)*(alpha_T*F_T - beta_S*F_S). ! (The ocean path folds the 1/rho_0 into its expansion ! coefficients; coastal keeps it explicit.) b_0 = ( GRAVITY / rho_0 ) * ( alpha_T * f_t_kin - beta_S * f_s_kin ) u_star ( i , j ) = us buoy_flux ( i , j ) = b_0 ! Reference buoyancy at the surface layer centre. b_ref = - GRAVITY * rho_layer ( i , j , nz ) / rho_0 d_centre_ref = 0.5_wp * h_top ! Lagged convective scale for V_t² (self-bootstraps from 0). h_b_lagged = bl_depth ( i , j ) wstar3_lagged = max ( 0.0_wp , - b_0 ) * h_b_lagged w_s_col = sqrt ( us * us + wstar3_lagged ** ( 2.0_wp / 3.0_wp )) ri_prev = 0.0_wp d_prev = d_centre_ref h_b = 0.0_wp crossing_found = . false . d_centre_k = d_centre_ref do k = nz - 1 , 1 , - 1 if (. not . crossing_found ) then h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) d_centre_k = d_centre_k + 0.5_wp * ( h_k1 + h_k ) if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if b_k = - GRAVITY * rho_layer ( i , j , k ) / rho_0 delta_d = d_centre_k - d_centre_ref delta_b = b_ref - b_k n_brunt = sqrt ( max ( 0.0_wp , delta_b / delta_d )) vt2 = ( c_vt2 / ri_crit ) * d_centre_k * n_brunt * w_s_col shear2 = max (( u_k - u_ref ) * ( u_k - u_ref ) + & ( v_k - v_ref ) * ( v_k - v_ref ) + vt2 , SHEAR2_FLOOR ) ri_bulk = delta_b * delta_d / shear2 if ( ri_bulk >= ri_crit ) then denom = ri_bulk - ri_prev if ( abs ( denom ) > 1.0e-12_wp ) then frac = ( ri_crit - ri_prev ) / denom else frac = 0.5_wp end if h_b = d_prev + frac * ( d_centre_k - d_prev ) crossing_found = . true . end if ri_prev = ri_bulk d_prev = d_centre_k end if end do if (. not . crossing_found ) h_b = h_col bl_depth ( i , j ) = h_b end do end subroutine ml_kpp_boundary_layer pure subroutine ml_kpp_viscosity ( h_layer , hu_layer , hv_layer , rho_layer , & rho_0 , nu_max , nu_bg , ri_alpha , & u_star , buoy_flux , bl_depth , & grid , nz , dt ) !! Pass 2 (momentum): PP81 interior viscosity with the KPP !! shape-function overlay max'd in, then the explicit CFL-clamped !! diffusive flux applied to hu/hv.  Identical to !! `ml_vertical_viscosity` everywhere the overlay is inactive !! (w_s = 0 or interface below the BL). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 , nu_max , nu_bg , ri_alpha real ( wp ), intent ( in ) :: u_star ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: buoy_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: bl_depth ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , h_col real ( wp ) :: du , dv , drho , Ri , denom , nu_t , flux_u , flux_v real ( wp ) :: h_b , b_0 , us , wstar3 , w_star , w_s real ( wp ) :: d_below , d_iface , sigma , g_shape , nu_kpp nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , du , dv , drho , & Ri , denom , nu_t , flux_u , flux_v , h_col , h_b , b_0 , us , & wstar3 , w_star , w_s , d_below , d_iface , sigma , g_shape , nu_kpp ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then h_b = bl_depth ( i , j ) b_0 = buoy_flux ( i , j ) us = u_star ( i , j ) wstar3 = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3 ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) d_below = 0.0_wp do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( i , j , k + 1 ) / h_k1 v_k1 = hv_layer ( i , j , k + 1 ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( i , j , k ) - rho_layer ( i , j , k + 1 ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + ri_alpha * Ri nu_t = nu_max / ( denom * denom ) + nu_bg ! KPP overlay inside the boundary layer. if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) nu_kpp = h_b * w_s * g_shape if ( nu_kpp > nu_t ) nu_t = nu_kpp end if ! Explicit-flux stability: nu_t*dt/h_avg² < 0.5. if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) then nu_t = 0.5_wp * h_avg * h_avg / dt end if flux_u = nu_t * du / h_avg * dt flux_v = nu_t * dv / h_avg * dt hu_layer ( i , j , k ) = hu_layer ( i , j , k ) + flux_u hu_layer ( i , j , k + 1 ) = hu_layer ( i , j , k + 1 ) - flux_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) + flux_v hv_layer ( i , j , k + 1 ) = hv_layer ( i , j , k + 1 ) - flux_v end if end do end if end do end subroutine ml_kpp_viscosity pure subroutine ml_kpp_diffusion_tracers ( h_layer , hu_layer , hv_layer , & hS_layer , hT_layer , rho_layer , rho_0 , & nu_max , kappa_S_bg , kappa_T_bg , ri_alpha , & cs_nonlocal , heat_flux , evap_minus_precip , & cp , u_star , buoy_flux , bl_depth , & grid , nz , dt ) !! Pass 2 (tracers): PP81 cubic interior diffusivity with the KPP !! overlay max'd in (same overlay as momentum), explicit flux on !! salinity + temperature, plus the non-local counter-gradient !! transport under destabilizing forcing.  Fuses the two !! `ml_vertical_diffusion_tracer` calls; bit-identical to them !! where the overlay + non-local terms vanish. !! !! Non-local: gamma(iface) = cs·G(sigma)·F_kin is a downward flux; !! its divergence redistributes the surface flux through the BL. !! Applied in a second column pass so the diffusive flux above is !! computed from un-redistributed tracer (matches the ocean order !! of vdiff-then-nonlocal).  gamma = 0 at the bed and free !! surface ⇒ the divergence conserves the column integral. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 , nu_max , kappa_S_bg , kappa_T_bg , ri_alpha real ( wp ), intent ( in ) :: cs_nonlocal , cp real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_star ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: buoy_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: bl_depth ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , h_col real ( wp ) :: s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom real ( wp ) :: kappa_S , kappa_T , flux_S , flux_T real ( wp ) :: h_b , b_0 , us , wstar3 , w_star , w_s real ( wp ) :: h_top , s_top , f_t_kin , f_s_kin real ( wp ) :: d_below , d_iface , sigma , g_shape , nu_kpp , gamma_T , gamma_S logical :: destabilizing nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , h_col , & s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom , & kappa_S , kappa_T , flux_S , flux_T , h_b , b_0 , us , & wstar3 , w_star , w_s , h_top , s_top , f_t_kin , f_s_kin , & d_below , d_iface , sigma , g_shape , nu_kpp , gamma_T , gamma_S , & destabilizing ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then h_b = bl_depth ( i , j ) b_0 = buoy_flux ( i , j ) us = u_star ( i , j ) wstar3 = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3 ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) destabilizing = ( b_0 < 0.0_wp ) ! ---- diffusive flux (PP81 cubic + KPP overlay) ---- d_below = 0.0_wp do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k s_k = hS_layer ( i , j , k ) / h_k t_k = hT_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp s_k = 0.0_wp t_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( i , j , k + 1 ) / h_k1 v_k1 = hv_layer ( i , j , k + 1 ) / h_k1 s_k1 = hS_layer ( i , j , k + 1 ) / h_k1 t_k1 = hT_layer ( i , j , k + 1 ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp s_k1 = 0.0_wp t_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( i , j , k ) - rho_layer ( i , j , k + 1 ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + ri_alpha * Ri kappa_S = nu_max / ( denom * denom * denom ) + kappa_S_bg kappa_T = nu_max / ( denom * denom * denom ) + kappa_T_bg if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) nu_kpp = h_b * w_s * g_shape if ( nu_kpp > kappa_S ) kappa_S = nu_kpp if ( nu_kpp > kappa_T ) kappa_T = nu_kpp end if if ( kappa_S * dt > 0.5_wp * h_avg * h_avg ) kappa_S = 0.5_wp * h_avg * h_avg / dt if ( kappa_T * dt > 0.5_wp * h_avg * h_avg ) kappa_T = 0.5_wp * h_avg * h_avg / dt flux_S = kappa_S * ( s_k1 - s_k ) / h_avg * dt flux_T = kappa_T * ( t_k1 - t_k ) / h_avg * dt hS_layer ( i , j , k ) = hS_layer ( i , j , k ) + flux_S hS_layer ( i , j , k + 1 ) = hS_layer ( i , j , k + 1 ) - flux_S hT_layer ( i , j , k ) = hT_layer ( i , j , k ) + flux_T hT_layer ( i , j , k + 1 ) = hT_layer ( i , j , k + 1 ) - flux_T end if end do ! ---- non-local counter-gradient transport ---- if ( destabilizing . and . w_s > 0.0_wp . and . h_b > 0.0_wp ) then h_top = h_layer ( i , j , nz ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( i , j , nz ) / h_top else s_top = 0.0_wp end if f_t_kin = heat_flux ( i , j ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( i , j ) * s_top d_below = 0.0_wp do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) gamma_T = cs_nonlocal * g_shape * f_t_kin gamma_S = cs_nonlocal * g_shape * f_s_kin hT_layer ( i , j , k ) = hT_layer ( i , j , k ) + dt * gamma_T hT_layer ( i , j , k + 1 ) = hT_layer ( i , j , k + 1 ) - dt * gamma_T hS_layer ( i , j , k ) = hS_layer ( i , j , k ) + dt * gamma_S hS_layer ( i , j , k + 1 ) = hS_layer ( i , j , k + 1 ) - dt * gamma_S end if end do end if end if end do end subroutine ml_kpp_diffusion_tracers end module rki_ml_kpp","tags":"","url":"sourcefile/rki_ml_kpp.f90.html"},{"title":"rki_boundary.F90 – Rakali","text":"Boundary condition application for ghost cells This file depends on sourcefile~~rki_boundary.f90~~EfferentGraph sourcefile~rki_boundary.f90 rki_boundary.F90 sourcefile~rki_boundary_types.f90 rki_boundary_types.F90 sourcefile~rki_boundary.f90->sourcefile~rki_boundary_types.f90 sourcefile~rki_config.f90 rki_config.F90 sourcefile~rki_boundary.f90->sourcefile~rki_config.f90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_boundary.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_boundary.f90->sourcefile~rki_grid.f90 sourcefile~rki_boundary_types.f90->sourcefile~rki_config.f90 sourcefile~rki_boundary_types.f90->sourcefile~rki_constants.f90 sourcefile~rki_config.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common_unstr.f90 rki_ml_common_unstr.F90 sourcefile~rki_config.f90->sourcefile~rki_ml_common_unstr.f90 sourcefile~rki_nml_schema.f90 rki_nml_schema.F90 sourcefile~rki_config.f90->sourcefile~rki_nml_schema.f90 sourcefile~rki_recon_weno.f90 rki_recon_weno.F90 sourcefile~rki_config.f90->sourcefile~rki_recon_weno.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_nml_schema.f90->sourcefile~rki_constants.f90 sourcefile~rki_recon_weno.f90->sourcefile~rki_constants.f90 sourcefile~rki_recon_weno.f90->sourcefile~rki_grid.f90 sourcefile~rki_ml_common.f90 rki_ml_common.F90 sourcefile~rki_recon_weno.f90->sourcefile~rki_ml_common.f90 sourcefile~rki_ml_common.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_boundary.f90~~AfferentGraph sourcefile~rki_boundary.f90 rki_boundary.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_boundary.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Boundary condition application for ghost cells module rki_boundary !! Fills ghost cells per boundary type: wall (mirror), open/tidal !! (Flather radiation), inflow/discharge (prescribed velocity/flux), !! clamped (Dirichlet eta), sponge (falls through to wall), Chapman !! (Orlanski radiation). use rki_constants , only : wp , GRAVITY use rki_config , only : MAX_TIDAL_CONSTITUENTS use rki_boundary_types , only : bc_params_t , BC_WALL , BC_OPEN , BC_TIDAL , & BC_NESTED , BC_INFLOW , BC_DISCHARGE , & BC_CLAMPED , BC_SPONGE , BC_CHAPMAN , & bc_type_from_string , TWO_PI use rki_grid , only : hgrid_t implicit none private public :: apply_boundary_conditions public :: apply_nh_boundary_conditions public :: bc_params_t public :: BC_WALL , BC_OPEN , BC_TIDAL , BC_NESTED public :: BC_INFLOW , BC_DISCHARGE , BC_CLAMPED , BC_SPONGE , BC_CHAPMAN public :: bc_type_from_string integer , parameter :: N_EDGES = 4 !! Number of domain edges (west, east, south, north). ! Per-edge geometry descriptor for the unified boundary dispatch. type :: edge_t integer :: bc_type !! BC tag for this edge (bc%west / east / south / north) integer :: n_tan !! tangential extent (ny on W/E, nx on S/N) integer :: ig0 , jg0 !! first ghost cell (k=1, t=1) integer :: di_n , dj_n !! outward step per ghost layer k integer :: di_t , dj_t !! step along the edge per tangential index t real ( wp ) :: nrm_sign !! +1 on high edges (E/N), -1 on low edges (W/S) logical :: normal_is_u !! normal momentum is hu (W/E) vs hv (S/N) end type edge_t contains subroutine apply_boundary_conditions ( h , hu , hv , b , grid , bc ) !! Fill ghost cells based on boundary condition type type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: b ( grid % nx_total , grid % ny_total ) !! INOUT: wall/sponge edges mirror the bed into their ghost cells !! (see `bc_wall_edge`).  Open/tidal/inflow edges leave it untouched !! — there the domain genuinely continues past the boundary. type ( bc_params_t ), intent ( inout ) :: bc !! Boundary condition parameters integer :: k , j , i , n integer :: nx , ny , nghost integer :: i_first , i_last , j_first , j_last type ( edge_t ) :: edges ( N_EDGES ) real ( wp ) :: tidal_eta , h_int , eta_int , speed real ( wp ) :: inflow_vel , disch_flux , clamp_eta real ( wp ) :: c_phase , deta_dt , deta_dx , eta_ghost_new , eta_old_val , bc_dt , bc_dx , bc_dy integer :: n_tc real ( wp ) :: tc_amp ( MAX_TIDAL_CONSTITUENTS ) real ( wp ) :: tc_phase ( MAX_TIDAL_CONSTITUENTS ) real ( wp ) :: tc_omega ( MAX_TIDAL_CONSTITUENTS ) real ( wp ) :: bc_time nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost i_first = nghost + 1 i_last = nx - nghost j_first = nghost + 1 j_last = ny - nghost ! Per-edge geometry (west / east / south / north). W/E loop over j, ! normal momentum hu; S/N over i, normal momentum hv. edges ( 1 ) = edge_t ( bc_type = bc % west , n_tan = ny , ig0 = i_first - 1 , jg0 = 1 , & di_n =- 1 , dj_n = 0 , di_t = 0 , dj_t = 1 , nrm_sign =- 1.0_wp , normal_is_u = . true .) edges ( 2 ) = edge_t ( bc_type = bc % east , n_tan = ny , ig0 = i_last + 1 , jg0 = 1 , & di_n = 1 , dj_n = 0 , di_t = 0 , dj_t = 1 , nrm_sign = 1.0_wp , normal_is_u = . true .) edges ( 3 ) = edge_t ( bc_type = bc % south , n_tan = nx , ig0 = 1 , jg0 = j_first - 1 , & di_n = 0 , dj_n =- 1 , di_t = 1 , dj_t = 0 , nrm_sign =- 1.0_wp , normal_is_u = . false .) edges ( 4 ) = edge_t ( bc_type = bc % north , n_tan = nx , ig0 = 1 , jg0 = j_last + 1 , & di_n = 0 , dj_n = 1 , di_t = 1 , dj_t = 0 , nrm_sign = 1.0_wp , normal_is_u = . false .) n_tc = bc % n_tidal_constituents bc_time = bc % time tc_amp = bc % tidal_amp tc_phase = bc % tidal_phase tc_omega = bc % tidal_omega tidal_eta = 0.0_wp if ( n_tc > 0 ) then ! eta(t) = sum A_n cos(omega_n*t - phi_n) do n = 1 , n_tc tidal_eta = tidal_eta + tc_amp ( n ) * cos ( tc_omega ( n ) * bc_time - tc_phase ( n )) end do else if ( bc % tidal_period > 0.0_wp ) then ! Single-constituent fallback tidal_eta = bc % tidal_amplitude * sin ( TWO_PI * bc_time / bc % tidal_period ) end if inflow_vel = bc % inflow_velocity disch_flux = bc % discharge_flux clamp_eta = bc % clamped_elevation bc_dt = bc % dt bc_dx = bc % dx bc_dy = bc % dy ! ---- West boundary ---- select case ( bc % west ) case ( BC_WALL , BC_SPONGE ) call bc_wall_edge ( h , hu , hv , b , grid , edges ( 1 )) case ( BC_OPEN ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 1 ), 0.0_wp , . false .) case ( BC_TIDAL ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 1 ), tidal_eta , . true .) case ( BC_INFLOW ) call bc_inflow_edge ( h , hu , hv , b , grid , edges ( 1 ), inflow_vel ) case ( BC_DISCHARGE ) call bc_disch_edge ( h , hu , hv , b , grid , edges ( 1 ), disch_flux ) case ( BC_CLAMPED ) call bc_clamped_edge ( h , hu , hv , b , grid , edges ( 1 ), clamp_eta ) case ( BC_CHAPMAN ) call bc_chapman_edge ( h , hu , hv , b , grid , edges ( 1 ), bc % eta_old_west , bc_dt , bc_dx , bc_dy ) case default continue end select ! ---- East boundary ---- select case ( bc % east ) case ( BC_WALL , BC_SPONGE ) call bc_wall_edge ( h , hu , hv , b , grid , edges ( 2 )) case ( BC_OPEN ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 2 ), 0.0_wp , . false .) case ( BC_TIDAL ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 2 ), tidal_eta , . true .) case ( BC_INFLOW ) call bc_inflow_edge ( h , hu , hv , b , grid , edges ( 2 ), inflow_vel ) case ( BC_DISCHARGE ) call bc_disch_edge ( h , hu , hv , b , grid , edges ( 2 ), disch_flux ) case ( BC_CLAMPED ) call bc_clamped_edge ( h , hu , hv , b , grid , edges ( 2 ), clamp_eta ) case ( BC_CHAPMAN ) call bc_chapman_edge ( h , hu , hv , b , grid , edges ( 2 ), bc % eta_old_east , bc_dt , bc_dx , bc_dy ) case default continue end select ! ---- South boundary ---- select case ( bc % south ) case ( BC_WALL , BC_SPONGE ) call bc_wall_edge ( h , hu , hv , b , grid , edges ( 3 )) case ( BC_OPEN ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 3 ), 0.0_wp , . false .) case ( BC_TIDAL ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 3 ), tidal_eta , . true .) case ( BC_INFLOW ) call bc_inflow_edge ( h , hu , hv , b , grid , edges ( 3 ), inflow_vel ) case ( BC_DISCHARGE ) call bc_disch_edge ( h , hu , hv , b , grid , edges ( 3 ), disch_flux ) case ( BC_CLAMPED ) call bc_clamped_edge ( h , hu , hv , b , grid , edges ( 3 ), clamp_eta ) case ( BC_CHAPMAN ) call bc_chapman_edge ( h , hu , hv , b , grid , edges ( 3 ), bc % eta_old_south , bc_dt , bc_dx , bc_dy ) case default continue end select ! ---- North boundary ---- select case ( bc % north ) case ( BC_WALL , BC_SPONGE ) call bc_wall_edge ( h , hu , hv , b , grid , edges ( 4 )) case ( BC_OPEN ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 4 ), 0.0_wp , . false .) case ( BC_TIDAL ) call bc_flather_edge ( h , hu , hv , b , grid , edges ( 4 ), tidal_eta , . true .) case ( BC_INFLOW ) call bc_inflow_edge ( h , hu , hv , b , grid , edges ( 4 ), inflow_vel ) case ( BC_DISCHARGE ) call bc_disch_edge ( h , hu , hv , b , grid , edges ( 4 ), disch_flux ) case ( BC_CLAMPED ) call bc_clamped_edge ( h , hu , hv , b , grid , edges ( 4 ), clamp_eta ) case ( BC_CHAPMAN ) call bc_chapman_edge ( h , hu , hv , b , grid , edges ( 4 ), bc % eta_old_north , bc_dt , bc_dx , bc_dy ) case default continue end select end subroutine apply_boundary_conditions pure subroutine bc_wall_edge ( h , hu , hv , b , grid , ed ) !! Wall / sponge ghost fill for one edge: mirror the BED and the !! surface, negate the NORMAL momentum, copy the tangential. !! Geometry comes from `ed`; its scalars are hoisted to locals so the !! do concurrent carries no derived-type dereference. !! !! ## Why the bed is mirrored too !! !! A wall IS a reflection: the ghost column is a fictitious mirror of !! the interior, so its bed must equal its mirror's bed.  Anything else !! describes a domain that CONTINUES past the wall with different !! topography — which is not a wall. !! !! Formula bathymetry setters fill the ghost rows by evaluating the !! formula there (they must, or the EOS sees h_layer = 0 at ghosts and !! falls back to rho_0), so without this line `b(ghost)` is the !! CONTINUATION of the topography rather than its reflection, and the !! reconstruction across the wall face is asymmetric. !! !! At rest that is harmless — the Audusse hydrostatic reconstruction !! still returns exactly zero flux, which is why the C-property held to !! 1e-12 over irregular bathymetry.  But WITH FLOW the asymmetry gives a !! non-zero HLL mass flux through a closed wall.  Measured on a closed !! box, stratified, sinusoidal bed, 400 steps: relative mass change !! 1.364e-6 with the formula bed in the ghosts vs -2.1e-14 with it !! mirrored, and the solver's own `mass_out` accumulator attributed !! 100 % of it to boundary flux (budget residual 2e-14). !! !! Mirroring here rather than once at setup means it also survives a bed !! that EVOLVES — which is exactly what the Exner update in the !! morphodynamics plan will do. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed integer :: t , k , ig , jg , im , jm , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan logical :: nu nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u do concurrent ( t = 1 : n_tan , k = 1 : nghost ) local ( ig , jg , im , jm ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit ! ghost cell jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt im = ig - ( 2 * k - 1 ) * din ! mirror interior cell jm = jg - ( 2 * k - 1 ) * djn ! Mirror the bed FIRST (see the note above), then the surface.  With ! b symmetric the eta-mirror below reduces to h(ig,jg) = h(im,jm); ! the general form is kept so the routine stays correct if a caller ! ever supplies an already-mirrored bed. b ( ig , jg ) = b ( im , jm ) h ( ig , jg ) = max ( 0.0_wp , h ( im , jm ) + b ( im , jm ) - b ( ig , jg )) if ( nu ) then hu ( ig , jg ) = - hu ( im , jm ) hv ( ig , jg ) = hv ( im , jm ) else hv ( ig , jg ) = - hv ( im , jm ) hu ( ig , jg ) = hu ( im , jm ) end if end do end subroutine bc_wall_edge pure subroutine bc_flather_edge ( h , hu , hv , b , grid , ed , eta_ext , prescribe_h ) !! Flather radiation for one edge.  Shared by OPEN (eta_ext = 0, !! prescribe_h = .false. -> zero-gradient ghost depth) and TIDAL !! (eta_ext = tidal_eta, prescribe_h = .true. -> ghost depth from !! the prescribed surface).  The NORMAL momentum radiates the !! surface anomaly outward (sign from ed%nrm_sign); the tangential !! momentum is copied from the first interior cell. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed real ( wp ), intent ( in ) :: eta_ext logical , intent ( in ) :: prescribe_h integer :: t , k , ig , jg , ii , ji , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan real ( wp ) :: sgn , h_int , eta_int , speed , hmax , h_ghost logical :: nu nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u sgn = ed % nrm_sign do concurrent ( t = 1 : n_tan , k = 1 : nghost ) & local ( ig , jg , ii , ji , h_int , eta_int , speed , hmax , h_ghost ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ! first interior cell at this tangential index ji = jg0 + ( t - 1 ) * djt - djn h_int = h ( ii , ji ) eta_int = h_int + b ( ii , ji ) hmax = max ( h_int , 1.0e-6_wp ) speed = sqrt ( GRAVITY * hmax ) h_ghost = merge ( max ( 0.0_wp , eta_ext - b ( ig , jg )), h_int , prescribe_h ) h ( ig , jg ) = h_ghost if ( nu ) then hu ( ig , jg ) = h_ghost * ( hu ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ext ) / hmax ) hv ( ig , jg ) = hv ( ii , ji ) else hv ( ig , jg ) = h_ghost * ( hv ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ext ) / hmax ) hu ( ig , jg ) = hu ( ii , ji ) end if end do end subroutine bc_flather_edge pure subroutine bc_inflow_edge ( h , hu , hv , b , grid , ed , vel ) !! Inflow: zero-gradient ghost depth; the NORMAL momentum is the !! prescribed inward transport h_ghost*vel (inward = -ed%nrm_sign); !! tangential momentum copied from the first interior cell. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed real ( wp ), intent ( in ) :: vel integer :: t , k , ig , jg , ii , ji , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan real ( wp ) :: in_sgn , h_int logical :: nu nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u in_sgn = - ed % nrm_sign do concurrent ( t = 1 : n_tan , k = 1 : nghost ) local ( ig , jg , ii , ji , h_int ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ji = jg0 + ( t - 1 ) * djt - djn h_int = h ( ii , ji ) h ( ig , jg ) = h_int if ( nu ) then hu ( ig , jg ) = in_sgn * h_int * vel hv ( ig , jg ) = hv ( ii , ji ) else hv ( ig , jg ) = in_sgn * h_int * vel hu ( ig , jg ) = hu ( ii , ji ) end if end do end subroutine bc_inflow_edge pure subroutine bc_disch_edge ( h , hu , hv , b , grid , ed , flux ) !! Discharge: zero-gradient ghost depth; the NORMAL momentum (the !! depth-integrated transport) is set directly to the prescribed !! inward flux (inward = -ed%nrm_sign); tangential momentum copied. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed real ( wp ), intent ( in ) :: flux integer :: t , k , ig , jg , ii , ji , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan real ( wp ) :: in_sgn logical :: nu nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u in_sgn = - ed % nrm_sign do concurrent ( t = 1 : n_tan , k = 1 : nghost ) local ( ig , jg , ii , ji ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ji = jg0 + ( t - 1 ) * djt - djn h ( ig , jg ) = h ( ii , ji ) if ( nu ) then hu ( ig , jg ) = in_sgn * flux hv ( ig , jg ) = hv ( ii , ji ) else hv ( ig , jg ) = in_sgn * flux hu ( ig , jg ) = hu ( ii , ji ) end if end do end subroutine bc_disch_edge pure subroutine bc_clamped_edge ( h , hu , hv , b , grid , ed , eta ) !! Clamped (Dirichlet surface): prescribe the ghost depth from the !! clamped elevation; copy BOTH momenta from the first interior !! cell (no normal/tangential distinction). type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed real ( wp ), intent ( in ) :: eta integer :: t , k , ig , jg , ii , ji , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan do concurrent ( t = 1 : n_tan , k = 1 : nghost ) local ( ig , jg , ii , ji ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ji = jg0 + ( t - 1 ) * djt - djn h ( ig , jg ) = max ( 0.0_wp , eta - b ( ig , jg )) hu ( ig , jg ) = hu ( ii , ji ) hv ( ig , jg ) = hv ( ii , ji ) end do end subroutine bc_clamped_edge pure subroutine bc_chapman_edge ( h , hu , hv , b , grid , ed , eta_old , dt , dx , dy ) !! Chapman / Orlanski radiation for one edge.  The ghost surface !! advects at a clamped, non-negative phase speed estimated from the !! interior eta tendency and along-normal gradient; the momentum is !! the Flather radiation about that surface (sign ed%nrm_sign). !! `eta_old` is this edge's persistent surface (length n_tan), !! refreshed to the interior eta on the k==1 layer (per-t writes are !! disjoint).  `dd = dx` on W/E, `dy` on S/N. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed ! assumed-shape-ok: eta_old is a 1D edge-count-sized array; its length ! varies per boundary edge and is not a grid-level nx/ny dimension. real ( wp ), intent ( inout ) :: eta_old (:) real ( wp ), intent ( in ) :: dt , dx , dy integer :: t , k , ig , jg , ii , ji , i2 , j2 , nx , ny , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan real ( wp ) :: sgn , dd , h_int , eta_int , eta_old_val , speed , hmax real ( wp ) :: deta_dt , deta_dx , c_phase , eta_ghost_new , h_ghost logical :: nu nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u sgn = ed % nrm_sign dd = merge ( dx , dy , nu ) do concurrent ( t = 1 : n_tan , k = 1 : nghost ) & local ( ig , jg , ii , ji , i2 , j2 , h_int , eta_int , eta_old_val , speed , & hmax , deta_dt , deta_dx , c_phase , eta_ghost_new , h_ghost ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ! first interior cell ji = jg0 + ( t - 1 ) * djt - djn i2 = ii - din ! second interior (along normal) j2 = ji - djn h_int = h ( ii , ji ) eta_int = h_int + b ( ii , ji ) eta_old_val = eta_old ( t ) hmax = max ( h_int , 1.0e-6_wp ) speed = sqrt ( GRAVITY * hmax ) if ( dt > 0.0_wp ) then deta_dt = ( eta_int - eta_old_val ) / dt if ( i2 >= 1 . and . i2 <= nx . and . j2 >= 1 . and . j2 <= ny ) then deta_dx = ( h ( i2 , j2 ) + b ( i2 , j2 ) - eta_int ) / dd else deta_dx = 0.0_wp end if if ( abs ( deta_dx ) > 1.0e-10_wp ) then c_phase = - deta_dt / deta_dx else c_phase = 0.0_wp end if c_phase = max ( 0.0_wp , min ( c_phase , speed )) eta_ghost_new = eta_old_val - c_phase * dt / dd * ( eta_old_val - eta_int ) else eta_ghost_new = eta_int end if if ( k == 1 ) eta_old ( t ) = eta_int h_ghost = max ( 0.0_wp , eta_ghost_new - b ( ig , jg )) h ( ig , jg ) = h_ghost if ( nu ) then hu ( ig , jg ) = h_ghost * ( hu ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ghost_new ) / hmax ) hv ( ig , jg ) = hv ( ii , ji ) else hv ( ig , jg ) = h_ghost * ( hv ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ghost_new ) / hmax ) hu ( ig , jg ) = hu ( ii , ji ) end if end do end subroutine bc_chapman_edge pure subroutine apply_nh_boundary_conditions ( q_nh , u_layer , v_layer , w , h , b , & grid , nz , bc ) !! Fill ghost cells for non-hydrostatic variables !! !! q_nh: zero-gradient (Neumann) at all boundaries !! u_layer, v_layer: mirror/negate at walls, extrapolate at open !! w: zero-gradient laterally type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( bc_params_t ), intent ( in ) :: bc integer :: i , j , k , g , nx , ny , nghost integer :: i_first , i_last , j_first , j_last integer :: bc_w , bc_e , bc_s , bc_n nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost i_first = nghost + 1 i_last = nx - nghost j_first = nghost + 1 j_last = ny - nghost ! Extract bc types into local scalars for GPU accessibility bc_w = bc % west bc_e = bc % east bc_s = bc % south bc_n = bc % north ! ---- West boundary ---- do concurrent ( k = 1 : nz , j = 1 : ny , g = 1 : nghost ) select case ( bc_w ) case ( BC_WALL ) q_nh ( i_first - g , j , k ) = q_nh ( i_first + g - 1 , j , k ) u_layer ( i_first - g , j , k ) = - u_layer ( i_first + g - 1 , j , k ) v_layer ( i_first - g , j , k ) = v_layer ( i_first + g - 1 , j , k ) case default q_nh ( i_first - g , j , k ) = q_nh ( i_first + g - 1 , j , k ) u_layer ( i_first - g , j , k ) = u_layer ( i_first + g - 1 , j , k ) v_layer ( i_first - g , j , k ) = v_layer ( i_first + g - 1 , j , k ) end select end do do concurrent ( k = 1 : nz + 1 , j = 1 : ny , g = 1 : nghost ) w ( i_first - g , j , k ) = w ( i_first + g - 1 , j , k ) end do ! ---- East boundary ---- do concurrent ( k = 1 : nz , j = 1 : ny , g = 1 : nghost ) select case ( bc_e ) case ( BC_WALL ) q_nh ( i_last + g , j , k ) = q_nh ( i_last - g + 1 , j , k ) u_layer ( i_last + g , j , k ) = - u_layer ( i_last - g + 1 , j , k ) v_layer ( i_last + g , j , k ) = v_layer ( i_last - g + 1 , j , k ) case default q_nh ( i_last + g , j , k ) = q_nh ( i_last - g + 1 , j , k ) u_layer ( i_last + g , j , k ) = u_layer ( i_last - g + 1 , j , k ) v_layer ( i_last + g , j , k ) = v_layer ( i_last - g + 1 , j , k ) end select end do do concurrent ( k = 1 : nz + 1 , j = 1 : ny , g = 1 : nghost ) w ( i_last + g , j , k ) = w ( i_last - g + 1 , j , k ) end do ! ---- South boundary ---- do concurrent ( k = 1 : nz , i = 1 : nx , g = 1 : nghost ) select case ( bc_s ) case ( BC_WALL ) q_nh ( i , j_first - g , k ) = q_nh ( i , j_first + g - 1 , k ) u_layer ( i , j_first - g , k ) = u_layer ( i , j_first + g - 1 , k ) v_layer ( i , j_first - g , k ) = - v_layer ( i , j_first + g - 1 , k ) case default q_nh ( i , j_first - g , k ) = q_nh ( i , j_first + g - 1 , k ) u_layer ( i , j_first - g , k ) = u_layer ( i , j_first + g - 1 , k ) v_layer ( i , j_first - g , k ) = v_layer ( i , j_first + g - 1 , k ) end select end do do concurrent ( k = 1 : nz + 1 , i = 1 : nx , g = 1 : nghost ) w ( i , j_first - g , k ) = w ( i , j_first + g - 1 , k ) end do ! ---- North boundary ---- do concurrent ( k = 1 : nz , i = 1 : nx , g = 1 : nghost ) select case ( bc_n ) case ( BC_WALL ) q_nh ( i , j_last + g , k ) = q_nh ( i , j_last - g + 1 , k ) u_layer ( i , j_last + g , k ) = u_layer ( i , j_last - g + 1 , k ) v_layer ( i , j_last + g , k ) = - v_layer ( i , j_last - g + 1 , k ) case default q_nh ( i , j_last + g , k ) = q_nh ( i , j_last - g + 1 , k ) u_layer ( i , j_last + g , k ) = u_layer ( i , j_last - g + 1 , k ) v_layer ( i , j_last + g , k ) = v_layer ( i , j_last - g + 1 , k ) end select end do do concurrent ( k = 1 : nz + 1 , i = 1 : nx , g = 1 : nghost ) w ( i , j_last + g , k ) = w ( i , j_last - g + 1 , k ) end do end subroutine apply_nh_boundary_conditions end module rki_boundary","tags":"","url":"sourcefile/rki_boundary.f90.html"},{"title":"rki_bathymetry.F90 – Rakali","text":"Bathymetry loading from NetCDF files This file depends on sourcefile~~rki_bathymetry.f90~~EfferentGraph sourcefile~rki_bathymetry.f90 rki_bathymetry.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_bathymetry.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_bathymetry.f90->sourcefile~rki_grid.f90 sourcefile~rki_io_netcdf.f90 rki_io_netcdf.F90 sourcefile~rki_bathymetry.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_io_netcdf.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_bathymetry.f90~~AfferentGraph sourcefile~rki_bathymetry.f90 rki_bathymetry.F90 sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_state.f90->sourcefile~rki_bathymetry.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90 rki_handle.F90 sourcefile~rki_api.f90->sourcefile~rki_handle.f90 sourcefile~rki_init.f90 rki_init.F90 sourcefile~rki_api.f90->sourcefile~rki_init.f90 sourcefile~rki_output.f90 rki_output.F90 sourcefile~rki_api.f90->sourcefile~rki_output.f90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_coastal_console_stats.f90 rki_coastal_console_stats.F90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_init.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_state.f90 sourcefile~rki_driver.f90->sourcefile~rki_coastal_console_stats.f90 sourcefile~rki_forcing.f90 rki_forcing.F90 sourcefile~rki_driver.f90->sourcefile~rki_forcing.f90 sourcefile~rki_gauges.f90 rki_gauges.F90 sourcefile~rki_driver.f90->sourcefile~rki_gauges.f90 sourcefile~rki_driver.f90->sourcefile~rki_init.f90 sourcefile~rki_nesting.f90 rki_nesting.F90 sourcefile~rki_driver.f90->sourcefile~rki_nesting.f90 sourcefile~rki_driver.f90->sourcefile~rki_output.f90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_forcing.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90->sourcefile~rki_state.f90 sourcefile~rki_init.f90->sourcefile~rki_state.f90 sourcefile~rki_nesting.f90->sourcefile~rki_state.f90 sourcefile~rki_output.f90->sourcefile~rki_state.f90 sourcefile~rki_solver.f90->sourcefile~rki_state.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Bathymetry loading from NetCDF files module rki_bathymetry !! Reads bathymetry (bottom elevation) from a NetCDF file and populates !! the state%barotropic%b array. Expects a 2D variable on a structured grid. !! If no file is configured, falls back to flat bottom. use rki_constants , only : wp use rki_grid , only : hgrid_t use rki_io_netcdf , only : nc_check , nc_open_read , nc_close , & nc_get_dim_len , nc_get_varid , nc_get_var_2d use netcdf , only : nf90_inquire_variable , nf90_inquire_dimension use pic_logger , only : logger => global_logger use pic_strings , only : to_string implicit none private public :: load_bathymetry_into_array public :: fill_bathymetry_ghosts_array contains subroutine load_bathymetry_into_array ( filename , b , grid ) !! Load bathymetry from a NetCDF file into a target 2D array !! shaped `(grid%nx_total, grid%ny_total)`. !! !! The file must contain: !!   - Dimensions: x (nx_phys), y (ny_phys) !!   - Variable: b(x, y) or elevation(x, y) or depth(x, y) !! !! Handles NetCDF C/Fortran dimension reversal: files written by !! Python/C store b(x,y) in C order, which Fortran reads as b(y,x). !! If the direct dimensions don't match but the transposed ones do, !! we read transposed and copy correctly. !! !! Bathymetry lands in the interior; ghost cells are filled by !! constant extrapolation from the nearest interior cell via !! `fill_bathymetry_ghosts_array`. character ( len =* ), intent ( in ) :: filename real ( wp ), intent ( inout ) :: b (:, :) type ( hgrid_t ), intent ( in ) :: grid integer :: ncid , varid , file_nx , file_ny integer :: ng , i , j integer :: var_dimids ( 2 ) integer :: var_ndims , dim1_len , dim2_len integer :: status character ( len = 64 ) :: dim1_name , dim2_name logical :: needs_transpose real ( wp ), allocatable :: b_interior (:, :) call logger % info ( \"Loading bathymetry from: \" // trim ( filename )) call nc_open_read ( filename , ncid ) ! Read grid dimensions (by name — these are the logical sizes) call nc_get_dim_len ( ncid , \"x\" , file_nx ) call nc_get_dim_len ( ncid , \"y\" , file_ny ) ! Try variable names in order: b, elevation, depth call try_get_bathymetry_var ( ncid , varid ) ! Query the variable's actual dimension order in the file. ! Files written by Python/C store b(x,y) in C-order. Fortran's ! NetCDF library reverses this, so the variable appears as b(y,x) ! in Fortran. We detect this by checking the first dimension name. call nc_check ( nf90_inquire_variable ( ncid , varid , ndims = var_ndims , & dimids = var_dimids ), \"querying bathymetry variable\" ) call nc_check ( nf90_inquire_dimension ( ncid , var_dimids ( 1 ), & name = dim1_name , len = dim1_len ), \"querying dim 1\" ) call nc_check ( nf90_inquire_dimension ( ncid , var_dimids ( 2 ), & name = dim2_name , len = dim2_len ), \"querying dim 2\" ) call logger % info ( \"Bathymetry variable: \" // trim ( dim1_name ) // \"=\" // & to_string ( dim1_len ) // \" x \" // trim ( dim2_name ) // \"=\" // & to_string ( dim2_len ) // \" (Fortran order)\" ) ! In Fortran, dim1 is the first array index (varies fastest). ! If dim1 is \"x\" and matches nx, no transpose needed. ! If dim1 is \"y\" (C-order file reversed), we need to transpose. needs_transpose = ( trim ( dim1_name ) == \"y\" ) ! Validate dimensions if ( needs_transpose ) then if ( dim1_len /= grid % ny_phys . or . dim2_len /= grid % nx_phys ) then call logger % error ( \"Bathymetry grid mismatch: file has \" // & to_string ( dim2_len ) // \" x \" // to_string ( dim1_len ) // & \" but simulation expects \" // & to_string ( grid % nx_phys ) // \" x \" // & to_string ( grid % ny_phys )) call nc_close ( ncid ) error stop \"Bathymetry grid mismatch\" end if else if ( dim1_len /= grid % nx_phys . or . dim2_len /= grid % ny_phys ) then call logger % error ( \"Bathymetry grid mismatch: file has \" // & to_string ( dim1_len ) // \" x \" // to_string ( dim2_len ) // & \" but simulation expects \" // & to_string ( grid % nx_phys ) // \" x \" // & to_string ( grid % ny_phys )) call nc_close ( ncid ) error stop \"Bathymetry grid mismatch\" end if end if ng = grid % nghost ! Read into temporary array matching the Fortran storage order allocate ( b_interior ( dim1_len , dim2_len )) call nc_get_var_2d ( ncid , varid , b_interior ) call nc_close ( ncid ) if ( needs_transpose ) then ! b_interior is (y, x) in Fortran — transpose to (x, y) for b do j = 1 , grid % ny_phys do i = 1 , grid % nx_phys b ( ng + i , ng + j ) = b_interior ( j , i ) end do end do else b ( ng + 1 : ng + grid % nx_phys , ng + 1 : ng + grid % ny_phys ) = b_interior end if deallocate ( b_interior ) ! Fill ghost cells by constant extrapolation from nearest interior cell. ! Without this, ghost cells retain b=0 which creates artificial cliffs ! against real bathymetry (e.g. b=-50m interior vs b=0 ghost), generating ! extreme velocities and tiny CFL timesteps. call fill_bathymetry_ghosts_array ( b , grid ) call logger % info ( \"Bathymetry loaded: min = \" // & to_string ( minval ( b ( ng + 1 : ng + grid % nx_phys , & ng + 1 : ng + grid % ny_phys ))) // & \" m, max = \" // & to_string ( maxval ( b ( ng + 1 : ng + grid % nx_phys , & ng + 1 : ng + grid % ny_phys ))) // & \" m\" ) end subroutine load_bathymetry_into_array subroutine try_get_bathymetry_var ( ncid , varid ) !! Try to find the bathymetry variable by common names use netcdf , only : nf90_noerr , nf90_inq_varid integer , intent ( in ) :: ncid integer , intent ( out ) :: varid integer :: status ! Try \"b\" first (our convention) status = nf90_inq_varid ( ncid , \"b\" , varid ) if ( status == nf90_noerr ) return ! Try \"elevation\" status = nf90_inq_varid ( ncid , \"elevation\" , varid ) if ( status == nf90_noerr ) return ! Try \"depth\" status = nf90_inq_varid ( ncid , \"depth\" , varid ) if ( status == nf90_noerr ) return ! None found call logger % error ( \"No bathymetry variable found (tried: b, elevation, depth)\" ) end subroutine try_get_bathymetry_var subroutine fill_bathymetry_ghosts_array ( b , grid ) !! Fill ghost cell bathymetry by constant extrapolation from the !! nearest interior cell.  This ensures boundary flux computations !! see a consistent bottom elevation across the ghost-interior !! interface.  Works on a target 2D array directly so both the !! coastal and ocean barotropic slots can reuse it. real ( wp ), intent ( inout ) :: b (:, :) type ( hgrid_t ), intent ( in ) :: grid integer :: ng , i , j , nx , ny ng = grid % nghost nx = grid % nx_phys ny = grid % ny_phys ! West and east ghost columns do j = 1 , grid % ny_total do i = 1 , ng b ( i , j ) = b ( ng + 1 , j ) ! west b ( ng + nx + i , j ) = b ( ng + nx , j ) ! east end do end do ! South and north ghost rows (corners already filled above) do j = 1 , ng do i = 1 , grid % nx_total b ( i , j ) = b ( i , ng + 1 ) ! south b ( i , ng + ny + j ) = b ( i , ng + ny ) ! north end do end do end subroutine fill_bathymetry_ghosts_array end module rki_bathymetry","tags":"","url":"sourcefile/rki_bathymetry.f90.html"},{"title":"rki_ml_tracers_unstr.F90 – Rakali","text":"Tracer machinery for the unstructured multilayer solver. This file depends on sourcefile~~rki_ml_tracers_unstr.f90~~EfferentGraph sourcefile~rki_ml_tracers_unstr.f90 rki_ml_tracers_unstr.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_tracers_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_ml_tracers_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_ml_common_unstr.f90 rki_ml_common_unstr.F90 sourcefile~rki_ml_tracers_unstr.f90->sourcefile~rki_ml_common_unstr.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_ml_tracers_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_barotropic_state_unstr.f90 rki_barotropic_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_barotropic_state_unstr.f90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_state_unstr.f90->source