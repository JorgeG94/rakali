proc~output_unstr_init->proc~create_ugrid_file proc~output_unstr_init_from_arrays output_unstr_init_from_arrays proc~output_unstr_init_from_arrays->proc~create_ugrid_file proc~rki_unstr_output_init rki_unstr_output_init proc~rki_unstr_output_init->proc~output_unstr_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: bed_varid integer, private :: cgid_varid integer, private :: conn_varid integer, private :: face_area_varid integer, private :: face_dimid integer, private :: face_x_varid integer, private :: face_y_varid integer, private :: ncid integer, private :: node_dimid integer, private :: node_x_varid integer, private :: node_y_varid integer, private :: stage_varid integer, private :: three_dimid integer, private :: time_dimid integer, private :: time_varid integer, private :: topo_varid integer, private :: xmom_varid integer, private :: ymom_varid Source Code subroutine create_ugrid_file ( ostate , filename , nverts , ncells , & vert_x , vert_y , tri_v , & centroid_x , centroid_y , area , bed , & cell_global_id , dlev , state ) !! Shared implementation: create file, define UGRID topology, write !! static data. Both public init routines delegate here.  When !! `state` is present and `state%use_multilayer` is true, also !! defines the 3D layer / tracer variables before exiting define !! mode. type ( output_unstr_state_t ), intent ( out ) :: ostate character ( len =* ), intent ( in ) :: filename integer , intent ( in ) :: nverts , ncells real ( wp ), intent ( in ) :: vert_x ( nverts ), vert_y ( nverts ) integer , intent ( in ) :: tri_v ( 3 , ncells ) real ( wp ), intent ( in ) :: centroid_x ( ncells ), centroid_y ( ncells ) real ( wp ), intent ( in ) :: area ( ncells ), bed ( ncells ) integer ( 8 ), intent ( in ), optional :: cell_global_id ( ncells ) integer , intent ( in ) :: dlev type ( unstr_state_t ), intent ( in ), optional :: state integer :: ncid integer :: node_dimid , face_dimid , three_dimid , time_dimid integer :: topo_varid integer :: node_x_varid , node_y_varid integer :: conn_varid integer :: face_x_varid , face_y_varid , face_area_varid integer :: bed_varid integer :: stage_varid , xmom_varid , ymom_varid integer :: time_varid integer :: cgid_varid ! ---- create file ---- call nc_create_file ( trim ( filename ), ncid ) ! ---- global attributes ---- call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.11 UGRID-1.0\" ) call nc_put_att_global ( ncid , \"title\" , \"Rakali unstructured solver output\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali\" ) call nc_put_att_global ( ncid , \"institution\" , \"NCI\" ) call nc_put_att_global_int ( ncid , \"ncells_owned\" , ncells ) call nc_put_att_global_int ( ncid , \"nverts\" , nverts ) ! ---- dimensions ---- call nc_def_dim ( ncid , \"node\" , nverts , node_dimid ) call nc_def_dim ( ncid , \"face\" , ncells , face_dimid ) call nc_def_dim ( ncid , \"three\" , 3 , three_dimid ) call nc_def_dim ( ncid , \"time\" , nf90_unlimited , time_dimid ) ! ---- mesh topology dummy variable ---- call nc_check ( nf90_def_var ( ncid , \"mesh2d\" , nf90_int , topo_varid ), & \"defining mesh2d\" ) call nc_put_att ( ncid , topo_varid , \"cf_role\" , \"mesh_topology\" ) call nc_put_att_int ( ncid , topo_varid , \"topology_dimension\" , 2 ) call nc_put_att ( ncid , topo_varid , \"node_coordinates\" , & \"mesh_node_x mesh_node_y\" ) call nc_put_att ( ncid , topo_varid , \"face_node_connectivity\" , & \"mesh_face_nodes\" ) call nc_put_att ( ncid , topo_varid , \"face_coordinates\" , & \"mesh_face_x mesh_face_y\" ) ! ---- node coordinates ---- call rki_def_var_1d ( ncid , \"mesh_node_x\" , node_dimid , node_x_varid , dlev ) call nc_put_att ( ncid , node_x_varid , \"standard_name\" , & \"projection_x_coordinate\" ) call nc_put_att ( ncid , node_x_varid , \"long_name\" , & \"x-coordinate of mesh nodes\" ) call nc_put_att ( ncid , node_x_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"mesh_node_y\" , node_dimid , node_y_varid , dlev ) call nc_put_att ( ncid , node_y_varid , \"standard_name\" , & \"projection_y_coordinate\" ) call nc_put_att ( ncid , node_y_varid , \"long_name\" , & \"y-coordinate of mesh nodes\" ) call nc_put_att ( ncid , node_y_varid , \"units\" , \"m\" ) ! ---- face-node connectivity (integer, shape three x face) ---- call nc_check ( nf90_def_var ( ncid , \"mesh_face_nodes\" , nf90_int , & [ three_dimid , face_dimid ], conn_varid ), & \"defining mesh_face_nodes\" ) call nc_put_att ( ncid , conn_varid , \"cf_role\" , \"face_node_connectivity\" ) call nc_put_att_int ( ncid , conn_varid , \"start_index\" , 1 ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , conn_varid , & shuffle = 1 , deflate = 1 , & deflate_level = dlev ), & \"enabling compression for mesh_face_nodes\" ) end if ! ---- face centroids ---- call rki_def_var_1d ( ncid , \"mesh_face_x\" , face_dimid , face_x_varid , dlev ) call nc_put_att ( ncid , face_x_varid , \"long_name\" , & \"x-coordinate of face centroids\" ) call nc_put_att ( ncid , face_x_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"mesh_face_y\" , face_dimid , face_y_varid , dlev ) call nc_put_att ( ncid , face_y_varid , \"long_name\" , & \"y-coordinate of face centroids\" ) call nc_put_att ( ncid , face_y_varid , \"units\" , \"m\" ) ! ---- face area ---- call rki_def_var_1d ( ncid , \"mesh_face_area\" , face_dimid , & face_area_varid , dlev ) call nc_put_att ( ncid , face_area_varid , \"long_name\" , \"Triangle area\" ) call nc_put_att ( ncid , face_area_varid , \"units\" , \"m2\" ) ! ---- bathymetry (static, face) ---- call rki_def_var_1d ( ncid , \"bed\" , face_dimid , bed_varid , dlev ) call nc_put_att ( ncid , bed_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , bed_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , bed_varid , \"long_name\" , \"Bed elevation\" ) call nc_put_att ( ncid , bed_varid , \"units\" , \"m\" ) ! ---- cell global id ---- if ( present ( cell_global_id )) then call nc_check ( nf90_def_var ( ncid , \"cell_global_id\" , nf90_int64 , & [ face_dimid ], cgid_varid ), & \"defining cell_global_id\" ) call nc_put_att ( ncid , cgid_varid , \"long_name\" , & \"Cell index\" ) end if ! ---- time ---- call rki_def_var_1d ( ncid , \"time\" , time_dimid , time_varid ) call nc_put_att ( ncid , time_varid , \"units\" , & \"seconds since simulation start\" ) call nc_put_att ( ncid , time_varid , \"calendar\" , \"none\" ) call nc_put_att ( ncid , time_varid , \"axis\" , \"T\" ) ! ---- time-varying solution fields (face, time) ---- call nc_def_var_2d ( ncid , \"stage\" , [ face_dimid , time_dimid ], & stage_varid , dlev ) call nc_put_att ( ncid , stage_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , stage_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , stage_varid , \"long_name\" , & \"Free-surface elevation\" ) call nc_put_att ( ncid , stage_varid , \"units\" , \"m\" ) call nc_def_var_2d ( ncid , \"xmom\" , [ face_dimid , time_dimid ], & xmom_varid , dlev ) call nc_put_att ( ncid , xmom_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , xmom_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , xmom_varid , \"long_name\" , \"x-momentum (h*u)\" ) call nc_put_att ( ncid , xmom_varid , \"units\" , \"m2/s\" ) call nc_def_var_2d ( ncid , \"ymom\" , [ face_dimid , time_dimid ], & ymom_varid , dlev ) call nc_put_att ( ncid , ymom_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ymom_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ymom_varid , \"long_name\" , \"y-momentum (h*v)\" ) call nc_put_att ( ncid , ymom_varid , \"units\" , \"m2/s\" ) ! ---- multilayer outputs (only when state%use_multilayer) ---- ! Defined here while still in define mode so we get one nc_enddef ! for the whole file.  Variables go in (face, layer, time) order ! to match the unstructured convention `(nz_ml, ncells)` flipped ! so layer is the slow axis on disk. if ( present ( state )) then if ( state % use_multilayer ) then call define_multilayer_outputs ( ostate , ncid , face_dimid , & time_dimid , dlev , state ) end if end if ! ---- end define mode, write static data ---- call nc_enddef ( ncid ) call rki_put_var_1d ( ncid , node_x_varid , vert_x ) call rki_put_var_1d ( ncid , node_y_varid , vert_y ) call nc_check ( nf90_put_var ( ncid , conn_varid , tri_v ), & \"writing mesh_face_nodes\" ) call rki_put_var_1d ( ncid , face_x_varid , centroid_x ) call rki_put_var_1d ( ncid , face_y_varid , centroid_y ) call rki_put_var_1d ( ncid , face_area_varid , area ) call rki_put_var_1d ( ncid , bed_varid , bed ) if ( present ( cell_global_id )) then call nc_check ( nf90_put_var ( ncid , cgid_varid , cell_global_id ), & \"writing cell_global_id\" ) end if ! Stash handles for snapshot writes ostate % ncid = ncid ostate % time_dimid = time_dimid ostate % time_varid = time_varid ostate % stage_varid = stage_varid ostate % xmom_varid = xmom_varid ostate % ymom_varid = ymom_varid ostate % time_index = 0 ostate % ncells = ncells call logger % info ( \"UGRID output initialised: \" // trim ( filename ) // & \" (\" // to_string ( ncells ) // \" faces, \" // & to_string ( nverts ) // \" nodes)\" ) end subroutine create_ugrid_file","tags":"","url":"proc/create_ugrid_file.html"},{"title":"define_multilayer_outputs – Rakali","text":"private  subroutine define_multilayer_outputs(ostate, ncid, face_dimid, time_dimid, dlev, state) Define the 3D layer / tracer variables on a UGRID file that’s\nstill in define mode.  Per-tracer variables come from the\nregistry — one NetCDF variable per state%multilayer%tracers(:) entry, metadata pulled directly from each unstr_tracer_t .\nAdding a sediment / passive scalar produces a correctly-\nlabelled output variable with no I/O changes. Dim order [nz_dimid, face_dimid, time_dimid] matches the\nin-memory (nz_ml, ncells_total) layout so each snapshot is a\nsingle contiguous nf90_put_var (no transpose buffer needed). Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(inout) :: ostate integer, intent(in) :: ncid integer, intent(in) :: face_dimid integer, intent(in) :: time_dimid integer, intent(in) :: dlev type( unstr_state_t ), intent(in) :: state Calls proc~~define_multilayer_outputs~~CallsGraph proc~define_multilayer_outputs define_multilayer_outputs nf90_def_var nf90_def_var proc~define_multilayer_outputs->nf90_def_var nf90_def_var_deflate nf90_def_var_deflate proc~define_multilayer_outputs->nf90_def_var_deflate proc~nc_check nc_check proc~define_multilayer_outputs->proc~nc_check proc~nc_def_dim nc_def_dim proc~define_multilayer_outputs->proc~nc_def_dim proc~nc_put_att nc_put_att proc~define_multilayer_outputs->proc~nc_put_att error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_def_dim->proc~nc_check nf90_def_dim nf90_def_dim proc~nc_def_dim->nf90_def_dim proc~nc_put_att->proc~nc_check nf90_put_att nf90_put_att proc~nc_put_att->nf90_put_att Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~define_multilayer_outputs~~CalledByGraph proc~define_multilayer_outputs define_multilayer_outputs proc~create_ugrid_file create_ugrid_file proc~create_ugrid_file->proc~define_multilayer_outputs proc~output_unstr_init output_unstr_init proc~output_unstr_init->proc~create_ugrid_file proc~output_unstr_init_from_arrays output_unstr_init_from_arrays proc~output_unstr_init_from_arrays->proc~create_ugrid_file proc~rki_unstr_output_init rki_unstr_output_init proc~rki_unstr_output_init->proc~output_unstr_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: dimids_3d (3) integer, private :: dimids_3d_w (3) integer, private :: it integer, private :: nz_dimid integer, private :: nzi_dimid integer, private :: varid Source Code subroutine define_multilayer_outputs ( ostate , ncid , face_dimid , time_dimid , & dlev , state ) !! Define the 3D layer / tracer variables on a UGRID file that's !! still in define mode.  Per-tracer variables come from the !! registry — one NetCDF variable per `state%multilayer%tracers(:)` !! entry, metadata pulled directly from each `unstr_tracer_t`. !! Adding a sediment / passive scalar produces a correctly- !! labelled output variable with no I/O changes. !! !! Dim order `[nz_dimid, face_dimid, time_dimid]` matches the !! in-memory `(nz_ml, ncells_total)` layout so each snapshot is a !! single contiguous `nf90_put_var` (no transpose buffer needed). type ( output_unstr_state_t ), intent ( inout ) :: ostate integer , intent ( in ) :: ncid , face_dimid , time_dimid , dlev type ( unstr_state_t ), intent ( in ) :: state integer :: nz_dimid , nzi_dimid integer :: dimids_3d ( 3 ), dimids_3d_w ( 3 ) integer :: it , varid ostate % has_ml = . true . ostate % nz_ml = state % multilayer % nz_ml call nc_def_dim ( ncid , \"nz_ml\" , state % multilayer % nz_ml , nz_dimid ) call nc_def_dim ( ncid , \"nz_ml_interface\" , state % multilayer % nz_ml + 1 , nzi_dimid ) dimids_3d = [ nz_dimid , face_dimid , time_dimid ] dimids_3d_w = [ nzi_dimid , face_dimid , time_dimid ] ! Layer thickness (m) call nc_check ( nf90_def_var ( ncid , \"h_layer\" , NC_WP , dimids_3d , & ostate % ml_h_layer_varid ), & \"defining h_layer\" ) call nc_put_att ( ncid , ostate % ml_h_layer_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ostate % ml_h_layer_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ostate % ml_h_layer_varid , \"long_name\" , \"Layer thickness\" ) call nc_put_att ( ncid , ostate % ml_h_layer_varid , \"units\" , \"m\" ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , ostate % ml_h_layer_varid , & shuffle = 1 , deflate = 1 , deflate_level = dlev ), & \"compress h_layer\" ) end if ! Layer x-velocity (derived: hu_layer / h_layer) call nc_check ( nf90_def_var ( ncid , \"u_ml\" , NC_WP , dimids_3d , ostate % ml_u_varid ), & \"defining u_ml\" ) call nc_put_att ( ncid , ostate % ml_u_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ostate % ml_u_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ostate % ml_u_varid , \"long_name\" , \"Layer x-velocity\" ) call nc_put_att ( ncid , ostate % ml_u_varid , \"units\" , \"m s-1\" ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , ostate % ml_u_varid , & shuffle = 1 , deflate = 1 , deflate_level = dlev ), & \"compress u_ml\" ) end if ! Layer y-velocity call nc_check ( nf90_def_var ( ncid , \"v_ml\" , NC_WP , dimids_3d , ostate % ml_v_varid ), & \"defining v_ml\" ) call nc_put_att ( ncid , ostate % ml_v_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ostate % ml_v_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ostate % ml_v_varid , \"long_name\" , \"Layer y-velocity\" ) call nc_put_att ( ncid , ostate % ml_v_varid , \"units\" , \"m s-1\" ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , ostate % ml_v_varid , & shuffle = 1 , deflate = 1 , deflate_level = dlev ), & \"compress v_ml\" ) end if ! Layer density call nc_check ( nf90_def_var ( ncid , \"rho_layer\" , NC_WP , dimids_3d , & ostate % ml_rho_varid ), & \"defining rho_layer\" ) call nc_put_att ( ncid , ostate % ml_rho_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ostate % ml_rho_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ostate % ml_rho_varid , \"standard_name\" , \"sea_water_density\" ) call nc_put_att ( ncid , ostate % ml_rho_varid , \"long_name\" , \"Layer density\" ) call nc_put_att ( ncid , ostate % ml_rho_varid , \"units\" , \"kg m-3\" ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , ostate % ml_rho_varid , & shuffle = 1 , deflate = 1 , deflate_level = dlev ), & \"compress rho_layer\" ) end if ! Vertical velocity at layer interfaces (nz_ml + 1) call nc_check ( nf90_def_var ( ncid , \"w_interface\" , NC_WP , dimids_3d_w , & ostate % ml_w_varid ), & \"defining w_interface\" ) call nc_put_att ( ncid , ostate % ml_w_varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , ostate % ml_w_varid , \"location\" , \"face\" ) call nc_put_att ( ncid , ostate % ml_w_varid , \"long_name\" , & \"Vertical velocity at layer interfaces\" ) call nc_put_att ( ncid , ostate % ml_w_varid , \"units\" , \"m s-1\" ) if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , ostate % ml_w_varid , & shuffle = 1 , deflate = 1 , deflate_level = dlev ), & \"compress w_interface\" ) end if ! ---- Tracer registry: one variable per registered tracer ---- if ( allocated ( state % multilayer % tracers )) then allocate ( ostate % ml_tracer_varids ( size ( state % multilayer % tracers ))) ostate % ml_tracer_varids = - 1 do it = 1 , size ( state % multilayer % tracers ) associate ( tr => state % multilayer % tracers ( it )) if ( len_trim ( tr % name ) == 0 ) cycle call nc_check ( nf90_def_var ( ncid , trim ( tr % name ), NC_WP , & dimids_3d , varid ), & \"defining tracer \" // trim ( tr % name )) ostate % ml_tracer_varids ( it ) = varid call nc_put_att ( ncid , varid , \"mesh\" , \"mesh2d\" ) call nc_put_att ( ncid , varid , \"location\" , \"face\" ) if ( len_trim ( tr % units ) > 0 ) then call nc_put_att ( ncid , varid , \"units\" , trim ( tr % units )) end if if ( len_trim ( tr % long_name ) > 0 ) then call nc_put_att ( ncid , varid , \"long_name\" , trim ( tr % long_name )) end if if ( len_trim ( tr % standard_name ) > 0 ) then call nc_put_att ( ncid , varid , \"standard_name\" , trim ( tr % standard_name )) end if if ( dlev > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , varid , & shuffle = 1 , deflate = 1 , & deflate_level = dlev ), & \"compress \" // trim ( tr % name )) end if end associate end do end if end subroutine define_multilayer_outputs","tags":"","url":"proc/define_multilayer_outputs.html"},{"title":"write_multilayer_snapshot – Rakali","text":"private  subroutine write_multilayer_snapshot(ostate, state) Write the 3D layer fields + per-tracer fields for the current\ntime index.  Velocities are derived from hu_layer / h_layer with a dry-cell guard; tracers from tracers(it)%hTr / h_layer . Memory layout (nz_ml, ncells_total) matches the file layout [nz_dimid, face_dimid, time_dimid] so each field is one\ncontiguous nf90_put_var — no transpose buffer. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(inout) :: ostate type( unstr_state_t ), intent(in) :: state Calls proc~~write_multilayer_snapshot~~CallsGraph proc~write_multilayer_snapshot write_multilayer_snapshot nf90_put_var nf90_put_var proc~write_multilayer_snapshot->nf90_put_var proc~nc_check nc_check proc~write_multilayer_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~write_multilayer_snapshot~~CalledByGraph proc~write_multilayer_snapshot write_multilayer_snapshot proc~output_unstr_write_snapshot output_unstr_write_snapshot proc~output_unstr_write_snapshot->proc~write_multilayer_snapshot proc~rki_unstr_output_write rki_unstr_output_write proc~rki_unstr_output_write->proc~output_unstr_write_snapshot Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, allocatable :: buf (:,:) integer, private :: cc real(kind=wp), private :: h_k integer, private :: it integer, private :: kk integer, private :: n integer, private :: nz integer, private :: ti Source Code subroutine write_multilayer_snapshot ( ostate , state ) !! Write the 3D layer fields + per-tracer fields for the current !! time index.  Velocities are derived from `hu_layer / h_layer` !! with a dry-cell guard; tracers from `tracers(it)%hTr / h_layer`. !! !! Memory layout `(nz_ml, ncells_total)` matches the file layout !! `[nz_dimid, face_dimid, time_dimid]` so each field is one !! contiguous `nf90_put_var` — no transpose buffer. type ( output_unstr_state_t ), intent ( inout ) :: ostate type ( unstr_state_t ), intent ( in ) :: state integer :: ti , n , nz , kk , cc , it real ( wp ), allocatable :: buf (:, :) real ( wp ) :: h_k ti = ostate % time_index n = ostate % ncells nz = ostate % nz_ml ! Layer thickness — write directly from memory. call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_h_layer_varid , & state % multilayer % h_layer ( 1 : nz , 1 : n ), & start = [ 1 , 1 , ti ], & count = [ nz , n , 1 ]), & \"writing h_layer slice\" ) ! Velocity components — derive u = hu / h with dry-cell guard. allocate ( buf ( nz , n )) do cc = 1 , n do kk = 1 , nz h_k = state % multilayer % h_layer ( kk , cc ) if ( h_k > DRY_TOLERANCE ) then buf ( kk , cc ) = state % multilayer % hu_layer ( kk , cc ) / h_k else buf ( kk , cc ) = 0.0_wp end if end do end do call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_u_varid , buf , & start = [ 1 , 1 , ti ], count = [ nz , n , 1 ]), & \"writing u_ml slice\" ) do cc = 1 , n do kk = 1 , nz h_k = state % multilayer % h_layer ( kk , cc ) if ( h_k > DRY_TOLERANCE ) then buf ( kk , cc ) = state % multilayer % hv_layer ( kk , cc ) / h_k else buf ( kk , cc ) = 0.0_wp end if end do end do call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_v_varid , buf , & start = [ 1 , 1 , ti ], count = [ nz , n , 1 ]), & \"writing v_ml slice\" ) ! Density (already a primitive variable — direct write). call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_rho_varid , & state % multilayer % rho_layer ( 1 : nz , 1 : n ), & start = [ 1 , 1 , ti ], count = [ nz , n , 1 ]), & \"writing rho_layer slice\" ) ! Vertical velocity at interfaces (nz + 1 levels). call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_w_varid , & state % multilayer % w_interface ( 1 : nz + 1 , 1 : n ), & start = [ 1 , 1 , ti ], count = [ nz + 1 , n , 1 ]), & \"writing w_interface slice\" ) ! ---- Per-tracer variables ---- ! Divide the conserved hTr by h_layer to recover the primitive ! variable in the same units the registry advertises. if ( allocated ( state % multilayer % tracers ) . and . allocated ( ostate % ml_tracer_varids )) then do it = 1 , size ( state % multilayer % tracers ) if ( ostate % ml_tracer_varids ( it ) < 0 ) cycle do cc = 1 , n do kk = 1 , nz h_k = state % multilayer % h_layer ( kk , cc ) if ( h_k > DRY_TOLERANCE ) then buf ( kk , cc ) = state % multilayer % tracers ( it )% hTr ( kk , cc ) / h_k else buf ( kk , cc ) = 0.0_wp end if end do end do call nc_check ( nf90_put_var ( ostate % ncid , ostate % ml_tracer_varids ( it ), & buf , start = [ 1 , 1 , ti ], count = [ nz , n , 1 ]), & \"writing tracer slice\" ) end do end if deallocate ( buf ) end subroutine write_multilayer_snapshot","tags":"","url":"proc/write_multilayer_snapshot.html"},{"title":"fill_gpu_1d – Rakali","text":"private pure subroutine fill_gpu_1d(arr, val) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: arr (:) real(kind=wp), intent(in) :: val Called by proc~~fill_gpu_1d~~CalledByGraph proc~fill_gpu_1d fill_gpu_1d interface~fill_gpu fill_gpu interface~fill_gpu->proc~fill_gpu_1d Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: hi integer, private :: i integer, private :: lo Source Code pure subroutine fill_gpu_1d ( arr , val ) ! assumed-shape-ok: generic fill utility; must accept any rank-1 slice real ( wp ), intent ( inout ) :: arr (:) real ( wp ), intent ( in ) :: val integer :: i , lo , hi lo = lbound ( arr , 1 ) hi = ubound ( arr , 1 ) do concurrent ( i = lo : hi ) arr ( i ) = val end do end subroutine fill_gpu_1d","tags":"","url":"proc/fill_gpu_1d.html"},{"title":"fill_gpu_2d – Rakali","text":"private pure subroutine fill_gpu_2d(arr, val) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: arr (:,:) real(kind=wp), intent(in) :: val Called by proc~~fill_gpu_2d~~CalledByGraph proc~fill_gpu_2d fill_gpu_2d interface~fill_gpu fill_gpu interface~fill_gpu->proc~fill_gpu_2d Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows