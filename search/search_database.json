 of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: a_b real(kind=wp), private :: a_t real(kind=wp), private :: denom real(kind=wp), private :: gl_h real(kind=wp), private :: gl_hu real(kind=wp), private :: gl_hv real(kind=wp), private :: gr_h real(kind=wp), private :: gr_hu real(kind=wp), private :: gr_hv real(kind=wp), private :: s_l real(kind=wp), private :: s_r real(kind=wp), private :: u_b real(kind=wp), private :: u_t real(kind=wp), private :: v_b real(kind=wp), private :: v_t Source Code pure subroutine hll_flux_y ( h_b , hu_b , hv_b , h_t , hu_t , hv_t , & g_h , g_hu , g_hv ) !! HLL numerical flux in y-direction between bottom and top states real ( wp ), intent ( in ) :: h_b , hu_b , hv_b real ( wp ), intent ( in ) :: h_t , hu_t , hv_t real ( wp ), intent ( out ) :: g_h , g_hu , g_hv real ( wp ) :: u_b , u_t , v_b , v_t , a_b , a_t real ( wp ) :: s_l , s_r , denom real ( wp ) :: gl_h , gl_hu , gl_hv real ( wp ) :: gr_h , gr_hu , gr_hv if ( h_b > DRY_TOLERANCE ) then u_b = hu_b / h_b v_b = hv_b / h_b else u_b = 0.0_wp v_b = 0.0_wp end if if ( h_t > DRY_TOLERANCE ) then u_t = hu_t / h_t v_t = hv_t / h_t else u_t = 0.0_wp v_t = 0.0_wp end if a_b = sqrt ( GRAVITY * max ( h_b , 0.0_wp )) a_t = sqrt ( GRAVITY * max ( h_t , 0.0_wp )) ! Wave-speed estimate.  Davis (min/max of the one-sided speeds) is right ! for a genuine two-sided WET Riemann problem, but wrong at a wet/dry ! front and must be replaced there. ! ! With the right state dry, `a_R = 0` and `u_R = 0`, so Davis returns ! `s_r = u_L + a_L`.  The exact dry-front speed is `u_L + 2 a_L` — the ! Ritter (1892) result — so Davis underestimates the right-going wave by ! up to a factor of two and the front cannot advance at the right rate. ! The dry-state speeds below are the standard fix (Toro, \"Riemann ! Solvers and Numerical Methods for Fluid Dynamics\", 3rd ed. S10.4; ! Einfeldt et al. 1991). ! ! Measured consequence before this branch existed: the Ritter dry-bed ! tip advanced at 1.49 c0 rather than 2 c0, the leading tongue below ! ~1 % of the upstream depth was absent, and on a sloping beach a thin ! film would not recede at all (validation phases 4 and 5). if ( h_t <= DRY_TOLERANCE ) then ! Dry on the RIGHT: the right-going wave IS the dry front. s_l = v_b - a_b s_r = v_b + 2.0_wp * a_b else if ( h_b <= DRY_TOLERANCE ) then ! Dry on the LEFT: mirror image. s_l = v_t - 2.0_wp * a_t s_r = v_t + a_t else s_l = min ( v_b - a_b , v_t - a_t ) s_r = max ( v_b + a_b , v_t + a_t ) end if gl_h = hv_b gl_hu = hu_b * v_b gl_hv = hv_b * v_b + 0.5_wp * GRAVITY * h_b * h_b gr_h = hv_t gr_hu = hu_t * v_t gr_hv = hv_t * v_t + 0.5_wp * GRAVITY * h_t * h_t if ( s_l >= 0.0_wp ) then g_h = gl_h g_hu = gl_hu g_hv = gl_hv else if ( s_r <= 0.0_wp ) then g_h = gr_h g_hu = gr_hu g_hv = gr_hv else denom = 1.0_wp / ( s_r - s_l ) g_h = ( s_r * gl_h - s_l * gr_h & + s_l * s_r * ( h_t - h_b )) * denom g_hu = ( s_r * gl_hu - s_l * gr_hu & + s_l * s_r * ( hu_t - hu_b )) * denom g_hv = ( s_r * gl_hv - s_l * gr_hv & + s_l * s_r * ( hv_t - hv_b )) * denom end if end subroutine hll_flux_y","tags":"","url":"proc/hll_flux_y.html"},{"title":"hllc_flux_x – Rakali","text":"private pure subroutine hllc_flux_x(h_l, hu_l, hv_l, h_r, hu_r, hv_r, f_h, f_hu, f_hv) HLLC numerical flux in x-direction. Transverse momentum hv is\nupwinded across the contact wave: f_hv = f_h * v_upwind\n(v_l if s_star >= 0, else v_r); h and hu match HLL. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_l real(kind=wp), intent(in) :: hu_l real(kind=wp), intent(in) :: hv_l real(kind=wp), intent(in) :: h_r real(kind=wp), intent(in) :: hu_r real(kind=wp), intent(in) :: hv_r real(kind=wp), intent(out) :: f_h real(kind=wp), intent(out) :: f_hu real(kind=wp), intent(out) :: f_hv Called by proc~~hllc_flux_x~~CalledByGraph proc~hllc_flux_x hllc_flux_x proc~flux_cell flux_cell proc~flux_cell->proc~hllc_flux_x proc~compute_flux_hll compute_flux_hll proc~compute_flux_hll->proc~flux_cell proc~compute_flux_hllc compute_flux_hllc proc~compute_flux_hllc->proc~flux_cell proc~solver_compute_barotropic_flux solver_compute_barotropic_flux proc~solver_compute_barotropic_flux->proc~compute_flux_hll proc~solver_compute_barotropic_flux->proc~compute_flux_hllc proc~solver_advance_2d_generic solver_advance_2d_generic proc~solver_advance_2d_generic->proc~solver_compute_barotropic_flux proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~solver_compute_barotropic_flux proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~solver_compute_barotropic_flux proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~solver_compute_barotropic_flux proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~solver_compute_barotropic_flux proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_compute_barotropic_flux proc~solver_step_impl->proc~solver_advance_2d_generic proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_barotropic_rk_stage Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: a_l real(kind=wp), private :: a_r real(kind=wp), private :: denom real(kind=wp), private :: denom_star real(kind=wp), private :: fl_h real(kind=wp), private :: fl_hu real(kind=wp), private :: fl_hv real(kind=wp), private :: fr_h real(kind=wp), private :: fr_hu real(kind=wp), private :: fr_hv real(kind=wp), private :: s_l real(kind=wp), private :: s_r real(kind=wp), private :: s_star real(kind=wp), private :: u_l real(kind=wp), private :: u_r real(kind=wp), private :: v_l real(kind=wp), private :: v_r Source Code pure subroutine hllc_flux_x ( h_l , hu_l , hv_l , h_r , hu_r , hv_r , & f_h , f_hu , f_hv ) !! HLLC numerical flux in x-direction. Transverse momentum hv is !! upwinded across the contact wave: f_hv = f_h * v_upwind !! (v_l if s_star >= 0, else v_r); h and hu match HLL. real ( wp ), intent ( in ) :: h_l , hu_l , hv_l real ( wp ), intent ( in ) :: h_r , hu_r , hv_r real ( wp ), intent ( out ) :: f_h , f_hu , f_hv real ( wp ) :: u_l , u_r , v_l , v_r , a_l , a_r real ( wp ) :: s_l , s_r , denom , denom_star , s_star real ( wp ) :: fl_h , fl_hu , fl_hv real ( wp ) :: fr_h , fr_hu , fr_hv if ( h_l > DRY_TOLERANCE ) then u_l = hu_l / h_l v_l = hv_l / h_l else u_l = 0.0_wp v_l = 0.0_wp end if if ( h_r > DRY_TOLERANCE ) then u_r = hu_r / h_r v_r = hv_r / h_r else u_r = 0.0_wp v_r = 0.0_wp end if a_l = sqrt ( GRAVITY * max ( h_l , 0.0_wp )) a_r = sqrt ( GRAVITY * max ( h_r , 0.0_wp )) ! Wave-speed estimate.  Davis (min/max of the one-sided speeds) is right ! for a genuine two-sided WET Riemann problem, but wrong at a wet/dry ! front and must be replaced there. ! ! With the right state dry, `a_R = 0` and `u_R = 0`, so Davis returns ! `s_r = u_L + a_L`.  The exact dry-front speed is `u_L + 2 a_L` — the ! Ritter (1892) result — so Davis underestimates the right-going wave by ! up to a factor of two and the front cannot advance at the right rate. ! The dry-state speeds below are the standard fix (Toro, \"Riemann ! Solvers and Numerical Methods for Fluid Dynamics\", 3rd ed. S10.4; ! Einfeldt et al. 1991). ! ! Measured consequence before this branch existed: the Ritter dry-bed ! tip advanced at 1.49 c0 rather than 2 c0, the leading tongue below ! ~1 % of the upstream depth was absent, and on a sloping beach a thin ! film would not recede at all (validation phases 4 and 5). if ( h_r <= DRY_TOLERANCE ) then ! Dry on the RIGHT: the right-going wave IS the dry front. s_l = u_l - a_l s_r = u_l + 2.0_wp * a_l else if ( h_l <= DRY_TOLERANCE ) then ! Dry on the LEFT: mirror image. s_l = u_r - 2.0_wp * a_r s_r = u_r + a_r else s_l = min ( u_l - a_l , u_r - a_r ) s_r = max ( u_l + a_l , u_r + a_r ) end if fl_h = hu_l fl_hu = hu_l * u_l + 0.5_wp * GRAVITY * h_l * h_l fl_hv = hu_l * v_l fr_h = hu_r fr_hu = hu_r * u_r + 0.5_wp * GRAVITY * h_r * h_r fr_hv = hu_r * v_r if ( s_l >= 0.0_wp ) then f_h = fl_h f_hu = fl_hu f_hv = fl_hv else if ( s_r <= 0.0_wp ) then f_h = fr_h f_hu = fr_hu f_hv = fr_hv else denom = 1.0_wp / ( s_r - s_l ) f_h = ( s_r * fl_h - s_l * fr_h & + s_l * s_r * ( h_r - h_l )) * denom f_hu = ( s_r * fl_hu - s_l * fr_hu & + s_l * s_r * ( hu_r - hu_l )) * denom ! Contact-wave speed (Toro). Fall back to the arithmetic mean ! when the denominator vanishes. denom_star = h_r * ( u_r - s_r ) - h_l * ( u_l - s_l ) if ( abs ( denom_star ) > DRY_TOLERANCE ) then s_star = ( s_l * h_r * ( u_r - s_r ) - s_r * h_l * ( u_l - s_l )) / denom_star else s_star = 0.5_wp * ( u_l + u_r ) end if if ( s_star >= 0.0_wp ) then f_hv = f_h * v_l else f_hv = f_h * v_r end if end if end subroutine hllc_flux_x","tags":"","url":"proc/hllc_flux_x.html"},{"title":"hllc_flux_y – Rakali","text":"private pure subroutine hllc_flux_y(h_b, hu_b, hv_b, h_t, hu_t, hv_t, g_h, g_hu, g_hv) HLLC numerical flux in y-direction. Mirrors hllc_flux_x with\n(u, hu) and (v, hv) swapped; transverse hu is upwinded. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_b real(kind=wp), intent(in) :: hu_b real(kind=wp), intent(in) :: hv_b real(kind=wp), intent(in) :: h_t real(kind=wp), intent(in) :: hu_t real(kind=wp), intent(in) :: hv_t real(kind=wp), intent(out) :: g_h real(kind=wp), intent(out) :: g_hu real(kind=wp), intent(out) :: g_hv Called by proc~~hllc_flux_y~~CalledByGraph proc~hllc_flux_y hllc_flux_y proc~flux_cell flux_cell proc~flux_cell->proc~hllc_flux_y proc~compute_flux_hll compute_flux_hll proc~compute_flux_hll->proc~flux_cell proc~compute_flux_hllc compute_flux_hllc proc~compute_flux_hllc->proc~flux_cell proc~solver_compute_barotropic_flux solver_compute_barotropic_flux proc~solver_compute_barotropic_flux->proc~compute_flux_hll proc~solver_compute_barotropic_flux->proc~compute_flux_hllc proc~solver_advance_2d_generic solver_advance_2d_generic proc~solver_advance_2d_generic->proc~solver_compute_barotropic_flux proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~solver_compute_barotropic_flux proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~solver_compute_barotropic_flux proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~solver_compute_barotropic_flux proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~solver_compute_barotropic_flux proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_compute_barotropic_flux proc~solver_step_impl->proc~solver_advance_2d_generic proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_barotropic_rk_stage Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: a_b real(kind=wp), private :: a_t real(kind=wp), private :: denom real(kind=wp), private :: denom_star real(kind=wp), private :: gl_h real(kind=wp), private :: gl_hu real(kind=wp), private :: gl_hv real(kind=wp), private :: gr_h real(kind=wp), private :: gr_hu real(kind=wp), private :: gr_hv real(kind=wp), private :: s_l real(kind=wp), private :: s_r real(kind=wp), private :: s_star real(kind=wp), private :: u_b real(kind=wp), private :: u_t real(kind=wp), private :: v_b real(kind=wp), private :: v_t Source Code pure subroutine hllc_flux_y ( h_b , hu_b , hv_b , h_t , hu_t , hv_t , & g_h , g_hu , g_hv ) !! HLLC numerical flux in y-direction. Mirrors hllc_flux_x with !! (u, hu) and (v, hv) swapped; transverse hu is upwinded. real ( wp ), intent ( in ) :: h_b , hu_b , hv_b real ( wp ), intent ( in ) :: h_t , hu_t , hv_t real ( wp ), intent ( out ) :: g_h , g_hu , g_hv real ( wp ) :: u_b , u_t , v_b , v_t , a_b , a_t real ( wp ) :: s_l , s_r , denom , denom_star , s_star real ( wp ) :: gl_h , gl_hu , gl_hv real ( wp ) :: gr_h , gr_hu , gr_hv if ( h_b > DRY_TOLERANCE ) then u_b = hu_b / h_b v_b = hv_b / h_b else u_b = 0.0_wp v_b = 0.0_wp end if if ( h_t > DRY_TOLERANCE ) then u_t = hu_t / h_t v_t = hv_t / h_t else u_t = 0.0_wp v_t = 0.0_wp end if a_b = sqrt ( GRAVITY * max ( h_b , 0.0_wp )) a_t = sqrt ( GRAVITY * max ( h_t , 0.0_wp )) ! Wave-speed estimate.  Davis (min/max of the one-sided speeds) is right ! for a genuine two-sided WET Riemann problem, but wrong at a wet/dry ! front and must be replaced there. ! ! With the right state dry, `a_R = 0` and `u_R = 0`, so Davis returns ! `s_r = u_L + a_L`.  The exact dry-front speed is `u_L + 2 a_L` — the ! Ritter (1892) result — so Davis underestimates the right-going wave by ! up to a factor of two and the front cannot advance at the right rate. ! The dry-state speeds below are the standard fix (Toro, \"Riemann ! Solvers and Numerical Methods for Fluid Dynamics\", 3rd ed. S10.4; ! Einfeldt et al. 1991). ! ! Measured consequence before this branch existed: the Ritter dry-bed ! tip advanced at 1.49 c0 rather than 2 c0, the leading tongue below ! ~1 % of the upstream depth was absent, and on a sloping beach a thin ! film would not recede at all (validation phases 4 and 5). if ( h_t <= DRY_TOLERANCE ) then ! Dry on the RIGHT: the right-going wave IS the dry front. s_l = v_b - a_b s_r = v_b + 2.0_wp * a_b else if ( h_b <= DRY_TOLERANCE ) then ! Dry on the LEFT: mirror image. s_l = v_t - 2.0_wp * a_t s_r = v_t + a_t else s_l = min ( v_b - a_b , v_t - a_t ) s_r = max ( v_b + a_b , v_t + a_t ) end if gl_h = hv_b gl_hu = hu_b * v_b gl_hv = hv_b * v_b + 0.5_wp * GRAVITY * h_b * h_b gr_h = hv_t gr_hu = hu_t * v_t gr_hv = hv_t * v_t + 0.5_wp * GRAVITY * h_t * h_t if ( s_l >= 0.0_wp ) then g_h = gl_h g_hu = gl_hu g_hv = gl_hv else if ( s_r <= 0.0_wp ) then g_h = gr_h g_hu = gr_hu g_hv = gr_hv else denom = 1.0_wp / ( s_r - s_l ) g_h = ( s_r * gl_h - s_l * gr_h & + s_l * s_r * ( h_t - h_b )) * denom g_hv = ( s_r * gl_hv - s_l * gr_hv & + s_l * s_r * ( hv_t - hv_b )) * denom denom_star = h_t * ( v_t - s_r ) - h_b * ( v_b - s_l ) if ( abs ( denom_star ) > DRY_TOLERANCE ) then s_star = ( s_l * h_t * ( v_t - s_r ) - s_r * h_b * ( v_b - s_l )) / denom_star else s_star = 0.5_wp * ( v_b + v_t ) end if if ( s_star >= 0.0_wp ) then g_hu = g_h * u_b else g_hu = g_h * u_t end if end if end subroutine hllc_flux_y","tags":"","url":"proc/hllc_flux_y.html"},{"title":"ml_truncate_velocity – Rakali","text":"public pure subroutine ml_truncate_velocity(h_layer, hu_layer, hv_layer, grid, nz, dt, cfl_trunc) Clip any layer velocity with CFL > cfl_trunc to 0.9 cfl_trunc dx/dt. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: cfl_trunc Calls proc~~ml_truncate_velocity~~CallsGraph proc~ml_truncate_velocity ml_truncate_velocity local local proc~ml_truncate_velocity->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_truncate_velocity~~CalledByGraph proc~ml_truncate_velocity ml_truncate_velocity proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_truncate_velocity proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: h_k integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: u_abs real(kind=wp), private :: v_abs real(kind=wp), private :: vel_max_x real(kind=wp), private :: vel_max_y Source Code pure subroutine ml_truncate_velocity ( h_layer , hu_layer , hv_layer , & grid , nz , dt , & cfl_trunc ) !! Clip any layer velocity with CFL > cfl_trunc to 0.9*cfl_trunc*dx/dt. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dt real ( wp ), intent ( in ) :: cfl_trunc integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: u_abs , v_abs , h_k , vel_max_x , vel_max_y nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy vel_max_x = 0.9_wp * cfl_trunc * dx / max ( dt , 1.0e-10_wp ) vel_max_y = 0.9_wp * cfl_trunc * dy / max ( dt , 1.0e-10_wp ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , u_abs , v_abs , h_k ) do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle u_abs = abs ( hu_layer ( i , j , k )) / h_k v_abs = abs ( hv_layer ( i , j , k )) / h_k if ( u_abs > vel_max_x ) then hu_layer ( i , j , k ) = sign ( vel_max_x * h_k , hu_layer ( i , j , k )) end if if ( v_abs > vel_max_y ) then hv_layer ( i , j , k ) = sign ( vel_max_y * h_k , hv_layer ( i , j , k )) end if end do end do end subroutine ml_truncate_velocity","tags":"","url":"proc/ml_truncate_velocity.html"},{"title":"resolve – Rakali","text":"private  function resolve(c_handle, h) result(ierr) Resolve an opaque c_ptr to a Fortran handle pointer. Arguments Type Intent Optional Attributes Name type(c_ptr), intent(in) :: c_handle type( solver_handle_unstr_t ), intent(out), pointer :: h Return Value integer(kind=c_int) Calls proc~~resolve~~CallsGraph proc~resolve resolve proc~handle_check_unstr handle_check_unstr proc~resolve->proc~handle_check_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an