), private :: kappa_t real(kind=wp), private :: tr_k real(kind=wp), private :: tr_k1 real(kind=wp), private :: u_k real(kind=wp), private :: u_k1 real(kind=wp), private :: v_k real(kind=wp), private :: v_k1 Source Code pure subroutine ml_vertical_diffusion_tracer_unstr_impl ( nz , n , ncells_owned , height_cv , & h_layer , hu_layer , hv_layer , & rho_layer , rho_0 , vmix_ri_alpha , & vmix_nu_max , hTr_layer , kappa_bg , dt ) !! Flat-impl of [[ml_vertical_diffusion_tracer_unstr]]: explicit-shape !! dummies so the device kernel addresses raw pointers, not derived-type !! descriptors.  Column-local; no neighbour access. integer , intent ( in ) :: nz , n , ncells_owned real ( wp ), intent ( in ) :: height_cv ( n ) real ( wp ), intent ( in ) :: h_layer ( nz , n ), hu_layer ( nz , n ), hv_layer ( nz , n ) real ( wp ), intent ( in ) :: rho_layer ( nz , n ) real ( wp ), intent ( in ) :: rho_0 , vmix_ri_alpha , vmix_nu_max real ( wp ), intent ( inout ) :: hTr_layer ( nz , n ) real ( wp ), intent ( in ) :: kappa_bg , dt integer :: cell , k real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 real ( wp ) :: du , dv , drho , Ri , denom , kappa_t real ( wp ) :: tr_k , tr_k1 , dtr , flux_tr real ( wp ) :: flux_iface ( BPG_NZ_MAX ) real ( wp ), parameter :: EPS = 1.0e-20_wp do concurrent ( cell = 1 : ncells_owned ) & local ( k , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , & du , dv , drho , Ri , denom , kappa_t , & tr_k , tr_k1 , dtr , flux_tr , flux_iface ) if ( height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle ! Pass 1: compute interface fluxes do k = 1 , nz - 1 h_k = h_layer ( k , cell ) h_k1 = h_layer ( k + 1 , cell ) h_avg = 0.5_wp * ( h_k + h_k1 ) flux_iface ( k ) = 0.0_wp ! VCOORD_ZSTAR_FULL: no-flux through vanishing-layer interfaces. if ( h_avg > VANISHING_LAYER_TOL_UNSTR . and . & h_k > VANISHING_LAYER_TOL_UNSTR . and . & h_k1 > VANISHING_LAYER_TOL_UNSTR ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( k , cell ) / h_k v_k = hv_layer ( k , cell ) / h_k tr_k = hTr_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp tr_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( k + 1 , cell ) / h_k1 v_k1 = hv_layer ( k + 1 , cell ) / h_k1 tr_k1 = hTr_layer ( k + 1 , cell ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp tr_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( k , cell ) - rho_layer ( k + 1 , cell ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + vmix_ri_alpha * Ri kappa_t = vmix_nu_max / ( denom * denom * denom ) + kappa_bg ! Stability: kappa_t * dt / h_avg&#94;2 <= 0.5 if ( kappa_t * dt > 0.5_wp * h_avg * h_avg ) then kappa_t = 0.5_wp * h_avg * h_avg / dt end if dtr = tr_k1 - tr_k flux_iface ( k ) = kappa_t * dtr / h_avg * dt end if end do ! Pass 2: apply fluxes.  flux_iface(k) is the diffusive transfer ! across interface k+1/2 (units [tr]*m); the same quantity adds to ! layer k and subtracts from layer k+1.  Multiplying each side by ! h_layer (previous form) was dimensionally wrong and non-conservative ! under non-uniform dz (e.g. VCOORD_ZSTAR_FULL). hTr_layer ( 1 , cell ) = hTr_layer ( 1 , cell ) + flux_iface ( 1 ) do k = 2 , nz - 1 hTr_layer ( k , cell ) = hTr_layer ( k , cell ) & + ( flux_iface ( k ) - flux_iface ( k - 1 )) end do hTr_layer ( nz , cell ) = hTr_layer ( nz , cell ) - flux_iface ( nz - 1 ) end do end subroutine ml_vertical_diffusion_tracer_unstr_impl","tags":"","url":"proc/ml_vertical_diffusion_tracer_unstr_impl.html"},{"title":"ml_vertical_exchange_tracer_unstr_impl – Rakali","text":"private pure subroutine ml_vertical_exchange_tracer_unstr_impl(nz, n, ncells_owned, height_cv, h_layer, w_interface, hTr_layer, dt) Flat-impl of ml_vertical_exchange_tracer_unstr : explicit-shape dummies\nso the device kernel addresses raw pointers, not derived-type descriptors. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz integer, intent(in) :: n integer, intent(in) :: ncells_owned real(kind=wp), intent(in) :: height_cv (n) real(kind=wp), intent(in) :: h_layer (nz,n) real(kind=wp), intent(in) :: w_interface (nz+1,n) real(kind=wp), intent(inout) :: hTr_layer (nz,n) real(kind=wp), intent(in) :: dt Calls proc~~ml_vertical_exchange_tracer_unstr_impl~~CallsGraph proc~ml_vertical_exchange_tracer_unstr_impl ml_vertical_exchange_tracer_unstr_impl local local proc~ml_vertical_exchange_tracer_unstr_impl->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_vertical_exchange_tracer_unstr_impl~~CalledByGraph proc~ml_vertical_exchange_tracer_unstr_impl ml_vertical_exchange_tracer_unstr_impl proc~ml_vertical_exchange_tracer_unstr ml_vertical_exchange_tracer_unstr proc~ml_vertical_exchange_tracer_unstr->proc~ml_vertical_exchange_tracer_unstr_impl proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_vertical_exchange_tracer_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: cell real(kind=wp), private :: flux_iface (BPG_NZ_MAX) real(kind=wp), private :: flux_tr real(kind=wp), private :: h_val integer, private :: k real(kind=wp), private :: tr_up real(kind=wp), private :: w_face Source Code pure subroutine ml_vertical_exchange_tracer_unstr_impl ( nz , n , ncells_owned , height_cv , & h_layer , w_interface , hTr_layer , dt ) !! Flat-impl of [[ml_vertical_exchange_tracer_unstr]]: explicit-shape dummies !! so the device kernel addresses raw pointers, not derived-type descriptors. integer , intent ( in ) :: nz , n , ncells_owned real ( wp ), intent ( in ) :: height_cv ( n ) real ( wp ), intent ( in ) :: h_layer ( nz , n ) real ( wp ), intent ( in ) :: w_interface ( nz + 1 , n ) real ( wp ), intent ( inout ) :: hTr_layer ( nz , n ) real ( wp ), intent ( in ) :: dt integer :: cell , k real ( wp ) :: w_face , tr_up , flux_tr , h_val real ( wp ) :: flux_iface ( BPG_NZ_MAX ) do concurrent ( cell = 1 : ncells_owned ) local ( k , w_face , tr_up , flux_tr , h_val , flux_iface ) ! Skip thin columns if ( height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle ! Pass 1: compute all interface fluxes from current state do k = 1 , nz - 1 w_face = w_interface ( k + 1 , cell ) ! Upwind tracer selection if ( w_face > 0.0_wp ) then ! Upward flow: donor is layer k h_val = h_layer ( k , cell ) if ( h_val > DRY_TOLERANCE ) then tr_up = hTr_layer ( k , cell ) / h_val else tr_up = 0.0_wp end if else ! Downward flow: donor is layer k+1 h_val = h_layer ( k + 1 , cell ) if ( h_val > DRY_TOLERANCE ) then tr_up = hTr_layer ( k + 1 , cell ) / h_val else tr_up = 0.0_wp end if end if ! Flux = w * tracer_concentration * dt flux_tr = w_face * tr_up * dt ! 50% limiter if ( w_face > 0.0_wp ) then if ( abs ( flux_tr ) > 0.5_wp * abs ( hTr_layer ( k , cell ))) then flux_tr = sign ( 0.5_wp * abs ( hTr_layer ( k , cell )), flux_tr ) end if else if ( abs ( flux_tr ) > 0.5_wp * abs ( hTr_layer ( k + 1 , cell ))) then flux_tr = sign ( 0.5_wp * abs ( hTr_layer ( k + 1 , cell )), flux_tr ) end if end if flux_iface ( k ) = flux_tr end do ! Pass 2: apply fluxes to layers ! Bottom layer (k=1): only has the interface ABOVE it hTr_layer ( 1 , cell ) = hTr_layer ( 1 , cell ) - flux_iface ( 1 ) ! Interior layers: interface below and above do k = 2 , nz - 1 hTr_layer ( k , cell ) = hTr_layer ( k , cell ) + flux_iface ( k - 1 ) - flux_iface ( k ) end do ! Top / surface layer (k=nz): only has the interface BELOW it hTr_layer ( nz , cell ) = hTr_layer ( nz , cell ) + flux_iface ( nz - 1 ) end do end subroutine ml_vertical_exchange_tracer_unstr_impl","tags":"","url":"proc/ml_vertical_exchange_tracer_unstr_impl.html"},{"title":"ml_build_vcoord_zstar_full_unstr – Rakali","text":"public  subroutine ml_build_vcoord_zstar_full_unstr(state) Fill the per-cell reference z-level array from the bathymetry.\nRuns once at solver init (host-side loop); pushes vcoord_z_ref_col to the device when done. bed_cv is bed\nelevation (negative when submerged); its magnitude is h_bed . Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state Calls proc~~ml_build_vcoord_zstar_full_unstr~~CallsGraph proc~ml_build_vcoord_zstar_full_unstr ml_build_vcoord_zstar_full_unstr proc~zstar_full_build_column zstar_full_build_column proc~ml_build_vco