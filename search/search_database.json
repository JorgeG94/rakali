oc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it integer, private, parameter :: nz_local = 1 Source Code subroutine solver_multilayer_rk_stage_nz1 ( state , is_stage1 ) !! Fused RK-stage path specialised for nz_ml=1 (depth-averaged !! 2D with optional tracers). !! !! Reorders the tracer pipeline to run before the per-cell post- !! update sequence so that (compute_update + distribute_barotropic !! + bottom_friction + truncate_velocity + recompute_barotropic + !! wind / atm_pressure / precip + coriolis) collapses into a !! single fused kernel `ml_fused_post_update`. Mirrors what the !! 2D HLL path does with `fused_update_stage1/2`. At nz_ml=1 the !! vertical-mixing block (vert_exchange, EOS, vmix, BPG) is !! definitionally empty, so this path is complete; for nz_ml>1 !! the un-fused stage above runs instead. !! !! When `is_stage1` is true the fused kernel additionally saves !! the pre-update barotropic and layer state into the `*_0` !! arrays, absorbing `solver_save_state` and `ml_save_layer_state`. type ( state_t ), intent ( inout ) :: state logical , intent ( in ) :: is_stage1 integer , parameter :: nz_local = 1 integer :: it ! ---- Barotropic + layer BCs ---- call profiler_start ( \"boundary\" ) call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) call ml_apply_layer_bcs ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % multilayer % dsig_ml , & state % grid , nz_local , & bc_west = state % bc % west , bc_east = state % bc % east , & bc_south = state % bc % south , bc_north = state % bc % north ) call profiler_stop ( \"boundary\" ) ! ---- Barotropic HLL flux (mass + momentum) ---- ! The pre-update momentum needed by the fused-kernel's distribute ! step is captured in registers inside the kernel itself, so the ! un-fused path's hu_ml_pre / hv_ml_pre copies are skipped here. call profiler_start ( \"flux\" ) call solver_compute_barotropic_flux ( state ) call profiler_stop ( \"flux\" ) ! ---- Tracer BCs + CWC advection on OLD h_layer + mass_flux ---- ! Reordered to run before the fused post-update kernel, since the ! fused kernel writes the NEW h_layer in place. The CWC property ! holds because the mass_flux is the same continuity flux that ! the barotropic update inside the fused kernel will consume. ! Tracer BCs on OLD h_layer, looped over the registry (per-tracer ! inflow synced for S/T in solver_multilayer_rk_stage above). do it = 1 , size ( state % multilayer % tracers ) call ml_apply_tracer_bcs ( state % multilayer % tracers ( it )% hTr , state % multilayer % h_layer , & state % multilayer % tracers ( it )% tr_inflow , & state % grid , nz_local , state % bc ) end do ! CWC tracer advection on OLD h_layer with NEW mass_flux, looped ! over the whole registry (mirrors the nz>1 path). do it = 1 , size ( state % multilayer % tracers ) if (. not . state % multilayer % tracers ( it )% do_horizontal_advection ) cycle if ( state % multilayer % use_ppm_tracer ) then if ( state % multilayer % tracer_recon_code /= TRACER_RECON_PPM ) then call ml_advect_tracer_weno ( & state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % mass_flux_x , state % barotropic % mass_flux_y , & state % multilayer % tracers ( it )% hTr , tracer_scratch % weno_tr_snap , state % grid , nz_local , & state % dt , state % multilayer % tracer_recon_code ) else call ml_advect_tracer_ppm ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % mass_flux_x , state % barotropic % mass_flux_y , & state % multilayer % tracers ( it )% hTr , & tracer_scratch % ppm_tr_snap , tracer_scratch % ppm_ql_x , tracer_scratch % ppm_qr_x , & tracer_scratch % ppm_ql_y , tracer_scratch % ppm_qr_y , & state % grid , nz_local , & state % dt ) end if else call ml_advect_tracer ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % mass_flux_x , state % barotropic % mass_flux_y , & state % multilayer % tracers ( it )% hTr , tracer_scratch % adv_hTr_snap , state % grid , nz_local , & state % dt ) end if end do ! ---- The big fusion: 7 per-cell kernels collapsed into one ---- call profiler_start ( \"update\" ) call ml_fused_post_update ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & state % multilayer % h_layer0 , state % multilayer % hu_layer0 , state % multilayer % hv_layer0 , & state % barotropic % flux_h , state % barotropic % flux_hu , state % barotropic % flux_hv , & state % multilayer % dsig_ml , & state % forcing % wind_x , state % forcing % wind_y , & state % forcing % atm_pressure , state % forcing % precipitation , & state % grid , nz_local , state % dt , & state % barotropic % manning_n , & state % barotropic % use_linear_bottom_drag , state % barotropic % bottom_drag_r , & state % barotropic % coriolis_f , state % forcing % active , & do_save = is_stage1 ) call profiler_stop ( \"update\" ) ! ---- Tracer pipeline tail: horizontal diffusion, surface flux, !      physical clamp. ---- ! Horizontal tracer diffusion, looped over the registry with ! per-tracer hdiff_kappa (synced from the state scalar for S/T). do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_horizontal_diffusion . and . & state % multilayer % tracers ( it )% hdiff_kappa > 0.0_wp ) then call ml_horizontal_diffusion_tracer ( state % multilayer % h_layer , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hdiff_kappa , & tracer_scratch % hdiff_hTr_pre , & state % grid , nz_local , & state % dt ) end if end do ! Surface tracer flux + S/T clamp fused into one per-cell pass. ! Replaces 3 launches: ml_apply_surface_tracer_fluxes + ! ml_clamp_tracer(S) + ml_clamp_tracer(T). call ml_fused_tracer_post ( state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % h_layer , & state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % forcing % heat_flux , state % forcing % evap_minus_precip , & state % multilayer % evap_mass_sink , & state % multilayer % evap_latent_cooling , & state % multilayer % S_min , state % multilayer % S_max , & state % multilayer % T_min , state % multilayer % T_max , & state % multilayer % rho_0 , CP_WATER , ML_MIN_DEPTH , & state % grid , nz_local , state % dt ) ! Clamp extra registered tracers — the fused tracer-post above clamps ! S/T only, so extras (e.g. sediment) need their own positivity clamp. do it = 1 , size ( state % multilayer % tracers ) if ( it == state % multilayer % idx_salinity . or . it == state % multilayer % idx_temperature ) cycle if ( state % multilayer % tracers ( it )% do_clamp ) then call ml_clamp_tracer ( state % multilayer % tracers ( it )% hTr , state % multilayer % h_layer , & state % multilayer % tracers ( it )% tr_min , state % multilayer % tracers ( it )% tr_max , & state % grid , nz_local ) end if end do ! ---- Smagorinsky horizontal viscosity (optional) ---- ! Smag modifies hu_layer/hv_layer; refresh barotropic hu/hv so ! the next stage's BCs see consistent state. if ( state % multilayer % smagorinsky_cs > 0.0_wp ) then call ml_horizontal_viscosity_smag ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % multilayer % smagorinsky_cs , & state % grid , nz_local , state % dt ) end if if ( state % multilayer % biharmonic_nu4 > 0.0_wp ) then call ml_horizontal_viscosity_biharmonic ( state % multilayer % h_layer , state % multilayer % hu_layer , & state % multilayer % hv_layer , state % multilayer % biharmonic_nu4 , & state % grid , nz_local , state % dt ) end if if ( state % multilayer % smagorinsky_cs > 0.0_wp . or . state % multilayer % biharmonic_nu4 > 0.0_wp ) then call ml_compute_barotropic_momentum ( state % multilayer % h_layer , state % multilayer % hu_layer , & state % multilayer % hv_layer , state % barotropic % hu , state % barotropic % hv , & state % grid , nz_local ) end if ! ---- Sponge zone relaxation ---- ! NOTE: the nz=1 ML fast path does NOT call accumulate_mass_src / ! accumulate_sponge_mass_src, so mass_src_tracked stays .false. and ! the console falls back to raw drift for this path.  This is a safe, ! conservative fallback: the nz=1 fused path is typically used for ! barotropic ML spin-up or validation, not the flagship forced runs ! (Sydney Harbour / coastal configs with precip/evap/sponge use nz>1). ! Instrumenting it requires threading the evap_mass_sink flag and the ! budget accumulators through the fused kernel; deferred until needed. call apply_sponge ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % dt , state % bc ) end subroutine solver_multilayer_rk_stage_nz1","tags":"","url":"proc/solver_multilayer_rk_stage_nz1.html"},{"title":"solver_nh_rk_stage – Rakali","text":"private  subroutine solver_nh_rk_stage(state, nz, use_nh) One RK stage: BCs, flux, update, friction, then NH correction Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state integer, intent(in) :: nz logical, intent(in) :: use_nh Calls proc~~solver_nh_rk_stage~~CallsGraph proc~solver_nh_rk_stage solver_nh_rk_stage proc~apply_boundary_conditions apply_boundary_conditions proc~solver_nh_rk_stage->proc~apply_boundary_conditions proc~apply_coriolis apply_coriolis proc~solver_nh_rk_stage->proc~apply_coriolis proc~apply_friction apply_friction proc~solver_nh_rk_stage->proc~apply_friction proc~apply_nh_boundary_conditions apply_nh_boundary_conditions proc~solver_nh_rk_stage->proc~apply_nh_boundary_conditions proc~apply_nh_correction apply_nh_correction proc~solver_nh_rk_stage->proc~apply_nh_correction proc~apply_sponge apply_sponge proc~solver_nh_rk_stage->proc~apply_sponge proc~compute_layer_from_barotropic compute_layer_from_barotropic proc~solver_nh_rk_stage->proc~compute_layer_from_barotropic proc~compute_update compute_update proc~solver_nh_rk_stage->proc~compute_update proc~compute_vertical_velocity compute_vertical_velocity proc~solver_nh_rk_stage->proc~compute_vertical_velocity proc~profiler_start profiler_start proc~solver_nh_rk_stage->proc~profiler_start proc~profiler_stop profiler_stop proc~solver_nh_rk_stage->proc~profiler_stop proc~save_barotropic_state save_barotropic_state proc~solver_nh_rk_stag