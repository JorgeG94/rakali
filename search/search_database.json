s one simulation. Multiple handles may coexist in the same !! process (the historical singleton restriction is gone). !! !! Lifecycle (one-shot): !!   void* h; !!   rki_create_from_namelist(filename, len, &h)  -> allocate + init + GPU !!   rki_step(h, n) / rki_advance(h, target_time) !!   rki_get_h_ptr(h, ptr, n), etc. !!   rki_destroy(&h)                              -> clean up; nulls h !! !! Lifecycle (two-phase, for programmatic bathymetry/IC): !!   rki_create(filename, len, &h) !!   rki_set_bathymetry(h, data, nx, ny) !!   rki_set_initial_h(h, data, nx, ny) !!   rki_finalize(h) !!   rki_step / rki_advance / ... !! !! Error codes: !!   0     success !!   -1    not initialised (or other entry-specific precondition failed) !!   -2    grid mismatch / already finalised / out-of-range argument !!   -3    multilayer mode not active / restart grid mismatch !!  -100   invalid handle (null or stale c_ptr) module rki_api use , intrinsic :: iso_c_binding , only : c_char , c_double , c_int , & c_loc , c_null_ptr , c_ptr use rki_constants , only : wp use rki_config , only : read_config , read_config_from_string , & validate_config , MAX_TIDAL_CONSTITUENTS use rki_config_schema , only : nml_dirname use rki_nml_schema , only : nml_schema_t use rki_state , only : load_bathymetry , fill_bathymetry_ghosts use rki_boundary_types , only : bc_init_from_config , bc_init_chapman use rki_solver , only : solver_step , solver_enter_data , solver_exit_data , & solver_update_host , solver_update_forcing , & solver_update_state use rki_init , only : init_from_config , init_multilayer_from_barotropic use rki_output , only : restart_write , restart_read use rki_handle , only : solver_handle_t , handle_create , handle_destroy , & handle_check , HANDLE_OK use pic_logger , only : logger => global_logger , info_level use pic_strings , only : to_string use rki_banner , only : print_banner use pic_knowledge , only : get_knowledge implicit none private integer ( c_int ), parameter :: RKI_ERR_BAD_HANDLE = - 100 !! State machine for GPU data lifecycle (h%on_device, h%host_is_current): !!   (F, F) — initial / after destroy !!   (T, F) — after finalize/step/advance (GPU canonical) !!   (T, T) — after rki_sync_host (both valid) !!   (F, T) — after ensure_host/exit_data (host only) !! !! Transitions: !!   rki_finalize      -> (T, F) !!   rki_step/advance  -> (T, F) !!   rki_sync_host     -> (T, T) !!   ensure_host       -> if host_is_current: no-op; else (F, T) !!   ensure_device     -> (T, F) !!   rki_destroy       -> handle freed contains ! ================================================================ ! Helpers ! ================================================================ subroutine c_to_f_string ( c_str , c_len , f_str ) !! Convert C string (char* + length) to Fortran character. integer ( c_int ), intent ( in ), value :: c_len character ( kind = c_char ), intent ( in ) :: c_str ( c_len ) character ( len = :), allocatable , intent ( out ) :: f_str integer :: i allocate ( character ( len = c_len ) :: f_str ) do i = 1 , c_len f_str ( i : i ) = c_str ( i ) end do end subroutine c_to_f_string function resolve ( c_handle , h ) result ( ierr ) !! Resolve an opaque c_ptr to a Fortran handle pointer. !! Returns 0 on success, RKI_ERR_BAD_HANDLE if the c_ptr is null !! or fails the magic-number check. Callers propagate the code. type ( c_ptr ), intent ( in ) :: c_handle type ( solver_handle_t ), pointer , intent ( out ) :: h integer ( c_int ) :: ierr integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK ) then ierr = 0 else ierr = RKI_ERR_BAD_HANDLE end if end function resolve subroutine ensure_host ( h ) !! If data is on GPU and host is stale, copy back to host. type ( solver_handle_t ), pointer , intent ( inout ) :: h if ( h % host_is_current ) return if ( h % on_device ) then call solver_exit_data ( h % state ) h % on_device = . false . h % host_is_current = . true . end if end subroutine ensure_host subroutine ensure_device ( h ) type ( solver_handle_t ), pointer , intent ( inout ) :: h if (. not . h % on_device ) then call solver_enter_data ( h % state ) h % on_device = . true . end if h % host_is_current = . false . end subroutine ensure_device subroutine refresh_host ( h ) !! Lightweight host refresh that keeps GPU data mapped. type ( solver_handle_t ), pointer , intent ( inout ) :: h if (. not . h % is_initialised ) return if ( h % host_is_current ) return if ( h % on_device ) then call solver_update_host ( h % state ) h % host_is_current = . true . end if end subroutine refresh_host subroutine push_state_to_device ( h ) !! Push solution arrays from host to GPU and mark device-canonical. type ( solver_handle_t ), pointer , intent ( inout ) :: h if (. not . h % on_device ) return call solver_update_state ( h % state ) h % host_is_current = . false . end subroutine push_state_to_device subroutine api_init_multilayer ( h ) !! Initialise multilayer arrays from the barotropic state. type ( solver_handle_t ), pointer , intent ( inout ) :: h call init_multilayer_from_barotropic ( h % state , h % cfg ) end subroutine api_init_multilayer ! ================================================================ ! Lifecycle ! ================================================================ function rki_working_precision () result ( nbytes ) & bind ( c , name = \"rki_working_precision\" ) !! Working-precision width in bytes (8 = double, 4 = single) for the !! solver real kind `wp`.  Process-global (compile-time), handle-less: !! lets the Python/ctypes layer pick the numpy dtype matching the !! zero-copy field views, which are `c_loc` of `real(wp)` arrays. !! Shared by the structured and unstructured Python paths (one !! symbol in librakali, since `wp` is identical for both). integer ( c_int ) :: nbytes nbytes = int ( storage_size ( 1.0_wp ) / 8 , c_int ) end function rki_working_precision function rki_create ( c_filename , c_len , c_handle ) result ( ierr ) & bind ( c , name = \"rki_create\" ) !! Phase 1: allocate handle, read config, allocate state arrays. !! !! On success, c_handle is set to the new opaque handle and ierr is 0. !! On failure, c_handle is null and ierr is non-zero. integer ( c_int ), intent ( in ), value :: c_len character ( kind = c_char ), intent ( in ) :: c_filename ( c_len ) type ( c_ptr ), intent ( out ) :: c_handle integer ( c_int ) :: ierr character ( len = :), allocatable :: filename type ( solver_handle_t ), pointer :: h type ( nml_schema_t ) :: schema character ( len = :), allocatable :: doc_dir integer :: status c_handle = handle_create () status = handle_check ( c_handle , h ) if ( status /= HANDLE_OK ) then ierr = RKI_ERR_BAD_HANDLE return end if call c_to_f_string ( c_filename , c_len , filename ) ! read_config builds + strict-parses the schema internally (unknown ! key / range / enum errors error-stop here); `schema` is returned ! for the parameter-doc dumps below. call read_config ( filename , h % cfg , schema ) call validate_config ( h % cfg ) ! Emit the MOM6-style parameter-doc dumps next to the input ! namelist (the FFI path does not bootstrap the output directory), ! using the schema returned by read_config (already built + parsed). doc_dir = nml_dirname ( filename ) call schema % write_doc_all ( doc_dir // \"rakali_parameter_doc.all\" ) call schema % write_doc_short ( doc_dir // \"rakali_parameter_doc.short\" ) call h % state % init_from_config ( h % cfg ) h % t_current = 0.0_wp h % is_initialised = . true . h % is_finalised = . false . h % user_set_bathymetry = . false . h % user_set_h = . false . h % user_set_layers = . false . call print_banner () ierr = 0 end function rki_create function rki_finalize ( c_handle ) result ( ierr ) bind ( c , name = \"rki_finalize\" ) !! Phase 2: complete setup after user has set fields. type ( c_ptr ), intent ( in ), value :: c_handle integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if if ( h % is_finalised ) then ierr = - 2 return end if associate ( s => h % state , cfg => h % cfg ) if (. not . h % user_set_bathymetry . and . len_trim ( cfg % bathymetry_file ) > 0 ) then call load_bathymetry ( trim ( cfg % bathymetry_file ), s ) end if call fill_bathymetry_ghosts ( s ) if (. not . h % user_set_h ) then call init_from_config ( s , cfg ) else if ( s % use_multilayer . and . . not . h % user_set_layers ) then call api_init_multilayer ( h ) end if call bc_init_from_config ( s % bc , cfg ) call bc_init_chapman ( s % bc , s % barotropic % h , s % barotropic % b , & s % grid % nx_total , s % grid % ny_total , s % grid % nghost ) call solver_enter_data ( s ) end associate h % on_device = . true . h % host_is_current = . false . h % is_finalised = . true . ierr = 0 end function rki_finalize function rki_create_from_namelist ( c_filename , c_len , c_handle ) result ( ierr ) & bind ( c , name = \"rki_create_from_namelist\" ) !! One-shot create + finalize from a namelist file. integer ( c_int ), intent ( in ), value :: c_len character ( kind = c_char ), intent ( in ) :: c_filename ( c_len ) type ( c_ptr ), intent ( out ) :: c_handle integer ( c_int ) :: ierr ierr = rki_create ( c_filename , c_len , c_handle ) if ( ierr /= 0 ) return ierr = rki_finalize ( c_handle ) end function rki_create_from_namelist function rki_create_from_string ( c_text , c_len , c_handle ) result ( ierr ) & bind ( c , name = \"rki_create_from_string\" ) !! Phase 1, fully in-memory: allocate the handle and read config from !! the `c_text` namelist buffer (newline-separated) — no temp file, !! no `chdir`, no on-disk parameter-doc dumps.  Otherwise identical !! to [[rki_create]] (same strict validation, state !! allocation).  Pair with the `set_*` setters + [[rki_finalize]]. integer ( c_int ), intent ( in ), value :: c_len character ( kind = c_char ), intent ( in ) :: c_text ( c_len ) type ( c_ptr ), intent ( out ) :: c_handle integer ( c_int ) :: ierr character ( len = :), allocatable :: text type ( solver_handle_t ), pointer :: h integer :: status c_handle = handle_create () status = handle_check ( c_handle , h ) if ( status /= HANDLE_OK ) then ierr = RKI_ERR_BAD_HANDLE return end if call c_to_f_string ( c_text , c_len , text ) ! Strict parse + apply straight into h%cfg, in memory (error-stops on ! any unknown key / range / enum violation, like the file path). call read_config_from_string ( text , h % cfg ) call validate_config ( h % cfg ) call h % state % init_from_config ( h % cfg ) h % t_current = 0.0_wp h % is_initialised = . true . h % is_finalised = . false . h % user_set_bathymetry = . false . h % user_set_h = . false . h % user_set_layers = . false . call print_banner () ierr = 0 end function rki_create_from_string function rki_create_from_namelist_string ( c_text , c_len , c_handle ) & result ( ierr ) bind ( c , name = \"rki_create_from_namelist_string\" ) !! One-shot create + finalize from an in-memory namelist buffer. integer ( c_int ), intent ( in ), value :: c_len character ( kind = c_char ), intent ( in ) :: c_text ( c_len ) type ( c_ptr ), intent ( out ) :: c_handle integer ( c_int ) :: ierr ierr = rki_create_from_string ( c_text , c_len , c_handle ) if ( ierr /= 0 ) return ierr = rki_finalize ( c_handle ) end function rki_create_from_namelist_string subroutine rki_destroy ( c_handle ) bind ( c , name = \"rki_destroy\" ) !! Destroy the simulation and free the handle. Nulls c_handle. !! Idempotent on null/already-destroyed handles. type ( c_ptr ), intent ( inout ) :: c_handle type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status /= HANDLE_OK ) then !! Still call destroy to handle the null case gracefully. call handle_destroy ( c_handle ) return end if !! Must do full exit_data before deallocate to unmap GPU memory and !! avoid \"partially present\" errors on a future create. if ( h % on_device ) then call solver_exit_data ( h % state ) h % on_device = . false . end if if ( h % is_initialised ) call h % state % destroy () call get_knowledge () call handle_destroy ( c_handle ) end subroutine rki_destroy ! ================================================================ ! Stepping ! ================================================================ function rki_step ( c_handle , n_steps ) result ( ierr ) bind ( c , name = \"rki_step\" ) type ( c_ptr ), intent ( in ), value :: c_handle integer ( c_int ), intent ( in ), value :: n_steps integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h integer :: i ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_finalised ) then ierr = - 1 return end if call ensure_device ( h ) h % host_is_current = . false . do i = 1 , n_steps call solver_step ( h % state , & dt_max = ( h % cfg % t_end - h % t_current ), & time = h % t_current ) h % t_current = h % t_current + h % state % dt end do ierr = 0 end function rki_step function rki_advance ( c_handle , target_time ) result ( ierr ) & bind ( c , name = \"rki_advance\" ) type ( c_ptr ), intent ( in ), value :: c_handle real ( c_double ), intent ( in ), value :: target_time integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_finalised ) then ierr = - 1 return end if call ensure_device ( h ) h % host_is_current = . false . do while ( h % t_current < target_time - 1.0e-10_wp ) call solver_step ( h % state , & dt_max = real ( target_time - h % t_current , wp ), & time = h % t_current ) h % t_current = h % t_current + h % state % dt end do ierr = 0 end function rki_advance ! ================================================================ ! Queries ! ================================================================ function rki_get_time ( c_handle ) result ( t ) bind ( c , name = \"rki_get_time\" ) type ( c_ptr ), intent ( in ), value :: c_handle real ( c_double ) :: t type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK ) then t = h % t_current else t = 0.0_wp end if end function rki_get_time function rki_get_dt ( c_handle ) result ( dt ) bind ( c , name = \"rki_get_dt\" ) type ( c_ptr ), intent ( in ), value :: c_handle real ( c_double ) :: dt type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK . and . h % is_initialised ) then dt = h % state % dt else dt = 0.0_wp end if end function rki_get_dt subroutine rki_get_grid_info ( c_handle , nx , ny , nghost , dx , dy ) & bind ( c , name = \"rki_get_grid_info\" ) !! Return physical grid dimensions (excluding ghost cells). type ( c_ptr ), intent ( in ), value :: c_handle integer ( c_int ), intent ( out ) :: nx , ny , nghost real ( c_double ), intent ( out ) :: dx , dy type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK . and . h % is_initialised ) then nx = h % state % grid % nx_phys ny = h % state % grid % ny_phys nghost = h % state % grid % nghost dx = h % state % grid % dx dy = h % state % grid % dy else nx = 0 ny = 0 nghost = 0 dx = 0.0_wp dy = 0.0_wp end if end subroutine rki_get_grid_info function rki_get_step_count ( c_handle ) result ( n ) & bind ( c , name = \"rki_get_step_count\" ) type ( c_ptr ), intent ( in ), value :: c_handle integer ( c_int ) :: n type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK . and . h % is_initialised ) then n = h % state % step_count else n = 0 end if end function rki_get_step_count function rki_get_nz_ml ( c_handle ) result ( nz ) bind ( c , name = \"rki_get_nz_ml\" ) type ( c_ptr ), intent ( in ), value :: c_handle integer ( c_int ) :: nz type ( solver_handle_t ), pointer :: h integer :: status status = handle_check ( c_handle , h ) if ( status == HANDLE_OK . and . h % is_initialised . and . h % state % use_multilayer ) then nz = h % state % multilayer % nz_ml else nz = 0 end if end function rki_get_nz_ml ! ================================================================ ! Zero-copy field accessors (return c_ptr to Fortran data) ! ================================================================ function rki_get_h_ptr ( c_handle , ptr , nx_total , ny_total ) result ( ierr ) & bind ( c , name = \"rki_get_h_ptr\" ) type ( c_ptr ), intent ( in ), value :: c_handle type ( c_ptr ), intent ( out ) :: ptr integer ( c_int ), intent ( out ) :: nx_total , ny_total integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h real ( wp ), pointer :: tmp (:, :) ptr = c_null_ptr nx_total = 0 ny_total = 0 ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if call ensure_host ( h ) tmp => h % state % barotropic % h ptr = c_loc ( tmp ( 1 , 1 )) nx_total = h % state % grid % nx_total ny_total = h % state % grid % ny_total ierr = 0 end function rki_get_h_ptr function rki_get_hu_ptr ( c_handle , ptr , nx_total , ny_total ) result ( ierr ) & bind ( c , name = \"rki_get_hu_ptr\" ) type ( c_ptr ), intent ( in ), value :: c_handle type ( c_ptr ), intent ( out ) :: ptr integer ( c_int ), intent ( out ) :: nx_total , ny_total integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h real ( wp ), pointer :: tmp (:, :) ptr = c_null_ptr nx_total = 0 ny_total = 0 ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if call ensure_host ( h ) tmp => h % state % barotropic % hu ptr = c_loc ( tmp ( 1 , 1 )) nx_total = h % state % grid % nx_total ny_total = h % state % grid % ny_total ierr = 0 end function rki_get_hu_ptr function rki_get_hv_ptr ( c_handle , ptr , nx_total , ny_total ) result ( ierr ) & bind ( c , name = \"rki_get_hv_ptr\" ) type ( c_ptr ), intent ( in ), value :: c_handle type ( c_ptr ), intent ( out ) :: ptr integer ( c_int ), intent ( out ) :: nx_total , ny_total integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h real ( wp ), pointer :: tmp (:, :) ptr = c_null_ptr nx_total = 0 ny_total = 0 ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if call ensure_host ( h ) tmp => h % state % barotropic % hv ptr = c_loc ( tmp ( 1 , 1 )) nx_total = h % state % grid % nx_total ny_total = h % state % grid % ny_total ierr = 0 end function rki_get_hv_ptr function rki_get_b_ptr ( c_handle , ptr , nx_total , ny_total ) result ( ierr ) & bind ( c , name = \"rki_get_b_ptr\" ) type ( c_ptr ), intent ( in ), value :: c_handle type ( c_ptr ), intent ( out ) :: ptr integer ( c_int ), intent ( out ) :: nx_total , ny_total integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h real ( wp ), pointer :: tmp (:, :) ptr = c_null_ptr nx_total = 0 ny_total = 0 ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if call ensure_host ( h ) tmp => h % state % barotropic % b ptr = c_loc ( tmp ( 1 , 1 )) nx_total = h % state % grid % nx_total ny_total = h % state % grid % ny_total ierr = 0 end function rki_get_b_ptr ! RK2 save-buffer accessors (h&#94;n / hu&#94;n / hv&#94;n captured at start of stage 1 ! by fused_update_stage1, consumed by fused_update_stage2 for the average). ! Needed for mid-RK checkpointing. function rki_get_h0_ptr ( c_handle , ptr , nx_total , ny_total ) result ( ierr ) & bind ( c , name = \"rki_get_h0_ptr\" ) type ( c_ptr ), intent ( in ), value :: c_handle type ( c_ptr ), intent ( out ) :: ptr integer ( c_int ), intent ( out ) :: nx_total , ny_total integer ( c_int ) :: ierr type ( solver_handle_t ), pointer :: h real ( wp ), pointer :: tmp (:, :) ptr = c_null_ptr nx_total = 0 ny_total = 0 ierr = resolve ( c_handle , h ) if ( ierr /= 0 ) return if (. not . h % is_initialised ) then ierr = - 1 return end if call ensure_host ( h ) tmp => h % state % barotropic % h0 ptr = c_loc ( tmp ( 1 , 1 )) nx_total =