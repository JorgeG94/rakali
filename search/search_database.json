d Procedures procedure, public, non_overridable :: bytes => nh_state_bytes private pure function nh_state_bytes (this) result(nbytes) Counted allocatable footprint of the non-hydrostatic slot: layer\nvelocities + NH pressure + RK2 saves + CG Poisson workspace + the\ngated mode-splitting buffers (0 when split_ratio == 1). Arguments Type Intent Optional Attributes Name class( nonhydrostatic_state_t ), intent(in) :: this Return Value integer(kind=int64) procedure, public, non_overridable :: destroy => nh_state_destroy private  subroutine nh_state_destroy (this) Arguments Type Intent Optional Attributes Name class( nonhydrostatic_state_t ), intent(inout) :: this procedure, public, non_overridable :: init => nh_state_init private  subroutine nh_state_init (this, grid) Allocate all NH arrays at the grid size and the configured\nlayer count.  Mode-splitting arrays are allocated only when split_ratio /= 1 .  PCG preconditioner workspace cg_z is\nalways allocated; the OpenACC enter data directive is\nconditional on nh_preconditioner so unused PCG state isn’t\nmapped to the device. Read more… Arguments Type Intent Optional Attributes Name class( nonhydrostatic_state_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid Source Code type :: nonhydrostatic_state_t !! Per-layer NH prognostics + CG workspaces + mode-split buffers. ! Layer count integer :: nz = 1 !! Number of NH sigma layers ! Sigma vertical coordinate real ( wp ), allocatable :: dsig (:) !! Sigma layer thicknesses (nz), sum = 1 ! Per-layer prognostic velocities + pressure (nx_total, ny_total, nz) real ( wp ), allocatable :: u_layer (:, :, :) !! Per-layer x-velocity real ( wp ), allocatable :: v_layer (:, :, :) !! Per-layer y-velocity real ( wp ), allocatable :: w (:, :, :) !! Vertical velocity at interfaces (nx_total, ny_total, nz+1) real ( wp ), allocatable :: q_nh (:, :, :) !! Non-hydrostatic pressure ! RK2 saves real ( wp ), allocatable :: u_layer0 (:, :, :) real ( wp ), allocatable :: v_layer0 (:, :, :) real ( wp ), allocatable :: w0 (:, :, :) ! CG Poisson solver workspaces (nx_total, ny_total, nz) real ( wp ), allocatable :: cg_r (:, :, :) !! Residual real ( wp ), allocatable :: cg_p (:, :, :) !! Search direction real ( wp ), allocatable :: cg_Ap (:, :, :) !! Operator application real ( wp ), allocatable :: cg_z (:, :, :) !! Preconditioned residual (PCG only) ! Workspace: barotropic momentum before HLL update real ( wp ), allocatable :: hu_pre (:, :) real ( wp ), allocatable :: hv_pre (:, :) ! ----- CG / NH scalar config ----- real ( wp ) :: nh_tolerance = 1.0e-6_wp !! CG convergence tolerance integer :: nh_max_iterations = 100 !! Maximum CG iterations logical :: nh_preconditioner = . false . !! Enable vertical-line preconditioner for CG solver integer :: nh_solve_interval = 1 !! Solve NH pressure every N steps (1 = every step) ! ----- Mode-splitting config + arrays ----- ! Allocated only when `split_ratio /= 1`.  N fast barotropic ! substeps per slow baroclinic step, ROMS-style time averaging. integer :: split_ratio = 1 !! Barotropic-baroclinic split: 0=auto, 1=unsplit, N>1=fixed logical :: split_averaging = . true . !! ROMS-style time averaging over barotropic substeps real ( wp ), allocatable :: h_avg (:, :) !! Time-averaged barotropic depth real ( wp ), allocatable :: hu_avg (:, :) !! Time-averaged barotropic x-momentum real ( wp ), allocatable :: hv_avg (:, :) !! Time-averaged barotropic y-momentum real ( wp ), allocatable :: h_bt0 (:, :) !! Barotropic RK2 saved depth real ( wp ), allocatable :: hu_bt0 (:, :) !! Barotropic RK2 saved x-momentum real ( wp ), allocatable :: hv_bt0 (:, :) !! Barotropic RK2 saved y-momentum real ( wp ), allocatable :: baro_tend_x (:, :) !! NH barotropic tendency in x real ( wp ), allocatable :: baro_tend_y (:, :) !! NH barotropic tendency in y contains procedure , non_overridable :: init => nh_state_init procedure , non_overridable :: destroy => nh_state_destroy procedure , non_overridable :: bytes => nh_state_bytes end type no