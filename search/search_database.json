ntent ( in ) :: edge_len ( 3 , n ) integer , intent ( in ) :: surrogate_neighbours ( 3 , n ) real ( wp ), intent ( inout ) :: hTr_layer ( nz , n ) real ( wp ), intent ( in ) :: kappa , dt integer :: cell , k , e , nbr real ( wp ) :: kappa_eff , tr_c , tr_nbr , h_k , h_nbr , inv_area real ( wp ) :: dx_cn , dy_cn , d_cn , flux_accum do concurrent ( k = 1 : nz , cell = 1 : n ) hTr_pre ( k , cell ) = hTr_layer ( k , cell ) end do do concurrent ( cell = 1 : ncells_owned ) & local ( k , e , nbr , kappa_eff , tr_c , tr_nbr , h_k , h_nbr , inv_area , & dx_cn , dy_cn , d_cn , flux_accum ) if ( height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle inv_area = 1.0_wp / area ( cell ) ! Per-cell stability limit: kappa * dt / radius&#94;2 <= 0.125 kappa_eff = min ( kappa , 0.125_wp * radius ( cell ) ** 2 / ( dt + 1.0e-30_wp )) do k = 1 , nz h_k = h_layer ( k , cell ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle tr_c = hTr_pre ( k , cell ) / h_k flux_accum = 0.0_wp do e = 1 , 3 nbr = surrogate_neighbours ( e , cell ) if ( nbr == cell ) cycle ! boundary edge — zero-flux wall h_nbr = h_layer ( k , nbr ) if ( h_nbr < THIN_LAYER_THRESHOLD ) cycle ! dry-nbr — zero-flux wall tr_nbr = hTr_pre ( k , nbr ) / h_nbr dx_cn = centroid_x ( nbr ) - centroid_x ( cell ) dy_cn = centroid_y ( nbr ) - centroid_y ( cell ) d_cn = sqrt ( dx_cn * dx_cn + dy_cn * dy_cn ) flux_accum = flux_accum + 0.5_wp * ( h_k + h_nbr ) & * ( tr_nbr - tr_c ) * edge_len ( e , cell ) / d_cn end do hTr_layer ( k , cell ) = hTr_layer ( k , cell ) & + kappa_eff * dt * flux_accum * inv_area end do end do end subroutine ml_horizontal_diffusion_tracer_unstr_impl","tags":"","url":"proc/ml_horizontal_diffusion_tracer_unstr_impl.html"},{"title":"ml_vertical_diffusion_tracer_unstr_impl – Rakali","text":"private pure subroutine ml_vertical_diffusion_tracer_unstr_impl(nz, n, ncells_owned, height_cv, h_layer, hu_layer, hv_layer, rho_layer, rho_0, vmix_ri_alpha, vmix_nu_max, hTr_layer, kappa_bg, dt) Flat-impl of ml_vertical_diffusion_tracer_unstr :