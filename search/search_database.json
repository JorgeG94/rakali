nterface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: u_avg real(kind=wp), private :: v_avg Source Code pure subroutine compute_depth_averaged_momentum ( h , u_layer , v_layer , dsig , & hu , hv , grid , nz ) !! Compute depth-integrated momentum from per-layer velocities !! hu = h * sum(dsig_k * u_k), hv = h * sum(dsig_k * v_k) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv ( grid % nx_total , grid % ny_total ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: u_avg , v_avg nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( u_avg , v_avg , k ) u_avg = 0.0_wp v_avg = 0.0_wp do k = 1 , nz u_avg = u_avg + dsig ( k ) * u_layer ( i , j , k ) v_avg = v_avg + dsig ( k ) * v_layer ( i , j , k ) end do hu ( i , j ) = h ( i , j ) * u_avg hv ( i , j ) = h ( i , j ) * v_avg end do end subroutine compute_depth_averaged_momentum","tags":"","url":"proc/compute_depth_averaged_momentum.html"},{"title":"compute_layer_from_barotropic – Rakali","text":"public pure subroutine compute_layer_from_barotropic(h, hu, hv, hu_pre, hv_pre, u_layer, v_layer, dsig, grid, nz, dt) Distribute barotropic acceleration (hu_new - hu_pre)/h uniformly\nto all layer velocities. Arguments Type Intent O