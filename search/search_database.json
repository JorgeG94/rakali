ourcefile~rki_grid.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_vcoord.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_ml_vertical_viscosity_unstr.f90~~AfferentGraph sourcefile~rki_ml_vertical_viscosity_unstr.f90 rki_ml_vertical_viscosity_unstr.F90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_ml_vertical_viscosity_unstr.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Vertical viscosity for layer momentum on the unstructured grid. module rki_ml_vertical_viscosity_unstr !! Currently implements the gradient-Richardson-number closure of !! Pacanowski & Philander (1981).  Computes a turbulent viscosity at !! each interior interface and applies a diffusive flux to layer !! momentum: !! !!   nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg !! !! Column-local, no neighbour reads — safe for `do concurrent`. !! When an ocean-grade KPP closure lands, it will live alongside this !! one and the solver will pick between them via a config flag. use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE use rki_state_unstr , only : unstr_state_t use rki_ml_common_unstr , only : ML_MIN_DEPTH_UNSTR , BPG_NZ_MAX , & VANISHING_LAYER_TOL_UNSTR implicit none private public :: ml_vertical_viscosity_unstr contains pure subroutine ml_vertical_viscosity_unstr ( state , dt ) !! Ri-dependent vertical viscosity for momentum. !! Computes gradient Richardson number at each interface and applies !! turbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. !! !! Column-local — no neighbour access, safe for `do concurrent`. type ( unstr_state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: dt integer :: cell , k , nz , n real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 real ( wp ) :: du , dv , drho , Ri , denom , nu_t , flux_u , flux_v real ( wp ) :: flux_u_iface ( BPG_NZ_MAX ), flux_v_iface ( BPG_NZ_MAX ) real ( wp ), parameter :: EPS = 1.0e-20_wp if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = state % ncells_owned if ( nz < 2 ) return do concurrent ( cell = 1 : n ) & local ( k , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , & du , dv , drho , Ri , denom , nu_t , flux_u , flux_v , & flux_u_iface , flux_v_iface ) if ( state % barotropic % height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle ! Pass 1: compute interface fluxes do k = 1 , nz - 1 h_k = state % multilayer % h_layer ( k , cell ) h_k1 = state % multilayer % h_layer ( k + 1 , cell ) h_avg = 0.5_wp * ( h_k + h_k1 ) flux_u_iface ( k ) = 0.0_wp flux_v_iface ( k ) = 0.0_wp ! VCOORD_ZSTAR_FULL: no-flux through interfaces adjacent to ! vanishing layers (otherwise nu_t * du / h_avg blows up ! when h_avg = h_min / 2). if ( h_avg > VANISHING_LAYER_TOL_UNSTR . and . & h_k > VANISHING_LAYER_TOL_UNSTR . and . & h_k1 > VANISHING_LAYER_TOL_UNSTR ) then if ( h_k > DRY_TOLERANCE ) then u_k = state % multilayer % hu_layer ( k , cell ) / h_k v_k = state % multilayer % hv_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = state % multilayer % hu_layer ( k + 1 , cell ) / h_k1 v_k1 = state % multilayer % hv_layer ( k + 1 , cell ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = state % multilayer % rho_layer ( k , cell ) - state % multilayer % rho_layer ( k + 1 , cell ) Ri = GRAVITY * ( drho / state % multilayer % rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + state % multilayer % vmix_ri_alpha * Ri nu_t = state % multilayer % vmix_nu_max / ( denom * denom ) + state % multilayer % vmix_nu_bg ! Stability: nu_t * dt / h_avg&#94;2 <= 0.5 if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) then nu_t = 0.5_wp * h_avg * h_avg / dt end if flux_u_iface ( k ) = nu_t * du / h_avg * dt flux_v_iface ( k ) = nu_t * dv / h_avg * dt end if end do ! Pass 2: apply fluxes to layers.  flux_*_iface(k) is the momentum ! transfer across interface k+1/2 (units m&#94;2/s); same quantity adds ! to layer k and subtracts from layer k+1.  Previous h_layer ! multipliers were dimensionally wrong and non-conservative under ! non-uniform dz (e.g. VCOORD_ZSTAR_FULL). state % multilayer % hu_layer ( 1 , cell ) = state % multilayer % hu_layer ( 1 , cell ) & + flux_u_iface ( 1 ) state % multilayer % hv_layer ( 1 , cell ) = state % multilayer % hv_layer ( 1 , cell ) & + flux_v_iface ( 1 ) do k = 2 , nz - 1 state % multilayer % hu_layer ( k , cell ) = state % multilayer % hu_layer ( k , cell ) & + ( flux_u_iface ( k ) - flux_u_iface ( k - 1 )) state % multilayer % hv_layer ( k , cell ) = state % multilayer % hv_layer ( k , cell ) & + ( flux_v_iface ( k ) - flux_v_iface ( k - 1 )) end do state % multilayer % hu_layer ( nz , cell ) = state % multilayer % hu_layer ( nz , cell ) & - flux_u_iface ( nz - 1 ) state % multilayer % hv_layer ( nz , cell ) = state % multilayer % hv_layer ( nz , cell ) & - flux_v_iface ( nz - 1 ) end do end subroutine ml_vertical_viscosity_unstr end module rki_ml_vertical_viscosity_unstr","tags":"","url":"sourcefile/rki_ml_vertical_viscosity_unstr.f90.html"},{"title":"rki_kernel_pressure.F90 – Rakali","text":"Non-hydrostatic pressure correction kernels This file depends on sourcefile~~rki_kernel_pressure.f90~~EfferentGraph sourcefile~rki_kernel_pressure.f90 rki_kernel_pressure.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_pressure.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_kernel_pressure.f90->sourcefile~rki_grid.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_kernel_pressure.f90~~AfferentGraph sourcefile~rki_kernel_pressure.f90 rki_kernel_pressure.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_kernel_pressure.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Non-hydrostatic pressure correction kernels module rki_kernel_pressure !! Fractional-step NH pressure correction (Stelling & Zijlema, 2003). !! Multi-layer sigma coordinates with a CG Poisson solver. use rki_constants , only : wp , GRAVITY , NH_MIN_DEPTH use rki_grid , only : hgrid_t implicit none private public :: compute_depth_averaged_momentum public :: save_barotropic_state public :: compute_layer_from_barotropic public :: compute_vertical_velocity public :: compute_nh_rhs public :: apply_poisson_operator public :: compute_vert_coefficients public :: apply_poisson_operator_fast public :: apply_nh_correction public :: compute_rk2_average_layers public :: solve_nh_pressure public :: apply_vertical_preconditioner public :: compute_nh_baro_tendency public :: apply_baro_nh_tendency public :: reconcile_barotropic contains pure subroutine compute_depth_averaged_momentum ( h , u_layer , v_layer , dsig , & hu , hv , grid , nz ) !! Compute depth-integrated momentum from per-layer velocities !! hu = h * sum(dsig_k * u_k), hv = h * sum(dsig_k * v_k) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv ( grid % nx_total , grid % ny_total ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: u_avg , v_avg nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( u_avg , v_avg , k ) u_avg = 0.0_wp v_avg = 0.0_wp do k = 1 , nz u_avg = u_avg + dsig ( k ) * u_layer ( i , j , k ) v_avg = v_avg + dsig ( k ) * v_layer ( i , j , k ) end do hu ( i , j ) = h ( i , j ) * u_avg hv ( i , j ) = h ( i , j ) * v_avg end do end subroutine compute_depth_averaged_momentum pure subroutine save_barotropic_state ( hu , hv , hu_pre , hv_pre , grid ) !! Save barotropic momentum before HLL update type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hu_pre ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv_pre ( grid % nx_total , grid % ny_total ) integer :: i , j , nx , ny nx = grid % nx_total ny = grid % ny_total do concurrent ( j = 1 : ny , i = 1 : nx ) hu_pre ( i , j ) = hu ( i , j ) hv_pre ( i , j ) = hv ( i , j ) end do end subroutine save_barotropic_state pure subroutine compute_layer_from_barotropic ( h , hu , hv , hu_pre , hv_pre , & u_layer , v_layer , dsig , & grid , nz , dt ) !! Distribute barotropic acceleration (hu_new - hu_pre)/h uniformly !! to all layer velocities. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ), hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu_pre ( grid % nx_total , grid % ny_total ), hv_pre ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_val , du , dv nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , du , dv , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then du = ( hu ( i , j ) - hu_pre ( i , j )) / h_val dv = ( hv ( i , j ) - hv_pre ( i , j )) / h_val do k = 1 , nz u_layer ( i , j , k ) = u_layer ( i , j , k ) + du v_layer ( i , j , k ) = v_layer ( i , j , k ) + dv end do else do k = 1 , nz u_layer ( i , j , k ) = 0.0_wp v_layer ( i , j , k ) = 0.0_wp end do end if end do end subroutine compute_layer_from_barotropic pure subroutine compute_vertical_velocity ( h , u_layer , v_layer , b , dsig , w , & grid , nz ) !! Integrate continuity equation bottom-up to get vertical velocity !! !! w(:,:,1) = 0 at bottom !! w(:,:,k+1) = w(:,:,k) - dsig_k * [d(h*u_k)/dx + d(h*v_k)/dy] !! using central differences for horizontal divergence type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: div_hu , div_hv nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( div_hu , div_hv , k ) w ( i , j , 1 ) = 0.0_wp if ( h ( i , j ) > NH_MIN_DEPTH ) then do k = 1 , nz div_hu = ( h ( i + 1 , j ) * u_layer ( i + 1 , j , k ) - & h ( i - 1 , j ) * u_layer ( i - 1 , j , k )) / ( 2.0_wp * dx ) div_hv = ( h ( i , j + 1 ) * v_layer ( i , j + 1 , k ) - & h ( i , j - 1 ) * v_layer ( i , j - 1 , k )) / ( 2.0_wp * dy ) w ( i , j , k + 1 ) = w ( i , j , k ) - dsig ( k ) * ( div_hu + div_hv ) end do else do k = 1 , nz w ( i , j , k + 1 ) = 0.0_wp end do end if end do end subroutine compute_vertical_velocity pure subroutine compute_nh_rhs ( h , w , dsig , rhs , nx , ny , nz , nghost , dx , dy , dt ) !! Public only for the unit-test suite (no production module imports it). !! Compute RHS of NH Poisson equation from velocity divergence !! !! rhs_k = -(w_{k+1} - w_k) / (dsig_k * h * dt) integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: w ( nx , ny , nz + 1 ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: rhs ( nx , ny , nz ) real ( wp ), intent ( in ) :: dx , dy , dt integer :: i , j , k real ( wp ) :: h_val do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz rhs ( i , j , k ) = - ( w ( i , j , k + 1 ) - w ( i , j , k )) & / ( dsig ( k ) * h_val * dt ) end do else do k = 1 , nz rhs ( i , j , k ) = 0.0_wp end do end if end do end subroutine compute_nh_rhs pure subroutine apply_poisson_operator ( h , dsig , p , Ap , nx , ny , nz , nghost , dx , dy , dt ) !! Public only for the unit-test suite (no production module imports it). !! Matrix-free Poisson operator: Ap = A * p !! !! Horizontal: 5-point Laplacian per layer !! Vertical: tridiagonal coupling between layers integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: p ( nx , ny , nz ) real ( wp ), intent ( out ) :: Ap ( nx , ny , nz ) real ( wp ), intent ( in ) :: dx , dy , dt integer :: i , j , k real ( wp ) :: h_val , horiz , vert_lo , vert_hi real ( wp ) :: inv_dx2 , inv_dy2 , inv_dt2 inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) inv_dt2 = 1.0_wp / ( dt * dt ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , horiz , vert_lo , vert_hi , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz ! Horizontal Laplacian horiz = h_val * inv_dx2 * ( p ( i + 1 , j , k ) - 2.0_wp * p ( i , j , k ) + p ( i - 1 , j , k )) & + h_val * inv_dy2 * ( p ( i , j + 1 , k ) - 2.0_wp * p ( i , j , k ) + p ( i , j - 1 , k )) ! Vertical coupling: second derivative in sigma vert_lo = 0.0_wp vert_hi = 0.0_wp if ( k > 1 ) then vert_lo = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) * & ( p ( i , j , k - 1 ) - p ( i , j , k )) end if if ( k < nz ) then vert_hi = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) * & ( p ( i , j , k + 1 ) - p ( i , j , k )) end if Ap ( i , j , k ) = horiz + vert_lo + vert_hi end do else do k = 1 , nz Ap ( i , j , k ) = 0.0_wp end do end if end do end subroutine apply_poisson_operator pure subroutine compute_vert_coefficients ( dsig , nz , dt , vert_lo , vert_hi ) !! Pre-compute vertical coupling coefficients (dsig-dependent part only) !! !! vert_lo(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k-1)) * dsig(k))  for k=2..nz !! vert_hi(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k+1)) * dsig(k))  for k=1..nz-1 !! In the operator, multiply by 1/h(i,j) to get the full coefficient. integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt real ( wp ), intent ( out ) :: vert_lo ( nz ) real ( wp ), intent ( out ) :: vert_hi ( nz ) integer :: k real ( wp ) :: inv_dt2 inv_dt2 = 1.0_wp / ( dt * dt ) vert_lo ( 1 ) = 0.0_wp do k = 2 , nz vert_lo ( k ) = 2.0_wp * inv_dt2 / (( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) end do do k = 1 , nz - 1 vert_hi ( k ) = 2.0_wp * inv_dt2 / (( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) end do vert_hi ( nz ) = 0.0_wp end subroutine compute_vert_coefficients pure subroutine apply_poisson_operator_fast ( h , p , Ap , nx , ny , nz , nghost , & inv_dx2 , inv_dy2 , vert_lo , vert_hi ) !! Poisson operator (Ap = A*p) using pre-computed dsig-dependent !! vertical coefficients to avoid divisions; horizontal 5-point !! Laplacian + vertical tridiagonal coupling (coefficients / h). integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: p ( nx , ny , nz ) real ( wp ), intent ( out ) :: Ap ( nx , ny , nz ) real ( wp ), intent ( in ) :: inv_dx2 , inv_dy2 real ( wp ), intent ( in ) :: vert_lo ( nz ) real ( wp ), intent ( in ) :: vert_hi ( nz ) integer :: i , j , k real ( wp ) :: h_val , horiz , vl , vh do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , horiz , vl , vh , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz ! Horizontal Laplacian horiz = h_val * inv_dx2 * ( p ( i + 1 , j , k ) - 2.0_wp * p ( i , j , k ) + p ( i - 1 , j , k )) & + h_val * inv_dy2 * ( p ( i , j + 1 , k ) - 2.0_wp * p ( i , j , k ) + p ( i , j - 1 , k )) ! Vertical coupling: pre-computed coefficients / h vl = 0.0_wp vh = 0.0_wp if ( k > 1 ) then vl = vert_lo ( k ) / h_val * ( p ( i , j , k - 1 ) - p ( i , j , k )) end if if ( k < nz ) then vh = vert_hi ( k ) / h_val * ( p ( i , j , k + 1 ) - p ( i , j , k )) end if Ap ( i , j , k ) = horiz + vl + vh end do else do k = 1 , nz Ap ( i , j , k ) = 0.0_wp end do end if end do end subroutine apply_poisson_operator_fast pure subroutine apply_nh_correction ( h , u_layer , v_layer , w , q_nh , dsig , & grid , nz , dt ) !! Apply NH pressure gradient to correct layer velocities !! !! u_k -= dt * dq/dx !! v_k -= dt * dq/dy !! w corrected vertically type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: dqdx , dqdy , h_val nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( dqdx , dqdy , h_val , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz ! Horizontal NH pressure gradient (central difference) dqdx = ( q_nh ( i + 1 , j , k ) - q_nh ( i - 1 , j , k )) / ( 2.0_wp * dx ) dqdy = ( q_nh ( i , j + 1 , k ) - q_nh ( i , j - 1 , k )) / ( 2.0_wp * dy ) u_layer ( i , j , k ) = u_layer ( i , j , k ) - dt * dqdx v_layer ( i , j , k ) = v_layer ( i , j , k ) - dt * dqdy end do ! Vertical velocity correction ! w_1 = 0 (bottom), already set do k = 1 , nz if ( k < nz ) then w ( i , j , k + 1 ) = w ( i , j , k + 1 ) + & dt * ( q_nh ( i , j , k + 1 ) - q_nh ( i , j , k )) & * 2.0_wp / ( h_val * ( dsig ( k ) + dsig ( k + 1 ))) else ! Top interface: q above surface = 0 w ( i , j , k + 1 ) = w ( i , j , k + 1 ) - & dt * q_nh ( i , j , k ) * 2.0_wp / ( h_val * dsig ( k )) end if end do end if end do end subroutine apply_nh_correction pure subroutine compute_rk2_average_layers ( u_layer , v_layer , w , & u_layer0 , v_layer0 , w0 , & grid , nz ) !! RK2 averaging for layer fields: 0.5 * (old + new) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: u_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: w0 ( grid % nx_total , grid % ny_total , nz + 1 ) integer :: i , j , k , nx , ny , nghost nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) u_layer ( i , j , k ) = 0.5_wp * ( u_layer0 ( i , j , k ) + u_layer ( i , j , k )) v_layer ( i , j , k ) = 0.5_wp * ( v_layer0 ( i , j , k ) + v_layer ( i , j , k )) end do do concurrent ( k = 1 : nz + 1 , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) w ( i , j , k ) = 0.5_wp * ( w0 ( i , j , k ) + w ( i , j , k )) end do end subroutine compute_rk2_average_layers pure subroutine apply_vertical_preconditioner ( h , dsig , r , z , nx , ny , nz , nghost , dx , dy , dt ) !! Public only for the unit-test suite (no production module imports it). !! Vertical-line preconditioner: solve M*z = r per (i,j) column !! !! M is the vertical tridiagonal part of the Poisson operator plus !! the horizontal diagonal contribution. Thomas algorithm per column !! (serial in k, parallel over i,j via do concurrent). integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: r ( nx , ny , nz ) real ( wp ), intent ( out ) :: z ( nx , ny , nz ) real ( wp ), intent ( in ) :: dx , dy , dt integer , parameter :: NZ_MAX = 64 integer :: i , j , k real ( wp ) :: inv_dx2 , inv_dy2 , inv_dt2 real ( wp ) :: h_val , h_diag , a_k , c_k , d_k real ( wp ) :: cp ( NZ_MAX ), dp ( NZ_MAX ) inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) inv_dt2 = 1.0_wp / ( dt * dt ) ! Horizontal diagonal contribution (same for all layers) h_diag = 2.0_wp * inv_dx2 + 2.0_wp * inv_dy2 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , a_k , c_k , d_k , cp , dp , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then ! Forward sweep (Thomas algorithm) ! k = 1: a_k = 0 (no layer below) if ( nz > 1 ) then c_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( 1 ) + dsig ( 2 )) * dsig ( 1 )) else c_k = 0.0_wp end if d_k = - ( c_k + h_val * h_diag ) cp ( 1 ) = c_k / d_k dp ( 1 ) = r ( i , j , 1 ) / d_k do k = 2 , nz ! Sub-diagonal: coupling to k-1 a_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) ! Super-diagonal: coupling to k+1 if ( k < nz ) then c_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) else c_k = 0.0_wp end if ! Modified diagonal and RHS d_k = - ( a_k + c_k + h_val * h_diag ) - a_k * cp ( k - 1 ) cp ( k ) = c_k / d_k dp ( k ) = ( r ( i , j , k ) - a_k * dp ( k - 1 )) / d_k end do ! Back substitution z ( i , j , nz ) = dp ( nz ) do k = nz - 1 , 1 , - 1 z ( i , j , k ) = dp ( k ) - cp ( k ) * z ( i , j , k + 1 ) end do else do k = 1 , nz z ( i , j , k ) = 0.0_wp end do end if end do end subroutine apply_vertical_preconditioner subroutine solve_nh_pressure ( h , u_layer , v_layer , w , q_nh , dsig , & cg_r , cg_p , cg_Ap , cg_z , & grid , nz , dt , & max_iter , tol , iter_out , & use_preconditioner ) !! Conjugate Gradient solver for the NH Poisson equation !! !! Warm-started from previous q_nh. !! Optionally uses vertical-line preconditioner (Thomas algorithm per column). !! Solves A * q = rhs where A is the Poisson operator and !! rhs comes from the velocity divergence. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( inout ) :: cg_r ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_p ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_Ap ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_z ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dt integer , intent ( in ) :: max_iter real ( wp ), intent ( in ) :: tol integer , intent ( out ) :: iter_out logical , intent ( in ), optional :: use_preconditioner logical :: use_pc integer :: i , j , k , iter , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: rz , rz_new , rr , pAp , alpha , beta real ( wp ) :: tol2 , inv_dx2 , inv_dy2 real ( wp ) :: vlo ( nz ), vhi ( nz ) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy use_pc = . false . if ( present ( use_preconditioner )) use_pc = use_preconditioner tol2 = tol * tol iter_out = 0 ! Pre-compute vertical coefficients and horizontal inverses once call compute_vert_coefficients ( dsig , nz , dt , vlo , vhi ) inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) ! Compute RHS into cg_r call compute_nh_rhs ( h , w , dsig , cg_r , nx , ny , nz , nghost , dx , dy , dt ) ! r = rhs - A*q_nh (warm start: q_nh retains previous solution) call apply_poisson_operator_fast ( h , q_nh , cg_Ap , nx , ny , nz , nghost , & inv_dx2 , inv_dy2 , vlo , vhi ) do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_r ( i , j , k ) = cg_r ( i , j , k ) - cg_Ap ( i , j , k ) end do ! Check if already converged (unpreconditioned residual) rr = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rr ) rr = rr + cg_r ( i , j , k ) * cg_r ( i , j , k ) end do if ( rr < tol2 ) return if ( use_pc ) then ! PCG: z = M&#94;{-1} r, p = z call apply_vertical_preconditioner ( h , dsig , cg_r , cg_z , nx , ny , nz , nghost , dx , dy , dt ) do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_z ( i , j , k ) end do ! rz = dot(r, z) rz = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rz ) rz = rz + cg_r ( i , j , k ) * cg_z ( i , j , k ) end do else ! Plain CG: p = r, rz = rr do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_r ( i , j , k ) end do rz = rr end if do iter = 1 , max_iter ! Ap = A * p call apply_poisson_operator_fast ( h , cg_p , cg_Ap , nx , ny , nz , nghost , & inv_dx2 , inv_dy2 , vlo , vhi ) ! pAp = dot(p, Ap) pAp = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : pAp ) pAp = pAp + cg_p ( i , j , k ) * cg_Ap ( i , j , k ) end do if ( abs ( pAp ) < 1.0e-30_wp ) exit alpha = rz / pAp ! q_nh += alpha * p ! r -= alpha * Ap do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) q_nh ( i , j , k ) = q_nh ( i , j , k ) + alpha * cg_p ( i , j , k ) cg_r ( i , j , k ) = cg_r ( i , j , k ) - alpha * cg_Ap ( i , j , k ) end do ! Convergence check on unpreconditioned residual rr = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rr ) rr = rr + cg_r ( i , j , k ) * cg_r ( i , j , k ) end do iter_out = iter if ( rr < tol2 ) exit if ( use_pc ) then ! PCG: z = M&#94;{-1} r, rz_new = dot(r, z) call apply_vertical_preconditioner ( h , dsig , cg_r , cg_z , nx , ny , nz , nghost , dx , dy , dt ) rz_new = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rz_new ) rz_new = rz_new + cg_r ( i , j , k ) * cg_z ( i , j , k ) end do beta = rz_new / rz rz = rz_new ! p = z + beta * p do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_z ( i , j , k ) + beta * cg_p ( i , j , k ) end do else ! Plain CG: rz_new = rr beta = rr / rz rz = rr ! p = r + beta * p do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_r ( i , j , k ) + beta * cg_p ( i , j , k ) end do end if end do end subroutine solve_nh_pressure pure subroutine compute_nh_baro_tendency ( h , q_nh , dsig , tend_x , tend_y , & grid , nz ) !! Compute depth-averaged NH pressure gradient for barotropic forcing !! !! tend_x(i,j) = -sum_k(dsig_k * dq_nh_k/dx) !! tend_y(i,j) = -sum_k(dsig_k * dq_nh_k/dy) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: tend_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: tend_y ( grid % nx_total , grid % ny_total ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: tx , ty , dqdx , dqdy , inv_2dx , inv_2dy nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_2dx = 1.0_wp / ( 2.0_wp * dx ) inv_2dy = 1.0_wp / ( 2.0_wp * dy ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( tx , ty , dqdx , dqdy , k ) tx = 0.0_wp ty = 0.0_wp if ( h ( i , j ) > NH_MIN_DEPTH ) then do k = 1 , nz dqdx = ( q_nh ( i + 1 , j , k ) - q_nh ( i - 1 , j , k )) * inv_2dx dqdy = ( q_nh ( i , j + 1 , k ) - q_nh ( i , j - 1 , k )) * inv_2dy tx = tx - dsig ( k ) * dqdx ty = ty - dsig ( k ) * dqdy end do end if tend_x ( i , j ) = tx tend_y ( i , j ) = ty end do end subroutine compute_nh_baro_tendency pure subroutine apply_baro_nh_tendency ( hu , hv , h , tend_x , tend_y , & grid , dt ) !! Add NH barotropic tendency as forcing during barotropic subcycling !! !! hu += dt * h * tend_x !! hv += dt * h * tend_y type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: tend_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: tend_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt integer :: i , j , nx , ny , nghost nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) hu ( i , j ) = hu ( i , j ) + dt * h ( i , j ) * tend_x ( i , j ) hv ( i , j ) = hv ( i , j ) + dt * h ( i , j ) * tend_y ( i , j ) end do end subroutine apply_baro_nh_tendency subroutine reconcile_barotropic ( h , hu , hv , u_layer , v_layer , dsig , & grid , nz ) !! Recompute barotropic momentum from corrected layer velocities !! !! hu = h * sum(dsig_k * u_layer_k) !! hv = h * sum(dsig_k * v_layer_k) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) ! This is identical to compute_depth_averaged_momentum call compute_depth_averaged_momentum ( h , u_layer , v_layer , dsig , & hu , hv , grid , nz ) end subroutine reconcile_barotropic end module rki_kernel_pressure","tags":"","url":"sourcefile/rki_kernel_pressure.f90.html"},{"title":"rki_kernel_fused_ml.F90 – Rakali","text":"Fused per-cell post-update kernels for the multilayer structured solver.\nCollapse the per-stage post-flux kernel chain (update → distribute →\nbottom friction → truncate → barotropic momentum → wind/pressure/precip\n→ coriolis) into one launch per stage; no horizontal neighbour reads\nexcept the atmospheric pressure gradient.\nCaller must run tracer advection BEFORE these kernels (CWC needs OLD h_layer). This file depends on sourcefile~~rki_kernel_fused_ml.f90~~EfferentGraph sourcefile~rki_kernel_fused_ml.f90 rki_kernel_fused_ml.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_fused_ml.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_kernel_fused_ml.f90->sourcefile~rki_grid.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_kernel_fused_ml.f90~~AfferentGraph sourcefile~rki_kernel_fused_ml.f90 rki_kernel_fused_ml.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_kernel_fused_ml.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Fused per-cell post-update kernels for the multilayer structured solver. !! Collapse the per-stage post-flux kernel chain (update → distribute → !! bottom friction → truncate → barotropic momentum → wind/pressure/precip !! → coriolis) into one launch per stage; no horizontal neighbour reads !! except the atmospheric pressure gradient. !! Caller must run tracer advection BEFORE these kernels (CWC needs OLD h_layer). module rki_kernel_fused_ml use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE , THIN_LAYER_THRESHOLD , & DESING_EPS , FROUDE_BACKSTOP , RHO_WATER , & LATENT_HEAT_VAPORIZATION use rki_grid , only : hgrid_t implicit none private public :: ml_fused_post_update public :: ml_fused_rk2_finalise public :: ml_fused_tracer_post contains pure subroutine ml_fused_tracer_post ( hS_layer , hT_layer , h_layer , & hu_layer , hv_layer , & h_bt , hu_bt , hv_bt , & heat_flux , evap_minus_precip , & evap_mass_sink , evap_latent_cooling , & S_min , S_max , T_min , T_max , & rho_0 , cp , min_depth , & grid , nz , dt ) !! Fuses surface tracer fluxes + per-layer clamp (S, T) into one !! per-(i,j)-column kernel (no horizontal neighbour reads). !! !! Surface flux (top layer k=nz, wet column only): !! - evap_mass_sink=.false. (default): virtual salt flux !!     hT(top) += dt * heat_flux / (rho_0 * cp);  hS(top) += dt * (E-P) * S_top !! - evap_mass_sink=.true.: real water-mass sink — dh = E*dt removed !!   COLUMN-PROPORTIONALLY (h, hu, hv, hT scale by 1 - dh/h_col; hS !!   held), so S concentrates while T, u, v are exactly invariant. !!   With evap_latent_cooling, the evaporated mass ALSO withdraws its !!   latent heat from the top layer (additive surface cooling; distinct !!   from the sensible heat carried away by the fac-scaled hT — no !!   double-count).  Removal clamps to the water available above !!   min_depth; the unsatisfied fraction is dropped honestly.  Precipitation !!   (evap_minus_precip < 0) is NOT added — that is the barotropic !!   precipitation field's job.  See ml_apply_surface_tracer_fluxes !!   for the full derivation. !! !! Clamp: bounds [tr_min, tr_max] per layer where h_layer > DRY_TOLERANCE, !! else zeroes the column tracer mass. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: h_bt ( grid % nx_total , grid % ny_total ) !! Barotropic depth — the nz=1 fast path maintains h_bt == h_layer !! BY CONSTRUCTION (no recompute-from-layers), so the mass sink !! must update both or the next stage rebuilds the pre-sink depth. real ( wp ), intent ( inout ) :: hu_bt ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv_bt ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) logical , intent ( in ) :: evap_mass_sink logical , intent ( in ) :: evap_latent_cooling real ( wp ), intent ( in ) :: S_min , S_max , T_min , T_max real ( wp ), intent ( in ) :: rho_0 , cp , dt , min_depth integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_col , h_top , S_top , kin_heat_flux , inv_rho0cp real ( wp ) :: h_k , hs_k , ht_k , s_val , t_val real ( wp ) :: dh_req , dh_eff , fac , latent_gain logical :: column_wet nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost inv_rho0cp = 1.0_wp / ( rho_0 * cp ) ! Kinematic latent-heat withdrawal per metre of evaporated water ! (0 unless the knob is on -> default bit-identical). latent_gain = 0.0_wp if ( evap_latent_cooling ) latent_gain = RHO_WATER * LATENT_HEAT_VAPORIZATION * inv_rho0cp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_col , h_top , S_top , kin_heat_flux , h_k , hs_k , ht_k , & s_val , t_val , column_wet , dh_req , dh_eff , fac ) ! ---- Total column depth (surface-flux wet gate) ---- h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( i , j , k ) end do column_wet = ( h_col > min_depth ) ! ---- Surface flux (top layer, k=nz under bottom-up ROMS indexing) ---- if ( column_wet ) then h_top = h_layer ( i , j , nz ) if ( h_top > THIN_LAYER_THRESHOLD ) then ! Thermal (unchanged in both modes): dt * Q_net / (rho_0 * cp) kin_heat_flux = heat_flux ( i , j ) * inv_rho0cp hT_layer ( i , j , nz ) = hT_layer ( i , j , nz ) + dt * kin_heat_flux if ( evap_mass_sink ) then ! Column-proportional water-mass sink (see ! ml_apply_surface_tracer_fluxes).  hS held; h, hu, hv, ! hT scale so S concentrates while T, u, v stay invariant. dh_req = dt * max ( evap_minus_precip ( i , j ), 0.0_wp ) dh_eff = min ( dh_req , max ( h_col - min_depth , 0.0_wp )) if ( dh_eff > 0.0_wp ) then fac = 1.0_wp - dh_eff / h_col do k = 1 , nz h_layer ( i , j , k ) = h_layer ( i , j , k ) * fac hu_layer ( i , j , k ) = hu_layer ( i , j , k ) * fac hv_layer ( i , j , k ) = hv_layer ( i , j , k ) * fac hT_layer ( i , j , k ) = hT_layer ( i , j , k ) * fac ! hS_layer held -> concentration rises naturally. end do ! Keep the barotropic state consistent with the layers ! (the nz=1 path never recomputes it from the layers). h_bt ( i , j ) = h_bt ( i , j ) * fac hu_bt ( i , j ) = hu_bt ( i , j ) * fac hv_bt ( i , j ) = hv_bt ( i , j ) * fac ! Latent-heat cooling (additive, top layer; not scaled ! by fac).  latent_gain == 0 when off -> bit-identical. hT_layer ( i , j , nz ) = hT_layer ( i , j , nz ) - latent_gain * dh_eff end if else ! Legacy virtual salt flux (bit-identical default). S_top = hS_layer ( i , j , nz ) / h_top hS_layer ( i , j , nz ) = hS_layer ( i , j , nz ) & + dt * evap_minus_precip ( i , j ) * S_top end if end if end if ! ---- Clamp every layer to physical bounds ---- do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k > DRY_TOLERANCE ) then hs_k = hS_layer ( i , j , k ) ht_k = hT_layer ( i , j , k ) s_val = hs_k / h_k s_val = max ( S_min , min ( S_max , s_val )) hS_layer ( i , j , k ) = h_k * s_val t_val = ht_k / h_k t_val = max ( T_min , min ( T_max , t_val )) hT_layer ( i , j , k ) = h_k * t_val else hS_layer ( i , j , k ) = 0.0_wp hT_layer ( i , j , k ) = 0.0_wp end if end do end do end subroutine ml_fused_tracer_post pure subroutine ml_fused_rk2_finalise ( h , hu , hv , & h_layer , hu_layer , hv_layer , & h_layer0 , hu_layer0 , hv_layer0 , & hS_layer , hT_layer , & hS_layer0 , hT_layer0 , & grid , nz ) !! End-of-step fused kernel: RK2-averages all layer arrays with their !! `*_0` counterparts and accumulates the depth-integrated `h, hu, hv` !! in one inner k-loop. No neighbour reads. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( out ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: h_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hS_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hT_layer0 ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_k , hu_k , hv_k real ( wp ) :: hs_k , ht_k real ( wp ) :: h_sum , hu_sum , hv_sum nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_k , hu_k , hv_k , hs_k , ht_k , h_sum , hu_sum , hv_sum ) h_sum = 0.0_wp hu_sum = 0.0_wp hv_sum = 0.0_wp do k = 1 , nz ! ---- RK2 average of layer state ---- h_k = 0.5_wp * ( h_layer0 ( i , j , k ) + h_layer ( i , j , k )) hu_k = 0.5_wp * ( hu_layer0 ( i , j , k ) + hu_layer ( i , j , k )) hv_k = 0.5_wp * ( hv_layer0 ( i , j , k ) + hv_layer ( i , j , k )) ! Wet-cell guard, mirrors ml_rk2_average_layers if ( h_k < 0.0_wp ) then h_k = 0.0_wp hu_k = 0.0_wp hv_k = 0.0_wp else if ( h_k < THIN_LAYER_THRESHOLD ) then hu_k = 0.0_wp hv_k = 0.0_wp end if h_layer ( i , j , k ) = h_k hu_layer ( i , j , k ) = hu_k hv_layer ( i , j , k ) = hv_k ! Accumulate barotropic quantities h_sum = h_sum + h_k hu_sum = hu_sum + hu_k hv_sum = hv_sum + hv_k ! ---- Tracer RK2 average ---- hs_k = 0.5_wp * ( hS_layer0 ( i , j , k ) + hS_layer ( i , j , k )) ht_k = 0.5_wp * ( hT_layer0 ( i , j , k ) + hT_layer ( i , j , k )) if ( hs_k < 0.0_wp ) hs_k = 0.0_wp if ( ht_k < 0.0_wp ) ht_k = 0.0_wp hS_layer ( i , j , k ) = hs_k hT_layer ( i , j , k ) = ht_k end do h ( i , j ) = h_sum hu ( i , j ) = hu_sum hv ( i , j ) = hv_sum end do end subroutine ml_fused_rk2_finalise pure subroutine ml_fused_post_update ( h , hu , hv , & h_layer , hu_layer , hv_layer , & h0 , hu0 , hv0 , & h_layer0 , hu_layer0 , hv_layer0 , & flux_h , flux_hu , flux_hv , & dsig , & wind_x , wind_y , & atm_pressure , precipitation , & grid , nz , dt , & manning_n , use_linear_drag , drag_r , coriolis_f , & forcing_active , do_save ) !! Single fused kernel covering compute_update through coriolis. !! !! Manning friction is applied *only* to the bottom layer (k=nz), !! mirroring `ml_apply_bottom_friction`. The depth-averaged Manning !! pass that the un-fused path does inside `apply_friction` is !! omitted intentionally: per-layer friction already accounts for !! it. Wind, pressure-gradient, and precipitation forcing are still !! applied to the depth-averaged state. !! !! Pre-update barotropic momentum is captured in registers at the !! top of each (i,j) iteration, so the un-fused path's separate !! `hu_ml_pre` / `hv_ml_pre` copies are not needed. !! !! When `do_save` is true (RK stage 1), absorbs the work that !! `solver_save_state` and `ml_save_layer_state` would have done: !! writes pre-update `h, hu, hv` to `h0, hu0, hv0` and pre-update !! `h_layer, hu_layer, hv_layer` to the corresponding `*0` arrays. !! Tracer save is still a separate kernel (it has to run before !! the tracer pipeline, which precedes this kernel). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) ! intent(inout) so that when do_save=.false. we can leave these ! arrays untouched (intent(out) would require full assignment). real ( wp ), intent ( inout ) :: h0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: flux_h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: atm_pressure ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: precipitation ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt , manning_n logical , intent ( in ) :: use_linear_drag real ( wp ), intent ( in ) :: drag_r real ( wp ), intent ( in ) :: coriolis_f logical , intent ( in ) :: forcing_active , do_save integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: h_new , hu_new , hv_new , hu_pre , hv_pre real ( wp ) :: eps4 , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale real ( wp ) :: du , dv , h_k , h_k_new , u_k , v_k real ( wp ) :: u_b , v_b , speed_b , cf , denom real ( wp ) :: u_abs , v_abs , vel_max_x , vel_max_y real ( wp ) :: hu_sum , hv_sum real ( wp ) :: dpdx , dpdy , hu_old , hv_old real ( wp ) :: n_sq , cosf , sinf logical :: has_friction , has_coriolis nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy n_sq = manning_n * manning_n has_friction = ( manning_n > 0.0_wp ) . or . ( use_linear_drag . and . drag_r > 0.0_wp ) has_coriolis = ( abs ( coriolis_f ) > 1.0e-20_wp ) if ( has_coriolis ) then cosf = cos ( coriolis_f * dt ) sinf = sin ( coriolis_f * dt ) end if vel_max_x = 0.9_wp * 0.8_wp * dx / max ( dt , 1.0e-10_wp ) vel_max_y = 0.9_wp * 0.8_wp * dy / max ( dt , 1.0e-10_wp ) ! KP07 desingularization length for the barotropic clamp, shared ! convention with compute_update / the CFL timestep estimator. eps4 = DESING_EPS ** 4 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_new , hu_new , hv_new , hu_pre , hv_pre , & h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale , & du , dv , h_k , h_k_new , u_k , v_k , & u_b , v_b , speed_b , cf , denom , & u_abs , v_abs , hu_sum , hv_sum , & dpdx , dpdy , hu_old , hv_old ) ! ---- Capture pre-update barotropic momentum in registers ---- hu_pre = hu ( i , j ) hv_pre = hv ( i , j ) ! ---- Save pre-update barotropic state (RK stage 1 only) ---- if ( do_save ) then h0 ( i , j ) = h ( i , j ) hu0 ( i , j ) = hu_pre hv0 ( i , j ) = hv_pre end if ! ---- Euler update for the barotropic state ---- h_new = h ( i , j ) + dt * flux_h ( i , j ) hu_new = hu_pre + dt * flux_hu ( i , j ) hv_new = hv_pre + dt * flux_hv ( i , j ) ! ---- Negative-depth clamp + KP07 desingularization ---- ! (mirrors compute_update) if ( h_new < 0.0_wp ) then h_new = 0.0_wp hu_new = 0.0_wp hv_new = 0.0_wp else if ( h_new < DRY_TOLERANCE ) then hu_new = 0.0_wp hv_new = 0.0_wp else h4 = h_new ** 4 if ( h4 < eps4 ) then ! u = sqrt(2) h hu / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)); hu := h*u. ! Identity for h >= eps, so applied only below eps. u_ds = sqrt ( 2.0_wp ) * h_new * hu_new / sqrt ( h4 + eps4 ) v_ds = sqrt ( 2.0_wp ) * h_new * hv_new / sqrt ( h4 + eps4 ) hu_new = h_new * u_ds hv_new = h_new * v_ds end if ! Froude backstop: blowup arrester only (triggers on a TRUE ! comparison, so NaN passes through and fails loudly). speed_sq = ( hu_new ** 2 + hv_new ** 2 ) / h_new ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h_new if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) hu_new = hu_new * fr_scale hv_new = hv_new * fr_scale end if end if ! ---- Distribute barotropic acceleration to layers ---- ! du = (hu_new - hu_pre) / h_new is the depth-averaged acceleration ! Per-layer u_k retains the existing baroclinic anomaly. if ( h_new > DRY_TOLERANCE ) then du = ( hu_new - hu_pre ) / h_new dv = ( hv_new - hv_pre ) / h_new else du = 0.0_wp dv = 0.0_wp end if do k = 1 , nz h_k = h_layer ( i , j , k ) ! Save OLD layer state into *_0 arrays before we overwrite ! (RK stage 1 only — absorbs `ml_save_layer_state`). if ( do_save ) then h_layer0 ( i , j , k ) = h_k hu_layer0 ( i , j , k ) = hu_layer ( i , j , k ) hv_layer0 ( i , j , k ) = hv_layer ( i , j , k ) end if if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if h_k_new = dsig ( k ) * h_new h_layer ( i , j , k ) = h_k_new if ( h_k_new < THIN_LAYER_THRESHOLD ) then hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp else hu_layer ( i , j , k ) = h_k_new * ( u_k + du ) hv_layer ( i , j , k ) = h_k_new * ( v_k + dv ) end if end do ! ---- Bottom friction on layer 1 (semi-implicit) ---- ! k=1 is the bottom layer under bottom-up ROMS indexing (matches ! BPG / rho_ref / NH init / standalone ml_apply_bottom_friction). ! Linear (Rayleigh) or quadratic Manning, mirroring the un-fused path. if ( has_friction ) then h_k = h_layer ( i , j , 1 ) if ( h_k >= THIN_LAYER_THRESHOLD . and . h_new >= THIN_LAYER_THRESHOLD ) then if ( use_linear_drag ) then denom = 1.0_wp + dt * drag_r else u_b = hu_layer ( i , j , 1 ) / h_k v_b = hv_layer ( i , j , 1 ) / h_k speed_b = sqrt ( u_b * u_b + v_b * v_b ) cf = GRAVITY * n_sq / ( h_new ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed_b / h_k end if hu_layer ( i , j , 1 ) = hu_layer ( i , j , 1 ) / denom hv_layer ( i , j , 1 ) = hv_layer ( i , j , 1 ) / denom end if end if ! ---- CFL-based velocity truncation (MOM6-style, cfl_trunc=0.8) ---- do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k >= THIN_LAYER_THRESHOLD ) then u_abs = abs ( hu_layer ( i , j , k )) / h_k v_abs = abs ( hv_layer ( i , j , k )) / h_k if ( u_abs > vel_max_x ) then hu_layer ( i , j , k ) = sign ( vel_max_x * h_k , hu_layer ( i , j , k )) end if if ( v_abs > vel_max_y ) then hv_layer ( i , j , k ) = sign ( vel_max_y * h_k , hv_layer ( i , j , k )) end if end if end do ! ---- Recompute depth-integrated momentum from layers ---- hu_sum = 0.0_wp hv_sum = 0.0_wp do k = 1 , nz hu_sum = hu_sum + hu_layer ( i , j , k ) hv_sum = hv_sum + hv_layer ( i , j , k ) end do hu_new = hu_sum hv_new = hv_sum ! ---- Wind / atmospheric pressure / precipitation on barotropic ---- ! (Manning was applied per-layer above so we skip it here.) if ( forcing_active . and . h_new > DRY_TOLERANCE ) then hu_new = hu_new + dt * wind_x ( i , j ) / RHO_WATER hv_new = hv_new + dt * wind_y ( i , j ) / RHO_WATER dpdx = ( atm_pressure ( i + 1 , j ) - atm_pressure ( i - 1 , j )) / ( 2.0_wp * dx ) dpdy = ( atm_pressure ( i , j + 1 ) - atm_pressure ( i , j - 1 )) / ( 2.0_wp * dy ) hu_new = hu_new - dt * h_new * dpdx / RHO_WATER hv_new = hv_new - dt * h_new * dpdy / RHO_WATER end if ! ---- Coriolis rotation ---- if ( has_coriolis . and . h_new > DRY_TOLERANCE ) then hu_old = hu_new hv_old = hv_new hu_new = hu_old * cosf + hv_old * sinf hv_new = - hu_old * sinf + hv_old * cosf end if ! ---- Precipitation on barotropic h (all cells) ---- if ( forcing_active ) then h_new = h_new + dt * precipitation ( i , j ) end if ! ---- Write back ---- h ( i , j ) = h_new hu ( i , j ) = hu_new hv ( i , j ) = hv_new end do end subroutine ml_fused_post_update end module rki_kernel_fused_ml","tags":"","url":"sourcefile/rki_kernel_fused_ml.f90.html"},{"title":"rki_ml_kpp_unstr.F90 – Rakali","text":"KPP (Large, McWilliams & Doney 1994) surface-boundary-layer mixing\nfor the unstructured (triangular) coastal multilayer path. This file depends on sourcefile~~rki_ml_kpp_unstr.f90~~EfferentGraph sourcefile~rki_ml_kpp_unstr.f90 rki_ml_kpp_unstr.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_kpp_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common_unstr.f90 rki_ml_common_unstr.F90 sourcefile~rki_ml_kpp_unstr.f90->sourcefile~rki_ml_common_unstr.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_ml_kpp_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_common_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_barotropic_state_unstr.f90 rki_barotropic_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_barotropic_state_unstr.f90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefi