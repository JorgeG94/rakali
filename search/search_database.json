urs to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial type( nml_group_t ), private :: g integer, private, pointer :: pi logical, private, pointer :: pl real(kind=wp), private, pointer :: pr character(len=:), private, pointer :: ps Source Code subroutine register_nonhydrostatic ( cfg , schema ) !! `&nonhydrostatic_nml`: NH/multilayer switches, CG-Poisson !! controls, PP81 vmix, KPP knobs, k-eps, Smagorinsky, BPG, mode !! split.  `keps_stability` and `bpg_method` are enums. type ( config_t ), target , intent ( in ) :: cfg type ( nml_schema_t ), intent ( inout ) :: schema type ( nml_group_t ) :: g real ( wp ), pointer :: pr integer , pointer :: pi logical , pointer :: pl character ( len = :), pointer :: ps g % name = \"nonhydrostatic\" g % doc = \"Non-hydrostatic / multilayer: CG-Poisson, PP81/KPP/k-eps vmix, Smagorinsky, BPG, mode split.\" pl => cfg % use_nonhydrostatic call g % add ( nml_logical ( \"use_nonhydrostatic\" , pl , \"Enable multi-layer NH pressure correction\" )) pi => cfg % nz_layers call g % add ( nml_int ( \"nz_layers\" , pi , \"Number of sigma layers\" , min = 1 )) pr => cfg % nh_tolerance call g % add ( nml_real ( \"nh_tolerance\" , pr , \"CG convergence tolerance for NH pressure\" )) pi => cfg % nh_max_iterations call g % add ( nml_int ( \"nh_max_iterations\" , pi , \"Maximum CG iterations for NH pressure\" , min = 1 )) pl => cfg % nh_preconditioner call g % add ( nml_logical ( \"nh_preconditioner\" , pl , \"Vertical-line preconditioner for CG solver\" )) pi => cfg % nh_solve_interval call g % add ( nml_int ( \"nh_solve_interval\" , pi , \"Solve NH pressure every N steps\" , min = 1 )) pi => cfg % split_ratio call g % add ( nml_int ( \"split_ratio\" , pi , \"Mode-split ratio: 0=auto, 1=unsplit, N>1=fixed\" , min = 0 )) pl => cfg % split_averaging call g % add ( nml_logical ( \"split_averaging\" , pl , \"ROMS-style averaging over barotropic substeps\" )) pl => cfg % use_multilayer call g % add ( nml_logical ( \"use_multilayer\" , pl , \"Enable coupled hydrostatic vertical layers\" )) pr => cfg % rho_0 call g % add ( nml_real ( \"rho_0\" , pr , \"Reference density for EOS\" , units = \"kg/m&#94;3\" )) pr => cfg % vmix_nu_max call g % add ( nml_real ( \"vmix_nu_max\" , pr , \"PP81 max turbulent viscosity\" , units = \"m&#94;2/s\" )) pr => cfg % vmix_nu_bg call g % add ( nml_real ( \"vmix_nu_bg\" , pr , \"Background vertical viscosity\" , units = \"m&#94;2/s\" )) pr => cfg % vmix_ri_alpha call g % add ( nml_real ( \"vmix_ri_alpha\" , pr , \"PP81 Richardson-number scaling coefficient\" )) pl => cfg % vmix_use_kpp call g % add ( nml_logical ( \"vmix_use_kpp\" , pl , \"Enable KPP surface-boundary-layer overlay on PP81\" )) pl => cfg % vmix_use_keps call g % add ( nml_logical ( \"vmix_use_keps\" , pl , \"Enable two-equation k-epsilon vertical mixing\" )) pi => cfg % keps_si_picard call g % add ( nml_int ( \"keps_si_picard\" , pi , & \"Picard passes of the k<->eps coupling per semi-implicit step (SI+keps only)\" , & min = 1 , max = 3 )) pr => cfg % kpp_ri_crit call g % add ( nml_real ( \"kpp_ri_crit\" , pr , \"Critical bulk Richardson number for KPP BL-depth\" )) pr => cfg % kpp_cs_nonlocal call g % add ( nml_real ( \"kpp_cs_nonlocal\" , pr , \"KPP non-local (counter-gradient) transport coefficient\" )) pr => cfg % kpp_c_vt2 call g % add ( nml_real ( \"kpp_c_vt2\" , pr , \"KPP V_t&#94;2 unresolved-turbulence coefficient (0 = off)\" )) pr => cfg % hdiff_kappa call g % add ( nml_real ( \"hdiff_kappa\" , pr , & \"Horizontal tracer diffusion coefficient\" , & units = \"m&#94;2/s\" )) pr => cfg % smagorinsky_cs call g % add ( nml_real ( \"smagorinsky_cs\" , pr , \"Smagorinsky horizontal-viscosity coefficient\" )) pr => cfg % biharmonic_nu4 call g % add ( nml_real ( \"biharmonic_nu4\" , pr , \"Biharmonic lateral viscosity (0 = off)\" , units = \"m&#94;4/s\" )) pl => cfg % evap_mass_sink call g % add ( nml_logical ( \"evap_mass_sink\" , pl , & \"Treat net evaporation as a real surface mass sink (default off = virtual salt flux)\" )) pl => cfg % evap_latent_cooling call g % add ( nml_logical ( \"evap_latent_cooling\" , pl , & \"Evaporative latent-heat surface cooling (requires evap_mass_sink; default off)\" )) pr => cfg % ml_min_depth call g % add ( nml_real ( \"ml_min_depth\" , pr , \"Minimum total depth for vertical-layer operations\" , units = \"m\" )) ps => cfg % bpg_method call g % add ( nml_enum ( \"bpg_method\" , ps , \"BPG computation method\" , & allowed = [ character ( len = 8 ) :: \"sigma\" , \"jacobian\" ])) ps => cfg % keps_stability call g % add ( nml_enum ( \"keps_stability\" , ps , \"k-epsilon stability functions\" , & allowed = [ character ( len = 9 ) :: \"constant\" , \"galperin\" , \"canuto\" ])) call schema % add_group ( g ) end subroutine register_nonhydrostatic","tags":"","url":"proc/register_nonhydrostatic.html"},{"title":"register_output – Rakali","text":"private  subroutine register_output(cfg, schema) &output_nml : file output + I/O + forcing/restart/gauge files. Arguments Type Intent Optional Attributes Name type( config_t ), intent(in), target :: cfg type( nml_schema_t ), intent(inout) :: schema Calls proc~~register_output~~CallsGraph proc~register_output register_output proc~group_add nml_group_t%group_add proc~register_output->proc~group_add proc~nml_enum nml_enum proc~register_output->proc~nml_enum proc~nml_int nml_int proc~register_output->proc~nml_int proc~nml_logical nml_logical proc~register_output->proc~nml_logical proc~nml_real nml_real proc~register_output->proc~nml_real proc~nml_string nml_string proc~register_output->proc~nml_string proc~schema_add_group nml_schema_t%schema_add_group proc~register_output->proc~schema_add_group error error proc~group_add->error proc~lower lower proc~group_add->proc~lower proc~schema_add_group->error proc~schema_add_group->proc~lower proc~move_group move_group proc~schema_add_group->proc~move_group Help Graph Key Nodes of different colours represent the following: 