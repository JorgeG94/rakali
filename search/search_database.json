 hu , state % barotropic % hv , & state % grid , nz ) end if ! ---- Apply barotropic BCs and distribute to layer ghost cells ---- call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) if ( state % multilayer % vcoord % coord_type == VCOORD_ZSTAR_FULL ) then call ml_apply_layer_bcs_full ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % multilayer % dsig_ml , state % multilayer % vcoord_z_ref_col , & state % multilayer % vcoord % zstar_h_min , & state % grid , nz ) else call ml_apply_layer_bcs ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % multilayer % dsig_ml , & state % grid , nz , & bc_west = state % bc % west , bc_east = state % bc % east , & bc_south = state % bc % south , bc_north = state % bc % north ) end if ! ---- Compute timestep from barotropic state ---- if ( state % dt_fixed > 0.0_wp ) then state % dt = state % dt_fixed if ( present ( dt_max )) state % dt = min ( state % dt , dt_max ) else if ( mod ( state % step_count , state % cfl_interval ) == 0 . or . state % dt <= 0.0_wp ) then call compute_timestep ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % cfl , state % dt ) if ( present ( dt_max )) state % dt = min ( state % dt , dt_max ) end if state % step_count = state % step_count + 1 state % bc % dt = state % dt ! ---- Save state for RK2 ---- ! At nz=1 the fused stage-1 kernel absorbs `solver_save_state` + ! `ml_save_layer_state`; nz>1 uses the standalone kernels. if ( nz > 1 ) then call solver_save_state ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , state % grid ) call ml_save_layer_state ( state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % multilayer % h_layer0 , state % multilayer % hu_layer0 , state % multilayer % hv_layer0 , & state % grid , nz ) end if do it = 1 , size ( state % multilayer % tracers ) call ml_save_tracer ( state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hTr0 , state % grid , nz ) end do ! ==== RK2 Stage 1 ==== call solver_multilayer_rk_stage ( state , nz , is_stage1 = . true .) ! ---- Update barotropic for BCs at stage 2 ---- ! Redundant at nz=1 (fused stage-1 already left h, hu, hv consistent). state % bc % time = state % bc % time + state % dt if ( nz > 1 ) then call ml_compute_total_depth ( state % multilayer % h_layer , state % barotropic % h , & state % grid , nz ) call ml_compute_barotropic_momentum ( state % multilayer % h_layer , state % multilayer % hu_layer , & state % multilayer % hv_layer , state % barotropic % hu , state % barotropic % hv , & state % grid , nz ) end if ! ==== RK2 Stage 2 ==== call solver_multilayer_rk_stage ( state , nz , is_stage1 = . false .) ! ---- RK2 Average + recompute barotropic in one fused kernel ---- ! One per-cell loop averages all layer arrays and accumulates h, hu, hv; ! replaces ml_rk2_average_layers + ml_rk2_average_tracer ×2 + ! ml_compute_total_depth + ml_compute_barotropic_momentum. Same path for ! nz=1 and nz>1 (no absorbed kernel has neighbour reads). call profiler_start ( \"ml_work\" ) call ml_fused_rk2_finalise ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % multilayer % h_layer , state % multilayer % hu_layer , state % multilayer % hv_layer , & state % multilayer % h_layer0 , state % multilayer % hu_layer0 , state % multilayer % hv_layer0 , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr0 , state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr0 , & state % grid , nz ) ! Fused finalise RK2-averages S/T; extra passive tracers averaged here. do it = 1 , size ( state % multilayer % tracers ) if ( it == state % multilayer % idx_salinity . or . it == state % multilayer % idx_temperature ) cycle call ml_rk2_average_tracer ( state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hTr0 , state % grid , nz ) end do call profiler_stop ( \"ml_work\" ) ! Sediment settling — applied ONCE per step on the RK2-averaged state ! (not per RK stage) so suspended loss = bed gain and total sediment is ! conserved. Constant w_s downward sink; bottom-layer flux deposits into ! the bed. Positivity-preserving (flux capped at layer mass), no clamp. if ( state % multilayer % use_sediment . and . state % multilayer % idx_sediment > 0 . and . & state % multilayer % sediment_w_s > 0.0_wp ) then call ml_settling_tracer ( state % multilayer % h_layer , & state % multilayer % tracers ( state % multilayer % idx_sediment )% hTr , & state % multilayer % bed_sediment , & state % multilayer % sediment_w_s , state % grid , nz , state % dt ) end if ! Bed erosion — bed sediment lifted into the bottom layer where the ! (Manning-consistent) bed stress exceeds the critical erosion stress. ! After settling, on the same RK2-averaged state; conservative against ! the bed reservoir. Net bed change = deposition minus erosion. if ( state % multilayer % use_sediment . and . state % multilayer % idx_sediment > 0 . and . & state % multilayer % sediment_erosion_rate > 0.0_wp . and . & state % multilayer % sediment_tau_crit_erosion > 0.0_wp ) then call ml_erode_bed_sediment ( state % multilayer % h_layer , & state % multilayer % hu_layer , state % multilayer % hv_layer , & state % multilayer % tracers ( state % multilayer % idx_sediment )% hTr , & state % multilayer % bed_sediment , & state % barotropic % manning_n , state % multilayer % rho_0 , & state % multilayer % sediment_tau_crit_erosion , & state % multilayer % sediment_erosion_rate , & state % multilayer % sediment_porosity , & state % grid , nz , state % dt ) end if ! Refresh EOS from the rk2-averaged tracers. Skipped at nz=1 (rho_layer ! has no consumer) and when alpha_T=beta_S=0 (density stays at rho_0) ! — unless the shared nonlinear EOS is selected (&tracer_nml eos_form), ! which doesn't read alpha_T/beta_S and must always refresh. if ( nz > 1 . and . ( state % multilayer % eos_use_shared . or . & state % multilayer % alpha_T /= 0.0_wp . or . state % multilayer % beta_S /= 0.0_wp )) then call profiler_start ( \"ml_eos\" ) if ( state % multilayer % eos_use_shared ) then call ml_equation_of_state_shared ( state % multilayer % h_layer , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % rho_layer , state % multilayer % eos , & state % grid , nz ) else call ml_equation_of_state ( state % multilayer % h_layer , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % rho_layer , state % multilayer % rho_0 , & state % multilayer % beta_S , state % multilayer % S_ref , & state % multilayer % alpha_T , state % multilayer % T_ref , & state % grid , nz ) end if call profiler_stop ( \"ml_eos\" ) end if end subroutine solver_step_multilayer_impl","tags":"","url":"proc/solver_step_multilayer_impl.html"},{"title":"solver_step_split_impl – Rakali","text":"private  subroutine solver_step_split_impl(state, dt_max) Split-step driver: N barotropic substeps + 1 baroclinic step Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state real(kind=wp), intent(in), optional :: dt_max Calls proc~~solver_step_split_im