lls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~gauges_unstr_init~~CalledByGraph proc~gauges_unstr_init gauges_unstr_init proc~rki_unstr_gauges_init rki_unstr_gauges_init proc~rki_unstr_gauges_init->proc~gauges_unstr_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: found integer, private :: ig integer, private :: k real(kind=wp), private :: l1 real(kind=wp), private :: l2 real(kind=wp), private :: l3 integer, private :: local_cell (n_gauges) real(kind=wp), private :: local_gx (n_gauges) real(kind=wp), private :: local_gy (n_gauges) real(kind=wp), private :: local_l1 (n_gauges) real(kind=wp), private :: local_l2 (n_gauges) real(kind=wp), private :: local_l3 (n_gauges) integer, private :: n_local real(kind=wp), private :: px real(kind=wp), private :: py integer, private :: v1 integer, private :: v2 integer, private :: v3 real(kind=wp), private :: x1 real(kind=wp), private :: x2 real(kind=wp), private :: x3 real(kind=wp), private :: y1 real(kind=wp), private :: y2 real(kind=wp), private :: y3 Source Code subroutine gauges_unstr_init ( gauges , filename , mesh , n_gauges , gx , gy ) !! Initialise gauge output. !! !! Searches owned triangles for each gauge point, computes !! barycentric weights, and creates the output NetCDF file. !! Gauges not found in any owned triangle are skipped. type ( gauge_unstr_t ), intent ( out ) :: gauges character ( len =* ), intent ( in ) :: filename type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: n_gauges real ( wp ), intent ( in ) :: gx ( n_gauges ) !! gauge x-coordinates real ( wp ), intent ( in ) :: gy ( n_gauges ) !! gauge y-coordinates integer :: ig , k , v1 , v2 , v3 , n_local real ( wp ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 , l1 , l2 , l3 integer :: local_cell ( n_gauges ) real ( wp ) :: local_l1 ( n_gauges ), local_l2 ( n_gauges ), local_l3 ( n_gauges ) real ( wp ) :: local_gx ( n_gauges ), local_gy ( n_gauges ) logical :: found gauges % n_gauges = n_gauges ! Brute-force point-in-triangle search (runs once at init) n_local = 0 do ig = 1 , n_gauges px = gx ( ig ) py = gy ( ig ) found = . false . do k = 1 , mesh % ncells_owned v1 = mesh % tri_v ( 1 , k ) v2 = mesh % tri_v ( 2 , k ) v3 = mesh % tri_v ( 3 , k ) x1 = mesh % vert_x ( v1 ) y1 = mesh % vert_y ( v1 ) x2 = mesh % vert_x ( v2 ) y2 = mesh % vert_y ( v2 ) x3 = mesh % vert_x ( v3 ) y3 = mesh % vert_y ( v3 ) if ( point_in_triangle ( px , py , x1 , y1 , x2 , y2 , x3 , y3 )) then n_local = n_local + 1 local_cell ( n_local ) = k call barycentric_weights ( px , py , x1 , y1 , x2 , y2 , x3 , y3 , & l1 , l2 , l3 ) local_l1 ( n_local ) = l1 local_l2 ( n_local ) = l2 local_l3 ( n_local ) = l3 local_gx ( n_local ) = px local_gy ( n_local ) = py found = . true . exit end if end do if (. not . found ) then call logger % debug ( \"Gauge \" // to_string ( ig ) // \" at (\" // & to_string ( px ) // \", \" // to_string ( py ) // & \") not in owned cells — skipped\" ) end if end do gauges % n_local = n_local if ( n_local == 0 ) then call logger % info ( \"No gauges on this rank\" ) return end if ! Store local gauge data allocate ( gauges % cell_id ( n_local )) allocate ( gauges % lam1 ( n_local ), gauges % lam2 ( n_local ), gauges % lam3 ( n_local )) allocate ( gauges % gauge_x ( n_local ), gauges % gauge_y ( n_local )) gauges % cell_id = local_cell ( 1 : n_local ) gauges % lam1 = local_l1 ( 1 : n_local ) gauges % lam2 = local_l2 ( 1 : n_local ) gauges % lam3 = local_l3 ( 1 : n_local ) gauges % gauge_x = local_gx ( 1 : n_local ) gauges % gauge_y = local_gy ( 1 : n_local ) ! Create NetCDF output file call create_gauge_netcdf ( gauges , filename , mesh ) call logger % info ( \"Gauges initialised: \" // to_string ( n_local ) // \" of \" // & to_string ( n_gauges ) // \" on this rank → \" // trim ( filename )) end subroutine gauges_unstr_init","tags":"","url":"proc/gauges_unstr_init.html"},{"title":"gauges_unstr_write – Rakali","text":"public  subroutine gauges_unstr_write(gauges, state, time) Interpolate (eta, u, v) at gauge locations and write to file. Uses centroid values of the containing triangle (no barycentric\ninterpolation of vertices needed since the solver stores\ncell-centred values). The barycentric weights are available\nfor future vertex-based interpolation if needed. Arguments Type Intent Optional Attributes Name type( gauge_unstr_t ), intent(inout) :: gauges type( unstr_state_t ), intent(in) :: state real(kind=wp), intent(in) :: time Calls proc~~gauges_unstr_write~~CallsGraph proc~gauges_unstr_write gauges_unstr_write nf90_put_var nf90_put_var proc~gauges_unstr_write->nf90_put_var nf90_sync nf90_sync proc~gauges_unstr_write->nf90_sync proc~nc_check nc_check proc~gauges_unstr_write->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~gauges_unstr_write~~CalledByGraph proc~gauges_unstr_write gauges_unstr_write proc~rki_unstr_gauges_write rki_unstr_gauges_write proc~rki_unstr_gauges_write->proc~gauges_unstr_write Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: bed_k real(kind=wp), private :: eta_vals (gauges%n_local) real(kind=wp), private :: h real(kind=wp), private :: hu real(kind=wp), private :: hv integer, private :: ig integer, private :: k real(kind=wp), private :: stage_k integer, private :: ti real(kind=wp), private :: u_vals (gauges%n_local) real(kind=wp), private :: v_vals (gauges%n_local) Source Code subroutine gauges_unstr_write ( gauges , state , time ) !! Interpolate (eta, u, v) at gauge locations and write to file. !! !! Uses centroid values of the containing triangle (no barycentric !! interpolation of vertices needed since the solver stores !! cell-centred values). The barycentric weights are available !! for future vertex-based interpolation if needed. type ( gauge_unstr_t ), intent ( inout ) :: gauges type ( unstr_state_t ), intent ( in ) :: state real ( wp ), intent ( in ) :: time integer :: ig , k , ti real ( wp ) :: eta_vals ( gauges % n_local ) real ( wp ) :: u_vals ( gauges % n_local ) real ( wp ) :: v_vals ( gauges % n_local ) real ( wp ) :: h , hu , hv , stage_k , bed_k if ( gauges % n_local == 0 . or . gauges % ncid < 0 ) return ! Interpolate at each gauge (cell-centred values) do ig = 1 , gauges % n_local k = gauges % cell_id ( ig ) stage_k = state % barotropic % stage_cv ( k ) bed_k = state % barotropic % bed_cv ( k ) h = max ( stage_k - bed_k , 0.0_wp ) hu = state % barotropic % xmom_cv ( k ) hv = state % barotropic % ymom_cv ( k ) eta_vals ( ig ) = stage_k if ( h > MIN_DEPTH ) then u_vals ( ig ) = hu / h v_vals ( ig ) = hv / h else u_vals ( ig ) = 0.0_wp v_vals ( ig ) = 0.0_wp end if end do ! Write to NetCDF gauges % time_index = gauges % time_index + 1 ti = gauges % time_index call nc_check ( nf90_put_var ( gauges % ncid , gauges % time_varid , time , & start = [ ti ]), \"writing gauge time\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % eta_varid , eta_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge eta\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % u_varid , u_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge u\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % v_varid , v_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge v\" ) call nc_check ( nf90_sync ( gauges % ncid ), \"syncing gauge file\" ) end subroutine gauges_unstr_write","tags":"","url":"proc/gauges_unstr_write.html"},{"title":"barycentric_weights – Rakali","text":"private pure subroutine barycentric_weights(px, py, x1, y1, x2, y2, x3, y3, l1, l2, l3) Compute barycentric coordinates of (px,py) in triangle\n(x1,y1)-(x2,y2)-(x3,y3). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: px real(kind=wp), intent(in) :: py real(kind=wp), intent(in) :: x1 real(kind=wp), intent(in) :: y1 real(kind=wp), intent(in) :: x2 real(kind=wp), intent(in) :: y2 real(kind=wp), intent(in) :: x3 real(kind=wp), intent(in) :: y3 real(kind=wp), intent(out) :: l1 real(kind=wp), intent(out) :: l2 real(kind=wp), intent(out) :: l3 Called by proc~~barycentric_weights~~CalledByGraph proc~barycentric_weights barycentric_weights proc~gauges_unstr_init gauges_unstr_init proc~gauges_unstr_init->proc~barycentric_weights proc~rki_unstr_gauges_init rki_unstr_gauges_init proc~rki_unstr_gauges_init->proc~gauges_unstr_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: det Source Code pure subroutine barycentric_weights ( px , py , x1 , y1 , x2 , y2 , x3 , y3 , & l1 , l2 , l3 ) !! Compute barycentric coordinates of (px,py) in triangle !! (x1,y1)-(x2,y2)-(x3,y3). real ( wp ), intent ( in ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 real ( wp ), intent ( out ) :: l1 , l2 , l3 real ( wp ) :: det det = ( y2 - y3 ) * ( x1 - x3 ) + ( x3 - x2 ) * ( y1 - y3 ) if ( abs ( det ) < 1.0e-30_wp ) then l1 = 1.0_wp / 3.0_wp l2 = 1.0_wp / 3.0_wp l3 = 1.0_wp / 3.0_wp return end if l1 = (( y2 - y3 ) * ( px - x3 ) + ( x3 - x2 ) * ( py - y3 )) / det l2 = (( y3 - y1 ) * ( px - x3 ) + ( x1 - x3 ) * ( py - y3 )) / det l3 = 1.0_wp - l1 - l2 end subroutine barycentric_weights","tags":"","url":"proc/barycentric_weights.html"},{"title":"create_gauge_netcdf – Rakali","text":"private  subroutine create_gauge_netcdf(gauges, filename, mesh) Create CF-1.8 station NetCDF file for gauge output. Arguments Type Intent Optional Attributes Name type( gauge_unstr_t ), intent(inout) :: gauges character(len=*), intent(in) :: filename type( mesh_unstr_t ), intent(in) :: mesh Calls proc~~create_gauge_netcdf~~CallsGraph proc~create_gauge_netcdf create_gauge_netcdf proc~nc_create_file nc_create_file proc~create_gauge_netcdf->proc~nc_create_file proc~nc_def_dim nc_def_dim proc~create_gauge_netcdf->proc~nc_def_dim proc~nc_def_var_2d nc_def_var_2d proc~create_gauge_netcdf->proc~nc_def_var_2d proc~nc_enddef nc_enddef proc~create_gauge_netcdf->proc~nc_enddef proc~nc_put_att nc_put_att proc~create_gauge_netcdf->proc~nc_put_att proc~nc_put_att_global nc_put_att_global proc~create_gauge_netcdf->proc~nc_put_att_global proc~rki_def_var_1d rki_def_var_1d proc~create_gauge_netcdf->proc~rki_def_var_1d proc~rki_put_var_1d rki_put_var_1d proc~create_gauge_netcdf->proc~rki_put_var_1d nf90_create nf90_create proc~nc_create_file->nf90_create proc~nc_check nc_check proc~nc_create_file->proc~nc_check nf90_def_dim nf90_def_dim proc~nc_def_dim->nf90_def_dim proc~nc_def_dim->proc~nc_check nf90_def_var nf90_def_var proc~nc_def_var_2d->nf90_def_var nf90_def_var_deflate nf90_def_var_deflate proc~nc_def_var_2d->nf90_def_var_deflate proc~nc_def_var_2d->proc~nc_check nf90_enddef nf90_enddef proc~nc_enddef->nf90_enddef proc~nc_enddef->proc~nc_check nf90_put_att nf90_put_att proc~nc_put_att->nf90_put_att proc~nc_put_att->proc~nc_check proc~nc_put_att_global->nf90_put_att proc~nc_put_att_global->proc~nc_check proc~rki_def_var_1d->nf90_def_var proc~rki_de