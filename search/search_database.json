d each step. real(kind=wp), public, allocatable :: height_ev (:,:) Water depth at edge midpoints. real(kind=wp), public :: manning_n = 0.0_wp Manning roughness coefficient (s/m&#94;{1/3}). Uniform. real(kind=wp), public, allocatable :: mass_flux_e (:,:) Net mass inflow to this cell across edge i, written by the\ncentral-upwind flux kernel and reused by ml_advect_tracer_unstr for CWC-consistent advection.\nShape (3, ncells_total) , units m&#94;3/s, positive INTO the cell. real(kind=wp), public, allocatable :: max_speed (:) Maximum wave speed seen on any edge of this cell during the\nlast flux pass. real(kind=wp), public, allocatable :: stage_backup (:) real(kind=wp), public, allocatable :: stage_cv (:) Stage w = h + b at the centroid (m). real(kind=wp), public, allocatable :: stage_eu (:) d(stage)/dt accumulator (cell-centric, no scatter). real(kind=wp), public, allocatable :: stage_ev (:,:) Stage at edge midpoints, after second-order extrapolation. real(kind=wp), public :: wind_tau_x = 0.0_wp Spatially-uniform wind stress in x (Pa). real(kind=wp), public :: wind_tau_y = 0.0_wp Spatially-uniform wind stress in y (Pa). real(kind=wp), public, allocatable :: x_centroid_work (:) Stash for original xmom during velocity-form reconstruction. real(kind=wp), public, allocatable :: xmom_backup (:) real(kind=wp), public, allocatable :: xmom_cv (:) x-momentum h*u at the centroid (m&#94;2/s). real(kind=wp), public, allocatable :: xmom_eu (:) d(xmom)/dt accumulator. real(kind=wp), public, allocatable :: xmom_ev (:,:) x-momentum at edge midpoints. real(kind=wp), public, allocatable :: xmom_siu (:) Semi-implicit increment for x-momentum (Manning friction). real(kind=wp), public, allocatable :: y_centroid_work (:) Stash for original ymom during velocity-form reconstruction. real(kind=wp), public, allocatable :: ymom_backup (:) real(kind=wp), public, allocatable :: ymom_cv (:) y-momentum h*v at the centroid (m&#94;2/s). real(kind=wp), public, allocatable :: ymom_eu (:) d(ymom)/dt accumulator. real(kind=wp), public, allocatable :: ymom_ev (:,:) y-momentum at edge midpoints. real(kind=wp), public, allocatable :: ymom_siu (:) Semi-implicit increment for y-momentum. Type-Bound Procedures procedure, public, non_overridable :: destroy => unstr_barotropic_destroy procedure, public, non_overridable :: enter_data => unstr_barotropic_enter_data procedure, public, non_overridable :: exit_data => unstr_barotropic_exit_data procedure, public, non_overridable :: init => unstr_barotropic_init Subroutines private  subroutine unstr_barotropic_destroy (this) Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this private  subroutine unstr_barotropic_enter_data (this) Map the barotropic allocatables onto the device (the parent\nvalue-type member rides over with copyin(state) ; only the inner\narrays need explicit attaches).  Read+write fields use copyin ,\npure-workspace fields use create . Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this private  subroutine unstr_barotropic_exit_data (this) Reverse of enter_data — copy out host-visible fields, drop\npure scratch.  Components first, parent last (handled by the\ncaller state_unstr_exit_data ). Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this private  subroutine unstr_barotropic_init (this, mesh) Allocate every array at the cell counts in mesh . All arrays\nare zero-initialised.  Calling on an already-initialised\nsub-object is safe – it destroys first. Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh","tags":"","url":"module/rki_barotropic_state_unstr.html"},{"title":"rki_tracer_unstr – Rakali","text":"Per-tracer state and config for the unstructured multilayer\nsolver.  Mirrors rki_tracer (structured) field-for-field; only\nthe array axis order differs.  Cell-centr