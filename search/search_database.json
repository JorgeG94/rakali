nt(in) :: Qn_ext real(kind=wp), intent(out) :: q_right (3) real(kind=wp), intent(out) :: zr real(kind=wp), intent(out) :: hre private pure subroutine compute_chapman_eta_target (state, mesh, k, i, hle, eta_target) Orlanski-style radiating ghost stage at boundary edge i of\ncell k . Advects the persistent chapman_eta_old(i, k) toward\nthe interior centroid stage along the phase speed, writes back\nthe new eta_old , and returns eta_target as the BC_TIDAL\nghost eta. Per-edge writes to chapman_eta_old(i, k) are\nrace-free: each (i, k) is touched only by cell k . Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: k integer, intent(in) :: i real(kind=wp), intent(in) :: hle real(kind=wp), intent(out) :: eta_target private pure subroutine compute_velocity_terms_impl (h, h_edge, uh_raw, vh_raw, u, uh, v, vh) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h real(kind=wp), intent(in) :: h_edge real(kind=wp), intent(in) :: uh_raw real(kind=wp), intent(in) :: vh_raw real(kind=wp), intent(out) :: u real(kind=wp), intent(out) :: uh real(kind=wp), intent(out) :: v real(kind=wp), intent(out) :: vh private pure subroutine cu_flux_pointwise_impl (q_left, q_right, h_left, h_right, hle, hre, n1, n2, low_froude_mode, edgeflux, max_speed, pressure_flux) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: q_left (3) real(kind=wp), intent(in) :: q_right (3) real(kind=wp), intent(in) :: h_left real(kind=wp), intent(in) :: h_right real(kind=wp), intent(in) :: hle real(kind=wp), intent(in) :: hre real(kind=wp), intent(in) :: n1 real(kind=wp), intent(in) :: n2 integer, intent(in) :: low_froude_mode real(kind=wp), intent(out) :: edgeflux (3) real(kind=wp), intent(out) :: max_speed real(kind=wp), intent(out) :: pressure_flux private pure subroutine flux_one_cell (state, mesh, k) Per-cell body of the flux pass. Pure: never writes to any cell\nother than k . Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: k private pure subroutine rotate_to_normal_impl (q, n1, n2) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: q (3) real(kind=wp), intent(in) :: n1 real(kind=wp), intent(in) :: n2","tags":"","url":"module/rki_kernel_flux_unstr.html"},{"title":"rki_nonhydrostatic_state – Rakali","text":"Per-layer NH prognostics ( u_layer , v_layer , w , q_nh ) + RK2\nsaves, CG Poisson workspaces, barotropic pre-HLL momentum saves,\nmode-splitting time-average + barotropic-tendency arrays, and the\nNH/CG/split scalar config.  Lives at state%nh ; allocated by state_init only when use_nonhydrostatic = .true. (else scalar\ndefaults).  Mode-splitting arrays further gated on split_ratio /= 1 . Uses rki_grid rki_constants rki_mem_report iso_fortran_env module~~rki_nonhydrostatic_state~~UsesGraph module~rki_nonhydrostatic_state rki_nonhydrostatic_state iso_fortran_env iso_fortran_env module~rki_nonhydrostatic_state->iso_fortran_env module~rki_constants rki_constants module~rki_nonhydrostatic_state->module~rki_constants module~rki_grid rki_grid module~rki_nonhydrostatic_state->module~rki_grid module~rki_mem_report rki_mem_report module~rki_nonhydrostatic_state->module~rki_mem_report pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants module~rki_mem_report->iso_fortran_env module~rki_mem_report->module~rki_constants pic_logger pic_logger module~rki_mem_report->pic_logger pic_strings pic_strings module~rki_mem_report->pic_strings Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program