hich it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_state.f90~~AfferentGraph sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90 rki_handle.F90 sourcefile~rki_api.f90->sourcefile~rki_handle.f90 sourcefile~rki_init.f90 rki_init.F90 sourcefile~rki_api.f90->sourcefile~rki_init.f90 sourcefile~rki_output.f90 rki_output.F90 sourcefile~rki_api.f90->sourcefile~rki_output.f90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_coastal_console_stats.f90 rki_coastal_console_stats.F90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_init.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_state.f90 sourcefile~rki_driver.f90->sourcefile~rki_coastal_console_stats.f90 sourcefile~rki_forcing.f90 rki_forcing.F90 sourcefile~rki_driver.f90->sourcefile~rki_forcing.f90 sourcefile~rki_gauges.f90 rki_gauges.F90 sourcefile~rki_driver.f90->sourcefile~rki_gauges.f90 sourcefile~rki_driver.f90->sourcefile~rki_init.f90 sourcefile~rki_nesting.f90 rki_nesting.F90 sourcefile~rki_driver.f90->sourcefile~rki_nesting.f90 sourcefile~rki_driver.f90->sourcefile~rki_output.f90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_forcing.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90->sourcefile~rki_state.f90 sourcefile~rki_init.f90->sourcefile~rki_state.f90 sourcefile~rki_nesting.f90->sourcefile~rki_state.f90 sourcefile~rki_output.f90->sourcefile~rki_state.f90 sourcefile~rki_solver.f90->sourcefile~rki_state.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Solution state type for the shallow water solver module rki_state !! Manages the conserved variables, bathymetry, and flux arrays !! !! All arrays use SoA layout with dimensions (nx_total, ny_total) where !! nx_total = nx_physical + 2*nghost. The first index (i / x-direction) !! is the fast-varying index for coalesced GPU memory access. use , intrinsic :: iso_fortran_env , only : int64 use rki_constants , only : wp , KEPS_STAB_CONSTANT , KEPS_STAB_GALPERIN , KEPS_STAB_CANUTO use rki_config , only : config_t use rki_mem_report , only : arr_bytes use rki_boundary_types , only : bc_params_t , BC_WALL use rki_vcoord , only : parse_vcoord_type , parse_remap_method , parse_stretching_mode use rki_timestepper , only : parse_time_scheme , TIME_RK2 , TIME_SEMI_IMPLICIT use rki_grid , only : hgrid_t use rki_surface_forcing , only : surface_forcing_t use rki_barotropic_state , only : barotropic_state_t use rki_multilayer_state , only : multilayer_state_t use rki_nonhydrostatic_state , only : nonhydrostatic_state_t use rki_tracer , only : tracer_t #ifndef RAKALI_NO_NETCDF use rki_bathymetry , only : load_bathymetry_into_array , & fill_bathymetry_ghosts_array #endif implicit none private public :: state_t public :: register_default_tracers public :: load_bathymetry , fill_bathymetry_ghosts type :: state_t !! Container for all solution arrays and grid metadata ! Barotropic conserved variables, bathymetry, flux scratch, RK2 ! saves, and barotropic physics scalars (Manning's n, Coriolis f). type ( barotropic_state_t ) :: barotropic ! Grid metadata type ( hgrid_t ) :: grid !! Cell counts, ghost width, and cell sizes ! Time-stepping real ( wp ) :: dt = 0.0_wp !! Current timestep (s) real ( wp ) :: cfl = 0.45_wp !! CFL number real ( wp ) :: dt_fixed = 0.0_wp !! Fixed timestep (s), 0 = adaptive CFL integer :: cfl_interval = 1 !! Recompute CFL timestep every N steps (1 = every step) integer :: time_scheme = TIME_RK2 !! Explicit time integrator (`TIME_*` from rki_timestepper). !! Default RK2 reproduces the historical SSP-RK2 path bit-for-bit. integer :: step_count = 0 !! Internal step counter for CFL interval ! Surface forcing fields (wind, pressure, precipitation, heat, ! virtual freshwater).  Filled by the forcing reader or API setters; ! consumed by barotropic friction + multilayer surface-flux kernels. type ( surface_forcing_t ) :: forcing ! Boundary condition parameters type ( bc_params_t ) :: bc !! Boundary condition configuration ! Coupled hydrostatic multi-layer logical :: use_multilayer = . false . !! Enable coupled hydrostatic vertical layers type ( multilayer_state_t ) :: multilayer !! Per-layer arrays, vcoord, tracer registry, EOS, vmix, BPG. ! Non-hydrostatic pressure correction (multi-layer) + mode-split logical :: use_nonhydrostatic = . false . !! Enable NH pressure correction type ( nonhydrostatic_state_t ) :: nh !! Per-layer NH velocities/pressure + RK2 saves, CG workspaces, !! barotropic pre-HLL momentum saves, mode-splitting arrays. contains procedure , non_overridable :: init => state_init procedure , non_overridable :: init_from_config => state_init_from_config procedure , non_overridable :: destroy => state_destroy procedure , non_overridable :: bytes => state_bytes end type state_t contains subroutine state_init ( this , nx_phys , ny_phys , nghost , dx , dy , cfl ) !! Allocate all arrays and set grid metadata class ( state_t ), intent ( inout ) :: this integer , intent ( in ) :: nx_phys !! Number of physical cells in x integer , intent ( in ) :: ny_phys !! Number of physical cells in y integer , intent ( in ) :: nghost !! Ghost cell width real ( wp ), intent ( in ) :: dx !! Cell size in x (m) real ( wp ), intent ( in ) :: dy !! Cell size in y (m) real ( wp ), intent ( in ) :: cfl !! CFL number integer :: nx , ny this % cfl = cfl call this % grid % init ( nx_phys , ny_phys , nghost , dx , dy ) nx = this % grid % nx_total ny = this % grid % ny_total ! Barotropic state arrays (h, hu, hv + RK saves, bathymetry, ! flux + mass-flux scratch) call this % barotropic % init ( this % grid ) ! Surface forcing arrays (initialised to zero = no forcing) call this % forcing % init ( this % grid ) ! Coupled hydrostatic multi-layer arrays + tracer registry. ! Caller must set nz_ml + vcoord params first; multilayer%init reads them. if ( this % use_multilayer ) then call this % multilayer % init ( this % grid ) end if ! Non-hydrostatic arrays + mode-splitting buffers.  Caller must set ! nz, CG/NH config, and split_ratio first; nh%init reads them. if ( this % use_nonhydrostatic ) then call this % nh % init ( this % grid ) end if end subroutine state_init subroutine state_init_from_config ( this , cfg ) !! Allocate arrays from config class ( state_t ), intent ( inout ) :: this type ( config_t ), intent ( in ) :: cfg !! Configuration parameters ! Set multilayer parameters from config (read by multilayer%init below) this % use_multilayer = cfg % use_multilayer if ( cfg % use_multilayer ) then this % multilayer % nz_ml = cfg % nz_layers ! Vcoord parameters so multilayer%init picks them up this % multilayer % vcoord % coord_type = parse_vcoord_type ( cfg % vcoord_type ) this % multilayer % vcoord % remap_method = parse_remap_method ( cfg % remap_method ) this % multilayer % vcoord % depth_transition = cfg % vcoord_depth_transition this % multilayer % vcoord % blend_width = cfg % vcoord_blend_width this % multilayer % vcoord % zstar_h_surf_target = cfg % zstar_h_surf_target this % multilayer % vcoord % zstar_h_min = cfg % zstar_h_min this % multilayer % vcoord % zstar_stretching = parse_stretching_mode ( cfg % zstar_stretching ) this % multilayer % vcoord % zstar_n_surf = cfg % zstar_n_surf this % multilayer % initial_salinity = cfg % initial_salinity this % multilayer % S_init_surface = cfg % S_init_surface this % multilayer % S_init_bottom = cfg % S_init_bottom this % multilayer % S_ref = cfg % S_ref this % multilayer % beta_S = cfg % beta_S this % multilayer % S_min = cfg % S_min this % multilayer % S_max = cfg % S_max this % multilayer % kappa_S_bg = cfg % kappa_S_bg this % multilayer % initial_temperature = cfg % initial_temperature this % multilayer % T_init_surface = cfg % T_init_surface this % multilayer % T_init_bottom = cfg % T_init_bottom this % multilayer % T_ref = cfg % T_ref this % multilayer % alpha_T = cfg % alpha_T this % multilayer % T_min = cfg % T_min this % multilayer % T_max = cfg % T_max this % multilayer % kappa_T_bg = cfg % kappa_T_bg this % multilayer % rho_0 = cfg % rho_0 ! Coastal EOS selector (&tracer_nml eos_form): default \"linear\" ! keeps the legacy kernel (eos_use_shared = .false.); \"wright\" / ! \"roquet_spv\" opt in to the shared nonlinear EOS.  The handle ! is a flat POD read on the host at dispatch — no device map. block use rki_ml_eos , only : ml_parse_eos_form call ml_parse_eos_form ( cfg % eos_form , & this % multilayer % eos_use_shared , & this % multilayer % eos % variant ) end block this % multilayer % eos % rho0 = cfg % rho_0 this % multilayer % eos % S_ref = cfg % S_ref this % multilayer % eos % T_ref = cfg % T_ref this % multilayer % eos % alpha_T = cfg % alpha_T this % multilayer % eos % beta_S = cfg % beta_S this % multilayer % eos % is_init = . true . this % multilayer % vmix_nu_max = cfg % vmix_nu_max this % multilayer % vmix_nu_bg = cfg % vmix_nu_bg this % multilayer % vmix_ri_alpha = cfg % vmix_ri_alpha this % multilayer % vmix_use_kpp = cfg % vmix_use_kpp this % multilayer % vmix_use_keps = cfg % vmix_use_keps this % multilayer % kpp_ri_crit = cfg % kpp_ri_crit this % multilayer % kpp_cs_nonlocal = cfg % kpp_cs_nonlocal this % multilayer % kpp_c_vt2 = cfg % kpp_c_vt2 this % multilayer % hdiff_kappa = cfg % hdiff_kappa this % multilayer % smagorinsky_cs = cfg % smagorinsky_cs this % multilayer % biharmonic_nu4 = cfg % biharmonic_nu4 this % multilayer % evap_mass_sink = cfg % evap_mass_sink this % multilayer % evap_latent_cooling = cfg % evap_latent_cooling this % multilayer % use_bpg_jacobian = ( trim ( cfg % bpg_method ) == \"jacobian\" ) this % multilayer % keps_stability = KEPS_STAB_CONSTANT if ( trim ( cfg % keps_stability ) == \"galperin\" ) then this % multilayer % keps_stability = KEPS_STAB_GALPERIN else if ( trim ( cfg % keps_stability ) == \"canuto\" ) then this % multilayer % keps_stability = KEPS_STAB_CANUTO end if this % multilayer % use_ppm_tracer = cfg % use_ppm_tracer block use rki_recon_weno , only : parse_tracer_recon this % multilayer % tracer_recon_code = parse_tracer_recon ( trim ( cfg % tracer_recon )) end block ! Sediment (set before this%init so bed_sediment allocates). this % multilayer % use_sediment = cfg % use_sediment this % multilayer % sediment_w_s = cfg % sediment_w_s this % multilayer % sediment_initial_conc = cfg % sediment_initial_conc this % multilayer % sediment_bed_init = cfg % sediment_bed_init this % multilayer % sediment_tau_crit_erosion = cfg % sediment_tau_crit_erosion this % multilayer % sediment_erosion_rate = cfg % sediment_erosion_rate this % multilayer % sediment_porosity = cfg % sediment_porosity end if ! Parse the time-scheme tag up front.  Semi-implicit is unstructured-only; ! a direct-API caller who sets only the string must fail loud here. this % time_scheme = parse_time_scheme ( cfg % time_scheme ) if ( this % time_scheme == TIME_SEMI_IMPLICIT ) then error stop \"time_scheme='semi_implicit' is only supported on \" // & \"unstructured grids\" end if ! Set NH and mode-splitting parameters from config (read by ! nh%init below) this % use_nonhydrostatic = cfg % use_nonhydrostatic this % nh % nz = cfg % nz_layers this % nh % nh_tolerance = cfg % nh_tolerance this % nh % nh_max_iterations = cfg % nh_max_iterations this % nh % nh_preconditioner = cfg % nh_preconditioner this % nh % nh_solve_interval = cfg % nh_solve_interval this % nh % split_ratio = cfg % split_ratio this % nh % split_averaging = cfg % split_averaging ! Delegate to main init (allocates arrays) call this % init ( cfg % nx , cfg % ny , cfg % nghost , cfg % dx , cfg % dy , cfg % cfl ) ! Set physics parameters from config this % barotropic % manning_n = cfg % manning_n this % barotropic % use_linear_bottom_drag = cfg % use_linear_bottom_drag this % barotropic % bottom_drag_r = cfg % bottom_drag_r this % barotropic % wind_surface_layer = cfg % wind_surface_layer this % forcing % wind_stress_x = cfg % wind_stress_x this % forcing % wind_stress_y = cfg % wind_stress_y this % barotropic % coriolis_f = cfg % coriolis_f this % barotropic % use_hllc = cfg % use_hllc this % dt_fixed = cfg % dt_fixed this % cfl_interval = cfg % cfl_interval ! The selectable explicit integrator (euler/rk3/rk43) is wired into ! the 2D barotropic fast path only.  Multilayer + non-hydrostatic ! keep their hard-wired SSP-RK2 (mode-split / pressure stages sit ! between the Euler update and the combine, so they can't share the ! generic N-stage loop yet).  Fail loud rather than silently ignore. ! The selectable explicit integrators (euler/rk3/rk43) are wired into ! the 2D barotropic fast path only.  NH is excluded on all non-rk2 ! schemes. if ( this % time_scheme /= TIME_RK2 . and . this % use_nonhydrostatic ) then error stop \"time_scheme: euler/rk3/rk43 are incompatible \" // & \"with use_nonhydrostatic=.true.; non-hydrostatic runs use rk2.\" end if if ( this % time_scheme /= TIME_RK2 . and . this % use_multilayer ) then error stop \"time_scheme: euler/rk3/rk43 require the 2D barotropic path \" // & \"(use_multilayer=.false.); multilayer runs use rk2.\" end if ! Fill spatially-varying forcing arrays from uniform config values this % forcing % wind_x (:, :) = cfg % wind_stress_x this % forcing % wind_y (:, :) = cfg % wind_stress_y ! Register the prognostic salinity + temperature tracers in the ! generic registry, accessed via tracers(idx_salinity/idx_temperature)%hTr. if ( cfg % use_multilayer ) then call register_default_tracers ( & this % multilayer % tracers ( this % multilayer % idx_salinity ), & this % multilayer % tracers ( this % multilayer % idx_temperature ), & cfg ) ! Register the suspended-sediment tracer (single class) when enabled. ! Horizontal transport / diffusion / clamp ride the registry; settling ! + bed exchange are separate kernels.  eos_coeff = 0 (no density ! feedback); concentration in kg/m&#94;3, clamped >= 0 (no upper bound). if ( cfg % use_sediment ) then call this % multilayer % register_passive_tracer ( this % grid , \"sediment\" , & cfg % sediment_initial_conc , & 0.0_wp , huge ( 1.0_wp ), & cfg % kappa_S_bg , cfg % hdiff_kappa ) this % multilayer % idx_sediment = size ( this % multilayer % tracers ) associate ( tr_sed => this % multilayer % tracers ( this % multilayer % idx_sediment )) tr_sed % long_name = \"Suspended sediment concentration\" tr_sed % units = \"kg m-3\" tr_sed % standard_name = \"mass_concentration_of_suspended_matter_in_sea_water\" end associate end if end if end subroutine state_init_from_config subroutine register_default_tracers ( tr_S , tr_T , cfg ) !! Overlay scalar config onto the already-allocated salinity / !! temperature tracer slots (by reference so coastal + ocean paths !! share the overlay).  Does not touch hTr / hTr0 — those are !! populated by the path's IC step once h_layer is known. type ( tracer_t ), intent ( inout ) :: tr_S type ( tracer_t ), intent ( inout ) :: tr_T type ( config_t ), intent ( in ) :: cfg ! Salinity tr_S % name = \"salinity\" tr_S % long_name = \"Sea water salinity\" tr_S % units = \"PSU\" tr_S % standard_name = \"sea_water_salinity\" tr_S % tr_init = cfg % initial_salinity tr_S % tr_inflow = cfg % inflow_salinity tr_S % tr_min = cfg % S_min tr_S % tr_max = cfg % S_max tr_S % kappa_bg = cfg % kappa_S_bg tr_S % hdiff_kappa = cfg % hdiff_kappa tr_S % eos_coeff = cfg % beta_S tr_S % eos_ref = cfg % S_ref ! Temperature tr_T % name = \"temperature\" tr_T % long_name = \"Sea water potential temperature\" tr_T % units = \"degC\" tr_T % standard_name = \"sea_water_potential_temperature\" tr_T % tr_init = cfg % initial_temperature tr_T % tr_inflow = cfg % inflow_temperature tr_T % tr_min = cfg % T_min tr_T % tr_max = cfg % T_max tr_T % kappa_bg = cfg % kappa_T_bg tr_T % hdiff_kappa = cfg % hdiff_kappa tr_T % eos_coeff = - cfg % alpha_T tr_T % eos_ref = cfg % T_ref end subroutine register_default_tracers subroutine state_destroy ( this ) !! Deallocate all arrays class ( state_t ), intent ( inout ) :: this call this % barotropic % destroy () call this % forcing % destroy () call this % multilayer % destroy () call this % nh % destroy () ! Chapman BC arrays if ( allocated ( this % bc % eta_old_west )) deallocate ( this % bc % eta_old_west ) if ( allocated ( this % bc % eta_old_east )) deallocate ( this % bc % eta_old_east ) if ( allocated ( this % bc % eta_old_south )) deallocate ( this % bc % eta_old_south ) if ( allocated ( this % bc % eta_old_north )) deallocate ( this % bc % eta_old_north ) end subroutine state_destroy pure function state_bytes ( this ) result ( nbytes ) !! Counted allocatable footprint of the whole coastal state, summed !! from each sub-slot's own `bytes()` (each 0 when its feature is !! gated off, so the total tracks conditional allocation directly). !! Reported before `enter_data` and reconciled against the measured !! device mapping — see `rki_mem_report`. class ( state_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = this % barotropic % bytes () + this % forcing % bytes () if ( this % use_multilayer ) nbytes = nbytes + this % multilayer % bytes () if ( this % use_nonhydrostatic ) nbytes = nbytes + this % nh % bytes () ! Chapman persistent-state arrays live directly on the bc slot. nbytes = nbytes + arr_bytes ( this % bc % eta_old_west ) & + arr_bytes ( this % bc % eta_old_east ) & + arr_bytes ( this % bc % eta_old_south ) & + arr_bytes ( this % bc % eta_old_north ) end function state_bytes subroutine load_bathymetry ( filename , state ) !! Coastal-state entry point — forwards to the array-based loader !! in `rki_bathymetry`.  Lives here (not there) to avoid a USE cycle. character ( len =* ), intent ( in ) :: filename type ( state_t ), intent ( inout ) :: state #ifndef RAKALI_NO_NETCDF call load_bathymetry_into_array ( filename , state % barotropic % b , state % grid ) #else ! File-loaded bathymetry needs the NetCDF reader, compiled out when ! RAKALI_ENABLE_NETCDF=OFF.  Fail fast; embed `filename` (also avoids ! an unused-arg warning). if ( state % grid % nghost < 0 ) return ! refs `state` to silence warn error stop \"load_bathymetry: requires RAKALI_ENABLE_NETCDF=ON at \" // & \"build time (the NetCDF-backed rki_bathymetry reader is needed \" // & \"to load '\" // trim ( filename ) // \"').\" #endif end subroutine load_bathymetry subroutine fill_bathymetry_ghosts ( state ) !! Wrapper mirror of `load_bathymetry` — populates ghost rows on !! `state%barotropic%b` after a custom bathy load (e.g. via the !! Python FFI). type ( state_t ), intent ( inout ) :: state #ifndef RAKALI_NO_NETCDF call fill_bathymetry_ghosts_array ( state % barotropic % b , state % grid ) #else ! Same gate — the ghost-fill helper also lives in rki_bathymetry, ! which is compiled out when RAKALI_ENABLE_NETCDF=OFF. if ( state % grid % nghost < 0 ) return ! refs `state` to silence warn error stop \"fill_bathymetry_ghosts: requires RAKALI_ENABLE_NETCDF=ON \" // & \"at build time.\" #endif end subroutine fill_bathymetry_ghosts end module rki_state","tags":"","url":"sourcefile/rki_state.f90.html"},{"title":"rki_scratch_3d.F90 – Rakali","text":"Reusable 3D scratch-buffer type. This file depends on sourcefile~~rki_scratch_3d.f90~~EfferentGraph sourcefile~rki_scratch_3d.f90 rki_scratch_3d.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_scratch_3d.f90->sourcefile~rki_constants.f90 sourcefile~rki_mem_report.f90 rki_mem_report.F90 sourcefile~rki_scratch_3d.f90->sourcefile~rki_mem_report.f90 sourcefile~rki_mem_report.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Reusable 3D scratch-buffer type. module rki_scratch_3d !! Single owner for `(n1, n2, n3)` scratch arrays.  Every column- !! local kernel slot (continuity, coriolis_adv, pressure_force, !! lateral-mix vorticity scratch, KPP solve scratch) declares its !! per-step workspace as a `scratch_3d_buffer_t` rather than as a !! bare `real(wp), allocatable :: foo(:, :, :)`. !! !! Why centralise this: !!   1. **One allocation policy.**  The strided hybrid loop !!      pattern (see `src/core/ocean/README.md`) sizes every !!      column-local scratch at `(stride, stride, nz_ml)` with !!      `stride = ocean_state%column_stride`.  Putting that policy !!      in one type means a new slot follows the convention by !!      construction, not by remembering to copy-paste it. !!   2. **One GPU-mapping site.**  `enter_data` / `exit_data` !!      live on the type, so every slot that uses this type !!      inherits the mapping for free — no per-slot directive !!      copies to keep in sync. !!   3. **One resize site.**  If a kernel discovers it needs a !!      different shape mid-run (rare — only happens if `stride` !!      becomes dynamic), `ensure_size` reallocates and remaps in !!      one place. !!   4. **Cheap finite-check.**  Phase 6 debug guards walk every !!      `scratch_3d_buffer_t` instance after each slot kernel and !!      verify no NaN / out-of-range leaked into scratch. !! !! Phase 2 status: alloc + GPU enter_data / exit_data live.  Phase !! 1+ items (`ensure_size`, `assert_finite`) still pending. use rki_constants , only : wp use , intrinsic :: iso_fortran_env , only : int64 use rki_mem_report , only : arr_bytes implicit none private public :: scratch_3d_buffer_t ! Non-polymorphic device-attach entry points.  Owning slots call these ! directly (with a `type(scratch_3d_buffer_t)` actual) so the OpenMP ! map base is the heap object, not a polymorphic stack box (the AMD ! libomptarget cross-slot-overlap fix).  The type-bound `enter_data` / ! `exit_data` are thin select-type wrappers over these. public :: scratch_3d_buffer_enter_data_impl public :: scratch_3d_buffer_exit_data_impl type :: scratch_3d_buffer_t logical :: is_init = . false . !! True between `init` and `destroy`.  Prefer this to !! `allocated(this%data)` — tracks GPU device attachment too. ! ---- Declared shape ---- integer :: n1 = 0 !! First-dim size, typically `stride` (or `stride+1` on !! face-located buffers). integer :: n2 = 0 !! Second-dim size, typically `stride`. integer :: n3 = 0 !! Third-dim size, typically `nz_ml` (or `nz_ml+1` for !! layer-interface buffers). ! ---- Payload ---- real ( wp ), allocatable :: data (:, :, :) !! The scratch storage.  Access in a kernel as !! `slot%scratch%data(i, j, k)`.  Note: this is a *single* !! derived type (not array-of-derived-types), so the !! `!$acc` indirection bug from the array-of-DT pattern !! does not apply. ! ---- Optional name ---- character ( len = 32 ) :: name = \"\" !! Human-readable tag for diagnostics + debug guard !! messages (\"kpp_bulk_ri_scratch\", \"ppm_h_face_left_x\", ...). contains procedure , non_overridable :: init => scratch_3d_buffer_init procedure , non_overridable :: destroy => scratch_3d_buffer_destroy procedure , non_overridable :: enter_data => scratch_3d_buffer_enter_data procedure , non_overridable :: exit_data => scratch_3d_buffer_exit_data ! Phase 6+: procedure :: assert_finite — debug-mode invariant procedure , non_overridable :: bytes => scratch_3d_buffer_bytes end type scratch_3d_buffer_t contains subroutine scratch_3d_buffer_init ( this , n1 , n2 , n3 , name ) !! Allocate the host-side storage at (n1, n2, n3), zero-filled. !! GPU attachment is a separate step via `enter_data` — !! `init` runs before the device exists in the typical !! init-then-enter-data sequence. class ( scratch_3d_buffer_t ), intent ( inout ) :: this integer , intent ( in ) :: n1 , n2 , n3 character ( len =* ), intent ( in ), optional :: name this % n1 = n1 this % n2 = n2 this % n3 = n3 if ( present ( name )) this % name = name allocate ( this % data ( n1 , n2 , n3 ), source = 0.0_wp ) this % is_init = . true . end subroutine scratch_3d_buffer_init subroutine scratch_3d_buffer_destroy ( this ) class ( scratch_3d_buffer_t ), intent ( inout ) :: this this % is_init = . false . if ( allocated ( this % data )) deallocate ( this % data ) this % n1 = 0 this % n2 = 0 this % n3 = 0 this % name = \"\" end subroutine scratch_3d_buffer_destroy subroutine scratch_3d_buffer_enter_data ( this ) !! Type-bound wrapper — keeps `buf%enter_data()` call sites working. !! Delegates to the non-polymorphic impl so the OpenMP map base is !! the heap object (see the impl + the public-decl comment above). class ( scratch_3d_buffer_t ), intent ( inout ) :: this select type ( this ) type is ( scratch_3d_buffer_t ) call scratch_3d_buffer_enter_data_impl ( this ) end select end subroutine scratch_3d_buffer_enter_data subroutine scratch_3d_buffer_enter_data_impl ( this ) !! Attach the scratch payload to the device.  `type(...)` (not !! `class`) dummy on purpose: a by-reference non-polymorphic dummy !! aliases the heap object, so `create(this%data)` attaches against !! a heap base — no polymorphic stack box for AMD to reject. !! !! No-op when the payload was never allocated.  Slots may GATE a !! buffer's `init` on a runtime knob (see !! `ocean_pressure_force_t%scratch_gated`) and still call this !! unconditionally from their `enter_data` walk; mapping an !! unallocated allocatable is not defined behaviour, so the guard !! lives here rather than at each call site. type ( scratch_3d_buffer_t ), intent ( inout ) :: this if (. not . allocated ( this % data )) return !$acc enter data create(this%data) end subroutine scratch_3d_buffer_enter_data_impl subroutine scratch_3d_buffer_exit_data ( this ) !! Type-bound wrapper — see scratch_3d_buffer_enter_data. class ( scratch_3d_buffer_t ), intent ( inout ) :: this select type ( this ) type is ( scratch_3d_buffer_t ) call scratch_3d_buffer_exit_data_impl ( this ) end select end subroutine scratch_3d_buffer_exit_data subroutine scratch_3d_buffer_exit_data_impl ( this ) !! Release the scratch payload from the device.  No `copyout` !! — scratch contents are per-step intermediates with no !! host-side meaning.  No-op when never allocated (mirrors !! `scratch_3d_buffer_enter_data_impl`'s gate). type ( scratch_3d_buffer_t ), intent ( inout ) :: this if (. not . allocated ( this % data )) return !$acc exit data delete(this%data) end subroutine scratch_3d_buffer_exit_data_impl pure function scratch_3d_buffer_bytes ( this ) result ( nbytes ) !! Counted allocatable footprint of the 3D scratch buffer slot (0 when !! unallocated). class ( scratch_3d_buffer_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = arr_bytes ( this % data ) end function scratch_3d_buffer_bytes end module rki_scratch_3d","tags":"","url":"sourcefile/rki_scratch_3d.f90.html"},{"title":"rki_tracer.F90 – Rakali","text":"Multilayer tracer descriptor This file depends on sourcefile~~rki_tracer.f90~~EfferentGraph sourcefile~rki_tracer.f90 rki_tracer.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_tracer.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_tracer.f90->sourcefile~rki_grid.f90 sourcefile~rki_mem_report.f90 rki_mem_report.F90 sourcefile~rki_tracer.f90->sourcefile~rki_mem_report.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_mem_report.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_tracer.f90~~AfferentGraph sourcefile~rki_tracer.f90 rki_tracer.F90 sourcefile~rki_multilayer_state.f90 rki_multilayer_state.F90 sourcefile~rki_multilayer_state.f90->sourcefile~rki_tracer.f90 sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_state.f90->sourcefile~rki_tracer.f90 sourcefile~rki_state.f90->sourcefile~rki_multilayer_state.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90 rki_handle.F90 sourcefile~rki_api.f90->sourcefile~rki_handle.f90 sourcefile~rki_init.f90 rki_init.F90 sourcefile~rki_api.f90->sourcefile~rki_init.f90 sourcefile~rki_output.f90 rki_output.F90 sourcefile~rki_api.f90->sourcefile~rki_output.f90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_coastal_console_stats.f90 rki_coastal_console_stats.F90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_init.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_state.f90 sourcefile~rki_driver.f90->sourcefile~rki_coastal_console_stats.f90 sourcefile~rki_forcing.f90 rki_forcing.F90 sourcefile~rki_driver.f90->sourcefile~rki_forcing.f90 sourcefile~rki_gauges.f90 rki_gauges.F90 sourcefile~rki_driver.f90->sourcefile~rki_gauges.f90 sourcefile~rki_driver.f90->sourcefile~rki_init.f90 sourcefile~rki_nesting.f90 rki_nesting.F90 sourcefile~rki_driver.f90->sourcefile~rki_nesting.f90 sourcefile~rki_driver.f90->sourcefile~rki_output.f90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_forcing.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90->sourcefile~rki_state.f90 sourcefile~rki_init.f90->sourcefile~rki_state.f90 sourcefile~rki_nesting.f90->sourcefile~rki_state.f90 sourcefile~rki_output.f90->sourcefile~rki_state.f90 sourcefile~rki_solver.f90->sourcefile~rki_state.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Multilayer tracer descriptor module rki_tracer !! Per-tracer state and config for the structured multilayer solver. !! !! Holds the prognostic field `hTr` (= h * Tr), the RK2 save buffer !! `hTr0`, and all scalar config the kernels consume (initial value, !! BC inflow value, physical clamp bounds, vertical/horizontal !! background diffusivities, and a linear-EOS contribution !! `eos_coeff * (Tr - eos_ref)`). !! !! Lets the solver iterate `do it = 1, size(state%tracers)` and dispatch !! the generic `ml_*_tracer` kernels per element.  Special-shape physics !! (surface heat/salt flux, sediment) indexes by name instead. use , intrinsic :: iso_fortran_env , only : int64 use rki_constants , only : wp use rki_grid , only : hgrid_t use rki_mem_report , only : arr_bytes implicit none private public :: tracer_t public :: TRACER_BUDGET_NONE , TRACER_BUDGET_HEAT , TRACER_BUDGET_SALT integer , parameter :: TRACER_BUDGET_NONE = 0 !! No conservation-budget contributor slot (passive tracers, ideal !! age, pseudo-salt). integer , parameter :: TRACER_BUDGET_HEAT = 1 !! Tracer feeds the OCEAN path's `heat_budget_*` accumulators. integer , parameter :: TRACER_BUDGET_SALT = 2 !! Tracer feeds the OCEAN path's `salt_budget_*` accumulators. type :: tracer_t ! Identity (used for output/config lookup).  All four strings are ! written verbatim onto the NetCDF variable; output loops over the ! registry, so a new tracer needs no changes to `rki_output`. character ( len = 32 ) :: name = \"\" character ( len = 64 ) :: long_name = \"\" character ( len = 16 ) :: units = \"\" character ( len = 64 ) :: standard_name = \"\" !! CF-1.11 standard_name (e.g. \"sea_water_salinity\").  Empty !! string => no standard_name attribute is written. ! Prognostic field and RK2 save (nx_total, ny_total, nz_ml) real ( wp ), allocatable :: hTr (:, :, :) real ( wp ), allocatable :: hTr0 (:, :, :) ! Scalar config real ( wp ) :: tr_init = 0.0_wp !! Uniform initial concentration (set by init from cfg) real ( wp ) :: tr_inflow = 0.0_wp !! BC inflow concentration for BC_INFLOW / BC_DISCHARGE real ( wp ) :: tr_min = - huge ( 1.0_wp ) !! Physical lower clamp bound real ( wp ) :: tr_max = huge ( 1.0_wp ) !! Physical upper clamp bound real ( wp ) :: kappa_bg = 0.0_wp !! Background vertical diffusivity (m&#94;2/s) real ( wp ) :: hdiff_kappa = 0.0_wp !! Horizontal Laplacian diffusivity (m&#94;2/s) ! Linear EOS contribution: rho_anomaly += eos_coeff * (Tr - eos_ref) ! Salinity: eos_coeff = +beta_S, eos_ref = S_ref ! Temperature: eos_coeff = -alpha_T, eos_ref = T_ref ! Passive scalar: eos_coeff = 0 real ( wp ) :: eos_coeff = 0.0_wp real ( wp ) :: eos_ref = 0.0_wp integer :: budget_id = TRACER_BUDGET_NONE !! Which conservation-budget contributor slot this tracer's !! kernels fill on the OCEAN path: NONE (no budget — passive !! tracers, ideal age, pseudo-salt), HEAT (`heat_budget_*`) or !! SALT (`salt_budget_*`).  Read HOST-side only, at the seven !! budget dispatch blocks; never dereferenced inside a device !! loop.  Unused on the coastal paths (no budget slots there) — !! left at NONE. ! Pipeline opt-outs (skip work for diagnostic/passive tracers) logical :: do_horizontal_advection = . true . logical :: do_vertical_exchange = . true . logical :: do_vertical_diffusion = . true . logical :: do_horizontal_diffusion = . true . logical :: do_clamp = . true . contains procedure , non_overridable :: init => tracer_init procedure , non_overridable :: destroy => tracer_destroy procedure , non_overridable :: bytes => tracer_bytes end type tracer_t contains subroutine tracer_init ( this , grid , nz ) !! Allocate hTr / hTr0 at the multilayer grid size, zero-filled. !! Caller is responsible for populating the prognostic field !! (e.g. `hTr = h_layer * tr_init`) after layer thicknesses are set. class ( tracer_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz integer :: nx , ny nx = grid % nx_total ny = grid % ny_total allocate ( this % hTr ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % hTr0 ( nx , ny , nz ), source = 0.0_wp ) end subroutine tracer_init subroutine tracer_destroy ( this ) class ( tracer_t ), intent ( inout ) :: this if ( allocated ( this % hTr )) deallocate ( this % hTr ) if ( allocated ( this % hTr0 )) deallocate ( this % hTr0 ) end subroutine tracer_destroy pure function tracer_bytes ( this ) result ( nbytes ) !! Counted allocatable footprint of one tracer (hTr + RK2 save). class ( tracer_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = arr_bytes ( this % hTr ) + arr_bytes ( this % hTr0 ) end function tracer_bytes end module rki_tracer","tags":"","url":"sourcefile/rki_tracer.f90.html"},{"title":"rki_si_unstr_wetdry.F90 – Rakali","text":"Casulli-style wetting/drying machinery for the unstructured SI surface. This file depends on sourcefile~~rki_si_unstr_wetdry.f90~~EfferentGraph sourcefile~rki_si_unstr_wetdry.f90 rki_si_unstr_wetdry.F90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_common.f90 rki_si_common.F90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_si_common.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_si_unstr_wetdry.f90~~AfferentGraph sourcefile~rki_si_unstr_wetdry.f90 rki_si_unstr_wetdry.F90 sourcefile~rki_si_unstr_step.f90 rki_si_unstr_step.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_wetdry.f90 sourcefile~rki_si_unstr_step_ml.f90 rki_si_unstr_step_ml.F90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_wetdry.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_step.f90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step.f90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step_ml.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Casulli-style wetting/drying machinery for the unstructured SI surface. module rki_si_unstr_wetdry !! Casulli (2009) subgrid wetting/drying for the unstructured !! semi-implicit free-surface mode — ported per-cell (`(n_sub, ncells)` sub-bottom !! layout) exactly as the prototype confirmed mesh-agnostic !! (`si_unstr_proto.py` study 2: V/a/Newton + the edge sill rule ran !! UNCHANGED on triangles).  Replaces the linear solver's constant !! `1.0` cell-mass term by the exact wetted-volume function per unit !! cell area (depth units): !! !!   v_c(eta) = (1/n_sub) sum_s max(eta - b_c&#94;(s), 0)   (mean wet depth) !!   a_c(eta) = v'_c(eta) in [0,1]                      (wet fraction) !! !! driving a PLAIN Newton outer loop (V convex => monotone finite !! convergence) around the SAME area-weighted TPFA CG, with the !! operator's mass term replaced per cell by `a(eta) + floor` (the !! `mass_diag` argument already threaded through !! `si_unstr_apply_helmholtz` / `si_unstr_cg_solve`). !! !! FROZEN edge rule (Casulli, rule R1) — the GATED-MEAN conveyance: !!   Hf_e = 0.5*(max(eta_L-b_L,0) + max(eta_R-b_R,0)) !!          gated to 0 unless  max(eta_L,eta_R) > max(b_L,b_R) !! built ONCE from eta&#94;n and held over the step, shared by the !! operator, back-substitution and RHS (R2).  Where both cells are wet !! this reduces EXACTLY to the linear edge depth 0.5*(h_L+h_R) — the !! all-wet self-consistency invariant.  Dead edges (higher surface !! below the sill) become walls; their U&#94;n edge transports are zeroed !! at step start (R3 — structural on this backend: the RHS consumes !! per-edge transports directly, so zeroing u_star/u_n_edge on Hf=0 !! edges closes the dead-edge flux exactly; no cell-momentum !! reconstruction masking is needed, unlike the structured path). !! Dry-cell eta is NOT clamped at the bed — Newton lets it settle !! below (V = 0 regardless). !! !! References: Casulli (2009) IJNMF 60:391-408; Casulli & Zanolli !! (2010) SISC 32(4):2255-2273. !! !! All kernels explicit-shape `(n_sub|3, ncells)`, device-resident, !! cell-index-last per the unstructured convention. use rki_constants , only : wp use rki_mesh_unstr , only : mesh_unstr_t implicit none private public :: si_unstr_wetdry_fill_bsub public :: si_unstr_wetdry_volume public :: si_unstr_wetdry_wetfrac public :: si_unstr_wetdry_mass_diag public :: si_unstr_wetdry_face_depths public :: si_unstr_wetdry_newton_residual public :: si_unstr_wetdry_wetcount integer , parameter :: EDGES_PER_TRI = 3 !! Triangles only. real ( wp ), parameter :: WETDRY_FLOOR_TOL = 1.0e-14_wp !! Threshold below which a cell's wet fraction AND its three edge !! stiffness coefficients count as zero => a fully-decoupled dry row !! that receives the +1 identity floor (Casulli rule R5): keeps the !! Newton Jacobian SPD with O(1) conditioning where a would be 0. contains pure subroutine si_unstr_wetdry_fill_bsub ( mesh , nsub , nct , nco , bed , & bsub_fill , b_sub , b_min ) !! Fill the per-cell sub-bottom table from the plain bed.  v1 !! (n_sub=1): b_sub(1,:) = bed, b_min = bed — always, regardless of !! mode.  Subgrid (n_sub>=2): !!   FLAT (default): all sub-bottoms = bed => BIT-IDENTICAL to n_sub=1. !!   LINEAR: `nsub` equal-area sub-bottoms evenly spaced across the !!     per-cell relief band `[bed-half, bed+half]`, `half = 0.5*max` !!     edge-neighbour |Δbed| (a linear sub-cell bed ramp; Casulli 2009 !!     subgrid bathymetry, prototype `subgrid_bathy_from_bed`). !!     Sub-bottoms ascending; mean == bed (still-water volume !!     unchanged); wet fraction staircases 1/nsub per breakpoint so a !!     coarse tidal flat drains/floods SMOOTHLY.  Boundary edges (no !!     neighbour) contribute 0 to the relief so a shore cell falls back !!     toward FLAT.  On flat bed (half=0) => == FLAT.  b_min = the !!     deepest (first, sill) sub-bottom. use rki_si_common , only : SI_BSUB_FILL_LINEAR type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nsub !! Sub-bottoms per cell (>= 1). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: bed ( nct ) integer , intent ( in ) :: bsub_fill !! `SI_BSUB_FILL_*`.  FLAT => flat fill; LINEAR => the ramp. real ( wp ), intent ( out ) :: b_sub ( nsub , nct ) real ( wp ), intent ( out ) :: b_min ( nct ) integer :: c , s , i , kn real ( wp ) :: half , b_lo , span , frac , dmax if ( bsub_fill /= SI_BSUB_FILL_LINEAR . or . nsub < 2 ) then do concurrent ( c = 1 : nco ) local ( s ) do s = 1 , nsub b_sub ( s , c ) = bed ( c ) end do b_min ( c ) = bed ( c ) end do return end if do concurrent ( c = 1 : nco ) local ( s , i , kn , half , b_lo , span , frac , dmax ) dmax = 0.0_wp do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , c ) if ( kn > 0 ) dmax = max ( dmax , abs ( bed ( kn ) - bed ( c ))) end do half = 0.5_wp * dmax b_lo = bed ( c ) - half span = 2.0_wp * half do s = 1 , nsub frac = ( real ( s , wp ) - 0.5_wp ) / real ( nsub , wp ) b_sub ( s , c ) = b_lo + span * frac end do b_min ( c ) = b_lo end do end subroutine si_unstr_wetdry_fill_bsub pure subroutine si_unstr_wetdry_volume ( nsub , nct , nco , eta , b_sub , v_cell ) !! Per-cell wetted mean depth v_c(eta) = (1/n_sub) sum_s max(eta-b&#94;s,0) !! (m; per unit cell area).  n_sub=1: v = max(eta-b,0) = the !! still-water total depth. integer , intent ( in ) :: nsub !! Sub-bottoms per cell. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( nct ) real ( wp ), intent ( in ) :: b_sub ( nsub , nct ) real ( wp ), intent ( out ) :: v_cell ( nct ) integer :: c , s real ( wp ) :: acc , inv_nsub inv_nsub = 1.0_wp / real ( nsub , wp ) do concurrent ( c = 1 : nco ) local ( s , acc ) acc = 0.0_wp do s = 1 , nsub acc = acc + max ( eta ( c ) - b_sub ( s , c ), 0.0_wp ) end do v_cell ( c ) = acc * inv_nsub end do end subroutine si_unstr_wetdry_volume pure subroutine si_unstr_wetdry_wetfrac ( nsub , nct , nco , eta , b_sub , a_cell ) !! Per-cell wet fraction a_c(eta) = v' in [0,1] — the Newton diagonal. !! RIGHT-continuous at breakpoints (`eta >= b_sub` counts wet), the !! sub-derivative that keeps Newton-on-convex-V monotone. integer , intent ( in ) :: nsub !! Sub-bottoms per cell. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( nct ) real ( wp ), intent ( in ) :: b_sub ( nsub , nct ) real ( wp ), intent ( out ) :: a_cell ( nct ) integer :: c , s , cnt real ( wp ) :: inv_nsub inv_nsub = 1.0_wp / real ( nsub , wp ) do concurrent ( c = 1 : nco ) local ( s , cnt ) cnt = 0 do s = 1 , nsub if ( eta ( c ) >= b_sub ( s , c )) cnt = cnt + 1 end do a_cell ( c ) = real ( cnt , wp ) * inv_nsub end do end subroutine si_unstr_wetdry_wetfrac pure subroutine si_unstr_wetdry_mass_diag ( nct , nco , a_cell , Hf_edge , mass_diag ) !! Assemble the Newton mass diagonal M = a + floor (Casulli R5): the !! wet fraction a plus a +1 identity for a fully-decoupled dry row !! (a <= tol AND all three edge stiffness coefficients Hf <= tol). !! The `+1` matches the linear operator's constant mass exactly at !! wet cells where a == 1 and no floor fires. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: a_cell ( nct ) real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( out ) :: mass_diag ( nct ) integer :: c , i real ( wp ) :: stiff_sum , floor_c do concurrent ( c = 1 : nco ) local ( i , stiff_sum , floor_c ) stiff_sum = 0.0_wp do i = 1 , EDGES_PER_TRI stiff_sum = stiff_sum + Hf_edge ( i , c ) end do if ( a_cell ( c ) <= WETDRY_FLOOR_TOL . and . stiff_sum <= WETDRY_FLOOR_TOL ) then floor_c = 1.0_wp else floor_c = 0.0_wp end if mass_diag ( c ) = a_cell ( c ) + floor_c end do end subroutine si_unstr_wetdry_mass_diag pure subroutine si_unstr_wetdry_face_depths ( mesh , nct , nco , n_bc , eta , & b_min , bc_type , bc_eta_ext , & Hf_edge , eta_ghost_edge ) !! FROZEN wet/dry edge depths — the GATED-MEAN conveyance rule per !! edge (Casulli rule R1, prototype-verified mesh-agnostic): !!   wet  <=>  max(eta_L, eta_R) > max(b_L, b_R)     (max-eta/sill) !!   Hf   = 0.5*(max(eta_L-b_L,0) + max(eta_R-b_R,0))  where wet !! Where BOTH cells are wet this is EXACTLY the linear edge depth !! 0.5*(h_L+h_R) — an all-wet basin reproduces the linear operator's !! Hf bit-for-bit (NOT a raw max-eta or bare sill depth, which would !! change the all-wet answer — the load-bearing structured lesson). !! Dead edges (higher surface below the higher bed — a wet cell !! cannot \"see\" through a dry one over the sill) are walls (Hf=0). !! !! Boundary edges: WALL => 0; TIDAL/CLAMPED (Dirichlet) => the same !! gated-mean rule against the seeded ghost (ghost bed mirrors the !! cell bed; ghost surface = the prescribed eta_bc, also stashed in !! `eta_ghost_edge` for the operator/RHS/back-sub). use rki_boundary_unstr , only : BC_WALL , BC_TIDAL , BC_CLAMPED type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size. real ( wp ), intent ( in ) :: eta ( nct ) !! eta&#94;n at circumcentres (the FROZEN surface). real ( wp ), intent ( in ) :: b_min ( nct ) !! Sill bed elevation (deepest sub-bottom) at cells (m). integer , intent ( in ) :: bc_type ( n_bc ) real ( wp ), intent ( in ) :: bc_eta_ext ( n_bc ) real ( wp ), intent ( out ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( out ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) integer :: c , i , kn , g , bt real ( wp ) :: eta_bc do concurrent ( c = 1 : nco ) local ( i , kn , g , bt , eta_bc ) do i = 1 , EDGES_PER_TRI eta_ghost_edge ( i , c ) = 0.0_wp kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then Hf_edge ( i , c ) = edge_depth_wetdry ( eta ( c ), eta ( kn ), & b_min ( c ), b_min ( kn )) else g = mesh % bc_group ( i , c ) bt = BC_WALL if ( g >= 1 . and . g <= n_bc ) bt = bc_type ( g ) if (( bt == BC_TIDAL . or . bt == BC_CLAMPED ) . and . g >= 1 ) then eta_bc = bc_eta_ext ( g ) Hf_edge ( i , c ) = edge_depth_wetdry ( eta ( c ), eta_bc , & b_min ( c ), b_min ( c )) eta_ghost_edge ( i , c ) = eta_bc else Hf_edge ( i , c ) = 0.0_wp end if end if end do end do end subroutine si_unstr_wetdry_face_depths pure function edge_depth_wetdry ( eta_l , eta_r , b_l , b_r ) result ( hf ) !! Frozen wet/dry edge conveyance: the arithmetic-mean water depth of !! the two adjacent cells, gated to 0 by the max-eta/sill wet test. !! `!$acc routine seq` so device do-concurrent bodies can call it. !$acc routine seq real ( wp ), intent ( in ) :: eta_l , eta_r , b_l , b_r real ( wp ) :: hf if ( max ( eta_l , eta_r ) > max ( b_l , b_r )) then hf = 0.5_wp * ( max ( eta_l - b_l , 0.0_wp ) + max ( eta_r - b_r , 0.0_wp )) else hf = 0.0_wp end if end function edge_depth_wetdry subroutine si_unstr_wetdry_newton_residual ( nct , nco , eta , Jeta , mass_diag , & v_cell , rhs , res , res2_out ) !! Form the Newton nonlinear residual and its squared interior norm: !!   F_c = v_c(eta) + [T eta]_c - rhs_c, !! with the stiffness recovered matmul-free from the full mass-diag !! operator apply:  T*eta = Jeta - mass_diag*eta.  Returns sum(F&#94;2) !! over the owned cells (the Newton convergence norm — plain, not !! area-weighted, matching the prototype/structured gate; it is a !! convergence heuristic, not the CG inner product). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( nct ), Jeta ( nct ), mass_diag ( nct ) real ( wp ), intent ( in ) :: v_cell ( nct ), rhs ( nct ) real ( wp ), intent ( out ) :: res ( nct ) real ( wp ), intent ( out ) :: res2_out integer :: c real ( wp ) :: res2 do concurrent ( c = 1 : nco ) res ( c ) = v_cell ( c ) + ( Jeta ( c ) - mass_diag ( c ) * eta ( c )) - rhs ( c ) end do res2 = 0.0_wp do concurrent ( c = 1 : nco ) reduce ( + : res2 ) res2 = res2 + res ( c ) * res ( c ) end do res2_out = res2 end subroutine si_unstr_wetdry_newton_residual subroutine si_unstr_wetdry_wetcount ( nsub , nct , nco , eta , b_sub , count_out ) !! Total owned wet-sub-bottom count — the active-set fingerprint the !! Newton loop watches (frozen set + small residual = converged). !! Integer so equality is exact. integer , intent ( in ) :: nsub !! Sub-bottoms per cell. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( nct ) real ( wp ), intent ( in ) :: b_sub ( nsub , nct ) integer , intent ( out ) :: count_out integer :: c , s , cnt cnt = 0 do concurrent ( c = 1 : nco ) reduce ( + : cnt ) do s = 1 , nsub if ( eta ( c ) >= b_sub ( s , c )) cnt = cnt + 1 end do end do count_out = cnt end subroutine si_unstr_wetdry_wetcount end module rki_si_unstr_wetdry","tags":"","url":"sourcefile/rki_si_unstr_wetdry.f90.html"},{"title":"rki_mesh_gen_unstr.F90 – Rakali","text":"Native (Python-free) unstructured mesh generators. This file depends on sourcefile~~rki_mesh_gen_unstr.f90~~EfferentGraph sourcefile~rki_mesh_gen_unstr.f90 rki_mesh_gen_unstr.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_mesh_gen_unstr.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_mesh_gen_unstr.f90~~AfferentGraph sourcefile~rki_mesh_gen_unstr.f90 rki_mesh_gen_unstr.F90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_mesh_gen_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Native (Python-free) unstructured mesh generators. module rki_mesh_gen_unstr !! Naive in-Fortran triangulators for idealized domains, so the !! unstructured path can be driven end-to-end without the Python + !! meshpy/Triangle toolchain (benchmarks, idealized test cases).  The !! output (vert_x, vert_y, tri_v) feeds straight into !! `mesh_unstr_init_from_triangles`.  These are NOT a substitute for !! meshpy on real coastlines -- no boundary conformity, no !! bathymetry-driven refinement. use rki_constants , only : wp implicit none private public :: gen_regular_triangulation public :: gen_delaunay_triangulation contains subroutine gen_regular_triangulation ( nx , ny , lx , ly , vert_x , vert_y , tri_v ) !! Regular rectangular triangulation of [0,lx] x [0,ly]: an !! (nx+1) x (ny+1) vertex grid, each quad split into two CCW !! triangles (a lower (v00,v10,v01) + an upper (v10,v11,v01)). !! Yields (nx+1)(ny+1) vertices and 2*nx*ny triangles.  Vertices are !! numbered row-major (i fastest); the triangulation tiles the !! rectangle exactly with positively-oriented triangles. integer , intent ( in ) :: nx , ny !! Number of cells in x / y (>= 1). real ( wp ), intent ( in ) :: lx , ly !! Domain extents in x / y (m). real ( wp ), allocatable , intent ( out ) :: vert_x (:), vert_y (:) integer , allocatable , intent ( out ) :: tri_v (:, :) !! Triangle connectivity, shape (3, 2*nx*ny); 1-based vertex ids. integer :: nverts , ntri integer :: i , j , vid , tid integer :: v00 , v10 , v01 , v11 real ( wp ) :: dx , dy nverts = ( nx + 1 ) * ( ny + 1 ) ntri = 2 * nx * ny allocate ( vert_x ( nverts ), vert_y ( nverts )) allocate ( tri_v ( 3 , ntri )) dx = lx / real ( nx , wp ) dy = ly / real ( ny , wp ) ! Vertices: row-major, i fastest.  vid(i,j) = j*(nx+1) + i + 1. do j = 0 , ny do i = 0 , nx vid = j * ( nx + 1 ) + i + 1 vert_x ( vid ) = real ( i , wp ) * dx vert_y ( vid ) = real ( j , wp ) * dy end do end do ! Each quad -> two CCW triangles. tid = 0 do j = 0 , ny - 1 do i = 0 , nx - 1 v00 = j * ( nx + 1 ) + i + 1 ! (i,   j) v10 = j * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j) v01 = ( j + 1 ) * ( nx + 1 ) + i + 1 ! (i,   j+1) v11 = ( j + 1 ) * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j+1) tid = tid + 1 tri_v ( 1 , tid ) = v00 tri_v ( 2 , tid ) = v10 tri_v ( 3 , tid ) = v01 tid = tid + 1 tri_v ( 1 , tid ) = v10 tri_v ( 2 , tid ) = v11 tri_v ( 3 , tid ) = v01 end do end do end subroutine gen_regular_triangulation subroutine gen_delaunay_triangulation ( nx , ny , lx , ly , vert_x , vert_y , tri_v ) !! Acute-Delaunay variant of `gen_regular_triangulation` for the !! semi-implicit (TPFA) path.  The plain right-triangle split puts !! each circumcentre ON the shared hypotenuse midpoint — the two !! triangles of a quad get COINCIDENT circumcentres, `edge_delta = 0`, !! and the SI mesh-quality gate rightly rejects the mesh.  Here the !! interior vertices are jittered (deterministic hash — reproducible) !! and each quad is split along its locally-Delaunay diagonal !! (in-circle test), so circumcentres sit strictly inside the acute !! triangles and `edge_delta > 0` everywhere.  Boundary vertices stay !! ON the box so the domain is exactly rectangular for the wall BC. integer , intent ( in ) :: nx , ny !! Number of cells in x / y (>= 1). real ( wp ), intent ( in ) :: lx , ly !! Domain extents in x / y (m). real ( wp ), allocatable , intent ( out ) :: vert_x (:), vert_y (:) integer , allocatable , intent ( out ) :: tri_v (:, :) !! Triangle connectivity, shape (3, 2*nx*ny); 1-based vertex ids. real ( wp ), parameter :: JIT = 0.28_wp integer :: nverts , ntri , i , j , vid , tid integer :: v00 , v10 , v01 , v11 real ( wp ) :: dx , dy , jx , jy nverts = ( nx + 1 ) * ( ny + 1 ) ntri = 2 * nx * ny allocate ( vert_x ( nverts ), vert_y ( nverts )) allocate ( tri_v ( 3 , ntri )) dx = lx / real ( nx , wp ) dy = ly / real ( ny , wp ) do j = 0 , ny do i = 0 , nx vid = j * ( nx + 1 ) + i + 1 jx = 0.0_wp jy = 0.0_wp ! Jitter interior vertices only (keep the boundary on the box). if ( i > 0 . and . i < nx ) jx = JIT * dx * ( hash01 ( i , j , 1 ) - 0.5_wp ) if ( j > 0 . and . j < ny ) jy = JIT * dy * ( hash01 ( i , j , 2 ) - 0.5_wp ) vert_x ( vid ) = real ( i , wp ) * dx + jx vert_y ( vid ) = real ( j , wp ) * dy + jy end do end do tid = 0 do j = 0 , ny - 1 do i = 0 , nx - 1 v00 = j * ( nx + 1 ) + i + 1 ! (i,   j)   bl v10 = j * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j)   br v01 = ( j + 1 ) * ( nx + 1 ) + i + 1 ! (i,   j+1) tl v11 = ( j + 1 ) * ( nx + 1 ) + ( i + 1 ) + 1 ! (i+1, j+1) tr if ( delaunay_diag_bl_tr ( vert_x ( v00 ), vert_y ( v00 ), & vert_x ( v10 ), vert_y ( v10 ), & vert_x ( v11 ), vert_y ( v11 ), & vert_x ( v01 ), vert_y ( v01 ))) then tid = tid + 1 tri_v (:, tid ) = [ v00 , v10 , v11 ] tid = tid + 1 tri_v (:, tid ) = [ v00 , v11 , v01 ] else tid = tid + 1 tri_v (:, tid ) = [ v00 , v10 , v01 ] tid = tid + 1 tri_v (:, tid ) = [ v10 , v11 , v01 ] end if end do end do end subroutine gen_delaunay_triangulation pure function hash01 ( i , j , s ) result ( r ) !! Deterministic pseudo-random value in [0,1) from a 3-integer key. integer , intent ( in ) :: i , j , s real ( wp ) :: r integer ( kind = 8 ) :: h h = int ( i , 8 ) * 73856093_8 + int ( j , 8 ) * 19349663_8 + int ( s , 8 ) * 83492791_8 h = iand ( h , 2147483647_8 ) r = real ( modulo ( h , 100003_8 ), wp ) / 10000 3.0_wp end function hash01 pure function delaunay_diag_bl_tr ( xbl , ybl , xbr , ybr , xtr , ytr , xtl , ytl ) & result ( use_bl_tr ) !! In-circle test choosing the Delaunay diagonal of the quad !! (bl, br, tr, tl) CCW.  Returns .true. to split along bl--tr (the !! diagonal that keeps both triangles Delaunay), .false. for br--tl. real ( wp ), intent ( in ) :: xbl , ybl , xbr , ybr , xtr , ytr , xtl , ytl logical :: use_bl_tr real ( wp ) :: ax , ay , bx , by , cx , cy , incirc ax = xbl - xtl ay = ybl - ytl bx = xbr - xtl by = ybr - ytl cx = xtr - xtl cy = ytr - ytl incirc = ( ax * ax + ay * ay ) * ( bx * cy - cx * by ) & - ( bx * bx + by * by ) * ( ax * cy - cx * ay ) & + ( cx * cx + cy * cy ) * ( ax * by - bx * ay ) ! (bl,br,tr) CCW => incirc > 0 means tl is inside the circumcircle => ! flip to br--tl; else keep bl--tr. use_bl_tr = ( incirc <= 0.0_wp ) end function delaunay_diag_bl_tr end module rki_mesh_gen_unstr","tags":"","url":"sourcefile/rki_mesh_gen_unstr.f90.html"},{"title":"rki_ml_vertical_viscosity.F90 – Rakali","text":"Vertical viscosity for layer momentum. This file depends on sourcefile~~rki_ml_vertical_viscosity.f90~~EfferentGraph sourcefile~rki_ml_vertical_viscosity.f90 rki_ml_vertical_viscosity.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_vertical_viscosity.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_ml_vertical_viscosity.f90->sourcefile~rki_grid.f90 sourcefile~rki_ml_common.f90 rki_ml_common.F90 sourcefile~rki_ml_vertical_viscosity.f90->sourcefile~rki_ml_common.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_ml_vertical_viscosity.f90~~AfferentGraph sourcefile~rki_ml_vertical_viscosity.f90 rki_ml_vertical_viscosity.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_ml_vertical_viscosity.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Vertical viscosity for layer momentum. module rki_ml_vertical_viscosity !! Currently implements the gradient-Richardson-number closure of !! Pacanowski & Philander (1981).  Computes a turbulent viscosity at !! each interior interface and applies a diffusive flux to layer !! momentum: !! !!   nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg !! !! When an ocean-grade KPP closure lands, it will live alongside !! this one (e.g. `vertical/rki_ml_kpp.F90`) and the solver will !! pick between them via a config flag. use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE use rki_grid , only : hgrid_t use rki_ml_common , only : ML_MIN_DEPTH , VANISHING_LAYER_TOL implicit none private public :: ml_vertical_viscosity contains pure subroutine ml_vertical_viscosity ( h_layer , hu_layer , hv_layer , rho_layer , & rho_0 , nu_max , nu_bg , ri_alpha , & grid , nz , dt ) !! Ri-dependent vertical viscosity for momentum (Pacanowski-Philander 1981). !! Computes gradient Richardson number at each interface and applies !! turbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 !! Reference density (kg/m&#94;3) real ( wp ), intent ( in ) :: nu_max !! Maximum turbulent viscosity (m&#94;2/s) real ( wp ), intent ( in ) :: nu_bg !! Background viscosity (m&#94;2/s) real ( wp ), intent ( in ) :: ri_alpha !! Richardson number scaling coefficient real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_avg , h_k , h_k1 , u_k , v_k , u_k1 , v_k1 , h_col real ( wp ) :: du , dv , drho , Ri , denom , nu_t , flux_u , flux_v real ( wp ), parameter :: EPS = 1.0e-20_wp nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , du , dv , drho , & Ri , denom , nu_t , flux_u , flux_v , h_col ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) ! VCOORD_ZSTAR_FULL: vanishing layers (h ≈ h_min) on either ! side of the interface produce a tiny h_avg, which makes ! the diffusive flux nu_t*du/h_avg blow up.  Treat as ! no-flux instead.  VANISHING_LAYER_TOL ≥ DRY_TOLERANCE, ! so this is strictly more conservative than the legacy guard. if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( i , j , k + 1 ) / h_k1 v_k1 = hv_layer ( i , j , k + 1 ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( i , j , k ) - rho_layer ( i , j , k + 1 ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + ri_alpha * Ri nu_t = nu_max / ( denom * denom ) + nu_bg ! Limit diffusive flux: stability requires nu_t*dt/h_avg&#94;2 < 0.5 if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) then nu_t = 0.5_wp * h_avg * h_avg / dt end if flux_u = nu_t * du / h_avg * dt flux_v = nu_t * dv / h_avg * dt ! Conservative + dimensionally correct: same momentum flux ! both sides of the interface (previous h_k / h_k1 multipliers ! were dimensionally wrong and non-conservative under ! non-uniform layer thicknesses, e.g. VCOORD_ZSTAR_FULL). hu_layer ( i , j , k ) = hu_layer ( i , j , k ) + flux_u hu_layer ( i , j , k + 1 ) = hu_layer ( i , j , k + 1 ) - flux_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) + flux_v hv_layer ( i , j , k + 1 ) = hv_layer ( i , j , k + 1 ) - flux_v end if end do end if end do end subroutine ml_vertical_viscosity end module rki_ml_vertical_viscosity","tags":"","url":"sourcefile/rki_ml_vertical_viscosity.f90.html"},{"title":"rki_ml_friction_unstr.F90 – Rakali","text":"Per-layer bottom friction and Coriolis rotation on the unstructured\nmultilayer 