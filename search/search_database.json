e Intent Optional Attributes Name real(kind=wp), intent(inout) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: w (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(in) :: u_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: w0 (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine compute_vert_coefficients (dsig, nz, dt, vert_lo, vert_hi) Pre-compute vertical coupling coefficients (dsig-dependent part only) Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: dsig (nz) integer, intent(in) :: nz real(kind=wp), intent(in) :: dt real(kind=wp), intent(out) :: vert_lo (nz) real(kind=wp), intent(out) :: vert_hi (nz) public pure subroutine compute_vertical_velocity (h, u_layer, v_layer, b, dsig, w, grid, nz) Integrate continuity equation bottom-up to get vertical velocity Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public  subroutine reconcile_barotropic (h, hu, hv, u_layer, v_layer, dsig, grid, nz) Recompute barotropic momentum from corrected layer velocities Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine save_barotropic_state (hu, hv, hu_pre, hv_pre, grid) Save barotropic momentum before HLL update Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv_pre (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid public  subroutine solve_nh_pressure (h, u_layer, v_layer, w, q_nh, dsig, cg_r, cg_p, cg_Ap, cg_z, grid, nz, dt, max_iter, tol, iter_out, use_preconditioner) Conjugate Gradient solver for the NH Poisson equation Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: w (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(inout) :: q_nh (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(inout) :: cg_r (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_p (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_Ap (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_z (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt integer, intent(in) :: max_iter real(kind=wp), intent(in) :: tol integer, intent(out) :: iter_out logical, intent(in), optional :: use_preconditioner","tags":"","url":"module/rki_kernel_pressure.html"},{"title":"rki_kernel_fused_ml – Rakali","text":"Uses rki_grid rki_constants module~~rki_kernel_fused_ml~~UsesGraph module~rk