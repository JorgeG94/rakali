. Guards central-difference\noperators (BPG, divergence) against spurious gradients at dry cells. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_col column depth at (i,j) real(kind=wp), intent(in) :: h_col_ip1 column depth at (i+1,j) real(kind=wp), intent(in) :: h_col_im1 column depth at (i-1,j) real(kind=wp), intent(in) :: h_col_jp1 column depth at (i,j+1) real(kind=wp), intent(in) :: h_col_jm1 column depth at (i,j-1) Return Value logical Subroutines public pure subroutine ml_apply_layer_bcs (h_layer, hu_layer, hv_layer, h, hu, hv, dsig, grid, nz, bc_west, bc_east, bc_south, bc_north) Enforce layer consistency in ghost cells.\nCall after applying barotropic BCs and before flux computation. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz integer, intent(in), optional :: bc_west integer, intent(in), optional :: bc_east integer, intent(in), optional :: bc_south integer, intent(in), optional :: bc_north public  subroutine ml_apply_layer_bcs_full (h_layer, hu_layer, hv_layer, h, hu, hv, dsig, vcoord_z_ref_col, h_min, grid, nz) VCOORD_ZSTAR_FULL variant of ml_apply_layer_bcs . Rebuilds\nghost-cell h_layer from the per-column vcoord_z_ref_col profile\n(as the interior ml_distribute_with_remap_full ) so the layout is\nconsistent across the boundary — a sigma fallback would mismatch and\nmake CWC advection inject tracer at the wrong per-layer ratio.\nMomentum is still split by dsig(k) (ghost barotropic momentum\ncarries no internal shear). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: vcoord_z_ref_col (0:nz,grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h_min type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_apply_wind_to_surface_layer (hu_layer, hv_layer, h_layer, wind_x, wind_y, grid, nz, dt) Apply the surface wind stress to the TOP layer (k=nz) momentum only,\nso the wind is surface-concentrated and generates vertical shear that\nthe vertical mixing then spreads downward — instead of the\ndepth-uniform barotropic forcing ( apply_friction ).  tau =\n(wind_x, wind_y) in Pa; adds dt*tau/RHO_WATER to hu/hv_layer(:,:,nz).\nGated by wind_surface_layer ; the caller suppresses the barotropic\nwind so the stress is not applied twice. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public  subroutine ml_build_vcoord_zstar_full (b, vcoord_z_ref_col, grid, nz, h_surf_target, n_surf, stretching) Fill the per-column reference z-level array from the bathymetry.\nHost-side loop (runs at init / bathymetry change); updates the\ndevice copy after writing. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) Bed ELEVATION ( state%barotropic%b ): negative for submerged\ncells; negated here to the POSITIVE bed depth that zstar_full_build_column expects. real(kind=wp), intent(inout) :: vcoord_z_ref_col (0:nz,grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: h_surf_target Target surface-layer thickness (m), see zstar_full_build_column integer, intent(in) :: n_surf integer, intent(in) :: stretching public pure subroutine ml_compute_barotropic_momentum (h_layer, hu_layer, hv_layer, hu, hv, grid, nz) Compute depth-integrated momentum: hu = sum_k hu_k, hv = sum_k hv_k Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_compute_total_depth (h_layer, h, grid, nz) Compute total water depth: H = sum_k h_k Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: h (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_compute_vertical_exchange (h_layer, hu_layer, hv_layer, w, grid, nz, dt) Vertical momentum exchange using upwind advection at layer interfaces.\nTransfers momentum between adjacent layers based on diagnostic w. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_compute_vertical_velocity (h_layer, hu_layer, hv_layer, dsig, w, grid, nz) DIASURFACE (sigma-relative) vertical mass-transport velocity from\nper-layer continuity, integrated bottom-up. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_distribute_barotropic (h, hu, hv, hu_pre, hv_pre, dsig, h_layer, hu_layer, hv_layer, grid, nz) Distribute barotropic HLL acceleration to layers, preserving\nper-layer velocity anomalies (shear). h_k = dsig_k H (sigma\nconstraint); hu_k = h_k (u_k_old + du), du = (HU_new-HU_pre)/H. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) Total depth AFTER barotropic update real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) Barotropic x-momentum AFTER update real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) Barotropic y-momentum AFTER update real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) Barotropic x-momentum BEFORE update real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) Barotropic y-momentum BEFORE update real(kind=wp), intent(in) :: dsig (nz) Sigma layer fractions real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) Layer thickness (old on entry, dsig_k*H on exit) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) Layer x-momentum (updated) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) Layer y-momentum (updated) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public  subroutine ml_distribute_with_remap (h, hu, hv, hu_pre, hv_pre, coord_type, dsig, z_ref, depth_transition, blend_width, h_layer, hu_layer, hv_layer, grid, nz) Barotropic-to-layer distribution with vertical-coordinate\nreshaping — momentum + thickness only. Saves old thicknesses into remap_dz_old , sets new target h_layer via vcoord, distributes\nthe barotropic acceleration. Per-tracer remap is done separately by ml_remap_tracer (looped over the registry by the solver).\nAll array args must be device-resident under GPU offload; vcoord_t\nis NOT passed (raw arrays/scalars instead) to avoid\nallocatable-component resolution issues on the device. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) integer, intent(in) :: coord_type VCOORD_SIGMA, VCOORD_ZSIGMA, etc. real(kind=wp), intent(in) :: dsig (nz) Target sigma fractions (device-resident) real(kind=wp), intent(in) :: z_ref (0:nz) Reference z-level interfaces (device-resident) real(kind=wp), intent(in) :: depth_transition real(kind=wp), intent(in) :: blend_width real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public  subroutine ml_distribute_with_remap_full (h, hu, hv, hu_pre, hv_pre, z_ref_col, h_min, h_layer, hu_layer, hv_layer, grid, nz) VCOORD_ZSTAR_FULL variant of ml_distribute_with_remap (momentum +\nthickness only): builds per-cell dz_new via vcoord_target_dz_column_zstar_full from the per-column reference\nprofile z_ref_col(0:nz,i,j) . Per-tracer remap by ml_remap_tracer .\nShares the remap_dz_old persistent workspace. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: z_ref_col (0:nz,grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h_min real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public  subroutine ml_dynamics_workspaces_cleanup () Release the vcoord-remap persistent workspace.  Called by the\nsolver at simulation end. Arguments None public pure subroutine ml_init_layers_from_barotropic (h, hu, hv, dsig, h_layer, hu_layer, hv_layer, grid, nz) Initialise layer variables from barotropic state.\nh_k = dsig_k * H, hu_k = dsig_k * hu, hv_k = dsig_k * hv Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hv_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public  subroutine ml_remap_tracer (hTr, h, remap_method, h_layer, grid, nz) Conservatively remap ONE tracer from the saved pre-update layer\nthicknesses ( remap_dz_old ) onto the current h_layer (new vcoord\ntarget): scale dz_old to sum to H_new, column-mean fallback at\nvanishing layers, conservative remap_column . Looped over the\ntracer registry by the solver. Must run AFTER the dynamics remap\n(which writes remap_dz_old and the new h_layer ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) integer, intent(in) :: remap_method real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_rk2_average_layers (h_layer, hu_layer, hv_layer, h_layer0, hu_layer0, hv_layer0, grid, nz) SSP-RK2 averaging: U&#94;{n+1} = 0.5 (U&#94;n + U *) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_save_layer_state (h_layer, hu_layer, hv_layer, h_layer0, hu_layer0, hv_layer0, grid, nz) Save layer state for RK2 averaging Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hv_layer0 (grid%nx_total,grid