utine read_config_from_string ( text , cfg , schema ) !! In-memory sibling of [[read_config]]: build + strict-parse + !! apply a namelist held entirely in the `text` buffer (newline- !! separated), with NO filesystem touch — no temp file, no `chdir`, !! no cleanup.  Same validation + error-stop behaviour as the !! file path (the schema parser runs from the in-memory line array). character ( len =* ), intent ( in ) :: text !! Whole namelist as one string (records separated by '\\n'). type ( config_t ), target , intent ( out ) :: cfg type ( nml_schema_t ), intent ( out ), optional :: schema if ( present ( schema )) then call read_config_from_string_impl ( text , cfg , schema ) else block type ( nml_schema_t ) :: sch call read_config_from_string_impl ( text , cfg , sch ) end block end if end subroutine read_config_from_string","tags":"","url":"proc/read_config_from_string.html"},{"title":"validate_config – Rakali","text":"public  subroutine validate_config(cfg) Uses rki_recon_weno rki_ml_common_unstr proc~~validate_config~~UsesGraph proc~validate_config validate_config module~rki_ml_common_unstr rki_ml_common_unstr proc~validate_config->module~rki_ml_common_unstr module~rki_recon_weno rki_recon_weno proc~validate_config->module~rki_recon_weno module~rki_constants rki_constants module~rki_ml_common_unstr->module~rki_constants module~rki_recon_weno->module~rki_constants module~rki_grid rki_grid module~rki_recon_weno->module~rki_grid module~rki_ml_common rki_ml_common module~rki_recon_weno->module~rki_ml_common pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants module~rki_ml_common->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Validate configuration parameters after reading Logs errors for invalid values that would crash the solver,\nand warnings for suspicious but non-fatal settings. Arguments Type Intent Optional Attributes Name type( config_t ), intent(in) :: cfg Calls proc~~validate_config~~CallsGraph proc~validate_config validate_config error error proc~validate_config->error proc~bpg_nz_is_sufficient bpg_nz_is_sufficient proc~validate_config->proc~bpg_nz_is_sufficient proc~bpg_nz_required bpg_nz_required proc~validate_config->proc~bpg_nz_required proc~nz_stack_is_sufficient nz_stack_is_sufficient proc~validate_config->proc~nz_stack_is_sufficient proc~nz_stack_required nz_stack_required proc~validate_config->proc~nz_stack_required proc~parse_tracer_recon parse_tracer_recon proc~validate_config->proc~parse_tracer_recon proc~semi_implicit_grid_conflict semi_implicit_grid_conflict proc~validate_config->proc~semi_implicit_grid_conflict proc~si_bc_supported si_bc_supported proc~validate_config->proc~si_bc_supported proc~tracer_recon_required_nghost tracer_recon_required_nghost proc~validate_config->proc~tracer_recon_required_nghost proc~tracer_recon_support_status tracer_recon_support_status proc~validate_config->proc~tracer_recon_support_status proc~warn_unknown_bc warn_unknown_bc proc~validate_config->proc~warn_unknown_bc to_string to_string proc~validate_config->to_string warning warning proc~validate_config->warning proc~bpg_nz_is_sufficient->proc~bpg_nz_required proc~nz_stack_is_sufficient->proc~nz_stack_required proc~warn_unknown_bc->warning Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~validate_config~~CalledByGraph proc~validate_config validate_config proc~rki_create rki_create proc~rki_create->proc~validate_config proc~rki_create_from_string rki_create_from_string proc~rki_create_from_string->proc~validate_config proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_create proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_create_from_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: has_error Source Code subroutine validate_config ( cfg ) !! Validate configuration parameters after reading !! !! Logs errors for invalid values that would crash the solver, !! and warnings for suspicious but non-fatal settings. use rki_ml_common_unstr , only : BPG_NZ_MAX , bpg_nz_required , & bpg_nz_is_sufficient type ( config_t ), intent ( in ) :: cfg logical :: has_error has_error = . false . ! Simulation regime — this build carries the coastal path only; ! any other regime tag must fail loud, never silently fall through. if ( trim ( cfg % sim_type ) /= \"coastal\" ) then call logger % error ( \"Invalid sim_type = '\" // trim ( cfg % sim_type ) // & \"': must be 'coastal' (the only regime in this build)\" ) has_error = . true . end if ! Grid parameters if ( cfg % nx < 1 ) then call logger % error ( \"Invalid nx = \" // to_string ( cfg % nx ) // \": must be >= 1\" ) has_error = . true . end if if ( cfg % ny < 1 ) then call logger % error ( \"Invalid ny = \" // to_string ( cfg % ny ) // \": must be >= 1\" ) has_error = . true . end if if ( cfg % nghost < 1 ) then call logger % error ( \"Invalid nghost = \" // to_string ( cfg % nghost ) // \": must be >= 1\" ) has_error = . true . end if if ( cfg % dx <= 0.0_wp ) then call logger % error ( \"Invalid dx = \" // to_string ( cfg % dx ) // \": must be > 0\" ) has_error = . true . end if if ( cfg % dy <= 0.0_wp ) then call logger % error ( \"Invalid dy = \" // to_string ( cfg % dy ) // \": must be > 0\" ) has_error = . true . end if ! Time parameters if ( cfg % cfl <= 0.0_wp . or . cfg % cfl > 1.0_wp ) then call logger % error ( \"Invalid cfl = \" // to_string ( cfg % cfl ) // \": must be in (0, 1]\" ) has_error = . true . end if if ( cfg % t_end <= 0.0_wp ) then call logger % error ( \"Invalid t_end = \" // to_string ( cfg % t_end ) // \": must be > 0\" ) has_error = . true . end if ! Multilayer parameters if ( cfg % use_multilayer ) then if ( cfg % nz_layers < 1 ) then call logger % error ( \"Invalid nz_layers = \" // to_string ( cfg % nz_layers ) // & \": must be >= 1 for multilayer\" ) has_error = . true . end if if ( cfg % use_nonhydrostatic ) then call logger % error ( \"use_multilayer and use_nonhydrostatic are mutually exclusive\" ) has_error = . true . end if ! Unstructured multilayer: the per-column stack workspaces are ! sized by BPG_NZ_MAX (rki_ml_common_unstr, default 20), NOT by ! NZ_STACK_MAX.  The binding consumer (the k-eps interface ! tridiagonal) indexes plain BPG_NZ_MAX arrays at nz + 1, so ! the requirement is nz + 1 <= BPG_NZ_MAX.  Exceeding it is not ! a crash: the unstructured BPG kernels silently return (no ! baroclinic pressure gradient — plausible-looking wrong ! physics) and the unguarded column kernels silently overrun ! thread-local storage.  Refuse here, fail-loud. if ( trim ( cfg % grid_type ) == \"unstructured\" . and . & . not . bpg_nz_is_sufficient ( cfg % nz_layers )) then call logger % error ( \"Unstructured multilayer nz_layers = \" // & to_string ( cfg % nz_layers ) // \" needs BPG_NZ_MAX >= \" // & to_string ( bpg_nz_required ( cfg % nz_layers )) // & \" but this build has BPG_NZ_MAX = \" // & to_string ( BPG_NZ_MAX ) // \" (the k-eps interface \" // & \"tridiagonal indexes per-column stack arrays at \" // & \"nz + 1). Reduce nz_layers to <= \" // & to_string ( BPG_NZ_MAX - 1 ) // \" or rebuild with \" // & \"-DRAKALI_BPG_NZ_MAX=\" // & to_string ( bpg_nz_required ( cfg % nz_layers )) // \" or larger.\" ) has_error = . true . end if end if ! Per-column stack-workspace bound.  FAIL LOUD. ! ! Every layered kernel (BPG, ALE remap, the diag-remap fills) ! carries fixed-size `NZ_STACK_MAX` thread-local column arrays. ! Overrunning them corrupts thread-local storage SILENTLY — wrong ! answers, no crash — so this must refuse the run, not warn. ! ! The requirement is `nz + 1` — see `nz_stack_required`. if ( cfg % use_multilayer ) then if (. not . nz_stack_is_sufficient ( cfg % nz_layers )) then call logger % error ( \"nz_layers = \" // to_string ( cfg % nz_layers ) // & \" needs NZ_STACK_MAX >= \" // & to_string ( nz_stack_required ( cfg % nz_layers )) // & \" but this binary was compiled with NZ_STACK_MAX = \" // & to_string ( NZ_STACK_MAX ) // & \". Per-column stack kernels (BPG, ALE remap) would \" // & \"overrun thread-local storage and \" // & \"silently produce wrong answers. Rebuild with \" // & \"-DRAKALI_NZ_STACK_MAX=\" // & to_string ( nz_stack_required ( cfg % nz_layers )) // \" (or larger).\" ) has_error = . true . end if end if ! tracer_recon knob guards.  The \"is this rung supported on this ! config\" decision runs for EVERY config (fail-loud): a weno* rung is ! silently ignored by anything but the coastal multilayer solver, so ! it must abort on non-multilayer configs (2D barotropic / NH) ! rather than parse-and-drop.  The nghost / ! use_ppm_tracer quality guards apply only to the valid weno path. block use rki_recon_weno , only : parse_tracer_recon , & tracer_recon_required_nghost , & tracer_recon_support_status , & TRACER_RECON_PPM , & TRACER_RECON_OK , & TRACER_RECON_REJECT_PQM , & TRACER_RECON_REJECT_UNKNOWN , & TRACER_RECON_REJECT_OCEAN , & TRACER_RECON_REJECT_NO_ML integer :: recon_code_local , support_status recon_code_local = parse_tracer_recon ( trim ( cfg % tracer_recon )) ! Second argument is the \"is this a non-coastal regime\" flag of the ! shared predicate — always .false. here (coastal is the only regime). support_status = tracer_recon_support_status ( recon_code_local , & . false ., & cfg % use_multilayer ) select case ( support_status ) case ( TRACER_RECON_REJECT_PQM ) call logger % error ( \"tracer_recon='pqm' is deferred: dominated by \" // & \"weno5-Z under practical limiters; use weno5/7/9.\" ) has_error = . true . case ( TRACER_RECON_REJECT_UNKNOWN ) call logger % error ( \"tracer_recon='\" // trim ( cfg % tracer_recon ) // & \"' not recognised; valid: ppm, weno5, weno7, weno9\" ) has_error = . true . case ( TRACER_RECON_REJECT_OCEAN ) ! Unreachable here (the regime flag above is hard .false.); ! kept for select-case totality over the shared predicate's codes. call logger % error ( \"tracer_recon='\" // trim ( cfg % tracer_recon ) // & \"' is only supported by the coastal multilayer solver\" ) has_error = . true . case ( TRACER_RECON_REJECT_NO_ML ) call logger % error ( \"tracer_recon='\" // trim ( cfg % tracer_recon ) // & \"' requires multilayer tracers (use_multilayer=.true.)\" ) has_error = . true . case ( TRACER_RECON_OK ) ! Valid path.  For a weno rung on coastal multilayer, apply the ! multilayer-specific quality guards. if ( recon_code_local /= TRACER_RECON_PPM ) then if ( cfg % nghost < tracer_recon_required_nghost ( recon_code_local )) then call logger % error ( \"tracer_recon='\" // trim ( cfg % tracer_recon ) // & \"' requires nghost >= \" // & to_string ( tracer_recon_required_nghost ( recon_code_local )) // & \" but nghost = \" // to_string ( cfg % nghost )) has_error = . true . end if if (. not . cfg % use_ppm_tracer ) then call logger % error ( \"tracer_recon='\" // trim ( cfg % tracer_recon ) // & \"' requires use_ppm_tracer=.true.\" ) has_error = . true . end if end if case default ! Unreachable: tracer_recon_support_status returns only the ! codes above.  Fail loud if a new code is ever added unhandled. call logger % error ( \"internal error: unhandled tracer_recon support status \" // & to_string ( support_status )) has_error = . true . end select end block ! NH parameters if ( cfg % use_nonhydrostatic ) then if ( cfg % nz_layers < 1 ) then call logger % error ( \"Invalid nz_layers = \" // to_string ( cfg % nz_layers ) // & \": must be >= 1\" ) has_error = . true . end if if ( cfg % nh_tolerance <= 0.0_wp ) then call logger % error ( \"Invalid nh_tolerance = \" // to_string ( cfg % nh_tolerance ) // & \": must be > 0\" ) has_error = . true . end if if ( cfg % nh_max_iterations < 1 ) then call logger % error ( \"Invalid nh_max_iterations = \" // & to_string ( cfg % nh_max_iterations ) // \": must be >= 1\" ) has_error = . true . end if end if ! Semi-implicit free-surface mode: 2D barotropic (Phase 0/1) or 3D ! multilayer (Phase 2).  Unstructured grids only; non-hydrostatic is ! excluded. if ( cfg % semi_implicit ) then if ( semi_implicit_grid_conflict ( cfg )) then call logger % error ( \"time_scheme='semi_implicit' is only supported \" // & \"on unstructured grids (grid_type='unstructured').\" ) has_error = . true . end if if ( cfg % use_nonhydrostatic ) then call logger % error ( \"time_scheme='semi_implicit' is incompatible with \" // & \"use_nonhydrostatic=.true. (the implicit free surface \" // & \"assumes hydrostatic; NH-on-semi-implicit is deferred).\" ) has_error = . true . end if if ( cfg % dt_fixed <= 0.0_wp ) then call logger % error ( \"time_scheme='semi_implicit' requires dt_fixed > 0 \" // & \"(the semi-implicit scheme bypasses the gravity-wave CFL and takes \" // & \"the fixed step directly).\" ) has_error = . true . end if ! Every non-wall edge must be a Dirichlet-eta type the SI seed ! supports (tidal / clamped).  Any other non-wall type (open/ ! Flather, chapman, sponge, nested, inflow, discharge) fills its ! ghosts with momentum the Helmholtz operator treats as a no-flux ! wall (Hf=0) — the RHS divergence then sees flux through a \"wall\" ! with no balancing PGF: a silent mass leak.  Abort instead. if (. not . si_bc_supported ( cfg % bc_west )) then call logger % error ( \"time_scheme='semi_implicit': bc_west='\" // & trim ( cfg % bc_west ) // \"' is unsupported (only wall / tidal / \" // & \"clamped are wired into the implicit eta-solve).\" ) has_error = . true . end if if (. not . si_bc_supported ( cfg % bc_east )) then call logger % error ( \"time_scheme='semi_implicit': bc_east='\" // & trim ( cfg % bc_east ) // \"' is unsupported (only wall / tidal / \" // & \"clamped are wired into the implicit eta-solve).\" ) has_error = . true . end if if (. not . si_bc_supported ( cfg % bc_south )) then call logger % error ( \"time_scheme='semi_implicit': bc_south='\" // & trim ( cfg % bc_south ) // \"' is unsupported (only wall / tidal / \" // & \"clamped are wired into the implicit eta-solve).\" ) has_error = . true . end if if (. not . si_bc_supported ( cfg % bc_north )) then call logger % error ( \"time_scheme='semi_implicit': bc_north='\" // & trim ( cfg % bc_north ) // \"' is unsupported (only wall / tidal / \" // & \"clamped are wired into the implicit eta-solve).\" ) has_error = . true . end if ! Phase-2 (3D multilayer) scope guards — fail loud rather than ! silently drop a configured feature the SI step does not run. ! The unstructured 3D SI path (P3.2) is sigma-only / ! wall-tidal-clamped / PP81-or-closure / no-sediment. if ( cfg % use_multilayer ) then if ( cfg % nz_layers < 2 ) then call logger % error ( \"time_scheme='semi_implicit' with use_multilayer \" // & \"requires nz_layers >= 2 (the nz=1 multilayer fast path \" // & \"is not wired to the SI column solve; use the pure 2D \" // & \"barotropic SI mode instead).\" ) has_error = . true . end if ! Boundary-type support (wall / tidal / clamped only) is already ! enforced for EVERY SI config — 2D and ML alike — by the ! all-edges si_bc_supported guard above; no ML-specific re-check ! is needed (the seed/operator machinery is shared). ! k-epsilon and KPP are wired into the SI implicit column solve ! (Q1: closure fills si%nu_iface; the implicit tridiagonal + the ! implicit tracer vdiff consume it) — no guard needed for them. if ( cfg % use_sediment ) then call logger % error ( \"time_scheme='semi_implicit' with use_multilayer \" // & \"does not run the sediment settling/erosion kernels \" // & \"(Phase 2); use_sediment would be silently dropped.\" ) has_error = . true . end if if ( trim ( cfg % vcoord_type ) /= \"sigma\" ) then call logger % error ( \"time_scheme='semi_implicit' with use_multilayer \" // & \"targets vcoord_type='sigma' in Phase 2 (the remap \" // & \"vcoords need the pre-remap Lagrangian-thickness \" // & \"consistency pass, deferred).\" ) has_error = . true . end if end if ! nsub >= 2 is live via `wetdry_bsub_fill` (\"flat\" default = ! bit-identical to nsub=1; \"linear\" = the analytic Casulli 2009 ! subgrid ramp).  The LINEAR fill is incompatible with the ! multilayer wet/dry step on BOTH backends: the eta-solve conserves ! the subgrid v_cell(eta) but the ML thickness update consumes ! max(eta-b,0) on the plain bed, so mass leaks at the wet/dry ! front.  The state-init si_bsub_ml_conflict guards error-stop too; ! this is the configure-time twin. if ( cfg % si_wetdry . and . cfg % si_wetdry_nsub > 1 . and . & trim ( adjustl ( cfg % si_wetdry_bsub_fill )) == \"linear\" . and . & cfg % use_multilayer ) then call logger % error ( \"time_scheme='semi_implicit': wetdry_bsub_fill='linear' \" // & \"(nsub>=2) is not supported with use_multilayer — use \" // & \"'flat' with multilayer, or 'linear' on the 2D barotropic \" // & \"path.\" ) has_error = . true . end if end if ! `keps_si_picard > 1` is consumed only under semi_implicit + ML + ! vmix_use_keps; anywhere else it is silently inert => warn from ! top-level scope so explicit-scheme / 2D configs get feedback too ! (warning not error: default 1, harmless). if ( cfg % keps_si_picard > 1 . and . . not . ( cfg % semi_implicit . and . & cfg % use_multilayer . and . cfg % vmix_use_keps )) then call logger % warning ( \"keps_si_picard > 1 has no effect without \" // & \"time_scheme='semi_implicit' + use_multilayer + \" // & \"vmix_use_keps = .true.\" ) end if ! si_wetdry only takes effect when the semi-implicit slot allocates; ! with any other time_scheme the knob would be silently dropped. if ( cfg % si_wetdry . and . . not . cfg % semi_implicit ) then call logger % error ( \"si_wetdry=.true. requires time_scheme='semi_implicit' \" // & \"— the knob would be silently dropped (the semi-implicit \" // & \"state slot only allocates under time_scheme='semi_implicit').\" ) has_error = . true . end if ! Split ratio if ( cfg % split_ratio < 0 ) then call logger % error ( \"Invalid split_ratio = \" // to_string ( cfg % split_ratio ) // & \": must be >= 0\" ) has_error = . true . end if ! Sponge width if ( cfg % sponge_width < 0 ) then call logger % error ( \"Invalid sponge_width = \" // to_string ( cfg % sponge_width ) // & \": must be >= 0\" ) has_error = . true . end if ! Warn about unknown BC strings (they silently default to WALL) call warn_unknown_bc ( cfg % bc_west , \"bc_west\" ) call warn_unknown_bc ( cfg % bc_east , \"bc_east\" ) call warn_unknown_bc ( cfg % bc_south , \"bc_south\" ) call warn_unknown_bc ( cfg % bc_north , \"bc_north\" ) ! Warnings for suspicious settings. ! split_ratio defaults to 1 (= \"unsplit, no subcycling\"); only 0 ! (\"auto\") or values > 1 actually engage mode splitting, and they ! only matter when nonhydrostatic mode is on. if ( cfg % split_ratio /= 1 . and . . not . cfg % use_nonhydrostatic ) then call logger % warning ( \"split_ratio = \" // to_string ( cfg % split_ratio ) // & \" has no effect without use_nonhydrostatic = .true.\" ) end if if ( cfg % output_to_file . and . cfg % output_interval <= 0.0_wp ) then call logger % warning ( \"output_to_file = .true. but output_interval <= 0 — no snapshots will be written\" ) end if if ( cfg % async_output ) then call logger % warning ( \"async_output = .true. is not supported in this build\" ) end if ! ---- Evaporative latent-heat cooling (coastal multilayer) ---- ! Latent cooling only makes physical sense when the evaporated water is ! actually removed (evap_mass_sink): the sink withdraws the latent heat ! of the mass being evaporated.  With evap_mass_sink off, no water leaves ! and the cooling would be an arbitrary, unbudgeted heat loss.  Fail loud ! rather than silently no-op. if ( cfg % evap_latent_cooling . and . . not . cfg % evap_mass_sink ) then call logger % error ( \"evap_latent_cooling=.true. requires evap_mass_sink=.true. \" // & \"(latent cooling is tied to the evaporated water mass being removed)\" ) has_error = . true . end if if ( has_error ) then error stop \"Configuration validation failed — see errors above\" end if end subroutine validate_config","tags":"","url":"proc/validate_config.html"},{"title":"apply_time_unit_cascade – Rakali","text":"private  subroutine apply_time_unit_cascade(cfg) Post-parse time-unit fixup shared by the file + string config\npaths. t_end and status_interval are given\nin time_unit from &time_nml ; multiply through to SI seconds. dt_fixed / dt_max stay in seconds; default time_unit=\"s\" gives a 1× factor (bit-identical to before). Arguments Type Intent Optional Attributes Name type( config_t ), intent(inout) :: cfg Calls proc~~apply_time_unit_cascade~~CallsGraph proc~apply_time_unit_cascade apply_time_unit_cascade error error proc~apply_time_unit_cascade->error Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_time_unit_cascade~~CalledByGraph proc~apply_time_unit_cascade apply_time_unit_cascade proc~read_config_from_string_impl read_config_from_string_impl proc~read_config_from_string_impl->proc~apply_time_unit_cascade proc~read_config_impl read_config_impl proc~read_config_impl->proc~apply_time_unit_cascade proc~read_config read_config proc~read_config->proc~read_config_impl proc~read_config_from_string read_config_from_string proc~read_config_from_string->proc~read_config_from_string_impl proc~rki_create rki_create proc~rki_create->proc~read_config proc~rki_create_from_string rki_create_from_string proc~rki_create_from_string->proc~read_config_from_string proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_create proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_create_from_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: time_factor Source Code subroutine apply_time_unit_cascade ( cfg ) !! Post-parse time-unit fixup shared by the file + string config !! paths.  `t_end` and `status_interval` are given !! in `time_unit` from `&time_nml`; multiply through to SI seconds. !! `dt_fixed`/`dt_max` stay in seconds; default `time_unit=\"s\"` !! gives a 1× factor (bit-identical to before). type ( config_t ), intent ( inout ) :: cfg real ( wp ) :: time_factor select case ( trim ( cfg % time_unit )) case ( \"s\" , \"sec\" , \"second\" , \"seconds\" ) time_factor = 1.0_wp case ( \"min\" , \"minute\" , \"minutes\" ) time_factor = 6 0.0_wp case ( \"hr\" , \"hour\" , \"hours\" , \"h\" ) time_factor = 360 0.0_wp case ( \"day\" , \"days\" , \"d\" ) time_factor = 8640 0.0_wp case ( \"year\" , \"years\" , \"yr\" ) ! Julian year (365.25 d) — matches MOM6 / UDUNITS. time_factor = 36 5.25_wp * 8640 0.0_wp case default call logger % error ( \"Invalid time_unit = '\" // trim ( cfg % time_unit ) // & \"': must be one of s/min/hr/day/year\" ) time_factor = 1.0_wp ! fallthrough so validation reports it end select cfg % t_end = cfg % t_end * time_factor cfg % status_interval = cfg % status_interval * time_factor ! Derive the logical flag so downstream code never compares strings. cfg % semi_implicit = ( trim ( adjustl ( cfg % time_scheme )) == \"semi_implicit\" ) end subroutine apply_time_unit_cascade","tags":"","url":"proc/apply_time_unit_cascade.html"},{"title":"read_config_from_string_impl – Rakali","text":"private  subroutine read_config_from_string_impl(text, cfg, sch) Body of read_config_from_string — mirrors read_config_impl\nwith the line array replacing the file unit. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: text type( config_t ), intent(out), target :: cfg type( nml_schema_t ), intent(out) :: sch Calls proc~~read_config_from_string_impl~~CallsGraph proc~read_config_from_string_impl read_config_from_string_impl proc~apply_time_unit_cascade apply_time_unit_cascade proc~read_config_from_string_impl->proc~apply_time_unit_cascade proc~build_rakali_schema build_rakali_schema proc~read_config_from_string_impl->proc~build_rakali_schema proc~schema_parse_lines nml_schema_t%schema_parse_lines proc~read_config_from_string_impl->proc~schema_parse_lines proc~split_to_lines split_to_lines proc~read_config_from_string_impl->proc~split_to_lines error error proc~apply_time_unit_cascade->error proc~register_boundary register_boundary proc~build_rakali_schema->proc~register_boundary proc~register_grid register_grid proc~build_rakali_schema->proc~register_grid proc~register_initial_condition register_initial_condition proc~build_rakali_schema->proc~register_initial_condition proc~register_logging register_logging proc~build_rakali_schema->proc~register_logging proc~register_metadata register_metadata proc~build_rakali_schema->proc~register_metadata proc~register_nonhydrostatic register_nonhydrostatic proc~build_rakali_schema->proc~register_nonhydrostatic proc~register_output register_output proc~build_rakali_schema->proc~register_output proc~register_physics register_physics proc~build_rakali_schema->proc~register_physics proc~register_si register_si proc~build_rakali_schema->proc~register_si proc~r