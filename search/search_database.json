n_local) integer, private :: eta_varid integer, private :: ig integer, private :: k integer, private :: ncid integer, private :: sb_varid integer, private :: station_dimid integer, private :: sx_varid integer, private :: sy_varid integer, private :: time_dimid integer, private :: time_varid integer, private :: u_varid integer, private :: v_varid Source Code subroutine create_gauge_netcdf ( gauges , filename , mesh ) !! Create CF-1.8 station NetCDF file for gauge output. type ( gauge_unstr_t ), intent ( inout ) :: gauges character ( len =* ), intent ( in ) :: filename type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: ncid , station_dimid , time_dimid integer :: sx_varid , sy_varid , sb_varid integer :: time_varid , eta_varid , u_varid , v_varid integer :: ig , k real ( wp ) :: bed_interp ( gauges % n_local ) call nc_create_file ( trim ( filename ), ncid ) call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.8\" ) call nc_put_att_global ( ncid , \"title\" , \"Rakali unstructured gauge time series\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali\" ) call nc_def_dim ( ncid , \"station\" , gauges % n_local , station_dimid ) call nc_def_dim ( ncid , \"time\" , nf90_unlimited , time_dimid ) ! Station coordinates call rki_def_var_1d ( ncid , \"station_x\" , station_dimid , sx_varid ) call nc_put_att ( ncid , sx_varid , \"long_name\" , \"Gauge x-coordinate\" ) call nc_put_att ( ncid , sx_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"station_y\" , station_dimid , sy_varid ) call nc_put_att ( ncid , sy_varid , \"long_name\" , \"Gauge y-coordinate\" ) call nc_put_att ( ncid , sy_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"station_b\" , station_dimid , sb_varid ) call nc_put_att ( ncid , sb_varid , \"long_name\" , \"Interpolated bed elevation\" ) call nc_put_att ( ncid , sb_varid , \"units\" , \"m\" ) ! Time call rki_def_var_1d ( ncid , \"time\" , time_dimid , time_varid ) call nc_put_att ( ncid , time_varid , \"units\" , \"seconds since simulation start\" ) call nc_put_att ( ncid , time_varid , \"calendar\" , \"none\" ) call nc_put_att ( ncid , time_varid , \"axis\" , \"T\" ) ! Time-varying fields (station, time) call nc_def_var_2d ( ncid , \"eta\" , [ station_dimid , time_dimid ], eta_varid ) call nc_put_att ( ncid , eta_varid , \"long_name\" , \"Water surface elevation\" ) call nc_put_att ( ncid , eta_varid , \"units\" , \"m\" ) call nc_def_var_2d ( ncid , \"u\" , [ station_dimid , time_dimid ], u_varid ) call nc_put_att ( ncid , u_varid , \"long_name\" , \"Depth-averaged x-velocity\" ) call nc_put_att ( ncid , u_varid , \"units\" , \"m/s\" ) call nc_def_var_2d ( ncid , \"v\" , [ station_dimid , time_dimid ], v_varid ) call nc_put_att ( ncid , v_varid , \"long_name\" , \"Depth-averaged y-velocity\" ) call nc_put_att ( ncid , v_varid , \"units\" , \"m/s\" ) call nc_enddef ( ncid ) ! Write static fields call rki_put_var_1d ( ncid , sx_varid , gauges % gauge_x ) call rki_put_var_1d ( ncid , sy_varid , gauges % gauge_y ) ! Interpolate bed at gauge locations (centroid value of containing cell) do ig = 1 , gauges % n_local k = gauges % cell_id ( ig ) bed_interp ( ig ) = gauges % lam1 ( ig ) * mesh % vert_x ( 1 ) ! placeholder end do ! Actually just use the centroid bed value — simpler and consistent ! with what the solver sees do ig = 1 , gauges % n_local bed_interp ( ig ) = 0.0_wp ! will be set from state in first write end do call rki_put_var_1d ( ncid , sb_varid , bed_interp ) gauges % ncid = ncid gauges % time_varid = time_varid gauges % eta_varid = eta_varid gauges % u_varid = u_varid gauges % v_varid = v_varid gauges % time_index = 0 end subroutine create_gauge_netcdf","tags":"","url":"proc/create_gauge_netcdf.html"},{"title":"nc_check – Rakali","text":"public  subroutine nc_check(status, context) Check NetCDF return status and log error if it failed Arguments Type Intent Optional Attributes Name integer, intent(in) :: status Return code from nf90_* call character(len=*), intent(in) :: cont