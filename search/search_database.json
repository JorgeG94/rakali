tes Name real(kind=wp), intent(in) :: h (nx,ny) real(kind=wp), intent(in) :: p (nx,ny,nz) real(kind=wp), intent(out) :: Ap (nx,ny,nz) integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz integer, intent(in) :: nghost real(kind=wp), intent(in) :: inv_dx2 real(kind=wp), intent(in) :: inv_dy2 real(kind=wp), intent(in) :: vert_lo (nz) real(kind=wp), intent(in) :: vert_hi (nz) public pure subroutine apply_vertical_preconditioner (h, dsig, r, z, nx, ny, nz, nghost, dx, dy, dt) Public only for the unit-test suite (no production module imports it).\nVertical-line preconditioner: solve M*z = r per (i,j) column Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (nx,ny) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: r (nx,ny,nz) real(kind=wp), intent(out) :: z (nx,ny,nz) integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz integer, intent(in) :: nghost real(kind=wp), intent(in) :: dx real(kind=wp), intent(in) :: dy real(kind=wp), intent(in) :: dt public pure subroutine compute_depth_averaged_momentum (h, u_layer, v_layer, dsig, hu, hv, grid, nz) Compute depth-integrated momentum from per-layer velocities\nhu = h * sum(dsig_k * u_k), hv = h * sum(dsig_k * v_k) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine compute_layer_from_barotropic (h, hu, hv, hu_pre, hv_pre, u_layer, v_layer, dsig, grid, nz, dt) Distribute barotropic acceleration (hu_new - hu_pre)/h uniformly\nto all layer velocities. Arguments Type Intent Optional Attribut