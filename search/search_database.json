ate, allocatable :: station_b (:) integer, private :: station_dimid real(kind=wp), private, allocatable :: station_x (:) real(kind=wp), private, allocatable :: station_y (:) integer, private :: status integer, private :: strlen_dimid integer, private :: sx_varid integer, private :: sy_varid integer, private :: time_dimid real(kind=wp), private :: val real(kind=wp), private :: wxg real(kind=wp), private :: wyg Source Code subroutine create_gauge_netcdf ( gauges , state , cfg , rank ) !! Create the gauge output NetCDF file with dimensions and static data type ( gauge_output_t ), intent ( inout ) :: gauges !! Gauge output state type ( state_t ), intent ( in ) :: state !! Solution state (for bathymetry interpolation) type ( config_t ), intent ( in ) :: cfg !! Simulation configuration integer , intent ( in ) :: rank !! File-name rank suffix (always 0; the suffix is a leftover of the removed MPI support) character ( len = 512 ) :: filename integer :: ncid , station_dimid , time_dimid , strlen_dimid integer :: name_varid , sx_varid , sy_varid , sb_varid integer :: dimids_1d ( 1 ), dimids_2d ( 2 ), dimids_name ( 2 ) integer :: g , gi , i0 , j0 , status real ( wp ) :: wxg , wyg , val real ( wp ), allocatable :: station_x (:), station_y (:), station_b (:) character ( len = MAX_NAME_LEN ) :: padded_name ! Build filename if ( rank > 0 ) then write ( filename , \"(A,A,I6.6,A)\" ) trim ( cfg % output_dir ), & \"/gauges_rank_\" , rank , \".nc\" else filename = trim ( cfg % output_dir ) // \"/gauges.nc\" end if call nc_create_file ( trim ( filename ), ncid ) gauges % ncid = ncid ! Define dimensions call nc_def_dim ( ncid , \"station\" , gauges % n_local , station_dimid ) call nc_def_dim ( ncid , \"time\" , nf90_unlimited , time_dimid ) call nc_def_dim ( ncid , \"name_strlen\" , MAX_NAME_LEN , strlen_dimid ) ! Define time variable dimids_1d = [ time_dimid ] status = nf90_def_var ( ncid , \"time\" , nf90_double , dimids_1d , & gauges % time_varid ) call nc_check ( status , \"def_var time\" ) if ( len_trim ( cfg % reference_time ) > 0 ) then call nc_put_att ( ncid , gauges % time_varid , \"units\" , & \"seconds since \" // trim ( cfg % reference_time )) else call nc_put_att ( ncid , gauges % time_varid , \"units\" , \"seconds\" ) end if call nc_put_att ( ncid , gauges % time_varid , \"calendar\" , \"proleptic_gregorian\" ) ! Define station_name variable (name_strlen, station) dimids_name = [ strlen_dimid , station_dimid ] status = nf90_def_var ( ncid , \"station_name\" , nf90_char , dimids_name , & name_varid ) call nc_check ( status , \"def_var station_name\" ) ! Define station coordinate variables dimids_1d = [ station_dimid ] status = nf90_def_var ( ncid , \"station_x\" , nf90_double , dimids_1d , & sx_varid ) call nc_check ( status , \"def_var station_x\" ) call nc_put_att ( ncid , sx_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , sx_varid , \"long_name\" , \"gauge x-coordinate\" ) status = nf90_def_var ( ncid , \"station_y\" , nf90_double , dimids_1d , & sy_varid ) call nc_check ( status , \"def_var station_y\" ) call nc_put_att ( ncid , sy_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , sy_varid , \"long_name\" , \"gauge y-coordinate\" ) status = nf90_def_var ( ncid , \"station_b\" , nf90_double , dimids_1d , & sb_varid ) call nc_check ( status , \"def_var station_b\" ) call nc_put_att ( ncid , sb_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , sb_varid , \"long_name\" , & \"interpolated bottom elevation\" ) ! Define time-varying output variables (station, time) dimids_2d = [ station_dimid , time_dimid ] status = nf90_def_var ( ncid , \"eta\" , nf90_double , dimids_2d , & gauges % eta_varid ) call nc_check ( status , \"def_var eta\" ) call nc_put_att ( ncid , gauges % eta_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , gauges % eta_varid , \"long_name\" , & \"water surface elevation\" ) status = nf90_def_var ( ncid , \"u\" , nf90_double , dimids_2d , & gauges % u_varid ) call nc_check ( status , \"def_var u\" ) call nc_put_att ( ncid , gauges % u_varid , \"units\" , \"m/s\" ) call nc_put_att ( ncid , gauges % u_varid , \"long_name\" , & \"depth-averaged x-velocity\" ) status = nf90_def_var ( ncid , \"v\" , nf90_double , dimids_2d , & gauges % v_varid ) call nc_check ( status , \"def_var v\" ) call nc_put_att ( ncid , gauges % v_varid , \"units\" , \"m/s\" ) call nc_put_att ( ncid , gauges % v_varid , \"long_name\" , & \"depth-averaged y-velocity\" ) ! Global attributes call nc_put_att_global ( ncid , \"title\" , \"Rakali gauge time series\" ) call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.8\" ) if ( len_trim ( cfg % institution ) > 0 ) then call nc_put_att_global ( ncid , \"institution\" , trim ( cfg % institution )) end if ! End define mode status = nf90_enddef ( ncid ) call nc_check ( status , \"enddef gauges\" ) ! Write static data: station names, coordinates, interpolated bathymetry allocate ( station_x ( gauges % n_local )) allocate ( station_y ( gauges % n_local )) allocate ( station_b ( gauges % n_local )) do g = 1 , gauges % n_local gi = gauges % local_idx ( g ) station_x ( g ) = gauges % gauge_x ( gi ) station_y ( g ) = gauges % gauge_y ( gi ) ! Write station name as fixed-length padded string padded_name = gauges % names ( gi ) status = nf90_put_var ( ncid , name_varid , trim ( padded_name ), & start = [ 1 , g ], count = [ len_trim ( padded_name ), 1 ]) call nc_check ( status , \"put_var station_name\" ) ! Interpolate bathymetry at gauge location i0 = gauges % ix0 ( g ) j0 = gauges % iy0 ( g ) wxg = gauges % wx ( g ) wyg = gauges % wy ( g ) station_b ( g ) = ( 1.0_wp - wxg ) * ( 1.0_wp - wyg ) * state % barotropic % b ( i0 , j0 ) & + wxg * ( 1.0_wp - wyg ) * state % barotropic % b ( i0 + 1 , j0 ) & + ( 1.0_wp - wxg ) * wyg * state % barotropic % b ( i0 , j0 + 1 ) & + wxg * wyg * state % barotropic % b ( i0 + 1 , j0 + 1 ) end do status = nf90_put_var ( ncid , sx_varid , station_x ) call nc_check ( status , \"put_var station_x\" ) status = nf90_put_var ( ncid , sy_varid , station_y ) call nc_check ( status , \"put_var station_y\" ) status = nf90_put_var ( ncid , sb_varid , station_b ) call nc_check ( status , \"put_var station_b\" ) deallocate ( station_x , station_y , station_b ) status = nf90_sync ( ncid ) call nc_check ( status , \"sync gauges init\" ) call logger % info ( \"Gauges: created \" // trim ( filename )) end subroutine create_gauge_netcdf","tags":"","url":"proc/create_gauge_netcdf~2.html"},{"title":"read_gauge_file – Rakali","text":"private  subroutine read_gauge_file(filename, names, gauge_x, gauge_y, n_gauges) Parse a gauge locations text file Format: one gauge per line, name  x  y .  Lines starting with # or blank lines are skipped. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to gauge locations file character(len=MAX_NAME_LEN), intent(out), allocatable :: names (:) Gauge names real(kind=wp), intent(out), allocatable :: gauge_x (:) Gauge x-coordinates (m) real(kind=wp), intent(out), allocatable :: gauge_y (:) Gauge y-coordinates (m) integer, intent(out) :: n_gauges Number of gauges read Calls proc~~read_gauge_file~~CallsGraph proc~read_gauge_file read_gauge_file error error proc~read_gauge_file->error info info proc~read_gauge_file->info to_string to_string proc~read_gauge_file->to_string warning warning proc~read_gauge_file->warning Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~read_gauge_file~~CalledByGraph proc~read_gauge_file read_gauge_file proc~gauges_init gauges_init proc~gauges_init->proc~read_gauge_file proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~gauges_init proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: file_exists integer, private :: ios character(len=256), private :: ios_msg integer, private :: iunit character(len=MAX_LINE_LEN), private :: line integer, private :: n character(len=MAX_NAME_LEN), private :: tmp_names (MAX_GAUGES) real(kind=wp), private :: tmp_x (MAX_GAUGES) real(kind=wp), private :: tmp_y (MAX_GAUGES) Source Code subroutine read_gauge_file ( filename , names , gauge_x , gauge_y , n_gauges ) !! Parse a gauge locations text file !! !! Format: one gauge per line, ``name  x  y``.  Lines starting with !! ``#`` or blank lines are skipped. character ( len =* ), intent ( in ) :: filename !! Path to gauge locations file character ( len = MAX_NAME_LEN ), allocatable , intent ( out ) :: names (:) !! Gauge names real ( wp ), allocatable , intent ( out ) :: gauge_x (:) !! Gauge x-coordinates (m) real ( wp ), allocatable , intent ( out ) :: gauge_y (:) !! Gauge y-coordinates (m) integer , intent ( out ) :: n_gauges !! Number of gauges read character ( len = MAX_LINE_LEN ) :: line character ( len = MAX_NAME_LEN ) :: tmp_names ( MAX_GAUGES ) real ( wp ) :: tmp_x ( MAX_GAUGES ), tmp_y ( MAX_GAUGES ) integer :: iunit , ios , n character ( len = 256 ) :: ios_msg logical :: file_exists n_gauges = 0 inquire ( file = trim ( filename ), exist = file_exists ) if (. not . file_exists ) then call logger % error ( \"Gauges: file not found: \" // trim ( filename )) return end if open ( newunit = iunit , file = trim ( filename ), status = \"old\" , action = \"read\" , & iostat = ios , iomsg = ios_msg ) if ( ios /= 0 ) then call logger % error ( \"Gauges: cannot open file \" // trim ( filename ) // & \": \" // trim ( ios_msg )) return end if n = 0 do read ( iunit , \"(A)\" , iostat = ios , iomsg = ios_msg ) line if ( ios /= 0 ) exit ! Skip comments and blank lines line = adjustl ( line ) if ( len_trim ( line ) == 0 ) cycle if ( line ( 1 : 1 ) == \"#\" ) cycle n = n + 1 if ( n > MAX_GAUGES ) then call logger % warning ( \"Gauges: maximum of \" // & trim ( to_string ( MAX_GAUGES )) // & \" gauges exceeded, ignoring remainder\" ) n = MAX_GAUGES exit end if read ( line , * , iostat = ios , iomsg = ios_msg ) tmp_names ( n ), tmp_x ( n ), tmp_y ( n ) if ( ios /= 0 ) then call logger % warning ( \"Gauges: skipping malformed line: \" // & trim ( line ) // \" (\" // trim ( ios_msg ) // \")\" ) n = n - 1 cycle end if end do close ( iunit ) n_gauges = n allocate ( names ( n ), gauge_x ( n ), gauge_y ( n )) names ( 1 : n ) = tmp_names ( 1 : n ) gauge_x ( 1 : n ) = tmp_x ( 1 : n ) gauge_y ( 1 : n ) = tmp_y ( 1 : n ) call logger % info ( \"Gauges: read \" // trim ( to_string ( n_gauges )) // & \" gauge locations from \" // trim ( filename )) end subroutine read_gauge_file","tags":"","url":"proc/read_gauge_file.html"},{"title":"ml_vertical_viscosity_unstr – Rakali","text":"public pure subroutine ml_vertical_viscosity_unstr(state, dt) Ri-dependent vertical viscosity for momentum.\nComputes gradient Richardson number at each interface and applies\nturbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. Column-local — no neighbour access, safe for do concurrent . Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt Calls proc~~ml_vertical_viscosity_unstr~~CallsGraph proc~ml_vertical_viscosity_unstr ml_vertical_viscosity_unstr local local proc~ml_vertical_viscosity_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_vertical_viscosity_unstr~~CalledByGraph proc~ml_vertical_viscosity_unstr ml_vertical_viscosity_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_vertical_viscosity_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: EPS = 1.0e-20_wp real(kind=wp), private :: Ri integer, private :: cell real(kind=wp), private :: denom real(kind=wp), private :: drho real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: flux_u real(kind=wp), private :: flux_u_iface (BPG_NZ_MAX) real(kind=wp), private :: flux_v real(kind=wp), private :: flux_v_iface (BPG_NZ_MAX) real(kind=wp), private :: h_avg real(kind=wp), private :: h_k real(kind=wp), private :: h_k1 integer, private :: k integer, private :: n real(kind=wp), private :: nu_t integer, private :: nz real(kind=wp), private :: u_k real(kind=wp), private :: u_k1 real(kind=wp), private :: v_k real(kind=wp), private :: v_k1 Source Code pure subroutine ml_vertical_viscosity_unstr ( state , dt ) !! Ri-dependent vertical viscosity for momentum. !! Computes gradient Richardson number at each interface and applies !! turbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. !! !! Column-local — no neighbour access, safe for `do concurrent`. type ( unstr_state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: dt integer :: cell , k , nz , n real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 real ( wp ) :: du , dv , drho , Ri , denom , nu_t , flux_u , flux_v real ( wp ) :: flux_u_iface ( BPG_NZ_MAX ), flux_v_iface ( BPG_NZ_MAX ) real ( wp ), parameter :: EPS = 1.0e-20_wp if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = state % ncells_owned if ( nz < 2 ) return do concurrent ( cell = 1 : n ) & local ( k , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , & du , dv , drho , Ri , denom , nu_t , flux_u , flux_v , & flux_u_iface , flux_v_iface ) if ( state % barotropic % height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle ! Pass 1: compute interface fluxes do k = 1 , nz - 1 h_k = state % multilayer % h_layer ( k , cell ) h_k1 = state % multilayer % h_layer ( k + 1 , cell ) h_avg = 0.5_wp * ( h_k + h_k1 ) flux_u_iface ( k ) = 0.0_wp flux_v_iface ( k ) = 0.0_wp ! VCOORD_ZSTAR_FULL: no-flux through interfaces adjacent to ! vanishing layers (otherwise nu_t * du / h_avg blows up ! when h_avg = h_min / 2). if ( h_avg > VANISHING_LAYER_TOL_UNSTR . and . & h_k > VANISHING_LAYER_TOL_UNSTR . and . & h_k1 > VANISHING_LAYER_TOL_UNSTR ) then if ( h_k > DRY_TOLERANCE ) then u_k = state % multilayer % hu_layer ( k , cell ) / h_k v_k = state % multilayer % hv_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = state % multilayer % hu_layer ( k + 1 , cell ) / h_k1 v_k1 = state % multilayer % hv_layer ( k + 1 , cell ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = state % multilayer % rho_layer ( k , cell ) - state % multilayer % rho_layer ( k + 1 , cell ) Ri = GRAVITY * ( drho / state % multilayer % rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + state % multilayer % vmix_ri_alpha * Ri nu_t = state % multilayer % vmix_nu_max / ( denom * denom ) + state % multilayer % vmix_nu_bg ! Stability: nu_t * dt / h_avg&#94;2 <= 0.5 if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) then nu_t = 0.5_wp * h_avg * h_avg / dt end if flux_u_iface ( k ) = nu_t * du / h_avg * dt flux_v_iface ( k ) = nu_t * dv / h_avg * dt end if end do ! Pass 2: apply fluxes to layers.  flux_*_iface(k) is the momentum ! transfer across interface k+1/2 (units m&#94;2/s); same quantity adds ! to layer k and subtracts from layer k+1.  Previous h_layer ! multipliers were dimensionally wrong and non-conservative under ! non-uniform dz (e.g. VCOORD_ZSTAR_FULL). state % multilayer % hu_layer ( 1 , cell ) = state % multilayer % hu_layer ( 1 , cell ) & + flux_u_iface ( 1 ) state % multilayer % hv_layer ( 1 , cell ) = state % multilayer % hv_layer ( 1 , cell ) & + flux_v_iface ( 1 ) do k = 2 , nz - 1 state % multilayer % hu_layer ( k , cell ) = state % multilayer % hu_layer ( k , cell ) & + ( flux_u_iface ( k ) - flux_u_iface ( k - 1 )) state % multilayer % hv_layer ( k , cell ) = state % multilayer % hv_layer ( k , cell ) & + ( flux_v_iface ( k ) - flux_v_iface ( k - 1 )) end do state % multilayer % hu_layer ( nz , cell ) = state % multilayer % hu_layer ( nz , cell ) & - flux_u_iface ( nz - 1 ) state % multilayer % hv_layer ( nz , cell ) = state % multilayer % hv_layer ( nz , cell ) & - flux_v_iface ( nz - 1 ) end do end subroutine ml_vertical_viscosity_unstr","tags":"","url":"proc/ml_vertical_viscosity_unstr.html"},{"title":"apply_baro_nh_tendency – Rakali","text":"public pure subroutine apply_baro_nh_tendency(hu, hv, h, tend_x, tend_y, grid, dt) Add NH barotropic tendency as forcing during barotropic subcycling hu += dt * h * tend_x\nhv += dt * h * tend_y Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: tend_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: tend_y (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt Called by proc~~apply_baro_nh_tendency~~CalledByGraph proc~apply_baro_nh_tendency apply_baro_nh_tendency proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~apply_baro_nh_tendency proc~solver_s