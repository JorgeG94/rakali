area; 0 on a dry / NaN-guarded\ncell (the additive identity, so it drops out of the KE sum). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h real(kind=wp), intent(in) :: hu real(kind=wp), intent(in) :: hv real(kind=wp), intent(in) :: area Return Value real(kind=wp) Called by proc~~ke_cell~~CalledByGraph proc~ke_cell ke_cell proc~reduce_barotropic reduce_barotropic proc~reduce_barotropic->proc~ke_cell proc~reduce_multilayer reduce_multilayer proc~reduce_multilayer->proc~ke_cell proc~coastal_reduce_stats coastal_reduce_stats proc~coastal_reduce_stats->proc~reduce_barotropic proc~coastal_reduce_stats->proc~reduce_multilayer proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~coastal_reduce_stats proc~coastal_max_cfl coastal_max_cfl proc~coastal_max_cfl->proc~coastal_reduce_stats proc~coastal_total_ke coastal_total_ke proc~coastal_total_ke->proc~coastal_reduce_stats proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function ke_cell ( h , hu , hv , area ) result ( v ) !! Per-cell kinetic energy 0.5·(hu²+hv²)/h·area; 0 on a dry / NaN-guarded !! cell (the additive identity, so it drops out of the KE sum). !$acc routine seq real ( wp ), intent ( in ) :: h , hu , hv , area real ( wp ) :: v if ( h > 0.0_wp . and . h < 1.0e6_wp ) then v = 0.5_wp * ( hu * hu + hv * hv ) / h * area else v = 0.0_wp end if end function ke_cell","tags":"","url":"proc/ke_cell.html"},{"title":"coastal_console_stats_report – Rakali","text":"public  subroutine coastal_console_stats_report(this, s, dt, t, step) Reduce the coastal totals and print the shared MOM6-style block. this latches the t=0 reference\non the first call (see rki_console_stats ). Arguments Type Intent Optional Attributes Name type( console_stats_t ), intent(inout) :: this type( state_t ), intent(inout) :: s real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: t integer, intent(in) :: step Calls proc~~coastal_console_stats_report~~CallsGraph proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_reduce_stats coastal_reduce_stats proc~coastal_console_stats_report->proc~coastal_reduce_stats proc~compute_layer_sums compute_layer_sums proc~coastal_console_stats_report->proc~compute_layer_sums proc~compute_total_mass compute_total_mass proc~coastal_console_stats_report->proc~compute_total_mass proc~console_stats_report console_stats_report proc~coastal_console_stats_report->proc~console_stats_report proc~reduce_barotropic reduce_barotropic proc~coastal_reduce_stats->proc~reduce_barotropic proc~reduce_multilayer reduce_multilayer proc~coastal_reduce_stats->proc~reduce_multilayer proc~compute_layer_sums_impl compute_layer_sums_impl proc~compute_layer_sums->proc~compute_layer_sums_impl local local proc~compute_total_mass->local reduce reduce proc~compute_total_mass->reduce error error proc~console_stats_report->error info info proc~console_stats_report->info proc~any_nan any_nan proc~console_stats_report->proc~any_nan proc~efp_real_diff efp_real_diff proc~console_stats_report->proc~efp_real_diff proc~emit_drift_line emit_drift_line proc~console_stats_report->proc~emit_drift_line to_string to_string proc~console_stats_report->to_string proc~compute_layer_sums_impl->local proc~compute_layer_sums_impl->reduce proc~efp_minus efp_minus proc~efp_real_diff->proc~efp_minus proc~efp_to_real efp_to_real proc~efp_real_diff->proc~efp_to_real proc~emit_drift_line->info proc~relative_drift relative_drift proc~emit_drift_line->proc~relative_drift proc~reduce_barotropic->reduce proc~cfl_cell cfl_cell proc~reduce_barotropic->proc~cfl_cell proc~interior_bounds interior_bounds proc~reduce_barotropic->proc~interior_bounds proc~ke_cell ke_cell proc~reduce_barotropic->proc~ke_cell proc~reduce_multilayer->reduce proc~reduce_multilayer->proc~cfl_cell proc~reduce_multilayer->proc~interior_bounds proc~reduce_multilayer->proc~ke_cell proc~efp_regularize efp_regularize proc~efp_minus->proc~efp_regularize proc~efp_to_real->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~coastal_console_stats_report~~CalledByGraph proc~coastal_console_stats_report coastal_console_stats_report proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial type( conservation_budget_t ), private :: bud real(kind=wp), private :: cell_area logical, private :: has_st real(kind=wp), private :: max_cfl real(kind=wp), private :: mean_S real(kind=wp), private :: mean_T real(kind=wp), private :: sum_h real(kind=wp), private :: sum_hS real(kind=wp), private :: sum_hT real(kind=wp), private :: total_heat real(kind=wp), private :: total_ke real(kind=wp), private :: total_mass real(kind=wp), private :: total_salt Source Code subroutine coastal_console_stats_report ( this , s , dt , t , step ) !! Reduce the coastal totals and print the shared MOM6-style block. !! `this` latches the t=0 reference !! on the first call (see `rki_console_stats`). type ( console_stats_t ), intent ( inout ) :: this type ( state_t ), intent ( inout ) :: s real ( wp ), intent ( in ) :: dt , t integer , intent ( in ) :: step real ( wp ) :: total_mass , total_ke , max_cfl , cell_area real ( wp ) :: sum_h , sum_hS , sum_hT , mean_S , mean_T , total_salt , total_heat logical :: has_st type ( conservation_budget_t ) :: bud cell_area = s % grid % dx * s % grid % dy has_st = s % use_multilayer total_mass = compute_total_mass ( s ) ! One fused device sweep returns both the KE sum and the max CFL. call coastal_reduce_stats ( s , dt , total_ke , max_cfl ) ! Mass conservation budget: cumulative volume out through the domain ! boundaries (accumulated per RK stage in the solver from the flux ! divergence) + cumulative volume added by surface sources (precip, ! evap, sponge h-relaxation).  Both terms must be tracked for the ! closed budget to be valid; if either is absent, fall back to raw ! drift (mass_active=.false.). bud % mass_out = s % barotropic % mass_out bud % mass_src = s % barotropic % mass_src bud % mass_active = s % barotropic % mass_out_tracked & . and . s % barotropic % mass_src_tracked sum_h = 0.0_wp sum_hS = 0.0_wp sum_hT = 0.0_wp if ( s % use_multilayer ) call compute_layer_sums ( s , sum_h , sum_hS , sum_hT ) if ( s % use_multilayer . and . sum_h > 0.0_wp ) then mean_S = sum_hS / sum_h mean_T = sum_hT / sum_h else mean_S = 0.0_wp mean_T = 0.0_wp end if ! Column-integrated salt / heat for the drift block (area-weighted so ! the absolute figure is Σ hS·dx·dy; the Error ratio is scale-free). total_salt = sum_hS * cell_area total_heat = sum_hT * cell_area call console_stats_report ( this , t , step , total_mass , total_ke , & mean_S , mean_T , max_cfl , total_salt , total_heat , & has_salt = has_st , has_temp = has_st , & mean_age = 0.0_wp , has_age = . false ., budget = bud ) end subroutine coastal_console_stats_report","tags":"","url":"proc/coastal_console_stats_report.html"},{"title":"coastal_reduce_stats – Rakali","text":"private  subroutine coastal_reduce_stats(s, dt, ke, mcfl) Fused KE-sum + max-CFL reduction, dispatched on the layer mode. Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s real(kind=wp), intent(in) :: dt real(kind=wp), intent(out) :: ke real(kind=wp), intent(out) :: mcfl Calls proc~~coastal_reduce_stats~~CallsGraph proc~coastal_reduce_stats coastal_reduce_stats proc~reduce_barotropic reduce_barotropic proc~coastal_reduce_stats->proc~reduce_barotropic proc~reduce_multilayer reduce_multilayer proc~coastal_reduce_stats->proc~reduce_mul