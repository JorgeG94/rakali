odule. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: a_l real(kind=wp), private :: a_r real(kind=wp), private :: denom real(kind=wp), private :: fl_h real(kind=wp), private :: fl_hu real(kind=wp), private :: fl_hv real(kind=wp), private :: fr_h real(kind=wp), private :: fr_hu real(kind=wp), private :: fr_hv real(kind=wp), private :: s_l real(kind=wp), private :: s_r real(kind=wp), private :: u_l real(kind=wp), private :: u_r real(kind=wp), private :: v_l real(kind=wp), private :: v_r Source Code pure subroutine hll_flux_x ( h_l , hu_l , hv_l , h_r , hu_r , hv_r , & f_h , f_hu , f_hv ) !! HLL numerical flux in x-direction between left and right states real ( wp ), intent ( in ) :: h_l , hu_l , hv_l real ( wp ), intent ( in ) :: h_r , hu_r , hv_r real ( wp ), intent ( out ) :: f_h , f_hu , f_hv real ( wp ) :: u_l , u_r , v_l , v_r , a_l , a_r real ( wp ) :: s_l , s_r , denom real ( wp ) :: fl_h , fl_hu , fl_hv real ( wp ) :: fr_h , fr_hu , fr_hv if ( h_l > DRY_TOLERANCE ) then u_l = hu_l / h_l v_l = hv_l / h_l else u_l = 0.0_wp v_l = 0.0_wp end if if ( h_r > DRY_TOLERANCE ) then u_r = hu_r / h_r v_r = hv_r / h_r else u_r = 0.0_wp v_r = 0.0_wp end if a_l = sqrt ( GRAVITY * max ( h_l , 0.0_wp )) a_r = sqrt ( GRAVITY * max ( h_r , 0.0_wp )) ! Wave-speed estimate.  Davis (min/max of the one-sided speeds) is right ! for a genuine two-sided WET Riemann problem, but wrong at a wet/dry ! front and must be replaced there. ! ! With the right state dry, `a_R = 0` and `u_R = 0`, so Davis returns ! `s_r = u_L + a_L`.  The exact dry-front speed is `u_L + 2 a_L` — the ! Ritter (1892) result — so Davis underestimates the right-going wave by ! up to a factor of two and the front cannot advance at the right rate. ! The dry-state speeds below are the standard fix (Toro, \"Riemann ! Solvers and Numerical Methods for Fluid Dynamics\", 3rd ed. S10.4; ! Einfeldt et al. 1991). ! ! Measured consequence before this branch existed: the Ritter dry-bed ! tip advanced at 1.49 c0 rather than 2 c0, the leading tongue below ! ~1 % of the upstream depth was absent, and on a sloping beach a thin ! film would not recede at all (validation phases 4 and 5). if ( h_r <= DRY_TOLERANCE ) then ! Dry on the RIGHT: the right-going wave IS the dry front. s_l = u_l - a_l s_r = u_l + 2.0_wp * a_l else if ( h_l <= DRY_TOLERANCE ) then ! Dry on the LEFT: mirror image. s_l = u_r - 2.0_wp * a_r s_r = u_r + a_r else s_l = min ( u_l - a_l , u_r - a_r ) s_r = max ( u_l + a_l , u_r + a_r ) end if fl_h = hu_l fl_hu = hu_l * u_l + 0.5_wp * GRAVITY * h_l * h_l fl_hv = hu_l * v_l fr_h = hu_r fr_hu = hu_r * u_r + 0.5_wp * GRAVITY * h_r * h_r fr_hv = hu_r * v_r if ( s_l >= 0.0_wp ) then f_h = fl_h f_hu = fl_hu f_hv = fl_hv else if ( s_r <= 0.0_wp ) then f_h = fr_h f_hu = fr_hu f_hv = fr_hv else denom = 1.0_wp / ( s_r - s_l ) f_h = ( s_r * fl_h - s_l * fr_h & + s_l * s_r * ( h_r - h_l )) * denom f_hu = ( s_r * fl_hu - s_l * fr_hu & + s_l * s_r * ( hu_r - hu_l )) * denom f_hv = ( s_r * fl_hv - s_l * fr_hv & + s_l * s_r * ( hv_r - hv_l )) * denom end if end subroutine hll_flux_x","tags":"","url":"proc/hll_flux_x.html"},{"title":"hll_flux_y – Rakali","text":"private pure subroutine hll_flux_y(h_b, hu_b, hv_b, h_t, hu_t, hv_t, g_h, g_hu, g_hv) HLL numerical flux in y-direction between bottom and top states Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_b real(kind=wp), intent(in) :: hu_b real(kind=wp), intent(in) :: hv_b real(kind=wp), intent(in) :: h_t real(kind=wp), intent(in) :: hu_t real(kind=wp), intent(in) :: hv_t real(kind=wp), intent(out) :: g_h real(kind=wp), intent(out) :: g_hu real(kind=wp), intent(out) :: g_hv Called by proc~~hll_flux_y~~CalledByGraph proc~hll_flux_y hll_flux_y proc~flux_cell flux_cell proc~flux_cell->proc~hll_flux_y proc~compute_flux_hll compute_flux_hll proc~compute_flux_hll->proc~flu