d % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: area , dt , idx , idy real ( wp ), intent ( out ) :: ke , mcfl integer :: i , j , k , i_lo , i_hi , j_lo , j_hi real ( wp ) :: ke_acc , cfl_acc call interior_bounds ( grid , i_lo , i_hi , j_lo , j_hi ) ke_acc = 0.0_wp cfl_acc = 0.0_wp do concurrent ( k = 1 : nz , j = j_lo : j_hi , i = i_lo : i_hi ) reduce ( + : ke_acc ) reduce ( max : cfl_acc ) ke_acc = ke_acc + ke_cell ( h_layer ( i , j , k ), hu_layer ( i , j , k ), & hv_layer ( i , j , k ), area ) cfl_acc = max ( cfl_acc , cfl_cell ( h_layer ( i , j , k ), hu_layer ( i , j , k ), & hv_layer ( i , j , k ), dt , idx , idy )) end do ke = ke_acc mcfl = cfl_acc end subroutine reduce_multilayer","tags":"","url":"proc/reduce_multilayer.html"},{"title":"solver_unstr_advance – Rakali","text":"public  subroutine solver_unstr_advance(state, mesh, t_end) Step until state%time >= t_end . Recomputes the CFL-limited\ntimestep from the per-cell wave speeds before each step using compute_timestep_unstr . NOTE: the very first step needs state%barotropic%max_speed to be\npopulated, which only happens after a flux pass. We bootstrap\nby running extrapolate + flux once before the loop starts so\nthe CFL kernel has something to read. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(inout) :: mesh real(kind=wp), intent(in) :: t_end Calls proc~~solver_unstr_advance~~CallsGraph proc~solver_unstr_advance solver_unstr_advance proc~compute_fluxes_central_unstr compute_fluxes_central_unstr proc~solver_unstr_advance->proc~compute_fluxes_central_unstr proc~compute_timestep_unstr compute_timestep_unstr proc~solver_unstr_advance->proc~compute_timestep_unstr proc~extrapolate_second_order_edge_unstr extrapolate_second_order_edge_unstr proc~solver_u