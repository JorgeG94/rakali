d integer, private :: n integer, private :: ncid integer, private :: stage_varid integer, private :: xmom_varid integer, private :: ymom_varid Source Code subroutine restart_write_unstr ( filename , state , mesh , time ) !! Write a checkpoint file. Caller must ensure state is on host. character ( len =* ), intent ( in ) :: filename type ( unstr_state_t ), intent ( in ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: time integer :: ncid , face_dimid integer :: stage_varid , xmom_varid , ymom_varid , bed_varid integer :: cgid_varid integer :: n n = mesh % ncells_owned call nc_create_file ( trim ( filename ), ncid ) ! Global attributes call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.11\" ) call nc_put_att_global ( ncid , \"title\" , \"Rakali unstructured restart\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali\" ) call nc_put_att_global_int ( ncid , \"ncells_owned\" , n ) call nc_put_att_global_int ( ncid , \"step_count\" , state % step_count ) call nc_check ( nf90_put_att ( ncid , nf90_global , \"time\" , time ), & \"writing time attribute\" ) ! Dimension call nc_def_dim ( ncid , \"face\" , n , face_dimid ) ! Solution fields call rki_def_var_1d ( ncid , \"stage\" , face_dimid , stage_varid ) call nc_put_att ( ncid , stage_varid , \"long_name\" , \"Free-surface elevation\" ) call nc_put_att ( ncid , stage_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"xmom\" , face_dimid , xmom_varid ) call nc_put_att ( ncid , xmom_varid , \"long_name\" , \"x-momentum (h*u)\" ) call nc_put_att ( ncid , xmom_varid , \"units\" , \"m2/s\" ) call rki_def_var_1d ( ncid , \"ymom\" , face_dimid , ymom_varid ) call nc_put_att ( ncid , ymom_varid , \"long_name\" , \"y-momentum (h*v)\" ) call nc_put_att ( ncid , ymom_varid , \"units\" , \"m2/s\" ) call rki_def_var_1d ( ncid , \"bed\" , face_dimid , bed_varid ) call nc_put_att ( ncid , bed_varid , \"long_name\" , \"Bed elevation\" ) call nc_put_att ( ncid , bed_varid , \"units\" , \"m\" ) if ( allocated ( mesh % cell_global_id )) then call nc_check ( nf90_def_var ( ncid , \"cell_global_id\" , nf90_int64 , & [ face_dimid ], cgid_varid ), & \"defining cell_global_id\" ) end if call nc_enddef ( ncid ) ! Write data call rki_put_var_1d ( ncid , stage_varid , state % barotropic % stage_cv ( 1 : n )) call rki_put_var_1d ( ncid , xmom_varid , state % barotropic % xmom_cv ( 1 : n )) call rki_put_var_1d ( ncid , ymom_varid , state % barotropic % ymom_cv ( 1 : n )) call rki_put_var_1d ( ncid , bed_varid , state % barotropic % bed_cv ( 1 : n )) if ( allocated ( mesh % cell_global_id )) then call nc_check ( nf90_put_var ( ncid , cgid_varid , & mesh % cell_global_id ( 1 : n )), & \"writing cell_global_id\" ) end if call nc_close ( ncid ) call logger % info ( \"Restart written: \" // trim ( filename ) // & \" (t = \" // to_string ( time ) // \" s, \" // & to_string ( n ) // \" cells)\" ) end subroutine restart_write_unstr","tags":"","url":"proc/restart_write_unstr.html"},{"title":"surface_forcing_bytes – Rakali","text":"private pure function surface_forcing_bytes(this) result(nbytes) Counted allocatable footprint of the surface-forcing slot. Type Bound surface_forcing_t Arguments Type Intent Optional Attributes Name class( surface_forcing_t ), intent(in) :: this Return Value integer(kind=int64) Calls proc~~surface_forcing_bytes~~CallsGraph proc~surface_forcing_bytes surface_forcing_t%surface_forcing_bytes interface~arr_bytes arr_bytes proc~surface_forcing_bytes->interface~arr_bytes proc~arr_bytes_i1 arr_bytes_i1 interface~arr_bytes->proc~arr_bytes_i1 proc~arr_bytes_i2 arr_bytes_i2 interface~arr_bytes->proc~arr_bytes_i2 proc~arr_bytes_i3 arr_bytes_i3 interface~arr_bytes->proc~arr_bytes_i3 proc~arr_bytes_l1 arr_bytes_l1 interface~arr_bytes->proc~arr_bytes_l1 proc~arr_bytes_l2 arr_bytes_l2 interface~arr_bytes->proc~arr_bytes_l2 proc~arr_bytes_l3 arr_bytes_l3 interface~arr_bytes->proc~arr_bytes_l3 proc~arr_bytes_r1 arr_bytes_r1 interface~arr_bytes->proc~arr_by