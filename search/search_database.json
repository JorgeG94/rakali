est, state, sim_time) Fill ghost cells on nested edges by interpolating from the parent,\nusing Flather radiation with spatially-varying external values. Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest type( state_t ), intent(inout) :: state real(kind=wp), intent(in) :: sim_time Calls proc~~nesting_update~~CallsGraph proc~nesting_update nesting_update proc~advance_parent_bracket advance_parent_bracket proc~nesting_update->proc~advance_parent_bracket proc~apply_nested_east apply_nested_east proc~nesting_update->proc~apply_nested_east proc~apply_nested_north apply_nested_north proc~nesting_update->proc~apply_nested_north proc~apply_nested_south apply_nested_south proc~nesting_update->proc~apply_nested_south proc~apply_nested_west apply_nested_west proc~nesting_update->proc~apply_nested_west proc~load_parent_snapshot load_parent_snapshot proc~advance_parent_bracket->proc~load_parent_snapshot proc~interp_parent interp_parent proc~apply_nested_east->proc~interp_parent proc~apply_nested_north->proc~interp_parent proc~apply_nested_south->proc~interp_parent proc~apply_nested_west->proc~interp_parent nf90_get_var nf90_get_var proc~load_parent_snapshot->nf90_get_var proc~nc_check nc_check proc~load_parent_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~nesting_update~~CalledByGraph proc~nesting_update nesting_update proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~nesting_update proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha Source Code subroutine nesting_update ( nest , state , sim_time ) !! Fill ghost cells on nested edges by interpolating from the parent, !! using Flather radiation with spatially-varying external values. type ( nesting_t ), intent ( inout ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: sim_time real ( wp ) :: alpha if (. not . nest % active ) return ! Check if any edge is nested if ( state % bc % west /= BC_NESTED . and . state % bc % east /= BC_NESTED . and . & state % bc % south /= BC_NESTED . and . state % bc % north /= BC_NESTED ) return ! Advance time bracket call advance_parent_bracket ( nest , sim_time ) ! Temporal interpolation weight if ( nest % idx_lo == nest % idx_hi ) then alpha = 0.0_wp else alpha = ( sim_time - nest % p_time ( nest % idx_lo )) / & ( nest % p_time ( nest % idx_hi ) - nest % p_time ( nest % idx_lo )) alpha = max ( 0.0_wp , min ( 1.0_wp , alpha )) end if ! Apply nested BCs per edge if ( state % bc % west == BC_NESTED ) then call apply_nested_west ( nest , state , alpha ) end if if ( state % bc % east == BC_NESTED ) then call apply_nested_east ( nest , state , alpha ) end if if ( state % bc % south == BC_NESTED ) then call apply_nested_south ( nest , state , alpha ) end if if ( state % bc % north == BC_NESTED ) then call apply_nested_north ( nest , state , alpha ) end if end subroutine nesting_update","tags":"","url":"proc/nesting_update.html"},{"title":"advance_parent_bracket – Rakali","text":"private  subroutine advance_parent_bracket(nest, sim_time) Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest real(kind=wp), intent(in) :: sim_time Calls proc~~advance_parent_bracket~~CallsGraph proc~advance_parent_bracket advance_parent_bracket proc~load_parent_snapshot load_parent_snapshot proc~advance_parent_bracket->proc~load_parent_snapshot nf90_get_var nf90_get_var proc~load_parent_snapshot->nf90_get_var proc~nc_check nc_check proc~load_parent_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~advance_parent_bracket~~CalledByGraph proc~advance_parent_bracket advance_parent_bracket proc~nesting_update nesting_update proc~nesting_update->proc~advance_parent_bracket proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~nesting_update proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine advance_parent_bracket ( nest , sim_time ) type ( nesting_t ), intent ( inout ) :: nest real ( wp ), intent ( in ) :: sim_time do while ( nest % idx_hi < nest % p_nt . and . & sim_time >= nest % p_time ( nest % idx_hi )) nest % idx_lo = nest % idx_hi nest % h_lo = nest % h_hi nest % hu_lo = nest % hu_hi nest % hv_lo = nest % hv_hi nest % idx_hi = nest % idx_hi + 1 call load_parent_snapshot ( nest , nest % ncid , nest % idx_hi , & nest % h_hi , nest % hu_hi , nest % hv_hi ) end do end subroutine advance_parent_bracket","tags":"","url":"proc/advance_parent_bracket.html"},{"title":"allocate_parent_snapshots – Rakali","text":"private  subroutine allocate_parent_snapshots(nest) Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest Called by proc~~allocate_parent_snapshots~~CalledByGraph proc~allocate_parent_snapshots allocate_parent_snapshots proc~nesting_init nesting_init proc~nesting_init->proc~allocate_parent_snapshots proc~nesting_init_from_config nesting_init_from_config proc~nesting_init_from_config->proc~nesting_init proc~driver_run_coastal driver_run_coastal proc~driver