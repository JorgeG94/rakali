bi_one~~CallsGraph proc~agglom_jacobi_one agglom_jacobi_one local local proc~agglom_jacobi_one->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~agglom_jacobi_one~~CalledByGraph proc~agglom_jacobi_one agglom_jacobi_one proc~agglom_jacobi_sweeps agglom_jacobi_sweeps proc~agglom_jacobi_sweeps->proc~agglom_jacobi_one proc~agglom_vcycle agglom_vcycle proc~agglom_vcycle->proc~agglom_jacobi_sweeps proc~agglom_vcycle->proc~agglom_vcycle proc~agglom_unstr_vcycle_precond agglom_unstr_vcycle_precond proc~agglom_unstr_vcycle_precond->proc~agglom_vcycle proc~si_unstr_precond_apply si_unstr_precond_apply proc~si_unstr_precond_apply->proc~agglom_unstr_vcycle_precond proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_unstr_cg_solve->proc~si_unstr_precond_apply Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: acc integer, private :: k integer, private :: s Source Code subroutine agglom_jacobi_one ( e_old , e_new , r , nbr , ke , diag , dinv , & mv , nc , omega ) !! One damped-Jacobi sweep e_new = e_old + omega*(r - Ahat*e_old)/diag — !! reads e_old only, writes e_new only (race-free). integer , intent ( in ) :: mv , nc real ( wp ), intent ( in ) :: e_old ( nc ) real ( wp ), intent ( out ) :: e_new ( nc ) real ( wp ), intent ( in ) :: r ( nc ) integer , intent ( in ) :: nbr ( mv , nc ) real ( wp ), intent ( in ) :: ke ( mv , nc ) real ( wp ), intent ( in ) :: diag ( nc ), dinv ( nc ) real ( wp ), intent ( in ) :: omega integer :: k , s real ( wp ) :: acc do concurrent ( k = 1 : nc ) local ( s , acc ) acc = diag ( k ) * e_old ( k ) do s = 1 , mv acc = acc - ke ( s , k ) * e_old ( nbr ( s , k )) end do e_new ( k ) = e_old ( k ) + omega * ( r ( k ) - acc ) * dinv ( k ) end do end subroutine agglom_jacobi_one","tags":"","url":"proc/agglom_jacobi_one.html"},{"title":"agglom_jacobi_sweeps – Rakali","text":"private  subroutine agglom_jacobi_sweeps(e, r, tmp, nbr, ke, diag, dinv, mv, nc, omega, nu) nu damped-Jacobi sweeps, ping-pong (e,tmp); latest iterate in e . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: e (nc) real(kind=wp), intent(in) :: r (nc) real(kind=wp), intent(inout) :: tmp (nc) integer, intent(in) :: nbr (mv,nc) real(kind=wp), intent(in) :: ke (mv,nc) real(kind=wp), intent(in) :: diag (nc) real(kind=wp), intent(in) :: dinv (nc) integer, intent(in) :: mv integer, intent(in) :: nc real(kind=wp), intent(in) :: omega integer, intent(in) :: nu Calls proc~~agglom_jacobi_sweeps~~CallsGraph proc~agglom_jacobi_sweeps agglom_jacobi_sweeps proc~agglom_copy agglom_copy proc~agglom_jacobi_sweeps->proc~agglom_copy proc~agglom_jacobi_one agglom_jacobi_one proc~agglom_jacobi_sweeps-