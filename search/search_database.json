p), private :: h_ghost real(kind=wp), private :: h_int real(kind=wp), private :: hmax integer, private :: i2 integer, private :: ig integer, private :: ig0 integer, private :: ii integer, private :: j2 integer, private :: jg integer, private :: jg0 integer, private :: ji integer, private :: k integer, private :: n_tan integer, private :: nghost logical, private :: nu integer, private :: nx integer, private :: ny real(kind=wp), private :: sgn real(kind=wp), private :: speed integer, private :: t Source Code pure subroutine bc_chapman_edge ( h , hu , hv , b , grid , ed , eta_old , dt , dx , dy ) !! Chapman / Orlanski radiation for one edge.  The ghost surface !! advects at a clamped, non-negative phase speed estimated from the !! interior eta tendency and along-normal gradient; the momentum is !! the Flather radiation about that surface (sign ed%nrm_sign). !! `eta_old` is this edge's persistent surface (length n_tan), !! refreshed to the interior eta on the k==1 layer (per-t writes are !! disjoint).  `dd = dx` on W/E, `dy` on S/N. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) type ( edge_t ), intent ( in ) :: ed ! assumed-shape-ok: eta_old is a 1D edge-count-sized array; its length ! varies per boundary edge and is not a grid-level nx/ny dimension. real ( wp ), intent ( inout ) :: eta_old (:) real ( wp ), intent ( in ) :: dt , dx , dy integer :: t , k , ig , jg , ii , ji , i2 , j2 , nx , ny , nghost integer :: ig0 , jg0 , din , djn , dit , djt , n_tan real ( wp ) :: sgn , dd , h_int , eta_int , eta_old_val , speed , hmax real ( wp ) :: deta_dt , deta_dx , c_phase , eta_ghost_new , h_ghost logical :: nu nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost ig0 = ed % ig0 jg0 = ed % jg0 din = ed % di_n djn = ed % dj_n dit = ed % di_t djt = ed % dj_t n_tan = ed % n_tan nu = ed % normal_is_u sgn = ed % nrm_sign dd = merge ( dx , dy , nu ) do concurrent ( t = 1 : n_tan , k = 1 : nghost ) & local ( ig , jg , ii , ji , i2 , j2 , h_int , eta_int , eta_old_val , speed , & hmax , deta_dt , deta_dx , c_phase , eta_ghost_new , h_ghost ) ig = ig0 + ( k - 1 ) * din + ( t - 1 ) * dit jg = jg0 + ( k - 1 ) * djn + ( t - 1 ) * djt ii = ig0 + ( t - 1 ) * dit - din ! first interior cell ji = jg0 + ( t - 1 ) * djt - djn i2 = ii - din ! second interior (along normal) j2 = ji - djn h_int = h ( ii , ji ) eta_int = h_int + b ( ii , ji ) eta_old_val = eta_old ( t ) hmax = max ( h_int , 1.0e-6_wp ) speed = sqrt ( GRAVITY * hmax ) if ( dt > 0.0_wp ) then deta_dt = ( eta_int - eta_old_val ) / dt if ( i2 >= 1 . and . i2 <= nx . and . j2 >= 1 . and . j2 <= ny ) then deta_dx = ( h ( i2 , j2 ) + b ( i2 , j2 ) - eta_int ) / dd else deta_dx = 0.0_wp end if if ( abs ( deta_dx ) > 1.0e-10_wp ) then c_phase = - deta_dt / deta_dx else c_phase = 0.0_wp end if c_phase = max ( 0.0_wp , min ( c_phase , speed )) eta_ghost_new = eta_old_val - c_phase * dt / dd * ( eta_old_val - eta_int ) else eta_ghost_new = eta_int end if if ( k == 1 ) eta_old ( t ) = eta_int h_ghost = max ( 0.0_wp , eta_ghost_new - b ( ig , jg )) h ( ig , jg ) = h_ghost if ( nu ) then hu ( ig , jg ) = h_ghost * ( hu ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ghost_new ) / hmax ) hv ( ig , jg ) = hv ( ii , ji ) else hv ( ig , jg ) = h_ghost * ( hv ( ii , ji ) / hmax + sgn * speed * ( eta_int - eta_ghost_new ) / hmax ) hu ( ig , jg ) = hu ( ii , ji ) end if end do end subroutine bc_chapman_edge","tags":"","url":"proc/bc_chapman_edge.html"},{"title":"bc_clamped_edge – Rakali","text":"private pure subroutine bc_clamped_edge(h, hu, hv, b, grid, ed, eta) Clamped (Dirichlet surface): prescribe the ghost depth from the\nclamped elevation; copy BOTH momenta from the first interior\ncell (no normal/tangential distin