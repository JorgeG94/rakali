dratic on the bed row (the unstructured barotropic !! state carries no linear-drag knob): !!   cf = g*n&#94;2 / H_total&#94;{1/3};  lambda = cf*|u_bed| / h_1 !! folded into the bed diagonal as +dt*lambda.  Tridiagonal, Thomas !! factorisation, three back-solves (u&#94;n, v&#94;n, -1), then !!   Gbar = sum_k h_k G_k,  Hhat = -sum_k h_k R_k  (>= 0). !! R_k is axis-independent (u and v share the matrix). integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (the interface-array leading dim, explicit-shape). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s] (predictor tendencies already folded). real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s] (vdiff convention). real ( wp ), intent ( in ) :: manning_n !! Manning roughness n [s/m&#94;{1/3}]; <= 0 disables bottom drag. real ( wp ), intent ( in ) :: dt !! Time step [s]. real ( wp ), intent ( out ) :: g_col_u ( nz , nct ) !! Column velocity response to u&#94;n (G_k&#94;u) [m/s]. real ( wp ), intent ( out ) :: g_col_v ( nz , nct ) !! Column velocity response to v&#94;n (G_k&#94;v) [m/s]. real ( wp ), intent ( out ) :: r_col ( nz , nct ) !! Column velocity response to -1 (R_k) [m/s] (<= 0). real ( wp ), intent ( out ) :: Hhat_cell ( nct ) !! Effective column depth Hhat = -sum_k h_k R_k [m] (>= 0). real ( wp ), intent ( out ) :: Gbar_cell_x ( nct ) !! Column-integrated predictor transport sum_k h_k G_k&#94;u [m&#94;2/s]. real ( wp ), intent ( out ) :: Gbar_cell_y ( nct ) !! Column-integrated y predictor transport [m&#94;2/s]. integer :: c , k real ( wp ) :: hk_col ( NZ_STACK_MAX ) real ( wp ) :: ak_col ( NZ_STACK_MAX ) real ( wp ) :: bk_col ( NZ_STACK_MAX ) real ( wp ) :: ck_col ( NZ_STACK_MAX ) real ( wp ) :: rhs_u ( NZ_STACK_MAX ) real ( wp ) :: rhs_v ( NZ_STACK_MAX ) real ( wp ) :: rhs_r ( NZ_STACK_MAX ) real ( wp ) :: hc , hm , hp , dz_bot , dz_top real ( wp ) :: alph , beta_k , denom_k real ( wp ) :: lambda_drag , h_total , u_bed , v_bed , cf real ( wp ) :: gx_sum , gy_sum , hhat_sum do concurrent ( c = 1 : nco ) & local ( k , hk_col , ak_col , bk_col , ck_col , rhs_u , rhs_v , rhs_r , & hc , hm , hp , dz_bot , dz_top , alph , beta_k , denom_k , & lambda_drag , h_total , u_bed , v_bed , cf , gx_sum , gy_sum , hhat_sum ) ! ---- Floored thicknesses + plain u&#94;n/v&#94;n predictors (no PGF) ---- do k = 1 , nz hc = max ( h_layer ( k , c ), H_VANISHED ) hk_col ( k ) = hc rhs_u ( k ) = hu_layer ( k , c ) / hc rhs_v ( k ) = hv_layer ( k , c ) / hc rhs_r ( k ) = - 1.0_wp end do ! ---- Manning bottom drag on the bed row ---- lambda_drag = 0.0_wp if ( manning_n > 0.0_wp ) then h_total = 0.0_wp do k = 1 , nz h_total = h_total + hk_col ( k ) end do cf = GRAVITY * manning_n * manning_n / ( h_total ** ( 1.0_wp / 3.0_wp )) u_bed = hu_layer ( 1 , c ) / hk_col ( 1 ) v_bed = hv_layer ( 1 , c ) / hk_col ( 1 ) lambda_drag = cf * sqrt ( u_bed * u_bed + v_bed * v_bed ) / hk_col ( 1 ) end if ! ---- Tridiagonal build (bottom-up; vanished layers decouple) ---- hc = hk_col ( 1 ) if ( nz > 1 ) then hp = hk_col ( 2 ) dz_top = 0.5_wp * ( hc + hp ) alph = dt * nu_iface ( 2 , c ) / ( hc * dz_top ) if ( h_layer ( 1 , c ) <= H_VANISHED . or . h_layer ( 2 , c ) <= H_VANISHED ) then alph = 0.0_wp end if else alph = 0.0_wp end if ak_col ( 1 ) = 0.0_wp ck_col ( 1 ) = - alph bk_col ( 1 ) = 1.0_wp + alph + dt * lambda_drag do k = 2 , nz - 1 hc = hk_col ( k ) hm = hk_col ( k - 1 ) hp = hk_col ( k + 1 ) dz_bot = 0.5_wp * ( hm + hc ) dz_top = 0.5_wp * ( hc + hp ) beta_k = dt * nu_iface ( k , c ) / ( hc * dz_bot ) alph = dt * nu_iface ( k + 1 , c ) / ( hc * dz_top ) if ( h_layer ( k , c ) <= H_VANISHED . or . h_layer ( k - 1 , c ) <= H_VANISHED ) then beta_k = 0.0_wp end if if ( h_layer ( k , c ) <= H_VANISHED . or . h_layer ( k + 1 , c ) <= H_VANISHED ) then alph = 0.0_wp end if ak_col ( k ) = - beta_k ck_col ( k ) = - alph bk_col ( k ) = 1.0_wp + alph + beta_k end do if ( nz > 1 ) then hc = hk_col ( nz ) hm = hk_col ( nz - 1 ) dz_bot = 0.5_wp * ( hm + hc ) beta_k = dt * nu_iface ( nz , c ) / ( hc * dz_bot ) if ( h_layer ( nz , c ) <= H_VANISHED . or . h_layer ( nz - 1 , c ) <= H_VANISHED ) then beta_k = 0.0_wp end if ak_col ( nz ) = - beta_k ck_col ( nz ) = 0.0_wp bk_col ( nz ) = 1.0_wp + beta_k end if ! ---- Thomas factorisation + three-RHS sweep ---- ck_col ( 1 ) = ck_col ( 1 ) / bk_col ( 1 ) do k = 2 , nz denom_k = bk_col ( k ) - ak_col ( k ) * ck_col ( k - 1 ) ck_col ( k ) = ck_col ( k ) / denom_k bk_col ( k ) = denom_k end do rhs_u ( 1 ) = rhs_u ( 1 ) / bk_col ( 1 ) rhs_v ( 1 ) = rhs_v ( 1 ) / bk_col ( 1 ) rhs_r ( 1 ) = rhs_r ( 1 ) / bk_col ( 1 ) do k = 2 , nz rhs_u ( k ) = ( rhs_u ( k ) - ak_col ( k ) * rhs_u ( k - 1 )) / bk_col ( k ) rhs_v ( k ) = ( rhs_v ( k ) - ak_col ( k ) * rhs_v ( k - 1 )) / bk_col ( k ) rhs_r ( k ) = ( rhs_r ( k ) - ak_col ( k ) * rhs_r ( k - 1 )) / bk_col ( k ) end do ! Back-substitution (in place: rhs_* become the solutions x_*). do k = nz - 1 , 1 , - 1 rhs_u ( k ) = rhs_u ( k ) - ck_col ( k ) * rhs_u ( k + 1 ) rhs_v ( k ) = rhs_v ( k ) - ck_col ( k ) * rhs_v ( k + 1 ) rhs_r ( k ) = rhs_r ( k ) - ck_col ( k ) * rhs_r ( k + 1 ) end do ! ---- Cell integrals + store responses ---- ! RAW h_layer in the integrals (NOT the floored hk_col): the floor's ! only job is arming the tridiagonal 1/h — a vanished layer carries ! no transport, so it must contribute 0 to the column conveyance. ! The per-layer recovery telescopes with raw h_k*R_k / h_k*G_k, so ! floored integrals would make the eta-solve's face conveyance ! DISAGREE with the recovered transports by up to nz*H_VANISHED at ! dry/thin columns — measured as a ~1e-3 m/step mass<->tracer ! closure breach at the wet/dry front (water moving without salt, ! ~1.7 PSU freshening over a flood; the Q8 ML+wet/dry lesson). ! For any layer with h > H_VANISHED raw == floored, so columns where ! EVERY layer exceeds H_VANISHED are bit-identical (a genuinely wet ! but sub-H_VANISHED-thin layer is wet yet floored — NOT ! bit-identical). gx_sum = 0.0_wp gy_sum = 0.0_wp hhat_sum = 0.0_wp do k = 1 , nz gx_sum = gx_sum + h_layer ( k , c ) * rhs_u ( k ) gy_sum = gy_sum + h_layer ( k , c ) * rhs_v ( k ) hhat_sum = hhat_sum - h_layer ( k , c ) * rhs_r ( k ) g_col_u ( k , c ) = rhs_u ( k ) g_col_v ( k , c ) = rhs_v ( k ) r_col ( k , c ) = rhs_r ( k ) end do Gbar_cell_x ( c ) = gx_sum Gbar_cell_y ( c ) = gy_sum Hhat_cell ( c ) = hhat_sum end do end subroutine si_unstr_column_solve","tags":"","url":"proc/si_unstr_column_solve.html"},{"title":"si_unstr_edge_layers_to_cells – Rakali","text":"public pure subroutine si_unstr_edge_layers_to_cells(mesh, nz, nct, nco, u_edge_layer, hu_layer, hv_layer) Per-layer least-squares A-grid cell-momentum reconstruction from\nthe three per-layer edge-normal transports — the 2D si_unstr_reconstruct_cell_momenta , per layer (the documented\nreconstruction compromise; restart round-trips through the cell\nlayer momenta). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz Number of layers. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: u_edge_layer (nz,EDGES_PER_TRI,nct) real(kind=wp), intent(inout) :: hu_layer (nz,nct) Cell layer momenta [m&#94;2/s]; owned cells overwritten. real(kind=wp), intent(inout) :: hv_layer (nz,nct) Cell layer momenta [m&#94;2/s]; owned cells overwritten. Calls proc~~si_unstr_edge_layers_to_cells~~CallsGraph proc~si_unstr_edge_layers_to_cells si_unstr_edge_layers_to_cells local local proc~si_unstr_edge_layers_to_cells->local Help Graph Key Nodes of different colours represent 