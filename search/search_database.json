_v end if end do end if end do end subroutine ml_kpp_viscosity","tags":"","url":"proc/ml_kpp_viscosity.html"},{"title":"apply_boundary_conditions – Rakali","text":"public  subroutine apply_boundary_conditions(h, hu, hv, b, grid, bc) Fill ghost cells based on boundary condition type Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: b (grid%nx_total,grid%ny_total) (see bc_wall_edge ).  Open/tidal/inflow edges leave it untouched\n— there the domain genuinely continues past the boundary. type( hgrid_t ), intent(in) :: grid type( bc_params_t ), intent(inout) :: bc Boundary condition parameters Calls proc~~apply_boundary_conditions~~CallsGraph proc~apply_boundary_conditions apply_boundary_conditions proc~bc_chapman_edge bc_chapman_edge proc~apply_boundary_conditions->proc~bc_chapman_edge proc~bc_clamped_edge bc_clamped_edge proc~apply_boundary_conditions->proc~bc_clamped_edge proc~bc_disch_edge bc_disch_edge proc~apply_boundary_conditions->proc~bc_disch_edge proc~bc_flather_edge bc_flather_edge proc~apply_boundary_conditions->proc~bc_flather_edge proc~bc_inflow_edge bc_inflow_edge proc~apply_boundary_conditions->proc~bc_inflow_edge proc~bc_wall_edge bc_wall_edge proc~apply_boundary_conditions->proc~bc_wall_edge local local proc~bc_chapman_edge->local proc~bc_clamped_edge->local proc~bc_disch_edge->local proc~bc_flather_edge->local proc~bc_inflow_edge->local proc~bc_wall_edge->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface 