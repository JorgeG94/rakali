e~rki_state.f90 sourcefile~rki_output_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_restart_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_dynamics_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_eos_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_friction_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_horizontal_viscosity_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_keps_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_kpp_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_pressure_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_ml_tracers_unstr.f90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_step.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Explicit SSP Runge-Kutta time-integrator selection for the coastal solver. module rki_timestepper !! Holds the Shu-Osher coefficient table for the selectable explicit !! time integrator (`time_scheme`).  Every scheme is built from the same !! forward-Euler stage primitive: stage `i` advances the running iterate by !! `beta(i)*dt`, then blends with the start-of-step state `U&#94;n`: !! !!     E       = U&#94;(i-1) + beta(i)*dt * L(U&#94;(i-1))     ! Euler step !!     U&#94;(i)   = alpha(i)*U&#94;n + (1 - alpha(i))*E       ! convex blend !! !! All four schemes are strong-stability-preserving (SSP) so the per-stage !! convex structure keeps the wetting/drying positivity of forward Euler. !! `ssp_coeff` is the factor by which the stable timestep exceeds the !! forward-Euler CFL limit (1 for euler/rk2/rk3, 2 for rk43). !! !! Data, not polymorphism: a concrete container + an enum, mirroring the !! `vcoord_type` / EOS-variant / `use_hllc` dispatch idiom.  The type is !! host-side orchestration only (its weights reach kernels as scalars by !! value) so it is never device-mapped. use rki_constants , only : wp implicit none private public :: timestepper_t , make_timestepper , parse_time_scheme public :: TIME_EULER , TIME_RK2 , TIME_RK3 , TIME_RK43 , TIME_SEMI_IMPLICIT , MAX_STAGES integer , parameter :: TIME_EULER = 1 !! Forward Euler, SSPRK(1,1): 1st order, 1 stage. integer , parameter :: TIME_RK2 = 2 !! Heun / SSPRK(2,2): 2nd order, 2 stages (the default). integer , parameter :: TIME_RK3 = 3 !! Shu-Osher SSPRK(3,3): 3rd order, 3 stages. integer , parameter :: TIME_RK43 = 4 !! SSPRK(4,3): 3rd order, 4 stages, SSP coefficient 2 (2x timestep). integer , parameter :: TIME_SEMI_IMPLICIT = 5 !! Semi-implicit free-surface (Casulli): implicit gravity wave via a CG Helmholtz !! eta-solve. Not an SSP stage table — dispatched separately in solver_step. integer , parameter :: MAX_STAGES = 4 !! Largest stage count across the supported schemes. type :: timestepper_t !! Concrete Shu-Osher coefficient table for one scheme.  Host-side only. integer :: scheme = TIME_RK2 !! Active scheme tag (`TIME_*`). integer :: n_stages = 2 !! Number of forward-Euler stages. real ( wp ) :: ssp_coeff = 1.0_wp !! Stable-dt multiplier vs the forward-Euler CFL limit. real ( wp ) :: alpha ( MAX_STAGES ) = 0.0_wp !! Per-stage blend weight on `U&#94;n` (combine = alpha*U&#94;n + (1-alpha)*E). real ( wp ) :: beta ( MAX_STAGES ) = 0.0_wp !! Per-stage Euler-step fraction of `dt`. real ( wp ) :: c ( MAX_STAGES ) = 0.0_wp !! Per-stage time abscissa (fraction of `dt`) for time-dependent BCs. end type timestepper_t contains pure function make_timestepper ( scheme ) result ( ts ) !! Build the coefficient table for a scheme tag. integer , intent ( in ) :: scheme type ( timestepper_t ) :: ts ts % scheme = scheme select case ( scheme ) case ( TIME_EULER ) ts % n_stages = 1 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 ) = 0.0_wp ts % beta ( 1 ) = 1.0_wp ts % c ( 1 ) = 0.0_wp case ( TIME_RK3 ) ts % n_stages = 3 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 : 3 ) = [ 0.0_wp , 0.75_wp , 1.0_wp / 3.0_wp ] ts % beta ( 1 : 3 ) = [ 1.0_wp , 1.0_wp , 1.0_wp ] ts % c ( 1 : 3 ) = [ 0.0_wp , 1.0_wp , 0.5_wp ] case ( TIME_RK43 ) ts % n_stages = 4 ts % ssp_coeff = 2.0_wp ts % alpha ( 1 : 4 ) = [ 0.0_wp , 0.0_wp , 2.0_wp / 3.0_wp , 0.0_wp ] ts % beta ( 1 : 4 ) = [ 0.5_wp , 0.5_wp , 0.5_wp , 0.5_wp ] ts % c ( 1 : 4 ) = [ 0.0_wp , 0.5_wp , 1.0_wp , 0.5_wp ] case ( TIME_SEMI_IMPLICIT ) ! Semi-implicit has NO SSP stage table — solver_step dispatches it ! to si_step before any coefficient table is consulted.  Reaching ! here means a new call site asked for stage coefficients that do ! not exist; fail loud rather than silently handing back RK2. error stop \"make_timestepper: time_scheme='semi_implicit' is not \" // & \"stage-table-driven; it dispatches in solver_step (si_step).\" case default ! TIME_RK2 (Heun) ts % scheme = TIME_RK2 ts % n_stages = 2 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 : 2 ) = [ 0.0_wp , 0.5_wp ] ts % beta ( 1 : 2 ) = [ 1.0_wp , 1.0_wp ] ts % c ( 1 : 2 ) = [ 0.0_wp , 1.0_wp ] end select end function make_timestepper pure function parse_time_scheme ( name ) result ( scheme ) !! Map a namelist string to a `TIME_*` tag.  Unrecognised -> TIME_RK2. character ( len =* ), intent ( in ) :: name integer :: scheme select case ( trim ( adjustl ( name ))) case ( \"euler\" ) scheme = TIME_EULER case ( \"rk3\" ) scheme = TIME_RK3 case ( \"rk43\" ) scheme = TIME_RK43 case ( \"semi_implicit\" ) scheme = TIME_SEMI_IMPLICIT case default ! \"rk2\" and anything unrecognised scheme = TIME_RK2 end select end function parse_time_scheme end module rki_timestepper","tags":"","url":"sourcefile/rki_timestepper.f90.html"},{"title":"rki_flux_dump.F90 – Rakali","text":"Optional NetCDF snapshot of the barotropic flux-kernel per-cell I/O This file depends on sourcefile~~rki_flux_dump.f90~~EfferentGraph sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_constants.f90 sourcefile~rki_io_netcdf.f90 rki_io_netcdf.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_io_netcdf.f90->sourcefile~rki_constants.f90 sourcefile~rki_state.f90->sourcefile~rki_constants.f90 sourcefile~rki_barotropic_state.f90 rki_barotropic_state.F90 sourcefile~rki_state.f90->sourcefile~rki_barotropic_state.f90 sourcefile~rki_bathymetry.f90 rki_bathymetry.F90 sourcefile~rki_state.f90->sourcefile~rki_bathymetry.f90 sourcefile~rki_boundary_types.f90 rki_boundary_types.F90 sourcefile~rki_state.f90->sourcefile~rki_boundary_types.f90 sourcefile~rki_config.f90 rki_config.F90 sourcefile~rki_state.f90->sourcefile~rki_config.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_state.f90->sourcefile~rki_grid.f90 sourcefile~rki_mem_report.f90 rki_mem_report.F90 sourcefile~rki_state.f90->sourcefile~rki_mem_report.f90 sourcefile~rki_ml_eos.f90 rki_ml_eos.F90 sourcefile~rki_state.f90->sourcefile~rki_ml_eos.f90 sourcefile~rki_multilayer_state.f90 rki_multilayer_state.F90 sourcefile~rki_state.f90->sourcefile~rki_multilayer_state.f90 sourcefile~rki_nonhydrostatic_state.f90 rki_nonhydrostatic_state.F90 sourcefile~rki_state.f90->sourcefile~rki_nonhydrostatic_state.f90 sourcefile~rki_recon_weno.f90 rki_recon_weno.F90 sourcefile~rki_state.f90->sourcefile~rki_recon_weno.f90 sourcefile~rki_surface_forcing.f90 rki_surface_forcing.F90 sourcefile~rki_state.f90->sourcefile~rki_surface_forcing.f90 sourcefile~rki_timestepper.f90 rki_timestepper.F90 sourcefile~rki_stat