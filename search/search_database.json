inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n logical, intent(in) :: use_linear_drag real(kind=wp), intent(in) :: drag_r real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active logical, intent(in) :: do_save public pure subroutine ml_fused_rk2_finalise (h, hu, hv, h_layer, hu_layer, hv_layer, h_layer0, hu_layer0, hv_layer0, hS_layer, hT_layer, hS_layer0, hT_layer0, grid, nz) End-of-step fused kernel: RK2-averages all layer arrays with their *_0 counterparts and accumulates the depth-integrated h, hu, hv in one inner k-loop. No neighbour reads. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(out) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hT_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_fused_tracer_post (hS_layer, hT_layer, h_layer, hu_layer, hv_layer, h_bt, hu_bt, hv_bt, heat_flux, evap_minus_precip, evap_mass_sink, evap_latent_cooling, S_min, S_max, T_min, T_max, rho_0, cp, min_depth, grid, nz, dt) Fuses surface tracer fluxes + per-layer clamp (S, T) into one\nper-(i,j)-column kernel (no horizontal neighbour reads). Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h_bt (grid%nx_total,grid%ny_total) Barotropic depth — the nz=1 fast path maintains h_bt == h_layer\nBY CONSTRUCTION (no recompute-from-layers), so the mass sink\nmust update both or the next stage rebuilds the pre-sink depth. real(kind=wp), intent(inout) :: hu_bt (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv_bt (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) logical, intent(in) :: evap_mass_sink logical, intent(in) :: evap_latent_cooling real(kind=wp), intent(in) :: S_min real(kind=wp), intent(in) :: S_max real(kind=wp), intent(in) :: T_min real(kind=wp), intent(in) :: T_max real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: min_depth type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt","tags":"","url":"module/rki_kernel_fused_ml.html"},{"title":"rki_ml_kpp_unstr – Rakali","text":"Unstructured port of the structured A-grid KPP overlay\n( rki_ml_kpp ).  Same physics, adapted to the cell-centric (nz, ncells) layout and the two-pass (compute-then-apply)\nflux style the unstructured PP81 kernels use.  Like the structured\npath, the closure is fused with the explicit-flux apply because\nthe unstructured solver has no implicit vertical-diffusion solve: ml_kpp_boundary_layer_unstr — per cell, computes u_* (from\n    the barotropic wind stress), the surface buoyancy flux B_0,\n    and the bulk-Richardson boundary-layer depth h_b (with the\n    LMD94 eq-23 V_t&#94;2 term).  Stores all three on the multilayer\n    state; kpp_bl_depth persists across steps to seed V_t&#94;2. ml_kpp_viscosity_unstr — momentum: nu_t = max(PP81 interior,\n    KPP shape-function overlay), CFL-clamped explicit flux to\n    hu/hv.  Drop-in for ml_vertical_viscosity_unstr . ml_kpp_diffusion_tracers_unstr — S + T: same overlay on the\n    PP81 cubic diffusivity, plus the non-local counter-gradient\n    transport folded into the interface flux.  Drop-in for the two ml_vertical_diffusion_tracer_unstr calls. When the overlay is inactive (no wind + no destabilizing flux ⇒\nw_s = 0), every interface falls through to the bit-identical PP81\narithmetic, so vmix_use_kpp off leaves existing results\nunchanged.  u_* comes from the spatially-uniform state%barotropic%wind_tau_x/y (the unstructured wind-stress\ncoupling); a per-cell wind field is a future enhancement. Layer convention is bottom-up (k=1 bed, k=nz surface), matching\nthe rest of the unstructured multilayer path. Uses rki_state_unstr rki_constants rki_ml_common_unstr module~~rki_ml_kpp_unstr~~UsesGraph module~rki_ml_kpp_unstr rki_ml_kpp_unstr module~rki_constants rki_constants module~rki_ml_kpp_unstr->module~rki_constants module~rki_ml_common_unstr rki_ml_common_unstr module~rki_ml_kpp_unstr->module~rki_ml_common_unstr module~rki_state_unstr rki_state_unstr module~rki_ml_kpp_unstr->module~rki_state_unstr pic_types pic_types module~rki_constants->pic_types module~rki_ml_common_unstr->module~rki_constants module~rki_state_unstr->module~rki_constants module~rki_barotropic_state_unstr rki_barotropic_state_unstr module~rki_state_unstr->module~rki_barotropic_state_unstr module~rki_boundary_unstr rki_boundary_unstr module~rki_state_unstr->module~rki_boundary_unstr module~rki_mesh_unstr rki_mesh_unstr module~rki_state_unstr->module~rki_mesh_unstr module~rki_multilayer_state_unstr rki_multilayer_state_unstr module~rki_state_unstr->module~rki_multilayer_state_unstr module~rki_si_common rki_si_common module~rki_state_unstr->module~rki_si_common module~rki_si_unstr_state rki_si_unstr_state module~rki_state_unstr->module~rki_si_unstr_state module~rki_surface_forcing_unstr rki_surface_forcing_unstr module~rki_state_unstr->module~rki_surface_forcing_unstr module~rki_timestepper rki_timestepper module~rki_state_unstr->module~rki_timestepper pic_io pic_io module~rki_state_unstr->pic_io pic_logger pic_logger module~rki_state_unstr->pic_logger module~rki_barotropic_state_unstr->module~rki_constants module~rki_barotropic_state_unstr->module~rki_mesh_unstr modu