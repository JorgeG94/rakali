type / remap_method , and any other\nvcoord parameters before calling. Type Bound unstr_multilayer_state_t Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz_ml Calls proc~~unstr_multilayer_init~~CallsGraph proc~unstr_multilayer_init unstr_multilayer_state_t%unstr_multilayer_init proc~vcoord_init vcoord_t%vcoord_init proc~unstr_multilayer_init->proc~vcoord_init proc~vcoord_needs_remap vcoord_t%vcoord_needs_remap proc~unstr_multilayer_init->proc~vcoord_needs_remap error error proc~vcoord_init->error proc~nz_stack_is_sufficient nz_stack_is_sufficient proc~vcoord_init->proc~nz_stack_is_sufficient proc~nz_stack_required nz_stack_required proc~vcoord_init->proc~nz_stack_required to_string to_string proc~vcoord_init->to_string warning warning proc~vcoord_init->warning proc~nz_stack_is_sufficient->proc~nz_stack_required Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: n integer, private :: nz Source Code subroutine unstr_multilayer_init ( this , mesh , nz_ml ) !! Allocate every multilayer array at the cell counts in `mesh` !! and the configured layer count.  Initialises `vcoord` from !! its (already-set) `coord_type` / `remap_method`, allocates !! the rho-ref profile, and registers the salinity + temperature !! tracers in the tracer registry. !! !! Caller must have set `this%nz_ml` (or pass it via `nz_ml`), !! `this%vcoord%coord_type` / `remap_method`, and any other !! vcoord parameters before calling. class ( unstr_multilayer_state_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz_ml integer :: n , nz n = mesh % ncells_total nz = nz_ml this % nz_ml = nz call this % vcoord % init ( nz , this % vcoord % coord_type , & this % vcoord % remap_method ) allocate ( this % dsig_ml ( nz )) this % dsig_ml = this % vcoord % dsig_target ! GPU-mappable copy of z_ref allocate ( this % vcoord_z_ref ( 0 : nz ), source = 0.0_wp ) if ( allocated ( this % vcoord % z_ref )) then this % vcoord_z_ref = this % vcoord % z_ref end if ! Full z* per-cell z_ref. Allocated here; per-cell contents filled ! from bathymetry by `ml_build_vcoord_zstar_full_unstr` later. if ( this % vcoord % coord_type == VCOORD_ZSTAR_FULL ) then allocate ( this % vcoord_z_ref_col ( 0 : nz , n ), source = 0.0_wp ) end if allocate ( this % h_layer ( nz , n ), source = 0.0_wp ) allocate ( this % hu_layer ( nz , n ), source = 0.0_wp ) allocate ( this % hv_layer ( nz , n ), source = 0.0_wp ) allocate ( this % rho_layer ( nz , n ), source = 0.0_wp ) allocate ( this % w_interface ( nz + 1 , n ), source = 0.0_wp ) allocate ( this % h_layer0 ( nz , n ), source = 0.0_wp ) allocate ( this % hu_layer0 ( nz , n ), source = 0.0_wp ) allocate ( this % hv_layer0 ( nz , n ), source = 0.0_wp ) ! KPP per-cell boundary-layer workspace (always allocated; tiny). allocate ( this % kpp_bl_depth ( n ), source = 0.0_wp ) allocate ( this % kpp_u_star ( n ), source = 0.0_wp ) allocate ( this % kpp_buoy_flux ( n ), source = 0.0_wp ) ! k-epsilon interface state — allocated unconditionally (mirrors KPP). ! Seeds mirror the structured path. allocate ( this % keps_tke ( nz + 1 , n ), source = 1.0e-6_wp ) allocate ( this % keps_eps ( nz + 1 , n ), source = 1.0e-8_wp ) allocate ( this % keps_nut ( nz + 1 , n ), source = 1.0e-4_wp ) allocate ( this % keps_kt ( nz + 1 , n ), source = 1.0e-4_wp ) allocate ( this % keps_ustar_s ( n ), source = 0.0_wp ) allocate ( this % keps_ustar_b ( n ), source = 0.0_wp ) ! Picard save slots: only needed when keps_si_picard > 1.  The caller ! (rki_driver / test) sets keps_si_picard BEFORE calling init, so the ! allocation can happen here. if ( this % vmix_use_keps . and . this % keps_si_picard > 1 ) then allocate ( this % keps_tke0 ( nz + 1 , n ), source = 0.0_wp ) allocate ( this % keps_eps0 ( nz + 1 , n ), source = 0.0_wp ) end if allocate ( this % tracer_advect_scratch ( nz , n ), source = 0.0_wp ) allocate ( this % ml_lgrad_x ( nz , n ), source = 0.0_wp ) allocate ( this % ml_lgrad_y ( nz , n ), source = 0.0_wp ) allocate ( this % ml_hdiff_hTr_pre ( nz , n ), source = 0.0_wp ) allocate ( this % ml_horvisc_hu_pre ( nz , n ), source = 0.0_wp ) allocate ( this % ml_horvisc_hv_pre ( nz , n ), source = 0.0_wp ) allocate ( this % xmom_pre ( n ), source = 0.0_wp ) allocate ( this % ymom_pre ( n ), source = 0.0_wp ) if ( this % vcoord % needs_remap ()) then allocate ( this % remap_dz_old ( nz , n ), source = 0.0_wp ) end if ! Reference-density profile: 100 piecewise-linear samples. this % nz_ref = 100 allocate ( this % rho_ref ( 0 : this % nz_ref ), source = 0.0_wp ) this % rho_ref_dz = 0.0_wp ! Default tracer registry: salinity at index 1, temperature at index 2. allocate ( this % tracers ( 2 )) this % idx_salinity = 1 this % idx_temperature = 2 call this % tracers ( this % idx_salinity )% init ( mesh , nz ) call this % tracers ( this % idx_temperature )% init ( mesh , nz ) this % tracers ( this % idx_salinity )% name = \"salinity\" this % tracers ( this % idx_salinity )% long_name = \"Sea water salinity\" this % tracers ( this % idx_salinity )% units = \"PSU\" this % tracers ( this % idx_salinity )% standard_name = \"sea_water_salinity\" this % tracers ( this % idx_temperature )% name = \"temperature\" this % tracers ( this % idx_temperature )% long_name = \"Sea water potential temperature\" this % tracers ( this % idx_temperature )% units = \"degC\" this % tracers ( this % idx_temperature )% standard_name = \"sea_water_potential_temperature\" end subroutine unstr_multilayer_init","tags":"","url":"proc/unstr_multilayer_init.html"},{"title":"unstr_multilayer_register_passive_tracer – Rakali","text":"private  subroutine unstr_multilayer_register_passive_tracer(this, mesh, name, tr_init, tr_min, tr_max, kappa_bg, hdiff_kappa) Append a passive tracer (eos_coeff = 0) to the registry. Must be\ncalled AFTER init and BEFORE state_unstr_enter_data (so the\nnew tracer’s hTr gets device-mapped) — enforced via registry_locked : once the registry is device-mapped the call\nlogs an error and returns without touching it. S/T keep their\nindices. Type Bound unstr_multilayer_state_t Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh character(len=*), intent(in) :: name real(kind=wp), intent(in) :: tr_init real(kind=wp), intent(in) :: tr_min real(kind=wp), intent(in) :: tr_max real(kind=wp), intent(in) :: kappa_bg real(kind=wp), intent(in) :: hdiff_kappa Calls proc~~unstr_multilayer_register_passive_tracer~~CallsGraph proc~unstr_multilayer_register_passive_tracer unstr_multilayer_state_t%unstr_multilayer_register_passive_tracer error error proc~unstr_multilayer_register_passive_tracer->error proc~unstr_tracer_init unstr_tracer_t%unstr_tracer_init proc~unstr_multilayer_register_passive_tracer->proc~unstr_tracer_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it integer, private :: n_old type( unstr_tracer_t ), private, allocatable :: tmp (:) Source Code subroutine unstr_multilayer_register_passive_tracer ( this , mesh , name , tr_init , & tr_min , tr_max , kappa_bg , & hdiff_kappa ) !! Append a passive tracer (eos_coeff = 0) to the registry. Must be !! called AFTER `init` and BEFORE `state_unstr_enter_data` (so the !! new tracer's `hTr` gets device-mapped) — enforced via !! `registry_locked`: once the registry is device-mapped the call !! logs an error and returns without touching it. S/T keep their !! indices. class ( unstr_multilayer_state_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh character ( len =* ), intent ( in ) :: name real ( wp ), intent ( in ) :: tr_init , tr_min , tr_max , kappa_bg , hdiff_kappa type ( unstr_tracer_t ), allocatable :: tmp (:) integer :: n_old , it if ( this % registry_locked ) then call global_logger % error ( \"unstr_multilayer_state: register_passive_tracer(\" // & trim ( name ) // \") refused — registry locked by \" // & \"enter_data (growing the registry now would strand \" // & \"every existing tracer's device mapping on the \" // & \"mem:separate GPU build)\" ) return end if n_old = size ( this % tracers ) call move_alloc ( this % tracers , tmp ) allocate ( this % tracers ( n_old + 1 )) ! Deep-copy the existing tracers (intrinsic assignment reallocates ! the allocatable hTr / hTr0 components and copies their data). do it = 1 , n_old this % tracers ( it ) = tmp ( it ) end do it = n_old + 1 call this % tracers ( it )% init ( mesh , this % nz_ml ) this % tracers ( it )% name = trim ( name ) this % tracers ( it )% long_name = trim ( name ) this % tracers ( it )% units = \"1\" this % tracers ( it )% standard_name = \"\" this % tracers ( it )% tr_init = tr_init this % tracers ( it )% tr_inflow = tr_init this % tracers ( it )% bc_ext = tr_init this % tracers ( it )% tr_min = tr_min this % tracers ( it )% tr_max = tr_max this % tracers ( it )% kappa_bg = kappa_bg this % tracers ( it )% hdiff_kappa = hdiff_kappa this % tracers ( it )% eos_coeff = 0.0_wp this % tracers ( it )% eos_ref = 0.0_wp end subroutine unstr_multilayer_register_passive_tracer","tags":"","url":"proc/unstr_multilayer_register_passive_tracer.html"},{"title":"apply_manning_friction_unstr – Rakali","text":"public pure subroutine apply_manning_friction_unstr(state, mesh, dt) Semi-implicit Manning friction + explicit wind stress over\nevery owned cell. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~apply_manning_friction_unstr~~CallsGraph proc~apply_manning_friction_unstr apply_manning_friction_unstr local local proc~apply_manning_friction_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: cf real(kind=wp), private :: denom real(kind=wp), private :: h_val logical, private :: has_friction logical, private :: has_wind integer, private :: k real(kind=wp), private :: min_h real(kind=wp), private :: n_sq real(kind=wp), private :: speed real(kind=wp), private :: tau_x_over_rho real(kind=wp), private :: tau_y_over_rho real(kind=wp), private :: u_val real(kind=wp), private :: v_val Source Code pure subroutine apply_manning_friction_unstr ( state , mesh , dt ) !! Semi-implicit Manning friction + explicit wind stress over !! every owned cell. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer :: k real ( wp ) :: h_val , u_val , v_val , speed , cf , denom real ( wp ) :: n_sq , min_h , tau_x_over_rho , tau_y_over_rho logical :: has_friction , has_wind if ( dt <= 0.0_wp ) return has_friction = state % barotropic % manning_n > 0.0_wp has_wind = ( state % barotropic % wind_tau_x /= 0.0_wp ) . or . ( state % barotropic % wind_tau_y /= 0.0_wp ) if (. not . has_friction . and . . not . has_wind ) return n_sq = state % barotropic % manning_n * state % barotropic % manning_n min_h = state % minimum_allowed_height tau_x_over_rho = state % barotropic % wind_tau_x / RHO_WATER tau_y_over_rho = state % barotropic % wind_tau_y / RHO_WATER do concurrent ( k = 1 : mesh % ncells_owned ) & local ( h_val , u_val , v_val , speed , cf , denom ) h_val = state % barotropic % stage_cv ( k ) - state % barotropic % bed_cv ( k ) if ( h_val > min_h ) then if ( has_friction ) then u_val = state % barotropic % xmom_cv ( k ) / h_val v_val = state % barotropic % ymom_cv ( k ) / h_val speed = sqrt ( u_val * u_val + v_val * v_val ) cf = GRAVITY * n_sq / ( h_val ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed / h_val state % barotropic % xmom_cv ( k ) = state % barotropic % xmom_cv ( k ) / denom state % barotropic % ymom_cv ( k ) = state % barotropic % ymom_cv ( k ) / denom end if if ( has_wind ) then state % barotropic % xmom_cv ( k ) = state % barotropic % xmom_cv ( k ) + dt * tau_x_over_rho state % barotropic % ymom_cv ( k ) = state % barotropic % ymom_cv ( k ) + dt * tau_y_over_rho end if end if end do end subroutine apply_manning_friction_unstr","tags":"","url":"proc/apply_manning_friction_unstr.html"},{"title":"ml_compute_reference_density – Rakali","text":"public  subroutine ml_compute_reference_density(h_layer, rho_layer, rho_ref, rho_ref_dz, nz_ref, rho_0, grid, nz) Build the horizontally-uniform reference-density profile rho_ref(z) from the current rho_layer .  Sampled on a uniform\nz-grid 0..rho_ref_dz*nz_ref , area-weighted across interior cells. Subtracted by both BPG kernels so the integrand becomes the\ndensity anomaly rho - rho_ref(z) – 10-100x smaller than rho - rho_0 in stratified water (Phase B2). Computed on the host: copies layer fields back from the device,\nbuilds the profile, and pushes rho_ref to the device.  Single\none-time D2H+H2D, negligible at init. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: rho_ref (0:nz_ref) real(kind=wp), intent(out) :: rho_ref_dz integer, intent(in) :: nz_ref real(kind=wp), intent(in) :: rho_0 type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Called by proc~~ml_compute_reference_density~~CalledByGraph proc~ml_compute_reference_density ml_compute_reference_density proc~refresh_multilayer_derived refresh_multilayer_derived proc~refresh_multilayer_derived->proc~ml_compute_reference_density proc~init_multilayer_from_barotropic init_multilayer_from_barotropic proc~init_multilayer_from_barotropic->proc~refresh_multilayer_derived proc~restore_multilayer_after_restart restore_multilayer_after_restart proc~restore_multilayer_after_restart->proc~refresh_multilayer_derived proc~api_init_multilayer api_init_multilayer proc~api_init_multilayer->proc~init_multilayer_from_barotropic proc~init_from_config init_from_config proc~init_from_config->proc~init_multilayer_from_barotropic proc~init_local_state init_local_state proc~init_local_state->proc~init_multilayer_from_barotropic proc~init_local_state->proc~restore_multilayer_after_restart proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~rki_finalize rki_finalize proc~rki_finalize->proc~api_init_multilayer proc~rki_finalize->proc~init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_finalize proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_finalize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: H_col real(kind=wp), private :: H_max real(kind=wp), private :: dz integer, private :: i integer, private :: iz integer, private :: j integer, private :: k integer, private :: ncells integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: rho_at_z real(kind=wp), private, allocatable :: sum_rho (:) real(kind=wp), private :: z real(kind=wp), private :: z_bot real(kind=wp), private :: z_top Source Code subroutine ml_compute_reference_density ( h_layer , rho_layer , & rho_ref , rho_ref_dz , nz_ref , & rho_0 , & grid , nz ) !! Build the horizontally-uniform reference-density profile !! `rho_ref(z)` from the current `rho_layer`.  Sampled on a uniform !! z-grid `0..rho_ref_dz*nz_ref`, area-weighted across interior cells. !! !! Subtracted by both BPG kernels so the integrand becomes the !! density anomaly `rho - rho_ref(z)` -- 10-100x smaller than !! `rho - rho_0` in stratified water (Phase B2). !! !! Computed on the host: copies layer fields back from the device, !! builds the profile, and pushes `rho_ref` to the device.  Single !! one-time D2H+H2D, negligible at init. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz , nz_ref real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( out ) :: rho_ref ( 0 : nz_ref ) real ( wp ), intent ( out ) :: rho_ref_dz real ( wp ), intent ( in ) :: rho_0 integer :: i , j , k , iz , ncells , nx , ny , nghost real ( wp ) :: H_max , H_col , dz , z , z_top , z_bot , rho_at_z real ( wp ), allocatable :: sum_rho (:) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost !$acc update self(h_layer, rho_layer) if_present H_max = 0.0_wp do j = nghost + 1 , ny - nghost do i = nghost + 1 , nx - nghost H_col = 0.0_wp do k = 1 , nz H_col = H_col + h_layer ( i , j , k ) end do if ( H_col > H_max ) H_max = H_col end do end do if ( H_max <= 0.0_wp ) then rho_ref = rho_0 rho_ref_dz = 0.0_wp !$acc update device(rho_ref) if_present return end if H_max = 1.05_wp * H_max dz = H_max / real ( nz_ref , wp ) rho_ref_dz = dz allocate ( sum_rho ( 0 : nz_ref ), source = 0.0_wp ) ncells = 0 do j = nghost + 1 , ny - nghost do i = nghost + 1 , nx - nghost H_col = 0.0_wp do k = 1 , nz H_col = H_col + h_layer ( i , j , k ) end do if ( H_col < ML_MIN_DEPTH ) cycle ncells = ncells + 1 do iz = 0 , nz_ref z = real ( iz , wp ) * dz z_top = 0.0_wp rho_at_z = rho_layer ( i , j , nz ) if ( z >= H_col ) then rho_at_z = rho_layer ( i , j , 1 ) else do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i , j , k ) if ( z >= z_top . and . z <= z_bot ) then rho_at_z = rho_layer ( i , j , k ) exit end if z_top = z_bot end do end if sum_rho ( iz ) = sum_rho ( iz ) + rho_at_z end do end do end do if ( ncells > 0 ) then do iz = 0 , nz_ref rho_ref ( iz ) = sum_rho ( iz ) / real ( ncells , wp ) end do else rho_ref = rho_0 end if deallocate ( sum_rho ) !$acc update device(rho_ref) if_present end subroutine ml_compute_reference_density","tags":"","url":"proc/ml_compute_reference_density.html"},{"title":"ml_equation_of_state – Rakali","text":"public pure subroutine ml_equation_of_state(h_layer, hS_layer, hT_layer, rho_layer, rho_0, beta_S, S_ref, alpha_T, T_ref, grid, nz) Linear two-tracer equation of state:\n  rho_k = rho_0 + beta_S * (S_k - S_ref) - alpha_T * (T_k - T_ref)\nwhere S_k = hS_k / h_k and T_k = hT_k / h_k. Setting alpha_T = 0 makes temperature a passive tracer (no density\nfeedback).  Setting S_ref = 0 reproduces the one-tracer legacy form\nrho = rho_0 + beta_S*S. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 Reference density (kg/m&#94;3) real(kind=wp), intent(in) :: beta_S Haline contraction coefficient (kg/m&#94;3 per PSU) real(kind=wp), intent(in) :: S_ref Reference salinity (PSU) real(kind=wp), intent(in) :: alpha_T Thermal expansion coefficient (kg/m&#94;3 per degC) real(kind=wp), intent(in) :: T_ref Reference temperature (degC) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_equation_of_state~~CallsGraph proc~ml_equation_of_state ml_equation_of_state local local proc~ml_equation_of_state->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_equation_of_state~~CalledByGraph proc~ml_equation_of_state ml_equation_of_state proc~refresh_multilayer_derived refresh_multilayer_derived proc~refresh_multilayer_derived->proc~ml_equation_of_state proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_equation_of_state proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~ml_equation_of_state proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~init_multilayer_from_barotropic init_multilayer_from_barotropic proc~init_multilayer_from_barotropic->proc~refresh_multilayer_derived proc~restore_multilayer_after_restart restore_multilayer_after_restart proc~restore_multilayer_after_restart->proc~refresh_multilayer_derived proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~api_init_multilayer api_init_multilayer proc~api_init_multilayer->proc~init_multilayer_from_barotropic proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~init_local_state init_local_state proc~driver_run_coastal->proc~init_local_state proc~init_from_config init_from_config proc~init_from_config->proc~init_multilayer_from_barotropic proc~init_local_state->proc~init_multilayer_from_barotropic proc~init_local_state->proc~restore_multilayer_after_restart proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~rki_finalize rki_finalize proc~rki_finalize->proc~api_init_multilayer proc~rki_finalize->proc~init_from_config proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_finalize proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_finalize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: S_k real(kind=wp), private :: T_k integer, private :: i real(kind=wp), private :: inv_h integer, private :: j integer, private :: k integer, private :: nx integer, private :: ny Source Code pure subroutine ml_equation_of_state ( h_layer , hS_layer , hT_layer , rho_layer , & rho_0 , beta_S , S_ref , & alpha_T , T_ref , & grid , nz ) !! Linear two-tracer equation of state: !!   rho_k = rho_0 + beta_S * (S_k - S_ref) - alpha_T * (T_k - T_ref) !! where S_k = hS_k / h_k and T_k = hT_k / h_k. !! !! Setting alpha_T = 0 makes temperature a passive tracer (no density !! feedback).  Setting S_ref = 0 reproduces the one-tracer legacy form !! rho = rho_0 + beta_S*S. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( out ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 !! Reference density (kg/m&#94;3) real ( wp ), intent ( in ) :: beta_S !! Haline contraction coefficient (kg/m&#94;3 per PSU) real ( wp ), intent ( in ) :: S_ref !! Reference salinity (PSU) real ( wp ), intent ( in ) :: alpha_T !! Thermal expansion coefficient (kg/m&#94;3 per degC) real ( wp ), intent ( in ) :: T_ref !! Reference temperature (degC) integer :: i , j , k , nx , ny real ( wp ) :: S_k , T_k , inv_h nx = grid % nx_total ny = grid % ny_total ! Compute rho for ALL cells including ghost cells, because the ! baroclinic pressure gradient uses central differences that access ! ghost cell rho values.  Ghost cells already have valid h_layer ! (from ml_apply_layer_bcs) and hS/hT_layer (from ml_apply_tracer_bcs). do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) & local ( S_k , T_k , inv_h ) if ( h_layer ( i , j , k ) > DRY_TOLERANCE ) then inv_h = 1.0_wp / h_layer ( i , j , k ) S_k = hS_layer ( i , j , k ) * inv_h T_k = hT_layer ( i , j , k ) * inv_h else S_k = S_ref T_k = T_ref end if rho_layer ( i , j , k ) = rho_0 + beta_S * ( S_k - S_ref ) - alpha_T * ( T_k - T_ref ) end do end subroutine ml_equation_of_state","tags":"","url":"proc/ml_equation_of_state.html"},{"title":"ml_equation_of_state_shared – Rakali","text":"public  subroutine ml_equation_of_state_shared(h_layer, hS_layer, hT_layer, rho_layer, eos, grid, nz) Opt-in coastal entry to the SHARED (ocean) equation of state —\nselected by &tracer_nml eos_form = \"wright\" | \"roquet_spv\" .\nThin forwarding shim onto the regime-agnostic eos_compute_arrays variant dispatch; evaluation is at eos%p_ref (default 0 Pa ⇒ surface/potential density — the\nright choice for the coastal depth range) with the shared H_VANISHED vanishing-layer fallback to eos%rho0 (note: the\nlegacy coastal kernel gates on DRY_TOLERANCE instead).  The eos_t handle is a flat POD — its scalars are read on\nthe host here and passed by value into the device kernels, so\nno device mapping of the handle is required. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: rho_layer (grid%nx_total,grid%ny_total,nz) type( eos_t ), intent(in) :: eos Shared EOS handle (variant + scalar coefficients). type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_equation_of_state_shared~~CallsGraph proc~ml_equation_of_state_shared ml_equation_of_state_shared proc~eos_compute_arrays eos_compute_arrays proc~ml_equation_of_state_shared->proc~eos_compute_arrays proc~eos_linear_impl eos_linear_impl proc~eos_compute_arrays->proc~eos_linear_impl proc~eos_roquet_spv_impl eos_roquet_spv_impl proc~eos_compute_arrays->proc~eos_roquet_spv_impl proc~eos_wright_impl eos_wright_impl proc~eos_compute_arrays->proc~eos_wright_impl local local proc~eos_linear_impl->local proc~eos_roquet_spv_impl->local proc~roquet_spv_point roquet_spv_point proc~eos_roquet_spv_impl->proc~roquet_spv_point proc~eos_wright_impl->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that