 different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: N2 (NZ_STACK_MAX) real(kind=wp), private :: S2 (NZ_STACK_MAX) real(kind=wp), private :: a (NZ_STACK_MAX) real(kind=wp), private :: b (NZ_STACK_MAX) real(kind=wp), private :: buoy real(kind=wp), private :: c (NZ_STACK_MAX) real(kind=wp), private :: cmu_m real(kind=wp), private :: cmup_m real(kind=wp), private :: cp (NZ_STACK_MAX) real(kind=wp), private :: dd real(kind=wp), private :: denom real(kind=wp), private :: drho real(kind=wp), private :: du real(kind=wp), private :: dudz real(kind=wp), private :: dvdz real(kind=wp), private :: dz_if (NZ_STACK_MAX) real(kind=wp), private :: e_wb real(kind=wp), private :: e_ws real(kind=wp), private :: eok real(kind=wp), private :: h_col integer, private :: i integer, private :: j real(kind=wp), private :: k_wb real(kind=wp), private :: k_ws real(kind=wp), private :: ktx integer, private :: m integer, private :: nghost integer, private :: ni integer, private :: nx integer, private :: ny real(kind=wp), private :: prod real(kind=wp), private :: rhs (NZ_STACK_MAX) integer, private :: scheme_eff real(kind=wp), private :: sink real(kind=wp), private :: src real(kind=wp), private :: u_dn real(kind=wp), private :: u_up real(kind=wp), private :: v_dn real(kind=wp), private :: v_up logical, private :: walls Source Code pure subroutine ml_keps_update ( h_layer , hu_layer , hv_layer , rho_layer , & tke , eps , nut , kt , rho_0 , dt , grid , nz , & ustar_b , ustar_s , scheme ) !! Advance k and eps one step per column and recover nu_t / kappa_t. !! `tke`, `eps`, `nut`, `kt` are interface-shaped (nz+1); `tke`/`eps`/ !! `nut` carry state across steps (the diffusion reads the old `nut`). !! !! Boundary closure: if the optional friction velocities `ustar_b` !! (bed) and `ustar_s` (surface) are present, Dirichlet log-law wall !! functions are imposed at the first interior interfaces (interface 2 !! above the bed, interface nz below the surface): !!   k = u_*&#94;2 / sqrt(c_mu),   eps = u_*&#94;3 / (kappa_eff*(z + z0)) !! with z the interface distance from the wall (= the adjacent layer !! thickness).  Absent both, the boundary interfaces fall back to the !! zero-gradient (no-flux) closure (used by the standalone unit tests). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: tke ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: eps ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: nut ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: kt ( grid % nx_total , grid % ny_total , nz + 1 ) !! Scalar diffusivity, carried across steps: the buoyancy term reads !! the old value, so a stratification-aware scheme stays consistent. real ( wp ), intent ( in ) :: rho_0 , dt real ( wp ), intent ( in ), optional :: ustar_b ( grid % nx_total , grid % ny_total ) !! Bed friction velocity sqrt(|tau_b|/rho_0) (m/s), per column. real ( wp ), intent ( in ), optional :: ustar_s ( grid % nx_total , grid % ny_total ) !! Surface friction velocity sqrt(|tau_wind|/rho_0) (m/s), per column. integer , intent ( in ), optional :: scheme !! Stability-function scheme (KEPS_STAB_*): absent / CONSTANT -> the !! standard constant c_mu = 0.09 (bit-identical to the original); !! GALPERIN -> stratification-aware quasi-equilibrium. integer :: i , j , m , nx , ny , nghost , ni , scheme_eff real ( wp ) :: h_col , u_dn , u_up , v_dn , v_up , dudz , dvdz , drho real ( wp ) :: prod , buoy , ktx , dd , du , denom , sink , src , eok real ( wp ) :: k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m logical :: walls real ( wp ) :: S2 ( NZ_STACK_MAX ), N2 ( NZ_STACK_MAX ), dz_if ( NZ_STACK_MAX ) real ( wp ) :: a ( NZ_STACK_MAX ), b ( NZ_STACK_MAX ), c ( NZ_STACK_MAX ) real ( wp ) :: rhs ( NZ_STACK_MAX ), cp ( NZ_STACK_MAX ) if ( nz < 2 ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost ni = nz + 1 walls = present ( ustar_b ) . and . present ( ustar_s ) scheme_eff = KEPS_STAB_CONSTANT if ( present ( scheme )) scheme_eff = scheme do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( m , h_col , u_dn , u_up , v_dn , v_up , dudz , dvdz , drho , & prod , buoy , ktx , dd , du , denom , sink , src , eok , & k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m , & S2 , N2 , dz_if , a , b , c , rhs , cp ) h_col = 0.0_wp do m = 1 , nz h_col = h_col + h_layer ( i , j , m ) end do if ( h_col > ML_MIN_DEPTH ) then ! ---- interface metrics, shear S&#94;2 and buoyancy N&#94;2 ---- dz_if ( 1 ) = 0.5_wp * h_layer ( i , j , 1 ) dz_if ( ni ) = 0.5_wp * h_layer ( i , j , nz ) S2 ( 1 ) = 0.0_wp N2 ( 1 ) = 0.0_wp S2 ( ni ) = 0.0_wp N2 ( ni ) = 0.0_wp do m = 2 , nz dz_if ( m ) = 0.5_wp * ( h_layer ( i , j , m - 1 ) + h_layer ( i , j , m )) u_dn = hu_layer ( i , j , m - 1 ) / max ( h_layer ( i , j , m - 1 ), DRY_TOLERANCE ) u_up = hu_layer ( i , j , m ) / max ( h_layer ( i , j , m ), DRY_TOLERANCE ) v_dn = hv_layer ( i , j , m - 1 ) / max ( h_layer ( i , j , m - 1 ), DRY_TOLERANCE ) v_up = hv_layer ( i , j , m ) / max ( h_layer ( i , j , m ), DRY_TOLERANCE ) dudz = ( u_up - u_dn ) / dz_if ( m ) dvdz = ( v_up - v_dn ) / dz_if ( m ) S2 ( m ) = dudz * dudz + dvdz * dvdz drho = rho_layer ( i , j , m ) - rho_layer ( i , j , m - 1 ) ! above - below N2 ( m ) = - GRAVITY * drho / rho_0 / dz_if ( m ) end do ! ---- log-law wall values (Dirichlet) when friction velocities !      are supplied; z = adjacent-layer thickness ---- if ( walls ) then k_wb = max ( ustar_b ( i , j ) * ustar_b ( i , j ) / sqrt ( CMU ), K_MIN ) e_wb = max ( ustar_b ( i , j ) ** 3 / ( KAPPA_EFF * ( h_layer ( i , j , 1 ) + Z0_BED )), EPS_MIN ) k_ws = max ( ustar_s ( i , j ) * ustar_s ( i , j ) / sqrt ( CMU ), K_MIN ) e_ws = max ( ustar_s ( i , j ) ** 3 / ( KAPPA_EFF * ( h_layer ( i , j , nz ) + Z0_SURF )), EPS_MIN ) end if ! ---- TKE: implicit diffusion + production - dissipation ---- ! At the near-wall interfaces (2 = bed, nz = surface) the wall ! functions pin k by Dirichlet; interfaces 1 / nz+1 then copy ! the wall value via the zero-gradient rows in the tridiag solve. do m = 2 , nz if ( walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = k_ws else rhs ( m ) = k_wb end if else ktx = kt ( i , j , m ) prod = nut ( i , j , m ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( i , j , m - 1 ) + nut ( i , j , m )) / SIG_K ! layer m-1 du = 0.5_wp * ( nut ( i , j , m ) + nut ( i , j , m + 1 )) / SIG_K ! layer m a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( i , j , m - 1 ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( i , j , m ) sink = eps ( i , j , m ) / max ( tke ( i , j , m ), K_MIN ) b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( prod + buoy , 0.0_wp ) rhs ( m ) = tke ( i , j , m ) + dt * src end if end do call keps_tridiag_solve ( a , b , c , rhs , cp , ni ) do m = 1 , ni tke ( i , j , m ) = max ( rhs ( m ), K_MIN ) end do ! ---- eps: implicit diffusion + (eps/k)(ce1 P + ce3 B - ce2 eps) ---- do m = 2 , nz if ( walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = e_ws else rhs ( m ) = e_wb end if else ktx = kt ( i , j , m ) prod = nut ( i , j , m ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( i , j , m - 1 ) + nut ( i , j , m )) / SIG_E du = 0.5_wp * ( nut ( i , j , m ) + nut ( i , j , m + 1 )) / SIG_E a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( i , j , m - 1 ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( i , j , m ) eok = eps ( i , j , m ) / max ( tke ( i , j , m ), K_MIN ) ! tke is NEW sink = CE2 * eok b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( eok * ( CE1 * prod + CE3 * buoy ), 0.0_wp ) rhs ( m ) = eps ( i , j , m ) + dt * src end if end do call keps_tridiag_solve ( a , b , c , rhs , cp , ni ) do m = 1 , ni eps ( i , j , m ) = max ( rhs ( m ), EPS_MIN ) end do ! ---- recover nu_t, kappa_t (constant or stratification-aware) ---- do m = 1 , ni call keps_stability_funcs ( scheme_eff , S2 ( m ), N2 ( m ), tke ( i , j , m ), & eps ( i , j , m ), cmu_m , cmup_m ) nut ( i , j , m ) = min ( max ( cmu_m * tke ( i , j , m ) * tke ( i , j , m ) & / max ( eps ( i , j , m ), EPS_MIN ), NUT_MIN ), NUT_MAX ) kt ( i , j , m ) = min ( max ( cmup_m * tke ( i , j , m ) * tke ( i , j , m ) & / max ( eps ( i , j , m ), EPS_MIN ), NUT_MIN ), NUT_MAX ) end do end if end do end subroutine ml_keps_update","tags":"","url":"proc/ml_keps_update.html"},{"title":"keps_tridiag_solve – Rakali","text":"private pure subroutine keps_tridiag_solve(a, b, c, rhs, cp, ni) In-place Thomas solve over interfaces 1..ni with zero-gradient\n(no-flux) boundary rows. rhs returns the solution; cp scratch. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: a (ni) real(kind=wp), intent(inout) :: b (ni) real(kind=wp), intent(inout) :: c (ni) real(kind=wp), intent(inout) :: rhs (ni) real(kind=wp), intent(inout) :: cp (ni) integer, intent(in) :: ni Called by proc~~keps_tridiag_solve~~CalledByGraph proc~keps_tridiag_solve keps_tridiag_solve proc~ml_keps_update ml_keps_update proc~ml_keps_update->proc~keps_tridiag_solve proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_keps_update proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: denom integer, private :: m Source Code pure subroutine keps_tridiag_solve ( a , b , c , rhs , cp , ni ) !$acc routine seq !! In-place Thomas solve over interfaces 1..ni with zero-gradient !! (no-flux) boundary rows.  `rhs` returns the solution; `cp` scratch. integer , intent ( in ) :: ni real ( wp ), intent ( inout ) :: a ( ni ), b ( ni ), c ( ni ), rhs ( ni ), cp ( ni ) integer :: m real ( wp ) :: denom ! Zero-gradient closure: var(1)=var(2), var(ni)=var(ni-1). a ( 1 ) = 0.0_wp b ( 1 ) = 1.0_wp c ( 1 ) = - 1.0_wp rhs ( 1 ) = 0.0_wp a ( ni ) = - 1.0_wp b ( ni ) = 1.0_wp c ( ni ) = 0.0_wp rhs ( ni ) = 0.0_wp cp ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , ni denom = b ( m ) - a ( m ) * cp ( m - 1 ) cp ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = ni - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cp ( m ) * rhs ( m + 1 ) end do end subroutine keps_tridiag_solve","tags":"","url":"proc/keps_tridiag_solve.html"},{"title":"keps_tridiag_solve_noflux – Rakali","text":"private pure subroutine keps_tridiag_solve_noflux(a, b, c, rhs, cp, n) In-place Thomas solve over rows 1..n with the boundary closure\nalready baked into a/b/c by the caller (no row override, unlike keps_tridiag_solve ). rhs returns the solution; cp scratch.\na/b/c are read-only so one factorisation can serve multiple RHS. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: a (n) real(kind=wp), intent(in) :: b (n) real(kind=wp), intent(in) :: c (n) real(kind=wp), intent(inout) :: rhs (n) real(kind=wp), intent(inout) :: cp (n) integer, intent(in) :: n Called by proc~~keps_tridiag_solve_noflux~~CalledByGraph proc~keps_tridiag_solve_noflux keps_tridiag_solve_noflux proc~ml_keps_apply_diffusion_tracer ml_keps_apply_diffusion_tracer proc~ml_keps_apply_diffusion_tracer->proc~keps_tridiag_solve_noflux proc~ml_keps_apply_momentum ml_keps_apply_momentum proc~ml_keps_apply_momentum->proc~keps_tridiag_solve_noflux proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_keps_apply_diffusion_tracer proc~solver_multilayer_rk_stage->proc~ml_keps_apply_momentum proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: denom integer, private :: m Source Code pure subroutine keps_tridiag_solve_noflux ( a , b , c , rhs , cp , n ) !$acc routine seq !! In-place Thomas solve over rows 1..n with the boundary closure !! already baked into a/b/c by the caller (no row override, unlike !! `keps_tridiag_solve`).  `rhs` returns the solution; `cp` scratch. !! a/b/c are read-only so one factorisation can serve multiple RHS. integer , intent ( in ) :: n real ( wp ), intent ( in ) :: a ( n ), b ( n ), c ( n ) real ( wp ), intent ( inout ) :: rhs ( n ), cp ( n ) integer :: m real ( wp ) :: denom cp ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , n denom = b ( m ) - a ( m ) * cp ( m - 1 ) cp ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = n - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cp ( m ) * rhs ( m + 1 ) end do end subroutine keps_tridiag_solve_noflux","tags":"","url":"proc/keps_tridiag_solve_noflux.html"},{"title":"si_unstr_build_nu_interface_kpp – Rakali","text":"public pure subroutine si_unstr_build_nu_interface_kpp(nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, u_star, buoy_flux, bl_depth, nu_iface) PP81 interior interface viscosity with the KPP (LMD94) surface-\nboundary-layer overlay MAX’d in, for the SI implicit column solve:\n  nu = max( nu_max/(1+ri_alpha Ri)&#94;2 + nu_bg,\n            h_b * w_s * G(sigma) )        for interfaces inside h_b\nwith G(sigma) = sigma(1-sigma)&#94;2, sigma = d_iface/h_b, and the\nvelocity scale w_s = sqrt(u_ &#94;2 + w_ &#94;2), w_ &#94;3 = max(0,-B_0)*h_b.\nNO dt clamp: the consumer is the unconditionally-stable implicit\ntridiagonal.  Where the overlay is inactive (w_s = 0 / below the\nBL) the result is EXACTLY the PP81 si_unstr_build_nu_interface value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up. real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s]. real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(in) :: rho_layer (nz,nct) Layer densities [kg/m&#94;3]. real(kind=wp), intent(in) :: rho_0 Reference density [kg/m&#94;3]. real(kind=wp), intent(in) :: nu_max PP81 maximum turbulent viscosity [m&#94;2/s]. real(kind=wp), intent(in) :: nu_bg Background viscosity floor [m&#94;2/s]. real(kind=wp), intent(in) :: ri_alpha PP81 Richardson tuning coefficient. real(kind=wp), intent(in) :: u_star (nct) Surface friction velocity [m/s] (from ml_kpp_boundary_layer_unstr). real(kind=wp), intent(in) :: buoy_flux (nct) Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real(kind=wp), intent(in) :: bl_depth (nct) Diagnosed boundary-layer depth [m]. real(kind=wp), intent(out) :: nu_iface (nzp1,nct) Interface viscosity [m&#94;2/s], vdiff convention (bed/surface 0). Calls proc~~si_unstr_build_nu_interface_kpp~~CallsGraph proc~si_unstr_build_nu_interface_kpp si_unstr_build_nu_interface_kpp local local proc~si_unstr_build_nu_interface_kpp->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module