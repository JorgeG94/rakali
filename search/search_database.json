mid_y ( 2 , k ) - mesh % centroid_y ( k ) dyv2 = mesh % edge_mid_y ( 3 , k ) - mesh % centroid_y ( k ) select case ( mesh % n_boundaries ( k )) case ( 3 ) ! Isolated triangle -- constant (zeroth-order) edge values. call set_constant_edge_values_impl ( state % barotropic % stage_cv ( k ), stage_ev_local ) call set_constant_edge_values_impl ( state % barotropic % xmom_cv ( k ), xmom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % ymom_cv ( k ), ymom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % height_cv ( k ), height_ev_local ) case ( 2 ) call extrapolate_one_neighbour_branch ( & state , mesh , k , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & stage_ev_local , xmom_ev_local , ymom_ev_local , height_ev_local ) case default ! 0 or 1 boundary edges -- full 3-neighbour reconstruction. call extrapolate_three_neighbour_branch ( & state , mesh , k , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & stage_ev_local , xmom_ev_local , ymom_ev_local , height_ev_local ) end select ! Velocity-form recovery: if on, xmom_ev/ymom_ev hold velocities; ! multiply by reconstructed height to recover momenta. if ( state % extrapolate_velocity_second_order ) then do i = 1 , 3 xmom_ev_local ( i ) = xmom_ev_local ( i ) * height_ev_local ( i ) ymom_ev_local ( i ) = ymom_ev_local ( i ) * height_ev_local ( i ) end do end if ! Commit edge values for this cell. do i = 1 , 3 state % barotropic % stage_ev ( i , k ) = stage_ev_local ( i ) state % barotropic % xmom_ev ( i , k ) = xmom_ev_local ( i ) state % barotropic % ymom_ev ( i , k ) = ymom_ev_local ( i ) state % barotropic % height_ev ( i , k ) = height_ev_local ( i ) ! Recover bed from the well-balanced identity, preserving ! stage_ev = bed_ev + height_ev exactly (lake-at-rest). state % barotropic % bed_ev ( i , k ) = stage_ev_local ( i ) - height_ev_local ( i ) end do end subroutine extrapolate_one_cell","tags":"","url":"proc/extrapolate_one_cell.html"},{"title":"extrapolate_one_neighbour_branch – Rakali"