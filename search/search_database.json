o the live per-step `coef*Hf` (folded in at !! refresh) never changes the STRUCTURE — the hierarchy is static. !! Host-only (runs before enter_data); the diag/ke are placeholders here !! and are overwritten by the first `refresh` before any solve. class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nco integer :: l , nc , l_alloc , k , i , kn real ( wp ), allocatable :: str_l (:, :) real ( wp ), allocatable :: hf0 (:, :) ! ---- Level 1: the fine mesh operator structure (mv = 3) ---- call build_level1_structure ( this , mesh , nco ) call alloc_level_coeffs ( this % lev ( 1 )) allocate ( str_l ( this % lev ( 1 )% mv , this % lev ( 1 )% nc )) ! Uniform per-edge Hf=1 on interior edges => aggregation strength = ! len/delta (the geometric transmissibility).  Boundary edges left 0. allocate ( hf0 ( EDGES_PER_TRI , nco ), source = 0.0_wp ) do k = 1 , nco do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , k ) if ( kn > 0 . and . kn <= nco ) hf0 ( i , k ) = 1.0_wp end do end do call level1_operator ( mesh , nco , 1.0_wp , hf0 , this % lev ( 1 ), str_l ) deallocate ( hf0 ) l = 1 do nc = this % lev ( l )% nc if ( nc <= AGGLOM_MIN_SIZE . or . l >= AGGLOM_MAX_LEVELS ) exit ! Aggregate level l (strength = |ke| = str_l) -> define level l+1. call aggregate_and_build_coarse ( this , l , str_l ) if ( this % lev ( l + 1 )% nc >= nc ) then ! No coarsening achieved: drop the stub level, stop. call this % lev ( l + 1 )% destroy () this % n_levels = l exit end if call alloc_level_coeffs ( this % lev ( l + 1 )) if ( allocated ( str_l )) deallocate ( str_l ) allocate ( str_l ( this % lev ( l + 1 )% mv , this % lev ( l + 1 )% nc )) call galerkin_operator ( this % lev ( l ), this % lev ( l + 1 ), str_l ) l = l + 1 this % n_levels = l end do if ( allocated ( str_l )) deallocate ( str_l ) ! Shrink the level array to n_levels (it was over-allocated). l_alloc = size ( this % lev ) if ( this % n_levels < l_alloc ) call trim_levels ( this ) call global_logger % info ( \"si_unstr_mg: built \" // & itoa ( this % n_levels ) // \" levels (fine nc=\" // & itoa ( this % lev ( 1 )% nc ) // \", coarse nc=\" // & itoa ( this % lev ( this % n_levels )% nc ) // \")\" ) end subroutine agglom_hierarchy_unstr_build","tags":"","url":"proc/agglom_hierarchy_unstr_build.html"},{"title":"agglom_hierarchy_unstr_refresh – Rakali","text":"public  subroutine agglom_hierarchy_unstr_refresh(this, mesh, nco, coef, Hf_edge) Rebuild every level’s ke/diag/dinv from the current frozen per-edge Hf_edge (the same array the operator + RHS use) + push to the\ndevice.  Fine level from the mesh; coarse levels by the Galerkin\ncascade.  Structures are static.  Runs ONCE PER STEP (host loop), NOT\nper V-cycle. Hf_edge is device-resident; the caller pulls it self\nbefore calling (host build reads it). Arguments Type Intent Optional Attributes Name class( agglom_hierarchy_unstr_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nco real(kind=wp), intent(in) :: coef real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,nco) Calls proc~~agglom_hierarchy_unstr_refresh~~CallsGraph proc~agglom_hierarchy_unstr_refresh agglom_hierarchy_unstr_refresh proc~galerkin_operator galerkin_operator proc~agglom_hierarchy_unstr_refresh->proc~galerkin_operator proc~level1_operator level1_operator proc~agglom_hierarchy_unstr_refresh->proc~level1_operator proc~level_coeffs_to_device level_coeffs_to_device proc~agglom_hierarchy_unstr_refresh->proc~level_coeffs_to_device proc~find_slot find_slot proc~galerkin_operator->proc~find_slot error error proc~find_slot->error proc~itoa itoa proc~find_slot->proc~itoa Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point fr