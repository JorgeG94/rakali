teger, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny Source Code pure subroutine compute_rk2_average_layers ( u_layer , v_layer , w , & u_layer0 , v_layer0 , w0 , & grid , nz ) !! RK2 averaging for layer fields: 0.5 * (old + new) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: u_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: w0 ( grid % nx_total , grid % ny_total , nz + 1 ) integer :: i , j , k , nx , ny , nghost nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) u_layer ( i , j , k ) = 0.5_wp * ( u_layer0 ( i , j , k ) + u_layer ( i , j , k )) v_layer ( i , j , k ) = 0.5_wp * ( v_layer0 ( i , j , k ) + v_layer ( i , j , k )) end do do concurrent ( k = 1 : nz + 1 , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) w ( i , j , k ) = 0.5_wp * ( w0 ( i , j , k ) + w ( i , j , k )) end do end subroutine compute_rk2_average_layers","tags":"","url":"proc/compute_rk2_average_layers.html"},{"title":"compute_vert_coefficients – Rakali","text":"public pure subroutine compute_vert_coefficients(dsig, nz, dt, vert_lo, vert_hi) Pre-compute vertical coupling coefficients (dsig-dependent part only) vert_lo(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k-1)) * dsig(k))  for k=2..nz\nvert_hi(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k+1)) * dsig(k))  for k=1..nz-1\nIn the operator, multiply by 1/h(i,j) to get the full coefficient. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: dsig (nz) integer, intent(in) :: nz real(kind=wp), intent(in) :: dt real(kind=wp), intent(out) :: vert_lo (nz) real(kind=wp), intent(out) :: vert_hi (nz) Called by proc~~compute_vert_coefficients~~CalledByGraph proc~compute_vert_coefficients compute_vert_coefficients proc~solve_nh_pressure solve_nh_pressure proc~solve_nh_pressure->proc~compute_vert_coefficients proc~solver_baroclinic_rk_stage solver_baroclinic_rk_stage proc~solver_baroclinic_rk_stage->proc~solve_nh_pressure proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~solve_nh_pressure proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_baroclinic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: inv_dt2 integer, private :: k Source Code pure subroutine compute_vert_coefficients ( dsig , nz , dt , vert_lo , vert_hi ) !! Pre-compute vertical coupling coefficients (dsig-dependent part only) !! !! vert_lo(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k-1)) * dsig(k))  for k=2..nz !! vert_hi(k) = 2 / (dt&#94;2 * (dsig(k) + dsig(k+1)) * dsig(k))  for k=1..nz-1 !! In the operator, multiply by 1/h(i,j) to get the full coefficient. integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt real ( wp ), intent ( out ) :: vert_lo ( nz ) real ( wp ), intent ( out ) :: vert_hi ( nz ) integer :: k real ( wp ) :: inv_dt2 inv_dt2 = 1.0_wp / ( dt * dt ) vert_lo ( 1 ) = 0.0_wp do k = 2 , nz vert_lo ( k ) = 2.0_wp * inv_dt2 / (( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) end do do k = 1 , nz - 1 vert_hi ( k ) = 2.0_wp * inv_dt2 / (( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) end do vert_hi ( nz ) = 0.0_wp end subroutine compute_vert_coefficients","tags":"","url":"proc/compute_vert_coefficients.html"},{"title":"compute_vertical_velocity – Rakali","text":"public pure subroutine compute_vertical_velocity(h, u_layer, v_layer, b, dsig, w, grid, nz) Integrate continuity equation bottom-up to get vertical velocity w(:,:,1) = 0 at bottom\nw(:,:,k+1) = w(:,:,k) - dsig_k * [d(h u_k)/dx + d(h v_k)/dy]\nusing central differences for horizontal divergence Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~compute_vertical_velocity~~CallsGraph proc~compute_vertical_velocity compute_vertical_velocity local local proc~compute_vertical_velocity->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Func