ymom , h , eps4 , h4 , a_prev real ( wp ) :: speed_sq , fr_max_sq , fr_scale real ( wp ) :: mass_error_local n = mesh % ncells_owned a_prev = 1.0_wp - a_n mass_error_local = 0.0_wp eps4 = DESING_EPS ** 4 do concurrent ( k = 1 : n ) & local ( stage , xmom , ymom , h , h4 , speed_sq , fr_max_sq , fr_scale ) & reduce ( + : mass_error_local ) stage = a_n * state % barotropic % stage_backup ( k ) + a_prev * state % barotropic % stage_cv ( k ) xmom = a_n * state % barotropic % xmom_backup ( k ) + a_prev * state % barotropic % xmom_cv ( k ) ymom = a_n * state % barotropic % ymom_backup ( k ) + a_prev * state % barotropic % ymom_cv ( k ) h = stage - state % barotropic % bed_cv ( k ) if ( h < DRY_TOLERANCE ) then ! Dry (or negative) -- zero momentum. xmom = 0.0_wp ymom = 0.0_wp else ! Thin-but-wet: KP07 desingularized velocity ! u = sqrt(2) h uh / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)), uh := h*u ! (identity for h >= eps, so applied only below eps), then ! the Froude backstop — blowup arrester only (triggers on a ! TRUE comparison, so NaN passes through and fails loudly). h4 = h ** 4 if ( h4 < eps4 ) then xmom = h * ( sqrt ( 2.0_wp ) * h * xmom / sqrt ( h4 + eps4 )) ymom = h * ( sqrt ( 2.0_wp ) * h * ymom / sqrt ( h4 + eps4 )) end if speed_sq = ( xmom ** 2 + ymom ** 2 ) / ( h * h ) fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) xmom = xmom * fr_scale ymom = ymom * fr_scale end if end if if ( h < 0.0_wp ) then mass_error_local = mass_error_local + ( - h ) * mesh % area ( k ) stage = state % barotropic % bed_cv ( k ) end if state % barotropic % stage_cv ( k ) = stage state % barotropic % xmom_cv ( k ) = xmom state % barotropic % ymom_cv ( k ) = ymom end do state % mass_error = state % mass_error + mass_error_local end subroutine ssp_combine_unstr","tags":"","url":"proc/ssp_combine_unstr.html"},{"title":"mem_device_free_bytes – Rakali","text":"public  function mem_device_free_bytes() result(bytes) Free m