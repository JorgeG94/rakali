s Type Visibility Attributes Name Initial integer, private :: count3 (3) integer, private :: start3 (3) Source Code subroutine load_snapshot ( forc , ncid , tidx , u10 , v10 , msl , tp ) !! Read one time snapshot of all forcing fields from NetCDF type ( forcing_t ), intent ( in ) :: forc integer , intent ( in ) :: ncid integer , intent ( in ) :: tidx !! 1-based time index to read real ( wp ), intent ( out ) :: u10 (:, :), v10 (:, :), msl (:, :), tp (:, :) integer :: start3 ( 3 ), count3 ( 3 ) start3 = [ 1 , 1 , tidx ] count3 = [ forc % nlon , forc % nlat , 1 ] u10 = 0.0_wp v10 = 0.0_wp msl = 0.0_wp tp = 0.0_wp if ( forc % varid_u10 >= 0 ) then call nc_check ( nf90_get_var ( ncid , forc % varid_u10 , u10 , & start = start3 , count = count3 ), \"reading u10\" ) end if if ( forc % varid_v10 >= 0 ) then call nc_check ( nf90_get_var ( ncid , forc % varid_v10 , v10 , & start = start3 , count = count3 ), \"reading v10\" ) end if if ( forc % varid_msl >= 0 ) then call nc_check ( nf90_get_var ( ncid , forc % varid_msl , msl , & start = start3 , count = count3 ), \"reading msl/sp\" ) end if if ( forc % varid_tp >= 0 ) then call nc_check ( nf90_get_var ( ncid , forc % varid_tp , tp , & start = start3 , count = count3 ), \"reading tp\" ) end if end subroutine load_snapshot","tags":"","url":"proc/load_snapshot.html"},{"title":"read_forcing_grid – Rakali","text":"private  subroutine read_forcing_grid(forc, ncid) Read lon, lat, time coordinate arrays from the forcing file Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(inout) :: forc integer, intent(in) :: ncid Calls proc~~read_forcing_grid~~CallsGraph proc~read_forcing_grid read_forcing_grid nf90_get_var nf90_get_var proc~read_forcing_grid->nf90_get_var proc~nc_check nc_check proc~read_forcing_grid->proc~nc_check proc~nc_get_dim_len nc_get_dim_len proc~read_forcing_grid->proc~nc_get_dim_len proc~nc_get_varid nc_get_varid proc~read_forcing_grid->proc~nc_get_varid error error proc~nc_check->error nf90_strer