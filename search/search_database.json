 hTr (:,:,:) real(kind=wp), public, allocatable :: hTr0 (:,:,:) real(kind=wp), public :: hdiff_kappa = 0.0_wp Horizontal Laplacian diffusivity (m&#94;2/s) real(kind=wp), public :: kappa_bg = 0.0_wp Background vertical diffusivity (m&#94;2/s) character(len=64), public :: long_name = \"\" character(len=32), public :: name = \"\" character(len=64), public :: standard_name = \"\" CF-1.11 standard_name (e.g. “sea_water_salinity”).  Empty\nstring => no standard_name attribute is written. real(kind=wp), public :: tr_inflow = 0.0_wp BC inflow concentration for BC_INFLOW / BC_DISCHARGE real(kind=wp), public :: tr_init = 0.0_wp Uniform initial concentration (set by init from cfg) real(kind=wp), public :: tr_max = huge(1.0_wp) Physical upper clamp bound real(kind=wp), public :: tr_min = -huge(1.0_wp) Physical lower clamp bound character(len=16), public :: units = \"\" Type-Bound Procedures procedure, public, non_overridable :: bytes => tracer_bytes private pure function tracer_bytes (this) result(nbytes) Counted allocatable footprint of one tracer (hTr + RK2 save). Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(in) :: this Return Value integer(kind=int64) procedure, public, non_overridable :: destroy => tracer_destroy private  subroutine tracer_destroy (this) Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(inout) :: this procedure, public, non_overridable :: init => tracer_init private  subroutine tracer_init (this, grid, nz) Allocate hTr / hTr0 at the multilayer grid size, zero-filled.\nCaller is responsible for populating the prognostic field\n(e.g. hTr = h_layer * tr_init ) after layer thicknesses are set. Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Source Code type :: tracer_t ! Identity (used for output/config lookup).  All four strings are ! written verbatim onto the NetCDF variable; output loops over the ! registry, so a new tracer needs no changes to `rki_output`. character ( len = 32 ) :: name = \"\" character ( len = 64 ) :: long_name = \"\" character ( len = 16 ) :: units = \"\" character ( len = 64 ) :: standard_name = \"\" !! CF-1.11 standard_name (e.g. \"sea_water_salinity\").  Empty !! string => no standard_name attribute is written. ! Prognostic field and RK2 save (nx_total, ny_total, nz_ml) real ( wp ), allocatable :: hTr (:, :, :) real ( wp ), allocatable :: hTr0 (:, :, :) ! Scalar config real ( wp ) :: tr_init = 0.0_wp !! Uniform initial concentration (set by init from cfg) real ( wp ) :: tr_inflow = 0.0_wp !! BC inflow concentration for BC_INFLOW / BC_DISCHARGE real ( wp ) :: tr_min = - huge ( 1.0_wp ) !! Physical lower clamp bound real ( wp ) :: tr_max = huge ( 1.0_wp ) !! Physical upper clamp bound real ( wp ) :: kappa_bg = 0.0_wp !! Background vertical diffusivity (m&#94;2/s) real ( wp ) :: hdiff_kappa = 0.0_wp !! Horizontal Laplacian diffusivity (m&#94;2/s) ! Linear EOS contribution: rho_anomaly += eos_coeff * (Tr - eos_ref) ! Salinity: eos_coeff = +beta_S, eos_ref = S_ref ! Temperature: eos_coeff = -alpha_T, eos_ref = T_ref ! Passive scalar: eos_coeff = 0 real ( wp ) :: eos_coeff = 0.0_wp real ( wp ) :: eos_ref = 0.0_wp integer :: budget_id = TRACER_BUDGET_NONE !! Which conservation-budget contributor slot this tracer's !! kernels fill on the OCEAN path: NONE (no budget — passive !! tracers, ideal age, pseudo-salt), HEAT (`heat_budget_*`) or !! SALT (`salt_budget_*`).  Read HOST-side only, at the seven !! budget dispatch blocks; never dereferenced inside a device !! loop.  Unused on the coastal paths (no budget slots there) — !! left at NONE. ! Pipeline opt-outs (skip work for diagnostic/passive tracers) logical :: do_horizontal_advection = . true . logical :: do_vertical_exchange = . true . logical :: do_vertical_diffusion = . true . logical :: do_horizontal_diffusion = . true . logical :: do_clamp = . true . contains procedure , non_overridable :: init => tracer_init procedure , non_overridable :: destroy => tracer_destroy procedure , non_overridable :: bytes => tracer_bytes end type tracer_t","tags":"","url":"type/tracer_t.html"},{"title":"unstr_multilayer_state_t – Rakali ","text":"type, public :: unstr_multilayer_state_t Per-layer prognostic arrays + tracer registry + multilayer scalar config. Inherits type~~unstr_multilayer_state_t~~InheritsGraph type~unstr_multilayer_state_t unstr_multilayer_state_t type~eos_t eos_t type~unstr_multilayer_state_t->type~eos_t eos type~unstr_tracer_t unstr_tracer_t type~unstr_multilayer_state_t->type~unstr_tracer_t tracers type~vcoord_t vcoord_t type~unstr_multilayer_state_t->type~vcoord_t vcoord Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Inherited by type~~unstr_multilayer_state_t~~InheritedByGraph type~unstr_multilayer_state_t unstr_multilayer_state_t type~unstr_state_t unstr_state_t type~unstr_state_t->type~unstr_multilayer_state_t multilayer type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public :: S_init_bottom = 0.0_wp Linear-S(z) stratification, bed (k=1) value.  See S_init_surface. real(kind=wp), public :: S_init_surface = 0.0_wp Linear-S(z) stratification, surface (k=nz) value.  When both\nS_init_surface and S_init_bottom are non-zero (and nz>1) the\nsalinity seed becomes a linear profile from S_init_bottom at\nthe bed (k=1) to S_init_surface at the surface; otherwise the\nuniform initial_salinity is used.  Stable polarity is the\ninverse of temperature: S_init_bottom > S_init_surface (salty\nbed, fresh surface). real(kind=wp), public :: S_max = 40.0_wp real(kind=wp), public :: S_min = 0.0_wp real(kind=wp), public :: S_ref = 0.0_wp real(kind=wp), public :: T_init_bottom = 0.0_wp Linear-T(z) stratification, bed (k=1) value.  See T_init_surface. real(kind=wp), public :: T_init_surface = 0.0_wp Linear-T(z) stratification, surface (k=nz) value.  When both\nT_init_surface and T_init_bottom are non-zero (and nz>1) the\ntemperature seed becomes a linear profile from T_init_bottom at\nthe bed (k=1) to T_init_surface at the surface; otherwise the\nuniform initial_temperature is used.  Mirrors the ocean path. real(kind=wp), public :: T_max = 40.0_wp real(kind=wp), public :: T_min = -2.0_wp real(kind=wp), public :: T_ref = 15.0_wp real(kind=wp), public :: alpha_T = 0.17_wp real(kind=wp), public :: bc_S_ext (MAX_BC_GROUPS) = 35.0_wp real(kind=wp), public :: bc_T_ext (MAX_BC_GROUPS) = 15.0_wp real(kind=wp), public :: beta_S = 0.78_wp real(kind=wp), public, allocatable :: dsig_ml (:) Sigma layer fractions (nz_ml), sum = 1. type( eos_t ), public :: eos Shared EOS handle (variant tag + scalar coefficients) for\nthe opt-in path.  Flat POD — passed by value into the\ndevice kernel, no enter_data/exit_data mapping needed. eos%rho0 mirrors rho_0 ; eos%p_ref stays 0 ⇒\nsurface/potential density. logical, public :: eos_use_shared = .false. When .true. ml_equation_of_state_unstr routes through the\nshared rki_eos point evaluation instead of the\nlegacy linear kernel.  Default off ⇒ bit-identical.  Set\nfrom &tracer_nml eos_form via ml_parse_eos_form (driver). logical, public :: evap_latent_cooling = .false. When true (needs evap_mass_sink), evaporation additionally\nwithdraws its latent heat of vaporization from the surface layer\n(k=nz).  Mirrors the structured evap_latent_cooling .  Default\nfalse = bit-identical. logical, public :: evap_mass_sink = .false. When true, net evaporation is a real water-mass sink removed\nCOLUMN-PROPORTIONALLY (salt held, heat carried away with the\nwater) rather than a virtual salt flux.  Mirrors the structured evap_mass_sink .  Default false = bit-identical (virtual salt). real(kind=wp), public, allocatable :: h_layer (:,:) real(kind=wp), public, allocatable :: h_layer0 (:,:) real(kind=wp), public :: hdiff_kappa = 0.0_wp real(kind=wp), public, allocatable :: hu_layer (:,:) real(kind=wp), public, allocatable :: hu_layer0 (:,:) real(kind=wp), public, allocatable :: hv_layer (:,:) real(kind=wp), public, allocatable :: hv_layer0 (:,:) integer, public :: idx_salinity = 0 Index into tracers(:) for salinity. 0 = not registered. integer, public :: idx_temperature = 0 Index into tracers(:) for temperature. 0 = not registered. real(kind=wp), public :: initial_salinity = 35.0_wp real(kind=wp), public :: initial_temperature = 15.0_wp real(kind=wp), public :: kappa_S_bg = 1.0e-5_wp real(kind=wp), public :: kappa_T_bg = 1.0e-5_wp real(kind=wp), public, allocatable :: keps_eps (:,:) Dissipation rate at interfaces (nz+1, ncell); state. real(kind=wp), public, allocatable :: keps_eps0 (:,:) Pre-step dissipation-rate save slot (nz+1, ncells_total); co-\nallocated with keps_tke0. real(kind=wp), public, allocatable :: keps_kt (:,:) Scalar (tracer) diffusivity at interfaces (nz+1, ncell); carried. real(kind=wp), public, allocatable :: keps_nut (:,:) Eddy viscosity at interfaces (nz+1, ncell); carried across steps. integer, public :: keps_si_picard = 1 Picard iteration count for the SI k-eps solve (1 = single pass;\n2+ enables save/restore of the pre-step tke/eps and re-runs\nml_keps_update_unstr from the same initial state with the\nrefreshed nu_t production coefficient).  Mirrors the structured keps_si_picard knob. integer, public :: keps_stability = KEPS_STAB_CONSTANT Stability-function scheme: constant / galperin / canuto. real(kind=wp), public, allocatable :: keps_tke (:,:) Turbulent kinetic energy at interfaces (nz+1, ncell); state. real(kind=wp), public, allocatable :: keps_tke0 (:,:) Pre-step TKE save slot (nz+1, ncells_total); allocated only when\nvmix_use_keps .and. keps_si_picard > 1. real(kind=wp), public, allocatable :: keps_ustar_b (:) Bed friction velocity (m/s), per cell. real(kind=wp), public, allocatable :: keps_ustar_s (:) Surface friction velocity sqrt(|tau_wind|/rho_0) (m/s), per cell. real(kind=wp), public, allocatable :: kpp_bl_depth (:) Diagnosed boundary-layer depth (m, positive down), per cell.\nPersists across steps — the previous value seeds the V_t&#94;2\nvelocity scale (self-bootstraps from zero on the first call). real(kind=wp), public, allocatable :: kpp_buoy_flux (:) Surface buoyancy flux B_0 (m&#94;2/s&#94;3); <0 = destabilizing. real(kind=wp), public :: kpp_c_vt2 = 1.8_wp Unresolved-turbulence coefficient for V_t&#94;2 (LMD94 eq 23). real(kind=wp), public :: kpp_cs_nonlocal = 6.3_wp Non-local transport coefficient C_s (LMD94 eq 20). real(kind=wp), public :: kpp_ri_crit = 0.3_wp Critical bulk Richardson number for the BL-depth sweep. real(kind=wp), public, allocatable :: kpp_u_star (:) Surface friction velocity sqrt(|tau|/rho_0) (m/s), per cell. real(kind=wp), public, allocatable :: ml_hdiff_hTr_pre (:,:) Jacobi snapshot for the horizontal-diffusion kernel. real(kind=wp), public, allocatable :: ml_horvisc_hu_pre (:,:) Jacobi snapshot for the Smagorinsky horizontal-viscosity kernel. real(kind=wp), public, allocatable :: ml_horvisc_hv_pre (:,:) real(kind=wp), public, allocatable :: ml_lgrad_x (:,:) Limited Green-Gauss gradient (x) for MUSCL advection. real(kind=wp), public, allocatable :: ml_lgrad_y (:,:) integer, public :: nz_ml = 1 Number of multilayer sigma layers. integer, public :: nz_ref = 0 logical, public :: registry_locked = .false. Set by tracers_enter_data (rki_state_unstr), cleared by tracers_exit_data .  While locked, register_passive_tracer REFUSES: the device map snapshots tracers(:) element-by-element, so growing the registry\nreallocates the array (and deep-copies every element’s hTr / hTr0 ), stranding every existing tracer’s device\nmapping on freed host addresses — an illegal address or a\nsilent stale-host read on the mem:separate GPU build. real(kind=wp), public, allocatable :: remap_dz_old (:,:) real(kind=wp), public :: rho_0 = 1000.0_wp Reference density for the linear EOS / Boussinesq scaling. real(kind=wp), public, allocatable :: rho_layer (:,:) real(kind=wp), public, allocatable :: rho_ref (:) Reference density profile sampled at iz * rho_ref_dz for iz = 0..nz_ref . Index 0 = surface. real(kind=wp), public :: rho_ref_dz = 0.0_wp real(kind=wp), public :: smagorinsky_cs = 0.0_wp real(kind=wp), public, allocatable :: tracer_advect_scratch (:,:) Jacobi snapshot for ml_advect_tracer_unstr / MUSCL. type( unstr_tracer_t ), public, allocatable :: tracers (:) logical, public :: use_bpg_jacobian = .true. Use the pressure-Jacobian BPG (Shchepetkin & McWilliams 2003).\nDEFAULT ON.  The sigma alternative differences the integrated\ndensity anomaly at constant SIGMA INDEX, which over sloping\nbathymetry produces a fictitious force proportional to\n(uniform density anomaly) x (bed slope) – so a column of\nspatially UNIFORM density whose value differs from rho_0 is\nspuriously accelerated, and the resulting flow leaks mass\n(measured: 1.7e-6 relative over 400 steps, vs 1.3e-14 with the\nJacobian).  Pinned by test_bpg_uniform_density . logical, public :: use_ppm_tracer = .true. Use MUSCL for tracer advection (false = first-order upwind). type( vcoord_t ), public :: vcoord Coordinate type (sigma / zsigma), remap method, parameters. real(kind=wp), public, allocatable :: vcoord_z_ref (:) Reference z-level interfaces (0:nz_ml), GPU-mapped copy of vcoord%z_ref .  Top-level allocatable so OpenACC can map\nit without nested derived-type pointer issues. real(kind=wp), public, allocatable :: vcoord_z_ref_col (:,:) Per-cell reference z-level interfaces for VCOORD_ZSTAR_FULL,\nshape (0:nz_ml, ncells_total).  Built once at solver init\nfrom local bathymetry; static thereafter.  Only allocated\nwhen coord_type == VCOORD_ZSTAR_FULL. real(kind=wp), public :: vmix_nu_bg = 1.0e-4_wp real(kind=wp), public :: vmix_nu_max = 0.01_wp real(kind=wp), public :: vmix_ri_alpha = 5.0_wp logical, public :: vmix_use_keps = .false. Master switch for the k-epsilon closure (default off). logical, public :: vmix_use_kpp = .false. Master switch for the KPP overlay (default off = pure PP81). real(kind=wp), public, allocatable :: w_interface (:,:) (nz_ml + 1, ncells_total) . Index 1 = bed, nz_ml+1 = surface. real(kind=wp), public, allocatable :: xmom_pre (:) real(kind=wp), public, allocatable :: ymom_pre (:) Type-Bound Procedures procedure, public, non_overridable :: destroy => unstr_multilayer_destroy private  subroutine unstr_multilayer_destroy (this) Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this procedure, public, non_overridable :: enter_data => unstr_multilayer_enter_data private  subroutine unstr_multilayer_enter_data (this) Map the multilayer allocatables onto the device. Parent state%multilayer rides over with the parent copyin(state) ;\nonly the inner allocatables need explicit attaches. The tracer\nregistry’s two-step attach is handled by tracers_enter_data (in rki_state_unstr ). Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this procedure, public, non_overridable :: exit_data => unstr_multilayer_exit_data private  subroutine unstr_multilayer_exit_data (this) Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this procedure, public, non_overridable :: init => unstr_multilayer_init private  subroutine unstr_multilayer_init (this, mesh, nz_ml) Allocate every multilayer array at the cell counts in mesh and the configured layer count.  Initialises vcoord from\nits (already-set) coord_type / remap_method , allocates\nthe rho-ref profile, and registers the salinity + temperature\ntracers in the tracer registry. Read more… Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz_ml procedure, public, non_overridable :: register_passive_tracer => unstr_multilayer_register_passive_tracer private  subroutine unstr_multilayer_register_passive_tracer (this, mesh, name, tr_init, tr_min, tr_max, kappa_bg, hdiff_kappa) Append a passive tracer (eos_coeff = 0) to the registry. Must be\ncalled AFTER init and BEFORE state_unstr_enter_data (so the\nnew tracer’s hTr gets device-mapped) — enforced via registry_locked : once the registry is device-mapped the call\nlogs an error and returns without touching it. S/T keep their\nindices. Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh character(len=*), intent(in) :: name real(kind=wp), intent(in) :: tr_init real(kind=wp), intent(in) :: tr_min real(kind=wp), intent(in) :: tr_max real(kind=wp), intent(in) :: kappa_bg real(kind=wp), intent(in) :: hdiff_kappa Source Code type :: unstr_multilayer_state_t !! Per-layer prognostic arrays + tracer registry + multilayer scalar config. ! Layer count integer :: nz_ml = 1 !! Number of multilayer sigma layers. ! Vertical coordinate definition + GPU mirror type ( vcoord_t ) :: vcoord !! Coordinate type (sigma / zsigma), remap method, parameters. real ( wp ), allocatable :: dsig_ml (:) !! Sigma layer fractions (nz_ml), sum = 1. real ( wp ), allocatable :: vcoord_z_ref (:) !! Reference z-level interfaces (0:nz_ml), GPU-mapped copy of !! `vcoord%z_ref`.  Top-level allocatable so OpenACC can map !! it without nested derived-type pointer issues. real ( wp ), allocatable :: vcoord_z_ref_col (:, :) !! Per-cell reference z-level interfaces for VCOORD_ZSTAR_FULL, !! shape (0:nz_ml, ncells_total).  Built once at solver init !! from local bathymetry; static thereafter.  Only allocated !! when coord_type == VCOORD_ZSTAR_FULL. ! Layer prognostic arrays (nz_ml, ncells_total) real ( wp ), allocatable :: h_layer (:, :) real ( wp ), allocatable :: hu_layer (:, :) real ( wp ), allocatable :: hv_layer (:, :) ! RK2 saves (dynamics only — tracer RK2 saves live on tracers(it)%hTr0) real ( wp ), allocatable :: h_layer0 (:, :) real ( wp ), allocatable :: hu_layer0 (:, :) real ( wp ), allocatable :: hv_layer0 (:, :) ! EOS-derived density real ( wp ), allocatable :: rho_layer (:, :) ! Diagnostic vertical velocity at layer interfaces real ( wp ), allocatable :: w_interface (:, :) !! `(nz_ml + 1, ncells_total)`. Index 1 = bed, nz_ml+1 = surface. ! Generic tracer registry. Salinity / temperature live as the ! first two entries by default; sediment / passive tracers append. type ( unstr_tracer_t ), allocatable :: tracers (:) integer :: idx_salinity = 0 !! Index into tracers(:) for salinity. 0 = not registered. integer :: idx_temperature = 0 !! Index into tracers(:) for temperature. 0 = not registered. logical :: registry_locked = . false . !! Set by `tracers_enter_data` (rki_state_unstr), cleared by !! `tracers_exit_data`.  While locked, !! `register_passive_tracer` REFUSES: the device map snapshots !! `tracers(:)` element-by-element, so growing the registry !! reallocates the array (and deep-copies every element's !! `hTr`/`hTr0`), stranding every existing tracer's device !! mapping on freed host addresses — an illegal address or a !! silent stale-host read on the `mem:separate` GPU build. ! Reference-density profile. Subtracted in both BPG kernels so the ! integrand is `rho - rho_ref(z)` rather than `rho - rho_0` ! -- 10-100x smaller in stratified water. integer :: nz_ref = 0 real ( wp ) :: rho_ref_dz = 0.0_wp real ( wp ), allocatable :: rho_ref (:) !! Reference density profile sampled at `iz * rho_ref_dz` for !! `iz = 0..nz_ref`. Index 0 = surface. ! Per-step kernel workspaces (allocated alongside the prognostic ! arrays; mapped at enter_data so kernels never allocate per step). real ( wp ), allocatable :: tracer_advect_scratch (:, :) !! Jacobi snapshot for `ml_advect_tracer_unstr` / MUSCL. real ( wp ), allocatable :: ml_lgrad_x (:, :) !! Limited Green-Gauss gradient (x) for MUSCL advection. real ( wp ), allocatable :: ml_lgrad_y (:, :) real ( wp ), allocatable :: ml_hdiff_hTr_pre (:, :) !! Jacobi snapshot for the horizontal-diffusion kernel. real ( wp ), allocatable :: ml_horvisc_hu_pre (:, :) !! Jacobi snapshot for the Smagorinsky horizontal-viscosity kernel. real ( wp ), allocatable :: ml_horvisc_hv_pre (:, :) ! Barotropic momentum snapshot (saved before HLL update so ! `ml_distribute_barotropic_unstr` can spread the increment). real ( wp ), allocatable :: xmom_pre (:) real ( wp ), allocatable :: ymom_pre (:) ! Saved layer thicknesses before vertical-coordinate update. ! Only allocated when vcoord%needs_remap(). real ( wp ), allocatable :: remap_dz_old (:, :) ! ----- Scalar physics parameters ----- real ( wp ) :: initial_salinity = 3 5.0_wp real ( wp ) :: S_init_surface = 0.0_wp !! Linear-S(z) stratification, surface (k=nz) value.  When both !! S_init_surface and S_init_bottom are non-zero (and nz>1) the !! salinity seed becomes a linear profile from S_init_bottom at !! the bed (k=1) to S_init_surface at the surface; otherwise the !! uniform initial_salinity is used.  Stable polarity is the !! inverse of temperature: S_init_bottom > S_init_surface (salty !! bed, fresh surface). real ( wp ) :: S_init_bottom = 0.0_wp !! Linear-S(z) stratification, bed (k=1) value.  See S_init_surface. real ( wp ) :: S_ref = 0.0_wp real ( wp ) :: beta_S = 0.78_wp real ( wp ) :: S_min = 0.0_wp real ( wp ) :: S_max = 4 0.0_wp real ( wp ) :: kappa_S_bg = 1.0e-5_wp real ( wp ) :: initial_temperature = 1 5.0_wp real ( wp ) :: T_init_surface = 0.0_wp !! Linear-T(z) stratification, surface (k=nz) value.  When both !! T_init_surface and T_init_bottom are non-zero (and nz>1) the !! temperature seed becomes a linear profile from T_init_bottom at !! the bed (k=1) to T_init_surface at the surface; otherwise the !! uniform initial_temperature is used.  Mirrors the ocean path. real ( wp ) :: T_init_bottom = 0.0_wp !! Linear-T(z) stratification, bed (k=1) value.  See T_init_surface. real ( wp ) :: T_ref = 1 5.0_wp real ( wp ) :: alpha_T = 0.17_wp real ( wp ) :: T_min = - 2.0_wp real ( wp ) :: T_max = 4 0.0_wp real ( wp ) :: kappa_T_bg = 1.0e-5_wp real ( wp ) :: rho_0 = 100 0.0_wp !! Reference density for the linear EOS / Boussinesq scaling. ! Shared (ocean) nonlinear EOS — opt-in via `&tracer_nml eos_form` logical :: eos_use_shared = . false . !! When .true. `ml_equation_of_state_unstr` routes through the !! shared `rki_eos` point evaluation instead of the !! legacy linear kernel.  Default off ⇒ bit-identical.  Set !! from `&tracer_nml eos_form` via `ml_parse_eos_form` !! (driver). type ( eos_t ) :: eos !! Shared EOS handle (variant tag + scalar coefficients) for !! the opt-in path.  Flat POD — passed by value into the !! device kernel, no enter_data/exit_data mapping needed. !! `eos%rho0` mirrors `rho_0`; `eos%p_ref` stays 0 ⇒ !! surface/potential density. ! Pacanowski-Philander vertical mixing real ( wp ) :: vmix_nu_max = 0.01_wp real ( wp ) :: vmix_nu_bg = 1.0e-4_wp real ( wp ) :: vmix_ri_alpha = 5.0_wp ! KPP (Large et al. 1994) surface-boundary-layer overlay. When ! `vmix_use_kpp` is on, the solver swaps PP81 vmix for the KPP ! kernels (`rki_ml_kpp_unstr`): bulk-Ri BL-depth sweep, shape- ! function-enhanced diffusivity over PP81, non-local counter- ! gradient tracer transport. Per-cell fields allocated ! unconditionally (API can flip vmix_use_kpp after init; gating the ! allocation would leave them unmapped). logical :: vmix_use_kpp = . false . !! Master switch for the KPP overlay (default off = pure PP81). real ( wp ) :: kpp_ri_crit = 0.3_wp !! Critical bulk Richardson number for the BL-depth sweep. real ( wp ) :: kpp_cs_nonlocal = 6.3_wp !! Non-local transport coefficient C_s (LMD94 eq 20). real ( wp ) :: kpp_c_vt2 = 1.8_wp !! Unresolved-turbulence coefficient for V_t&#94;2 (LMD94 eq 23). real ( wp ), allocatable :: kpp_bl_depth (:) !! Diagnosed boundary-layer depth (m, positive down), per cell. !! Persists across steps — the previous value seeds the V_t&#94;2 !! velocity scale (self-bootstraps from zero on the first call). real ( wp ), allocatable :: kpp_u_star (:) !! Surface friction velocity sqrt(|tau|/rho_0) (m/s), per cell. real ( wp ), allocatable :: kpp_buoy_flux (:) !! Surface buoyancy flux B_0 (m&#94;2/s&#94;3); <0 = destabilizing. ! k-epsilon (two-equation GLS) vertical mixing. When `vmix_use_keps` ! is on, the solver swaps PP81/KPP for `rki_ml_keps_unstr`. Allocated ! unconditionally (mirrors KPP). Default off = bit-identical. logical :: vmix_use_keps = . false . !! Master switch for the k-epsilon closure (default off). integer :: keps_stability = KEPS_STAB_CONSTANT !! Stability-function scheme: constant / galperin / canuto. integer :: keps_si_picard = 1 !! Picard iteration count for the SI k-eps solve (1 = single pass; !! 2+ enables save/restore of the pre-step tke/eps and re-runs !! ml_keps_update_unstr from the same initial state with the !! refreshed nu_t production coefficient).  Mirrors the structured !! `keps_si_picard` knob. real ( wp ), allocatable :: keps_tke0 (:, :) !! Pre-step TKE save slot (nz+1, ncells_total); allocated only when !! vmix_use_keps .and. keps_si_picard > 1. real ( wp ), allocatable :: keps_eps0 (:, :) !! Pre-step dissipation-rate save slot (nz+1, ncells_total); co- !! allocated with keps_tke0. real ( wp ), allocatable :: keps_tke (:, :) !! Turbulent kinetic energy at interfaces (nz+1, ncell); state. real ( wp ), allocatable :: keps_eps (:, :) !! Dissipation rate at interfaces (nz+1, ncell); state. real ( wp ), allocatable :: keps_nut (:, :) !! Eddy viscosity at interfaces (nz+1, ncell); carried across steps. real ( wp ), allocatable :: keps_kt (:, :) !! Scalar (tracer) diffusivity at interfaces (nz+1, ncell); carried. real ( wp ), allocatable :: keps_ustar_s (:) !! Surface friction velocity sqrt(|tau_wind|/rho_0) (m/s), per cell. real ( wp ), allocatable :: keps_ustar_b (:) !! Bed friction velocity (m/s), per cell. ! Horizontal mixing real ( wp ) :: hdiff_kappa = 0.0_wp real ( wp ) :: smagorinsky_cs = 0.0_wp ! Scheme flags logical :: use_bpg_jacobian = . true . !! Use the pressure-Jacobian BPG (Shchepetkin & McWilliams 2003). !! DEFAULT ON.  The sigma alternative differences the integrated !! density anomaly at constant SIGMA INDEX, which over sloping !! bathymetry produces a fictitious force proportional to !! (uniform density anomaly) x (bed slope) -- so a column of !! spatially UNIFORM density whose value differs from `rho_0` is !! spuriously accelerated, and the resulting flow leaks mass !! (measured: 1.7e-6 relative over 400 steps, vs 1.3e-14 with the !! Jacobian).  Pinned by `test_bpg_uniform_density`. logical :: use_ppm_tracer = . true . !! Use MUSCL for tracer advection (false = first-order upwind). logical :: evap_mass_sink = . false . !! When true, net evaporation is a real water-mass sink removed !! COLUMN-PROPORTIONALLY (salt held, heat carried away with the !! water) rather than a virtual salt flux.  Mirrors the structured !! `evap_mass_sink`.  Default false = bit-identical (virtual salt). logical :: evap_latent_cooling = . false . !! When true (needs evap_mass_sink), evaporation additionally !! withdraws its latent heat of vaporization from the surface layer !! (k=nz).  Mirrors the structured `evap_latent_cooling`.  Default !! false = bit-identical. ! ----- Per-BC-group tracer inflow values ----- real ( wp ) :: bc_S_ext ( MAX_BC_GROUPS ) = 3 5.0_wp real ( wp ) :: bc_T_ext ( MAX_BC_GROUPS ) = 1 5.0_wp contains procedure , non_overridable :: init => unstr_multilayer_init procedure , non_overridable :: destroy => unstr_multilayer_destroy procedure , non_overridable :: enter_data => unstr_multilayer_enter_data procedure , non_overridable :: exit_data => unstr_multilayer_exit_data procedure , non_overridable :: register_passive_tracer => unstr_multilayer_register_passive_tracer end type unstr_multilayer_state_t","tags":"","url":"type/unstr_multilayer_state_t.html"},{"title":"vcoord_t – Rakali ","text":"type, public :: vcoord_t Inherited by type~~vcoord_t~~InheritedByGraph type~vcoord_t vcoord_t type~multilayer_state_t multilayer_state_t type~multilayer_state_t->type~vcoord_t vcoord type~unstr_multilayer_state_t unstr_multilayer_state_t type~unstr_multilayer_state_t->type~vcoord_t vcoord type~state_t state_t type~state_t->type~multilayer_state_t multilayer type~unstr_state_t unstr_state_t type~unstr_state_t->type~unstr_multilayer_state_t multilayer type~solver_handle_t solver_handle_t type~solver_handle_t->type~state_t state type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public :: blend_width = 50.0_wp Width of the blending zone (m) integer, public :: coord_type = VCOORD_SIGMA Vertical coordinate type (VCOORD_SIGMA, VCOORD_ZSIGMA, etc.) real(kind=wp), public :: depth_transition = 100.0_wp Depth (m) where sigma-to-z blending begins real(kind=wp), public, allocatable :: dsig_target (:) (nz) Target sigma-like layer fractions, sum = 1.0 integer, public :: nz = 0 Number of vertical layers integer, public :: remap_method = REMAP_PPM Remap reconstruction order (REMAP_PCM/PLM/PPM/PPM_H4/PQM). Default PPM.\nPQM falls back to PPM for nz < 5 (see remap_column_pqm ). real(kind=wp), public, allocatable :: z_ref (:) (nz+1) Reference interface depths for z-levels (m, positive down).\nOnly allocated for coord types that use z-levels. real(kind=wp), public :: zstar_h_min = 1.0e-4_wp Vanishing-layer floor (m).  Layers that would land below the\nlocal bed get clipped to this thickness rather than going to zero. real(kind=wp), public :: zstar_h_surf_target = 0.0_wp Target physical thickness of the surface layer (m).\n0 => auto: uniform per-column (falls back to lite behaviour\nper column).  Set > 0 to anchor the surface layer at a\nfixed thickness regardless of total depth H. integer, public :: zstar_n_surf = 0 Number of “fine” near-surface layers using stretching.\n0 => auto (use max(1, nz/3)) integer, public :: zstar_stretching = 1 Surface-concentration stretching: 1=log, 0=uniform Type-Bound Procedures procedure, public, non_overridable :: cleanup => vcoord_cleanup private  subroutine vcoord_cleanup (self) Deallocate all arrays.  Safe to call on uninitialised instances. Arguments Type Intent Optional Attributes Name class( vcoord_t ), intent(inout) :: self procedure, public, non_overridable :: enter_data => vcoord_enter_data private  subroutine vcoord_enter_data (self) Map read-only coordinate arrays to GPU. Arguments Type Intent Optional Attributes Name class( vcoord_t ), intent(inout) :: self procedure, public, non_overridable :: exit_data => vcoord_exit_data private  subroutine vcoord_exit_data (self) Unmap coordinate arrays from GPU. Arguments Type Intent Optional Attributes Name class( vcoord_t ), intent(inout) :: self procedure, public, non_overridable :: init => vcoord_init private  subroutine vcoord_init (self, nz, coord_type, remap_method) Initialise a vertical coordinate definition. Allocates + populates dsig_target for the given type. Unknown types: error stop. Arguments Type Intent Optional Attributes Name class( vcoord_t ), intent(inout) :: self integer, intent(in) :: nz Number of vertical layers integer, intent(in) :: coord_type Coordinate type constant (VCOORD_SIGMA, etc.) integer, intent(in) :: remap_method Remapping method constant (REMAP_PLM, etc.) procedure, public, non_overridable :: needs_remap => vcoord_needs_remap private pure function vcoord_needs_remap (self) result(needs_remap) Returns .true. if this coordinate type requires conservative\nvertical remapping after the barotropic step.  Pure sigma does\nnot — layers are simply rescaled by dsig(k) * H. Arguments Type Intent Optional Attributes Name class( vcoord_t ), intent(in) :: self Return Value logical Source Code type :: vcoord_t integer :: coord_type = VCOORD_SIGMA !! Vertical coordinate type (VCOORD_SIGMA, VCOORD_ZSIGMA, etc.) integer :: remap_method = REMAP_PPM !! Remap reconstruction order (REMAP_PCM/PLM/PPM/PPM_H4/PQM). Default PPM. !! PQM falls back to PPM for nz < 5 (see `remap_column_pqm`). integer :: nz = 0 !! Number of vertical layers real ( wp ), allocatable :: dsig_target (:) !! (nz) Target sigma-like layer fractions, sum = 1.0 real ( wp ), allocatable :: z_ref (:) !! (nz+1) Reference interface depths for z-levels (m, positive down). !! Only allocated for coord types that use z-levels. ! z-sigma hybrid parameters real ( wp ) :: depth_transition = 10 0.0_wp !! Depth (m) where sigma-to-z blending begins real ( wp ) :: blend_width = 5 0.0_wp !! Width of the blending zone (m) ! Full MOM6 z* parameters (VCOORD_ZSTAR_FULL) real ( wp ) :: zstar_h_surf_target = 0.0_wp !! Target physical thickness of the surface layer (m). !! 0 => auto: uniform per-column (falls back to