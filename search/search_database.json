proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: nh_iter Source Code subroutine solver_nh_rk_stage ( state , nz , use_nh ) !! One RK stage: BCs, flux, update, friction, then NH correction type ( state_t ), intent ( inout ) :: state integer , intent ( in ) :: nz logical , intent ( in ) :: use_nh integer :: nh_iter ! Save barotropic state before HLL update if ( use_nh ) then call save_barotropic_state ( state % barotropic % hu , state % barotropic % hv , & state % nh % hu_pre , state % nh % hv_pre , state % grid ) end if call profiler_start ( \"boundary\" ) call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) call profiler_stop ( \"boundary\" ) call profiler_start ( \"flux\" ) call solver_compute_barotropic_flux ( state ) call profiler_stop ( \"flux\" ) call profiler_start ( \"update\" ) call compute_update ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % flux_h , state % barotropic % flux_hu , state % barotropic % flux_hv , & state % grid , state % dt ) call profiler_stop ( \"update\" ) ! Distribute barotropic acceleration to layers if ( use_nh ) then call compute_layer_from_barotropic ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % nh % hu_pre , state % nh % hv_pre , & state % nh % u_layer , state % nh % v_layer , & state % nh % dsig , state % grid , nz , state % dt ) ! Compute vertical velocity from continuity call compute_vertical_velocity ( state % barotropic % h , state % nh % u_layer , state % nh % v_layer , & state % barotropic % b , state % nh % dsig , state % nh % w , & state % grid , nz ) ! Solve NH pressure (CG) and apply correction call profiler_start ( \"nh_pressure\" ) if ( mod ( state % step_count , state % nh % nh_solve_interval ) == 0 ) then call solve_nh_pressure ( state % barotropic % h , state % nh % u_layer , state % nh % v_layer , & state % nh % w , state % nh % q_nh , state % nh % dsig , & state % nh % cg_r , state % nh % cg_p , state % nh % cg_Ap , state % nh % cg_z , & state % grid , nz , state % dt , & state % nh % nh_max_iterations , state % nh % nh_tolerance , nh_iter , & state % nh % nh_preconditioner ) end if ! NH BCs for q_nh before applying correction call apply_nh_boundary_conditions ( state % nh % q_nh , state % nh % u_layer , & state % nh % v_layer , state % nh % w , & state % barotropic % h , state % barotropic % b , & state % grid , nz , state % bc ) call apply_nh_correction ( state % barotropic % h , state % nh % u_layer , state % nh % v_layer , & state % nh % w , state % nh % q_nh , state % nh % dsig , & state % grid , nz , state % dt ) call profiler_stop ( \"nh_pressure\" ) end if call profiler_start ( \"friction\" ) call apply_friction ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % dt , & state % barotropic % manning_n , state % forcing % wind_x , state % forcing % wind_y , & state % forcing % atm_pressure , state % forcing % precipitation , forcing_active = state % forcing % active ) call apply_coriolis ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % dt , state % barotropic % coriolis_f ) call profiler_stop ( \"friction\" ) ! Sponge layer relaxation (no-op when sponge_width <= 0) call apply_sponge ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % dt , state % bc ) end subroutine solver_nh_rk_stage","tags":"","url":"proc/solver_nh_rk_stage.html"},{"title":"solver_save_state – Rakali","text":"private pure subroutine solver_save_state(h, hu, hv, h0, hu0, hv0, grid) Copy current 2D state into saved arrays Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv0 (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid Called by proc~~solver_save_state~~CalledByGraph proc~solver_save_state solver_save_state proc~solver_advance_2d_generic solver_advance_2d_generic proc~solver_advance_2d_generic->proc~solver_save_state proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_save_state proc~solver_step_impl->proc~solver_advance_2d_generic proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_save_state proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_save_state proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_multilayer_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nod