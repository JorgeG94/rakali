kali","text":"public  subroutine nesting_init(nest, filename, state, x_origin, y_origin) Initialise nesting from a parent domain NetCDF file.\nPublic only for the unit-test suite. Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest character(len=*), intent(in) :: filename type( state_t ), intent(in) :: state real(kind=wp), intent(in), optional :: x_origin real(kind=wp), intent(in), optional :: y_origin Calls proc~~nesting_init~~CallsGraph proc~nesting_init nesting_init info info proc~nesting_init->info proc~allocate_parent_snapshots allocate_parent_snapshots proc~nesting_init->proc~allocate_parent_snapshots proc~compute_edge_weights compute_edge_weights proc~nesting_init->proc~compute_edge_weights proc~load_parent_snapshot load_parent_snapshot proc~nesting_init->proc~load_parent_snapshot proc~nc_get_varid nc_get_varid proc~nesting_init->proc~nc_get_varid proc~nc_open_read nc_open_read proc~nesting_init->proc~nc_open_read proc~read_parent_grid read_parent_grid proc~nesting_init->proc~read_parent_grid to_string to_string proc~nesting_init->to_string proc~find_bracket_1d find_bracket_1d proc~compute_edge_weights->proc~find_bracket_1d nf90_get_var nf90_get_var proc~load_parent_snapshot->nf90_get_var proc~nc_check nc_check proc~load_parent_snapshot->proc~nc_check nf90_inq_varid nf90_inq_varid proc~nc_get_varid->nf90_inq_varid proc~nc_get_varid->proc~nc_check nf90_open nf90_open proc~nc_open_read->nf90_open proc~nc_open_read->proc~nc_check proc~read_parent_grid->proc~nc_get_varid proc~read_parent_grid->nf90_get_var proc~read_parent_grid->proc~nc_check proc~nc_get_dim_len nc_get_dim_len proc~read_parent_grid->proc~nc_get_dim_len error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_get_dim_len->proc~nc_check nf90_inq_dimid nf90_inq_dimid proc~nc_get_dim_len->nf90_inq_dimid nf90_inquire_dimension nf90_inquire_dimension proc~nc_get_dim_len->nf90_inquire_dimension Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~nesting_init~~CalledByGraph proc~nesting_init nesting_init proc~nesting_init_from_config nesting_init_from_config proc~nesting_init_from_config->proc~nesting_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~nesting_init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: ncid Source Code subroutine nesting_init ( nest , filename , state , x_origin , y_origin ) !! Initialise nesting from a parent domain NetCDF file. !! Public only for the unit-test suite. type ( nesting_t ), intent ( inout ) :: nest character ( len =* ), intent ( in ) :: filename type ( state_t ), intent ( in ) :: state real ( wp ), intent ( in ), optional :: x_origin real ( wp ), intent ( in ), optional :: y_origin integer :: ncid if ( len_trim ( filename ) == 0 ) return nest % x_origin = 0.0_wp nest % y_origin = 0.0_wp if ( present ( x_origin )) nest % x_origin = x_origin if ( present ( y_origin )) nest % y_origin = y_origin call logger % info ( \"Loading nesting data from: \" // trim ( filename )) call nc_open_read ( filename , ncid ) nest % ncid = ncid ! Read parent grid call read_parent_grid ( nest , ncid ) ! Find variable IDs call nc_get_varid ( ncid , \"h\" , nest % varid_h ) call nc_get_varid ( ncid , \"hu\" , nest % varid_hu ) call nc_get_varid ( ncid , \"hv\" , nest % varid_hv ) ! Allocate snapshot arrays call allocate_parent_snapshots ( nest ) ! Precompute interpolation weights for boundary edges call compute_edge_weights ( nest , state ) ! Load first two snapshots if ( nest % p_nt >= 2 ) then nest % idx_lo = 1 nest % idx_hi = 2 call load_parent_snapshot ( nest , ncid , 1 , & nest % h_lo , nest % hu_lo , nest % hv_lo ) call load_parent_snapshot ( nest , ncid , 2 , & nest % h_hi , nest % hu_hi , nest % hv_hi ) else if ( nest % p_nt == 1 ) then nest % idx_lo = 1 nest % idx_hi = 1 call load_parent_snapshot ( nest , ncid , 1 , & nest % h_lo , nest % hu_lo , nest % hv_lo ) nest % h_hi = nest % h_lo nest % hu_hi = nest % hu_lo nest % hv_hi = nest % hv_lo end if nest % active = . true . call logger % info ( \"Parent grid: \" // to_string ( nest % p_nx ) // \" x \" // & to_string ( nest % p_ny ) // \", \" // & to_string ( nest % p_nt ) // \" time steps\" ) call logger % info ( \"Parent time range: \" // to_string ( nest % p_time ( 1 )) // & \" to \" // to_string ( nest % p_time ( nest % p_nt )) // \" s\" ) end subroutine nesting_init","tags":"","url":"proc/nesting_init.html"},{"title":"nesting_init_from_config – Rakali","text":"public  subroutine nesting_init_from_config(nest, cfg, state) Initialise nesting f