 per-edge !! `Hf_edge` (the same array the operator + RHS use) + push to the !! device.  Fine level from the mesh; coarse levels by the Galerkin !! cascade.  Structures are static.  Runs ONCE PER STEP (host loop), NOT !! per V-cycle.  `Hf_edge` is device-resident; the caller pulls it self !! before calling (host build reads it). class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nco real ( wp ), intent ( in ) :: coef real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nco ) integer :: l call level1_operator ( mesh , nco , coef , Hf_edge , this % lev ( 1 )) call level_coeffs_to_device ( this % lev ( 1 )) do l = 2 , this % n_levels call galerkin_operator ( this % lev ( l - 1 ), this % lev ( l )) call level_coeffs_to_device ( this % lev ( l )) end do end subroutine agglom_hierarchy_unstr_refresh","tags":"","url":"proc/agglom_hierarchy_unstr_refresh.html"},{"title":"agglom_unstr_vcycle_precond – Rakali","text":"public  subroutine agglom_unstr_vcycle_precond(this, r, z, area, nct, nco) z = M&#94;{-1} r for the AREA-WEIGHTED outer PCG: form rhs_hat = area*r,\nrun ONE V(2,2) cycle of the symmetric Ahat from zero, copy the\ncorrection into z (owned cells). r / z / area are the fine\n(ncell_total-shaped) device arrays; only the first nco owned entries\nare touched (ghost band left as the caller set it — pre-zeroed). Arguments Type Intent Optional Attributes Name class( agglom_hierarchy_unstr_t ), intent(inout) :: this real(kind=wp), intent(in) :: r (nct) real(kind=wp), intent(inout) :: z (nct) real(kind=wp), intent(in) :: area (nct) integer, intent(in) :: nct integer, intent(in) :: nco Calls proc~~agglom_unstr_vcycle_precond~~CallsGraph proc~agglom_unstr_vcycle_precond agglom_unstr_vcycle_precond proc~agglom_copy_out agglom_copy_out proc~agglom_unstr_vcycle_precond->proc~agglom_copy_out proc~agglom_scale_into_shim agglom_scale_into_shim proc~agglom_unstr_vcycle_precond->proc~agglom_scale_in