private :: nx integer, private :: ny Source Code pure subroutine save_barotropic_state ( hu , hv , hu_pre , hv_pre , grid ) !! Save barotropic momentum before HLL update type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hu_pre ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv_pre ( grid % nx_total , grid % ny_total ) integer :: i , j , nx , ny nx = grid % nx_total ny = grid % ny_total do concurrent ( j = 1 : ny , i = 1 : nx ) hu_pre ( i , j ) = hu ( i , j ) hv_pre ( i , j ) = hv ( i , j ) end do end subroutine save_barotropic_state","tags":"","url":"proc/save_barotropic_state.html"},{"title":"solve_nh_pressure – Rakali","text":"public  subroutine solve_nh_pressure(h, u_layer, v_layer, w, q_nh, dsig, cg_r, cg_p, cg_Ap, cg_z, grid, nz, dt, max_iter, tol, iter_out, use_preconditioner) Conjugate Gradient solver for the NH Poisson equation Warm-started from previous q_nh.\nOptionally uses vertical-line preconditioner (Thomas algorithm per column).\nSolves A * q = rhs where A is the Poisson operator and\nrhs comes from the velocity divergence. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: w (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(inout) :: q_nh (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(inout) :: cg_r (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_p (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_Ap (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: cg_z (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :