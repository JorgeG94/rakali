asulli wet/dry slots — reverse order of enter. if ( this % wetdry ) then !$acc exit data delete(this%newton_dz, this%newton_F, this%newton_Jeta) !$acc exit data delete(this%mass_diag, this%v_cell, this%rhs_d) !$acc exit data delete(this%b_sub, this%b_min, this%a_wet) end if ! P3.2 (3D multilayer) column slots — reverse order of enter. if ( this % nz_si > 1 ) then !$acc exit data delete(this%u_edge_layer, this%mass_flux_edge) !$acc exit data delete(this%Gbar_cell_x, this%Gbar_cell_y) !$acc exit data delete(this%nu_iface, this%Hhat_cell) !$acc exit data delete(this%g_col_u, this%g_col_v, this%r_col) end if !$acc exit data delete(this%eta_ghost_edge, this%u_n_edge) !$acc exit data delete(this%eta_diag, this%u_edge, this%u_star, this%Hf_edge) !$acc exit data delete(this%eta, this%eta_r, this%eta_p, this%eta_Ap, this%eta_z) end subroutine si_unstr_state_exit_data_impl","tags":"","url":"proc/si_unstr_state_exit_data_impl.html"},{"title":"si_unstr_state_init – Rakali","text":"private  subroutine si_unstr_state_init(this, mesh, nz, wetdry, n_sub) Allocate workspace arrays at the mesh size, zero-filled.  When nz is present and > 1 the P3.2 (3D multilayer) column slots are also\nallocated; when wetdry is present and .true. the P3.3 Casulli\nwet/dry slots are (with n_sub sub-bottoms, default 1); otherwise\nonly the 2D barotropic slots exist and the 2D path is unchanged.\nPlain host allocation (runs before enter_data , so a device loop\nwould round-trip). Type Bound semi_implicit_state_unstr_t Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in), optional :: nz Number of vertical layers.  Absent or <= 1 selects the 2D path. logical, intent(in), optional :: wetdry Casulli wetting/drying on.  Absent/.false. => slots unallocated. integer, intent(in), optional :: n_sub Subgrid sub-bottoms per cell (>= 1).  Absent => 1 (flat bottom). Called by proc~~si_unstr_state_init~~CalledByGraph proc~si_unstr_state_init semi_implicit_state_unstr_t%si_unstr_state_init proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_init proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: n integer, private :: ns integer, private :: nz_loc logical, private :: wd Source Code subroutine si_unstr_state_init ( this , mesh , nz , wetdry , n_sub ) !! Allocate workspace arrays at the mesh size, zero-filled.  When `nz` !! is present and > 1 the P3.2 (3D multilayer) column slots are also !! allocated; when `wetdry` is present and .true. the P3.3 Casulli !! wet/dry slots are (with `n_sub` sub-bottoms, default 1); otherwise !! only the 2D barotropic slots exist and the 2D path is unchanged. !! Plain host allocation (runs before `enter_data`, so a device loop !! would round-trip). class ( semi_implicit_state_unstr_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ), optional :: nz !! Number of vertical layers.  Absent or <= 1 selects the 2D path. logical , intent ( in ), optional :: wetdry !! Casulli wetting/drying on.  Absent/.false. => slots unallocated. integer , intent ( in ), optional :: n_sub !! Subgrid sub-bottoms per cell (>= 1).  Absent => 1 (flat bottom). integer :: n , nz_loc , ns logical :: wd n = mesh % ncells_total this % ncells_total = n nz_loc = 0 if ( present ( nz )) nz_loc = nz wd = . false . if ( present ( wetdry )) wd = wetdry ns = 1 if ( present ( n_sub )) ns = max ( 1 , n_sub ) allocate ( this % eta ( n ), source = 0.0_wp ) allocate ( this % eta_r ( n ), source = 0.0_wp ) allocate ( this % eta_p ( n ), source = 0.0_wp ) allocate ( this % eta_Ap ( n ), source = 0.0_wp ) allocate ( this % eta_z ( n ), source = 0.0_wp ) allocate ( this % eta_diag ( n ), source = 0.0_wp ) allocate ( this % u_edge ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % u_star ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % Hf_edge ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % eta_ghost_edge ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % u_n_edge ( EDGES_PER_TRI , n ), source = 0.0_wp ) ! --- P3.2 (3D multilayer) column slots (only when nz > 1) --- if ( nz_loc > 1 ) then this % nz_si = nz_loc allocate ( this % g_col_u ( nz_loc , n ), source = 0.0_wp ) allocate ( this % g_col_v ( nz_loc , n ), source = 0.0_wp ) allocate ( this % r_col ( nz_loc , n ), source = 0.0_wp ) allocate ( this % nu_iface ( nz_loc + 1 , n ), source = 0.0_wp ) allocate ( this % Hhat_cell ( n ), source = 0.0_wp ) allocate ( this % Gbar_cell_x ( n ), source = 0.0_wp ) allocate ( this % Gbar_cell_y ( n ), source = 0.0_wp ) allocate ( this % u_edge_layer ( nz_loc , EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % mass_flux_edge ( EDGES_PER_TRI , n ), source = 0.0_wp ) end if ! --- P3.3 Casulli wet/dry slots (only when wetdry on) --- if ( wd ) then this % wetdry = . true . this % n_sub = ns allocate ( this % b_sub ( ns , n ), source = 0.0_wp ) allocate ( this % b_min ( n ), source = 0.0_wp ) allocate ( this % a_wet ( n ), source = 1.0_wp ) allocate ( this % mass_diag ( n ), source = 1.0_wp ) allocate ( this % v_cell ( n ), source = 0.0_wp ) allocate ( this % rhs_d ( n ), source = 0.0_wp ) allocate ( this % newton_dz ( n ), source = 0.0_wp ) allocate ( this % newton_F ( n ), source = 0.0_wp ) allocate ( this % newton_Jeta ( n ), source = 0.0_wp ) end if end subroutine si_unstr_state_init","tags":"","url":"proc/si_unstr_state_init.html"},{"title":"apply_coriolis – Rakali","text":"public pure subroutine apply_coriolis(h, hu, hv, grid, dt, f) Apply Coriolis via the exact (energy-conserving) rotation:\n  hu_new =  hu cos(f dt) + hv sin(f dt)\n  hv_new = -hu sin(f dt) + hv cos(f dt) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (:,:) real(kind=wp), intent(inout) :: hu (:,:) real(kind=wp), intent(inout) :: hv (:,:) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: f Calls proc~~apply_coriolis~~CallsGraph proc~apply_coriolis apply_coriolis local local proc~apply_coriolis->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_coriolis~~CalledByGraph proc~apply_coriolis apply_coriolis proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~apply_coriolis proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~apply_coriolis proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_barotropic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: cosf real(kind=wp), private :: hu_old real(kind=wp), private :: hv_old integer, private :: i integer, private :: j integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: sinf Source Code pure subroutine apply_coriolis ( h , hu , hv , grid , dt , f ) !! Apply Coriolis via the exact (energy-conserving) rotation: !!   hu_new =  hu*cos(f*dt) + hv*sin(f*dt) !!   hv_new = -hu*sin(f*dt) + hv*cos(f*dt) type ( hgrid_t ), intent ( in ) :: grid ! assumed-shape-ok: Coriolis kernel is on the coastal barotropic path ! (not the ocean dycore hot path); h/hu/hv grid sizes are read from ! grid%nx_total/ny_total, not from the array descriptors. real ( wp ), intent ( in ) :: h (:, :) real ( wp ), intent ( inout ) :: hu (:, :), hv (:, :) ! assumed-shape-ok: coastal barotropic; grid dims from grid%nx_total real ( wp ), intent ( in ) :: dt , f integer :: i , j , nx , ny , nghost real ( wp ) :: cosf , sinf , hu_old , hv_old nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( abs ( f ) < 1.0e-20_wp ) return cosf = cos ( f * dt ) sinf = sin ( f * dt ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( hu_old , hv_old ) if ( h ( i , j ) > DRY_TOLERANCE ) then hu_old = hu ( i , j ) hv_old = hv ( i , j ) hu ( i , j ) = hu_old * cosf + hv_old * sinf hv ( i , j ) = - hu_old * sinf + hv_old * cosf end if end do end subroutine apply_coriolis","tags":"","url":"proc/apply_coriolis.html"},{"title":"apply_friction – Rakali","text":"public pure subroutine apply_friction(h, hu, hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, forcing_active, include_wind) Apply bottom friction, wind stress, atmospheric pressure gradient,\nand precipitation to (h, hu, hv). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt Timestep (s) real(kind=wp), intent(in) :: manning_n Manning roughness coefficient (s/m&#94;{1/3}) real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) logical, intent(in), optional :: forcing_active When .false., skip wind/pressure/precipitation (default: .true.) logical, intent(in), optional :: include_wind When .false., skip the wind stress (it is applied to the surface\nlayer instead — wind_surface_layer).  Default: .true. Calls proc~~apply_friction~~CallsGraph proc~apply_friction apply_friction local local proc~apply_friction->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_friction~~CalledByGraph proc~apply_friction apply_friction proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~apply_friction proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~apply_friction proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~apply_friction proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_barotropic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_multilayer_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: apply_wind real(kind=wp), private :: cf real(kind=wp), private :: denom real(kind=wp), private :: dpdx real(kind=wp), private :: dpdy real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: h_val logical, private :: has_forcing logical, private :: has_friction integer, private :: i integer, private :: j integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: speed real(kind=wp), private :: u_val real(kind=wp), private :: v_val Source Code pure subroutine apply_friction ( h , hu , hv , grid , dt , & manning_n , wind_x , wind_y , & atm_pressure , precipitation , & forcing_active , include_wind ) !! Apply bottom friction, wind stress, atmospheric pressure gradient, !! and precipitation to (h, hu, hv). type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt !! Timestep (s) real ( wp ), intent ( in ) :: manning_n !! Manning roughness coefficient (s/m&#94;{1/3}) real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: atm_pressure ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: precipitation ( grid % nx_total , grid % ny_total ) logical , intent ( in ), optional :: forcing_active !! When .false., skip wind/pressure/precipitation (default: .true.) logical , intent ( in ), optional :: include_wind !! When .false., skip the wind stress (it is applied to the surface !! layer instead — wind_surface_layer).  Default: .true. integer :: i , j , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: u_val , v_val , speed , cf , denom , h_val real ( wp ) :: dpdx , dpdy logical :: has_friction , has_forcing , apply_wind nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy has_friction = ( manning_n > 0.0_wp ) has_forcing = . true . if ( present ( forcing_active )) has_forcing = forcing_active apply_wind = . true . if ( present ( include_wind )) apply_wind = include_wind ! Early exit: no friction and no atmospheric forcing if (. not . has_friction . and . . not . has_forcing ) return if (. not . has_forcing ) then ! Fast path: friction only, no forcing array reads do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( u_val , v_val , speed , cf , denom , h_val ) h_val = h ( i , j ) if ( h_val > DRY_TOLERANCE ) then u_val = hu ( i , j ) / h_val v_val = hv ( i , j ) / h_val speed = sqrt ( u_val * u_val + v_val * v_val ) cf = GRAVITY * manning_n * manning_n / ( h_val ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed / h_val hu ( i , j ) = hu ( i , j ) / denom hv ( i , j ) = hv ( i , j ) / denom end if end do else ! Full path: friction + wind + pressure + precipitation do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( u_val , v_val , speed , cf , denom , h_val , dpdx , dpdy ) h_val = h ( i , j ) if ( h_val > DRY_TOLERANCE ) then u_val = hu ( i , j ) / h_val v_val = hv ( i , j ) / h_val speed = sqrt ( u_val * u_val + v_val * v_val ) if ( manning_n > 0.0_wp ) then cf = GRAVITY * manning_n * manning_n / ( h_val ** ( 1.0_wp / 3.0_wp )) ! Semi-implicit: divide by (1 + dt*cf*|u|/h) denom = 1.0_wp + dt * cf * speed / h_val hu ( i , j ) = hu ( i , j ) / denom hv ( i , j ) = hv ( i , j ) / denom end if ! Wind stress tau/rho; skipped when wind goes to the surface layer. if ( apply_wind ) then hu ( i , j ) = hu ( i , j ) + dt * wind_x ( i , j ) / RHO_WATER hv ( i , j ) = hv ( i , j ) + dt * wind_y ( i , j ) / RHO_WATER end if ! Atmospheric pressure gradient -(h/rho)*dp/dx, central diff. dpdx = ( atm_pressure ( i + 1 , j ) - atm_pressure ( i - 1 , j )) / ( 2.0_wp * dx ) dpdy = ( atm_pressure ( i , j + 1 ) - atm_pressure ( i , j - 1 )) / ( 2.0_wp * dy ) hu ( i , j ) = hu ( i , j ) - dt * h_val * dpdx / RHO_WATER hv ( i , j ) = hv ( i , j ) - dt * h_val * dpdy / RHO_WATER end if ! Precipitation: mass source (applied to all cells including dry) h ( i , j ) = h ( i , j ) + dt * precipitation ( i , j ) end do end if end subroutine apply_friction","tags":"","url":"proc/apply_friction.html"},{"title":"mesh_unstr_destroy – Rakali","text":"public  subroutine mesh_unstr_destroy(mesh) Release all allocatable arrays. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~mesh_unstr_destroy~~CalledByGraph proc~mesh_unstr_destroy mesh_unstr_destroy proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_destroy proc~rki_unstr_destroy rki_unstr_destroy proc~rki_unstr_destroy->proc~mesh_unstr_destroy proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine mesh_unstr_destroy ( mesh ) !! Release all allocatable arrays. type ( mesh_unstr_t ), intent ( inout ) :: mesh if ( allocated ( mesh % vert_x )) deallocate ( mesh % vert_x ) if ( allocated ( mesh % vert_y )) deallocate ( mesh % vert_y ) if ( allocated ( mesh % tri_v )) deallocate ( mesh % tri_v ) if ( allocated ( mesh % centroid_x )) deallocate ( mesh % centroid_x ) if ( allocated ( mesh % centroid_y )) deallocate ( mesh % centroid_y ) if ( allocated ( mesh % area )) deallocate ( mesh % area ) if ( allocated ( mesh % radius )) deallocate ( mesh % radius ) if ( allocated ( mesh % n_boundaries )) deallocate ( mesh % n_boundaries ) if ( allocated ( mesh % edge_len )) deallocate ( mesh % edge_len ) if ( allocated ( mesh % edge_n1 )) deallocate ( mesh % edge_n1 ) if ( allocated ( mesh % edge_n2 )) deallocate ( mesh % edge_n2 ) if ( allocated ( mesh % edge_mid_x )) deallocate ( mesh % edge_mid_x ) if ( allocated ( mesh % edge_mid_y )) deallocate ( mesh % edge_mid_y ) if ( allocated ( mesh % neighbours )) deallocate ( mesh % neighbours ) if ( allocated ( mesh % neighbour_edges )) deallocate ( mesh % neighbour_edges ) if ( allocated ( mesh % surrogate_neighbours )) deallocate ( mesh % surrogate_neighbours ) if ( allocated ( mesh % bc_group )) deallocate ( mesh % bc_group ) if ( allocated ( mesh % circumcentre_x )) deallocate ( mesh % circumcentre_x ) if ( allocated ( mesh % circumcentre_y )) deallocate ( mesh % circumcentre_y ) if ( allocated ( mesh % edge_delta )) deallocate ( mesh % edge_delta ) if ( allocated ( mesh % edge_dev_angle )) deallocate ( mesh % edge_dev_angle ) if ( allocated ( mesh % cell_global_id )) deallocate ( mesh % cell_global_id ) mesh % nverts = 0 mesh % ncells_owned = 0 mesh % ncells_total = 0 mesh % n_boundary_edges = 0 end subroutine mesh_unstr_destroy","tags":"","url":"proc/mesh_unstr_destroy.html"},{"title":"mesh_unstr_enter_data – Rakali","text":"public  subroutine mesh_unstr_enter_data(mesh) Map the read-only mesh geometry and topology arrays into device\nmemory. Called once at solver init alongside state_unstr_enter_data . Vertex coords + raw triangle vertex\nlist stay host-only (kernels never read them after init). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~mesh_unstr_enter_data~~CalledByGraph proc~mesh_unstr_enter_data mesh_unstr_enter_data proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_enter_data proc~rki_unstr_finalize rki_unstr_finalize proc~rki_unstr_finalize->proc~mesh_unstr_enter_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine mesh_unstr_enter_data ( mesh ) !! Map the read-only mesh geometry and topology arrays into device !! memory. Called once at solver init alongside !! `state_unstr_enter_data`. Vertex coords + raw triangle vertex !! list stay host-only (kernels never read them after init). type ( mesh_unstr_t ), intent ( inout ) :: mesh ! Parent struct descriptor first (MOM6-miniapp pattern), then ! components attach to it. EVERY allocatable component must appear ! in a per-component map below -- an allocated-but-unattached field ! leaves an invalid device pointer in the parent descriptor and the ! first `do concurrent` deref of `mesh%<anything>` trips ! CUDA_ERROR_ILLEGAL_ADDRESS. Partition metadata no kernel reads ! still must be attached to keep the parent descriptor well-formed. !$acc enter data copyin(mesh) !$acc enter data copyin(mesh%centroid_x, mesh%centroid_y, & !$acc&                  mesh%area, mesh%radius, & !$acc&                  mesh%n_boundaries, & !$acc&                  mesh%edge_len, mesh%edge_n1, mesh%edge_n2, & !$acc&                  mesh%edge_mid_x, mesh%edge_mid_y, & !$acc&                  mesh%neighbours, mesh%neighbour_edges, & !$acc&                  mesh%surrogate_neighbours, mesh%bc_group) !$acc enter data copyin(mesh%circumcentre_x, mesh%circumcentre_y, & !$acc&                  mesh%edge_delta, mesh%edge_dev_angle) end subroutine mesh_unstr_enter_data","tags":"","url":"proc/mesh_unstr_enter_data.html"},{"title":"mesh_unstr_exit_data – Rakali","text":"public  subroutine mesh_unstr_exit_data(mesh) Release the device copies of the mesh arrays. Counterpart to mesh_unstr_enter_data . Mesh data is read-only on the device,\nso nothing needs to be copied back. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~mesh_unstr_exit_data~~CalledByGraph proc~mesh_unstr_exit_data mesh_unstr_exit_data proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_exit_data proc~ensure_host ensure_host proc~ensure_host->proc~mesh_unstr_exit_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~rki_unstr_destroy rki_unstr_destroy proc~rki_unstr_destroy->proc~ensure_host Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine mesh_unstr_exit_data ( mesh ) !! Release the device copies of the mesh arrays. Counterpart to !! `mesh_unstr_enter_data`. Mesh data is read-only on the device, !! so nothing needs to be copied back. type ( mesh_unstr_t ), intent ( inout ) :: mesh ! Components first, parent struct last (mirror of enter_data). !$acc exit data delete(mesh%circumcentre_x, mesh%circumcentre_y, & !$acc&                 mesh%edge_delta, mesh%edge_dev_angle) !$acc exit data delete(mesh%centroid_x, mesh%centroid_y, & !$acc&                 mesh%area, mesh%radius, & !$acc&                 mesh%n_boundaries, & !$acc&                 mesh%edge_len, mesh%edge_n1, mesh%edge_n2, & !$acc&                 mesh%edge_mid_x, mesh%edge_mid_y, & !$acc&                 mesh%neighbours, mesh%neighbour_edges, & !$acc&                 mesh%surrogate_neighbours, mesh%bc_group) !$acc exit data delete(mesh) end subroutine mesh_unstr_exit_data","tags":"","url":"proc/mesh_unstr_exit_data.html"},{"title":"mesh_unstr_init_from_triangles – Rakali","text":"public  subroutine mesh_unstr_init_from_triangles(mesh, vert_x, vert_y, tri_v, bc_tags) Build a mesh_unstr_t from raw vertex coordinates and triangle\nvertex lists. Computes geometry, neighbour topology and the\nsurrogate-neighbour table. tri_v(1:3, k) are the vertex ids (1-based) of triangle k in CCW\norder. bc_tags(1:3, k) is an optional per-edge boundary group id per\ncell; only edges that are physical boundaries ( neighbours == -1 )\nkeep their tag, interior edges get 0. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(out) :: mesh real(kind=wp), intent(in) :: vert_x (:) real(kind=wp), intent(in) :: vert_y (:) integer, intent(in) :: tri_v (:,:) integer, intent(in), optional :: bc_tags (:,:) Calls proc~~mesh_unstr_init_from_triangles~~CallsGraph proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles error error proc~mesh_unstr_init_from_triangles->error info info proc~mesh_unstr_init_from_triangles->info proc~build_neighbours build_neighbours proc~mesh_unstr_init_from_triangles->proc~build_neighbours proc~build_surrogate_neighbours build_surrogate_neighbours proc~mesh_unstr_init_from_triangles->proc~build_surrogate_neighbours proc~compute_geometry compute_geometry proc~mesh_unstr_init_from_triangles->proc~compute_geometry proc~compute_si_geometry compute_si_geometry proc~mesh_unstr_init_from_triangles->proc~compute_si_geometry proc~count_boundary_edges count_boundary_edges proc~mesh_unstr_init_from_triangles->proc~count_boundary_edges to_char to_char proc~mesh_unstr_init_from_triangles->to_char proc~build_neighbours->error proc~build_neighbours->to_char proc~sort_by_key sort_by_key proc~build_neighbours->proc~sort_by_key none~quicksort quicksort proc~sort_by_key->none~quicksort none~quicksort->none~quicksort Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~mesh_unstr_init_from_triangles~~CalledByGraph proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: n_owned integer, private :: n_total Source Code subroutine mesh_unstr_init_from_triangles ( mesh , vert_x , vert_y , tri_v , bc_tags ) !! Build a `mesh_unstr_t` from raw vertex coordinates and triangle !! vertex lists. Computes geometry, neighbour topology and the !! surrogate-neighbour table. !! !! `tri_v(1:3, k)` are the vertex ids (1-based) of triangle k in CCW !! order. !! !! `bc_tags(1:3, k)` is an optional per-edge boundary group id per !! cell; only edges that are physical boundaries (`neighbours == -1`) !! keep their tag, interior edges get 0. type ( mesh_unstr_t ), intent ( out ) :: mesh real ( wp ), intent ( in ) :: vert_x (:) real ( wp ), intent ( in ) :: vert_y (:) integer , intent ( in ) :: tri_v (:, :) integer , intent ( in ), optional :: bc_tags (:, :) integer :: n_owned , n_total if ( size ( tri_v , 1 ) /= EDGES_PER_TRI ) then call logger % error ( \"mesh_unstr_init_from_triangles: tri_v must have \" & // \"3 rows, got \" // to_char ( size ( tri_v , 1 ))) return end if n_total = size ( tri_v , 2 ) n_owned = n_total mesh % nverts = size ( vert_x ) mesh % ncells_owned = n_owned mesh % ncells_total = n_total allocate ( mesh % vert_x ( mesh % nverts )) allocate ( mesh % vert_y ( mesh % nverts )) mesh % vert_x = vert_x mesh % vert_y = vert_y ! `tri_v` is the FULL list (owned + halo), so a direct copy. allocate ( mesh % tri_v ( EDGES_PER_TRI , n_total )) mesh % tri_v = tri_v allocate ( mesh % centroid_x ( n_total ), source = 0.0_wp ) allocate ( mesh % centroid_y ( n_total ), source = 0.0_wp ) allocate ( mesh % area ( n_total ), source = 0.0_wp ) allocate ( mesh % radius ( n_total ), source = 0.0_wp ) allocate ( mesh % n_boundaries ( n_total ), source = 0 ) allocate ( mesh % edge_len ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % edge_n1 ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % edge_n2 ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % edge_mid_x ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % edge_mid_y ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) ! Semi-implicit (TPFA) geometry — circumcentres per cell; edge deltas ! + deviation angles filled by `compute_si_geometry` after neighbours. allocate ( mesh % circumcentre_x ( n_total ), source = 0.0_wp ) allocate ( mesh % circumcentre_y ( n_total ), source = 0.0_wp ) allocate ( mesh % edge_delta ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % edge_dev_angle ( EDGES_PER_TRI , n_total ), source = 0.0_wp ) allocate ( mesh % neighbours ( EDGES_PER_TRI , n_total ), source =- 1 ) allocate ( mesh % neighbour_edges ( EDGES_PER_TRI , n_total ), source =- 1 ) allocate ( mesh % surrogate_neighbours ( EDGES_PER_TRI , n_total ), source =- 1 ) allocate ( mesh % bc_group ( EDGES_PER_TRI , n_total ), source = 0 ) call compute_geometry ( mesh ) call build_neighbours ( mesh ) call build_surrogate_neighbours ( mesh ) call count_boundary_edges ( mesh ) ! Semi-implicit TPFA geometry: circumcentre-line edge deltas + ! deviation angles (needs neighbour circumcentres, so post-neighbours). call compute_si_geometry ( mesh ) if ( present ( bc_tags )) then block integer :: kk , ii if ( size ( bc_tags , 1 ) /= EDGES_PER_TRI . or . & size ( bc_tags , 2 ) /= n_owned ) then call logger % error ( \"mesh_unstr_init_from_triangles: bc_tags \" // & \"shape mismatch, expected (3, ncells_owned)\" ) else do kk = 1 , n_owned do ii = 1 , EDGES_PER_TRI if ( mesh % neighbours ( ii , kk ) < 0 ) then mesh % bc_group ( ii , kk ) = bc_tags ( ii , kk ) end if end do end do end if end block end if allocate ( mesh % cell_global_id ( n_total )) block integer :: kk do kk = 1 , n_total mesh % cell_global_id ( kk ) = int ( kk , kind = int64 ) end do end block call logger % info ( \"mesh_unstr: built \" // to_char ( n_owned ) // & \" cells, \" // to_char ( mesh % n_boundary_edges ) // \" boundary edges\" ) end subroutine mesh_unstr_init_from_triangles","tags":"","url":"proc/mesh_unstr_init_from_triangles.html"},{"title":"mesh_unstr_si_quality_gate – Rakali","text":"public  subroutine mesh_unstr_si_quality_gate(mesh, ok) Fail-loud mesh-quality gate for the semi-implicit TPFA operator\n(Casulli & Walters 2000 orthogonal-centre requirement, made\nexplicit).  Aborts via ok=.false. (the caller error-stops) when\neither\n  * the max circumcentre-line deviation angle exceeds SI_MAX_DEV_ANGLE_DEG (a non-Delaunay / corrupted mesh), or\n  * the smallest interior edge_delta is non-positive (an obtuse\n    triangle put its circumcentre outside itself => a flipped /\n    zero transmissibility K_e = Hf*len/delta ).\nA clean Delaunay mesh (meshpy/pymetis pipeline) passes trivially. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh logical, intent(out) :: ok Calls proc~~mesh_unstr_si_quality_gate~~CallsGraph proc~mesh_unstr_si_quality_gate mesh_unstr_si_quality_gate error error proc~mesh_unstr_si_quality_gate->error to_char to_char proc~mesh_unstr_si_quality_gate->to_char Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~mesh_unstr_si_quality_gate~~CalledByGraph proc~mesh_unstr_si_quality_gate mesh_unstr_si_quality_gate proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~mesh_unstr_si_quality_gate proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine mesh_unstr_si_quality_gate ( mesh , ok ) !! Fail-loud mesh-quality gate for the semi-implicit TPFA operator !! (Casulli & Walters 2000 orthogonal-centre requirement, made !! explicit).  Aborts via `ok=.false.` (the caller error-stops) when !! either !!   * the max circumcentre-line deviation angle exceeds !!     `SI_MAX_DEV_ANGLE_DEG` (a non-Delaunay / corrupted mesh), or !!   * the smallest interior `edge_delta` is non-positive (an obtuse !!     triangle put its circumcentre outside itself => a flipped / !!     zero transmissibility `K_e = Hf*len/delta`). !! A clean Delaunay mesh (meshpy/pymetis pipeline) passes trivially. type ( mesh_unstr_t ), intent ( in ) :: mesh logical , intent ( out ) :: ok ok = . true . if ( mesh % max_dev_angle > SI_MAX_DEV_ANGLE_DEG ) then call logger % error ( \"mesh_unstr: semi-implicit quality gate FAILED — \" // & \"max circumcentre-line deviation angle \" // & to_char ( mesh % max_dev_angle ) // \" deg exceeds the \" // & to_char ( SI_MAX_DEV_ANGLE_DEG ) // \" deg ceiling.  The \" // & \"TPFA free-surface operator is consistent only on a \" // & \"near-Delaunay mesh (edge orthogonal to the \" // & \"circumcentre line); this triangulation is not.\" ) ok = . false . end if if ( mesh % min_edge_delta <= 0.0_wp ) then call logger % error ( \"mesh_unstr: semi-implicit quality gate FAILED — \" // & \"non-positive interior circumcentre-line distance \" // & \"(min edge_delta = \" // to_char ( mesh % min_edge_delta ) // & \" m).  An obtuse triangle has its circumcentre \" // & \"outside itself => the TPFA transmissibility flips \" // & \"sign / vanishes.  Use an acute / Delaunay mesh.\" ) ok = . false . end if end subroutine mesh_unstr_si_quality_gate","tags":"","url":"proc/mesh_unstr_si_quality_gate.html"},{"title":"build_neighbours – Rakali","text":"private  subroutine build_neighbours(mesh) Build the neighbours / neighbour_edges tables by matching edges\nthat share the same unordered vertex pair. Uses a single sort of\n64-bit composite keys instead of a hash table – O(M log M) where\nM = 3 * ncells_total, and avoids dragging in any container code. Iterates over ncells_total so that edges between owned and\nhalo cells (the partition edges) are linked just like interior\nedges. Halo↔halo matches are harmless: the kernel never walks\ninto them because flux loops are bounded by ncells_owned . Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Calls proc~~build_neighbours~~CallsGraph proc~build_neighbours build_neighbours error error proc~build_neighbours->error proc~sort_by_key sort_by_key proc~build_neighbours->proc~sort_by_key to_char to_char proc~build_neighbours->to_char none~quicksort quicksort proc~sort_by_key->none~quicksort none~quicksort->none~quicksort Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~build_neighbours~~CalledByGraph proc~build_neighbours build_neighbours proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~mesh_unstr_init_from_triangles->proc~build_neighbours proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private, allocatable :: cell_of (:) integer, private :: e1 integer, private :: e2 integer, private, allocatable :: edge_of (:) integer, private :: i integer, private :: idx integer, private :: k integer, private :: k1 integer, private :: k2 integer(kind=int64), private, allocatable :: keys (:) integer, private :: m integer(kind=int64), private :: nv64 integer, private :: p integer, private :: q integer, private :: va integer, private :: vb integer, private :: vmax integer, private :: vmin Source Code subroutine build_neighbours ( mesh ) !! Build the neighbours / neighbour_edges tables by matching edges !! that share the same unordered vertex pair. Uses a single sort of !! 64-bit composite keys instead of a hash table -- O(M log M) where !! M = 3 * ncells_total, and avoids dragging in any container code. !! !! Iterates over `ncells_total` so that edges between owned and !! halo cells (the partition edges) are linked just like interior !! edges. Halo↔halo matches are harmless: the kernel never walks !! into them because flux loops are bounded by `ncells_owned`. type ( mesh_unstr_t ), intent ( inout ) :: mesh integer ( int64 ), allocatable :: keys (:) integer , allocatable :: cell_of (:), edge_of (:) integer ( int64 ) :: nv64 integer :: m , idx , k , i , va , vb , vmin , vmax integer :: p , q , k1 , e1 , k2 , e2 m = EDGES_PER_TRI * mesh % ncells_total if ( m == 0 ) return allocate ( keys ( m ), cell_of ( m ), edge_of ( m )) nv64 = int ( mesh % nverts , kind = int64 ) + 1_int64 idx = 0 do k = 1 , mesh % ncells_total do i = 1 , EDGES_PER_TRI ! Edge i is opposite vertex i, so its endpoints are the other two. select case ( i ) case ( 1 ) va = mesh % tri_v ( 2 , k ) vb = mesh % tri_v ( 3 , k ) case ( 2 ) va = mesh % tri_v ( 3 , k ) vb = mesh % tri_v ( 1 , k ) case default va = mesh % tri_v ( 1 , k ) vb = mesh % tri_v ( 2 , k ) end select vmin = min ( va , vb ) vmax = max ( va , vb ) idx = idx + 1 keys ( idx ) = int ( vmin , kind = int64 ) * nv64 + int ( vmax , kind = int64 ) cell_of ( idx ) = k edge_of ( idx ) = i end do end do call sort_by_key ( keys , cell_of , edge_of ) ! Walk consecutive runs of equal keys: a length-2 run is an interior ! edge (link both sides); length 1 is a physical boundary; length >2 ! means a non-manifold mesh, which is a hard error here. p = 1 do while ( p <= m ) q = p do while ( q < m ) if ( keys ( q + 1 ) /= keys ( p )) exit q = q + 1 end do select case ( q - p + 1 ) case ( 1 ) ! boundary -- leave neighbours(:, k) at -1 case ( 2 ) k1 = cell_of ( p ) e1 = edge_of ( p ) k2 = cell_of ( p + 1 ) e2 = edge_of ( p + 1 ) mesh % neighbours ( e1 , k1 ) = k2 mesh % neighbour_edges ( e1 , k1 ) = e2 mesh % neighbours ( e2 , k2 ) = k1 mesh % neighbour_edges ( e2 , k2 ) = e1 case default call logger % error ( \"mesh_unstr: non-manifold edge shared by \" & // to_char ( q - p + 1 ) // \" triangles\" ) end select p = q + 1 end do deallocate ( keys , cell_of , edge_of ) end subroutine build_neighbours","tags":"","url":"proc/build_neighbours.html"},{"title":"build_surrogate_neighbours – Rakali","text":"private  subroutine build_surrogate_neighbours(mesh) Surrogate neighbours: same as neighbours but the cell itself\nstands in for boundary edges. Lets the gradient\nkernel index neighbour values without branching on -1.\nFilled for every cell – halo cells included – so that any\nkernel that happens to dereference surrogate_neighbours(:, k) for a halo k still gets a valid index. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~build_surrogate_neighbours~~CalledByGraph proc~build_surrogate_neighbours build_surrogate_neighbours proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~mesh_unstr_init_from_triangles->proc~build_surrogate_neighbours proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: k Source Code subroutine build_surrogate_neighbours ( mesh ) !! Surrogate neighbours: same as `neighbours` but the cell itself !! stands in for boundary edges. Lets the gradient !! kernel index neighbour values without branching on -1. !! Filled for every cell -- halo cells included -- so that any !! kernel that happens to dereference `surrogate_neighbours(:, k)` !! for a halo `k` still gets a valid index. type ( mesh_unstr_t ), intent ( inout ) :: mesh integer :: k , i do k = 1 , mesh % ncells_total do i = 1 , EDGES_PER_TRI if ( mesh % neighbours ( i , k ) > 0 ) then mesh % surrogate_neighbours ( i , k ) = mesh % neighbours ( i , k ) else mesh % surrogate_neighbours ( i , k ) = k end if end do end do end subroutine build_surrogate_neighbours","tags":"","url":"proc/build_surrogate_neighbours.html"},{"title":"compute_geometry – Rakali","text":"private  subroutine compute_geometry(mesh) Compute per-cell area, centroid, CFL radius, and per-edge\nlength, outward normal, and midpoint for every cell – owned\nAND halo. Halo cells need real geometry too because the\nreconstruction kernel reads neighbour centroids when computing\nedge values across partition edges. Edge i is opposite local\nvertex i; in CCW orientation that gives an outward normal. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~compute_geometry~~CalledByGraph proc~compute_geometry compute_geometry proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~mesh_unstr_init_from_triangles->proc~compute_geometry proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dmid real(kind=wp), private :: ex real(kind=wp), private :: ey integer, private :: i integer, private :: k real(kind=wp), private :: len real(kind=wp), private :: perimeter real(kind=wp), private :: r_min integer, private :: va integer, private :: vb integer, private :: vc real(kind=wp), private :: x1 real(kind=wp), private :: x2 real(kind=wp), private :: x3 real(kind=wp), private :: y1 real(kind=wp), private :: y2 real(kind=wp), private :: y3 Source Code subroutine compute_geometry ( mesh ) !! Compute per-cell area, centroid, CFL radius, and per-edge !! length, outward normal, and midpoint for every cell -- owned !! AND halo. Halo cells need real geometry too because the !! reconstruction kernel reads neighbour centroids when computing !! edge values across partition edges. Edge i is opposite local !! vertex i; in CCW orientation that gives an outward normal. type ( mesh_unstr_t ), intent ( inout ) :: mesh integer :: k , i , va , vb , vc real ( wp ) :: x1 , y1 , x2 , y2 , x3 , y3 real ( wp ) :: ex , ey , len , perimeter , dmid , r_min do k = 1 , mesh % ncells_total va = mesh % tri_v ( 1 , k ) vb = mesh % tri_v ( 2 , k ) vc = mesh % tri_v ( 3 , k ) x1 = mesh % vert_x ( va ) y1 = mesh % vert_y ( va ) x2 = mesh % vert_x ( vb ) y2 = mesh % vert_y ( vb ) x3 = mesh % vert_x ( vc ) y3 = mesh % vert_y ( vc ) ! Signed area via cross product; positive iff CCW. mesh % area ( k ) = 0.5_wp * (( x2 - x1 ) * ( y3 - y1 ) - ( x3 - x1 ) * ( y2 - y1 )) mesh % centroid_x ( k ) = ( x1 + x2 + x3 ) / 3.0_wp mesh % centroid_y ( k ) = ( y1 + y2 + y3 ) / 3.0_wp ! Circumcentre (equidistant from the three vertices) — the SI ! free-surface places eta here so the TPFA edge flux is consistent ! on a Delaunay mesh (edge orthogonal to the circumcentre line). ! den = 2*(signed area)*2 = 4A; nonzero for a non-degenerate cell. block real ( wp ) :: den , a2 , b2 , c2 den = 2.0_wp * ( x1 * ( y2 - y3 ) + x2 * ( y3 - y1 ) + x3 * ( y1 - y2 )) if ( abs ( den ) > tiny ( 1.0_wp )) then a2 = x1 * x1 + y1 * y1 b2 = x2 * x2 + y2 * y2 c2 = x3 * x3 + y3 * y3 mesh % circumcentre_x ( k ) = & ( a2 * ( y2 - y3 ) + b2 * ( y3 - y1 ) + c2 * ( y1 - y2 )) / den mesh % circumcentre_y ( k ) = & ( a2 * ( x3 - x2 ) + b2 * ( x1 - x3 ) + c2 * ( x2 - x1 )) / den else ! Degenerate cell: fall back to the centroid (the quality ! gate will reject it via a non-positive edge_delta anyway). mesh % circumcentre_x ( k ) = mesh % centroid_x ( k ) mesh % circumcentre_y ( k ) = mesh % centroid_y ( k ) end if end block ! Edge i is opposite vertex i. Walking edges in CCW order: !   edge 1 = (v2 -> v3), edge 2 = (v3 -> v1), edge 3 = (v1 -> v2). ! Outward normal of an edge (xa,ya)->(xb,yb) in a CCW triangle is ! ( (yb - ya), -(xb - xa) ) / length. perimeter = 0.0_wp r_min = huge ( 1.0_wp ) do i = 1 , EDGES_PER_TRI block real ( wp ) :: xa , ya , xb , yb select case ( i ) case ( 1 ) xa = x2 ya = y2 xb = x3 yb = y3 case ( 2 ) xa = x3 ya = y3 xb = x1 yb = y1 case default xa = x1 ya = y1 xb = x2 yb = y2 end select ex = xb - xa ey = yb - ya len = sqrt ( ex * ex + ey * ey ) mesh % edge_len ( i , k ) = len mesh % edge_n1 ( i , k ) = ey / len mesh % edge_n2 ( i , k ) = - ex / len mesh % edge_mid_x ( i , k ) = 0.5_wp * ( xa + xb ) mesh % edge_mid_y ( i , k ) = 0.5_wp * ( ya + yb ) perimeter = perimeter + len ! Distance from the centroid to this edge's midpoint. dmid = sqrt (( mesh % centroid_x ( k ) - mesh % edge_mid_x ( i , k )) ** 2 & + ( mesh % centroid_y ( k ) - mesh % edge_mid_y ( i , k )) ** 2 ) if ( dmid < r_min ) r_min = dmid end block end do ! CFL length scale: min centroid-to-edge-midpoint distance ! (= 1/3 of the shortest median). Equals the inscribed-circle ! radius for equilateral triangles, smaller (more conservative) ! for skewed ones. if ( perimeter > 0.0_wp ) then mesh % radius ( k ) = r_min end if end do end subroutine compute_geometry","tags":"","url":"proc/compute_geometry.html"},{"title":"compute_si_geometry – Rakali","text":"private  subroutine compute_si_geometry(mesh) Fill the semi-implicit TPFA edge geometry: the circumcentre-to-\ncircumcentre distance edge_delta and the edge/centre-line\ndeviation angle edge_dev_angle for every edge of every cell, plus\nthe mesh-wide quality-gate scalars max_dev_angle / min_edge_delta over the OWNED interior edges.  Runs after build_neighbours so\nneighbour circumcentres are available.  Host-only (init-time; the\ndevice never re-derives geometry). interior edge i of cell k, neighbour kn:\n    dvec = cc(kn) - cc(k);  edge_delta = |dvec|\n    dev  = acos( |n_hat . dvec| / |dvec| )   (0 = orthogonal, ideal)\n  boundary edge:\n    edge_delta = circumcentre-to-edge-midpoint distance (the\n    Dirichlet ghost sits at the mirror across the edge); dev = 0. The circumcentre line of a valid Delaunay edge is orthogonal to the\nedge by construction, so dev is ~0 everywhere on a clean mesh; a\nlarge max_dev_angle (or a non-positive min_edge_delta from an\nobtuse triangle whose circumcentre falls outside itself) flags a\nmesh the TPFA operator would solve inconsistently — the SI configure\ngate aborts on it ( mesh_unstr_si_quality_gate ). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~compute_si_geometry~~CalledByGraph proc~compute_si_geometry compute_si_geometry proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~mesh_unstr_init_from_triangles->proc~compute_si_geometry proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: cosang real(kind=wp), private :: dlen real(kind=wp), private :: dmx real(kind=wp), private :: dmy real(kind=wp), private :: dxc real(kind=wp), private :: dyc integer, private :: i integer, private :: k integer, private :: kn real(kind=wp), private :: max_dev real(kind=wp), private :: min_delta Source Code subroutine compute_si_geometry ( mesh ) !! Fill the semi-implicit TPFA edge geometry: the circumcentre-to- !! circumcentre distance `edge_delta` and the edge/centre-line !! deviation angle `edge_dev_angle` for every edge of every cell, plus !! the mesh-wide quality-gate scalars `max_dev_angle` / `min_edge_delta` !! over the OWNED interior edges.  Runs after `build_neighbours` so !! neighbour circumcentres are available.  Host-only (init-time; the !! device never re-derives geometry). !! !!   interior edge i of cell k, neighbour kn: !!     dvec = cc(kn) - cc(k);  edge_delta = |dvec| !!     dev  = acos( |n_hat . dvec| / |dvec| )   (0 = orthogonal, ideal) !!   boundary edge: !!     edge_delta = circumcentre-to-edge-midpoint distance (the !!     Dirichlet ghost sits at the mirror across the edge); dev = 0. !! !! The circumcentre line of a valid Delaunay edge is orthogonal to the !! edge by construction, so `dev` is ~0 everywhere on a clean mesh; a !! large `max_dev_angle` (or a non-positive `min_edge_delta` from an !! obtuse triangle whose circumcentre falls outside itself) flags a !! mesh the TPFA operator would solve inconsistently — the SI configure !! gate aborts on it (`mesh_unstr_si_quality_gate`). type ( mesh_unstr_t ), intent ( inout ) :: mesh integer :: k , i , kn real ( wp ) :: dxc , dyc , dlen , cosang , dmx , dmy real ( wp ) :: max_dev , min_delta max_dev = 0.0_wp min_delta = huge ( 1.0_wp ) do k = 1 , mesh % ncells_total do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dxc = mesh % circumcentre_x ( kn ) - mesh % circumcentre_x ( k ) dyc = mesh % circumcentre_y ( kn ) - mesh % circumcentre_y ( k ) dlen = sqrt ( dxc * dxc + dyc * dyc ) mesh % edge_delta ( i , k ) = dlen ! Deviation angle between the outward edge-normal and the ! centre line (both unit-normalised via the /dlen below). if ( dlen > tiny ( 1.0_wp )) then cosang = abs ( mesh % edge_n1 ( i , k ) * dxc + mesh % edge_n2 ( i , k ) * dyc ) / dlen cosang = min ( max ( cosang , 0.0_wp ), 1.0_wp ) mesh % edge_dev_angle ( i , k ) = acos ( cosang ) * RAD2DEG else mesh % edge_dev_angle ( i , k ) = 0.0_wp end if ! Quality-gate reduction over OWNED interior edges only. ! min_delta tracks the SIGNED projection of the circumcentre ! line on the OUTWARD normal: both circumcentres sit on the ! shared edge's perpendicular bisector for ANY triangulation ! (so the deviation angle alone cannot flag a bad pair) — a ! locally NON-Delaunay pair puts the neighbour circumcentre ! on the WRONG side (negative projection => a flipped ! transmissibility sign), and a right-triangle pair puts ! them coincident (zero).  Both must abort. if ( k <= mesh % ncells_owned ) then max_dev = max ( max_dev , mesh % edge_dev_angle ( i , k )) min_delta = min ( min_delta , & dxc * mesh % edge_n1 ( i , k ) + dyc * mesh % edge_n2 ( i , k )) end if else ! Boundary (or partition-with-no-neighbour) edge: use the ! circumcentre-to-edge-midpoint distance; the Dirichlet ghost ! surface is imposed at the mirror across the edge. dmx = mesh % edge_mid_x ( i , k ) - mesh % circumcentre_x ( k ) dmy = mesh % edge_mid_y ( i , k ) - mesh % circumcentre_y ( k ) mesh % edge_delta ( i , k ) = sqrt ( dmx * dmx + dmy * dmy ) mesh % edge_dev_angle ( i , k ) = 0.0_wp end if end do end do if ( min_delta == huge ( 1.0_wp )) min_delta = 0.0_wp mesh % max_dev_angle = max_dev mesh % min_edge_delta = min_delta end subroutine compute_si_geometry","tags":"","url":"proc/compute_si_geometry.html"},{"title":"count_boundary_edges – Rakali","text":"private  subroutine count_boundary_edges(mesh) Tally n_boundaries(k) for every cell (owned AND halo) and\nthe total boundary-edge count across owned cells. The per-cell count is needed by the extrapolate kernel to\nbranch into the right reconstruction path (0/1 boundary →\nthree-neighbour, 2 → one-neighbour, 3 → constant). Halo\ncells need correct counts too because the extrapolate kernel\nruns over ncells_total so that ghost-cell edge values are\navailable for the flux kernel to read at partition edges. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(inout) :: mesh Called by proc~~count_boundary_edges~~CalledByGraph proc~count_boundary_edges count_boundary_edges proc~mesh_unstr_init_from_triangles mesh_unstr_init_from_triangles proc~mesh_unstr_init_from_triangles->proc~count_boundary_edges proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~mesh_unstr_init_from_triangles proc~rki_unstr_create rki_unstr_create proc~rki_unstr_create->proc~mesh_unstr_init_from_triangles proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: k integer, private :: n Source Code subroutine count_boundary_edges ( mesh ) !! Tally `n_boundaries(k)` for every cell (owned AND halo) and !! the total boundary-edge count across owned cells. !! !! The per-cell count is needed by the extrapolate kernel to !! branch into the right reconstruction path (0/1 boundary → !! three-neighbour, 2 → one-neighbour, 3 → constant). Halo !! cells need correct counts too because the extrapolate kernel !! runs over `ncells_total` so that ghost-cell edge values are !! available for the flux kernel to read at partition edges. type ( mesh_unstr_t ), intent ( inout ) :: mesh integer :: k , i , n mesh % n_boundary_edges = 0 do k = 1 , mesh % ncells_total n = 0 do i = 1 , EDGES_PER_TRI if ( mesh % neighbours ( i , k ) < 0 ) n = n + 1 end do mesh % n_boundaries ( k ) = n ! Only tally physical boundaries on owned cells for the ! mesh-wide count (halo boundaries are artefacts of the ! local sub-mesh, not real domain boundaries). if ( k <= mesh % ncells_owned ) then mesh % n_boundary_edges = mesh % n_boundary_edges + n end if end do end subroutine count_boundary_edges","tags":"","url":"proc/count_boundary_edges.html"},{"title":"sort_by_key – Rakali","text":"private  subroutine sort_by_key(keys, payload1, payload2) In-place quicksort keeping two integer payload arrays in lockstep\nwith the int64 key array. Mesh-init only. Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(inout) ::