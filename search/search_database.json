KPP !! overlay max'd in, plus the non-local counter-gradient transport !! folded into the interface flux, applied two-pass on salinity + !! temperature.  Fuses the two `ml_vertical_diffusion_tracer_unstr` !! calls; bit-identical to them where the overlay + non-local !! terms vanish. !! !! The non-local term gamma(iface) = cs·G(sigma)·F_kin is a !! downward flux; adding dt·gamma to the diffusive interface !! transfer makes the shared apply pass produce its divergence. !! gamma = 0 at the bed and free surface (no iface there), so the !! column integral is conserved. type ( unstr_state_t ), intent ( inout ) :: state ! assumed-shape-ok: unstructured outer-shim — caller host-dereferences ! state%multilayer%tracers(idx)%hTr_layer; ncells varies per mesh partition. real ( wp ), intent ( inout ) :: hS_layer (:, :) real ( wp ), intent ( inout ) :: hT_layer (:, :) ! assumed-shape-ok: unstructured outer-shim; ncells varies per mesh partition real ( wp ), intent ( in ) :: kappa_S_bg , kappa_T_bg , dt integer :: cell , k , nz , n real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 real ( wp ) :: s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom real ( wp ) :: kappa_S , kappa_T , h_col , h_b , b_0 , us , wstar3 , w_star , w_s real ( wp ) :: h_top , s_top , f_t_kin , f_s_kin , cs_nl real ( wp ) :: d_below , d_iface , sigma , g_shape , nu_kpp logical :: destabilizing real ( wp ) :: flux_s_iface ( BPG_NZ_MAX ), flux_t_iface ( BPG_NZ_MAX ) if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = state % ncells_owned if ( nz < 2 ) return cs_nl = state % multilayer % kpp_cs_nonlocal do concurrent ( cell = 1 : n ) & local ( k , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , & s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom , & kappa_S , kappa_T , h_col , h_b , b_0 , us , wstar3 , w_star , w_s , & h_top , s_top , f_t_kin , f_s_kin , d_below , d_iface , sigma , & g_shape , nu_kpp , destabilizing , flux_s_iface , flux_t_iface ) if ( state % barotropic % height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle h_col = 0.0_wp do k = 1 , nz h_col = h_col + state % multilayer % h_layer ( k , cell ) end do h_b = state % multilayer % kpp_bl_depth ( cell ) b_0 = state % multilayer % kpp_buoy_flux ( cell ) us = state % multilayer % kpp_u_star ( cell ) wstar3 = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3 ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) destabilizing = ( b_0 < 0.0_wp ) h_top = state % multilayer % h_layer ( nz , cell ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( nz , cell ) / h_top else s_top = 0.0_wp end if f_t_kin = state % forcing % heat_flux ( cell ) / ( state % multilayer % rho_0 * CP_WATER ) f_s_kin = state % forcing % evap_minus_precip ( cell ) * s_top ! Pass 1: interface fluxes (PP81 cubic + overlay + non-local) d_below = 0.0_wp do k = 1 , nz - 1 h_k = state % multilayer % h_layer ( k , cell ) h_k1 = state % multilayer % h_layer ( k + 1 , cell ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below flux_s_iface ( k ) = 0.0_wp flux_t_iface ( k ) = 0.0_wp if ( h_avg > VANISHING_LAYER_TOL_UNSTR . and . & h_k > VANISHING_LAYER_TOL_UNSTR . and . & h_k1 > VANISHING_LAYER_TOL_UNSTR ) then if ( h_k > DRY_TOLERANCE ) then u_k = state % multilayer % hu_layer ( k , cell ) / h_k v_k = state % multilayer % hv_layer ( k , cell ) / h_k s_k = hS_layer ( k , cell ) / h_k t_k = hT_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp s_k = 0.0_wp t_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = state % multilayer % hu_layer ( k + 1 , cell ) / h_k1 v_k1 = state % multilayer % hv_layer ( k + 1 , cell ) / h_k1 s_k1 = hS_layer ( k + 1 , cell ) / h_k1 t_k1 = hT_layer ( k + 1 , cell ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp s_k1 = 0.0_wp t_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = state % multilayer % rho_layer ( k , cell ) - state % multilayer % rho_layer ( k + 1 , cell ) Ri = GRAVITY * ( drho / state % multilayer % rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + state % multilayer % vmix_ri_alpha * Ri kappa_S = state % multilayer % vmix_nu_max / ( denom * denom * denom ) + kappa_S_bg kappa_T = state % multilayer % vmix_nu_max / ( denom * denom * denom ) + kappa_T_bg g_shape = 0.0_wp if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) end if nu_kpp = h_b * w_s * g_shape kappa_S = max ( kappa_S , nu_kpp ) kappa_T = max ( kappa_T , nu_kpp ) if ( kappa_S * dt > 0.5_wp * h_avg * h_avg ) kappa_S = 0.5_wp * h_avg * h_avg / dt if ( kappa_T * dt > 0.5_wp * h_avg * h_avg ) kappa_T = 0.5_wp * h_avg * h_avg / dt flux_s_iface ( k ) = kappa_S * ( s_k1 - s_k ) / h_avg * dt flux_t_iface ( k ) = kappa_T * ( t_k1 - t_k ) / h_avg * dt ! Non-local counter-gradient transport (g_shape = 0 outside ! the BL ⇒ no-op; skipped entirely under stabilizing flux). if ( destabilizing ) then flux_s_iface ( k ) = flux_s_iface ( k ) + dt * cs_nl * g_shape * f_s_kin flux_t_iface ( k ) = flux_t_iface ( k ) + dt * cs_nl * g_shape * f_t_kin end if end if end do ! Pass 2: apply interface fluxes to layers. hS_layer ( 1 , cell ) = hS_layer ( 1 , cell ) + flux_s_iface ( 1 ) hT_layer ( 1 , cell ) = hT_layer ( 1 , cell ) + flux_t_iface ( 1 ) do k = 2 , nz - 1 hS_layer ( k , cell ) = hS_layer ( k , cell ) + ( flux_s_iface ( k ) - flux_s_iface ( k - 1 )) hT_layer ( k , cell ) = hT_layer ( k , cell ) + ( flux_t_iface ( k ) - flux_t_iface ( k - 1 )) end do hS_layer ( nz , cell ) = hS_layer ( nz , cell ) - flux_s_iface ( nz - 1 ) hT_layer ( nz , cell ) = hT_layer ( nz , cell ) - flux_t_iface ( nz - 1 ) end do end subroutine ml_kpp_diffusion_tracers_unstr","tags":"","url":"proc/ml_kpp_diffusion_tracers_unstr.html"},{"title":"ml_kpp_viscosity_unstr – Rakali","text":"public pure subroutine ml_kpp_viscosity_unstr(state, dt) Pass 2 (momentum): PP81 interior viscosity with the KPP shape-\nfunction overlay max’d in, then the explicit CFL-clamped\ndiffusive flux applied to hu/hv (two-pass, mirroring ml_vertical_viscosity_unstr ). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt Calls proc~~ml_kpp_viscosity_unstr~~CallsGraph proc~ml_kpp_viscosity_unstr ml_kpp_viscosity_unstr local local proc~ml_kpp_viscosity_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_kpp_viscosity_unstr~~CalledByGraph proc~ml_kpp_viscosity_unstr ml_kpp_viscosity_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_kpp_viscosity_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid a