lic :: beta_uh = 0.8_wp real(kind=wp), public :: beta_uh_dry = 0.2_wp real(kind=wp), public :: beta_vh = 0.8_wp real(kind=wp), public :: beta_vh_dry = 0.2_wp real(kind=wp), public :: beta_w = 1.0_wp real(kind=wp), public :: beta_w_dry = 0.2_wp real(kind=wp), public :: cfl = 0.5_wp Default CFL for the unstructured solver. real(kind=wp), public :: dt = 0.0_wp Current timestep (s). real(kind=wp), public :: dt_fixed = 0.0_wp Fixed timestep (s) for the semi-implicit mode (bypasses the\ngravity-wave CFL).  Set from cfg%dt_fixed at init; 0 on the\nexplicit path. logical, public :: extrapolate_velocity_second_order = .true. When true, the extrapolation kernel converts centroid momenta\nto velocities before reconstruction and back at the edge\nmidpoints.  Much better behaved at wet/dry fronts. type( unstr_surface_forcing_t ), public :: forcing Surface tracer forcing.  See rki_surface_forcing_unstr . integer, public :: low_froude_mode = LOW_FROUDE_OFF Low-Froude correction mode for the central-upwind flux\n(LOW_FROUDE_OFF / _1 / _2). real(kind=wp), public :: mass_error = 0.0_wp Cumulative negative-mass clipped by protect . real(kind=wp), public :: minimum_allowed_height = 1.0e-3_wp Minimum allowed depth. Cells below this are treated as dry. type( unstr_multilayer_state_t ), public :: multilayer Per-layer arrays, vcoord, tracer registry, workspaces, and\nall multilayer scalar config.  See rki_multilayer_state_unstr . integer, public :: ncells_owned = 0 Cells owned by this rank. integer, public :: ncells_total = 0 ncells_owned + ncells_halo. All centroid/edge arrays are this long. type( semi_implicit_state_unstr_t ), public :: si CG workspace + edge face-depths for the TPFA Helmholtz eta-solve.\nAllocated only when use_semi_implicit .  See rki_si_unstr_state . integer, public :: step_count = 0 Total steps taken since init. real(kind=wp), public :: time = 0.0_wp Current simulation time (s). integer, public :: time_scheme = TIME_RK2 Explicit time integrator ( TIME_* from rki_timestepper).\nDefault RK2 reproduces the historical SSP-RK2 path bit-for-bit.\n2D barotropic path only; multilayer keeps RK2. logical, public :: use_multilayer = .false. When true, multilayer is initialised and mapped. logical, public :: use_semi_implicit = .false. When true, si is initialised + mapped and the solver dispatches\nto the unstructured SI step ( time_scheme=\"semi_implicit\" ). Source Code type :: unstr_state_t !! Container for the solution state, factored into sub-objects. ! ----- sizes (cached from the source mesh) ----- integer :: ncells_owned = 0 !! Cells owned by this rank. integer :: ncells_total = 0 !! ncells_owned + ncells_halo. All centroid/edge arrays are this long. ! ----- sub-state objects ----- type ( unstr_barotropic_state_t ) :: barotropic !! Centroid CV + edge reconstruction + per-step accumulators !! + RK2 saves + Chapman BC state + per-edge mass flux + !! barotropic scalar physics.  See `rki_barotropic_state_unstr`. ! Coupled hydrostatic multilayer logical :: use_multilayer = . false . !! When true, `multilayer` is initialised and mapped. type ( unstr_multilayer_state_t ) :: multilayer !! Per-layer arrays, vcoord, tracer registry, workspaces, and !! all multilayer scalar config.  See `rki_multilayer_state_unstr`. ! Surface forcing fields (heat flux + virtual freshwater flux). ! Always allocated and zero-filled so the surface-flux kernel can ! run unconditionally; non-zero values are pushed in via the C API. type ( unstr_surface_forcing_t ) :: forcing !! Surface tracer forcing.  See `rki_surface_forcing_unstr`. ! Semi-implicit (Casulli) free-surface mode. logical :: use_semi_implicit = . false . !! When true, `si` is initialised + mapped and the solver dispatches !! to the unstructured SI step (`time_scheme=\"semi_implicit\"`). type ( semi_implicit_state_unstr_t ) :: si !! CG workspace + edge face-depths for the TPFA Helmholtz eta-solve. !! Allocated only when `use_semi_implicit`.  See `rki_si_unstr_state`. real ( wp ) :: dt_fixed = 0.0_wp !! Fixed timestep (s) for the semi-implicit mode (bypasses the !! gravity-wave CFL).  Set from cfg%dt_fixed at init; 0 on the !! explicit path. ! ----- physics knobs (config-loaded later) ----- real ( wp ) :: minimum_allowed_height = 1.0e-3_wp !! Minimum allowed depth. Cells below this are treated as dry. real ( wp ) :: cfl = 0.5_wp !! Default CFL for the unstructured solver. ! ----- slope-limiter beta values ----- ! Wet/dry blending uses `hfactor` to interpolate between the dry ! value (small, conservative) and the wet value (close to 1). real ( wp ) :: beta_w = 1.0_wp real ( wp ) :: beta_w_dry = 0.2_wp real ( wp ) :: beta_uh = 0.8_wp real ( wp ) :: beta_uh_dry = 0.2_wp real ( wp ) :: beta_vh = 0.8_wp real ( wp ) :: beta_vh_dry = 0.2_wp logical :: extrapolate_velocity_second_order = . true . !! When true, the extrapolation kernel converts centroid momenta !! to velocities before reconstruction and back at the edge !! midpoints.  Much better behaved at wet/dry fronts. integer :: low_froude_mode = LOW_FROUDE_OFF !! Low-Froude correction mode for the central-upwind flux !! (LOW_FROUDE_OFF / _1 / _2). ! ----- boundary condition lookup table ----- ! Fixed-size integer array: lives inside the struct itself, so ! `map(to: state)` carries it across to the device automatically. integer :: bc_type ( MAX_BC_GROUPS ) = BC_WALL !! BC type for each boundary group `g = 1..MAX_BC_GROUPS`. real ( wp ) :: bc_eta_ext ( MAX_BC_GROUPS ) = 0.0_wp !! Per-group external stage (m) for `BC_TIDAL`. real ( wp ) :: bc_un_ext ( MAX_BC_GROUPS ) = 0.0_wp !! Per-group external normal velocity (m/s) for `BC_INFLOW`. real ( wp ) :: bc_h_ext ( MAX_BC_GROUPS ) = 0.0_wp !! Per-group external depth (m) for `BC_OUTFLOW`. real ( wp ) :: bc_Qn_ext ( MAX_BC_GROUPS ) = 0.0_wp !! Per-group specific discharge (m&#94;2/s) for `BC_DISCHARGE`. real ( wp ) :: bc_sponge_strength ( MAX_BC_GROUPS ) = 0.0_wp !! Sponge relaxation rate [1/s] per BC group (0 = inactive). !! Consumed by `apply_sponge_unstr`. Rides the struct copyin !! like `bc_eta_ext` — no separate device map needed. real ( wp ) :: bc_sponge_h_ref ( MAX_BC_GROUPS ) = 0.0_wp !! Sponge reference depth h_ref [m] per BC group. !! `apply_sponge_unstr` relaxes `h = stage - bed` toward this value. ! ----- timing + diagnostics ----- real ( wp ) :: dt = 0.0_wp !! Current timestep (s). real ( wp ) :: time = 0.0_wp !! Current simulation time (s). integer :: step_count = 0 !! Total steps taken since init. real ( wp ) :: mass_error = 0.0_wp !! Cumulative negative-mass clipped by `protect`. integer :: time_scheme = TIME_RK2 !! Explicit time integrator (`TIME_*` from rki_timestepper). !! Default RK2 reproduces the historical SSP-RK2 path bit-for-bit. !! 2D barotropic path only; multilayer keeps RK2. end type unstr_state_t","tags":"","url":"type/unstr_state_t.html"},{"title":"semi_implicit_state_unstr_t – Rakali ","text":"type, public :: semi_implicit_state_unstr_t CG workspace + edge face-depths for the 2D free-surface Helmholtz\nsolve on the triangulation. Inherits type~~semi_implicit_state_unstr_t~~InheritsGraph type~semi_implicit_state_unstr_t semi_implicit_state_unstr_t type~agglom_hierarchy_unstr_t agglom_hierarchy_unstr_t type~semi_implicit_state_unstr_t->type~agglom_hierarchy_unstr_t mg type~agglom_level_unstr_t agglom_level_unstr_t type~agglom_hierarchy_unstr_t->type~agglom_level_unstr_t lev Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Inherited by type~~semi_implicit_state_unstr_t~~InheritedByGraph type~semi_implicit_state_unstr_t semi_implicit_state_unstr_t type~unstr_state_t unstr_state_t type~unstr_state_t->type~semi_implicit_state_unstr_t si type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public, allocatable :: Gbar_cell_x (:) Column-integrated predictor transport sum_k h_k G_k&#94;u\n(ncells_total) [m&#94;2/s]. real(kind=wp), public, allocatable :: Gbar_cell_y (:) Column-integrated y predictor transport (ncells_total) [m&#94;2/s]. real(kind=wp), public, allocatable :: Hf_edge (:,:) Edge effective depth (m), shape (3, ncells_total). real(kind=wp), public, allocatable :: Hhat_cell (:) Effective column depth Hhat = -sum_k h_k R_k (ncells_total) [m]. real(kind=wp), public, allocatable :: a_wet (:) Wet fraction a(eta) in [0,1] at the current Newton iterate. real(kind=wp), public, allocatable :: b_min (:) Deepest sub-bottom per cell (m) — the sill bed at edges. real(kind=wp), public, allocatable :: b_sub (:,:) Per-cell SORTED sub-bottom bed elevations (n_sub, ncells) (m). integer, public :: bsub_fill = 0 Sub-bottom fill mode ( SI_BSUB_FILL_* from rki_si_common; 0=FLAT\ndefault ⇒ bit-identical, 1=LINEAR ⇒ analytic subgrid ramp).  Set\nby state_unstr_enable_si . integer, public :: cg_iters = 0 CG iterations on the most recent step (go/no-go cost number). real(kind=wp), public, allocatable :: eta (:) Surface elevation eta&#94;{n+1} (m), size ncells_total.  eta = h + b\nat circumcentres.  Warm-started from eta&#94;n each step; the CG\niterate.  Boundary/halo entries hold the seeded Dirichlet ghost. real(kind=wp), public, allocatable :: eta_Ap (:) Operator apply A*p. real(kind=wp), public, allocatable :: eta_diag (:) 1/diag of the Helmholtz operator (Jacobi preconditioner). real(kind=wp), public, allocatable :: eta_ghost_edge (:,:) Dirichlet ghost surface eta (m) on tidal/clamped boundary edges,\nshape (3, ncells_total); 0 elsewhere (unread — Hf=0 there).\nFilled alongside Hf_edge each step (frozen, rule R2). real(kind=wp), public, allocatable :: eta_p (:) Search direction p. real(kind=wp), public, allocatable :: eta_r (:) Residual r = rhs - A*eta. real(kind=wp), public, allocatable :: eta_z (:) Preconditioned residual z = M&#94;{-1} r (Jacobi); unread on plain CG. real(kind=wp), public, allocatable :: g_col_u (:,:) Column x-velocity response G_k&#94;u = solve(u&#94;n + tendencies)\n(nz, ncells_total) [m/s]. real(kind=wp), public, allocatable :: g_col_v (:,:) Column y-velocity response G_k&#94;v (nz, ncells_total) [m/s]. real(kind=wp), public, allocatable :: mass_diag (:) Newton mass diagonal a+floor — the operator’s M term. real(kind=wp), public, allocatable :: mass_flux_edge (:,:) Blended column edge mass flux theta sum_k u_edge_layer +\n(1-theta) U&#94;n_e (EDGES_PER_TRI, ncells_total) [m&#94;2/s] — the\nEXACT flux the eta update used; drives the dsig tracer split. real(kind=wp), public :: mass_res = 0.0_wp Area-weighted interior residual sum at solve end (m&#94;3) — the\nper-step mass-consistency diagnostic. type( agglom_hierarchy_unstr_t ), public :: mg Fine-to-coarse aggregation-MG level stack ( rki_si_unstr_mg ). integer, public :: n_sub = 1 Subgrid sub-bottoms per cell (1 = v1 flat bottom). integer, public :: ncells_total = 0 Cell count cached at init (all CG vectors are this long). real(kind=wp), public, allocatable :: newton_F (:) Nonlinear residual F = v + T*eta - rhs. real(kind=wp), public, allocatable :: newton_Jeta (:) Scratch for the full mass-diag operator apply J eta (the\nstiffness is recovered as J eta - mass_diag*eta). real(kind=wp), public, allocatable :: newton_dz (:) Newton increment: the inner CG solves J*dz = -F from zero. integer, public :: newton_iters = 0 Wet/dry Newton outer iterations on the most recent step (host\nscalar; read by tests / logging). real(kind=wp), public, allocatable :: nu_iface (:,:) PP81 interface viscosity (nz+1, ncells_total) [m&#94;2/s]; index k\n= interface BELOW layer k (bed row 1 and surface row nz+1 = 0). integer, public :: nz_si = 0 Layer count for the 3D SI path (0 or 1 = 2D-only; > 1 = the\nP3.2 multilayer column slots below are allocated). integer, public :: precond = SI_PRECOND_NONE Preconditioner ( SI_PRECOND_* ): NONE = plain CG (default),\nJACOBI = diagonal PCG, MG = aggregation-multigrid PCG. real(kind=wp), public, allocatable :: r_col (:,:) Column response R_k = solve(-1) (nz, ncells_total) [m/s]\n(<= 0); axis-independent — u and v share the tridiagonal. real(kind=wp), public, allocatable :: rhs_d (:) Depth-units Newton RHS v(eta&#94;n) - dt*div[blend] — held across\nthe Newton loop. real(kind=wp), public :: rtol = 1.0e-10_wp CG relative residual tolerance (area-weighted\n||r||&#94;2 < rtol&#94;2*||rhs||&#94;2). real(kind=wp), public, allocatable :: u_edge (:,:) Edge-normal transport (m&#94;2/s), shape (3, ncells_total); + along\nthe stored outward edge-normal. real(kind=wp), public, allocatable :: u_edge_layer (:,:,:) Recovered per-layer edge-normal transports\n(nz, EDGES_PER_TRI, ncells_total) [m&#94;2/s] — double-visit, same\noutward-normal convention as u_edge .  Column sums telescope to\nthe 2D back-substituted edge transport (mass consistency). real(kind=wp), public, allocatable :: u_n_edge (:,:) Saved U&#94;n edge transport (m&#94;2/s), shape (3, ncells_total) — the\n(1-theta) side of the theta-blend RHS; dead edges zeroed (R3). real(kind=wp), public, allocatable :: u_star (:,:) Predictor U*_e (m&#94;2/s), shape (3, ncells_total). logical, public :: use_mg = .false. MG preconditioner active (host scalar; set by enable_si). real(kind=wp), public, allocatable :: v_cell (:) Wetted mean depth v(eta) at the current iterate (m). logical, public :: wetdry = .false. Wet/dry mode on (host scalar; set by state_unstr_enable_si ). Type-Bound Procedures procedure, public, non_overridable :: build_mg => si_unstr_state_build_mg private  subroutine si_unstr_state_build_mg (this, mesh) Build the aggregation-MG preconditioner hierarchy for this state.\nHost-only; call from enable_si (after init , before enter_data )\nwhen precond == SI_PRECOND_MG .  Structure only (geometric\naggregation); the operator coefficients are filled by the first\nper-step refresh . Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh procedure, public, non_overridable :: destroy => si_unstr_state_destroy private  subroutine si_unstr_state_destroy (this) Deallocate all workspace arrays. Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this procedure, public, non_overridable :: enter_data => si_unstr_state_enter_data private  subroutine si_unstr_state_enter_data (this) Attach the workspace arrays to the device.  Arrays-only — the parent unstr_state_t is mapped by state_unstr_enter_data before this\nruns.  TBP wraps a non-polymorphic _impl (the class(...) box\nmaps to stack under AMD libomptarget; delegate to type(...) ). Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this procedure, public, non_overridable :: exit_data => si_unstr_state_exit_data private  subroutine si_unstr_state_exit_data (this) Detach the workspace arrays from the device. Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this procedure, public, non_overridable :: init => si_unstr_state_init private  subroutine si_unstr_state_init (this, mesh, nz, wetdry, n_sub) Allocate workspace arrays at the mesh size, zero-filled.  When nz is present and > 1 the P3.2 (3D multilayer) column slots are also\nallocated; when wetdry is present and .true. the P3.3 Casulli\nwet/dry slots are (with n_sub sub-bottoms, default 1); otherwise\nonly the 2D barotropic slots exist and the 2D path is unchanged.\nPlain host allocation (runs before enter_data , so a device loop\nwould round-trip). Arguments Type Intent Optional Attributes Name class( semi_implicit_state_unstr_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in), optional :: nz Number of vertical layers.  Absent or <= 1 selects the 2D path. logical, intent(in), optional :: wetdry Casulli wetting/drying on.  Absent/.false. => slots unallocated. integer, intent(in), optional :: n_sub Subgrid sub-bottoms per cell (>= 1).  Absent => 1 (flat bottom). Source Code type :: semi_implicit_state_unstr_t !! CG workspace + edge face-depths for the 2D free-surface Helmholtz !! solve on the triangulation. integer :: ncells_total = 0 !! Cell count cached at init (all CG vectors are this long). integer :: nz_si = 0 !! Layer count for the 3D SI path (0 or 1 = 2D-only; > 1 = the !! P3.2 multilayer column slots below are allocated). ! Free-surface elevation solved implicitly, at the CIRCUMCENTRE. real ( wp ), allocatable :: eta (:) !! Surface elevation eta&#94;{n+1} (m), size ncells_total.  eta = h + b !! at circumcentres.  Warm-started from eta&#94;n each step; the CG !! iterate.  Boundary/halo entries hold the seeded Dirichlet ghost. ! CG vectors (matrix-free), all size ncells_total. real ( wp ), allocatable :: eta_r (:) !! Residual r = rhs - A*eta. real ( wp ), allocatable :: eta_p (:) !! Search direction p. real ( wp ), allocatable :: eta_Ap (:) !! Operator apply A*p. real ( wp ), allocatable :: eta_z (:) !! Preconditioned residual z = M&#94;{-1} r (Jacobi); unread on plain CG. real ( wp ), allocatable :: eta_diag (:) !! 1/diag of the Helmholtz operator (Jacobi preconditioner). ! Per-edge-of-cell prognostic face transport U_e (m&#94;2/s), the ! staggered (Casulli) quantity.  Double-visit `(3, ncell)`: transport ! along the OUTWARD edge-normal of edge i of cell k.  Holds the ! predictor U*_e between the predictor and the back-substitution, then ! the final U&#94;{n+1}_e.  The A-grid cell momenta xmom_cv/ymom_cv are a ! step-end least-squares reconstruction for the KNP seam. real ( wp ), allocatable :: u_edge (:, :) !! Edge-normal transport (m&#94;2/s), shape (3, ncells_total); + along !! the stored outward edge-normal. real ( wp ), allocatable :: u_star (:, :) !! Predictor U*_e (m&#94;2/s), shape (3, ncells_total). ! Per-edge frozen effective depth Hf weighting the div(Hf grad eta) ! TPFA stencil (wall edges 0; open/Dirichlet edges real).  Shape ! (3, ncell); shared by the operator, back-sub and recovery (frozen ! over the step, rule R2). real ( wp ), allocatable :: Hf_edge (:, :) !! Edge effective depth (m), shape (3, ncells_total). real ( wp ), allocatable :: eta_ghost_edge (:, :) !! Dirichlet ghost surface eta (m) on tidal/clamped boundary edges, !! shape (3, ncells_total); 0 elsewhere (unread — Hf=0 there). !! Filled alongside Hf_edge each step (frozen, rule R2). real ( wp ), allocatable :: u_n_edge (:, :) !! Saved U&#94;n edge transport (m&#94;2/s), shape (3, ncells_total) — the !! (1-theta) side of the theta-blend RHS; dead edges zeroed (R3). ! CG controls (`&si_nml`; host scalars, set at init from cfg). integer :: precond = SI_PRECOND_NONE !! Preconditioner (`SI_PRECOND_*`): NONE = plain CG (default), !! JACOBI = diagonal PCG, MG = aggregation-multigrid PCG. real ( wp ) :: rtol = 1.0e-10_wp !! CG relative residual tolerance (area-weighted !! ||r||&#94;2 < rtol&#94;2*||rhs||&#94;2). ! Aggregation-multigrid preconditioner hierarchy — built at enable_si ! (host) only when precond == MG, refreshed once per step, attached to ! the device by this state's enter_data. logical :: use_mg = . false . !! MG preconditioner active (host scalar; set by enable_si). type ( agglom_hierarchy_unstr_t ) :: mg !! Fine-to-coarse aggregation-MG level stack (`rki_si_unstr_mg`). ! Diagnostics (host scalars). integer :: cg_iters = 0 !! CG iterations on the most recent step (go/no-go cost number). real ( wp ) :: mass_res = 0.0_wp !! Area-weighted interior residual sum at solve end (m&#94;3) — the !! per-step mass-consistency diagnostic. integer :: newton_iters = 0 !! Wet/dry Newton outer iterations on the most recent step (host !! scalar; read by tests / logging). ! --- Casulli wetting/drying (P3.3) — allocated only when `wetdry` !     is on.  The V(eta)/a(eta)/Newton machinery; per-cell, !     mesh-agnostic (prototype-confirmed).  All size (ncells) with !     the sub-bottom table (n_sub, ncells), cell index LAST. --- logical :: wetdry = . false . !! Wet/dry mode on (host scalar; set by `state_unstr_enable_si`). integer :: n_sub = 1 !! Subgrid sub-bottoms per cell (1 = v1 flat bottom). integer :: bsub_fill = 0 !! Sub-bottom fill mode (`SI_BSUB_FILL_*` from rki_si_common; 0=FLAT !! default ⇒ bit-identical, 1=LINEAR ⇒ analytic subgrid ramp).  Set !! by `state_unstr_enable_si`. real ( wp ), allocatable :: b_sub (:, :) !! Per-cell SORTED sub-bottom bed elevations (n_sub, ncells) (m). real ( wp ), allocatable :: b_min (:) !! Deepest sub-bottom per cell (m) — the sill bed at edges. real ( wp ), allocatable :: a_wet (:) !! Wet fraction a(eta) in [0,1] at the current Newton iterate. real ( wp ), allocatable :: mass_diag (:) !! Newton mass diagonal a+floor — the operator's `M` term. real ( wp ), allocatable :: v_cell (:) !! Wetted mean depth v(eta) at the current iterate (m). real ( wp ), allocatable :: rhs_d (:) !! Depth-units Newton RHS v(eta&#94;n) - dt*div[blend] — held across !! the Newton loop. real ( wp ), allocatable :: newton_dz (:) !! Newton increment: the inner CG solves J*dz = -F from zero. real ( wp ), allocatable :: newton_F (:) !! Nonlinear residual F = v + T*eta - rhs. real ( wp ), allocatable :: newton_Jeta (:) !! Scratch for the full mass-diag operator apply J*eta (the !! stiffness is recovered as J*eta - mass_diag*eta). ! --- P3.2 (3D multilayer) column slots — allocated only when !     nz_si > 1.  Layer convention: (nz, ncells) axis order — k=1 !     bed, k=nz surface, cell index LAST (unstructured convention, !     OPPOSITE of the structured (nx,ny,nz)). --- real ( wp ), allocatable :: g_col_u (:, :) !! Column x-velocity response G_k&#94;u = solve(u&#94;n + tendencies) !! (nz, ncells_total) [m/s]. real ( wp ), allocatable :: g_col_v (:, :) !! Column y-velocity response G_k&#94;v (nz, ncells_total) [m/s]. real ( wp ), allocatable :: r_col (:, :) !! Column response R_k = solve(-1) (nz, ncells_total) [m/s] !! (<= 0); axis-independent — u and v share the tridiagonal. real ( wp ), allocatable :: nu_iface (:, :) !! PP81 interface viscosity (nz+1, ncells_total) [m&#94;2/s]; index k !! = interface BELOW layer k (bed row 1 and surface row nz+1 = 0). real ( wp ), allocatable :: Hhat_cell (:) !! Effective column depth Hhat = -sum_k h_k R_k (ncells_total) [m]. real ( wp ), allocatable :: Gbar_cell_x (:) !! Column-integrated predictor transport sum_k h_k G_k&#94;u !! (ncells_total) [m&#94;2/s]. real ( wp ), allocatable :: Gbar_cell_y (:) !! Column-integrated y predictor transport (ncells_total) [m&#94;2/s]. real ( wp ), allocatable :: u_edge_layer (:, :, :) !! Recovered per-layer edge-normal transports !! (nz, EDGES_PER_TRI, ncells_total) [m&#94;2/s] — double-visit, same !! outward-normal convention as `u_edge`.  Column sums telescope to !! the 2D back-substituted edge transport (mass consistency). real ( wp ), allocatable :: mass_flux_edge (:, :) !! Blended column edge mass flux theta*sum_k u_edge_layer + !! (1-theta)*U&#94;n_e (EDGES_PER_TRI, ncells_total) [m&#94;2/s] — the !! EXACT flux the eta update used; drives the dsig tracer split. contains procedure , non_overridable :: init => si_unstr_state_init procedure , non_overridable :: destroy => si_unstr_state_destroy procedure , non_overridable :: enter_data => si_unstr_state_enter_data procedure , non_overridable :: exit_data => si_unstr_state_exit_data procedure , non_overridable :: build_mg => si_unstr_state_build_mg end type semi_implicit_state_unstr_t","tags":"","url":"type/semi_implicit_state_unstr_t.html"},{"title":"mesh_unstr_t – Rakali ","text":"type, public :: mesh_unstr_t Triangular mesh in flat layout. Inherited by type~~mesh_unstr_t~~InheritedByGraph type~mesh_unstr_t mesh_unstr_t type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~mesh_unstr_t mesh Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public, allocatable :: area (:) Cell area, size ncells_total. integer, public, allocatable :: bc_group (:,:) Boundary group id on edge i of cell k, 0 on interior edges. integer(kind=int64), public, allocatable :: cell_global_id (:) Cell ids 1..ncells_total , written to the output / restart\nfiles. real(kind=wp), public, allocatable :: centroid_x (:) Cell centroid x, size ncells_total. real(kind=wp), public, allocatable :: centroid_y (:) Cell centroid y, size ncells_total. real(kind=wp), public, allocatable :: circumcentre_x (:) Cell circumcentre x, size ncells_total.  eta lives here on the\nSI path.  Computed from the three vertices in compute_geometry . real(kind=wp), public, allocatable :: circumcentre_y (:) Cell circumcentre y, size ncells_total. real(kind=wp), public, allocatable :: edge_delta (:,:) Circumcentre-to-circumcentre distance across edge i of cell k,\nshape (3, ncells_total) (m).  Interior edge: |cc(nbr) - cc(k)|.\nBoundary edge: circumcentre-to-edge-midpoint distance (the\nDirichlet ghost sits at the mirror across the edge).  The TPFA\ntransmissibility is Hf * edge_len / edge_delta .  Built in a\nsecond pass ( compute_si_geometry ) once neighbours are known. real(kind=wp), public, allocatable :: edge_dev_angle (:,:) Deviation angle (degrees) between the outward edge-normal and the\ncircumcentre line across edge i of cell k, shape (3, ncells_total).\n0 = orthogonal (ideal Delaunay).  The mesh-quality-gate metric;\nboundary edges carry 0 (not meaningful for the Dirichlet ghost). real(kind=wp), public, allocatable :: edge_len (:,:) Length of edge i of cell k. real(kind=wp), public, allocatable :: edge_mid_x (:,:) Edge midpoint x. real(kind=wp), public, allocatable :: edge_mid_y (:,:) Edge midpoint y. real(kind=wp), public, allocatable :: edge_n1 (:,:) Outward unit normal x-component for edge i of cell k. real(kind=wp), public, allocatable :: edge_n2 (:,:) Outward unit normal y-component for edge i of cell k. real(kind=wp), public :: max_dev_angle = 0.0_wp Max interior edge_dev_angle over the owned cells (degrees) — the\nfail-loud quality-gate scalar (abort if > ~5 deg on the SI path). real(kind=wp), public :: min_edge_delta = 0.0_wp Smallest SIGNED circumcentre-line projection on the outward\nedge-normal over the owned interior edges (m) — the quality-gate\nscalar.  Non-positive = a degenerate (coincident circumcentres,\nright-triangle split) or locally non-Delaunay (flipped) pair =>\nzero / wrong-signed TPFA transmissibility => abort. integer, public, allocatable :: n_boundaries (:) Number of boundary edges on each cell, 0..3, size ncells_total. integer, public :: n_boundary_edges = 0 Total boundary edges across owned cells. integer, public :: ncells_owned = 0 Number of cells (live at indices 1..ncells_owned). integer, public :: ncells_total = 0 Equal to ncells_owned . integer, public, allocatable :: neighbour_edges (:,:) Local edge index (1..3) of the neighbour that matches edge i\nof cell k, or -1 on a physical boundary. integer, public, allocatable :: neighbours (:,:) Neighbouring cell index across edge i of cell k, or -1 if the\nedge is on a physical boundary. integer, public :: nverts = 0 Number of unique vertices. real(kind=wp), public, allocatable :: radius (:) Inscribed-circle radius, size ncells_total. Used as the CFL\nlength scale for CFL computation. integer, public, allocatable :: surrogate_neighbours (:,:) Same as neighbours, but k itself if the edge is a physical\nboundary. Used by the gradient stencil so the reconstruction\nkernel never branches on boundaries. integer, public, allocatable :: tri_v (:,:) Vertex ids of each triangle, shape (3, ncells_total). Ordered\ncounter-clockwise; local vertex i is opposite local edge i. real(kind=wp), public, allocatable :: vert_x (:) Vertex x coordinate, size nverts. real(kind=wp), public, allocatable :: vert_y (:) Vertex y coordinate, size nverts. Source Code type :: mesh_unstr_t !! Triangular mesh in flat layout. ! ----- sizes ----- integer :: nverts = 0 !! Number of unique vertices. integer :: ncells_owned = 0 !! Number of cells (live at indices 1..ncells_owned). integer :: ncells_total = 0 !! Equal to `ncells_owned`. integer :: n_boundary_edges = 0 !! Total boundary edges across owned cells. ! ----- vertex arrays ----- real ( wp ), allocatable :: vert_x (:) !! Vertex x coordinate, size nverts. real ( wp ), allocatable :: vert_y (:) !! Vertex y coordinate, size nverts. ! ----- per-cell arrays ----- integer , allocatable :: tri_v (:, :) !! Vertex ids of each triangle, shape (3, ncells_total). Ordered !! counter-clockwise; local vertex i is opposite local edge i. real ( wp ), allocatable :: centroid_x (:) !! Cell centroid x, size ncells_total. real ( wp ), allocatable :: centroid_y (:) !! Cell centroid y, size ncells_total. real ( wp ), allocatable :: area (:) !! Cell area, size ncells_total. real ( wp ), allocatable :: radius (:) !! Inscribed-circle radius, size ncells_total. Used as the CFL !! length scale for CFL computation. integer , allocatable :: n_boundaries (:) !! Number of boundary edges on each cell, 0..3, size ncells_total. ! ----- per-edge-of-cell arrays, shape (3, ncells_total) ----- real ( wp ), allocatable :: edge_len (:, :) !! Length of edge i of cell k. real ( wp ), allocatable :: edge_n1 (:, :) !! Outward unit normal x-component for edge i of cell k. real ( wp ), allocatable :: edge_n2 (:, :) !! Outward unit normal y-component for edge i of cell k. real ( wp ), allocatable :: edge_mid_x (:, :) !! Edge midpoint x. real ( wp ), allocatable :: edge_mid_y (:, :) !! Edge midpoint y. integer , allocatable :: neighbours (:, :) !! Neighbouring cell index across edge i of cell k, or -1 if the !! edge is on a physical boundary. integer , allocatable :: neighbour_edges (:, :) !! Local edge index (1..3) of the neighbour that matches edge i !! of cell k, or -1 on a physical boundary. integer , allocatable :: surrogate_neighbours (:, :) !! Same as neighbours, but k itself if the edge is a physical !! boundary. Used by the gradient stencil so the reconstruction !! kernel never branches on boundaries. integer , allocatable :: bc_group (:, :) !! Boundary group id on edge i of cell k, 0 on interior edges. ! ----- semi-implicit (TPFA) geometry, computed once at init ----- ! The semi-implicit free-surface solver (`time_scheme=\"semi_implicit\"`) ! places eta at the triangle CIRCUMCENTRE (NOT the centroid the KNP ! path uses): a Delaunay edge is orthogonal to the circumcentre line ! by construction, which makes the two-point (TPFA) edge flux ! consistent (Casulli & Walters 2000).  Centroids stay untouched for ! the KNP reconstruction; these fields are the SI-specific additions. real ( wp ), allocatable :: circumcentre_x (:) !! Cell circumcentre x, size ncells_total.  eta lives here on the !! SI path.  Computed from the three vertices in `compute_geometry`. real ( wp ), allocatable :: circumcentre_y (:) !! Cell circumcentre y, size ncells_total. real ( wp ), allocatable :: edge_delta (:, :) !! Circumcentre-to-circumcentre distance across edge i of cell k, !! shape (3, ncells_total) (m).  Interior edge: |cc(nbr) - cc(k)|. !! Boundary edge: circumcentre-to-edge-midpoint distance (the !! Dirichlet ghost sits at the mirror across the edge).  The TPFA !! transmissibility is `Hf * edge_len / edge_delta`.  Built in a !! second pass (`compute_si_geometry`) once neighbours are known. real ( wp ), allocatable :: edge_dev_angle (:, :) !! Deviation angle (degrees) between the outward edge-normal and the !! circumcentre line across edge i of cell k, shape (3, ncells_total). !! 0 = orthogonal (ideal Delaunay).  The mesh-quality-gate metric; !! boundary edges carry 0 (not meaningful for the Dirichlet ghost). real ( wp ) :: max_dev_angle = 0.0_wp !! Max interior `edge_dev_angle` over the owned cells (degrees) — the !! fail-loud quality-gate scalar (abort if > ~5 deg on the SI path). real ( wp ) :: min_edge_delta = 0.0_wp !! Smallest SIGNED circumcentre-line projection on the outward !! edge-normal over the owned interior edges (m) — the quality-gate !! scalar.  Non-positive = a degenerate (coincident circumcentres, !! right-triangle split) or locally non-Delaunay (flipped) pair => !! zero / wrong-signed TPFA transmissibility => abort. integer ( int64 ), allocatable :: cell_global_id (:) !! Cell ids `1..ncells_total`, written to the output / restart !! files. end type mesh_unstr_t","tags":"","url":"type/mesh_unstr_t.html"},{"title":"bc_params_t – Rakali ","text":"type, public :: bc_params_t Boundary condition parameters for all four edges Inherited by type~~bc_params_t~~InheritedByGraph type~bc_params_t bc_params_t type~state_t state_t type~state_t->type~bc_params_t bc type~solver_handle_t solver_handle_t type~solver_handle_t->type~state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\n