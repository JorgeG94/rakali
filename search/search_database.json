drostatic_state_t ), intent(inout) :: this Source Code subroutine nh_state_destroy ( this ) class ( nonhydrostatic_state_t ), intent ( inout ) :: this if ( allocated ( this % dsig )) deallocate ( this % dsig ) if ( allocated ( this % u_layer )) deallocate ( this % u_layer ) if ( allocated ( this % v_layer )) deallocate ( this % v_layer ) if ( allocated ( this % w )) deallocate ( this % w ) if ( allocated ( this % q_nh )) deallocate ( this % q_nh ) if ( allocated ( this % u_layer0 )) deallocate ( this % u_layer0 ) if ( allocated ( this % v_layer0 )) deallocate ( this % v_layer0 ) if ( allocated ( this % w0 )) deallocate ( this % w0 ) if ( allocated ( this % cg_r )) deallocate ( this % cg_r ) if ( allocated ( this % cg_p )) deallocate ( this % cg_p ) if ( allocated ( this % cg_Ap )) deallocate ( this % cg_Ap ) if ( allocated ( this % cg_z )) deallocate ( this % cg_z ) if ( allocated ( this % hu_pre )) deallocate ( this % hu_pre ) if ( allocated ( this % hv_pre )) deallocate ( this % hv_pre ) if ( allocated ( this % h_avg )) deallocate ( this % h_avg ) if ( allocated ( this % hu_avg )) deallocate ( this % hu_avg ) if ( allocated ( this % hv_avg )) deallocate ( this % hv_avg ) if ( allocated ( this % h_bt0 )) deallocate ( this % h_bt0 ) if ( allocated ( this % hu_bt0 )) deallocate ( this % hu_bt0 ) if ( allocated ( this % hv_bt0 )) deallocate ( this % hv_bt0 ) if ( allocated ( this % baro_tend_x )) deallocate ( this % baro_tend_x ) if ( allocated ( this % baro_tend_y )) deallocate ( this % baro_tend_y ) end subroutine nh_state_destroy","tags":"","url":"proc/nh_state_destroy.html"},{"title":"nh_state_init – Rakali","text":"private  subroutine nh_state_init(this, grid) Allocate all NH arrays at the grid size and the configured\nlayer count.  Mode-splitting arrays are allocated only when split_ratio /= 1 .  PCG preconditioner workspace cg_z is\nalways allocated; the OpenACC enter data directive is\nconditional on nh_preconditioner so unused PCG state isn’t\nmapped to the device. Caller must have set this%nz , the CG/NH scalar config, and this%split_ratio / this%split_averaging before calling. Type Bound nonhydrostatic_state_t Arguments Type Intent Optional Attributes Name class( nonhydrostatic_state_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid Variables Type Visibility Attributes Name Initial integer, private :: nx integer, private :: ny integer, private :: nz Source Code subroutine nh_state_init ( this , grid ) !! Allocate all NH arrays at the grid size and the configured !! layer count.  Mode-splitting arrays are allocated only when !! `split_ratio /= 1`.  PCG preconditioner workspace `cg_z` is !! always allocated; the OpenACC `enter data` directive is !! conditional on `nh_preconditioner` so unused PCG state isn't !! mapped to the device. !! !! Caller must have set `this%nz`, the CG/NH scalar config, and !! `this%split_ratio` / `this%split_averaging` before calling. class ( nonhydrostatic_state_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid integer :: nx , ny , nz nx = grid % nx_total ny = grid % ny_total nz = this % nz allocate ( this % dsig ( nz )) this % dsig = 1.0_wp / real ( nz , wp ) allocate ( this % u_layer ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % v_layer ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % w ( nx , ny , nz + 1 ), source = 0.0_wp ) allocate ( this % q_nh ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % u_layer0 ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % v_layer0 ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % w0 ( nx , ny , nz + 1 ), source = 0.0_wp ) allocate ( this % cg_r ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % cg_p ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % cg_Ap ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % cg_z ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % hu_pre ( nx , ny ), source = 0.0_wp ) allocate ( this % hv_pre ( nx , ny ), source = 0.0_wp ) ! Mode-splitting arrays only when split is on if ( this % split_ratio /= 1 ) then allocate ( this % h_avg ( nx , ny ), source = 0.0_wp ) allocate ( this % hu_avg ( nx , ny ), source = 0.0_wp ) allocate ( this % hv_avg ( nx , ny ), source = 0.0_wp ) allocate ( this % h_bt0 ( nx , ny ), source = 0.0_wp ) allocate ( this % hu_bt0 ( nx , ny ), source = 0.0_wp ) allocate ( this % hv_bt0 ( nx , ny ), source = 0.0_wp ) allocate ( this % baro_tend_x ( nx , ny ), source = 0.0_wp ) allocate ( this % baro_tend_y ( nx , ny ), source = 0.0_wp ) end if end subroutine nh_state_init","tags":"","url":"proc/nh_state_init.html"},{"title":"all_neighbours_wet – Rakali","text":"private pure function all_neighbours_wet(h_col, h_col_ip1, h_col_im1, h_col_jp1, h_col_jm1) result(all_wet) Returns .true. if the centre cell and its four face-neighbours all\nhave a total column depth at or above ML_MIN_DEPTH . Used to guard central-difference operators (BPG, divergence, etc.)\nthat produce spurious gradients when any of the five stencil\ncolumns is dry. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_col column depth at (i,j) real(kind=wp), intent(in) :: h_col_ip1 column depth at (i+1,j) real(kind=wp), intent(in) :: h_col_im1 column depth at (i-1,j) real(kind=wp), intent(in) :: h_col_jp1 column depth at (i,j+1) real(kind=wp), intent(in) :: h_col_jm1 column depth at (i,j-1) Return Value logical Called by proc~~all_neighbours_wet~~CalledByGraph proc~all_neighbours_wet all_neighbours_wet proc~ml_baroclinic_pressure_gradient ml_baroclinic_pressure_gradient proc~ml_baroclinic_pressure_gradient->proc~all_neighbours_wet proc~ml_baroclinic_pressure_gradient_jacobian ml_baroclinic_pressure_gradient_jacobian proc~ml_baroclinic_pressure_gradient_jacobian->proc~all_neighbours_wet proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient_jacobian proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure logical function all_neighbours_wet ( h_col , h_col_ip1 , h_col_im1 , & h_col_jp1 , h_col_jm1 ) result ( all_wet ) !$acc routine seq !! Returns `.true.` if the centre cell and its four face-neighbours all !! have a total column depth at or above `ML_MIN_DEPTH`. !! !! Used to guard central-difference operators (BPG, divergence, etc.) !! that produce spurious gradients when any of the five stencil !! columns is dry. real ( wp ), intent ( in ) :: h_col !! column depth at (i,j) real ( wp ), intent ( in ) :: h_col_ip1 !! column depth at (i+1,j) real ( wp ), intent ( in ) :: h_col_im1 !! column depth at (i-1,j) real ( wp ), intent ( in ) :: h_col_jp1 !! column depth at (i,j+1) real ( wp ), intent ( in ) :: h_col_jm1 !! column depth at (i,j-1) all_wet = h_col >= ML_MIN_DEPTH . and . & h_col_ip1 >= ML_MIN_DEPTH . and . & h_col_im1 >= ML_MIN_DEPTH . and . & h_col_jp1 >= ML_MIN_DEPTH . and . & h_col_jm1 >= ML_MIN_DEPTH end function all_neighbours_wet","tags":"","url":"proc/all_neighbours_wet.html"},{"title":"rho_ref_at – Rakali","text":"private pure function rho_ref_at(z, rho_ref, dz, nz_ref, rho_0) result(rho) Linear interpolation of the reference-density profile at depth z.\nOut-of-range falls back to the nearest endpoint. When the profile\nis unset ( dz == 0 ) returns rho_0 so the kernel reduces to the\npre-B2 anomaly. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: z real(kind=wp), intent(in) :: rho_ref (0:nz_ref) real(kind=wp), intent(in) :: dz integer, intent(in) :: nz_ref real(kind=wp), intent(in) :: rho_0 Return Value real(kind=wp) Called by proc~~rho_ref_at~2~~CalledByGraph proc~rho_ref_at~2 rho_ref_at proc~ml_baroclinic_pressure_gradient ml_baroclinic_pressure_gradient proc~ml_baroclinic_pressure_gradient->proc~rho_ref_at~2 proc~ml_baroclinic_pressure_gradient_jacobian ml_baroclinic_pressure_gradient_jacobian proc~ml_baroclinic_pressure_gradient_jacobian->proc~rho_ref_at~2 proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient_jacobian proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: frac integer, private :: i real(kind=wp), private :: zr Source Code pure function rho_ref_at ( z , rho_ref , dz , nz_ref , rho_0 ) result ( rho ) !$acc routine seq !! Linear interpolation of the reference-density profile at depth z. !! Out-of-range falls back to the nearest endpoint. When the profile !! is unset (`dz == 0`) returns rho_0 so the kernel reduces to the !! pre-B2 anomaly. real ( wp ), intent ( in ) :: z , dz , rho_0 integer , intent ( in ) :: nz_ref real ( wp ), intent ( in ) :: rho_ref ( 0 : nz_ref ) real ( wp ) :: rho , zr , frac integer :: i if ( dz <= 0.0_wp . or . nz_ref < 1 ) then rho = rho_0 return end if zr = max ( 0.0_wp , min ( z , dz * real ( nz_ref , wp ))) i = int ( zr / dz ) if ( i >= nz_ref ) then rho = rho_ref ( nz_ref ) else frac = zr / dz - real ( i , wp ) rho = ( 1.0_wp - frac ) * rho_ref ( i ) + frac * rho_ref ( i + 1 ) end if end function rho_ref_at","tags":"","url":"proc/rho_ref_at~2.html"},{"title":"ml_baroclinic_pressure_gradient – Rakali","text":"public pure subroutine ml_baroclinic_pressure_gradient(h_layer, rho_layer, hu_layer, hv_layer, rho_0, rho_ref, rho_ref_dz, nz_ref, grid, nz, dt) Apply baroclinic pressure gradient as explicit source term —\nonly the density-driven part; the barotropic PGF (g·deta/dx) is\nhandled by the HLL step. Hydrostatic internal pressure at the centre of layer k:\n  p_k = g * [ 0.5 rho_k h_k + sum_{j=k+1}&#94;{nz} rho_j*h_j ]\nBaroclinic PGF for layer k:\n  BPG_k&#94;x = -(g/rho_0) * h_k * dp_internal/dx\nAccumulated top-down per column, then central-differenced. OBC: the stencil reads ghost columns. OBC_WALL ghosts keep their\nIC state ⇒ zero-gradient PGF at the wall. For OPEN/TIDAL/CLAMPED,\ncallers wanting PGF to see the OBC value must populate the ghost h_layer first; per-edge dispatch is a deferred v2. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: rho_ref (0:nz_ref) real(kind=wp), intent(in) :: rho_ref_dz integer, intent(in) :: nz_ref type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_baroclinic_pressure_gradient~~CallsGraph proc~ml_baroclinic_pressure_gradient ml_baroclinic_pressure_gradient local local proc~ml_baroclinic_pressure_gradient->local proc~all_neighbours_wet all_neighbours_wet proc~ml_baroclinic_pressure_gradient->proc~all_neighbours_wet proc~rho_ref_at~2 rho_ref_at proc~ml_baroclinic_pressure_gradient->proc~rho_ref_at~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_baroclinic_pressure_gradient~~CalledByGraph proc~ml_baroclinic_pressure_gradient ml_baroclinic_pressure_gradient proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: acc real(kind=wp), private :: dp_dx real(kind=wp), private :: dp_dy real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: h_col real(kind=wp), private :: h_col_im1 real(kind=wp), private :: h_col_ip1 real(kind=wp), private :: h_col_jm1 real(kind=wp), private :: h_col_jp1 integer, private :: i real(kind=wp), private :: inv_2dx real(kind=wp), private :: inv_2dy real(kind=wp), private :: inv_rho0 integer, private :: j integer, private :: k integer, private :: kk integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: p_int (BPG_NZ_MAX) real(kind=wp), private :: p_int_im1 (BPG_NZ_MAX) real(kind=wp), private :: p_int_ip1 (BPG_NZ_MAX) real(kind=wp), private :: p_int_jm1 (BPG_NZ_MAX) real(kind=wp), private :: p_int_jp1 (BPG_NZ_MAX) real(kind=wp), private :: z_bot real(kind=wp), private :: z_mid_lay real(kind=wp), private :: z_top Source Code pure subroutine ml_baroclinic_pressure_gradient ( h_layer , rho_layer , & hu_layer , hv_layer , & rho_0 , rho_ref , rho_ref_dz , nz_ref , & grid , nz , dt ) !! Apply baroclinic pressure gradient as explicit source term — !! only the density-driven part; the barotropic PGF (g·deta/dx) is !! handled by the HLL step. !! !! Hydrostatic internal pressure at the centre of layer k: !!   p_k = g * [ 0.5*rho_k*h_k + sum_{j=k+1}&#94;{nz} rho_j*h_j ] !! Baroclinic PGF for layer k: !!   BPG_k&#94;x = -(g/rho_0) * h_k * dp_internal/dx !! Accumulated top-down per column, then central-differenced. !! !! OBC: the stencil reads ghost columns. OBC_WALL ghosts keep their !! IC state ⇒ zero-gradient PGF at the wall. For OPEN/TIDAL/CLAMPED, !! callers wanting PGF to see the OBC value must populate the ghost !! `h_layer` first; per-edge dispatch is a deferred v2. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz , nz_ref real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 real ( wp ), intent ( in ) :: rho_ref ( 0 : nz_ref ) real ( wp ), intent ( in ) :: rho_ref_dz real ( wp ), intent ( in ) :: dt ! Internal pressure at layer centres. ! For small nz (2-5) these fit comfortably in registers/stack per thread. ! Workspace capped by BPG_NZ_MAX (see module-level comment); ! validate_config rejects namelists that exceed this at startup. real ( wp ) :: p_int ( BPG_NZ_MAX ) integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: inv_2dx , inv_2dy , inv_rho0 real ( wp ) :: acc , h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 real ( wp ) :: dp_dx , dp_dy real ( wp ) :: z_top , z_bot , z_mid_lay real ( wp ) :: p_int_ip1 ( BPG_NZ_MAX ), p_int_im1 ( BPG_NZ_MAX ) real ( wp ) :: p_int_jp1 ( BPG_NZ_MAX ), p_int_jm1 ( BPG_NZ_MAX ) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_2dx = 0.5_wp / dx inv_2dy = 0.5_wp / dy inv_rho0 = 1.0_wp / rho_0 ! Process each interior cell ! We need the internal pressure at (i,j), (i±1,j), (i,j±1) for ! central differences. Compute all five columns per cell. do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , acc , p_int , p_int_ip1 , p_int_im1 , p_int_jp1 , p_int_jm1 , & dp_dx , dp_dy , h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 , & z_top , z_bot , z_mid_lay ) ! Compute total column depth for this cell and its neighbours h_col = 0.0_wp h_col_im1 = 0.0_wp h_col_ip1 = 0.0_wp h_col_jm1 = 0.0_wp h_col_jp1 = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) h_col_im1 = h_col_im1 + h_layer ( i - 1 , j , kk ) h_col_ip1 = h_col_ip1 + h_layer ( i + 1 , j , kk ) h_col_jm1 = h_col_jm1 + h_layer ( i , j - 1 , kk ) h_col_jp1 = h_col_jp1 + h_layer ( i , j + 1 , kk ) end do ! Skip cells near dry columns — BPG central differences across ! wet/dry fronts produce spurious pressure gradients if (. not . all_neighbours_wet ( h_col , h_col_ip1 , h_col_im1 , & h_col_jp1 , h_col_jm1 )) cycle ! Compute baroclinic pressure anomaly using !   rho' = rho - rho_ref(z) ! where rho_ref(z) is the horizontally-uniform reference profile ! (Phase B2). When unset (rho_ref_dz==0) the helper returns ! rho_0, recovering the pre-B2 anomaly. ! Column (i,j) acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i , j , k ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( rho_layer ( i , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j , k ) p_int ( k ) = acc - 0.5_wp * ( rho_layer ( i , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j , k ) z_top = z_bot end do ! Column (i+1,j) acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i + 1 , j , k ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( rho_layer ( i + 1 , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i + 1 , j , k ) p_int_ip1 ( k ) = acc - 0.5_wp * ( rho_layer ( i + 1 , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i + 1 , j , k ) z_top = z_bot end do ! Column (i-1,j) acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i - 1 , j , k ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( rho_layer ( i - 1 , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i - 1 , j , k ) p_int_im1 ( k ) = acc - 0.5_wp * ( rho_layer ( i - 1 , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i - 1 , j , k ) z_top = z_bot end do ! Column (i,j+1) acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i , j + 1 , k ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( rho_layer ( i , j + 1 , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j + 1 , k ) p_int_jp1 ( k ) = acc - 0.5_wp * ( rho_layer ( i , j + 1 , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j + 1 , k ) z_top = z_bot end do ! Column (i,j-1) acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + h_layer ( i , j - 1 , k ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( rho_layer ( i , j - 1 , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j - 1 , k ) p_int_jm1 ( k ) = acc - 0.5_wp * ( rho_layer ( i , j - 1 , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j - 1 , k ) z_top = z_bot end do ! Apply pressure gradient to each layer. ! Cap the BPG acceleration to prevent the sigma-coordinate PGE ! from creating velocities exceeding the local wave speed. do k = 1 , nz dp_dx = ( p_int_ip1 ( k ) - p_int_im1 ( k )) * inv_2dx dp_dy = ( p_int_jp1 ( k ) - p_int_jm1 ( k )) * inv_2dy dp_dx = GRAVITY * inv_rho0 * dp_dx dp_dy = GRAVITY * inv_rho0 * dp_dy ! Limit: BPG acceleration <= sqrt(g'*H)/dt per step acc = abs ( rho_layer ( i , j , 1 ) - rho_layer ( i , j , nz )) * inv_rho0 acc = sqrt ( max ( acc , 1.0e-6_wp ) * GRAVITY & * max ( h_col , ML_MIN_DEPTH )) & / max ( dt , 1.0e-10_wp ) if ( abs ( dp_dx ) > acc ) dp_dx = sign ( acc , dp_dx ) if ( abs ( dp_dy ) > acc ) dp_dy = sign ( acc , dp_dy ) if ( h_layer ( i , j , k ) > VANISHING_LAYER_TOL ) then hu_layer ( i , j , k ) = hu_layer ( i , j , k ) - dt * h_layer ( i , j , k ) * dp_dx hv_layer ( i , j , k ) = hv_layer ( i , j , k ) - dt * h_layer ( i , j , k ) * dp_dy else ! VCOORD_ZSTAR_FULL invariant: vanishing layers carry no ! momentum.  Keeps hu/h velocity bounded in vanishing rows ! where h_layer ≈ h_min and any residual momentum would ! show up as an unphysical velocity. hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp end if end do end do end subroutine ml_baroclinic_pressure_gradient","tags":"","url":"proc/ml_baroclinic_pressure_gradient.html"},{"title":"ml_baroclinic_pressure_gradient_jacobian – Rakali","text":"public pure subroutine ml_baroclinic_pressure_gradient_jacobian(h_layer, rho_layer, hu_layer, hv_layer, rho_0, rho_ref, rho_ref_dz, nz_ref, grid, nz, dt) Baroclinic pressure gradient via the pressure Jacobian method\n(Shchepetkin & McWilliams 2003): the pressure gradient along\nconstant-z surfaces, interpolating the neighbour column’s pressure\nto the centre column’s physical depth. Uniform density ⇒ zero BPG. Per cell (i,j): z_mid(k) = layer-k centre depth from surface;\np(z) = integral of (rho-rho_ref)*g from surface; interpolate\nneighbour p(z) to z_mid(k); dp/dx = [p_nbr - p_centre]/dx. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: rho_ref (0:nz_ref) real(kind=wp), intent(in) :: rho_ref_dz integer, intent(in) :: nz_ref type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_baroclinic_pressure_gradient_jacobian~~CallsGraph proc~ml_baroclinic_pressure_gradient_jacobian ml_baroclinic_pressure_gradient_jacobian local local proc~ml_baroclinic_pressure_gradient_jacobian->local proc~all_neighbours_wet all_neighbours_wet proc~ml_baroclinic_pressure_gradient_jacobian->proc~all_neighbours_wet proc~rho_ref_at~2 rho_ref_at proc~ml_baroclinic_pressure_gradient_jacobian->proc~rho_ref_at~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_baroclinic_pressure_gradient_jacobian~~CalledByGraph proc~ml_baroclinic_pressure_gradient_jacobian ml_baroclinic_pressure_gradient_jacobian proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_baroclinic_pressure_gradient_jacobian proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: acc real(kind=wp), private :: dp_dx real(kind=wp), private :: dp_dy real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: frac real(kind=wp), private :: h_col real(kind=wp), private :: h_col_im1 real(kind=wp), private :: h_col_ip1 real(kind=wp), private :: h_col_jm1 real(kind=wp), private :: h_col_jp1 integer, private :: i real(kind=wp), private :: inv_2dx real(kind=wp), private :: inv_2dy real(kind=wp), private :: inv_rho0 integer, private :: j integer, private :: k integer, private :: kk integer, private :: kn integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: p_here real(kind=wp), private :: p_if (BPG_NZ_MAX+1) real(kind=wp), private :: p_nbr real(kind=wp), private :: pn_if_im1 (BPG_NZ_MAX+1) real(kind=wp), private :: pn_if_ip1 (BPG_NZ_MAX+1) real(kind=wp), private :: pn_if_jm1 (BPG_NZ_MAX+1) real(kind=wp), private :: pn_if_jp1 (BPG_NZ_MAX+1) real(kind=wp), private :: z_if (BPG_NZ_MAX+1) real(kind=wp), private :: z_mid real(kind=wp), private :: z_mid_lay real(kind=wp), private :: zn_if_im1 (BPG_NZ_MAX+1) real(kind=wp), private :: zn_if_ip1 (BPG_NZ_MAX+1) real(kind=wp), private :: zn_if_jm1 (BPG_NZ_MAX+1) real(kind=wp), private :: zn_if_jp1 (BPG_NZ_MAX+1) Source Code pure subroutine ml_baroclinic_pressure_gradient_jacobian ( h_layer , rho_layer , & hu_layer , hv_layer , & rho_0 , rho_ref , rho_ref_dz , nz_ref , & grid , nz , dt ) !! Baroclinic pressure gradient via the pressure Jacobian method !! (Shchepetkin & McWilliams 2003): the pressure gradient along !! constant-z surfaces, interpolating the neighbour column's pressure !! to the centre column's physical depth. Uniform density ⇒ zero BPG. !! !! Per cell (i,j): z_mid(k) = layer-k centre depth from surface; !! p(z) = integral of (rho-rho_ref)*g from surface; interpolate !! neighbour p(z) to z_mid(k); dp/dx = [p_nbr - p_centre]/dx. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz , nz_ref real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 real ( wp ), intent ( in ) :: rho_ref ( 0 : nz_ref ) real ( wp ), intent ( in ) :: rho_ref_dz real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , kn , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: inv_2dx , inv_2dy , inv_rho0 real ( wp ) :: h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 ! Centre column: depth of layer interfaces and pressure at interfaces. ! Workspace capped by BPG_NZ_MAX (see module-level comment); ! validate_config rejects namelists that exceed this at startup. real ( wp ) :: z_if ( BPG_NZ_MAX + 1 ), p_if ( BPG_NZ_MAX + 1 ) ! One neighbour column per direction. Built once per cell and ! reused for every layer's search/interpolate. Hoisting these out ! of the inner `k` loop is what cuts BPG runtime in half -- the ! columns are independent of `z_mid`, only the queries into them ! depend on `k`. real ( wp ) :: zn_if_ip1 ( BPG_NZ_MAX + 1 ), pn_if_ip1 ( BPG_NZ_MAX + 1 ) real ( wp ) :: zn_if_im1 ( BPG_NZ_MAX + 1 ), pn_if_im1 ( BPG_NZ_MAX + 1 ) real ( wp ) :: zn_if_jp1 ( BPG_NZ_MAX + 1 ), pn_if_jp1 ( BPG_NZ_MAX + 1 ) real ( wp ) :: zn_if_jm1 ( BPG_NZ_MAX + 1 ), pn_if_jm1 ( BPG_NZ_MAX + 1 ) real ( wp ) :: z_mid , z_mid_lay , p_here , p_nbr , dp_dx , dp_dy , frac , acc nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_2dx = 0.5_wp / dx inv_2dy = 0.5_wp / dy inv_rho0 = 1.0_wp / rho_0 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , kn , z_if , p_if , & zn_if_ip1 , pn_if_ip1 , zn_if_im1 , pn_if_im1 , & zn_if_jp1 , pn_if_jp1 , zn_if_jm1 , pn_if_jm1 , & z_mid , z_mid_lay , p_here , p_nbr , & dp_dx , dp_dy , frac , acc , & h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 ) ! Compute total column depth for this cell and its neighbours h_col = 0.0_wp h_col_im1 = 0.0_wp h_col_ip1 = 0.0_wp h_col_jm1 = 0.0_wp h_col_jp1 = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) h_col_im1 = h_col_im1 + h_layer ( i - 1 , j , kk ) h_col_ip1 = h_col_ip1 + h_layer ( i + 1 , j , kk ) h_col_jm1 = h_col_jm1 + h_layer ( i , j - 1 , kk ) h_col_jp1 = h_col_jp1 + h_layer ( i , j + 1 , kk ) end do ! Skip cells near dry columns if (. not . all_neighbours_wet ( h_col , h_col_ip1 , h_col_im1 , & h_col_jp1 , h_col_jm1 )) cycle ! --- Centre column: interface depths (from surface) and pressure --- ! z_if(nz+1) = 0 (surface), z_if(k) = depth of interface below layer k. ! Pressure uses the density anomaly `(rho - rho_ref(z))` (Phase B2); ! when rho_ref is unset (rho_ref_dz==0) the helper returns rho_0. z_if ( nz + 1 ) = 0.0_wp p_if ( nz + 1 ) = 0.0_wp do k = nz , 1 , - 1 z_if ( k ) = z_if ( k + 1 ) + h_layer ( i , j , k ) z_mid_lay = 0.5_wp * ( z_if ( k ) + z_if ( k + 1 )) p_if ( k ) = p_if ( k + 1 ) & + ( rho_layer ( i , j , k ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j , k ) end do ! --- Build neighbour columns ONCE per cell (was: nz times) --- ! Each (zn_if_*, pn_if_*) is independent of `k`; the per-layer ! work in the inner loop is just a search/interpolate against ! these prebuilt columns. ! Column (i+1, j) zn_if_ip1 ( nz + 1 ) = 0.0_wp pn_if_ip1 ( nz + 1 ) = 0.0_wp do kn = nz , 1 , - 1 zn_if_ip1 ( kn ) = zn_if_ip1 ( kn + 1 ) + h_layer ( i + 1 , j , kn ) z_mid_lay = 0.5_wp * ( zn_if_ip1 ( kn ) + zn_if_ip1 ( kn + 1 )) pn_if_ip1 ( kn ) = pn_if_ip1 ( kn + 1 ) & + ( rho_layer ( i + 1 , j , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i + 1 , j , kn ) end do ! Column (i-1, j) zn_if_im1 ( nz + 1 ) = 0.0_wp pn_if_im1 ( nz + 1 ) = 0.0_wp do kn = nz , 1 , - 1 zn_if_im1 ( kn ) = zn_if_im1 ( kn + 1 ) + h_layer ( i - 1 , j , kn ) z_mid_lay = 0.5_wp * ( zn_if_im1 ( kn ) + zn_if_im1 ( kn + 1 )) pn_if_im1 ( kn ) = pn_if_im1 ( kn + 1 ) & + ( rho_layer ( i - 1 , j , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i - 1 , j , kn ) end do ! Column (i, j+1) zn_if_jp1 ( nz + 1 ) = 0.0_wp pn_if_jp1 ( nz + 1 ) = 0.0_wp do kn = nz , 1 , - 1 zn_if_jp1 ( kn ) = zn_if_jp1 ( kn + 1 ) + h_layer ( i , j + 1 , kn ) z_mid_lay = 0.5_wp * ( zn_if_jp1 ( kn ) + zn_if_jp1 ( kn + 1 )) pn_if_jp1 ( kn ) = pn_if_jp1 ( kn + 1 ) & + ( rho_layer ( i , j + 1 , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j + 1 , kn ) end do ! Column (i, j-1) zn_if_jm1 ( nz + 1 ) = 0.0_wp pn_if_jm1 ( nz + 1 ) = 0.0_wp do kn = nz , 1 , - 1 zn_if_jm1 ( kn ) = zn_if_jm1 ( kn + 1 ) + h_layer ( i , j - 1 , kn ) z_mid_lay = 0.5_wp * ( zn_if_jm1 ( kn ) + zn_if_jm1 ( kn + 1 )) pn_if_jm1 ( kn ) = pn_if_jm1 ( kn + 1 ) & + ( rho_layer ( i , j - 1 , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j - 1 , kn ) end do do k = 1 , nz z_mid = 0.5_wp * ( z_if ( k ) + z_if ( k + 1 )) ! Centre-column pressure at z_mid (used as the shelf-break wall ! fallback whenever a neighbour column is shallower than z_mid). p_here = p_if ( k + 1 ) & + 0.5_wp * ( rho_layer ( i , j , k ) & - rho_ref_at ( z_mid , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j , k ) ! --- x-direction: search & interpolate p at z_mid --- ! Column (i+1, j) p_nbr = p_here ! default: z_mid below neighbour bed -> wall do kn = 1 , nz if ( z_mid >= zn_if_ip1 ( kn + 1 ) . and . z_mid <= zn_if_ip1 ( kn )) then if ( h_layer ( i + 1 , j , kn ) > DRY_TOLERANCE ) then frac = ( z_mid - zn_if_ip1 ( kn + 1 )) / h_layer ( i + 1 , j , kn ) else frac = 0.0_wp end if z_mid_lay = 0.5_wp * ( zn_if_ip1 ( kn ) + zn_if_ip1 ( kn + 1 )) p_nbr = pn_if_ip1 ( kn + 1 ) + frac & * ( rho_layer ( i + 1 , j , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i + 1 , j , kn ) exit end if end do dp_dx = p_nbr ! save p at z_mid in i+1 column ! Column (i-1, j) p_nbr = p_here do kn = 1 , nz if ( z_mid >= zn_if_im1 ( kn + 1 ) . and . z_mid <= zn_if_im1 ( kn )) then if ( h_layer ( i - 1 , j , kn ) > DRY_TOLERANCE ) then frac = ( z_mid - zn_if_im1 ( kn + 1 )) / h_layer ( i - 1 , j , kn ) else frac = 0.0_wp end if z_mid_lay = 0.5_wp * ( zn_if_im1 ( kn ) + zn_if_im1 ( kn + 1 )) p_nbr = pn_if_im1 ( kn + 1 ) + frac & * ( rho_layer ( i - 1 , j , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i - 1 , j , kn ) exit end if end do dp_dx = ( dp_dx - p_nbr ) * inv_2dx ! central: (p_ip1 - p_im1)/(2*dx) ! --- y-direction --- ! Column (i, j+1) p_nbr = p_here do kn = 1 , nz if ( z_mid >= zn_if_jp1 ( kn + 1 ) . and . z_mid <= zn_if_jp1 ( kn )) then if ( h_layer ( i , j + 1 , kn ) > DRY_TOLERANCE ) then frac = ( z_mid - zn_if_jp1 ( kn + 1 )) / h_layer ( i , j + 1 , kn ) else frac = 0.0_wp end if z_mid_lay = 0.5_wp * ( zn_if_jp1 ( kn ) + zn_if_jp1 ( kn + 1 )) p_nbr = pn_if_jp1 ( kn + 1 ) + frac & * ( rho_layer ( i , j + 1 , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j + 1 , kn ) exit end if end do dp_dy = p_nbr ! save p at z_mid in j+1 column ! Column (i, j-1) p_nbr = p_here do kn = 1 , nz if ( z_mid >= zn_if_jm1 ( kn + 1 ) . and . z_mid <= zn_if_jm1 ( kn )) then if ( h_layer ( i , j - 1 , kn ) > DRY_TOLERANCE ) then frac = ( z_mid - zn_if_jm1 ( kn + 1 )) / h_layer ( i , j - 1 , kn ) else frac = 0.0_wp end if z_mid_lay = 0.5_wp * ( zn_if_jm1 ( kn ) + zn_if_jm1 ( kn + 1 )) p_nbr = pn_if_jm1 ( kn + 1 ) + frac & * ( rho_layer ( i , j - 1 , kn ) & - rho_ref_at ( z_mid_lay , rho_ref , rho_ref_dz , nz_ref , rho_0 )) & * h_layer ( i , j - 1 , kn ) exit end if end do dp_dy = ( dp_dy - p_nbr ) * inv_2dy ! central: (p_jp1 - p_jm1)/(2*dy) ! Apply dp_dx = GRAVITY * inv_rho0 * dp_dx dp_dy = GRAVITY * inv_rho0 * dp_dy ! Limit: BPG acceleration <= sqrt(g'*H)/dt per step ! Use reduced gravity g' = g*|drho_max|/rho_0 from this column ! so the cap scales with the actual baroclinic forcing, not the ! barotropic wave speed (which is orders of magnitude too loose). acc = abs ( rho_layer ( i , j , 1 ) - rho_layer ( i , j , nz )) * inv_rho0 acc = sqrt ( max ( acc , 1.0e-6_wp ) * GRAVITY & * max ( h_col , ML_MIN_DEPTH )) & / max ( dt , 1.0e-10_wp ) if ( abs ( dp_dx ) > acc ) dp_dx = sign ( acc , dp_dx ) if ( abs ( dp_dy ) > acc ) dp_dy = sign ( acc , dp_dy ) if ( h_layer ( i , j , k ) > VANISHING_LAYER_TOL ) then hu_layer ( i , j , k ) = hu_layer ( i , j , k ) - dt * h_layer ( i , j , k ) * dp_dx hv_layer ( i , j , k ) = hv_layer ( i , j , k ) - dt * h_layer ( i , j , k ) * dp_dy else ! VCOORD_ZSTAR_FULL invariant: vanishing layers carry no momentum hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp end if end do end do end subroutine ml_baroclinic_pressure_gradient_jacobian","tags":"","url":"proc/ml_baroclinic_pressure_gradient_jacobian.html"},{"title":"si_unstr_step_ml – Rakali","text":"public  subroutine si_unstr_step_ml(state, mesh, dt, iter_out) Advance the unstructured 3D multilayer state one semi-implicit\nstep.  The caller ( solver_unstr_step_semi_implicit ) has already\nhalo-exchanged; Dirichlet boundary coupling reads state%bc_type / state%bc_eta_ext (tidal/clamped) inside the\nedge kernels — the P3.1 coefficient-space route. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt integer, intent(out) :: iter_out Calls proc~~si_unstr_step_ml~~CallsGraph proc~si_unstr_step_ml si_unstr_step_ml proc~ml_apply_coriolis_unstr ml_apply_coriolis_unstr proc~si_unstr_step_ml->proc~ml_apply_coriolis_unstr proc~ml_apply_surface_tracer_fluxes_unstr ml_apply_surface_tracer_fluxes_unstr proc~si_unstr_step_ml->proc~ml_apply_surface_tracer_fluxes_unstr proc~ml_baroclinic_pressure_gradient_jacobian_unstr ml_baroclinic_pressure_gradient_jacobian_unstr proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_jacobian_unstr proc~ml_baroclinic_pressure_gradient_unstr ml_baroclinic_pressure_gradient_unstr proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_unstr proc~ml_clamp_tracer_unstr ml_clamp_tracer_unstr proc~si_unstr_step_ml->proc~ml_clamp_tracer_unstr proc~ml_compute_barotropic_momentum_unstr ml_compute_barotropic_momentum_unstr proc~si_unstr_step_ml->proc~ml_compute_barotropic_momentum_unstr proc~ml_equation_of_state_unstr ml_equation_of_state_unstr proc~si_unstr_step_ml->proc~ml_equati