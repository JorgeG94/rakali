if ( val >= coords ( k ) . and . val < coords ( k + 1 )) then idx = k frac = ( val - coords ( k )) / ( coords ( k + 1 ) - coords ( k )) return end if end do idx = n - 1 frac = 1.0_wp end subroutine find_bracket_1d","tags":"","url":"proc/find_bracket_1d.html"},{"title":"load_parent_snapshot – Rakali","text":"private  subroutine load_parent_snapshot(nest, ncid, tidx, h, hu, hv) Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(in) :: nest integer, intent(in) :: ncid integer, intent(in) :: tidx real(kind=wp), intent(out) :: h (:,:) real(kind=wp), intent(out) :: hu (:,:) real(kind=wp), intent(out) :: hv (:,:) Calls proc~~load_parent_snapshot~~CallsGraph proc~load_parent_snapshot load_parent_snapshot nf90_get_var nf90_get_var proc~load_parent_snapshot->nf90_get_var proc~nc_check nc_check proc~load_parent_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~load_parent_snapshot~~CalledByGraph proc~load_parent_snapshot load_parent_snapshot proc~advance_parent_bracket advance_parent_bracket proc~advance_parent_bracket->proc~load_parent_snapshot proc~nesting_init nesting_init proc~nesting_init->proc~load_parent_snapshot proc~nesting_init_from_config nesting_init_from_config proc~nesting_init_from_config->p