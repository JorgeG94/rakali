ible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine gauges_unstr_close ( gauges ) !! Close the gauge output file and deallocate. type ( gauge_unstr_t ), intent ( inout ) :: gauges if ( gauges % ncid >= 0 ) then call nc_close ( gauges % ncid ) call logger % info ( \"Gauge output closed (\" // & to_string ( gauges % time_index ) // \" records, \" // & to_string ( gauges % n_local ) // \" stations)\" ) gauges % ncid = - 1 end if if ( allocated ( gauges % cell_id )) deallocate ( gauges % cell_id ) if ( allocated ( gauges % lam1 )) deallocate ( gauges % lam1 ) if ( allocated ( gauges % lam2 )) deallocate ( gauges % lam2 ) if ( allocated ( gauges % lam3 )) deallocate ( gauges % lam3 ) if ( allocated ( gauges % gauge_x )) deallocate ( gauges % gauge_x ) if ( allocated ( gauges % gauge_y )) deallocate ( gauges % gauge_y ) end subroutine gauges_unstr_close","tags":"","url":"proc/gauges_unstr_close.html"},{"title":"gauges_unstr_init – Rakali","text":"public  subroutine gauges_unstr_init(gauges, filename, mesh, n_gauges, gx, gy) Initialise gauge output. Searches owned triangles for each gauge point, computes\nbarycentric weights, and creates the output NetCDF file.\nGauges not found in any owned triangle are skipped. Arguments Type Intent Optional Attributes Name type( gauge_unstr_t ), intent(out) :: gauges character(len=*), intent(in) :: filename type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: n_gauges real(kind=wp), intent(in) :: gx (n_gauges) gauge x-coordinates real(kind=wp), intent(in) :: gy (n_gauges) gauge y-coordinates Calls proc~~gauges_unstr_init~~CallsGraph proc~gauges_unstr_init gauges_unstr_init debug debug proc~gauges_unstr_init->debug info info proc~gauges_unstr_init->info proc~barycentric_weights barycentric_weights proc~gauges_unstr_init->proc~barycentric_weights proc~create_gauge_netcdf create_gauge_netcdf proc~gauges_unstr_init->proc~create_gauge_netcdf proc~poi