y NH pressure gradient to correct layer velocities !! !! u_k -= dt * dq/dx !! v_k -= dt * dq/dy !! w corrected vertically type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: dqdx , dqdy , h_val nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( dqdx , dqdy , h_val , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz ! Horizontal NH pressure gradient (central difference) dqdx = ( q_nh ( i + 1 , j , k ) - q_nh ( i - 1 , j , k )) / ( 2.0_wp * dx ) dqdy = ( q_nh ( i , j + 1 , k ) - q_nh ( i , j - 1 , k )) / ( 2.0_wp * dy ) u_layer ( i , j , k ) = u_layer ( i , j , k ) - dt * dqdx v_layer ( i , j , k ) = v_layer ( i , j , k ) - dt * dqdy end do ! Vertical velocity correction ! w_1 = 0 (bottom), already set do k = 1 , nz if ( k < nz ) then w ( i , j , k + 1 ) = w ( i , j , k + 1 ) + & dt * ( q_nh ( i , j , k + 1 ) - q_nh ( i , j , k )) & * 2.0_wp / ( h_val * ( dsig ( k ) + dsig ( k + 1 ))) else ! Top interface: q above surface = 0 w ( i , j , k + 1 ) = w ( i , j , k + 1 ) - & dt * q_nh ( i , j , k ) * 2.0_wp / ( h_val * dsig ( k )) end if end do end if end do end subroutine apply_nh_correction","tags":"","url":"proc/apply_nh_correction.html"},{"title":"apply_poisson_operator – Rakali","text":"public pure subroutine apply_poisson_operator(h, dsig, p, Ap, nx, ny, nz, nghost, dx, dy, dt) Public only for the unit-test suite (no production module imports it).\nMatrix-free Poisson operator: Ap = A * p Horizontal: 5-point Laplacian per layer\nVertical: tridiagonal coupling between layers Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (nx,ny) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: p (nx,ny,nz) real(kind=wp), intent(out) :: Ap (nx,ny,nz) integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz integer, intent(in) :: nghost real(kind=wp), intent(in) :: dx real(kind=wp), intent(in) :: dy real(kind=wp), intent(in) :: dt Calls proc~~apply_poisson_operator~~CallsGraph proc~apply_poisson_operator apply_poisson_operator local local proc~apply_poisson_operator->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: h_val real(kind=wp), private :: horiz integer, private :: i real(kind=wp), private :: inv_dt2 real(kind=wp), private :: inv_dx2 real(kind=wp), private :: inv_dy2 integer, private :: j integer, private :: k real(kind=wp), private :: vert_hi real(kind=wp), private :: vert_lo Source Code pure subroutine apply_poisson_operator ( h , dsig , p , Ap , nx , ny , nz , nghost , dx , dy , dt ) !! Public only for the unit-test suite (no production module imports it). !! Matrix-free Poisson operator: Ap = A * p !! !! Horizontal: 5-point Laplacian per layer !! Vertical: tridiagonal coupling between layers integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: p ( nx , ny , nz ) real ( wp ), intent ( out ) :: Ap ( nx , ny , nz ) real ( wp ), intent ( in ) :: dx , dy , dt integer :: i , j , k real ( wp ) :: h_val , horiz , vert_lo , vert_hi real ( wp ) :: inv_dx2 , inv_dy2 , inv_dt2 inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) inv_dt2 = 1.0_wp / ( dt * dt ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , horiz , vert_lo , vert_hi , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then do k = 1 , nz ! Horizontal Laplacian horiz = h_val * inv_dx2 * ( p ( i + 1 , j , k ) - 2.0_wp * p ( i , j , k ) + p ( i - 1 , j , k )) & + h_val * inv_dy2 * ( p ( i , j + 1 , k ) - 2.0_wp * p ( i , j , k ) + p ( i , j - 1 , k )) ! Vertical coupling: second derivative in sigma vert_lo = 0.0_wp vert_hi = 0.0_wp if ( k > 1 ) then vert_lo = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) * & ( p ( i , j , k - 1 ) - p ( i , j , k )) end if if ( k < nz ) then vert_hi = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) * & ( p ( i , j , k + 1 ) - p ( i , j , k )) end if Ap ( i , j , k ) = horiz + vert_lo + vert_hi end do else do k = 1 , nz Ap ( i , j , k ) = 0.0_wp end do end if end do end subroutine apply_poisson_operator","tags":"","url":"proc/apply_poisson_operator.html"},{"title":"apply_poisson_operator_fast – Rakali","text":"public pure subroutine apply_poisson_operator_fast(h, p, Ap, nx, ny, nz, nghost, inv_dx2, inv_dy2, vert_lo, vert_hi) Poisson operator (Ap = A*p) using pre-computed dsig-dependent\nvertical coefficients to avoid divisions; horizontal 5-point\nLaplacian + vertical tridiagonal coupling (coefficients / h). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (nx,ny) real(kind=wp), intent(in) :: p (nx,ny,nz) real(kind=wp), intent(out) :: Ap (nx,ny,nz) integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz integer, intent(in) :: nghost real(kind=wp), intent(in) :: inv_dx2 real(kind=wp), intent(in) :: inv_dy2 real(kind=wp), intent(in) :: vert_lo (nz) real(kind=wp), intent(in) :: vert_hi (nz) Calls proc~~apply_poisson_operator_fast~~CallsGraph proc~apply_poisson_operator_fast apply_poisson_operator_fast local local proc~apply_poisson_operator_fast->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_poisson_operator_fast~~CalledByGraph proc~apply_poisson_operator_fast apply_poisson_operator_fast proc~solve_nh_pressure solve_nh_pressure proc~solve_nh_pressure->proc~apply_poisson_operator_fast proc~solver_baroclinic_rk_stage solver_baroclinic_rk_stage proc~solver_baroclinic_rk_stage->proc~solve_nh_pressure proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~solve_nh_pressure proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_baroclinic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solve