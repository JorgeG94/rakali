pha(i)*U&#94;n + (1 - alpha(i))*E      (combine) !! !! `state%dt` already carries the ssp_coeff scaling.  No save/average !! kernels are reused from RK2 — U&#94;n is backed up once, the blend is !! a per-stage compute_ssp_combine, both wet/dry-positive (SSP). type ( state_t ), intent ( inout ) :: state type ( timestepper_t ), intent ( in ) :: ts integer :: stage real ( wp ) :: t_base , dt_stage ! Back up U&#94;n once; every stage blends against this start-of-step state. call solver_save_state ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & state % grid ) t_base = state % bc % time do stage = 1 , ts % n_stages dt_stage = ts % beta ( stage ) * state % dt ! Time-dependent BCs see the stage abscissa t_base + c(i)*dt. state % bc % time = t_base + ts % c ( stage ) * state % dt call profiler_start ( \"boundary\" ) call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) call profiler_stop ( \"boundary\" ) call profiler_start ( \"flux\" ) call solver_compute_barotropic_flux ( state ) call profiler_stop ( \"flux\" ) call profiler_start ( \"update\" ) call fused_update_stage_generic ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % flux_h , state % barotropic % flux_hu , state % barotropic % flux_hv , & state % grid , dt_stage , & state % barotropic % manning_n , state % forcing % wind_x , state % forcing % wind_y , & state % forcing % atm_pressure , state % forcing % precipitation , & state % barotropic % coriolis_f , & state % forcing % active ) ! Convex blend with U&#94;n (skip when alpha == 0: the stage iterate ! IS the new running state, e.g. euler and the first rk43 stages). if ( ts % alpha ( stage ) /= 0.0_wp ) then call compute_ssp_combine ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & ts % alpha ( stage ), state % grid ) end if call profiler_stop ( \"update\" ) call apply_sponge ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , dt_stage , state % bc ) end do ! Restore the canonical end-of-step BC time (t_base + dt). state % bc % time = t_base + state % dt end subroutine solver_advance_2d_generic","tags":"","url":"proc/solver_advance_2d_generic.html"},{"title":"solver_baroclinic_rk_stage – Rakali","text":"private  subroutine solver_baroclinic_rk_stage(state, nz, dt_slow) One RK stage of baroclinic step: layer distribution, w, CG Poisson, NH correction Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state integer, intent(in) :: nz real(kind=wp), intent(in) :: dt_slow Calls proc~~solver_baroclinic_rk_stage~~CallsGraph proc~solver_baroclinic_rk_stage solver_baroclinic_rk_stage proc~apply_nh_boundary_conditions apply_nh_boundary_conditions proc~solver_baroclinic_rk_stage->proc~apply_nh_boundary_conditions proc~apply_nh_correction apply_nh_correction proc~solver_baroclinic_rk_stage->proc~apply_nh_correction proc~compute_layer_from_barotropic compute_layer_from_barotropic proc~solver_baroclinic_rk_stage->proc~compute_layer_from_barotropic proc~compute_vertical_velocity compute_vertical_velocity proc~solver_baroclinic_rk_stage->proc~compute_vertical_velocity proc~solve_nh_pressure solve_nh_pressure proc~solver_baroclinic_rk_stage->proc~solve_nh_pressure local local proc~apply_nh_correction->local proc~compute_layer_from_barotropic->local proc~compute_vertical_velocity->local proc~apply_poisson_operator_fast apply_poisson_operator_fast proc~solve_nh_pressure->proc~apply_poisson_operator_fast proc~apply_vertical_preconditioner apply_vertical_preconditioner proc~solve_nh_pressure->proc~apply_vertical_preconditioner proc~compute_nh_rhs compute_nh_rhs proc~solve_nh_pressure->proc