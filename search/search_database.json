-solve + edge back-substitution + time/step ! bookkeeping; no SSP stage table (make_timestepper would fail loud). if ( state % use_semi_implicit ) then call solver_unstr_step_semi_implicit ( state , mesh , dt ) return end if ! Selectable explicit integrator (euler/rk3/rk43): 2D barotropic ! path only.  RK2 (default) and every multilayer run fall through to ! the historical two-stage fused pipeline below. if (. not . state % use_multilayer . and . state % time_scheme /= TIME_RK2 ) then call solver_unstr_step_generic ( state , mesh , dt ) state % time = state % time + dt state % step_count = state % step_count + 1 return end if if ( state % use_multilayer ) then ! Sync the salinity/temperature scalar config (held on the ! multilayer state for backward compat) onto their tracer-registry ! entries so the generic per-tracer kernels below read per-tracer ! config uniformly.  Extra passive tracers carry their own config ! (set by register_passive_tracer).  Cheap host-side copies. it = state % multilayer % idx_salinity if ( it > 0 ) then state % multilayer % tracers ( it )% kappa_bg = state % multilayer % kappa_S_bg state % multilayer % tracers ( it )% hdiff_kappa = state % multilayer % hdiff_kappa state % multilayer % tracers ( it )% tr_min = state % multilayer % S_min state % multilayer % tracers ( it )% tr_max = state % multilayer % S_max state % multilayer % tracers ( it )% bc_ext = state % multilayer % bc_S_ext end if it = state % multilayer % idx_temperature if ( it > 0 ) then state % multilayer % tracers ( it )% kappa_bg = state % multilayer % kappa_T_bg state % multilayer % tracers ( it )% hdiff_kappa = state % multilayer % hdiff_kappa state % multilayer % tracers ( it )% tr_min = state % multilayer % T_min state % multilayer % tracers ( it )% tr_max = state % multilayer % T_max state % multilayer % tracers ( it )% bc_ext = state % multilayer % bc_T_ext end if call ml_save_layer_state_unstr ( state ) do it = 1 , size ( state % multilayer % tracers ) call ml_save_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hTr0 ) end do end if ! ----- RK substage 1: save + Euler update + friction + protect ----- call extrapolate_second_order_edge_unstr ( state , mesh ) call compute_fluxes_central_unstr ( state , mesh ) if ( state % use_multilayer ) then call ml_save_barotropic_pre_unstr ( state ) end if call fused_update_stage1_unstr ( state , mesh , dt ) call apply_sponge_unstr ( state , mesh , dt ) if ( state % use_multilayer ) then ! Tracer advection first -- it reads the OLD `h_layer` to get ! the upwind concentration and the just-stashed `mass_flux_e` ! that is consistent with the barotropic continuity update we ! just applied. That CWC recipe keeps uniform tracers exactly ! uniform and tracer mass globally conserved.  Loop the whole ! tracer registry; each tracer carries its own inflow bc_ext. do it = 1 , size ( state % multilayer % tracers ) if (. not . state % multilayer % tracers ( it )% do_horizontal_advection ) cycle if ( state % multilayer % use_ppm_tracer ) then call ml_advect_tracer_muscl_unstr ( state , mesh , state % multilayer % tracers ( it )% hTr , & dt , state % multilayer % tracers ( it )% bc_ext ) else call ml_advect_tracer_unstr ( state , mesh , state % multilayer % tracers ( it )% hTr , & dt , state % multilayer % tracers ( it )% bc_ext ) end if end do ! Horizontal tracer diffusion (Laplacian, after advection) — ! per-tracer hdiff_kappa (synced from the state scalar for S/T). do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_horizontal_diffusion . and . & state % multilayer % tracers ( it )% hdiff_kappa > 0.0_wp ) then call ml_horizontal_diffusion_tracer_unstr ( state , mesh , & state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hdiff_kappa , dt ) end if end do ! Distribute the barotropic update to layers (momentum + thickness). ! For non-sigma coordinates this reshapes to the vcoord target; ! the per-tracer conservative remap then runs over the registry. if ( state % multilayer % vcoord % needs_remap ()) then if ( state % multilayer % vcoord % coord_type == VCOORD_ZSTAR_FULL ) then call ml_distribute_with_remap_full_unstr ( state ) else call ml_distribute_with_remap_unstr ( state ) end if do it = 1 , size ( state % multilayer % tracers ) call ml_remap_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr ) end do else call ml_distribute_barotropic_unstr ( state ) end if ! Smagorinsky horizontal viscosity (after distribute, per-layer) if ( state % multilayer % smagorinsky_cs > 0.0_wp ) then call ml_horizontal_viscosity_smag_unstr ( state , mesh , dt ) end if ! Vertical velocity and exchange: only when baroclinic physics active. if ( state % multilayer % beta_S > 0.0_wp . or . state % multilayer % alpha_T > 0.0_wp ) then call ml_compute_vertical_velocity_unstr ( state , mesh ) call ml_vertical_exchange_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_exchange ) then call ml_vertical_exchange_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , dt ) end if end do ! Vertical mixing: k-epsilon when enabled (precedence), else KPP ! overlay (BL-depth sweep + shape-function diffusivity + non-local ! transport), else PP81.  KPP fuses S/T; extra passive tracers fall ! back to the PP81 interior closure with their own kappa_bg. if ( state % multilayer % vmix_use_keps ) then ! k-epsilon: friction velocities -> advance k/eps + recover ! nu_t/kt -> implicit momentum + per-tracer vertical diffusion. call ml_keps_friction_velocities_unstr ( state ) call ml_keps_update_unstr ( state , dt , . true .) call ml_keps_apply_momentum_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_keps_apply_diffusion_tracer_unstr ( state , & state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do else if ( state % multilayer % vmix_use_kpp ) then call ml_kpp_boundary_layer_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr ) call ml_kpp_viscosity_unstr ( state , dt ) call ml_kpp_diffusion_tracers_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % kappa_S_bg , state % multilayer % kappa_T_bg , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( it == state % multilayer % idx_salinity . or . it == state % multilayer % idx_temperature ) cycle if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_vertical_diffusion_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do else call ml_vertical_viscosity_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_vertical_diffusion_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do end if end if ! Surface tracer fluxes (net heat + virtual freshwater).  Runs every ! RK2 stage unconditionally to mirror the structured pipeline -- a ! passive temperature tracer (alpha_T=0) still gets warmed by Q_net. call ml_apply_surface_tracer_fluxes_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr ) ! Per-layer bottom friction (Manning, on the lowest active layer): ! damps baroclinic shear the depth-averaged friction misses. call ml_apply_bottom_friction_unstr ( state , dt ) ! CFL-based velocity truncation (MOM6-style, cfl_trunc=0.8): clip ! runaway layer velocities so a few bad cells don't tank the step. call ml_truncate_velocity_unstr ( state , mesh , dt , 0.8_wp ) ! Per-layer Coriolis: rotate every layer's (hu_k, hv_k) before ! recomputing the depth-averaged so the barotropic mean reflects ! the rotated layer momenta.  Mirrors the structured slot ! (between truncate / final per-layer kernels and the recompute). call ml_apply_coriolis_unstr ( state , dt ) call ml_compute_barotropic_momentum_unstr ( state ) end if ! ----- RK substage 2: update + friction + RK2 average + protect ----- call extrapolate_second_order_edge_unstr ( state , mesh ) call compute_fluxes_central_unstr ( state , mesh ) if ( state % use_multilayer ) then call ml_save_barotropic_pre_unstr ( state ) end if call fused_update_stage2_unstr ( state , mesh , dt ) call apply_sponge_unstr ( state , mesh , dt ) if ( state % use_multilayer ) then do it = 1 , size ( state % multilayer % tracers ) if (. not . state % multilayer % tracers ( it )% do_horizontal_advection ) cycle if ( state % multilayer % use_ppm_tracer ) then call ml_advect_tracer_muscl_unstr ( state , mesh , state % multilayer % tracers ( it )% hTr , & dt , state % multilayer % tracers ( it )% bc_ext ) else call ml_advect_tracer_unstr ( state , mesh , state % multilayer % tracers ( it )% hTr , & dt , state % multilayer % tracers ( it )% bc_ext ) end if end do ! Horizontal tracer diffusion (stage 2) — per-tracer hdiff_kappa. do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_horizontal_diffusion . and . & state % multilayer % tracers ( it )% hdiff_kappa > 0.0_wp ) then call ml_horizontal_diffusion_tracer_unstr ( state , mesh , & state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hdiff_kappa , dt ) end if end do ! `fused_update_stage2_unstr` already RK2-blended the ! barotropic state (stage_cv, xmom_cv, ymom_cv) against the ! `_backup` snapshots captured at step start, and ! the distribute propagates that blend straight into ! `h_layer`. Applying `ml_rk2_average_layers_unstr` here ! would blend a second time (effectively 0.25/0.75 weights ! instead of 0.5/0.5), breaking tracer-concentration ! consistency. So we only RK2 the tracers, which carry ! their OWN `_layer0` backups. if ( state % multilayer % vcoord % needs_remap ()) then if ( state % multilayer % vcoord % coord_type == VCOORD_ZSTAR_FULL ) then call ml_distribute_with_remap_full_unstr ( state ) else call ml_distribute_with_remap_unstr ( state ) end if do it = 1 , size ( state % multilayer % tracers ) call ml_remap_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr ) end do else call ml_distribute_barotropic_unstr ( state ) end if ! Smagorinsky horizontal viscosity (stage 2) if ( state % multilayer % smagorinsky_cs > 0.0_wp ) then call ml_horizontal_viscosity_smag_unstr ( state , mesh , dt ) end if ! Vertical velocity and exchange (stage 2): only when baroclinic physics active. if ( state % multilayer % beta_S > 0.0_wp . or . state % multilayer % alpha_T > 0.0_wp ) then call ml_compute_vertical_velocity_unstr ( state , mesh ) call ml_vertical_exchange_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_exchange ) then call ml_vertical_exchange_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , dt ) end if end do ! Vertical mixing (stage 2): k-epsilon when enabled (precedence), ! else KPP overlay, else PP81.  KPP fuses S/T; extra passive ! tracers fall back to PP81 vdiff. if ( state % multilayer % vmix_use_keps ) then ! k-epsilon: friction velocities -> advance k/eps + recover ! nu_t/kt -> implicit momentum + per-tracer vertical diffusion. call ml_keps_friction_velocities_unstr ( state ) call ml_keps_update_unstr ( state , dt , . true .) call ml_keps_apply_momentum_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_keps_apply_diffusion_tracer_unstr ( state , & state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do else if ( state % multilayer % vmix_use_kpp ) then call ml_kpp_boundary_layer_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr ) call ml_kpp_viscosity_unstr ( state , dt ) call ml_kpp_diffusion_tracers_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % kappa_S_bg , state % multilayer % kappa_T_bg , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( it == state % multilayer % idx_salinity . or . it == state % multilayer % idx_temperature ) cycle if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_vertical_diffusion_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do else call ml_vertical_viscosity_unstr ( state , dt ) do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_vertical_diffusion ) then call ml_vertical_diffusion_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% kappa_bg , dt ) end if end do end if end if ! Surface tracer fluxes (stage 2).  Must run BEFORE the RK2 ! average so the flux contribution is time-integrated by the ! 0.5*(hTr0 + hTr) blend, matching the structured pipeline. call ml_apply_surface_tracer_fluxes_unstr ( state , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr ) ! RK2 average + conservative clamp over the whole registry — ! per-tracer bounds (synced from the state scalars for S/T). do it = 1 , size ( state % multilayer % tracers ) call ml_rk2_average_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% hTr0 ) end do do it = 1 , size ( state % multilayer % tracers ) if ( state % multilayer % tracers ( it )% do_clamp ) then call ml_clamp_tracer_unstr ( state , state % multilayer % tracers ( it )% hTr , & state % multilayer % tracers ( it )% tr_min , & state % multilayer % tracers ( it )% tr_max ) end if end do call ml_equation_of_state_unstr ( state ) ! Baroclinic pressure gradient: density-driven horizontal acceleration. ! Uses rho_layer from EOS, modifies hu/hv_layer per layer. if ( state % multilayer % use_bpg_jacobian ) then call ml_baroclinic_pressure_gradient_jacobian_unstr ( state , mesh , dt ) else call ml_baroclinic_pressure_gradient_unstr ( state , mesh , dt ) end if ! Per-layer bottom friction + CFL velocity truncation (after BPG, ! before Coriolis) — mirrors the structured stage order. call ml_apply_bottom_friction_unstr ( state , dt ) call ml_truncate_velocity_unstr ( state , mesh , dt , 0.8_wp ) ! Per-layer Coriolis after BPG, before recompute (matches stage 1). call ml_apply_coriolis_unstr ( state , dt ) call ml_compute_barotropic_momentum_unstr ( state ) end if state % time = state % time + dt state % step_count = state % step_count + 1 end subroutine solver_unstr_step","tags":"","url":"proc/solver_unstr_step.html"},{"title":"solver_unstr_update_forcing – Rakali","text":"public  subroutine solver_unstr_update_forcing(state) Refresh the device copy of the surface-forcing arrays after\nthe host has been updated by the C API setters. Mirror of solver_update_forcing on the structured side: uses !$acc update device(...) so the device mapping stays alive\nand the next step picks up the new values without an\nexit/enter round-trip. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state Called by proc~~solver_unstr_update_forcing~~CalledByGraph proc~solver_unstr_update_forcing solver_unstr_update_forcing proc~rki_unstr_set_evap_minus_precip rki_unstr_set_evap_minus_precip proc~rki_unstr_set_evap_minus_precip->proc~solver_unstr_update_forcing proc~rki_unstr_set_heat_flux rki_unstr_set_heat_flux proc~rki_unstr_set_heat_flux->proc~solver_unstr_update_forcing proc~rki_unstr_set_wind_field rki_unstr_set_wind_field proc~rki_unstr_set_wind_field->proc~solver_unstr_update_forcing Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine solver_unstr_update_forcing ( state ) !! Refresh the device copy of the surface-forcing arrays after !! the host has been updated by the C API setters. !! !! Mirror of `solver_update_forcing` on the structured side: uses !! `!$acc update device(...)` so the device mapping stays alive !! and the next step picks up the new values without an !! exit/enter round-trip. type ( unstr_state_t ), intent ( inout ) :: state !$acc update device(state%forcing%heat_flux, & !$acc&              state%forcing%evap_minus_precip, & !$acc&              state%forcing%wind_x, state%forcing%wind_y) end subroutine solver_unstr_update_forcing","tags":"","url":"proc/solver_unstr_update_forcing.html"},{"title":"solver_unstr_update_host – Rakali","text":"public  subroutine solver_unstr_update_host(state) Copy solution fields from GPU to host without tearing down the\ndevice mapping. Uses !$acc update self(...) so the device copy remains\nmapped and valid. This is the lightweight sync for output\ncallbacks and Python getters — avoids the full exit/enter\nround-trip. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state Called by proc~~solver_unstr_update_host~~CalledByGraph proc~solver_unstr_update_host solver_unstr_update_host proc~refresh_host refresh_host proc~refresh_host->proc~solver_unstr_update_host proc~rki_unstr_gauges_write rki_unstr_gauges_write proc~rki_unstr_gauges_write->proc~solver_unstr_update_host proc~rki_unstr_output_init rki_unstr_output_init proc~rki_unstr_output_init->proc~solver_unstr_update_host proc~rki_unstr_output_write rki_unstr_output_write proc~rki_unstr_output_write->proc~solver_unstr_update_host proc~rki_unstr_save_restart rki_unstr_save_restart proc~rki_unstr_save_restart->proc~solver_unstr_update_host proc~rki_unstr_get_h_layer_ptr rki_unstr_get_h_layer_ptr proc~rki_unstr_get_h_layer_ptr->proc~refresh_host proc~rki_unstr_get_height_ptr rki_unstr_get_height_ptr proc~rki_unstr_get_height_ptr->proc~refresh_host proc~rki_unstr_get_hs_layer_ptr rki_unstr_get_hS_layer_ptr proc~rki_unstr_get_hs_layer_ptr->proc~refresh_host proc~rki_unstr_get_ht_layer_ptr rki_unstr_get_hT_layer_ptr proc~rki_unstr_get_ht_layer_ptr->proc~refresh_host proc~rki_unstr_get_hu_layer_ptr rki_unstr_get_hu_layer_ptr proc~rki_unstr_get_hu_layer_ptr->proc~refresh_host proc~rki_unstr_get_hv_layer_ptr rki_unstr_get_hv_layer_ptr proc~rki_unstr_get_hv_layer_ptr->proc~refresh_host proc~rki_unstr_get_stage_ptr rki_unstr_get_stage_ptr proc~rki_unstr_get_stage_ptr->proc~refresh_host proc~rki_unstr_get_xmom_ptr rki_unstr_get_xmom_ptr proc~rki_unstr_get_xmom_ptr->proc~refresh_host proc~rki_unstr_get_ymom_ptr rki_unstr_get_ymom_ptr proc~rki_unstr_get_ymom_ptr->proc~refresh_host Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it Source Code subroutine solver_unstr_update_host ( state ) !! Copy solution fields from GPU to host without tearing down the !! device mapping. !! !! Uses `!$acc update self(...)` so the device copy remains !! mapped and valid. This is the lightweight sync for output !! callbacks and Python getters — avoids the full exit/enter !! round-trip. type ( unstr_state_t ), intent ( inout ) :: state integer :: it !$acc update self(state%barotropic%stage_cv, state%barotropic%xmom_cv, state%barotropic%ymom_cv, & !$acc&            state%barotropic%height_cv) if ( state % use_multilayer ) then !$acc update self(state%multilayer%h_layer, state%multilayer%hu_layer, state%multilayer%hv_layer) if ( allocated ( state % multilayer % tracers )) then do it = 1 , size ( state % multilayer % tracers ) !$acc update self(state%multilayer%tracers(it)%hTr) end do end if end if end subroutine solver_unstr_update_host","tags":"","url":"proc/solver_unstr_update_host.html"},{"title":"solver_unstr_step_generic – Rakali","text":"private  subroutine solver_unstr_step_generic(state, mesh, dt) Generic N-stage explicit SSP advance for the 2D barotropic\nunstructured path (euler/rk3/rk43).  Loops the same KNP\nforward-Euler stage primitive used by the fused RK2 fast path: E      = U&#94;(i-1) + beta(i)*dt * L(U&#94;(i-1))   (fused stage)\nU&#94;(i)  = alpha(i)*U&#94;n + (1 - alpha(i))*E      (convex blend) U&#94;n is backed up once; the blend is a per-stage ssp_combine_unstr.\nBoth keep the protect (wet/dry positivity) so the SSP guarantee\ncarries through. dt already carries any ssp_coeff scaling. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(inout) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~solver_unstr_step_generic~~CallsGraph proc~solver_unstr_step_generic solver_unstr_step_generic proc~compute_fluxes_central_unstr compute_fluxes_central_unstr proc~solver_unstr_step_generic->proc~compute_fluxes_central_unstr proc~extrapolate_second_order_edge_unstr extrapolate_second_order_edge_unstr proc~solver_unstr_step_generic->proc~extrapolate_second_order_edge_unstr proc~fused_save_state_unstr fused_save_state_unstr proc~solver_unstr_step_generic->proc~fused_save_state_unstr proc~fused_update_stage_generic_unstr fused_update_stage_generic_unstr proc~solver_unstr_step_generic->proc~fused_update_stage_generic_unstr proc~make_timestepper make_timestepper proc~solver_unstr_step_generic->proc~make_timestepper proc~ssp_combine_unstr ssp_combine_unstr proc~solver_unstr_step_generic->proc~ssp_combine_unstr proc~flux_one_cell flux_one_cell proc~compute_fluxes_central_unstr->proc~flux_one_cell proc~centroid_pass centroid_pass proc~extrapolate_second_order_edge_unstr->proc~centroid_pass proc~centroid_restore centroid_restore proc~extrapolate_second_order_edge_unstr->proc~centroid_restore proc~per_cell_extrapolation per_cell_extrapolation proc~extrapolate_second_order_edge_unstr->proc~per_cell_extrapolation local local proc~fused_update_stage_generic_unstr->local reduce reduce proc~fused_update_stage_generic_unstr->reduce proc~ssp_combine_unstr->local proc~ssp_combine_unstr->reduce proc~compute_boundary_state_impl compute_boundary_state_impl proc~flux_one_cell->proc~compute_boundary_state_impl proc~compute_chapman_eta_target compute_chapman_eta_target proc~flux_one_cell->proc~compute_chapman_eta_target proc~cu_flux_pointwise_impl cu_flux_pointwise_impl proc~flux_one_cell->proc~cu_flux_pointwise_impl proc~extrapolate_one_cell extrapolate_one_cell pro