 adjacent layers based on diagnostic w. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: w_face , u_up , v_up , flux_u , flux_v , h_val , h_col nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost ! Single-layer case: no vertical exchange needed if ( nz < 2 ) return ! Each thread processes its full column — no cross-column dependency do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , w_face , u_up , v_up , flux_u , flux_v , h_val , h_col ) ! Compute total column depth h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do ! Skip thin columns entirely — vertical exchange is meaningless ! when the water column is near-dry if ( h_col > ML_MIN_DEPTH ) then do k = 1 , nz - 1 w_face = w ( i , j , k + 1 ) ! Upwind velocity selection if ( w_face > 0.0_wp ) then h_val = h_layer ( i , j , k ) if ( h_val > DRY_TOLERANCE ) then u_up = hu_layer ( i , j , k ) / h_val v_up = hv_layer ( i , j , k ) / h_val else u_up = 0.0_wp v_up = 0.0_wp end if else h_val = h_layer ( i , j , k + 1 ) if ( h_val > DRY_TOLERANCE ) then u_up = hu_layer ( i , j , k + 1 ) / h_val v_up = hv_layer ( i , j , k + 1 ) / h_val else u_up = 0.0_wp v_up = 0.0_wp end if end if ! Flux = w * u_up * dt (mass flux * velocity) ! Limit: don't extract more than 50% of donor layer momentum flux_u = w_face * u_up * dt flux_v = w_face * v_up * dt if ( w_face > 0.0_wp ) then ! Donor is layer k if ( abs ( flux_u ) > 0.5_wp * abs ( hu_layer ( i , j , k ))) then flux_u = sign ( 0.5_wp * abs ( hu_layer ( i , j , k )), flux_u ) end if if ( abs ( flux_v ) > 0.5_wp * abs ( hv_layer ( i , j , k ))) then flux_v = sign ( 0.5_wp * abs ( hv_layer ( i , j , k )), flux_v ) end if else ! Donor is layer k+1 if ( abs ( flux_u ) > 0.5_wp * abs ( hu_layer ( i , j , k + 1 ))) then flux_u = sign ( 0.5_wp * abs ( hu_layer ( i , j , k + 1 )), flux_u ) end if if ( abs ( flux_v ) > 0.5_wp * abs ( hv_layer ( i , j , k + 1 ))) then flux_v = sign ( 0.5_wp * abs ( hv_layer ( i , j , k + 1 )), flux_v ) end if end if hu_layer ( i , j , k ) = hu_layer ( i , j , k ) - flux_u hu_layer ( i , j , k + 1 ) = hu_layer ( i , j , k + 1 ) + flux_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) - flux_v hv_layer ( i , j , k + 1 ) = hv_layer ( i , j , k + 1 ) + flux_v end do end if end do end subroutine ml_compute_vertical_exchange","tags":"","url":"proc/ml_compute_vertical_exchange.html"},{"title":"ml_compute_vertical_velocity – Rakali","text":"public pure subroutine ml_compute_vertical_velocity(h_layer, hu_layer, hv_layer, dsig, w, grid, nz) DIASURFACE (sigma-relative) vertical mass-transport velocity from\nper-layer continuity, integrated bottom-up. w_ml is the volume flux PER UNIT AREA across each moving sigma\ninterface — i.e. the sigma-relative (diasurface) velocity that the\nvertical exchange kernels advect momentum/tracers with, NOT the\nphysical Cartesian vertical velocity w_phys . In sigma coordinates the interfaces move with the free surface, ∂h_k/∂t = dsig_k·∂H/∂t . Layer continuity is\n  ∂h_k/∂t + ∂(hu_k)/∂x + ∂(hv_k)/∂y = w(k+1) − w(k),\nso the flux across the MOVING interface is\n  w(k+1) = w(k) − [div(hu_k) + dsig_k·∂H/∂t],\nwith the column mass balance ∂H/∂t = −Σ_m div(hu_m) = −div_col.\nSubstituting gives the implemented increment\n  w(k+1) = w(k) − div(hu_k) + dsig_k·div_col. Two consequences vs. the former w(k+1)=w(k)−div(hu_k) form (which\nomitted the moving-coordinate term and so reported w_phys ):\n  * Under pure barotropic sigma flow (hu_k = dsig_k·hu_bt) every\n    interface flux is 0 to round-off — no spurious diapycnal\n    transport (was ~1e-3, drove a salt leak in the exchange).\n  * The free surface w(:,:,nz+1) ≡ 0 by construction\n    (Σ_k dsig_k·div_col = div_col cancels div_col) — no diasurface\n    flux through the moving top, the correct kinematic BC.\nBaroclinic (sheared) flow still yields sensible nonzero interior w. Boundary condition: w(:,:,1) = 0 (no-penetration at the bed). NOTE: the dsig_k·∂H/∂t interface-motion model is exact for pure\nsigma layering (the coastal default VCOORD_SIGMA ); for hybrid\nz/z* coordinates the interface velocity is only approximated here. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_compute_vertical_velocity~~CallsGraph proc~ml_compute_vertical_velocity ml_compute_vertical_velocity local local proc~ml_compute_vertical_velocity->local proc~all_neighbours_wet~2 all_neighbours_wet proc~ml_compute_vertical_velocity->proc~all_neighbours_wet~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_compute_vertical_velocity~~CalledByGraph proc~ml_compute_vertical_velocity ml_compute_vertical_velocity proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_compute_vertical_velocity proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: div_col real(kind=wp), private :: div_hu real(kind=wp), private :: div_hv real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: h_col real(kind=wp), private :: h_col_im1 real(kind=wp), private :: h_col_ip1 real(kind=wp), private :: h_col_jm1 real(kind=wp), private :: h_col_jp1 integer, private :: i real(kind=wp), private :: inv_2dx real(kind=wp), private :: inv_2dy integer, private :: j integer, private :: k integer, private :: kk integer, private :: nghost integer, private :: nx integer, private :: ny Source Code pure subroutine ml_compute_vertical_velocity ( h_layer , hu_layer , hv_layer , & dsig , w , grid , nz ) !! DIASURFACE (sigma-relative) vertical mass-transport velocity from !! per-layer continuity, integrated bottom-up. !! !! `w_ml` is the volume flux PER UNIT AREA across each moving sigma !! interface — i.e. the sigma-relative (diasurface) velocity that the !! vertical exchange kernels advect momentum/tracers with, NOT the !! physical Cartesian vertical velocity `w_phys`. !! !! In sigma coordinates the interfaces move with the free surface, !! `∂h_k/∂t = dsig_k·∂H/∂t`. Layer continuity is !!   ∂h_k/∂t + ∂(hu_k)/∂x + ∂(hv_k)/∂y = w(k+1) − w(k), !! so the flux across the MOVING interface is !!   w(k+1) = w(k) − [div(hu_k) + dsig_k·∂H/∂t], !! with the column mass balance ∂H/∂t = −Σ_m div(hu_m) = −div_col. !! Substituting gives the implemented increment !!   w(k+1) = w(k) − div(hu_k) + dsig_k·div_col. !! !! Two consequences vs. the former `w(k+1)=w(k)−div(hu_k)` form (which !! omitted the moving-coordinate term and so reported `w_phys`): !!   * Under pure barotropic sigma flow (hu_k = dsig_k·hu_bt) every !!     interface flux is 0 to round-off — no spurious diapycnal !!     transport (was ~1e-3, drove a salt leak in the exchange). !!   * The free surface w(:,:,nz+1) ≡ 0 by construction !!     (Σ_k dsig_k·div_col = div_col cancels div_col) — no diasurface !!     flux through the moving top, the correct kinematic BC. !! Baroclinic (sheared) flow still yields sensible nonzero interior w. !! !! Boundary condition: w(:,:,1) = 0 (no-penetration at the bed). !! !! NOTE: the `dsig_k·∂H/∂t` interface-motion model is exact for pure !! sigma layering (the coastal default `VCOORD_SIGMA`); for hybrid !! z/z* coordinates the interface velocity is only approximated here. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: div_hu , div_hv , div_col , inv_2dx , inv_2dy , dx , dy real ( wp ) :: h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_2dx = 0.5_wp / dx inv_2dy = 0.5_wp / dy do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , div_hu , div_hv , div_col , & h_col , h_col_im1 , h_col_ip1 , h_col_jm1 , h_col_jp1 ) w ( i , j , 1 ) = 0.0_wp ! Compute total column depth for this cell and its neighbours h_col = 0.0_wp h_col_im1 = 0.0_wp h_col_ip1 = 0.0_wp h_col_jm1 = 0.0_wp h_col_jp1 = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) h_col_im1 = h_col_im1 + h_layer ( i - 1 , j , kk ) h_col_ip1 = h_col_ip1 + h_layer ( i + 1 , j , kk ) h_col_jm1 = h_col_jm1 + h_layer ( i , j - 1 , kk ) h_col_jp1 = h_col_jp1 + h_layer ( i , j + 1 , kk ) end do ! Skip dry columns and columns adjacent to dry cells where ! central differences would produce spurious divergence if ( all_neighbours_wet ( h_col , h_col_ip1 , h_col_im1 , & h_col_jp1 , h_col_jm1 )) then ! Column-integrated horizontal transport divergence ! div_col = Σ_m [div(hu_m) + div(hv_m)] = −∂H/∂t. div_col = 0.0_wp do kk = 1 , nz div_col = div_col & + ( hu_layer ( i + 1 , j , kk ) - hu_layer ( i - 1 , j , kk )) * inv_2dx & + ( hv_layer ( i , j + 1 , kk ) - hv_layer ( i , j - 1 , kk )) * inv_2dy end do do k = 1 , nz div_hu = ( hu_layer ( i + 1 , j , k ) - hu_layer ( i - 1 , j , k )) * inv_2dx div_hv = ( hv_layer ( i , j + 1 , k ) - hv_layer ( i , j - 1 , k )) * inv_2dy ! Diasurface increment: subtract the moving-interface term ! dsig_k·∂H/∂t = −dsig_k·div_col. w ( i , j , k + 1 ) = w ( i , j , k ) - ( div_hu + div_hv ) + dsig ( k ) * div_col end do else do k = 1 , nz w ( i , j , k + 1 ) = 0.0_wp end do end if end do end subroutine ml_compute_vertical_velocity","tags":"","url":"proc/ml_compute_vertical_velocity.html"},{"title":"ml_distribute_barotropic – Rakali","text":"public pure subroutine ml_distribute_barotropic(h, hu, hv, hu_pre, hv_pre, dsig, h_layer, hu_layer, hv_layer, grid, nz) Distribute barotropic HLL acceleration to layers, preserving\nper-layer velocity anomalies (shear). h_k = dsig_k H (sigma\nconstraint); hu_k = h_k (u_k_old + du), du = (HU_new-HU_pre)/H. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) Total depth AFTER barotropic update real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) Barotropic x-momentum AFTER update real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) Barotropic y-momentum AFTER update real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) Barotropic x-momentum BEFORE update real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) Barotropic y-momentum BEFORE update real(kind=wp), intent(in) :: dsig (nz) Sigma layer fractions real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) Layer thickness (old on entry, dsig_k*H on exit) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) Layer x-momentum (updated) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) Layer y-momentum (updated) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_distribute_barotropic~~CallsGraph proc~ml_distribute_barotropic ml_distribute_barotropic local local proc~ml_distribute_barotropic->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_distribute_barotropic~~CalledByGraph proc~ml_distribute_barotropic ml_distribute_barotropic proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_distribute_barotropic proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: h_k_old real(kind=wp), private :: h_val integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: u_k real(kind=wp), private :: v_k Source Code pure subroutine ml_distribute_barotropic ( h , hu , hv , hu_pre , hv_pre , & dsig , h_layer , hu_layer , hv_layer , & grid , nz ) !! Distribute barotropic HLL acceleration to layers, preserving !! per-layer velocity anomalies (shear). h_k = dsig_k*H (sigma !! constraint); hu_k = h_k*(u_k_old + du), du = (HU_new-HU_pre)/H. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) !! Total depth AFTER barotropic update real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) !! Barotropic x-momentum AFTER update real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) !! Barotropic y-momentum AFTER update real ( wp ), intent ( in ) :: hu_pre ( grid % nx_total , grid % ny_total ) !! Barotropic x-momentum BEFORE update real ( wp ), intent ( in ) :: hv_pre ( grid % nx_total , grid % ny_total ) !! Barotropic y-momentum BEFORE update real ( wp ), intent ( in ) :: dsig ( nz ) !! Sigma layer fractions real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer thickness (old on entry, dsig_k*H on exit) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer x-momentum (updated) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer y-momentum (updated) integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_val , du , dv , h_k_old , u_k , v_k nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_val , du , dv , h_k_old , u_k , v_k ) h_val = h ( i , j ) if ( h_val > DRY_TOLERANCE ) then du = ( hu ( i , j ) - hu_pre ( i , j )) / h_val dv = ( hv ( i , j ) - hv_pre ( i , j )) / h_val else du = 0.0_wp dv = 0.0_wp end if do k = 1 , nz h_k_old = h_layer ( i , j , k ) if ( h_k_old > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k_old v_k = hv_layer ( i , j , k ) / h_k_old else u_k = 0.0_wp v_k = 0.0_wp end if h_layer ( i , j , k ) = dsig ( k ) * h_val ! Thin-layer zeroing consistent with the barotropic update if ( h_layer ( i , j , k ) < THIN_LAYER_THRESHOLD ) then hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp else hu_layer ( i , j , k ) = h_layer ( i , j , k ) * ( u_k + du ) hv_layer ( i , j , k ) = h_layer ( i , j , k ) * ( v_k + dv ) end if end do end do end subroutine ml_distribute_barotropic","tags":"","url":"proc/ml_distribute_barotropic.html"},{"title":"ml_distribute_with_remap – Rakali","text":"public  subroutine ml_distribute_with_remap(h, hu, hv, hu_pre, hv_pre, coord_type, dsig, z_ref, depth_transition, blend_width, h_layer, hu_layer, hv_layer, grid, nz) Barotropic-to-layer distribution with vertical-coordinate\nreshaping — momentum + thickness only. Saves old thicknesses into remap_dz_old , sets new target h_layer via vcoord, distributes\nthe barotropic acceleration. Per-tracer remap is done separately by ml_remap_tracer (looped over the registry by the solver).\nAll array args must be device-resident under GPU offload; vcoord_t\nis NOT passed (raw arrays/scalars instead) to avoid\nallocatable-component resolution issues on the device. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) integer, intent(in) :: coord_type VCOORD_SIGMA, VCOORD_ZSIGMA, etc. real(kind=wp), intent(in) :: dsig (nz) Target sigma fractions (device-resident) real(kind=wp), intent(in) :: z_ref (0:nz) Reference z-level interfaces (device-resident) real(kind=wp), intent(in) :: depth_transition real(kind=wp), intent(in) :: blend_width real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_distribute_with_remap~~CallsGraph proc~ml_distribute_with_remap ml_distribute_with_remap proc~remap_workspace_ensure remap_workspace_ensure proc~ml_distribute_with_remap->proc~remap_workspace_ensure proc~vcoord_target_dz_column vcoord_target_dz_column proc~ml_distribute_with_remap->proc~vcoord_target_dz_column proc~remap_workspace_cleanup remap_workspace_cleanup proc~remap_workspace_ensure->proc~remap_workspace_cleanup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_distribute_with_remap~~CalledByGraph proc~ml_distribute_with_remap ml_distribute_with_remap proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_distribute_with_remap proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: dz_new (NZ_STACK_MAX) real(kind=wp), private :: h_k_old real(kind=wp), private :: h_val integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: u_k real(kind=wp), private :: v_k Source Code subroutine ml_distribute_with_remap ( h , hu , hv , hu_pre , hv_pre , & coord_type , & dsig , z_ref , & depth_transition , blend_width , & h_layer , hu_layer , hv_layer , & grid , nz ) !! Barotropic-to-layer distribution with vertical-coordinate !! reshaping — momentum + thickness only. Saves old thicknesses into !! `remap_dz_old`, sets new target `h_layer` via vcoord, distributes !! the barotropic acceleration. Per-tracer remap is done separately by !! `ml_remap_tracer` (looped over the registry by the solver). !! All array args must be device-resident under GPU offload; vcoord_t !! is NOT passed (raw arrays/scalars instead) to avoid !! allocatable-component resolution issues on the device. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu_pre ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv_pre ( grid % nx_total , grid % ny_total ) integer , intent ( in ) :: coord_type !! VCOORD_SIGMA, VCOORD_ZSIGMA, etc. real ( wp ), intent ( in ) :: dsig ( nz ) !! Target sigma fractions (device-resident) real ( wp ), intent ( in ) :: z_ref ( 0 : nz ) !! Reference z-level interfaces (device-resident) real ( wp ), intent ( in ) :: depth_transition real ( wp ), intent ( in ) :: blend_width real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_val , du , dv , h_k_old , u_k , v_k real ( wp ) :: dz_new ( NZ_STACK_MAX ) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost call remap_workspace_ensure ( nx , ny , nz ) ! Save old layer thicknesses for the per-tracer remap. do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) remap_dz_old ( i , j , k ) = h_layer ( i , j , k ) end do ! !$acc parallel loop (not do concurrent): the body calls ! vcoord_target_dz_column from another module (rki_vcoord), which ! NVHPC stdpar GPU offload does not lower from inside do concurrent. !$acc parallel loop collapse(2) & !$acc&   present(h, hu, hv, hu_pre, hv_pre, dsig, z_ref, & !$acc&           h_layer, hu_layer, hv_layer, remap_dz_old) & !$acc&   private(k, h_val, du, dv, h_k_old, u_k, v_k, dz_new) do j = nghost + 1 , ny - nghost do i = nghost + 1 , nx - nghost h_val = h ( i , j ) if ( h_val > DRY_TOLERANCE ) then du = ( hu ( i , j ) - hu_pre ( i , j )) / h_val dv = ( hv ( i , j ) - hv_pre ( i , j )) / h_val else du = 0.0_wp dv = 0.0_wp end if call vcoord_target_dz_column ( coord_type , nz , h_val , & dsig , z_ref , & depth_transition , blend_width , & dz_new ) do k = 1 , nz h_k_old = remap_dz_old ( i , j , k ) if ( h_k_old > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k_old v_k = hv_layer ( i , j , k ) / h_k_old else u_k = 0.0_wp v_k = 0.0_wp end if h_layer ( i , j , k ) = dz_new ( k ) if ( h_layer ( i , j , k ) < THIN_LAYER_THRESHOLD ) then hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp else hu_layer ( i , j , k ) = h_layer ( i , j , k ) * ( u_k + du ) hv_layer ( i , j , k ) = h_layer ( i , j , k ) * ( v_k + dv ) end if end do end do end do end subroutine ml_distribute_with_remap","tags":"","url":"proc/ml_distribute_with_remap.html"},{"title":"ml_distribute_with_remap_full – Rakali","text":"public  subroutine ml_distribute_with_remap_full(h, hu, hv, hu_pre, hv_pre, z_ref_col, h_min, h_layer, hu_layer, hv_layer, grid, nz) VCOORD_ZSTAR_FULL variant of ml_distribute_with_remap (momentum +\nthickness only): builds per-cell dz_new via vcoord_target_dz_column_zstar_full from the per-column reference\nprofile z_ref_col(0:nz,i,j) . Per-tracer remap by ml_remap_tracer .\nShares the remap_dz_old persistent workspace. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv_pre (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: z_ref_col (0:nz,grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h_min real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,n