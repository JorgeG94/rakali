r_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: EPS = 1.0e-20_wp real(kind=wp), private :: Ri real(kind=wp), private :: denom real(kind=wp), private :: drho real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: flux_u real(kind=wp), private :: flux_v real(kind=wp), private :: h_avg real(kind=wp), private :: h_col real(kind=wp), private :: h_k real(kind=wp), private :: h_k1 integer, private :: i integer, private :: j integer, private :: k integer, private :: kk integer, private :: nghost real(kind=wp), private :: nu_t integer, private :: nx integer, private :: ny real(kind=wp), private :: u_k real(kind=wp), private :: u_k1 real(kind=wp), private :: v_k real(kind=wp), private :: v_k1 Source Code pure subroutine ml_vertical_viscosity ( h_layer , hu_layer , hv_layer , rho_layer , & rho_0 , nu_max , nu_bg , ri_alpha , & grid , nz , dt ) !! Ri-dependent vertical viscosity for momentum (Pacanowski-Philander 1981). !! Computes gradient Richardson number at each interface and applies !! turbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 !! Reference density (kg/m&#94;3) real ( wp ), intent ( in ) :: nu_max !! Maximum turbulent viscosity (m&#94;2/s) real ( wp ), intent ( in ) :: nu_bg !! Background viscosity (m&#94;2/s) real ( wp ), intent ( in ) :: ri_alpha !! Richardson number scaling coefficient real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_avg , h_k , h_k1 , u_k , v_k , u_k1 , v_k1 , h_col real ( wp ) :: du , dv , drho , Ri , denom , nu_t , flux_u , flux_v real ( wp ), parameter :: EPS = 1.0e-20_wp nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , du , dv , drho , & Ri , denom , nu_t , flux_u , flux_v , h_col ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) ! VCOORD_ZSTAR_FULL: vanishing layers (h ≈ h_min) on either ! side of the interface produce a tiny h_avg, which makes ! the diffusive flux nu_t*du/h_avg blow up.  Treat as ! no-flux instead.  VANISHING_LAYER_TOL ≥ DRY_TOLERANCE, ! so this is strictly more conservative than the legacy guard. if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( i , j , k + 1 ) / h_k1 v_k1 = hv_layer ( i , j , k + 1 ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( i , j , k ) - rho_layer ( i , j , k + 1 ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + ri_alpha * Ri nu_t = nu_max / ( denom * denom ) + nu_bg ! Limit diffusive flux: stability requires nu_t*dt/h_avg&#94;2 < 0.5 if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) then nu_t = 0.5_wp * h_avg * h_avg / dt end if flux_u = nu_t * du / h_avg * dt flux_v = nu_t * dv / h_avg * dt ! Conservative + dimensionally correct: same momentum flux ! both sides of the interface (previous h_k / h_k1 multipliers ! were dimensionally wrong and non-conservative under ! non-uniform layer thicknesses, e.g. VCOORD_ZSTAR_FULL). hu_layer ( i , j , k ) = hu_layer ( i , j , k ) + flux_u hu_layer ( i , j , k + 1 ) = hu_layer ( i , j , k + 1 ) - flux_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) + flux_v hv_layer ( i , j , k + 1 ) = hv_layer ( i , j , k + 1 ) - flux_v end if end do end if end do end subroutine ml_vertical_viscosity","tags":"","url":"proc/ml_vertical_viscosity.html"},{"title":"ml_apply_bottom_friction_unstr – Rakali","text":"public pure subroutine ml_apply_bottom_friction_unstr(state, dt) Apply semi-implicit Manning bottom friction to the lowest active\nlayer (bottom-up k=1 bed) using that layer’s velocity:\n  hu_new = hu / (1 + dt C_d |u_b|/h_k),  C_d = g*n&#94;2/H&#94;{1/3},\nwhere H is the total column depth. No-op when manning_n <= 0.\nMirrors structured ml_apply_bottom_friction (Manning path); the\nunstructured barotropic state carries no linear-drag rate. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt Calls proc~~ml_apply_bottom_friction_unstr~~CallsGraph proc~ml_apply_bottom_friction_unstr ml_apply_bottom_friction_unstr local local proc~ml_apply_bottom_friction_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_apply_bottom_friction_unstr~~CalledByGraph proc~ml_apply_bottom_friction_unstr ml_apply_bottom_friction_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_apply_bottom_friction_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: cell real(kind=wp), private :: cf real(kind=wp), private :: denom real(kind=wp), private :: h_k real(kind=wp), private :: h_total integer, private :: k integer, private :: k_bot integer, private :: kk real(kind=wp), private :: manning_n integer, private :: n real(kind=wp), private :: n_sq integer, private :: nz real(kind=wp), private :: speed_b real(kind=wp), private :: u_b real(kind=wp), private :: v_b Source Code pure subroutine ml_apply_bottom_friction_unstr ( state , dt ) !! Apply semi-implicit Manning bottom friction to the lowest active !! layer (bottom-up `k=1` bed) using that layer's velocity: !!   hu_new = hu / (1 + dt*C_d*|u_b|/h_k),  C_d = g*n&#94;2/H&#94;{1/3}, !! where H is the total column depth. No-op when manning_n <= 0. !! Mirrors structured `ml_apply_bottom_friction` (Manning path); the !! unstructured barotropic state carries no linear-drag rate. type ( unstr_state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: dt integer :: cell , k , kk , k_bot , nz , n real ( wp ) :: manning_n , n_sq , h_k , h_total , u_b , v_b , speed_b , cf , denom if (. not . state % use_multilayer ) return manning_n = state % barotropic % manning_n if ( manning_n <= 0.0_wp ) return if ( dt <= 0.0_wp ) return nz = state % multilayer % nz_ml n = state % ncells_owned n_sq = manning_n * manning_n do concurrent ( cell = 1 : n ) & local ( k , kk , k_bot , h_k , h_total , u_b , v_b , speed_b , cf , denom ) ! Lowest active layer: k=1 for SIGMA/ZSIGMA/ZSTAR-lite; the first ! non-vanishing layer for ZSTAR_FULL (bed layer may be parked at ! h_min in shallow columns). k_bot = 1 do kk = 1 , nz if ( state % multilayer % h_layer ( kk , cell ) > VANISHING_LAYER_TOL_UNSTR ) then k_bot = kk exit end if end do h_k = state % multilayer % h_layer ( k_bot , cell ) if ( h_k >= THIN_LAYER_THRESHOLD ) then h_total = 0.0_wp do kk = 1 , nz h_total = h_total + state % multilayer % h_layer ( kk , cell ) end do if ( h_total >= THIN_LAYER_THRESHOLD ) then u_b = state % multilayer % hu_layer ( k_bot , cell ) / h_k v_b = state % multilayer % hv_layer ( k_bot , cell ) / h_k speed_b = sqrt ( u_b * u_b + v_b * v_b ) cf = GRAVITY * n_sq / ( h_total ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed_b / h_k state % multilayer % hu_layer ( k_bot , cell ) = & state % multilayer % hu_layer ( k_bot , cell ) / denom state % multilayer % hv_layer ( k_bot , cell ) = & state % multilayer % hv_layer ( k_bot , cell ) / denom end if end if end do end subroutine ml_apply_bottom_friction_unstr","tags":"","url":"proc/ml_apply_bottom_friction_unstr.html"},{"title":"ml_apply_coriolis_unstr – Rakali","text":"public pure subroutine ml_apply_coriolis_unstr(state, dt) Rotate every wet layer’s (hu_k, hv_k) through angle f*dt with\nthe closed-form rotation matrix (energy-conserving, det = 1).\nSkips layers thinner than THIN_LAYER_THRESHOLD (already zeroed by\nthe distribute / friction kernels). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt Calls proc~~ml_apply_coriolis_unstr~~CallsGraph proc~ml_apply_coriolis_unstr ml_apply_coriolis_unstr local local proc~ml_apply_coriolis_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_apply_coriolis_unstr~~CalledByGraph proc~ml_apply_coriolis_unstr ml_apply_coriolis_unstr proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~ml_apply_coriolis_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_apply_coriolis_unstr proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: cell real(kind=wp), private :: cosf real(kind=wp), private :: f real(kind=wp), private :: hu_old real(kind=wp), private :: hv_old integer, private :: k integer, private :: n integer, private :: nz real(kind=wp), private :: sinf Source Code pure subroutine ml_apply_coriolis_unstr ( state , dt ) !! Rotate every wet layer's `(hu_k, hv_k)` through angle `f*dt` with !! the closed-form rotation matrix (energy-conserving, det = 1). !! Skips layers thinner than THIN_LAYER_THRESHOLD (already zeroed by !! the distribute / friction kernels). type ( unstr_state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: dt integer :: cell , k , nz , n real ( wp ) :: f , cosf , sinf , hu_old , hv_old if (. not . state % use_multilayer ) return f = state % barotropic % coriolis_f if ( f == 0.0_wp ) return nz = state % multilayer % nz_ml n = state % ncells_owned cosf = cos ( f * dt ) sinf = sin ( f * dt ) do concurrent ( cell = 1 : n ) local ( k , hu_old , hv_old ) do k = 1 , nz if ( state % multilayer % h_layer ( k , cell ) > THIN_LAYER_THRESHOLD ) then hu_old = state % multilayer % hu_layer ( k , cell ) hv_old = state % multilayer % hv_layer ( k , cell ) state % multilayer % hu_layer ( k , cell ) = hu_old * cosf + hv_old * sinf state % multilayer % hv_layer ( k , cell ) = - hu_old * sinf + hv_old * cosf end if end do end do end subroutine ml_apply_coriolis_unstr","tags":"","url":"proc/ml_apply_coriolis_unstr.html"},{"title":"fused_update_stage1 – Rakali","text":"public pure subroutine fused_update_stage1(h, hu, hv, h0, hu0, hv0, flux_h, flux_hu, flux_hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, coriolis_f, forcing_active) Stage 1: save + Euler update + clamp + friction + coriolis Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv0 (grid%nx_total,grid%ny_tot