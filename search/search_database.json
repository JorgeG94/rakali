 :: inv_2dy integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: tx real(kind=wp), private :: ty Source Code pure subroutine compute_nh_baro_tendency ( h , q_nh , dsig , tend_x , tend_y , & grid , nz ) !! Compute depth-averaged NH pressure gradient for barotropic forcing !! !! tend_x(i,j) = -sum_k(dsig_k * dq_nh_k/dx) !! tend_y(i,j) = -sum_k(dsig_k * dq_nh_k/dy) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: tend_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: tend_y ( grid % nx_total , grid % ny_total ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: tx , ty , dqdx , dqdy , inv_2dx , inv_2dy nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_2dx = 1.0_wp / ( 2.0_wp * dx ) inv_2dy = 1.0_wp / ( 2.0_wp * dy ) do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( tx , ty , dqdx , dqdy , k ) tx = 0.0_wp ty = 0.0_wp if ( h ( i , j ) > NH_MIN_DEPTH ) then do k = 1 , nz dqdx = ( q_nh ( i + 1 , j , k ) - q_nh ( i - 1 , j , k )) * inv_2dx dqdy = ( q_nh ( i , j + 1 , k ) - q_nh ( i , j - 1 , k )) * inv_2dy tx = tx - dsig ( k ) * dqdx ty = ty - dsig ( k ) * dqdy end do end if tend_x ( i , j ) = tx tend_y ( i , j ) = ty end do end subroutine compute_nh_baro_tendency","tags":"","url":"proc/compute_nh_baro_tendency.html"},{"title":"compute_nh_rhs – Rakali","text":"public pure subroutine compute_nh_rhs(h, w, dsig, rhs, nx, ny, nz, nghost, dx, dy, dt) Public only for the unit-test suite (no production module imports it).\nCompute RHS of NH Poisson equation from velocity divergence rhs_k = -(w_{k+1} - w_k) / (dsig_k * h * 