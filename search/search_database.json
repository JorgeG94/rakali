rcefile~rki_si_unstr_mg.f90 rki_si_unstr_mg.F90 sourcefile~rki_si_unstr_state.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_surface_forcing_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_surface_forcing_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_timestepper.f90->sourcefile~rki_constants.f90 sourcefile~rki_eos.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_eos.f90->sourcefile~rki_grid.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_vcoord.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_kernel_protect_unstr.f90~~AfferentGraph sourcefile~rki_kernel_protect_unstr.f90 rki_kernel_protect_unstr.F90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_kernel_protect_unstr.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Protect against negative depths in the unstructured solver module rki_kernel_protect_unstr !! Negative-depth guard after each flux + update step. Cells with !! depth `h = stage - bed` below `DRY_TOLERANCE` have their centroid !! momenta zeroed; thin-but-wet cells (`h < eps = DESING_EPS`, !! the Kurganov & Petrova 2007 desingularization length shared with the !! structured kernels) get the desingularized velocity !! `u = sqrt(2) h uh / sqrt(h&#94;4 + eps&#94;4)` and `uh := h*u`, which !! bounds thin-cell velocity smoothly instead of freezing thin water !! (the old hard zero below `minimum_allowed_height` pinned wet/dry !! fronts); a `FROUDE_BACKSTOP` rescale arrests thin-film velocity !! runaway (see the constant's docstring for the measurements). !! Strictly-negative cells clip stage back to bed (h=0) and !! accumulate the removed mass `(-h)*area` into `state%mass_error`. !! Uses `!$acc parallel loop reduction(+:..)` (array write + scalar !! reduction don't fit `do concurrent`). use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE , DESING_EPS , & FROUDE_BACKSTOP use rki_mesh_unstr , only : mesh_unstr_t use rki_state_unstr , only : unstr_state_t implicit none private public :: protect_unstr contains subroutine protect_unstr ( state , mesh ) !! Apply the negative-depth and shallow-cell guards. Adds the !! clipped negative mass to `state%mass_error` (does not reset). type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: k real ( wp ) :: h real ( wp ) :: eps4 , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale real ( wp ) :: mass_error_local mass_error_local = 0.0_wp eps4 = DESING_EPS ** 4 do concurrent ( k = 1 : mesh % ncells_owned ) & local ( h , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale ) & reduce ( + : mass_error_local ) h = state % barotropic % stage_cv ( k ) - state % barotropic % bed_cv ( k ) if ( h < DRY_TOLERANCE ) then ! Dry (or negative) -- no meaningful velocity; zero momentum. state % barotropic % xmom_cv ( k ) = 0.0_wp state % barotropic % ymom_cv ( k ) = 0.0_wp else h4 = h ** 4 if ( h4 < eps4 ) then ! u = sqrt(2) h uh / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)); uh := h*u. ! Identity for h >= eps, so applied only below eps. u_ds = sqrt ( 2.0_wp ) * h * state % barotropic % xmom_cv ( k ) / sqrt ( h4 + eps4 ) v_ds = sqrt ( 2.0_wp ) * h * state % barotropic % ymom_cv ( k ) / sqrt ( h4 + eps4 ) state % barotropic % xmom_cv ( k ) = h * u_ds state % barotropic % ymom_cv ( k ) = h * v_ds end if ! Froude backstop: blowup arrester only (triggers on a TRUE ! comparison, so NaN passes through and fails loudly). speed_sq = ( state % barotropic % xmom_cv ( k ) ** 2 & + state % barotropic % ymom_cv ( k ) ** 2 ) / h ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) state % barotropic % xmom_cv ( k ) = state % barotropic % xmom_cv ( k ) * fr_scale state % barotropic % ymom_cv ( k ) = state % barotropic % ymom_cv ( k ) * fr_scale end if end if if ( h < 0.0_wp ) then ! Strictly negative -- clip stage to bed and remember the ! unphysical mass we just removed. mass_error_local = mass_error_local + ( - h ) * mesh % area ( k ) state % barotropic % stage_cv ( k ) = state % barotropic % bed_cv ( k ) end if end do ! Accumulate into the running mass-error tally on the state. state % mass_error = state % mass_error + mass_error_local end subroutine protect_unstr end module rki_kernel_protect_unstr","tags":"","url":"sourcefile/rki_kernel_protect_unstr.f90.html"},{"title":"rki_ml_horizontal_viscosity.F90 – Rakali","text":"Horizontal viscosity for layer momentum. This file depends on sourcefile~~rki_ml_horizontal_viscosity.f90~~EfferentGraph sourcefile~rki_ml_horizontal_viscosity.f90 rki_ml_horizontal_viscosity.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_horizontal_viscosity.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_ml_horizontal_viscosity.f90->sourcefile~rki_grid.f90 sourcefile~rki_ml_common.f90 rki_ml_common.F90 sourcefile~rki_ml_horizontal_viscosity.f90->sourcefile~rki_ml_common.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_ml_horizontal_viscosity.f90~~AfferentGraph sourcefile~rki_ml_horizontal_viscosity.f90 rki_ml_horizontal_viscosity.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_ml_horizontal_viscosity.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Horizontal viscosity for layer momentum. module rki_ml_horizontal_viscosity !! Smagorinsky (1963) eddy-viscosity + biharmonic closures on the !! structured multilayer grid.  Owns persistent per-step !! momentum-snapshot workspaces, torn down via !! `ml_horizontal_viscosity_cleanup` at simulation end. use rki_constants , only : wp , THIN_LAYER_THRESHOLD use rki_grid , only : hgrid_t use rki_ml_common , only : ML_MIN_DEPTH implicit none private public :: ml_horizontal_viscosity_smag public :: ml_horizontal_viscosity_biharmonic public :: ml_horizontal_viscosity_cleanup ! Persistent per-kernel workspaces: lazy-allocated, sized (nx,ny,nz), ! reused every call to avoid per-call allocate/deallocate GPU stalls. real ( wp ), allocatable :: horvisc_hu_pre (:, :, :) real ( wp ), allocatable :: horvisc_hv_pre (:, :, :) ! Intermediate velocity Laplacian for the biharmonic first del&#94;2 pass. real ( wp ), allocatable :: bih_lap_u (:, :, :) real ( wp ), allocatable :: bih_lap_v (:, :, :) contains subroutine horvisc_workspace_ensure ( nx , ny , nz ) !! Lazy-allocate the Smagorinsky momentum-snapshot scratch. integer , intent ( in ) :: nx , ny , nz logical :: need_alloc need_alloc = . false . if (. not . allocated ( horvisc_hu_pre )) then need_alloc = . true . else if ( size ( horvisc_hu_pre , 1 ) /= nx . or . & size ( horvisc_hu_pre , 2 ) /= ny . or . & size ( horvisc_hu_pre , 3 ) /= nz ) then call ml_horizontal_viscosity_cleanup () need_alloc = . true . end if if ( need_alloc ) then allocate ( horvisc_hu_pre ( nx , ny , nz ), horvisc_hv_pre ( nx , ny , nz )) !$acc enter data create(horvisc_hu_pre, horvisc_hv_pre) end if end subroutine horvisc_workspace_ensure subroutine bih_workspace_ensure ( nx , ny , nz ) !! Lazy-allocate the biharmonic intermediate-Laplacian scratch. integer , intent ( in ) :: nx , ny , nz logical :: need_alloc need_alloc = . false . if (. not . allocated ( bih_lap_u )) then need_alloc = . true . else if ( size ( bih_lap_u , 1 ) /= nx . or . & size ( bih_lap_u , 2 ) /= ny . or . & size ( bih_lap_u , 3 ) /= nz ) then !$acc exit data delete(bih_lap_u, bih_lap_v) deallocate ( bih_lap_u , bih_lap_v ) need_alloc = . true . end if if ( need_alloc ) then allocate ( bih_lap_u ( nx , ny , nz ), bih_lap_v ( nx , ny , nz )) !$acc enter data create(bih_lap_u, bih_lap_v) end if end subroutine bih_workspace_ensure subroutine ml_horizontal_viscosity_cleanup () !! Release the lateral-viscosity persistent workspaces.  Called by the !! solver at simulation end. if ( allocated ( horvisc_hu_pre )) then !$acc exit data delete(horvisc_hu_pre, horvisc_hv_pre) deallocate ( horvisc_hu_pre , horvisc_hv_pre ) end if if ( allocated ( bih_lap_u )) then !$acc exit data delete(bih_lap_u, bih_lap_v) deallocate ( bih_lap_u , bih_lap_v ) end if end subroutine ml_horizontal_viscosity_cleanup subroutine ml_horizontal_viscosity_smag ( h_layer , hu_layer , hv_layer , & cs , grid , nz , dt ) !! Smagorinsky (1963) horizontal viscosity for layer momentum: !! nu_h = (Cs*delta)&#94;2*|S| Laplacian diffusion, delta=sqrt(dx*dy). !! !! Read-write hazard: the update reads neighbour velocities while !! writing the own cell.  `do concurrent` is Jacobi on GPU but !! sequential (Gauss-Seidel) on CPU, so we snapshot hu/hv_layer into !! frozen scratch and read neighbours from it for bit-identical !! results across backends. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: cs , dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: delta2 , inv_dx , inv_dy , inv_2dx , inv_2dy , nu_max , h_col real ( wp ) :: h_k , u_c , v_c real ( wp ) :: u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm real ( wp ) :: dudx , dvdy , dudy , dvdx real ( wp ) :: strain , nu_h , lap_u , lap_v nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy if ( cs <= 0.0_wp ) return delta2 = cs * cs * dx * dy inv_dx = 1.0_wp / dx inv_dy = 1.0_wp / dy inv_2dx = 0.5_wp * inv_dx inv_2dy = 0.5_wp * inv_dy ! Stability: nu_h * dt * (1/dx&#94;2 + 1/dy&#94;2) <= 0.5 nu_max = 0.5_wp / ( dt * ( inv_dx * inv_dx + inv_dy * inv_dy ) + 1.0e-30_wp ) call horvisc_workspace_ensure ( nx , ny , nz ) associate ( hu_pre => horvisc_hu_pre , hv_pre => horvisc_hv_pre ) ! Snapshot the input momentum so neighbour reads come from the ! pre-update image on every backend. do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) hu_pre ( i , j , k ) = hu_layer ( i , j , k ) hv_pre ( i , j , k ) = hv_layer ( i , j , k ) end do do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , & v_ip , v_im , v_jp , v_jm , dudx , dvdy , dudy , dvdx , & strain , nu_h , lap_u , lap_v , h_col ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col < ML_MIN_DEPTH ) cycle do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle ! Centre velocity u_c = hu_pre ( i , j , k ) / h_k v_c = hv_pre ( i , j , k ) / h_k ! Neighbour velocities (zero-gradient at dry cells) if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_ip = hu_pre ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) v_ip = hv_pre ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) else u_ip = u_c v_ip = v_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_im = hu_pre ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) v_im = hv_pre ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) else u_im = u_c v_im = v_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jp = hu_pre ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) v_jp = hv_pre ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) else u_jp = u_c v_jp = v_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jm = hu_pre ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) v_jm = hv_pre ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) else u_jm = u_c v_jm = v_c end if ! Strain rate components (central differences) dudx = ( u_ip - u_im ) * inv_2dx dvdy = ( v_jp - v_jm ) * inv_2dy dudy = ( u_jp - u_jm ) * inv_2dy dvdx = ( v_ip - v_im ) * inv_2dx ! |S| = sqrt( (du/dx - dv/dy)&#94;2 + (du/dy + dv/dx)&#94;2 ) strain = sqrt (( dudx - dvdy ) ** 2 + ( dudy + dvdx ) ** 2 ) ! Smagorinsky viscosity with stability limiter nu_h = min ( delta2 * strain , nu_max ) ! Laplacian of velocity lap_u = ( u_ip - 2.0_wp * u_c + u_im ) * inv_dx * inv_dx & + ( u_jp - 2.0_wp * u_c + u_jm ) * inv_dy * inv_dy lap_v = ( v_ip - 2.0_wp * v_c + v_im ) * inv_dx * inv_dx & + ( v_jp - 2.0_wp * v_c + v_jm ) * inv_dy * inv_dy ! Update momentum -- read from the frozen pre-image, write ! to the live array so later iterations see the old state. hu_layer ( i , j , k ) = hu_pre ( i , j , k ) + dt * h_k * nu_h * lap_u hv_layer ( i , j , k ) = hv_pre ( i , j , k ) + dt * h_k * nu_h * lap_v end do end do end associate end subroutine ml_horizontal_viscosity_smag subroutine ml_horizontal_viscosity_biharmonic ( h_layer , hu_layer , hv_layer , & nu_4 , grid , nz , dt ) !! Biharmonic (del&#94;4) lateral viscosity on layer momentum: !! d(hu)/dt = -nu_4*h*del&#94;2(del&#94;2 u) in two Laplacian passes (pass 1 !! over interior + one ghost ring; pass 2 over the interior). !! Scale-selective vs the harmonic Smagorinsky operator.  `nu_4` !! capped at the explicit stability limit !! nu_4*dt*((pi/dx)&#94;2+(pi/dy)&#94;2)&#94;2 <= 2.  Assumes nghost >= 2. real ( wp ), parameter :: PI = 3.14159265358979323846_wp type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: nu_4 , dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: inv_dx2 , inv_dy2 , nu4_max , nu4_eff real ( wp ) :: h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm real ( wp ) :: lu_c , lu_ip , lu_im , lu_jp , lu_jm real ( wp ) :: lv_c , lv_ip , lv_im , lv_jp , lv_jm real ( wp ) :: lap2_u , lap2_v if ( nu_4 <= 0.0_wp ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost inv_dx2 = 1.0_wp / ( grid % dx * grid % dx ) inv_dy2 = 1.0_wp / ( grid % dy * grid % dy ) ! Explicit forward-step stability cap on nu_4. nu4_max = 2.0_wp / ( dt * ( PI * PI * inv_dx2 + PI * PI * inv_dy2 ) ** 2 + 1.0e-30_wp ) nu4_eff = min ( nu_4 , nu4_max ) call bih_workspace_ensure ( nx , ny , nz ) ! ---- Pass 1: L = del&#94;2(u), over interior + one ghost ring ---- do concurrent ( j = nghost : ny - nghost + 1 , i = nghost : nx - nghost + 1 ) & local ( k , h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm ) do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) then bih_lap_u ( i , j , k ) = 0.0_wp bih_lap_v ( i , j , k ) = 0.0_wp cycle end if u_c = hu_layer ( i , j , k ) / h_k v_c = hv_layer ( i , j , k ) / h_k if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_ip = hu_layer ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) v_ip = hv_layer ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) else u_ip = u_c v_ip = v_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_im = hu_layer ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) v_im = hv_layer ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) else u_im = u_c v_im = v_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jp = hu_layer ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) v_jp = hv_layer ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) else u_jp = u_c v_jp = v_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jm = hu_layer ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) v_jm = hv_layer ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) else u_jm = u_c v_jm = v_c end if bih_lap_u ( i , j , k ) = ( u_ip - 2.0_wp * u_c + u_im ) * inv_dx2 & + ( u_jp - 2.0_wp * u_c + u_jm ) * inv_dy2 bih_lap_v ( i , j , k ) = ( v_ip - 2.0_wp * v_c + v_im ) * inv_dx2 & + ( v_jp - 2.0_wp * v_c + v_jm ) * inv_dy2 end do end do ! ---- Pass 2: hu -= dt*h*nu_4*del&#94;2(L), over the interior ---- do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_k , lu_c , lu_ip , lu_im , lu_jp , lu_jm , & lv_c , lv_ip , lv_im , lv_jp , lv_jm , lap2_u , lap2_v ) do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle lu_c = bih_lap_u ( i , j , k ) lv_c = bih_lap_v ( i , j , k ) if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then lu_ip = bih_lap_u ( i + 1 , j , k ) lv_ip = bih_lap_v ( i + 1 , j , k ) else lu_ip = lu_c lv_ip = lv_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then lu_im = bih_lap_u ( i - 1 , j , k ) lv_im = bih_lap_v ( i - 1 , j , k ) else lu_im = lu_c lv_im = lv_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then lu_jp = bih_lap_u ( i , j + 1 , k ) lv_jp = bih_lap_v ( i , j + 1 , k ) else lu_jp = lu_c lv_jp = lv_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then lu_jm = bih_lap_u ( i , j - 1 , k ) lv_jm = bih_lap_v ( i , j - 1 , k ) else lu_jm = lu_c lv_jm = lv_c end if lap2_u = ( lu_ip - 2.0_wp * lu_c + lu_im ) * inv_dx2 & + ( lu_jp - 2.0_wp * lu_c + lu_jm ) * inv_dy2 lap2_v = ( lv_ip - 2.0_wp * lv_c + lv_im ) * inv_dx2 & + ( lv_jp - 2.0_wp * lv_c + lv_jm ) * inv_dy2 hu_layer ( i , j , k ) = hu_layer ( i , j , k ) - dt * h_k * nu4_eff * lap2_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) - dt * h_k * nu4_eff * lap2_v end do end do end subroutine ml_horizontal_viscosity_biharmonic end module rki_ml_horizontal_viscosity","tags":"","url":"sourcefile/rki_ml_horizontal_viscosity.f90.html"},{"title":"rki_timestepper.F90 – Rakali","text":"Explicit SSP Runge-Kutta time-integrator selection for the coastal solver. This file depends on sourcefile~~rki_timestepper.f90~~EfferentGraph sourcefile~rki_timestepper.f90 rki_timestepper.F