ht ( 2 ) = q_left ( 2 ) q_right ( 3 ) = q_left ( 3 ) end if case ( BC_INFLOW ) q_right ( 1 ) = q_left ( 1 ) q_right ( 2 ) = hle * un_ext * n1 q_right ( 3 ) = hle * un_ext * n2 zr = zl hre = hle case ( BC_DISCHARGE ) q_right ( 1 ) = q_left ( 1 ) q_right ( 2 ) = Qn_ext * n1 q_right ( 3 ) = Qn_ext * n2 zr = zl hre = hle case ( BC_OUTFLOW ) zr = zl hre = h_ext q_right ( 1 ) = zr + h_ext q_right ( 2 ) = q_left ( 2 ) q_right ( 3 ) = q_left ( 3 ) case default ! BC_WALL (and any unknown type as a safe fallback). q_right ( 1 ) = q_left ( 1 ) normal_mom = q_left ( 2 ) * n1 + q_left ( 3 ) * n2 q_right ( 2 ) = q_left ( 2 ) - 2.0_wp * normal_mom * n1 q_right ( 3 ) = q_left ( 3 ) - 2.0_wp * normal_mom * n2 zr = zl hre = hle end select end subroutine compute_boundary_state_impl","tags":"","url":"proc/compute_boundary_state_impl.html"},{"title":"compute_chapman_eta_target – Rakali","text":"private pure subroutine compute_chapman_eta_target(state, mesh, k, i, hle, eta_target) Orlanski-style radiating ghost stage at boundary edge i of\ncell k . Advects the persistent chapman_eta_old(i, k) toward\nthe interior centroid stage along the phase speed, writes back\nthe new eta_old , and returns eta_target as the BC_TIDAL\nghost eta. Per-edge writes to chapman_eta_old(i, k) are\nrace-free: each (i, k) is touched only by cell k . Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: k integer, intent(in) :: i real(kind=wp), intent(in) :: hle real(kind=wp), intent(out) :: eta_target Called by proc~~compute_chapman_eta_target~~CalledByGraph proc~compute_chapman_eta_target compute_chapman_eta_target proc~flux_one_cell flux_one_cell proc~flux_one_cell->proc~compute_chapman_eta_target proc~compute_fluxes_central_unstr compute_fluxes_central_unstr proc~compute_fluxes_central_unstr->proc~flux_one_cell proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~compute_fluxes_cen