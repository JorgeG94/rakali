(:,:) real(kind=wp), intent(out) :: hu (:,:) real(kind=wp), intent(out) :: hv (:,:) private  subroutine read_parent_grid (nest, ncid) Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest integer, intent(in) :: ncid","tags":"","url":"module/rki_nesting.html"},{"title":"rki_ml_kpp – Rakali","text":"KPP surface-boundary-layer mixing for the coastal A-grid. Unlike the\nocean path (implicit Thomas solve), the coastal path has no implicit\nvertical-diffusion solver, so the KPP overlay is fused with the explicit\nCFL-clamped diffusive-flux apply:\n  * ml_kpp_boundary_layer — per column u_*, surface buoyancy flux B_0,\n    and bulk-Ri boundary-layer depth h_b (LMD94 eq-23 V_t&#94;2 term); bl_depth persists across steps to seed V_t&#94;2 (self-bootstrapping).\n  * ml_kpp_viscosity — momentum: nu_t = max(PP81 interior, KPP overlay\n    h_b·w_s·G(sigma)), explicit flux to hu/hv.\n  * ml_kpp_diffusion_tracers — S+T: same overlay + non-local\n    counter-gradient transport under destabilizing forcing. Overlay inactive (w_s=0) ⇒ falls through to bit-identical PP81. vmix_use_kpp off (default) leaves all results unchanged. Bottom-up layers (k=1 bed,\nk=nz surface); interface “k” sits between layer k and k+1. Uses rki_grid rki_constants rki_ml_common module~~rki_ml_kpp~~UsesGraph module~rki_ml_kpp rki_ml_kpp module~rki_constants rki_constants module~rki_ml_kpp->module~rki_constants module~rki_grid rki_grid module~rki_ml_kpp->module~rki_grid module~rki_ml_common rki_ml_common module~rki_ml_kpp->module~rki_ml_common pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants module~rki_ml_common->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_ml_kpp~~UsedByGraph module~rki_ml_kpp rki_ml_kpp module~rki_solver rki_solver module~rki_solver->module~rki_ml_kpp module~rki_api rki_api module~rki_api->module~rki_solver module~rki_driver rki_driver module~rki_driver->module~rki_solver Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: EPS = 1.0e-20_wp Shear² floor in the interior gradient-Ri (matches PP81 kernels). real(kind=wp), private, parameter :: SHEAR2_FLOOR = 1.0e-10_wp Velocity-difference floor in the bulk-Ri denominator (matches rki_ocean_vmix ); stops Ri_bulk blowing up in quiescent water. Functions public pure function kpp_shape (sigma) result(g) KPP cubic shape function G(sigma) = sigma·(1-sigma)² (LMD94), valid for\n0 <= sigma <= 1. Exposed only for unit tests; hot kernels inline the\none-line form to avoid a device cross-call. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: sigma Return Value real(kind=wp) Subroutines public pure subroutine ml_kpp_boundary_layer (h_layer, hu_layer, hv_layer, rho_layer, hS_layer, rho_0, alpha_T, beta_S, cp, wind_x, wind_y, heat_flux, evap_minus_precip, ri_crit, c_vt2, u_star, buoy_flux, bl_depth, grid, nz) Pass 1: per-column u_ , B_0, and bulk-Ri boundary-layer depth h_b.\n  u_ = sqrt(|tau|/rho_0), tau = surface wind stress (Pa).\n  B_0 = g·(alpha_T·F_T - beta_S·F_S), kinematic fluxes\n        F_T = Q_heat/(rho_0·cp), F_S = (E-P)·S_top; B_0 < 0 destabilizing.\n  h_b : top-down bulk-Ri sweep; crossing of ri_crit interpolated.\n        V_t²(d) = (c_vt2/ri_crit)·d·N(d)·w_s uses lagged bl_depth (zero on first call ⇒ self-bootstrapping). No crossing ⇒ h_b = H. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: alpha_T real(kind=wp), intent(in) :: beta_S real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: ri_crit real(kind=wp), intent(in) :: c_vt2 real(kind=wp), intent(inout) :: u_star (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: buoy_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: bl_depth (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_kpp_diffusion_tracers (h_layer, hu_layer, hv_layer, hS_layer, hT_layer, rho_layer, rho_0, nu_max, kappa_S_bg, kappa_T_bg, ri_alpha, cs_nonlocal, heat_flux, evap_minus_precip, cp, u_star, buoy_flux, bl_depth, grid, nz, dt) Pass 2 (tracers): PP81 cubic interior diffusivity with the KPP\noverlay max’d in (same overlay as momentum), explicit flux on\nsalinity + temperature, plus the non-local counter-gradient\ntransport under destabilizing forcing.  Fuses the two ml_vertical_diffusion_tracer calls; bit-identical to them\nwhere the overlay + non-local terms vanish. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: nu_max real(kind=wp), intent(in) :: kappa_S_bg real(kind=wp), intent(in) :: kappa_T_bg real(kind=wp), intent(in) :: ri_alpha real(kind=wp), intent(in) :: cs_nonlocal real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: u_star (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: buoy_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: bl_depth (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_kpp_viscosity (h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, u_star, buoy_flux, bl_depth, grid, nz, dt) Pass 2 (momentum): PP81 interior viscosity with the KPP\nshape-function overlay max’d in, then the explicit CFL-clamped\ndiffusive flux applied to hu/hv.  Identical to ml_vertical_viscosity everywhere the overlay is inactive\n(w_s = 0 or interface below the BL). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: r