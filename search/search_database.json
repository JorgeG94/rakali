d=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: b (grid%nx_total,grid%ny_total) (see bc_wall_edge ).  Open/tidal/inflow edges leave it untouched\n— there the domain genuinely continues past the boundary. type( hgrid_t ), intent(in) :: grid type( bc_params_t ), intent(inout) :: bc Boundary condition parameters public pure subroutine apply_nh_boundary_conditions (q_nh, u_layer, v_layer, w, h, b, grid, nz, bc) Fill ghost cells for non-hydrostatic variables Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: q_nh (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: w (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz type( bc_params_t ), intent(in) :: bc private pure subroutine bc_chapman_edge (h, hu, hv, b, grid, ed, eta_old, dt, dx, dy) Chapman / Orlanski radiation for one edge.  The ghost surface\nadvects at a clamped, non-negative phase speed estimated from the\ninterior eta tendency and along-normal gradient; the momentum is\nthe Flather radiation about that surface (sign ed%nrm_sign). eta_old is this edge’s persistent surface (length n_tan),\nrefreshed to the interior eta on the k==1 layer (per-t writes are\ndisjoint). dd = dx on W/E, dy on S/N. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed real(kind=wp), intent(inout) :: eta_old (:) real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: dx real(kind=wp), intent(in) :: dy private pure subroutine bc_clamped_edge (h, hu, hv, b, grid, ed, eta) Clamped (Dirichlet surface): prescribe the ghost depth from the\nclamped elevation; copy BOTH momenta from the first interior\ncell (no normal/tangential distinction). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed real(kind=wp), intent(in) :: eta private pure subroutine bc_disch_edge (h, hu, hv, b, grid, ed, flux) depth-integrated transport) is set directly to the prescribed\ninward flux (inward = -ed%nrm_sign); tangential momentum copied. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed real(kind=wp), intent(in) :: flux private pure subroutine bc_flather_edge (h, hu, hv, b, grid, ed, eta_ext, prescribe_h) Flather radiation for one edge.  Shared by OPEN (eta_ext = 0,\nprescribe_h = .false. -> zero-gradient ghost depth) and TIDAL\n(eta_ext = tidal_eta, prescribe_h = .true. -> ghost depth from\nthe prescribed surface).  The NORMAL momentum radiates the\nsurface anomaly outward (sign from ed%nrm_sign); the tangential\nmomentum is copied from the first interior cell. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed real(kind=wp), intent(in) :: eta_ext logical, intent(in) :: prescribe_h private pure subroutine bc_inflow_edge (h, hu, hv, b, grid, ed, vel) prescribed inward transport h_ghost*vel (inward = -ed%nrm_sign);\ntangential momentum copied from the first interior cell. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed real(kind=wp), intent(in) :: vel private pure subroutine bc_wall_edge (h, hu, hv, b, grid, ed) Wall / sponge ghost fill for one edge: mirror the BED and the\nsurface, negate the NORMAL momentum, copy the tangential.\nGeometry comes from ed ; its scalars are hoisted to locals so the\ndo concurrent carries no derived-type dereference. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid type( edge_t ), intent(in) :: ed","tags":"","url":"module/rki_boundary.html"},{"title":"rki_bathymetry – Rakali","text":"Reads bathymetry (bottom elevation) from a NetCDF file and populates\nthe state%barotropic%b array. Expects a 2D variable on a structured grid.\nIf no file is configured, falls back to flat bottom. Uses pic_logger netcdf rki_constants rki_grid rki_io_netcdf pic_strings module~~rk