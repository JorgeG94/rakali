nce forward if sim_time has passed the current bracket do while ( forc % idx_hi < forc % ntime . and . & sim_time >= forc % time ( forc % idx_hi )) ! Shift hi -> lo forc % idx_lo = forc % idx_hi forc % u10_lo = forc % u10_hi forc % v10_lo = forc % v10_hi forc % msl_lo = forc % msl_hi forc % tp_lo = forc % tp_hi ! Load new hi forc % idx_hi = forc % idx_hi + 1 call load_snapshot ( forc , forc % ncid , forc % idx_hi , & forc % u10_hi , forc % v10_hi , & forc % msl_hi , forc % tp_hi ) end do end subroutine advance_bracket","tags":"","url":"proc/advance_bracket.html"},{"title":"allocate_snapshots – Rakali","text":"private  subroutine allocate_snapshots(forc) Allocate the two time-bracket snapshot arrays Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(inout) :: forc Called by proc~~allocate_snapshots~~CalledByGraph proc~allocate_snapshots allocate_snapshots proc~forcing_init forcing_init proc~forcing_init->proc~allocate_snapshots proc~forcing_init_from_config forcing_init_from_config proc~forcing_init_from_config->proc~forcing_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~forcing_init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: na integer, private :: nl Source Code subroutine allocate_snapshots ( forc ) !! Allocate the two time-bracket snapshot arrays type ( forcing_t ), intent ( inout ) :: forc integer :: nl , na nl = forc % nlon na = forc % nlat allocate ( forc % u10_lo ( nl , na ), source = 0.0_wp ) allocate ( forc % u10_hi ( nl , na ), source = 0.0_wp ) allocate ( forc % v10_lo ( nl , na ), source = 0.0_wp ) allocate ( forc % v10_hi ( nl , na ), source = 0.0_wp ) allocate ( forc % msl_lo ( nl , na ), source = 0.0_wp ) allocate ( forc % msl_hi ( nl , na ), source = 0.0_wp ) allocate ( forc % tp_lo ( nl , na ), source = 0.0_wp ) allocate ( forc % tp_hi ( nl , na ), source = 0.0_wp ) end subroutine allocate_snapshots","tags":"","url":"proc/allocate_snapshots.html"},{"title":"compute_interp_weights – Rakali","text":"private  subroutine compute_interp_weights(forc, state) Precompute bilinear interpolation indices and weights: map each\nmodel cell centre to the forcing grid, store lower-left index and\nfractional weights. Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(inout) :: forc type( state_t ), intent(in) :: state Calls proc~~compute_interp_weights~2~~CallsGraph proc~compute_interp_weights~2 compute_interp_weights proc~find_bracket find_bracket proc~compute_interp_weights~2->proc~find_bracket Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_interp_weights~2~~CalledByGraph proc~compute_interp_weights~2 compute_interp_weights proc~forcing_init forcing_init proc~forcing_init->proc~compute_interp_weights~2 proc~forcing_init_from_config forcing_init_from_config proc~forcing_init_from_config->proc~forcing_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~forcing_init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: fx real(kind=wp), private :: fy integer, private :: i integer, private :: j integer, private :: ng integer, private :: nx integer, private :: ny real(kind=wp), private :: x_model real(kind=wp), private :: y_model Source Code subroutine compute_interp_weights ( forc , state ) !! Precompute bilinear interpolation indices and weights: map each !! model cell centre to the forcing grid, store lower-left index and !! fractional weights. type ( forcing_t ), intent ( inout ) :: forc type ( state_t ), intent ( in ) :: state integer :: i , j , nx , ny , ng real ( wp ) :: x_model , y_model , fx , fy nx = state % grid % nx_total ny = state % grid % ny_total ng = state % grid % nghost allocate ( forc % ix0 ( nx , ny ), source = 1 ) allocate ( forc % iy0 ( nx , ny ), source = 1 ) allocate ( forc % wx ( nx , ny ), source = 0.0_wp ) allocate ( forc % wy ( nx , ny ), source = 0.0_wp ) do j = ng + 1 , ny - ng do i = ng + 1 , nx - ng ! Model cell centre in forcing coordinates x_model = forc % x_origin + ( real ( i - ng , wp ) - 0.5_wp ) * state % grid % dx y_model = forc % y_origin + ( real ( j - ng , wp ) - 0.5_wp ) * state % grid % dy ! Find position in forcing grid call find_bracket ( forc % lon , forc % nlon , x_model , forc % ix0 ( i , j ), fx ) call find_bracket ( forc % lat , forc % nlat , y_model , forc % iy0 ( i , j ), fy ) forc % wx ( i , j ) = fx forc % wy ( i , j ) = fy end do end do end subroutine compute_interp_weights","tags":"","url":"proc/compute_interp_weights~2.html"},{"title":"find_bracket – Rakali","text":"private pure subroutine find_bracket(coords, n, val, idx, frac) Find the bracketing interval in a sorted coordinate array:\nidx with coords(idx) <= val < coords(idx+1) and\nfrac = (val - coords(idx)) / (coords(idx+1) - coords(idx)).\nClamps to boundaries if val is outside the grid. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: coords (:) integer, intent(in) :: n real(kind=wp), intent(in) :: val integer, intent(out) :: idx real(kind=wp), intent(out) :: frac Called by proc~~find_bracket~~CalledByGraph proc~find_bracket find_bracket proc~compute_interp_weights~2 compute_interp_weights proc~compute_interp_weights~2->proc~find_bracket proc~forcing_init forcing_init proc~forcing_init->proc~compute_interp_weights~2 proc~forcing_init_from_config forcing_init_from_config proc~forcing_init_from_config->proc~forcing_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~forcing_init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: k Source Code pure subroutine find_bracket ( coords , n , val , idx , frac ) !! Find the bracketing interval in a sorted coordinate array: !! idx with coords(idx) <= val < coords(idx+1) and !! frac = (val - coords(idx)) / (coords(idx+1) - coords(idx)). !! Clamps to boundaries if val is outside the grid. real ( wp ), intent ( in ) :: coords (:) integer , intent ( in ) :: n real ( wp ), intent ( in ) :: val integer , intent ( out ) :: idx real ( wp ), intent ( out ) :: frac integer :: k if ( n <= 1 ) then idx = 1 frac = 0.0_wp return end if ! Clamp below if ( val <= coords ( 1 )) then idx = 1 frac = 0.0_wp return end if ! Clamp above if ( val >= coords ( n )) then idx = n frac = 0.0_wp return end if ! Linear search (forcing grids are typically small, <1000 points) do k = 1 , n - 1 if ( val >= coords ( k ) . and . val < coords ( k + 1 )) then idx = k frac = ( val - coords ( k )) / ( coords ( k + 1 ) - coords ( k )) return end if end do ! Fallback (should not reach here) idx = n - 1 frac = 1.0_wp end subroutine find_bracket","tags":"","url":"proc/find_bracket.html"},{"title":"find_forcing_vars – Rakali","text":"private  subroutine find_forcing_vars(forc, ncid) Locate forcing variable IDs, tolerating missing variables Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(inout) :: forc integer, intent(in) :: ncid Calls proc~~find_forcing_vars~~CallsGraph proc~find_forcing_vars find_forcing_vars info info proc~find_forcing_vars->info nf90_inq_varid