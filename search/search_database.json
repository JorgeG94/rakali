 j , k ), tr_snap ( i , j , k ), & tr_snap ( i + 1 , j , k ), sigma ) case default tr_face_val = tr_snap ( i , j , k ) ! donor end select flux_right = f_layer * tr_face_val else if ( f_layer < 0.0_wp ) then ! Upwind cell c = i+1 (flowing left — flip stencil) avail_up = nx - nghost - i + 1 ! avail_east(i) avail_down = i - nghost + 1 ! avail_west(i) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i + 5 , j , k ), tr_snap ( i + 4 , j , k ), & tr_snap ( i + 3 , j , k ), tr_snap ( i + 2 , j , k ), & tr_snap ( i + 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i - 1 , j , k ), & tr_snap ( i - 2 , j , k ), tr_snap ( i - 3 , j , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i + 4 , j , k ), tr_snap ( i + 3 , j , k ), & tr_snap ( i + 2 , j , k ), tr_snap ( i + 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i - 1 , j , k ), & tr_snap ( i - 2 , j , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i + 3 , j , k ), tr_snap ( i + 2 , j , k ), & tr_snap ( i + 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i - 1 , j , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i + 2 , j , k ), tr_snap ( i + 1 , j , k ), & tr_snap ( i , j , k ), sigma ) case default tr_face_val = tr_snap ( i + 1 , j , k ) ! donor end select flux_right = f_layer * tr_face_val else flux_right = 0.0_wp end if ! ---- y-direction: BOTTOM face (between j-1 and j) ---- f_layer = v_yB ( k ) + hf_yB ( k ) * inv_H_yB * corr_yB h_face = 0.5_wp * ( h_layer ( i , j - 1 , k ) + h_layer ( i , j , k )) if ( h_face > DRY_TOLERANCE ) then u_eff = f_layer / h_face sigma = min ( abs ( u_eff ) * dt * inv_dy , 1.0_wp ) else u_eff = 0.0_wp sigma = 0.0_wp end if if ( f_layer > 0.0_wp ) then ! Upwind cell c = j-1 (flowing north) avail_up = j - nghost ! avail_south(j-1) avail_down = ny - nghost - j + 2 ! avail_north(j-1) rung = recon_rung_for_face ( avail_up , avail_down , rung