ny_total ) real ( wp ), intent ( in ) :: h0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: a_n !! Blend weight on the start-of-step state U&#94;n. integer :: i , j , nx , ny , nghost real ( wp ) :: a_prev , eps4 , h4 , u_val , v_val , speed_sq , fr_max_sq , fr_scale nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost a_prev = 1.0_wp - a_n eps4 = DESING_EPS ** 4 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h4 , u_val , v_val , speed_sq , fr_max_sq , fr_scale ) h ( i , j ) = a_n * h0 ( i , j ) + a_prev * h ( i , j ) hu ( i , j ) = a_n * hu0 ( i , j ) + a_prev * hu ( i , j ) hv ( i , j ) = a_n * hv0 ( i , j ) + a_prev * hv ( i , j ) if ( h ( i , j ) < 0.0_wp ) then h ( i , j ) = 0.0_wp hu ( i , j ) = 0.0_wp hv ( i , j ) = 0.0_wp else if ( h ( i , j ) < DRY_TOLERANCE ) then hu ( i , j ) = 0.0_wp hv ( i , j ) = 0.0_wp else h4 = h ( i , j ) ** 4 if ( h4 < eps4 ) then u_val = sqrt ( 2.0_wp ) * h ( i , j ) * hu ( i , j ) / sqrt ( h4 + eps4 ) v_val = sqrt ( 2.0_wp ) * h ( i , j ) * hv ( i , j ) / sqrt ( h4 + eps4 ) hu ( i , j ) = h ( i , j ) * u_val hv ( i , j ) = h ( i , j ) * v_val end if speed_sq = ( hu ( i , j ) ** 2 + hv ( i , j ) ** 2 ) / h ( i , j ) ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h ( i , j ) if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) hu ( i , j ) = hu ( i , j ) * fr_scale hv ( i , j ) = hv ( i , j ) * fr_scale end if end if end do end subroutine compute_ssp_combine","tags":"","url":"proc/compute_ssp_combine.html"},{"title":"compute_update – Rakali","text":"public pure subroutine compute_update(h, hu, hv, flux_h, flux_hu, flux_hv, grid, dt) Forward Euler update U = U + dt*RHS (each SSP-RK2 stage). Also\nenforces non-negative depth, zeroes momentum in dry cells, and\ndesingularizes thin-cell velocity (KP