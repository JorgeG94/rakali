s per coarse\ncell).  Host, O(fine edges). Arguments Type Intent Optional Attributes Name type( agglom_level_unstr_t ), intent(in) :: levf type( agglom_level_unstr_t ), intent(inout) :: levc integer, intent(in) :: aggof (:) Calls proc~~build_coarse_adjacency~~CallsGraph proc~build_coarse_adjacency build_coarse_adjacency proc~push_unique push_unique proc~build_coarse_adjacency->proc~push_unique Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~build_coarse_adjacency~~CalledByGraph proc~build_coarse_adjacency build_coarse_adjacency proc~aggregate_and_build_coarse aggregate_and_build_coarse proc~aggregate_and_build_coarse->proc~build_coarse_adjacency proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~aggregate_and_build_coarse proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: capI integer, private :: capJ integer, private, allocatable :: cnt (:) integer, private :: i integer, private :: j integer, private :: k integer, private :: mv integer, private :: nc integer, private :: s integer, private, allocatable :: tmpnbr (:,:) Source Code subroutine build_coarse_adjacency ( levf , levc , aggof ) !! Build coarse-level neighbour lists from the fine adjacency: coarse !! cells I,J are neighbours iff some fine edge crosses the I-J aggregate !! boundary.  Sets levc%mv / n_nbr / nbr (unique neighbours per coarse !! cell).  Host, O(fine edges). type ( agglom_level_unstr_t ), intent ( in ) :: levf type ( agglom_level_unstr_t ), intent ( inout ) :: levc integer , intent ( in ) :: aggof (:) integer :: nc , k , s , j , capI , capJ , mv , i integer , allocatable :: cnt (:), tmpnbr (:, :) nc = levc % nc allocate ( cnt ( nc ), source = 0 ) ! First pass: over-estimate max valence = sum of member valences. mv = 0 do capI = 1 , nc capJ = 0 do i = levc % mstart ( capI ), levc % mstart ( capI + 1 ) - 1 k = levc % mlist ( i ) capJ = capJ + levf % n_nbr ( k ) end do mv = max ( mv , capJ ) end do mv = max ( mv , 1 ) allocate ( tmpnbr ( mv , nc ), source = 0 ) do capI = 1 , nc do i = levc % mstart ( capI ), levc % mstart ( capI + 1 ) - 1 k = levc % mlist ( i ) do s = 1 , levf % n_nbr ( k ) j = aggof ( levf % nbr ( s , k )) if ( j == capI ) cycle call push_unique ( tmpnbr (:, capI ), cnt ( capI ), j ) end do end do end do levc % mv = max ( maxval ( cnt ), 1 ) allocate ( levc % n_nbr ( nc )) allocate ( levc % nbr ( levc % mv , nc ), source = 1 ) do capI = 1 , nc levc % n_nbr ( capI ) = cnt ( capI ) do s = 1 , cnt ( capI ) levc % nbr ( s , capI ) = tmpnbr ( s , capI ) end do end do deallocate ( cnt , tmpnbr ) end subroutine build_coarse_adjacency","tags":"","url":"proc/build_coarse_adjacency.html"},{"title":"build_level1_structure – Rakali","text":"private  subroutine build_level1_structure(this, mesh, nco) Allocate the level array + fill level 1’s static interior-neighbour\nstructure from the mesh (mv = EDGES_PER_TRI = 3). Arguments Type Intent Optional Attributes Name class( agglom_hierarchy_unstr_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nco Called by proc~~build_level1_structure~~CalledByGraph proc~build_level1_structure build_level1_structure proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~build_level1_structure proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: k integer, private :: kn integer, private :: ns Source Code subroutine build_level1_structure ( this , mesh , nco ) !! Allocate the level array + fill level 1's static interior-neighbour !! structure from the mesh (mv = EDGES_PER_TRI = 3). class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nco integer :: k , i , kn , ns allocate ( this % lev ( AGGLOM_MAX_LEVELS )) this % n_levels = 1 this % lev ( 1 )% nc = nco this % lev ( 1 )% mv = EDGES_PER_TRI allocate ( this % lev ( 1 )% n_nbr ( nco ), source = 0 ) allocate ( this % lev ( 1 )% nbr ( EDGES_PER_TRI , nco ), source = 1 ) do k = 1 , nco ns = 0 do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , k ) if ( kn > 0 . and . kn <= nco ) then ns = ns + 1 this % lev ( 1 )% nbr ( ns , k ) = kn end if end do this % lev ( 1 )% n_nbr ( k ) = ns end do end subroutine build_level1_structure","tags":"","url":"proc/build_level1_structure.html"},{"title":"galerkin_operator – Rakali","text":"private  subroutine galerkin_operator(levf, levc, strength) Build the coarse operator ke/diag/dinv by the Galerkin cascade from\nthe finer level’s ke/diag (== rediscretized agglomerate-TPFA for 0/1\naggregation). strength(mvc,ncc) returns |ke| for the NEXT\naggregation.  HOST; caller pushes to the device. Arguments Type Intent Optional Attributes Name type( agglom_level_unstr_t ), intent(in) :: levf type( agglom_level_unstr_t ), intent(inout) :: levc real(kind=wp), intent(out), optional :: strength (levc%mv,levc%nc) |ke| per coarse edge for the NEXT aggregation (BUILD only; the\nper-step refresh omits it). Calls proc~~galerkin_operator~~CallsGraph proc~galerkin_operator galerkin_operator proc~find_slot find_slot proc~galerkin_operator->proc~find_slot error error proc~find_slot->error proc~itoa itoa proc~find_slot->proc~itoa Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~galerkin_operator~~CalledByGraph proc~galerkin_operator galerkin_operator proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~galerkin_operator proc~agglom_hierarchy_unstr_refresh agglom_hierarchy_unstr_refresh proc~agglom_hierarchy_unstr_refresh->proc~galerkin_operator proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~agglom_hierarchy_unstr_refresh proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: capI integer, private :: capJ real(kind=wp), private :: diagI integer, private :: i integer, private :: j integer, private :: k integer, private :: s integer, private :: t real(kind=wp), private :: v Source Code subroutine galerkin_operator ( levf , levc , strength ) !! Build the coarse operator ke/diag/dinv by the Galerkin cascade from !! the finer level's ke/diag (== rediscretized agglomerate-TPFA for 0/1 !! aggregation).  `strength(mvc,ncc)` returns |ke| for the NEXT !! aggregation.  HOST; caller pushes to the device. type ( agglom_level_unstr_t ), intent ( in ) :: levf type ( agglom_level_unstr_t ), intent ( inout ) :: levc real ( wp ), intent ( out ), optional :: strength ( levc % mv , levc % nc ) !! |ke| per coarse edge for the NEXT aggregation (BUILD only; the !! per-step refresh omits it). integer :: capI , i , k , s , j , capJ , t real ( wp ) :: diagI , v if ( present ( strength )) strength = 0.0_wp levc % ke = 0.0_wp do capI = 1 , levc % nc diagI = 0.0_wp do i = levc % mstart ( capI ), levc % mstart ( capI + 1 ) - 1 k = levc % mlist ( i ) diagI = diagI + levf % diag ( k ) do s = 1 , levf % n_nbr ( k ) j = levf % nbr ( s , k ) v = levf % ke ( s , k ) capJ = levf % agg_of ( j ) if ( capJ == capI ) then diagI = diagI - v ! internal edge folds to diag else t = find_slot ( levc % nbr (:, capI ), levc % n_nbr ( capI ), capJ ) ! ke >= 0 invariant (Hf >= 0 => level-1 ke >= 0 => Galerkin ! sums stay >= 0), so the signed ke doubles as the next ! aggregation strength; a negative ke would silently ! degrade coarsening to singletons. levc % ke ( t , capI ) = levc % ke ( t , capI ) + v if ( present ( strength )) strength ( t , capI ) = levc % ke ( t , capI ) end if end do end do levc % diag ( capI ) = diagI levc % dinv ( capI ) = 1.0_wp / diagI end do end subroutine galerkin_operator","tags":"","url":"proc/galerkin_operator.html"},{"title":"level1_operator – Rakali","text":"private  subroutine level1_operator(mesh, nco, coef, Hf_edge, lev, strength) Fill level 1’s ke/diag/dinv from the mesh geometry + the per-edge\nfrozen Hf (still-water synthetic at build, the live Hf_edge at\nrefresh).  Mirrors si_unstr_compute_diag + the interior off-diagonals\nof si_unstr_apply_helmholtz , so the symmetric Ahat row is exact:\n  diag(k) = area_k + coef*sum_{Hf>0} K_e   (interior + Dirichlet)\n  off-diag ke to interior neighbours only.\nA Dirichlet boundary edge carries Hf>0 with no CG-unknown neighbour =>\nit lands on the diagonal (ghost = homogeneous 0 in the error\noperator).  Wall edges carry Hf=0 => dropped. strength returns |ke|\nper interior edge for aggregation.  HOST; caller pushes to the device. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nco real(kind=wp), intent(in) :: coef real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,nco) type( agglom_level_unstr_t ), intent(inout) :: lev real(kind=wp), intent(out), optional :: strength (lev%mv,nco) |ke| per edge for the NEXT aggregation.  Needed at BUILD only;\nthe per-step refresh omits it (no scratch allocation in the\nper-step path). Called by proc~~level1_operator~~CalledByGraph proc~level1_operator level1_operator proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~level1_operator proc~agglom_hierarchy_unstr_refresh agglom_hierarchy_unstr_refresh proc~agglom_hierarchy_unstr_refresh->proc~level1_operator proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~agglom_hierarchy_unstr_refresh proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: diagk integer, private :: i integer, private :: k real(kind=wp), private :: kloc integer, private :: kn integer, private :: ns Source Code subroutine level1_operator ( mesh , nco , coef , Hf_edge , lev , strength ) !! Fill level 1's ke/diag/dinv from the mesh geometry + the per-edge !! frozen Hf (still-water synthetic at build, the live `Hf_edge` at !! refresh).  Mirrors `si_unstr_compute_diag` + the interior off-diagonals !! of `si_unstr_apply_helmholtz`, so the symmetric Ahat row is exact: !!   diag(k) = area_k + coef*sum_{Hf>0} K_e   (interior + Dirichlet) !!   off-diag ke to interior neighbours only. !! A Dirichlet boundary edge carries Hf>0 with no CG-unknown neighbour => !! it lands on the diagonal (ghost = homogeneous 0 in the error !! operator).  Wall edges carry Hf=0 => dropped.  `strength` returns |ke| !! per interior edge for aggregation.  HOST; caller pushes to the device. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nco real ( wp ), intent ( in ) :: coef real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nco ) type ( agglom_level_unstr_t ), intent ( inout ) :: lev real ( wp ), intent ( out ), optional :: strength ( lev % mv , nco ) !! |ke| per edge for the NEXT aggregation.  Needed at BUILD only; !! the per-step refresh omits it (no scratch allocation in the !! per-step path). integer :: k , i , kn , ns real ( wp ) :: kloc , diagk if ( present ( strength )) strength = 0.0_wp lev % ke = 0.0_wp do k = 1 , nco diagk = mesh % area ( k ) ns = 0 do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , k ) ! Diagonal: every Hf>0 edge contributes coef*K_e (interior OR ! Dirichlet boundary edge — the latter lands on the diagonal with ! no CG-unknown neighbour slot).  Hf<=0 (wall / dried edge) => 0. if ( Hf_edge ( i , k ) > 0.0_wp ) then kloc = coef * Hf_edge ( i , k ) * mesh % edge_len ( i , k ) & / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) diagk = diagk + kloc else kloc = 0.0_wp end if ! Off-diagonal slot: advance `ns` on the SAME interior-edge ! predicate as `build_level1_structure` so the ke slot index stays ! LOCKED to the nbr slot index — independent of whether this edge's ! Hf is zero.  An interior edge that dries (Hf<=0) writes a ZERO ! (wall-like) transmissibility into its own aligned slot rather than ! skipping it, keeping the operator symmetric + SPD even with mixed ! zero/nonzero interior Hf (the plain 2D-barotropic dry-cell path). if ( kn > 0 . and . kn <= nco ) then ns = ns + 1 lev % ke ( ns , k ) = kloc if ( present ( strength )) strength ( ns , k ) = kloc end if end do lev % diag ( k ) = diagk lev % dinv ( k ) = 1.0_wp / diagk end do end subroutine level1_operator","tags":"","url":"proc/level1_operator.html"},{"title":"level_coeffs_to_device – Rakali","text":"private  subroutine level_coeffs_to_device(lev) Push the host-refreshed coefficient arrays to the device. Arguments Type Intent Optional Attributes Name type( agglom_level_unstr_t ), intent(inout) :: lev Called by proc~~level_coeffs_to_device~~CalledByGraph proc~level_coeffs_to_device level_coeffs_to_device proc~agglom_hierarchy_unstr_refresh agglom_hierarchy_unstr_refresh proc~agglom_hierarchy_unstr_refresh->proc~level_coeffs_to_device proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~agglom_hierarchy_unstr_refresh proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine level_coeffs_to_device ( lev ) !! Push the host-refreshed coefficient arrays to the device. type ( agglom_level_unstr_t ), intent ( inout ) :: lev !$acc update device(lev%ke, lev%diag, lev%dinv) end subroutine level_coeffs_to_device","tags":"","url":"proc/level_coeffs_to_device.html"},{"title":"move_level – Rakali","text":"private  subroutine move_level(src, dst) move_alloc every component from src to dst (host, pre-enter_data). Arguments Type Intent Optional Attributes Name type( agglom_level_unstr_t ), intent(inout) :: src type( agglom_level_unstr_t ), intent(inout) :: dst Called by proc~~move_level~~CalledByGraph proc~move_level move_level proc~trim_levels trim_levels proc~trim_levels->proc~move_level proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~trim_levels proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine move_level ( src , dst ) !! move_alloc every component from src to dst (host, pre-enter_data). type ( agglom_level_unstr_t ), intent ( inout ) :: src type ( agglom_level_unstr_t ), intent ( inout ) :: dst dst % nc = src % nc dst % mv = src % mv if ( allocated ( src % n_nbr )) call move_alloc ( src % n_nbr , dst % n_nbr ) if ( allocated ( src % nbr )) call move_alloc ( src % nbr , dst % nbr ) if ( allocated ( src % agg_of )) call move_alloc ( src % agg_of , dst % agg_of ) if ( allocated ( src % mstart )) call move_alloc ( src % mstart , dst % mstart ) if ( allocated ( src % mlist )) call move_alloc ( src % mlist , dst % mlist ) if ( allocated ( src % ke )) call move_alloc ( src % ke , dst % ke ) if ( allocated ( src % diag )) call move_alloc ( src % diag , dst % diag ) if ( allocated ( src % dinv )) call move_alloc ( src % dinv , dst % dinv ) if ( allocated ( src % e )) call move_alloc ( src % e , dst % e ) if ( allocated ( src % r )) call move_alloc ( src % r , dst % r ) if ( allocated ( src % tmp )) call move_alloc ( src % tmp , dst % tmp ) end subroutine move_level","tags":"","url":"proc/move_level.html"},{"title":"push_unique – Rakali","text":"private  subroutine push_unique(list, n, val) Append val to list(1:n) if not already present; bump n. Arguments Type Intent Optional Attributes Name integer, intent(inout) :: list (:) integer, intent(inout) :: n integer, intent(in) :: val Called by proc~~push_unique~~CalledByGraph proc~push_unique push_unique proc~build_coarse_adjacency build_coarse_adjacency proc~build_coarse_adjacency->proc~push_unique proc~aggregate_and_build_coarse aggregate_and_build_coarse proc~aggregate_and_build_coarse->proc~build_coarse_adjacency proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~aggregate_and_build_coarse proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: s Source Code subroutine push_unique ( list , n , val ) !! Append val to list(1:n) if not already present; bump n. integer , intent ( inout ) :: list (:) integer , intent ( inout ) :: n integer , intent ( in ) :: val integer :: s do s = 1 , n if ( list ( s ) == val ) return end do n = n + 1 list ( n ) = val end subroutine push_unique","tags":"","url":"proc/push_unique.html"},{"title":"trim_levels – Rakali","text":"private  subroutine trim_levels(this) Move-shrink the over-allocated level array to n_levels. Arguments Type Intent Optional Attributes Name class( agglom_hierarchy_unstr_t ), intent(inout) :: this Calls proc~~trim_levels~~CallsGraph proc~trim_levels trim_levels proc~move_level move_level proc~trim_levels->proc~move_level Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~trim_levels~~CalledByGraph proc~trim_levels trim_levels proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~trim_levels proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial type( agglom_level_unstr_t ), private, allocatable :: keep (:) integer, private :: l Source Code subroutine trim_levels ( this ) !! Move-shrink the over-allocated level array to n_levels. class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this type ( agglom_level_unstr_t ), allocatable :: keep (:) integer :: l allocate ( keep ( this % n_levels )) do l = 1 , this % n_levels call move_level ( this % lev ( l ), keep ( l )) end do call move_alloc ( keep , this % lev ) end subroutine trim_levels","tags":"","url":"proc/trim_levels.html"},{"title":"output_rank_filename – Rakali","text":"public  function output_rank_filename(base_dir, prefix, rank) result(fname) Generate a filename: / _rank_NNNNNN.nc (the rank\nsuffix is a leftover of the removed MPI support; callers pass 0) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: base_dir Output directory character(len=*), intent(in) :: prefix File prefix (e.g. “output” or “restart”) integer, intent(in) :: rank Rank suffix (always 0) Return Value character(len=512) Called by proc~~output_rank_filename~~CalledByGraph proc~output_rank_filename output_rank_filename proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~output_rank_filename proc~flush_restart flush_restart proc~driver_run_coastal->proc~flush_restart proc~flush_restart->proc~output_rank_filename proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code function output_rank_filename ( base_dir , prefix , rank ) result ( fname ) !! Generate a filename: <base_dir>/<prefix>_rank_NNNNNN.nc (the rank !! suffix is a leftover of the removed MPI support; callers pass 0) character ( len =* ), intent ( in ) :: base_dir !! Output directory character ( len =* ), intent ( in ) :: prefix !! File prefix (e.g. \"output\" or \"restart\") integer , intent ( in ) :: rank !! Rank suffix (always 0) character ( len = 512 ) :: fname write ( fname , '(A,\"/\",A,\"_rank_\",I6.6,\".nc\")' ) & trim ( base_dir ), trim ( prefix ), rank end function output_rank_filename","tags":"","url":"proc/output_rank_filename.html"},{"title":"output_close – Rakali","text":"public  subroutine output_close(ostate) Close the output NetCDF file Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Calls proc~~output_close~~CallsGraph proc~output_close output_close info info proc~output_close->info proc~nc_close nc_close proc~output_close->proc~nc_close to_string to_string proc~output_close->to_string nf90_close nf90_close proc~nc_close->nf90_close proc~nc_check nc_check proc~nc_close->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~output_close~~CalledByGraph proc~output_close output_close proc~finalize_output finalize_output proc~finalize_output->proc~output_close proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~finalize_output proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine output_close ( ostate ) !! Close the output NetCDF file type ( output_state_t ), intent ( inout ) :: ostate if ( ostate % ncid >= 0 ) then call nc_close ( ostate % ncid ) ostate % ncid = - 1 if ( allocated ( ostate % dsig )) deallocate ( ostate % dsig ) if ( allocated ( ostate % ml_tracer_varids )) deallocate ( ostate % ml_tracer_varids ) call logger % info ( \"Output file closed (\" // & to_string ( ostate % time_index ) // \" snapshots written)\" ) end if end subroutine output_close","tags":"","url":"proc/output_close.html"},{"title":"output_init – Rakali","text":"public  subroutine output_init(ostate, filename, state, cfg) Create and initialise a NetCDF output file with CF conventions Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state (populated on return) character(len=*), intent(in) :: filename Path to output file type( state_t ), intent(in) :: state Simulation state (for grid metadata) type( config_t ), intent(in) :: cfg Runtime configuration (for CF metadata) Calls proc~~output_init~~CallsGraph proc~output_init output_init info info proc~output_init->info nf90_def_var nf90_def_var proc~output_init->nf90_def_var nf90_put_var nf90_put_var proc~output_init->nf90_put_var proc~define_tracer_outputs define_tracer_outputs proc~output_init->proc~define_tracer_outputs proc~nc_check nc_check proc~output_init->proc~nc_check proc~nc_create_file nc_create_file proc~output_init->proc~nc_create_file proc~nc_def_dim nc_def_dim proc~output_init->proc~nc_def_dim proc~nc_def_var_2d nc_def_var_2d proc~output_init->proc~nc_def_var_2d proc~nc_def_var_3d nc_def_var_3d proc~output_init->proc~nc_def_var_3d proc~nc_def_var_4d nc_def_var_4d proc~output_init->proc~nc_def_var_4d proc~nc_enddef nc_enddef proc~output_init->proc~nc_enddef proc~nc_put_att nc_put_att proc~output_init->proc~nc_put_att proc~nc_put_att_global nc_put_att_global proc~output_init->proc~nc_put_att_global proc~nc_put_att_real nc_put_att_real proc~output_init->proc~nc_put_att_real proc~nc_put_var_2d nc_put_var_2d proc~output_init->proc~nc_put_var_2d proc~define_tracer_outputs->proc~nc_def_var_4d proc~define_tracer_outputs->proc~nc_put_att proc~define_tracer_outputs->proc~nc_put_att_real error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_create_file->proc~nc_check nf90_create nf90_create proc~nc_create_file->nf90_create proc~nc_def_dim->proc~nc_check nf90_def_dim nf90_def_dim proc~nc_def_dim->nf90_def_dim proc~nc_def_var_2d->nf90_def_var proc~nc_def_var_2d->proc~nc_check nf90_def_var_deflate nf90_def_var_deflate proc~nc_def_var_2d->nf90_def_var_deflate proc~nc_def_var_3d->nf90_def_var proc~nc_def_var_3d->proc~nc_check proc~nc_def_var_3d->nf90_def_var_deflate proc~nc_def_var_4d->nf90_def_var proc~nc_def_var_4d->proc~nc_check proc~nc_def_var_4d->nf90_def_var_deflate proc~nc_enddef->proc~nc_check nf90_enddef nf90_enddef proc~nc_enddef->nf90_enddef proc~nc_put_att->proc~nc_check nf90_put_att nf90_put_att proc~nc_put_att->nf90_put_att proc~nc_put_att_global->proc~nc_check proc~nc_put_att_global->nf90_put_att proc~nc_put_att_real->proc~nc_check proc~nc_put_att_real->nf90_put_att proc~nc_put_var_2d->nf90_put_var proc~nc_put_var_2d->proc~nc_check Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~output_init~~CalledByGraph proc~output_init output_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~output_init proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private, parameter :: DT_SIZE = 8 integer, private :: b_varid integer, private :: dimids_2d (2) integer, private :: dimids_3d (3) integer, private :: dimids_4d (4) integer, private :: dimids_4d_w (4) integer, private :: dlevel Deflate level (0 = no compression) integer, private :: dsig_varid integer, private :: dt_values (DT_SIZE) character(len=256), private :: history_str integer, private :: i integer, private :: j integer, private :: k integer, private :: ng character(len=256), private :: time_units real(kind=wp), private, allocatable :: x_coords (:) integer, private :: x_dimid integer, private :: x_varid real(kind=wp), private, allocatable :: y_coords (:) integer, private :: y_dimid integer, private :: y_varid integer, private :: z_dimid integer, private :: zi_dimid Source Code subroutine output_init ( ostate , filename , state , cfg ) !! Create and initialise a NetCDF output file with CF conventions type ( output_state_t ), intent ( inout ) :: ostate !! Output file state (populated on return) character ( len =* ), intent ( in ) :: filename !! Path to output file type ( state_t ), intent ( in ) :: state !! Simulation state (for grid metadata) type ( config_t ), intent ( in ) :: cfg !! Runtime configuration (for CF metadata) integer :: x_dimid , y_dimid , x_varid , y_varid , b_varid integer :: dimids_2d ( 2 ), dimids_3d ( 3 ) integer :: z_dimid , zi_dimid , dsig_varid integer :: dimids_4d ( 4 ), dimids_4d_w ( 4 ) integer :: i , j , k , ng real ( wp ), allocatable :: x_coords (:), y_coords (:) character ( len = 256 ) :: time_units , history_str integer , parameter :: DT_SIZE = 8 integer :: dt_values ( DT_SIZE ) integer :: dlevel !! Deflate level (0 = no compression) call logger % info ( \"Creating output file: \" // trim ( filename )) call nc_create_file ( filename , ostate % ncid ) ! Compression level (0 = disabled) dlevel = 0 if ( cfg % compress_output ) dlevel = cfg % compress_level ! Define dimensions call nc_def_dim ( ostate % ncid , \"x\" , state % grid % nx_phys , x_dimid ) call nc_def_dim ( ostate % ncid , \"y\" , state % grid % ny_phys , y_dimid ) call nc_def_dim ( ostate % ncid , \"time\" , nf90_unlimited , ostate % time_dimid ) dimids_2d = [ x_dimid , y_dimid ] dimids_3d = [ x_dimid , y_dimid , ostate % time_dimid ] ! Define coordinate variables call nc_check ( nf90_def_var ( ostate % ncid , \"x\" , NC_WP , [ x_dimid ], x_varid ), & \"defining x coordinate\" ) call nc_put_att ( ostate % ncid , x_varid , \"units\" , \"m\" ) call nc_put_att ( ostate % ncid , x_varid , \"long_name\" , \"x-coordinate of cell centre\" ) call nc_put_att ( ostate % ncid , x_varid , \"axis\" , \"X\" ) call nc_check ( nf90_def_var ( ostate % ncid , \"y\" , NC_WP , [ y_dimid ], y_varid ), & \"defining y coordinate\" ) call nc_put_att ( ostate % ncid , y_varid , \"units\" , \"m\" ) call nc_put_att ( ostate % ncid , y_varid , \"long_name\" , \"y-coordinate of cell centre\" ) call nc_put_att ( ostate % ncid , y_varid , \"axis\" , \"Y\" ) ! Time variable — reference time depends on whether this is an ! idealised run (reference_time=\"\") or a real-calendar run. call nc_check ( nf90_def_var ( ostate % ncid , \"time\" , nf90_double , & [ ostate % time_dimid ], ostate % time_varid ), & \"defining time variable\" ) if ( len_trim ( cfg % reference_time ) > 0 ) then time_units = \"seconds since \" // trim ( cfg % reference_time ) call nc_put_att ( ostate % ncid , ostate % time_varid , \"units\" , trim ( time_units )) call nc_put_att ( ostate % ncid , ostate % time_varid , \"calendar\" , \"proleptic_gregorian\" ) else call nc_put_att ( ostate % ncid , ostate % time_varid , \"units\" , & \"seconds since simulation start\" ) call nc_put_att ( ostate % ncid , ostate % time_varid , \"calendar\" , \"none\" ) end if call nc_put_att ( ostate % ncid , ostate % time_varid , \"long_name\" , \"time\" ) call nc_put_att ( ostate % ncid , ostate % time_varid , \"axis\" , \"T\" ) ! Bathymetry (static, 2D) call nc_def_var_2d ( ostate % ncid , \"b\" , dimids_2d , b_varid , dlevel ) call nc_put_att ( ostate % ncid , b_varid , \"units\" , \"m\" ) call nc_put_att ( ostate % ncid , b_varid , \"long_name\" , \"bottom elevation (positive up)\" ) call nc_put_att ( ostate % ncid , b_varid , \"coordinates\" , \"x y\" ) ! Solution variables (3D: x, y, time) call nc_def_var_3d ( ostate % ncid , \"h\" , dimids_3d , ostate % h_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % h_varid , \"units\" , \"m\" ) call nc_put_att ( ostate % ncid , ostate % h_varid , \"long_name\" , \"water depth\" ) call nc_put_att_real ( ostate % ncid , ostate % h_varid , \"_FillValue\" , FILL_VALUE ) call nc_put_att ( ostate % ncid , ostate % h_varid , \"coordinates\" , \"x y\" ) call nc_def_var_3d ( ostate % ncid , \"hu\" , dimids_3d , ostate % hu_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % hu_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ostate % ncid , ostate % hu_varid , \"long_name\" , \"x-momentum (h*u)\" ) call nc_put_att_real ( ostate % ncid , ostate % hu_varid , \"_FillValue\" , FILL_VALUE ) call nc_put_att ( ostate % ncid , ostate % hu_varid , \"coordinates\" , \"x y\" ) call nc_def_var_3d ( ostate % ncid , \"hv\" , dimids_3d , ostate % hv_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % hv_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ostate % ncid , ostate % hv_varid , \"long_name\" , \"y-momentum (h*v)\" ) call nc_put_att_real ( ostate % ncid , ostate % hv_varid , \"_FillValue\" , FILL_VALUE ) call nc_put_att ( ostate % ncid , ostate % hv_varid , \"coordinates\" , \"x y\" ) ! Non-hydrostatic variables (4D: x, y, z, time) if ( state % use_nonhydrostatic ) then ostate % has_nh = . true . ostate % nz = state % nh % nz allocate ( ostate % dsig ( state % nh % nz )) ostate % dsig = state % nh % dsig call nc_def_dim ( ostate % ncid , \"z\" , state % nh % nz , z_dimid ) call nc_def_dim ( ostate % ncid , \"z_interface\" , state % nh % nz + 1 , zi_dimid ) ! Sigma layer thickness coordinate call nc_check ( nf90_def_var ( ostate % ncid , \"dsig\" , NC_WP , [ z_dimid ], dsig_varid ), & \"defining dsig coordinate\" ) call nc_put_att ( ostate % ncid , dsig_varid , \"units\" , \"1\" ) call nc_put_att ( ostate % ncid , dsig_varid , \"long_name\" , & \"sigma layer thickness (fraction of water column)\" ) dimids_4d = [ x_dimid , y_dimid , z_dimid , ostate % time_dimid ] dimids_4d_w = [ x_dimid , y_dimid , zi_dimid , ostate % time_dimid ] call nc_def_var_4d ( ostate % ncid , \"u_layer\" , dimids_4d , ostate % u_layer_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % u_layer_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % u_layer_varid , \"long_name\" , & \"layer x-velocity\" ) call nc_put_att_real ( ostate % ncid , ostate % u_layer_varid , \"_FillValue\" , FILL_VALUE ) call nc_def_var_4d ( ostate % ncid , \"v_layer\" , dimids_4d , ostate % v_layer_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % v_layer_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % v_layer_varid , \"long_name\" , & \"layer y-velocity\" ) call nc_put_att_real ( ostate % ncid , ostate % v_layer_varid , \"_FillValue\" , FILL_VALUE ) call nc_def_var_4d ( ostate % ncid , \"w\" , dimids_4d_w , ostate % w_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % w_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % w_varid , \"long_name\" , & \"vertical velocity at layer interfaces\" ) call nc_put_att_real ( ostate % ncid , ostate % w_varid , \"_FillValue\" , FILL_VALUE ) call nc_def_var_4d ( ostate % ncid , \"q_nh\" , dimids_4d , ostate % q_nh_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % q_nh_varid , \"units\" , \"m2 s-2\" ) call nc_put_att ( ostate % ncid , ostate % q_nh_varid , \"long_name\" , & \"non-hydrostatic pressure\" ) call nc_put_att_real ( ostate % ncid , ostate % q_nh_varid , \"_FillValue\" , FILL_VALUE ) ! Vorticity diagnostics (3D: x, y, time) call nc_def_var_3d ( ostate % ncid , \"vorticity_x\" , dimids_3d , ostate % vort_x_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % vort_x_varid , \"units\" , \"s-1\" ) call nc_put_att ( ostate % ncid , ostate % vort_x_varid , \"long_name\" , & \"x-component of vorticity (-dv/dz)\" ) call nc_put_att_real ( ostate % ncid , ostate % vort_x_varid , \"_FillValue\" , FILL_VALUE ) call nc_def_var_3d ( ostate % ncid , \"vorticity_y\" , dimids_3d , ostate % vort_y_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % vort_y_varid , \"units\" , \"s-1\" ) call nc_put_att ( ostate % ncid , ostate % vort_y_varid , \"long_name\" , & \"y-component of vorticity (du/dz)\" ) call nc_put_att_real ( ostate % ncid , ostate % vort_y_varid , \"_FillValue\" , FILL_VALUE ) end if ! Multilayer variables (4D: x, y, z, time) if ( state % use_multilayer ) then ostate % has_ml = . true . ostate % nz_ml = state % multilayer % nz_ml call nc_def_dim ( ostate % ncid , \"z_ml\" , state % multilayer % nz_ml , z_dimid ) call nc_def_dim ( ostate % ncid , \"z_ml_interface\" , state % multilayer % nz_ml + 1 , zi_dimid ) ! Sigma layer thickness coordinate call nc_check ( nf90_def_var ( ostate % ncid , \"dsig_ml\" , NC_WP , [ z_dimid ], dsig_varid ), & \"defining dsig_ml coordinate\" ) call nc_put_att ( ostate % ncid , dsig_varid , \"units\" , \"1\" ) call nc_put_att ( ostate % ncid , dsig_varid , \"long_name\" , & \"sigma layer thickness (fraction of water column)\" ) dimids_4d = [ x_dimid , y_dimid , z_dimid , ostate % time_dimid ] dimids_4d_w = [ x_dimid , y_dimid , zi_dimid , ostate % time_dimid ] if ( cfg % out_h_layer ) then call nc_def_var_4d ( ostate % ncid , \"h_layer\" , dimids_4d , ostate % ml_h_layer_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % ml_h_layer_varid , \"units\" , \"m\" ) call nc_put_att ( ostate % ncid , ostate % ml_h_layer_varid , \"long_name\" , \"layer thickness\" ) call nc_put_att_real ( ostate % ncid , ostate % ml_h_layer_varid , \"_FillValue\" , FILL_VALUE ) end if if ( cfg % out_velocity ) then call nc_def_var_4d ( ostate % ncid , \"u_ml\" , dimids_4d , ostate % ml_u_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % ml_u_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % ml_u_varid , \"long_name\" , \"layer x-velocity\" ) call nc_put_att_real ( ostate % ncid , ostate % ml_u_varid , \"_FillValue\" , FILL_VALUE ) call nc_def_var_4d ( ostate % ncid , \"v_ml\" , dimids_4d , ostate % ml_v_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % ml_v_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % ml_v_varid , \"long_name\" , \"layer y-velocity\" ) call nc_put_att_real ( ostate % ncid , ostate % ml_v_varid , \"_FillValue\" , FILL_VALUE ) end if ! Tracer registry: define one NetCDF variable per registered ! tracer, using metadata from the tracer entry itself.  Adding ! a sediment / passive scalar to `state%multilayer%tracers(:)` ! produces a correctly-labelled output variable with no ! changes to this module.  `cfg%out_salinity` / ! `cfg%out_temperature` are still honoured (legacy switches); ! future tracers default to write-enabled. if ( allocated ( state % multilayer % tracers )) then call define_tracer_outputs ( ostate , state , cfg , dimids_4d , dlevel ) end if ! Bed sediment reservoir — a time-varying 2D (x, y, time) field, only ! when sediment is active.  Lets deposition / erosion be seen; the ! suspended load already auto-outputs via the tracer registry above. if ( state % multilayer % use_sediment ) then call nc_def_var_3d ( ostate % ncid , \"bed_sediment\" , dimids_3d , & ostate % bed_sediment_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % bed_sediment_varid , \"units\" , \"kg m-2\" ) call nc_put_att ( ostate % ncid , ostate % bed_sediment_varid , \"long_name\" , & \"bed sediment mass per unit area\" ) call nc_put_att_real ( ostate % ncid , ostate % bed_sediment_varid , \"_FillValue\" , FILL_VALUE ) call nc_put_att ( ostate % ncid , ostate % bed_sediment_varid , \"coordinates\" , \"x y\" ) end if if ( cfg % out_density ) then call nc_def_var_4d ( ostate % ncid , \"rho\" , dimids_4d , ostate % ml_rho_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % ml_rho_varid , \"units\" , \"kg m-3\" ) call nc_put_att ( ostate % ncid , ostate % ml_rho_varid , \"long_name\" , \"layer density\" ) call nc_put_att_real ( ostate % ncid , ostate % ml_rho_varid , \"_FillValue\" , FILL_VALUE ) end if if ( cfg % out_w ) then call nc_def_var_4d ( ostate % ncid , \"w_ml\" , dimids_4d_w , ostate % ml_w_varid , dlevel ) call nc_put_att ( ostate % ncid , ostate % ml_w_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ostate % ncid , ostate % ml_w_varid , \"long_name\" , & \"diasurface (sigma-relative) transport velocity at layer interfaces\" ) call nc_put_att_real ( ostate % ncid , ostate % ml_w_varid , \"_FillValue\" , FILL_VALUE ) end if end if ! Global attributes call nc_put_att_global ( ostate % ncid , \"Conventions\" , \"CF-1.11\" ) call nc_put_att_global ( ostate % ncid , \"title\" , \"Tidal shallow water solver output\" ) call nc_put_att_global ( ostate % ncid , \"source\" , \"Rakali v0.1.0\" ) ! History — CF recommends an audit trail with timestamps call date_and_time ( values = dt_values ) write ( history_str , '(I4.4,\"-\",I2.2,\"-\",I2.2,\"T\",I2.2,\":\",I2.2,\":\",I2.2,& &\"Z: Created by Rakali v0.1.0\")' ) & dt_values ( 1 ), dt_values ( 2 ), dt_values ( 3 ), & dt_values ( 5 ), dt_values ( 6 ), dt_values ( 7 ) call nc_put_att_global ( ostate % ncid , \"history\" , trim ( history_str )) ! Optional institution if ( len_trim ( cfg % institution ) > 0 ) then call nc_put_att_global ( ostate % ncid , \"institution\" , trim ( cfg % institution )) end if call nc_enddef ( ostate % ncid ) ! Write coordinate values ng = state % grid % nghost allocate ( x_coords ( state % grid % nx_phys ), y_coords ( state % grid % ny_phys )) do i = 1 , state % grid % nx_phys x_coords ( i ) = ( real ( i , wp ) - 0.5_wp ) * state % grid % dx end do do j = 1 , state % grid % ny_phys y_coords ( j ) = ( real ( j , wp ) - 0.5_wp ) * state % grid % dy end do call nc_check ( nf90_put_var ( ostate % ncid , x_varid , x_coords ), & \"writing x coordinates\" ) call nc_check ( nf90_put_var ( ostate % ncid , y_varid , y_coords ), & \"writing y coordinates\" ) deallocate ( x_coords , y_coords ) ! Write sigma layer thicknesses (static) if ( ostate % has_nh ) then call nc_check ( nf90_put_var ( ostate % ncid , dsig_varid , state % nh % dsig ), & \"writing dsig coordinate\" ) end if if ( ostate % has_ml ) then call nc_check ( nf90_put_var ( ostate % ncid , dsig_varid , state % multilayer % dsig_ml ), & \"writing dsig_ml coordinate\" ) end if ! Write bathymetry (static field) call nc_put_var_2d ( ostate % ncid , b_varid , & state % barotropic % b ( ng + 1 : ng + state % grid % nx_phys , ng + 1 : ng + state % grid % ny_phys )) ostate % time_index = 0 end subroutine output_init","tags":"","url":"proc/output_init.html"},{"title":"output_write_snapshot – Rakali","text":"public  subroutine output_write_snapshot(ostate, state, time) Write a solution snapshot at the current time Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state type( state_t ), intent(in) :: state Current simulation state real(kind=wp), intent(in) :: time Current simulation time (s) Calls proc~~output_write_snapshot~~CallsGraph proc~output_write_snapshot output_write_snapshot buf3d buf3d proc~output_write_snapshot->buf3d debug debug proc~output_write_snapshot->debug nf90_put_var nf90_put_var proc~output_write_snapshot->nf90_put_var nf90_sync nf90_sync proc~output_write_snapshot->nf90_sync proc~nc_check nc_check proc~output_write_snapshot->proc~nc_check proc~nc_put_var_3d_slice nc_put_var_3d_slice proc~output_write_snapshot->proc~nc_put_var_3d_slice proc~nc_put_var_4d_slice nc_put_var_4d_slice proc~output_write_snapshot->proc~nc_put_var_4d_slice proc~write_tracer_snapshots write_tracer_snapshots proc~output_write_snapshot->proc~write_tracer_snapshots to_string to_string proc~output_write_snapshot->to_string error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_put_var_3d_slice->nf90_put_var proc~nc_put_var_3d_slice->proc~nc_check proc~nc_put_var_4d_slice->nf90_put_var proc~nc_put_var_4d_slice->proc~nc_check proc~write_tracer_snapshots->proc~nc_put_var_4d_slice Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~output_write_snapshot~~CalledByGraph proc~output_write_snapshot output_write_snapshot proc~finalize_output finalize_output proc~finalize_output->proc~output_write_snapshot proc~flush_snapshot flush_snapshot proc~flush_snapshot->proc~output_write_snapshot proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~finalize_output proc~driver_run_coastal->proc~flush_snapshot proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dz_inv integer, private :: i integer, private :: j integer, private :: ng integer, private :: nx integer, private :: ny integer, private :: nz real(kind=wp), private, allocatable :: vort_x (:,:) real(kind=wp), private, allocatable :: vort_y (:,:) Source Code subroutine output_write_snapshot ( ostate , state , time ) !! Write a solution snapshot at the current time type ( output_state_t ), intent ( inout ) :: ostate !! Output file state type ( state_t ), intent ( in ) :: state !! Current simulation state real ( wp ), intent ( in ) :: time !! Current simulation time (s) integer :: ng , nx , ny , i , j , nz real ( wp ) :: dz_inv real ( wp ), allocatable :: vort_x (:, :), vort_y (:, :) if ( ostate % ncid < 0 ) return ostate % time_index = ostate % time_index + 1 ng = state % grid % nghost nx = state % grid % nx_phys ny = state % grid % ny_phys ! Write time call nc_check ( nf90_put_var ( ostate % ncid , ostate % time_varid , & time , start = [ ostate % time_index ]), & \"writing time value\" ) ! Write interior solution fields call nc_put_var_3d_slice ( ostate % ncid , ostate % h_varid , & state % barotropic % h ( ng + 1 : ng + nx , ng + 1 : ng + ny ), & ostate % time_index ) call nc_put_var_3d_slice ( ostate % ncid , ostate % hu_varid , & state % barotropic % hu ( ng + 1 : ng + nx , ng + 1 : ng + ny ), & ostate % time_index ) call nc_put_var_3d_slice ( ostate % ncid , ostate % hv_varid , & state % barotropic % hv ( ng + 1 : ng + nx , ng + 1 : ng + ny ), & ostate % time_index ) ! Non-hydrostatic fields if ( ostate % has_nh ) then nz = ostate % nz call nc_put_var_4d_slice ( ostate % ncid , ostate % u_layer_varid , & state % nh % u_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz ), & ostate % time_index ) call nc_put_var_4d_slice ( ostate % ncid , ostate % v_layer_varid , & state % nh % v_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz ), & ostate % time_index ) call nc_put_var_4d_slice ( ostate % ncid , ostate % w_varid , & state % nh % w ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz + 1 ), & ostate % time_index ) call nc_put_var_4d_slice ( ostate % ncid , ostate % q_nh_varid , & state % nh % q_nh ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz ), & ostate % time_index ) ! Compute vorticity from vertical shear (host-side, nz >= 2) allocate ( vort_x ( nx , ny ), vort_y ( nx , ny )) vort_x = 0.0_wp vort_y = 0.0_wp if ( nz >= 2 ) then do j = 1 , ny do i = 1 , nx dz_inv = 1.0_wp / ( 0.5_wp * state % barotropic % h ( ng + i , ng + j ) & * ( ostate % dsig ( 1 ) + ostate % dsig ( 2 ))) vort_y ( i , j ) = ( state % nh % u_layer ( ng + i , ng + j , 2 ) & - state % nh % u_layer ( ng + i , ng + j , 1 )) * dz_inv vort_x ( i , j ) = - ( state % nh % v_layer ( ng + i , ng + j , 2 ) & - state % nh % v_layer ( ng + i , ng + j , 1 )) * dz_inv end do end do end if call nc_put_var_3d_slice ( ostate % ncid , ostate % vort_x_varid , & vort_x , ostate % time_index ) call nc_put_var_3d_slice ( ostate % ncid , ostate % vort_y_varid , & vort_y , ostate % time_index ) deallocate ( vort_x , vort_y ) end if ! Multilayer fields if ( ostate % has_ml ) then block integer :: nz_ml , ii , jj , kk , it real ( wp ), allocatable :: buf3d (:, :, :) real ( wp ) :: h_k logical :: need_vel , need_tracers nz_ml = ostate % nz_ml need_vel = ( ostate % ml_u_varid >= 0 ) need_tracers = . false . if ( allocated ( ostate % ml_tracer_varids )) then need_tracers = any ( ostate % ml_tracer_varids >= 0 ) end if if ( ostate % ml_h_layer_varid >= 0 ) then call nc_put_var_4d_slice ( ostate % ncid , ostate % ml_h_layer_varid , & state % multilayer % h_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz_ml ), & ostate % time_index ) end if ! Bed sediment reservoir (2D slice at this time index). if ( ostate % bed_sediment_varid >= 0 ) then call nc_put_var_3d_slice ( ostate % ncid , ostate % bed_sediment_varid , & state % multilayer % bed_sediment ( ng + 1 : ng + nx , ng + 1 : ng + ny ), & ostate % time_index ) end if ! Compute and write primitive variables that need h division if ( need_vel . or . need_tracers ) then allocate ( buf3d ( nx , ny , nz_ml )) if ( need_vel ) then ! u_ml do kk = 1 , nz_ml do jj = 1 , ny do ii = 1 , nx h_k = state % multilayer % h_layer ( ng + ii , ng + jj , kk ) if ( h_k > DRY_TOLERANCE ) then buf3d ( ii , jj , kk ) = state % multilayer % hu_layer ( ng + ii , ng + jj , kk ) / h_k else buf3d ( ii , jj , kk ) = 0.0_wp end if end do end do end do call nc_put_var_4d_slice ( ostate % ncid , ostate % ml_u_varid , & buf3d , ostate % time_index ) ! v_ml do kk = 1 , nz_ml do jj = 1 , ny do ii = 1 , nx h_k = state % multilayer % h_layer ( ng + ii , ng + jj , kk ) if ( h_k > DRY_TOLERANCE ) then buf3d ( ii , jj , kk ) = state % multilayer % hv_layer ( ng + ii , ng + jj , kk ) / h_k else buf3d ( ii , jj , kk ) = 0.0_wp end if end do end do end do call nc_put_var_4d_slice ( ostate % ncid , ostate % ml_v_varid , & buf3d , ostate % time_index ) end if ! Per-tracer write loop — divides hTr by h_layer to ! recover the primitive variable (PSU, degC, kg/m&#94;3, ! ...) using the same dry-cell guard as velocity. if ( need_tracers ) then call write_tracer_snapshots ( ostate , state , & nx , ny , ng , nz_ml , buf3d ) end if deallocate ( buf3d ) end if if ( ostate % ml_rho_varid >= 0 ) then call nc_put_var_4d_slice ( ostate % ncid , ostate % ml_rho_varid , & state % multilayer % rho_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz_ml ), & ostate % time_index ) end if if ( ostate % ml_w_varid >= 0 ) then call nc_put_var_4d_slice ( ostate % ncid , ostate % ml_w_varid , & state % multilayer % w_ml ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz_ml + 1 ), & ostate % time_index ) end if end block end if call nc_check ( nf90_sync ( ostate % ncid ), \"syncing output file\" ) call logger % debug ( \"Output snapshot \" // to_string ( ostate % time_index ) // & \" at t = \" // to_string ( time ) // \" s\" ) end subroutine output_write_snapshot","tags":"","url":"proc/output_write_snapshot.html"},{"title":"output_write_snapshot_from_arrays – Rakali","text":"public  subroutine output_write_snapshot_from_arrays(ostate, h, hu, hv, b, time) Write a solution snapshot from pre-copied host arrays Used by the async output path: arrays are already in host memory\n(interior cells only, no ghost cells) so we write directly.\nNH fields are not supported in this path (hydrostatic only). Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state real(kind=wp), intent(in) :: h (:,:) Water depth (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: hu (:,:) x-momentum (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: hv (:,:) y-momentum (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: b (:,:) Bathymetry (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: time Current simulation time (s) Calls proc~~output_write_snapshot_from_arrays~~CallsGraph proc~output_write_snapshot_from_arrays output_write_snapshot_from_arrays debug debug proc~output_write_snapshot_from_arrays->debug nf90_put_var nf90_put_var proc~output_write_snapshot_from_arrays->nf90_put_var nf90_sync nf90_sync proc~output_write_snapshot_from_arrays->nf90_sync proc~nc_check nc_check proc~output_write_snapshot_from_arrays->proc~nc_check proc~nc_put_var_3d_slice nc_put_var_3d_slice proc~output_write_snapshot_from_arrays->proc~nc_put_var_3d_slice to_string to_string proc~output_write_snapshot_from_arrays->to_string error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_put_var_3d_slice->nf90_put_var proc~nc_put_var_3d_slice->proc~nc_check Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: nx integer, private :: ny Source Code subroutine output_write_snapshot_from_arrays ( ostate , h , hu , hv , b , time ) !! Write a solution snapshot from pre-copied host arrays !! !! Used by the async output path: arrays are already in host memory !! (interior cells only, no ghost cells) so we write directly. !! NH fields are not supported in this path (hydrostatic only). type ( output_state_t ), intent ( inout ) :: ostate !! Output file state real ( wp ), intent ( in ) :: h (:, :) !! Water depth (nx_phys, ny_phys) — interior only real ( wp ), intent ( in ) :: hu (:, :) !! x-momentum (nx_phys, ny_phys) — interior only real ( wp ), intent ( in ) :: hv (:, :) !! y-momentum (nx_phys, ny_phys) — interior only real ( wp ), intent ( in ) :: b (:, :) !! Bathymetry (nx_phys, ny_phys) — interior only real ( wp ), intent ( in ) :: time !! Current simulation time (s) integer :: nx , ny if ( ostate % ncid < 0 ) return ostate % time_index = ostate % time_index + 1 nx = size ( h , 1 ) ny = size ( h , 2 ) ! Write time call nc_check ( nf90_put_var ( ostate % ncid , ostate % time_varid , & time , start = [ ostate % time_index ]), & \"writing time value\" ) ! Write solution fields (already interior-only) call nc_put_var_3d_slice ( ostate % ncid , ostate % h_varid , h , ostate % time_index ) call nc_put_var_3d_slice ( ostate % ncid , ostate % hu_varid , hu , ostate % time_index ) call nc_put_var_3d_slice ( ostate % ncid , ostate % hv_varid , hv , ostate % time_index ) call nc_check ( nf90_sync ( ostate % ncid ), \"syncing output file\" ) call logger % debug ( \"Output snapshot \" // to_string ( ostate % time_index ) // & \" at t = \" // to_string ( time ) // \" s\" ) end subroutine output_write_snapshot_from_arrays","tags":"","url":"proc/output_write_snapshot_from_arrays.html"},{"title":"restart_read – Rakali","text":"public  subroutine restart_read(filename, state, time, ierr, loaded_multilayer) Read a restart file and restore the simulation state Grid dimensions in the restart file must match the current state.\nThe time variable is returned so the caller can resume the time loop. Multilayer fields (h_layer, hu_layer, hv_layer, hS_layer) are\nrestored when both the file and the destination state have\nmultilayer mode active and the z dimension matches.  Files\nwithout these variables (older restart format) round-trip as\nbarotropic; mismatched cases log a warning and skip the layer\nfields, leaving them at their post-allocation values. NOTE: NH fields (u_layer, v_layer, w, q_nh) are NOT restored. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to restart file type( state_t ), intent(inout) :: state Simulation state (arrays must be pre-allocated) real(kind=wp), intent(out) :: time Simulation time from the restart file (s) integer, intent(out), optional :: ierr 0 on success, non-zero on failure (currently: 1 = grid mismatch) logical, intent(out), optional :: loaded_multilayer .true. iff multilayer fields were actually populated from\nthe file.  Callers that auto-initialise layers from the\nbarotropic state should skip that step when this is true. Calls proc~~restart_read~~CallsGraph proc~restart_read restart_read error error proc~restart_read->error info info proc~restart_read->info nf90_get_var nf90_get_var proc~restart_read->nf90_get_var nf90_inq_varid nf90_inq_varid proc~restart_read->nf90_inq_varid proc~nc_check nc_check proc~restart_read->proc~nc_check proc~nc_close nc_close proc~restart_read->proc~nc_close proc~nc_get_dim_len nc_get_dim_len proc~restart_read->proc~nc_get_dim_len proc~nc_get_var_2d nc_get_var_2d proc~restart_read->proc~nc_get_var_2d proc~nc_get_varid nc_get_varid proc~restart_read->proc~nc_get_varid proc~nc_open_read nc_open_read proc~restart_read->proc~nc_open_read to_string to_string proc~restart_read->to_string warning warning proc~restart_read->warning proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_close->proc~nc_check nf90_close nf90_close proc~nc_close->nf90_close proc~nc_get_dim_len->proc~nc_check nf90_inq_dimid nf90_inq_dimid proc~nc_get_dim_len->nf90_inq_dimid nf90_inquire_dimension nf90_inquire_dimension proc~nc_get_dim_len->nf90_inquire_dimension proc~nc_get_var_2d->nf90_get_var proc~nc_get_var_2d->proc~nc_check proc~nc_get_varid->nf90_inq_varid proc~nc_get_varid->proc~nc_check proc~nc_open_read->proc~nc_check nf90_open nf90_open proc~nc_open_read->nf90_open Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~restart_read~~CalledByGraph proc~restart_read restart_read proc~init_local_state init_local_state proc~init_local_state->proc~restart_read proc~rki_load_restart rki_load_restart proc~rki_load_restart->proc~restart_read proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: file_has_multilayer integer, private :: file_nx integer, private :: file_ny integer, private :: file_nz integer, private :: h_layer_varid integer, private :: ncid integer, private :: ng integer, private :: nx integer, private :: ny integer, private :: nz integer, private :: status integer, private :: varid Source Code subroutine restart_read ( filename , state , time , ierr , loaded_multilayer ) !! Read a restart file and restore the simulation state !! !! Grid dimensions in the restart file must match the current state. !! The time variable is returned so the caller can resume the time loop. !! !! Multilayer fields (h_layer, hu_layer, hv_layer, hS_layer) are !! restored when both the file and the destination state have !! multilayer mode active and the z dimension matches.  Files !! without these variables (older restart format) round-trip as !! barotropic; mismatched cases log a warning and skip the layer !! fields, leaving them at their post-allocation values. !! !! NOTE: NH fields (u_layer, v_layer, w, q_nh) are NOT restored. character ( len =* ), intent ( in ) :: filename !! Path to restart file type ( state_t ), intent ( inout ) :: state !! Simulation state (arrays must be pre-allocated) real ( wp ), intent ( out ) :: time !! Simulation time from the restart file (s) integer , intent ( out ), optional :: ierr !! 0 on success, non-zero on failure (currently: 1 = grid mismatch) logical , intent ( out ), optional :: loaded_multilayer !! .true. iff multilayer fields were actually populated from !! the file.  Callers that auto-initialise layers from the !! barotropic state should skip that step when this is true. integer :: ncid , varid , file_nx , file_ny , file_nz , status integer :: h_layer_varid integer :: ng , nx , ny , nz logical :: file_has_multilayer call logger % info ( \"Reading restart file: \" // trim ( filename )) if ( present ( ierr )) ierr = 0 if ( present ( loaded_multilayer )) loaded_multilayer = . false . ng = state % grid % nghost nx = state % grid % nx_phys ny = state % grid % ny_phys call nc_open_read ( filename , ncid ) ! Validate dimensions call nc_get_dim_len ( ncid , \"x\" , file_nx ) call nc_get_dim_len ( ncid , \"y\" , file_ny ) if ( file_nx /= nx . or . file_ny /= ny ) then call logger % error ( \"Restart grid mismatch: file has \" // & to_string ( file_nx ) // \" x \" // to_string ( file_ny ) // & \" but simulation expects \" // & to_string ( nx ) // \" x \" // to_string ( ny )) call nc_close ( ncid ) time = 0.0_wp if ( present ( ierr )) ierr = 1 return end if ! Read state variables into interior call nc_get_varid ( ncid , \"h\" , varid ) call nc_get_var_2d ( ncid , varid , state % barotropic % h ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_get_varid ( ncid , \"hu\" , varid ) call nc_get_var_2d ( ncid , varid , state % barotropic % hu ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_get_varid ( ncid , \"hv\" , varid ) call nc_get_var_2d ( ncid , varid , state % barotropic % hv ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_get_varid ( ncid , \"b\" , varid ) call nc_get_var_2d ( ncid , varid , state % barotropic % b ( ng + 1 : ng + nx , ng + 1 : ng + ny )) ! Multilayer fields: presence of h_layer is the marker status = nf90_inq_varid ( ncid , \"h_layer\" , h_layer_varid ) file_has_multilayer = ( status == nf90_noerr ) if ( file_has_multilayer . and . state % use_multilayer ) then nz = state % multilayer % nz_ml call nc_get_dim_len ( ncid , \"z\" , file_nz ) if ( file_nz /= nz ) then call logger % warning ( \"Restart multilayer mismatch: file has \" // & to_string ( file_nz ) // \" layers but state expects \" // & to_string ( nz ) // \"; skipping layer fields\" ) else call nc_check ( nf90_get_var ( ncid , h_layer_varid , & state % multilayer % h_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"reading restart h_layer\" ) call nc_get_varid ( ncid , \"hu_layer\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , & state % multilayer % hu_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"reading restart hu_layer\" ) call nc_get_varid ( ncid , \"hv_layer\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , & state % multilayer % hv_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"reading restart hv_layer\" ) call nc_get_varid ( ncid , \"hS_layer\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"reading restart hS_layer\" ) ! hT_layer added in the temperature PR; older restart files ! lack this variable.  Fall back to initialising hT from ! initial_temperature so they remain usable. status = nf90_inq_varid ( ncid , \"hT_layer\" , varid ) if ( status == nf90_noerr ) then call nc_check ( nf90_get_var ( ncid , varid , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"reading restart hT_layer\" ) else call logger % warning ( \"Restart file lacks hT_layer; initialising \" // & \"temperature to initial_temperature = \" // & to_string ( state % multilayer % initial_temperature ) // \" degC\" ) state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz ) = & state % multilayer % h_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz ) * & state % multilayer % initial_temperature end if if ( present ( loaded_multilayer )) loaded_multilayer = . true . end if else if ( file_has_multilayer . and . . not . state % use_multilayer ) then call logger % warning ( \"Restart file contains multilayer fields but \" // & \"state has multilayer disabled; skipping layer fields\" ) else if (. not . file_has_multilayer . and . state % use_multilayer ) then call logger % warning ( \"Restart file is barotropic but state has \" // & \"multilayer enabled; layer fields will be re-initialised by \" // & \"the caller\" ) end if ! Read time call nc_get_varid ( ncid , \"time\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , time ), \"reading restart time\" ) call nc_close ( ncid ) call logger % info ( \"Restart loaded: t = \" // to_string ( time ) // \" s\" ) end subroutine restart_read","tags":"","url":"proc/restart_read.html"},{"title":"restart_write – Rakali","text":"public  subroutine restart_write(filename, state, time) Write a restart file containing full state for later continuation Saves the barotropic state (h, hu, hv, b) plus the multilayer\narrays (h_layer, hu_layer, hv_layer, hS_layer) when\nstate%use_multilayer is true.  The presence of the h_layer\nvariable in the file is the marker for multilayer mode — old\nfiles written before this change simply lack it and round-trip\nas barotropic. NOTE: NH fields (u_layer, v_layer, w, q_nh) are NOT saved.\nA warm start from restart reverts to hydrostatic initial conditions\nfor the NH solver state. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to restart file type( state_t ), intent(in) :: state Current simulation state real(kind=wp), intent(in) :: time Current simulation time (s) Calls proc~~restart_write~~CallsGraph proc~restart_write restart_write info info proc~restart_write->info nf90_def_var nf90_def_var proc~restart_write->nf90_def_var nf90_put_var nf90_put_var proc~restart_write->nf90_put_var proc~nc_check nc_check proc~restart_write->proc~nc_check proc~nc_close nc_close proc~restart_write->proc~nc_close proc~nc_create_file nc_create_file proc~restart_write->proc~nc_create_file proc~nc_def_dim nc_def_dim proc~restart_write->proc~nc_def_dim proc~nc_def_var_2d nc_def_var_2d proc~restart_write->proc~nc_def_var_2d proc~nc_def_var_3d nc_def_var_3d proc~restart_write->proc~nc_def_var_3d proc~nc_enddef nc_enddef proc~restart_write->proc~nc_enddef proc~nc_put_att nc_put_att proc~restart_write->proc~nc_put_att proc~nc_put_att_global nc_put_att_global proc~restart_write->proc~nc_put_att_global proc~nc_put_var_2d nc_put_var_2d proc~restart_write->proc~nc_put_var_2d to_string to_string proc~restart_write->to_string error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror proc~nc_close->proc~nc_check nf90_close nf90_close proc~nc_close->nf90_close proc~nc_create_file->proc~nc_check nf90_create nf90_create proc~nc_create_file->nf90_create proc~nc_def_dim->proc~nc_check nf90_def_dim nf90_def_dim proc~nc_def_dim->nf90_def_dim proc~nc_def_var_2d->nf90_def_var proc~nc_def_var_2d->proc~nc_check nf90_def_var_deflate nf90_def_var_deflate proc~nc_def_var_2d->nf90_def_var_deflate proc~nc_def_var_3d->nf90_def_var proc~nc_def_var_3d->proc~nc_check proc~nc_def_var_3d->nf90_def_var_deflate proc~nc_enddef->proc~nc_check nf90_enddef nf90_enddef proc~nc_enddef->nf90_enddef proc~nc_put_att->proc~nc_check nf90_put_att nf90_put_att proc~nc_put_att->nf90_put_att proc~nc_put_att_global->proc~nc_check proc~nc_put_att_global->nf90_put_att proc~nc_put_var_2d->nf90_put_var proc~nc_put_var_2d->proc~nc_check Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~restart_write~~CalledByGraph proc~restart_write restart_write proc~flush_restart flush_restart proc~flush_restart->proc~restart_write proc~rki_save_restart rki_save_restart proc~rki_save_restart->proc~restart_write proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~flush_restart proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: b_varid integer, private :: dimids_2d (2) integer, private :: dimids_3d (3) integer, private :: hS_layer_varid integer, private :: hT_layer_varid integer, private :: h_layer_varid integer, private :: h_varid integer, private :: hu_layer_varid integer, private :: hu_varid integer, private :: hv_layer_varid integer, private :: hv_varid integer, private :: ncid integer, private :: ng integer, private :: nx integer, private :: ny integer, private :: nz integer, private :: time_varid integer, private :: x_dimid integer, private :: y_dimid integer, private :: z_dimid Source Code subroutine restart_write ( filename , state , time ) !! Write a restart file containing full state for later continuation !! !! Saves the barotropic state (h, hu, hv, b) plus the multilayer !! arrays (h_layer, hu_layer, hv_layer, hS_layer) when !! state%use_multilayer is true.  The presence of the h_layer !! variable in the file is the marker for multilayer mode — old !! files written before this change simply lack it and round-trip !! as barotropic. !! !! NOTE: NH fields (u_layer, v_layer, w, q_nh) are NOT saved. !! A warm start from restart reverts to hydrostatic initial conditions !! for the NH solver state. character ( len =* ), intent ( in ) :: filename !! Path to restart file type ( state_t ), intent ( in ) :: state !! Current simulation state real ( wp ), intent ( in ) :: time !! Current simulation time (s) integer :: ncid , x_dimid , y_dimid , z_dimid integer :: h_varid , hu_varid , hv_varid , b_varid , time_varid integer :: h_layer_varid , hu_layer_varid , hv_layer_varid , hS_layer_varid , hT_layer_varid integer :: dimids_2d ( 2 ), dimids_3d ( 3 ) integer :: ng , nx , ny , nz call logger % info ( \"Writing restart file: \" // trim ( filename )) ng = state % grid % nghost nx = state % grid % nx_phys ny = state % grid % ny_phys call nc_create_file ( filename , ncid ) ! Dimensions call nc_def_dim ( ncid , \"x\" , nx , x_dimid ) call nc_def_dim ( ncid , \"y\" , ny , y_dimid ) dimids_2d = [ x_dimid , y_dimid ] ! Variables call nc_def_var_2d ( ncid , \"h\" , dimids_2d , h_varid ) call nc_def_var_2d ( ncid , \"hu\" , dimids_2d , hu_varid ) call nc_def_var_2d ( ncid , \"hv\" , dimids_2d , hv_varid ) call nc_def_var_2d ( ncid , \"b\" , dimids_2d , b_varid ) ! Multilayer arrays (only if active) if ( state % use_multilayer ) then nz = state % multilayer % nz_ml call nc_def_dim ( ncid , \"z\" , nz , z_dimid ) dimids_3d = [ x_dimid , y_dimid , z_dimid ] call nc_def_var_3d ( ncid , \"h_layer\" , dimids_3d , h_layer_varid ) call nc_def_var_3d ( ncid , \"hu_layer\" , dimids_3d , hu_layer_varid ) call nc_def_var_3d ( ncid , \"hv_layer\" , dimids_3d , hv_layer_varid ) call nc_def_var_3d ( ncid , \"hS_layer\" , dimids_3d , hS_layer_varid ) call nc_def_var_3d ( ncid , \"hT_layer\" , dimids_3d , hT_layer_varid ) end if ! Scalar time call nc_check ( nf90_def_var ( ncid , \"time\" , nf90_double , time_varid ), & \"defining restart time\" ) ! Metadata attributes call nc_put_att ( ncid , h_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , hu_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , hv_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , b_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , time_varid , \"units\" , \"seconds since simulation start\" ) if ( state % use_multilayer ) then call nc_put_att ( ncid , h_layer_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , hu_layer_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , hv_layer_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , hS_layer_varid , \"units\" , \"m PSU\" ) call nc_put_att ( ncid , hT_layer_varid , \"units\" , \"m degC\" ) end if call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.11\" ) call nc_put_att_global ( ncid , \"title\" , \"Tidal restart file\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali v0.1.0\" ) call nc_put_att_global ( ncid , \"dx\" , to_string ( state % grid % dx )) call nc_put_att_global ( ncid , \"dy\" , to_string ( state % grid % dy )) call nc_put_att_global ( ncid , \"nghost\" , to_string ( state % grid % nghost )) call nc_enddef ( ncid ) ! Write data (interior only) call nc_put_var_2d ( ncid , h_varid , state % barotropic % h ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_put_var_2d ( ncid , hu_varid , state % barotropic % hu ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_put_var_2d ( ncid , hv_varid , state % barotropic % hv ( ng + 1 : ng + nx , ng + 1 : ng + ny )) call nc_put_var_2d ( ncid , b_varid , state % barotropic % b ( ng + 1 : ng + nx , ng + 1 : ng + ny )) if ( state % use_multilayer ) then call nc_check ( nf90_put_var ( ncid , h_layer_varid , & state % multilayer % h_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"writing restart h_layer\" ) call nc_check ( nf90_put_var ( ncid , hu_layer_varid , & state % multilayer % hu_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"writing restart hu_layer\" ) call nc_check ( nf90_put_var ( ncid , hv_layer_varid , & state % multilayer % hv_layer ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"writing restart hv_layer\" ) call nc_check ( nf90_put_var ( ncid , hS_layer_varid , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"writing restart hS_layer\" ) call nc_check ( nf90_put_var ( ncid , hT_layer_varid , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr ( ng + 1 : ng + nx , ng + 1 : ng + ny , 1 : nz )), & \"writing restart hT_layer\" ) end if call nc_check ( nf90_put_var ( ncid , time_varid , time ), \"writing restart time\" ) call nc_close ( ncid ) call logger % info ( \"Restart file written at t = \" // to_string ( time ) // \" s\" ) end subroutine restart_write","tags":"","url":"proc/restart_write.html"},{"title":"write_ascii_output – Rakali","text":"public  subroutine write_ascii_output(s, output_dir) Write the final water depth field to an ASCII file Arguments Type Intent Optional Attributes Name type( state_t ), intent(in) :: s character(len=*), intent(in) :: output_dir Calls proc~~write_ascii_output~~CallsGraph proc~write_ascii_output write_ascii_output error error proc~write_ascii_output->error info info proc~write_ascii_output->info warning warning proc~write_ascii_output->warning Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~write_ascii_output~~CalledByGraph proc~write_ascii_output write_ascii_output proc~log_final_diagnostics log_final_diagnostics proc~log_final_diagnostics->proc~write_ascii_output proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~log_final_diagnostics proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial character(len=512), private :: filename integer, private :: i character(len=256), private :: io_msg integer, private :: io_stat integer, private :: io_unit integer, private :: j Source Code subroutine write_ascii_output ( s , output_dir ) !! Write the final water depth field to an ASCII file type ( state_t ), intent ( in ) :: s character ( len =* ), intent ( in ) :: output_dir integer :: i , j , io_unit , io_stat character ( len = 256 ) :: io_msg character ( len = 512 ) :: filename filename = trim ( output_dir ) // \"/final_h.dat\" open ( newunit = io_unit , file = trim ( filename ), status = \"replace\" , & action = \"write\" , iostat = io_stat , iomsg = io_msg ) if ( io_stat /= 0 ) then call logger % warning ( \"Could not open output file \" // & trim ( filename ) // \": \" // trim ( io_msg )) ! Fall back to writing to current directory filename = \"final_h.dat\" open ( newunit = io_unit , file = trim ( filename ), status = \"replace\" , & action = \"write\" , iostat = io_stat , iomsg = io_msg ) if ( io_stat /= 0 ) then call logger % error ( \"Could not write output file: \" // trim ( io_msg )) return end if end if ! Write header write ( io_unit , \"(A)\" ) \"# x  h\" ! Write 1D profile along centreline (j = middle) j = s % grid % nghost + s % grid % ny_phys / 2 + 1 do i = s % grid % nghost + 1 , s % grid % nx_total - s % grid % nghost write ( io_unit , \"(2ES20.12)\" ) & ( real ( i - s % grid % nghost , wp ) - 0.5_wp ) * s % grid % dx , s % barotropic % h ( i , j ) end do close ( io_unit ) call logger % info ( \"Output written to: \" // trim ( filename )) end subroutine write_ascii_output","tags":"","url":"proc/write_ascii_output.html"},{"title":"define_tracer_outputs – Rakali","text":"private  subroutine define_tracer_outputs(ostate, state, cfg, dimids_4d, dlevel) Define one NetCDF variable per entry in state%multilayer%tracers(:) , using each tracer’s identity\nstrings ( name , long_name , units , standard_name ) so\nthe registry alone determines what gets written.  Sets ostate%ml_tracer_varids(it) to -1 when the tracer is\ngated off (the legacy cfg%out_salinity / cfg%out_temperature switches still apply for those two\nbuilt-in tracers; new tracers default to write-enabled). Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate type( state_t ), intent(in) :: state type( config_t ), intent(in) :: cfg integer, intent(in) :: dimids_4d (4) integer, intent(in) :: dlevel Calls proc~~define_tracer_outputs~~CallsGraph proc~define_tracer_outputs define_tracer_outputs proc~nc_def_var_4d nc_def_var_4d proc~define_tracer_outputs->proc~nc_def_var_4d proc~nc_put_att nc