, and reused for every kernel call so the pure kernels\nnever allocate.  Each group is guarded by a want_* flag in tracer_scratch_ensure , so a PPM-only run does not allocate the\nupwind snapshot and vice-versa. Components Type Visibility Attributes Name Initial real(kind=wp), public, allocatable :: adv_hTr_snap (:,:,:) real(kind=wp), public, allocatable :: hdiff_hTr_pre (:,:,:) real(kind=wp), public, allocatable :: ppm_ql_x (:,:,:) real(kind=wp), public, allocatable :: ppm_ql_y (:,:,:) real(kind=wp), public, allocatable :: ppm_qr_x (:,:,:) real(kind=wp), public, allocatable :: ppm_qr_y (:,:,:) real(kind=wp), public, allocatable :: ppm_tr_snap (:,:,:) real(kind=wp), public, allocatable :: weno_tr_snap (:,:,:) Source Code type :: tracer_scratch_t !! Persistent per-kernel scratch owned by the caller (the solver, or !! a unit test).  Allocated once up front to (nx,ny,nz), device- !! attached, and reused for every kernel call so the `pure` kernels !! never allocate.  Each group is guarded by a `want_*` flag in !! `tracer_scratch_ensure`, so a PPM-only run does not allocate the !! upwind snapshot and vice-versa. ! ml_advect_tracer (first-order upwind) — Jacobi neighbour snapshot. real ( wp ), allocatable :: adv_hTr_snap (:, :, :) ! ml_advect_tracer_ppm — reconstruction snapshots + limited edges. real ( wp ), allocatable :: ppm_tr_snap (:, :, :) real ( wp ), allocatable :: ppm_ql_x (:, :, :) real ( wp ), allocatable :: ppm_qr_x (:, :, :) real ( wp ), allocatable :: ppm_ql_y (:, :, :) real ( wp ), allocatable :: ppm_qr_y (:, :, :) ! ml_advect_tracer_weno (WENO5/7/9 reconstruction) — concentration snapshot. real ( wp ), allocatable :: weno_tr_snap (:, :, :) ! ml_horizontal_diffusion_tracer — Jacobi pre-step snapshot. real ( wp ), allocatable :: hdiff_hTr_pre (:, :, :) end type tracer_scratch_t","tags":"","url":"type/tracer_scratch_t.html"},{"title":"unstr_barotropic_state_t – Rakali ","text":"type, public :: unstr_barotropic_state_t Centroid + edge conserved variables and the per-step workspace. Inherited by type~~unstr_barotropic_state_t~~InheritedByGraph type~unstr_barotropic_state_t unstr_barotropic_state_t type~unstr_state_t unstr_state_t type~unstr_state_t->type~unstr_barotropic_state_t barotropic type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public, allocatable :: bed_cv (:) Bed elevation at the centroid (m). Static after init. real(kind=wp), public, allocatable :: bed_ev (:,:) Bed at edge midpoints (= stage_ev - height_ev for well-balancing). real(kind=wp), public, allocatable :: chapman_eta_old (:,:) Persistent previous-step eta for BC_CHAPMAN . Shape (EDGES_PER_TRI, ncells_total) . Allocated unconditionally\nso the array is GPU-mappable regardless of whether Chapman\nis active on a given mesh. real(kind=wp), public :: coriolis_f = 0.0_wp Coriolis parameter f (1/s), typically 2 Omega sin(lat). Uniform.\nConsumed per-layer by ml_apply_coriolis_unstr (multilayer path). real(kind=wp), public, allocatable :: height_cv (:) Water depth h = max(stage - bed, 0) (m). Recomputed each step. real(kind=wp), public, allocatable :: height_ev (:,:) Water depth at edge midpoints. real(kind=wp), public :: manning_n = 0.0_wp Manning roughness coefficient (s/m&#94;{1/3}). Uniform. real(kind=wp), public, allocatable :: mass_flux_e (:,:) Net mass inflow to this cell across edge i, written by the\ncentral-upwind flux kernel and reused by ml_advect_tracer_unstr for CWC-consistent advection.\nShape (3, ncells_total) , units m&#94;3/s, positive INTO the cell. real(kind=wp), public, allocatable :: max_speed (:) Maximum wave speed seen on any edge of this cell during the\nlast flux pass. real(kind=wp), public, allocatable :: stage_backup (:) real(kind=wp), public, allocatable :: stage_cv (:) Stage w = h + b at the centroid (m). real(kind=wp), public, allocatable :: stage_eu (:) d(stage)/dt accumulator (cell-centric, no scatter). real(kind=wp), public, allocatable :: stage_ev (:,:) Stage at edge midpoints, after second-order extrapolation. real(kind=wp), public :: wind_tau_x = 0.0_wp Spatially-uniform wind stress in x (Pa). real(kind=wp), public :: wind_tau_y = 0.0_wp Spatially-uniform wind stress in y (Pa). real(kind=wp), public, allocatable :: x_centroid_work (:) Stash for original xmom during velocity-form reconstruction. real(kind=wp), public, allocatable :: xmom_backup (:) real(kind=wp), public, allocatable :: xmom_cv (:) x-momentum h*u at the centroid (m&#94;2/s). real(kind=wp), public, allocatable :: xmom_eu (:) d(xmom)/dt accumulator. real(kind=wp), public, allocatable :: xmom_ev (:,:) x-momentum at edge midpoints. real(kind=wp), public, allocatable :: xmom_siu (:) Semi-implicit increment for x-momentum (Manning friction). real(kind=wp), public, allocatable :: y_centroid_work (:) Stash for original ymom during velocity-form reconstruction. real(kind=wp), public, allocatable :: ymom_backup (:) real(kind=wp), public, allocatable :: ymom_cv (:) y-momentum h*v at the centroid (m&#94;2/s). real(kind=wp), public, allocatable :: ymom_eu (:) d(ymom)/dt accumulator. real(kind=wp), public, allocatable :: ymom_ev (:,:) y-momentum at edge midpoints. real(kind=wp), public, allocatable :: ymom_siu (:) Semi-implicit increment for y-momentum. Type-Bound Procedures procedure, public, non_overridable :: destroy => unstr_barotropic_destroy private  subroutine unstr_barotropic_destroy (this) Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this procedure, public, non_overridable :: enter_data => unstr_barotropic_enter_data private  subroutine unstr_barotropic_enter_data (this) Map the barotropic allocatables onto the device (the parent\nvalue-type member rides over with copyin(state) ; only the inner\narrays need explicit attaches).  Read+write fields use copyin ,\npure-workspace fields use create . Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this procedure, public, non_overridable :: exit_data => unstr_barotropic_exit_data private  subroutine unstr_barotropic_exit_data (this) Reverse of enter_data — copy out host-visible fields, drop\npure scratch.  Components first, parent last (handled by the\ncaller state_unstr_exit_data ). Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this procedure, public, non_overridable :: init => unstr_barotropic_init private  subroutine unstr_barotropic_init (this, mesh) Allocate every array at the cell counts in mesh . All arrays\nare zero-initialised.  Calling on an already-initialised\nsub-object is safe – it destroys first. Arguments Type Intent Optional Attributes Name class( unstr_barotropic_state_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh Source Code type :: unstr_barotropic_state_t !! Centroid + edge conserved variables and the per-step workspace. ! ----- centroid conserved variables ----- real ( wp ), allocatable :: stage_cv (:) !! Stage w = h + b at the centroid (m). real ( wp ), allocatable :: xmom_cv (:) !! x-momentum h*u at the centroid (m&#94;2/s). real ( wp ), allocatable :: ymom_cv (:) !! y-momentum h*v at the centroid (m&#94;2/s). ! ----- bathymetry and derived height ----- real ( wp ), allocatable :: bed_cv (:) !! Bed elevation at the centroid (m). Static after init. real ( wp ), allocatable :: height_cv (:) !! Water depth h = max(stage - bed, 0) (m). Recomputed each step. ! ----- reconstructed values at edge midpoints (3, ncells_total) ----- real ( wp ), allocatable :: stage_ev (:, :) !! Stage at edge midpoints, after second-order extrapolation. real ( wp ), allocatable :: xmom_ev (:, :) !! x-momentum at edge midpoints. real ( wp ), allocatable :: ymom_ev (:, :) !! y-momentum at edge midpoints. real ( wp ), allocatable :: bed_ev (:, :) !! Bed at edge midpoints (= stage_ev - height_ev for well-balancing). real ( wp ), allocatable :: height_ev (:, :) !! Water depth at edge midpoints. real ( wp ), allocatable :: chapman_eta_old (:, :) !! Persistent previous-step eta for `BC_CHAPMAN`. Shape !! `(EDGES_PER_TRI, ncells_total)`. Allocated unconditionally !! so the array is GPU-mappable regardless of whether Chapman !! is active on a given mesh. ! ----- explicit update accumulators ----- real ( wp ), allocatable :: stage_eu (:) !! d(stage)/dt accumulator (cell-centric, no scatter). real ( wp ), allocatable :: xmom_eu (:) !! d(xmom)/dt accumulator. real ( wp ), allocatable :: ymom_eu (:) !! d(ymom)/dt accumulator. ! ----- semi-implicit friction update ----- real ( wp ), allocatable :: xmom_siu (:) !! Semi-implicit increment for x-momentum (Manning friction). real ( wp ), allocatable :: ymom_siu (:) !! Semi-implicit increment for y-momentum. ! ----- RK2 backup of U&#94;n at the start of each step ----- real ( wp ), allocatable :: stage_backup (:) real ( wp ), allocatable :: xmom_backup (:) real ( wp ), allocatable :: ymom_backup (:) ! ----- velocity-form extrapolation scratch ----- real ( wp ), allocatable :: x_centroid_work (:) !! Stash for original xmom during velocity-form reconstruction. real ( wp ), allocatable :: y_centroid_work (:) !! Stash for original ymom during velocity-form reconstruction. ! ----- per-cell max wave speed for CFL ----- real ( wp ), allocatable :: max_speed (:) !! Maximum wave speed seen on any edge of this cell during the !! last flux pass. ! ----- per-edge barotropic mass flux ----- real ( wp ), allocatable :: mass_flux_e (:, :) !! Net mass inflow to this cell across edge i, written by the !! central-upwind flux kernel and reused by !! `ml_advect_tracer_unstr` for CWC-consistent advection. !! Shape `(3, ncells_total)`, units m&#94;3/s, positive INTO the cell. ! ----- scalar physics knobs ----- real ( wp ) :: manning_n = 0.0_wp !! Manning roughness coefficient (s/m&#94;{1/3}). Uniform. real ( wp ) :: wind_tau_x = 0.0_wp !! Spatially-uniform wind stress in x (Pa). real ( wp ) :: wind_tau_y = 0.0_wp !! Spatially-uniform wind stress in y (Pa). real ( wp ) :: coriolis_f = 0.0_wp !! Coriolis parameter f (1/s), typically 2*Omega*sin(lat). Uniform. !! Consumed per-layer by `ml_apply_coriolis_unstr` (multilayer path). contains procedure , non_overridable :: init => unstr_barotropic_init procedure , non_overridable :: destroy => unstr_barotropic_destroy procedure , non_overridable :: enter_data => unstr_barotropic_enter_data procedure , non_overridable :: exit_data => unstr_barotropic_exit_data end type unstr_barotropic_state_t","tags":"","url":"type/unstr_barotropic_state_t.html"},{"title":"unstr_tracer_t – Rakali ","text":"type, public :: unstr_tracer_t Inherited by type~~unstr_tracer_t~~InheritedByGraph type~unstr_tracer_t unstr_tracer_t type~unstr_multilayer_state_t unstr_multilayer_state_t type~unstr_multilayer_state_t->type~unstr_tracer_t tracers type~unstr_state_t unstr_state_t type~unstr_state_t->type~unstr_multilayer_state_t multilayer type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial real(kind=wp), public :: bc_ext (MAX_BC_GROUPS) = 0.0_wp Per-BC-group inflow concentration consumed by the advection\nkernel ( ml_advect_tracer{,_muscl}_unstr ).  For salinity /\ntemperature the solver syncs this from bc_S_ext / bc_T_ext each step; a registered passive tracer gets its scalar tr_inflow broadcast across all groups at registration.  Read\nhost-side (copied into the kernel-local before the device\nloop), so it needs no separate device mapping. logical, public :: do_clamp = .true. logical, public :: do_horizontal_advection = .true. logical, public :: do_horizontal_diffusion = .true. logical, public :: do_vertical_diffusion = .true. logical, public :: do_vertical_exchange = .true. real(kind=wp), public :: eos_coeff = 0.0_wp real(kind=wp), public :: eos_ref = 0.0_wp real(kind=wp), public, allocatable :: hTr (:,:) real(kind=wp), public, allocatable :: hTr0 (:,:) real(kind=wp), public :: hdiff_kappa = 0.0_wp Horizontal Laplacian diffusivity (m&#94;2/s) real(kind=wp), public :: kappa_bg = 0.0_wp Background vertical diffusivity (m&#94;2/s) character(len=64), public :: long_name = \"\" character(len=32), public :: name = \"\" character(len=64), public :: standard_name = \"\" CF-1.11 standard_name (empty string => no attribute written). real(kind=wp), public :: tr_inflow = 0.0_wp BC inflow concentration for BC_INFLOW / BC_DISCHARGE real(kind=wp), public :: tr_init = 0.0_wp Uniform initial concentration (set by init from cfg) real(kind=wp), public :: tr_max = huge(1.0_wp) Physical upper clamp bound real(kind=wp), public :: tr_min = -huge(1.0_wp) Physical lower clamp bound character(len=16), public :: units = \"\" Type-Bound Procedures procedure, public, non_overridable :: destroy => unstr_tracer_destroy private  subroutine unstr_tracer_destroy (this) Arguments Type Intent Optional Attributes Name class( unstr_tracer_t ), intent(inout) :: this procedure, public, non_overridable :: init => unstr_tracer_init private  subroutine unstr_tracer_init (this, mesh, nz) Allocate hTr / hTr0 at the multilayer mesh size, zero-filled.\nCaller is responsible for populating the prognostic field\n(e.g. hTr = h_layer * tr_init ) after layer thicknesses are set. Arguments Type Intent Optional Attributes Name class( unstr_tracer_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz Source Code type :: unstr_tracer_t ! Identity (used for output/config lookup).  Mirrors structured ! `tracer_t`: output loops over the registry and writes these ! verbatim onto the NetCDF variable. character ( len = 32 ) :: name = \"\" character ( len = 64 ) :: long_name = \"\" character ( len = 16 ) :: units = \"\" character ( len = 64 ) :: standard_name = \"\" !! CF-1.11 standard_name (empty string => no attribute written). ! Prognostic field and RK2 save (nz, ncells_total) real ( wp ), allocatable :: hTr (:, :) real ( wp ), allocatable :: hTr0 (:, :) ! Scalar config real ( wp ) :: tr_init = 0.0_wp !! Uniform initial concentration (set by init from cfg) real ( wp ) :: tr_inflow = 0.0_wp !! BC inflow concentration for BC_INFLOW / BC_DISCHARGE real ( wp ) :: tr_min = - huge ( 1.0_wp ) !! Physical lower clamp bound real ( wp ) :: tr_max = huge ( 1.0_wp ) !! Physical upper clamp bound real ( wp ) :: kappa_bg = 0.0_wp !! Background vertical diffusivity (m&#94;2/s) real ( wp ) :: hdiff_kappa = 0.0_wp !! Horizontal Laplacian diffusivity (m&#94;2/s) real ( wp ) :: bc_ext ( MAX_BC_GROUPS ) = 0.0_wp !! Per-BC-group inflow concentration consumed by the advection !! kernel (`ml_advect_tracer{,_muscl}_unstr`).  For salinity / !! temperature the solver syncs this from `bc_S_ext` / `bc_T_ext` !! each step; a registered passive tracer gets its scalar !! `tr_inflow` broadcast across all groups at registration.  Read !! host-side (copied into the kernel-local before the device !! loop), so it needs no separate device mapping. ! Linear EOS contribution: rho_anomaly += eos_coeff * (Tr - eos_ref) ! Salinity:    eos_coeff = +beta_S,  eos_ref = S_ref ! Temperature: eos_coeff = -alpha_T, eos_ref = T_ref ! Passive scalar: eos_coeff = 0 real ( wp ) :: eos_coeff = 0.0_wp real ( wp ) :: eos_ref = 0.0_wp ! Pipeline opt-outs (skip work for diagnostic/passive tracers) logical :: do_horizontal_advection = . true . logical :: do_vertical_exchange = . true . logical :: do_vertical_diffusion = . true . logical :: do_horizontal_diffusion = . true . logical :: do_clamp = . true . contains procedure , non_overridable :: init => unstr_tracer_init procedure , non_overridable :: destroy => unstr_tracer_destroy end type unstr_tracer_t","tags":"","url":"type/unstr_tracer_t.html"},{"title":"gauge_unstr_t – Rakali ","text":"type, public :: gauge_unstr_t Manages gauge point output Inherited by type~~gauge_unstr_t~~InheritedByGraph type~gauge_unstr_t gauge_unstr_t type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~gauge_unstr_t gauges Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial integer, public, allocatable :: cell_id (:) triangle containing each local gauge integer, public :: eta_varid = -1 real(kind=wp), public, allocatable :: gauge_x (:) x-coordinate of local gauges real(kind=wp), public, allocatable :: gauge_y (:) y-coordinate of local gauges real(kind=wp), public, allocatable :: lam1 (:) barycentric weight for vertex 1 real(kind=wp), public, allocatable :: lam2 (:) barycentric weight for vertex 2 real(kind=wp), public, allocatable :: lam3 (:) barycentric weight for vertex 3 i