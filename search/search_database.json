ss so the diffusive flux above is !! computed from un-redistributed tracer (matches the ocean order !! of vdiff-then-nonlocal).  gamma = 0 at the bed and free !! surface ⇒ the divergence conserves the column integral. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 , nu_max , kappa_S_bg , kappa_T_bg , ri_alpha real ( wp ), intent ( in ) :: cs_nonlocal , cp real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_star ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: buoy_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: bl_depth ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , h_col real ( wp ) :: s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom real ( wp ) :: kappa_S , kappa_T , flux_S , flux_T real ( wp ) :: h_b , b_0 , us , wstar3 , w_star , w_s real ( wp ) :: h_top , s_top , f_t_kin , f_s_kin real ( wp ) :: d_below , d_iface , sigma , g_shape , nu_kpp , gamma_T , gamma_S logical :: destabilizing nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , h_col , & s_k , s_k1 , t_k , t_k1 , du , dv , drho , Ri , denom , & kappa_S , kappa_T , flux_S , flux_T , h_b , b_0 , us , & wstar3 , w_star , w_s , h_top , s_top , f_t_kin , f_s_kin , & d_below , d_iface , sigma , g_shape , nu_kpp , gamma_T , gamma_S , & destabilizing ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then h_b = bl_depth ( i , j ) b_0 = buoy_flux ( i , j ) us = u_star ( i , j ) wstar3 = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3 ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) destabilizing = ( b_0 < 0.0_wp ) ! ---- diffusive flux (PP81 cubic + KPP overlay) ---- d_below = 0.0_wp do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL ) then if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k s_k = hS_layer ( i , j , k ) / h_k t_k = hT_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp s_k = 0.0_wp t_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = hu_layer ( i , j , k + 1 ) / h_k1 v_k1 = hv_layer ( i , j , k + 1 ) / h_k1 s_k1 = hS_layer ( i , j , k + 1 ) / h_k1 t_k1 = hT_layer ( i , j , k + 1 ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp s_k1 = 0.0_wp t_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = rho_layer ( i , j , k ) - rho_layer ( i , j , k + 1 ) Ri = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + ri_alpha * Ri kappa_S = nu_max / ( denom * denom * denom ) + kappa_S_bg kappa_T = nu_max / ( denom * denom * denom ) + kappa_T_bg if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) nu_kpp = h_b * w_s * g_shape if ( nu_kpp > kappa_S ) kappa_S = nu_kpp if ( nu_kpp > kappa_T ) kappa_T = nu_kpp end if if ( kappa_S * dt > 0.5_wp * h_avg * h_avg ) kappa_S = 0.5_wp * h_avg * h_avg / dt if ( kappa_T * dt > 0.5_wp * h_avg * h_avg ) kappa_T = 0.5_wp * h_avg * h_avg / dt flux_S = kappa_S * ( s_k1 - s_k ) / h_avg * dt flux_T = kappa_T * ( t_k1 - t_k ) / h_avg * dt hS_layer ( i , j , k ) = hS_layer ( i , j , k ) + flux_S hS_layer ( i , j , k + 1 ) = hS_layer ( i , j , k + 1 ) - flux_S hT_layer ( i , j , k ) = hT_layer ( i , j , k ) + flux_T hT_layer ( i , j , k + 1 ) = hT_layer ( i , j , k + 1 ) - flux_T end if end do ! ---- non-local counter-gradient transport ---- if ( destabilizing . and . w_s > 0.0_wp . and . h_b > 0.0_wp ) then h_top = h_layer ( i , j , nz ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( i , j , nz ) / h_top else s_top = 0.0_wp end if f_t_kin = heat_flux ( i , j ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( i , j ) * s_top d_below = 0.0_wp do k = 1 , nz - 1 h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below if ( h_avg > VANISHING_LAYER_TOL . and . & h_k > VANISHING_LAYER_TOL . and . & h_k1 > VANISHING_LAYER_TOL . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) gamma_T = cs_nonlocal * g_shape * f_t_kin gamma_S = cs_nonlocal * g_shape * f_s_kin hT_layer ( i , j , k ) = hT_layer ( i , j , k ) + dt * gamma_T hT_layer ( i , j , k + 1 ) = hT_layer ( i , j , k + 1 ) - dt * gamma_T hS_layer ( i , j , k ) = hS_layer ( i , j , k ) + dt * gamma_S hS_layer ( i , j , k + 1 ) = hS_layer ( i , j , k + 1 ) - dt * gamma_S end if end do end if end if end do end subroutine ml_kpp_diffusion_tracers","tags":"","url":"proc/ml_kpp_diffusion_tracers.html"},{"title":"ml_kpp_viscosity – Rakali","text":"public pure subroutine ml_kpp_viscosity(h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, u_star, buoy_flux, bl_depth, grid, nz