console_stats module~rki_forcing rki_forcing module~rki_driver->module~rki_forcing module~rki_gauges rki_gauges module~rki_driver->module~rki_gauges module~rki_driver->module~rki_init module~rki_nesting rki_nesting module~rki_driver->module~rki_nesting module~rki_driver->module~rki_output module~rki_driver->module~rki_solver module~rki_flux_dump rki_flux_dump module~rki_flux_dump->module~rki_state module~rki_forcing->module~rki_state module~rki_gauges->module~rki_state module~rki_handle->module~rki_state module~rki_init->module~rki_state module~rki_nesting->module~rki_state module~rki_output->module~rki_state module~rki_solver->module~rki_state module~rki_api_unstr rki_api_unstr module~rki_api_unstr->module~rki_handle Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, public, parameter :: TRACER_BUDGET_HEAT = 1 Tracer feeds the OCEAN path’s heat_budget_* accumulators. integer, public, parameter :: TRACER_BUDGET_NONE = 0 No conservation-budget contributor slot (passive tracers, ideal\nage, pseudo-salt). integer, public, parameter :: TRACER_BUDGET_SALT = 2 Tracer feeds the OCEAN path’s salt_budget_* accumulators. Derived Types type, public :: tracer_t Components Type Visibility Attributes Name Initial integer, public :: budget_id = TRACER_BUDGET_NONE Which conservation-budget contributor slot this tracer’s\nkernels fill on the OCEAN path: NONE (no budget — passive\ntracers, ideal age, pseudo-salt), HEAT ( heat_budget_* ) or\nSALT ( salt_budget_* ).  Read HOST-side only, at the seven\nbudget dispatch blocks; never dereferenced inside a device\nloop.  Unused on the coastal paths (no budget slots there) —\nleft at NONE. logical, public :: do_clamp = .true. logical, public :: do_horizontal_advection = .true. logical, public :: do_horizontal_diffusion = .true. logical, public :: do_vertical_diffusion = .true. logical, public :: do_vertical_exchange = .true. real(kind=wp), public :: eos_coeff = 0.0_wp real(kind=wp), public :: eos_ref = 0.0_wp real(kind=wp), public, allocatable :: hTr (:,:,:) real(kind=wp), public, allocatable :: hTr0 (:,:,:) real(kind=wp), public :: hdiff_kappa = 0.0_wp Horizontal Laplacian diffusivity (m&#94;2/s) real(kind=wp), public :: kappa_bg = 0.0_wp Background vertical diffusivity (m&#94;2/s) character(len=64), public :: long_name = \"\" character(len=32), public :: name = \"\" character(len=64), public :: standard_name = \"\" CF-1.11 standard_name (e.g. “sea_water_salinity”).  Empty\nstring => no standard_name attribute is written. real(kind=wp), public :: tr_inflow = 0.0_wp BC inflow concentration for BC_INFLOW / BC_DISCHARGE real(kind=wp), public :: tr_init = 0.0_wp Uniform initial concentration (set by init from cfg) real(kind=wp), public :: tr_max = huge(1.0_wp) Physical upper clamp bound real(kind=wp), public :: tr_min = -huge(1.0_wp) Physical lower clamp bound character(len=16), public :: units = \"\" Type-Bound Procedures procedure, public, non_overridable :: bytes => tracer_bytes procedure, public, non_overridable :: destroy => tracer_destroy procedure, public, non_overridable :: init => tracer_init Functions private pure function tracer_bytes (this) result(nbytes) Counted allocatable footprint of one tracer (hTr + RK2 save). Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(in) :: this Return Value integer(kind=int64) Subroutines private  subroutine tracer_destroy (this) Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(inout) :: this private  subroutine tracer_init (this, grid, nz) Allocate hTr / hTr0 at the multilayer grid size, zero-filled.\nCaller is responsible for populating the prognostic field\n(e.g. hTr = h_layer * tr_init ) after layer thicknesses are set. Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz","tags":"","url":"module/rki_tracer.html"},{"title":"rki_si_unstr_wetdry – Rakali","text":"Casulli (2009) subgrid wetting/drying for the unstructured\nsemi-implicit free-surface mode — ported per-cell ( (n_sub, ncells) sub-bottom\nlayout) exactly as the prototype confirmed mesh-agnostic\n( si_unstr_proto.py study 2: V/a/Newton + the edge sill rule ran\nUNCHANGED on triangles).  Replaces the linear solver’s constant 1.0 cell-mass term by the exact wetted-volume function per unit\ncell area (depth units): v_c(eta) = (1/n_sub) sum_s max(eta - b_c&#94;(s), 0)   (mean wet depth)\n  a_c(eta) = v’_c(eta) in [0,1]                      (wet fraction) driving a PLAIN Newton outer loop (V convex => monotone finite\nconvergence) around the SAME area-weighted TPFA CG, with the\noperator’s mass term replaced per cell by a(eta) + floor (the mass_diag argument already threaded through si_unstr_apply_helmholtz / si_unstr_cg_solve ). FROZEN edge rule (Casulli, rule R1) — the GATED-MEAN conveyance:\n  Hf_e = 0.5 (max(eta_L-b_L,0) + max(eta_R-b_R,0))\n         gated to 0 unless  max(eta_L,eta_R) > max(b_L,b_R)\nbuilt ONCE from eta&#94;n and held over the step, shared by the\noperator, back-substitution and RHS (R2).  Where both cells are wet\nthis reduces EXACTLY to the linear edge depth 0.5 (h_L+h_R) — the\nall-wet self-consistency invariant.  Dead edges (higher surface\nbelow the sill) become walls; their U&#94;n edge transports are zeroed\nat step start (R3 — structural on this backend: the RHS consumes\nper-edge transports directly, so zeroing u_star/u_n_edge on Hf=0\nedges closes the dead-edge flux exactly; no cell-momentum\nreconstruction masking is needed, unlike the structured path).\nDry-cell eta is NOT clamped at the bed — Newton lets it settle\nbelow (V = 0 regardless). References: Casulli (2009) IJNMF 60:391-408; Casulli & Zanolli\n(2010) SISC 32(4):2255-2273. All kernels explicit-shape (n_sub|3, ncells) , device-resident,\ncell-index-last per the unstructured convention. Uses rki_mesh_unstr rki_constants module~~rki_si_unstr_wetdry~~UsesGraph module~rki_si_unstr_wetdry rki_si_unstr_wetdry module~rki_constants rki_constants module~rki_si_unstr_wetdry->module~rki_constants module~rki_mesh_unstr rki_mesh_unstr module~rki_si_unstr_wetdry->module~rki_mesh_unstr pic_types pic_types module~rki_constants->pic_types module~rki_mesh_unstr->module~rki_constants pic_io pic_io module~rki_mesh_unstr->pic_io pic_logger pic_logger module~rki_mesh_unstr->pic_logger module~rki_mesh_unstr->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_si_unstr_wetdry~~UsedByGraph module~rki_si_unstr_wetdry rki_si_unstr_wetdry module~rki_si_unstr_step rki_si_unstr_step module~rki_si_unstr_step->module~rki_si_unstr_wetdry module~rki_si_unstr_step_ml rki_si_unstr_step_ml module~rki_si_unstr_step_ml->module~rki_si_unstr_wetdry module~rki_si_unstr_step_ml->module~rki_si_unstr_step module~rki_solver_unstr rki_solver_unstr module~rki_solver_unstr->module~rki_si_unstr_step module~rki_solver_unstr->module~rki_si_unstr_step_ml module~rki_api_unstr rki_api_unstr module~rki_api_unstr->module~rki_solver_unstr module~rki_driver rki_driver module~rki_driver->module~rki_solver_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private, parameter :: EDGES_PER_TRI = 3 Triangles only. real(kind=wp), private, parameter :: WETDRY_FLOOR_TOL = 1.0e-14_wp Threshold below which a cell’s wet fraction AND its three edge\nstiffness coefficients count as zero => a fully-decoupled dry row\nthat receives the +1 identity floor (Casulli rule R5): keeps the\nNewton Jacobian SPD with O(1) conditioning where a would be 0. Functions private pure function edge_depth_wetdry (eta_l, eta_r, b_l, b_r) result(hf) Frozen wet/dry edge conveyance: the arithmetic-mean water depth of\nthe two adjacent cells, gated to 0 by the max-eta/sill wet test. !$acc routine seq so device do-concurrent bodies can call it. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: eta_l real(kind=wp), intent(in) :: eta_r real(kind=wp), intent(in) :: b_l real(kind=wp), intent(in) :: b_r Return Value real(kind=wp) Subroutines public pure subroutine si_unstr_wetdry_face_depths (mesh, nct, nco, n_bc, eta, b_min, bc_type, bc_eta_ext, Hf_edge, eta_ghost_edge) FROZEN wet/dry edge depths — the GATED-MEAN conveyance rule per\nedge (Casulli rule R1, prototype-verified mesh-agnostic):\n  wet  <=>  max(eta_L, eta_R) > max(b_L, b_R)     (max-eta/sill)\n  Hf   = 0.5 (max(eta_L-b_L,0) + max(eta_R-b_R,0))  where wet\nWhere BOTH cells are wet this is EXACTLY the linear edge depth\n0.5 (h_L+h_R) — an all-wet basin reproduces the linear operator’s\nHf bit-for-bit (NOT a raw max-eta or bare sill depth, which would\nchange the all-wet answer — the load-bearing structured lesson).\nDead edges (higher surface below the higher bed — a wet cell\ncannot “see” through a dry one over the sill) are walls (Hf=0). Read more… Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. integer, intent(in) :: n_bc BC group table size. real(kind=wp), intent(in) :: eta (nct) eta&#94;n at circumcentres (the FROZEN surface). real(kind=wp), intent(in) :: b_min (nct) Sill bed elevation (deepest sub-bottom) at cells (m). integer, intent(in) :: bc_type (n_bc) real(kind=wp), intent(in) :: bc_eta_ext (n_bc) real(kind=wp), intent(out) :: Hf_edge (EDGES_PER_TRI,nct) real(kind=wp), intent(out) :: eta_ghost_edge (EDGES_PER_TRI,nct) public pure subroutine si_unstr_wetdry_fill_bsub (mesh, nsub, nct, nco, bed, bsub_fill, b_sub, b_min) Fill the per-cell sub-bottom table from the plain bed.  v1\n(n_sub=1): b_sub(1,:) = bed, b_min = bed — always, regardless of\nmode.  Subgrid (n_sub>=2):\n  FLAT (default): all sub-bottoms = bed => BIT-IDENTICAL to n_sub=1.\n  LINEAR: nsub equal-area sub-bottoms evenly spaced across the\n    per-cell relief band [bed-half, bed+half] , half = 0.5*max edge-neighbour |Δbed| (a linear sub-cell bed ramp; Casulli 2009\n    subgrid bathymetry, prototype subgrid_bathy_from_bed ).\n    Sub-bottoms ascending; mean == bed (still-water volume\n    unchanged); wet fraction staircases 1/nsub per breakpoint so a\n    coarse tidal flat drains/floods SMOOTHLY.  Boundary edges (no\n    neighbour) contribute 0 to the relief so a shore cell falls back\n    toward FLAT.  On flat bed (half=0) => == FLAT.  b_min = the\n    deepest (first, sill) sub-bottom. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nsub Sub-bottoms per cell (>= 1). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: bed (nct) integer, intent(in) :: bsub_fill SI_BSUB_FILL_* .  FLAT => flat fill; LINEAR => the ramp. real(kind=wp), intent(out) :: b_sub (nsub,nct) real(kind=wp), intent(out) :: b_min (nct) public pure subroutine si_unstr_wetdry_mass_diag (nct, nco, a_cell, Hf_edge, mass_diag) Assemble the Newton mass diagonal M = a + floor (Casulli R5): the\nwet fraction a plus a +1 identity for a fully-decoupled dry row\n(a <= tol AND all three edge stiffness coefficients Hf <= tol).\nThe +1 matches the linear operator’s constant mass exactly at\nwet cells where a == 1 and no floor fires. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: a_cell (nct) real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,nct) real(kind=wp), intent(out) :: mass_diag (nct) public  subroutine si_unstr_wetdry_newton_residual (nct, nco, eta, Jeta, mass_diag, v_cell, rhs, res, res2_out) Form the Newton nonlinear residual and its squared interior norm:\n  F_c = v_c(eta) + [T eta]_c - rhs_c,\nwith the stiffness recovered matmul-free from the full mass-diag\noperator apply:  T eta = Jeta - mass_diag eta.  Returns sum(F&#94;2)\nover the owned cells (the Newton convergence norm — plain, not\narea-weighted, matching the prototype/structured gate; it is a\nconvergence heuristic, not the CG inner product). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: eta (nct) real(kind=wp), intent(in) :: Jeta (nct) real(kind=wp), intent(in) :: mass_diag (nct) real(kind=wp), intent(in) :: v_cell (nct) real(kind=wp), intent(in) :: rhs (nct) real(kind=wp), intent(out) :: res (nct) real(kind=wp), intent(out) :: res2_out public pure subroutine si_unstr_wetdry_volume (nsub, nct, nco, eta, b_sub, v_cell) Per-cell wetted mean depth v_c(eta) = (1/n_sub) sum_s max(eta-b&#94;s,0)\n(m; per unit cell area).  n_sub=1: v = max(eta-b,0) = the\nstill-water total depth. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nsub Sub-bottoms per cell. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: eta (nct) real(kind=wp), intent(in) :: b_sub (nsub,nct) real(kind=wp), intent(out) :: v_cell (nct) public  subroutine si_unstr_wetdry_wetcount (nsub, nct, nco, eta, b_sub, count_out) Total owned wet-sub-bottom count — the active-set fingerprint the\nNewton loop watches (frozen set + small residual = converged).\nInteger so equality is exact. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nsub Sub-bottoms per cell. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: eta (nct) real(kind=wp), intent(in) :: b_sub (nsub,nct) integer, intent(out) :: count_out public pure subroutine si_unstr_wetdry_wetfrac (nsub, nct, nco, eta, b_sub, a_cell) Per-cell wet fraction a_c(eta) = v’ in [0,1] — the Newton diagonal.\nRIGHT-continuous at breakpoints ( eta >= b_sub counts wet), the\nsub-derivative that keeps Newton-on-convex-V monotone. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nsub Sub-bottoms per cell. integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: eta (nct) real(kind=wp), intent(in) :: b_sub (nsub,nct) real(kind=wp), intent(out) :: a_cell (nct)","tags":"","url":"module/rki_si_unstr_wetdry.html"},{"title":"rki_mesh_gen_unstr – Rakali","text":"Naive in-Fortran triangulators for idealized domains, so the\nunstructured path can be driven end-to-end without the Python +\nmeshpy/Triangle toolchain (benchmarks, idealized test cases).  The\noutput (vert_x, vert_y, tri_v) feeds straight into mesh_unstr_init_from_triangles .  These are NOT a substitute for\nmeshpy on real coastlines – no boundary conformity, no\nbathymetry-driven refinement. Uses rki_constants module~~rki_mesh_gen_unstr~~UsesGraph module~rki_mesh_gen_unstr rki_mesh_gen_unstr module~rki_constants rki_constants module~rki_mesh_gen_unstr->module~rki_constants pic_types pic_types module~rki_constants->pic_types Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_mesh_gen_unstr~~UsedByGraph module~rki_mesh_gen_unstr rki_mesh_gen_unstr module~rki_driver rki_driver module~rki_driver->module~rki_mesh_gen_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Functions private pure function delaunay_diag_bl_tr (xbl, ybl, xbr, ybr, xtr, ytr, xtl, ytl) result(use_bl_tr) In-circle test choosing the Delaunay diagonal of the quad\n(bl, br, tr, tl) CCW.  Returns .true. to split along bl–tr (the\ndiagonal that keeps both triangles Delaunay), .false. for br–tl. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: xbl real(kind=wp), intent(in) :: ybl real(kind=wp), intent(in) :: xbr real(kind=wp), intent(in) :: ybr real(kind=wp), intent(in) :: xtr real(kind=wp), intent(in) :: ytr real(kind=wp), intent(in) :: xtl real(kind=wp), intent(in) :: ytl Return Value logical private pure function hash01 (i, j, s) result(r) Deterministic pseudo-random value in [0,1) from a 3-integer key. Arguments Type Intent Optional Attributes Name integer, intent(in) :: i integer, intent(in) :: j integer, intent(in) :: s Return Value real(kind=wp) Subroutines public  subroutine gen_delaunay_triangulation (nx, ny, lx, ly, vert_x, vert_y, tri_v) Acute-Delaunay variant of gen_regular_triangulation for the\nsemi-implicit (TPFA) path.  The plain right-triangle split puts\neach circumcentre ON the shared hypotenuse midpoint — the two\ntriangles of a quad get COINCIDENT circumcentres, edge_delta = 0 ,\nand the SI mesh-quality gate rightly rejects the mesh.  Here the\ninterior vertices are jittered (deterministic hash — reproducible)\nand each quad is split along its locally-Delaunay diagonal\n(in-circle test), so circumcentres sit strictly inside the acute\ntriangles and edge_delta > 0 everywhere.  Boundary vertices stay\nON the box so the domain is exactly rectangular for the wall BC. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx Number of cells in x / y (>= 1). integer, intent(in) :: ny Number of cells in x / y (>= 1). real(kind=wp), intent(in) :: lx Domain extents in x / y (m). real(kind=wp), intent(in) :: ly Domain extents in x / y (m). real(kind=wp), intent(out), allocatable :: vert_x (:) real(kind=wp), intent(out), allocatable :: vert_y (:) integer, intent(out), allocatable :: tri_v (:,:) Triangle connectivity, shape (3, 2 nx ny); 1-based vertex ids. public  subroutine gen_regular_triangulation (nx, ny, lx, ly, vert_x, vert_y, tri_v) Regular rectangular triangulation of [0,lx] x [0,ly]: an\n(nx+1) x (ny+1) vertex grid, each quad split into two CCW\ntriangles (a lower (v00,v10,v01) + an upper (v10,v11,v01)).\nYields (nx+1)(ny+1) vertices and 2 nx ny triangles.  Vertices are\nnumbered row-major (i fastest); the triangulation tiles the\nrectangle exactly with positively-oriented triangles. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx Number of cells in x / y (>= 1). integer, intent(in) :: ny Number of cells in x / y (>= 1). real(kind=wp), intent(in) :: lx Domain extents in x / y (m). real(kind=wp), intent(in) :: ly Domain extents in x / y (m). real(kind=wp), intent(out), allocatable :: vert_x (:) real(kind=wp), intent(out), allocatable :: vert_y (:) integer, intent(out), allocatable :: tri_v (:,:) Triangle connectivity, shape (3, 2 nx ny); 1-based vertex ids.","tags":"","url":"module/rki_mesh_gen_unstr.html"},{"title":"rki_ml_vertical_viscosity – Rakali","text":"Currently implements the gradient-Richardson-number closure of\nPacanowski & Philander (1981).  Computes a turbulent viscosity at\neach interior interface and applies a diffusive flux to layer\nmomentum: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg When an ocean-grade KPP closure lands, it will live alongside\nthis one (e.g. vertical/rki_ml_kpp.F90 ) and the solver will\npick between them via a config flag. Uses rki_grid rki_constants rki_ml_common module~~rki_ml_vertical_viscosity~~UsesGraph module~rki_ml_vertical_viscosity rki_ml_vertical_viscosity module~rki_constants rki_constants module~rki_ml_vertical_viscosity->module~rki_constants module~rki_grid rki_grid module~rki_ml_vertical_viscosity->module~rki_grid module~rki_ml_common rki_ml_common module~rki_ml_vertical_viscosity->module~rki_ml_common pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants module~rki_ml_common->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_ml_vertical_viscosity~~UsedByGraph module~rki_ml_vertical_viscosity rki_ml_vertical_viscosity module~rki_solver rki_solver module~rki_solver->module~rki_ml_vertical_viscosity module~rki_api rki_api module~rki_api->module~rki_solver module~rki_driver rki_driver module~rki_driver->module~rki_solver Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Subroutines public pure subroutine ml_vertical_viscosity (h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, grid, nz, dt) Ri-dependent vertical viscosity for momentum (Pacanowski-Philander 1981).\nComputes gradient Richardson number at each interface and applies\nturbulent diffusive flux: nu_t = nu_max / (1 + alpha*Ri)&#94;2 + nu_bg. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 Reference density (kg/m&#94;3) real(kind=wp), intent(in) :: nu_max Maximum turbulent viscosity (m&#94;2/s) real(kind=wp), intent(in) :: nu_bg Background viscosity (m&#94;2/s) real(kind=wp), intent(in) :: ri_alpha Richardson number scaling coefficient type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt","tags":"","url":"module/rki_ml_vertical_viscosity.html"},{"title":"rki_ml_friction_unstr – Rakali","text":"Provides ml_apply_coriolis_unstr (closed-form per-layer Coriolis\nrotation, mirrors structured ml_apply_coriolis ) and ml_apply_bottom_friction_unstr (semi-implicit Manning quadratic\ndrag on the lowest active layer, mirrors structured ml_apply_bottom_friction ). Layer-index convention: bottom-up ( k=1 bed, k=nz surface).\nCoriolis is uniform in the vertical (scalar f ), applied to every\nlayer’s (hu_k, hv_k) . Bottom friction acts on the lowest\nnon-vanishing layer (usually k=1 ; the deepest active layer for\nZSTAR_FULL where the bed layer can be parked at h_min). Both are\ncolumn-local — safe for do concurrent . Uses rki_state_unstr rki_constants rki_ml_common_unstr module~~rki_ml_friction_unstr~~UsesGraph module~rki_ml_friction_unstr rki_ml_friction_unstr module~rki_constants rki_constants module~rki_ml_friction_unstr->module~rki_constants module~rki_ml_common_unstr rki_ml_common_unstr module~rki_ml_friction_unstr->module~rki_ml_common_unstr module~rki_state_unstr rki_state_unstr module~rki_ml_friction_unstr->module~rki_state_unstr pic_types pic_types module~rki_constants->pic_types module~rki_ml_common_unstr->module~rki_constants module~rki_state_unstr->module~rki_constants module~rki_barotropic_state_unstr rki_barotropic_state_unstr module~rki_state_unstr->module~rki_barotropic_state_unstr module~rki_boundary_unstr rki_boundary_unstr module~rki_state_unstr->module~rki_boundary_unstr module~rki_mesh_unstr rki_mesh_unstr module~rki_state_unstr->module~rki_mesh_unstr module~rki_multilayer_state_unstr rki_multilayer_state_unstr module~rki_state_unstr->module~rki_multilayer_state_unstr module~rki_si_common rki_si_common module~rki_state_unstr->module~rki_si_common module~rki_si_unstr_state rki_si_unstr_state module~rki_state_unstr->module~rki_si_unstr_sta