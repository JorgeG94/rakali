 si_unstr_tridiag_noflux","tags":"","url":"proc/si_unstr_tridiag_noflux.html"},{"title":"compute_timestep – Rakali","text":"public  subroutine compute_timestep(h, hu, hv, grid, cfl, dt) Maximum stable timestep: reduces over interior cells for the max\nwave speed, then dt = cfl * min(dx,dy) / max_wavespeed. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: cfl CFL number real(kind=wp), intent(out) :: dt Computed timestep (s) Calls proc~~compute_timestep~~CallsGraph proc~compute_timestep compute_timestep local local proc~compute_timestep->local reduce reduce proc~compute_timestep->reduce Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_timestep~~CalledByGraph proc~compute_timestep compute_timestep proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~compute_timestep proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~compute_timestep proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~compute_timestep proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_multilayer_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: denom real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: eps real(kind=wp), private :: eps4 real(kind=wp), private :: h4 integer, private :: i integer, private :: j real(kind=wp), private :: max_speed integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: speed_x real(kind=wp), private :: speed_y real(kind=wp), private :: u_abs real(kind=wp), private :: v_abs real(kind=wp), private :: wave_speed Source Code subroutine compute_timestep ( h , hu , hv , grid , cfl , dt ) !! Maximum stable timestep: reduces over interior cells for the max !! wave speed, then dt = cfl * min(dx,dy) / max_wavespeed. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: cfl !! CFL number real ( wp ), intent ( out ) :: dt !! Computed timestep (s) integer :: i , j , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: max_speed , speed_x , speed_y , u_abs , v_abs , wave_speed real ( wp ) :: h4 , eps4 , denom , eps nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy ! Desingularization parameter (Kurganov & Petrova, 2007): the SAME ! eps as the update kernels' thin-cell desingularization, so the dt ! bound and the update agree about what \"thin\" means.  (The old ! `max(eps, 0.01*min(dx,dy))` grid term is gone: on coarse grids it ! made this estimator blind to real velocities in cells shallower ! than 1% of the cell width — a latent CFL bug.)  The denominator ! here omits the KP07 `max(h&#94;4, eps&#94;4)`, so the speed estimated ! below is >= the desingularized velocity the update kernels produce ! for every h (by up to sqrt(2) in deep water) — a strict, mildly ! conservative upper bound on the CFL. eps = DESING_EPS eps4 = eps ** 4 max_speed = 0.0_wp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( wave_speed , h4 , denom , u_abs , v_abs , speed_x , speed_y ) & reduce ( max : max_speed ) if ( h ( i , j ) > DRY_TOLERANCE ) then wave_speed = sqrt ( GRAVITY * h ( i , j )) ! Desingularized velocity (Kurganov & Petrova, 2007): !   u = sqrt(2)*h*hu / sqrt(h&#94;4 + eps&#94;4) h4 = h ( i , j ) ** 4 denom = sqrt ( h4 + eps4 ) u_abs = abs ( hu ( i , j )) * sqrt ( 2.0_wp ) * h ( i , j ) / denom v_abs = abs ( hv ( i , j )) * sqrt ( 2.0_wp ) * h ( i , j ) / denom speed_x = u_abs + wave_speed speed_y = v_abs + wave_speed max_speed = max ( max_speed , speed_x / dx , speed_y / dy ) end if end do if ( max_speed > 0.0_wp ) then dt = cfl / max_speed else dt = cfl * min ( dx , dy ) / sqrt ( GRAVITY * DRY_TOLERANCE ) end if end subroutine compute_timestep","tags":"","url":"proc/compute_timestep.html"}