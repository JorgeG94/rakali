 or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: nz type( timestepper_t ), private :: ts logical, private :: use_nh Source Code subroutine solver_step_impl ( state , dt_max ) !! SSP-RK2 step for unsplit (2D or NH without mode splitting) type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ), optional :: dt_max logical :: use_nh integer :: nz type ( timestepper_t ) :: ts use_nh = state % use_nonhydrostatic nz = state % nh % nz ! Build the explicit-integrator coefficient table for this step. ! Host-side scalars only (never device-mapped); rebuilding each step ! is a few branch tests.  NH stays on RK2 (configure guard forbids a ! non-RK2 scheme unless the run is pure 2D barotropic). ts = make_timestepper ( state % time_scheme ) ! ---- NH: compute depth-averaged momentum from layers ---- if ( use_nh ) then call compute_depth_averaged_momentum ( state % barotropic % h , state % nh % u_layer , & state % nh % v_layer , state % nh % dsig , & state % barotropic % hu , state % barotropic % hv , & state % grid , nz ) end if ! ---- Compute timestep from U&#94;n ---- call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) if ( use_nh ) then call apply_nh_boundary_conditions ( state % nh % q_nh , state % nh % u_layer , & state % nh % v_layer , state % nh % w , & state % barotropic % h , state % barotropic % b , & state % grid , nz , state % bc ) end if if ( state % dt_fixed > 0.0_wp ) then state % dt = state % dt_fixed if ( present ( dt_max )) state % dt = min ( state % dt , dt_max ) else if ( mod ( state % step_count , state % cfl_interval ) == 0 . or . state % dt <= 0.0_wp ) then call compute_timestep ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % cfl , state % dt ) ! SSP coefficient: rk43 (C=2) is stable at 2x the forward-Euler ! CFL dt.  Exact x1.0 for euler/rk2/rk3, so default RK2 is ! bit-identical here.  Applied before dt_max so the cap still wins. state % dt = state % dt * ts % ssp_coeff if ( present ( dt_max )) then state % dt = min ( state % dt , dt_max ) end if end if state % step_count = state % step_count + 1 ! Propagate dt to BC params for Chapman radiation state % bc % dt = state % dt ! 2D barotropic fused path: save + update + friction + coriolis in one ! kernel per RK stage. NH/multilayer use the unfused path below (layer ! operations sit between update and friction). if (. not . use_nh . and . . not . state % use_multilayer & . and . ts % scheme /= TIME_RK2 ) then ! Selectable explicit integrator (euler/rk3/rk43): generic ! N-stage advance.  RK2 falls through to the untouched fused ! fast path below (its bit-identity gate). call solver_advance_2d_generic ( state , ts ) else if (. not . use_nh . and . . not . state % use_multilayer ) then ! ==== Fused RK2 Stage 1 ==== call profiler_start ( \"boundary\" ) call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) call profiler_stop ( \"boundary\" ) call profiler_start ( \"flux\" ) call solver_compute_barotropic_flux ( state ) call accumulate_boundary_mass_out ( state , 0.5_wp ) call profiler_stop ( \"flux\" ) call profiler_start ( \"update\" ) call fused_update_stage1 ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & state % barotropic % flux_h , state % barotropic % flux_hu , state % barotropic % flux_hv , & state % grid , state % dt , & state % barotropic % manning_n , state % forcing % wind_x , state % forcing % wind_y , & state % forcing % atm_pressure , state % forcing % precipitation , & state % barotropic % coriolis_f , & state % forcing % active ) ! Accumulate the precipitation mass source for this stage.  The 2D ! barotropic path has no evap mass sink (no multilayer tracers), so ! evap_mass_sink=.false. call accumulate_mass_src ( state , 0.5_wp , evap_mass_sink = . false .) call profiler_stop ( \"update\" ) ! Sponge: measure the h-change so it enters the mass-source budget. call accumulate_sponge_mass_src ( state , 0.5_wp ) ! ==== Fused RK2 Stage 2 ==== state % bc % time = state % bc % time + state % dt call profiler_start ( \"boundary\" ) call apply_boundary_conditions ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , state % barotropic % b , & state % grid , state % bc ) call profiler_stop ( \"boundary\" ) call profiler_start ( \"flux\" ) call solver_compute_barotropic_flux ( state ) call accumulate_boundary_mass_out ( state , 0.5_wp ) call profiler_stop ( \"flux\" ) call profiler_start ( \"rk2_average\" ) call fused_update_stage2 ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & state % barotropic % flux_h , state % barotropic % flux_hu , state % barotropic % flux_hv , & state % grid , state % dt , & state % barotropic % manning_n , state % forcing % wind_x , state % forcing % wind_y , & state % forcing % atm_pressure , state % forcing % precipitation , & state % barotropic % coriolis_f , & state % forcing % active ) ! Stage 2 precipitation source (same sign, same weight). call accumulate_mass_src ( state , 0.5_wp , evap_mass_sink = . false .) call profiler_stop ( \"rk2_average\" ) ! Sponge stage 2. call accumulate_sponge_mass_src ( state , 0.5_wp ) else ! Unfused path: NH and multilayer. ! ---- Save U&#94;n for the averaging step ---- call solver_save_state ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , state % grid ) if ( use_nh ) then call solver_save_state_layers ( state % nh % u_layer , state % nh % v_layer , state % nh % w , & state % nh % u_layer0 , state % nh % v_layer0 , state % nh % w0 , & state % grid , nz ) end if ! ==== RK2 Stage 1 ==== call solver_nh_rk_stage ( state , nz , use_nh ) ! ---- Stage 2: U** = U* + dt * L(U*) ---- ! Advance BC time by dt for tidal boundaries at stage 2 state % bc % time = state % bc % time + state % dt ! NH: recompute depth-averaged momentum from updated layers if ( use_nh ) then call compute_depth_averaged_momentum ( state % barotropic % h , state % nh % u_layer , & state % nh % v_layer , state % nh % dsig , & state % barotropic % hu , state % barotropic % hv , & state % grid , nz ) end if call solver_nh_rk_stage ( state , nz , use_nh ) ! ---- Average: U&#94;{n+1} = 0.5 * (U&#94;n + U**) ---- call profiler_start ( \"rk2_average\" ) call compute_rk2_average ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , & state % grid ) if ( use_nh ) then call compute_rk2_average_layers ( state % nh % u_layer , state % nh % v_layer , state % nh % w , & state % nh % u_layer0 , state % nh % v_layer0 , state % nh % w0 , & state % grid , nz ) end if call profiler_stop ( \"rk2_average\" ) end if ! fused vs unfused path end subroutine solver_step_impl","tags":"","url":"proc/solver_step_impl.html"},{"title":"solver_step_multilayer_impl – Rakali","text":"private  subroutine solver_step_multilayer_impl(state, dt_max) SSP-RK2 step for coupled hydrostatic multi-layer equations Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state real(kind=wp), intent(in), optional :: dt_max Calls proc~~solver_step_multilayer_impl~~CallsGraph proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~apply_boundary_conditions apply_boundary_conditions proc~solver_step_multilayer_