the ghost depth is !!     h_ghost = eta_bc - b_c, and Hf = 0.5*(h_c + h_ghost).  The ghost !!     eta is stashed in `eta_ghost_edge(i,k)` for the operator + RHS + !!     back-sub (the coefficient-space Dirichlet route). !! !! Cell-centric double-visit `(3, ncell)`: each cell fills its own 3 !! edge values from its own `height`/`bed` + the neighbour's `height` !! (read-only); interior edges are visited twice with the same result. use rki_boundary_unstr , only : BC_WALL , BC_TIDAL , BC_CLAMPED type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: ncell_total !! Cell array extent (owned + halo) — the explicit-shape dim. integer , intent ( in ) :: ncell_owned !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size (`MAX_BC_GROUPS`). real ( wp ), intent ( in ) :: height ( ncell_total ) !! Still-water depth h at cells (m). real ( wp ), intent ( in ) :: bed ( ncell_total ) !! Bed elevation b at cells (m). integer , intent ( in ) :: bc_type ( n_bc ) !! Per-group BC type (`state%bc_type`), the boundary lookup. real ( wp ), intent ( in ) :: bc_eta_ext ( n_bc ) !! Per-group Dirichlet external surface eta (m) (`state%bc_eta_ext`). real ( wp ), intent ( out ) :: Hf_edge ( EDGES_PER_TRI , ncell_total ) !! Edge effective depth (m). real ( wp ), intent ( out ) :: eta_ghost_edge ( EDGES_PER_TRI , ncell_total ) !! Dirichlet ghost surface eta (m) on Dirichlet boundary edges; !! 0 elsewhere (unread — Hf=0 there). integer :: k , i , kn , g , bt real ( wp ) :: h_ghost , eta_bc do concurrent ( k = 1 : ncell_owned ) local ( i , kn , g , bt , h_ghost , eta_bc ) do i = 1 , EDGES_PER_TRI eta_ghost_edge ( i , k ) = 0.0_wp kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then ! Interior / partition edge: arithmetic-mean still depth. Hf_edge ( i , k ) = si_unstr_face_depth_linear ( height ( k ), height ( kn )) else g = mesh % bc_group ( i , k ) bt = BC_WALL if ( g >= 1 . and . g <= n_bc ) bt = bc_type ( g ) if (( bt == BC_TIDAL . or . bt == BC_CLAMPED ) . and . g >= 1 ) then eta_bc = bc_eta_ext ( g ) h_ghost = max ( eta_bc - bed ( k ), 0.0_wp ) Hf_edge ( i , k ) = si_unstr_face_depth_linear ( height ( k ), h_ghost ) eta_ghost_edge ( i , k ) = eta_bc else Hf_edge ( i , k ) = 0.0_wp end if end if end do end do end subroutine si_unstr_face_depths","tags":"","url":"proc/si_unstr_face_depths.html"},{"title":"si_unstr_precond_apply – Rakali","text":"private  subroutine si_unstr_precond_apply(mesh, ncell_total, ncell_owned, r, z, eta_diag, use_mg, mg) Preconditioner apply z = M&#94;{-1} r for the area-weighted PCG.\nJACOBI: z = eta_diag*r (diagonal).  MG: one aggregation-multigrid\nV-cycle of the symmetric Ahat on the area-weighted RHS\n( agglom_unstr_vcycle_precond folds the area*r ), which reduces to\nthe Jacobi apply when the V-cycle is a single diagonal sweep — the\ngeneralisation is exact (module header).  Owned cells only; the ghost\nband of z is left as the caller set it (pre-zeroed). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total integer, intent(in) :: ncell_owned real(kind=wp), intent(in) :: r (ncell_total) real(kind=wp), intent(inout) :: z (ncell_total) real(kind=wp), intent(in) :: eta_diag (ncell_total) logical, intent(in) :: use_mg type( agglom_hierarchy_unstr_t ), intent(inout), optional :: mg Calls proc~~si_unstr_precond_apply~~CallsGraph proc~si_unstr_precond_apply si_unstr_precond_apply proc~agglom_unstr_vcycle_precond agglom_unstr_vcycle_precond proc~si_unstr_precond_apply->proc~agglom_unstr_vcycle_precond proc~agglom_copy_out agglom_copy_out proc~agglom_unstr_vcycle_precond->proc~agglom_copy_out proc~agglom_scale_into_shim agglom_scale_into_shim proc~agglom_unstr_vcycle_precond->proc~agglom_scale_into_shim proc~agglom_vcycle agglom_vcycle proc~agglom_unstr_vcycle_precond->proc~agglom_vcycle proc~agglom_vcycle->proc~agglom_vcycle proc~agglom_jacobi_sweeps agglom_jacobi_sweeps proc~agglom_vcycle->proc~agglom_jacobi_sweeps proc~agglo