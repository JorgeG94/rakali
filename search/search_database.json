 0.0_wp ) allocate ( this % height_cv ( n ), source = 0.0_wp ) allocate ( this % stage_ev ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % xmom_ev ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % ymom_ev ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % bed_ev ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % height_ev ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % chapman_eta_old ( EDGES_PER_TRI , n ), source = 0.0_wp ) allocate ( this % stage_eu ( n ), source = 0.0_wp ) allocate ( this % xmom_eu ( n ), source = 0.0_wp ) allocate ( this % ymom_eu ( n ), source = 0.0_wp ) allocate ( this % xmom_siu ( n ), source = 0.0_wp ) allocate ( this % ymom_siu ( n ), source = 0.0_wp ) allocate ( this % stage_backup ( n ), source = 0.0_wp ) allocate ( this % xmom_backup ( n ), source = 0.0_wp ) allocate ( this % ymom_backup ( n ), source = 0.0_wp ) allocate ( this % x_centroid_work ( n ), source = 0.0_wp ) allocate ( this % y_centroid_work ( n ), source = 0.0_wp ) allocate ( this % max_speed ( n ), source = 0.0_wp ) allocate ( this % mass_flux_e ( EDGES_PER_TRI , n ), source = 0.0_wp ) end subroutine unstr_barotropic_init","tags":"","url":"proc/unstr_barotropic_init.html"},{"title":"unstr_tracer_destroy – Rakali","text":"private  subroutine unstr_tracer_destroy(this) Type Bound unstr_tracer_t Arguments Type Intent Optional Attributes Name class( unstr_tracer_t ), intent(inout) :: this Called by proc~~unstr_tracer_destroy~~CalledByGraph proc~unstr_tracer_destroy unstr_tracer_t%unstr_tracer_destroy proc~unstr_multilayer_destroy unstr_multilayer_state_t%unstr_multilayer_destroy proc~unstr_multilayer_destroy->proc~unstr_tracer_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine unstr_tracer_destroy ( this ) class ( unstr_tracer_t ), intent ( inout ) :: this if ( allocated ( this % hTr )) deallocate ( this % hTr ) if ( allocated ( this % hTr0 )) deallocate ( this % hTr0 ) end subroutine unstr_tracer_destroy","tags":"","url":"proc/unstr_tracer_destroy.html"},{"title":"unstr_tracer_init – Rakali","text":"private  subroutine unstr_tracer_init(this, mesh, nz) Allocate hTr / hTr0 at the multilayer mesh size, zero-filled.\nCaller is responsible for populating the prognostic field\n(e.g. hTr = h_layer * tr_init ) after layer thicknesses are set. Type Bound unstr_tracer_t Arguments Type Intent Optional Attributes Name class( unstr_tracer_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nz Called by proc~~unstr_tracer_init~~CalledByGraph proc~unstr_tracer_init unstr_tracer_t%unstr_tracer_init proc~unstr_multilayer_register_passive_tracer unstr_multilayer_state_t%unstr_multilayer_register_passive_tracer proc~unstr_multilayer_register_passive_tracer->proc~unstr_tracer_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine unstr_tracer_init ( this , mesh , nz ) !! Allocate hTr / hTr0 at the multilayer mesh size, zero-filled. !! Caller is responsible for populating the prognostic field !! (e.g. `hTr = h_layer * tr_init`) after layer thicknesses are set. class ( unstr_tracer_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz allocate ( this % hTr ( nz , mesh % ncells_total ), source = 0.0_wp ) allocate ( this % hTr0 ( nz , mesh % ncells_total ), source = 0.0_wp ) end subroutine unstr_tracer_init","tags":"","url":"proc/unstr_tracer_init.html"},{"title":"ml_truncate_velocity_unstr – Rakali","text":"public pure subroutine ml_truncate_velocity_unstr(state, mesh, dt, cfl_trunc) Clip any layer velocity with CFL > cfl_trunc to 0.9*cfl_trunc*radius/dt , per owned cell and layer. Skips layers\nthinner than THIN_LAYER_THRESHOLD (already zeroed upstream). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: cfl_trunc Calls proc~~ml_truncate_velocity_unstr~~CallsGraph proc~ml_truncate_velocity_unstr ml_truncate_velocity_unstr local local proc~ml_truncate_velocity_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_truncate_velocity_unstr~~CalledByGraph proc~ml_truncate_velocity_unstr ml_truncate_velocity_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_truncate_velocity_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: cell real(kind=wp), private :: coef real(kind=wp), private :: h_k real(kind=wp), private :: inv_dt integer, private :: k integer, private :: n integer, private :: nz real(kind=wp), private :: u_abs real(kind=wp), private :: v_abs real(kind=wp), private :: vel_max Source Code pure subroutine ml_truncate_velocity_unstr ( state , mesh , dt , cfl_trunc ) !! Clip any layer velocity with CFL > cfl_trunc to !! `0.9*cfl_trunc*radius/dt`, per owned cell and layer. Skips layers !! thinner than THIN_LAYER_THRESHOLD (already zeroed upstream). type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt real ( wp ), intent ( in ) :: cfl_trunc integer :: cell , k , nz , n real ( wp ) :: vel_max , h_k , u_abs , v_abs , inv_dt , coef if (. not . state % use_multilayer ) return if ( cfl_trunc <= 0.0_wp ) return nz = state % multilayer % nz_ml n = state % ncells_owned inv_dt = 1.0_wp / max ( dt , 1.0e-10_wp ) coef = 0.9_wp * cfl_trunc * inv_dt do concurrent ( cell = 1 : n ) local ( k , vel_max , h_k , u_abs , v_abs ) vel_max = coef * mesh % radius ( cell ) do k = 1 , nz h_k = state % multilayer % h_layer ( k , cell ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle u_abs = abs ( state % multilayer % hu_layer ( k , cell )) / h_k v_abs = abs ( state % multilayer % hv_layer ( k , cell )) / h_k if ( u_abs > vel_max ) then state % multilayer % hu_layer ( k , cell ) = & sign ( vel_max * h_k , state % multilayer % hu_layer ( k , cell )) end if if ( v_abs > vel_max ) then state % multilayer % hv_layer ( k , cell ) = & sign ( vel_max * h_k , state % multilayer % hv_layer ( k , cell )) end if end do end do end subroutine ml_truncate_velocity_unstr","tags":"","url":"proc/ml_truncate_velocity_unstr.html"},{"title":"point_in_triangle – Rakali","text":"private pure function point_in_triangle(px, py, x1, y1, x2, y2, x3, y3) result(inside) Test if point (px,py) is inside triangle (x1,y1)-(x2,y2)-(x3,y3).\nUses sign-of-cross-product method. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: px real(kind=wp), intent(in) :: py real(kind=wp), intent(in) :: x1 real(kind=wp), intent(in) :: y1 real(kind=wp), intent(in) :: x2 real(kind=wp), intent(in) :: y2 real(kind=wp), intent(in) :: x3 real(kind=wp), intent(in) :: y3 Return Value logical Called by proc~~point_in_triangle~~CalledByGraph proc~point_in_triangle point_in_triangle proc~gauges_unstr_init gauges_unstr_init proc~gauges_unstr_init->proc~point_in_triangle proc~rki_unstr_gauges_init rki_unstr_gauges_init proc~rki_unstr_gauges_init->proc~gauges_unstr_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: d1 real(kind=wp), private :: d2 real(kind=wp), private :: d3 logical, private :: has_neg logical, private :: has_pos Source Code pure function point_in_triangle ( px , py , x1 , y1 , x2 , y2 , x3 , y3 ) result ( inside ) !! Test if point (px,py) is inside triangle (x1,y1)-(x2,y2)-(x3,y3). !! Uses sign-of-cross-product method. real ( wp ), intent ( in ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 logical :: inside real ( wp ) :: d1 , d2 , d3 logical :: has_neg , has_pos d1 = ( px - x2 ) * ( y1 - y2 ) - ( x1 - x2 ) * ( py - y2 ) d2 = ( px - x3 ) * ( y2 - y3 ) - ( x2 - x3 ) * ( py - y3 ) d3 = ( px - x1 ) * ( y3 - y1 ) - ( x3 - x1 ) * ( py - y1 ) has_neg = ( d1 < 0.0_wp ) . or . ( d2 < 0.0_wp ) . or . ( d3 < 0.0_wp ) has_pos = ( d1 > 0.0_wp ) . or . ( d2 > 0.0_wp ) . or . ( d3 > 0.0_wp ) inside = . not . ( has_neg . and . has_pos ) end function point_in_triangle","tags":"","url":"proc/point_in_triangle.html"},{"title":"gauges_unstr_close – Rakali","text":"public  subroutine gauges_unstr_close(gauges) Close the gauge output file and deallocate. Arguments Type Intent Optional Attributes Name type( gauge_unstr_t ), 