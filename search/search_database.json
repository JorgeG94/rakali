eps_tke, this%keps_eps, this%keps_nut, & !$acc&                  this%keps_kt, this%keps_ustar_s, this%keps_ustar_b) if ( allocated ( this % keps_tke0 )) then !$acc enter data copyin(this%keps_tke0, this%keps_eps0) end if if ( allocated ( this % vcoord_z_ref )) then !$acc enter data copyin(this%vcoord_z_ref) end if if ( allocated ( this % vcoord_z_ref_col )) then !$acc enter data copyin(this%vcoord_z_ref_col) end if if ( allocated ( this % remap_dz_old )) then !$acc enter data create(this%remap_dz_old) end if end subroutine unstr_multilayer_enter_data","tags":"","url":"proc/unstr_multilayer_enter_data.html"},{"title":"unstr_multilayer_exit_data – Rakali","text":"private  subroutine unstr_multilayer_exit_data(this) Type Bound unstr_multilayer_state_t Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this Called by proc~~unstr_multilayer_exit_data~~CalledByGraph proc~unstr_multilayer_exit_data unstr_multilayer_state_t%unstr_multilayer_exit_data proc~state_unstr_exit_data state_unstr_exit_data proc~state_unstr_exit_data->proc~unstr_multilayer_exit_data proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_exit_data proc~ensure_host ensure_host proc~ensure_host->proc~state_unstr_exit_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~rki_unstr_destroy rki_unstr_destroy proc~rki_unstr_destroy->proc~ensure_host Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface