broutine ml_apply_tracer_bcs (hTr_layer, h_layer, tr_inflow, grid, nz, bc) Set a scalar tracer in ghost cells. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_inflow type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz type( bc_params_t ), intent(in) :: bc public pure subroutine ml_clamp_tracer (hTr_layer, h_layer, tr_min, tr_max, grid, nz) Enforce physical tracer bounds tr_min <= Tr <= tr_max\nconservatively within each column. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_min real(kind=wp), intent(in) :: tr_max type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_distribute_tracer (h_layer, hTr_layer, dsig, h_new, grid, nz) Update hTr through the barotropic step: preserve tracer Tr,\nset h_k = dsig_k * H_new, hTr_k = h_k_new * Tr_k_old. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) Old layer depths (before barotropic update) real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) Tracer h*Tr (updated using old Tr and new h) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: h_new (grid%nx_total,grid%ny_total) Total depth AFTER barotropic update type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_erode_bed_sediment (h_layer, hu_layer, hv_layer, hTr_sed, bed, manning_n, rho_0, tau_ce, e_rate, porosity, grid, nz, dt) Ariathurai-Arulanandan (1978) bed erosion of suspended sediment.\nWhere the bed shear stress exceeds the critical erosion stress tau_ce , lift bed sediment into the bottom (lowest active) layer: Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr_sed (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: bed (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: manning_n real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: tau_ce real(kind=wp), intent(in) :: e_rate real(kind=wp), intent(in) :: porosity type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_horizontal_diffusion_tracer (h_layer, hTr_layer, kappa, hdiff_hTr_pre, grid, nz, dt) Horizontal Laplacian diffusion of a scalar tracer in flux form,\nconservative per-face under non-uniform layer thicknesses. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: kappa real(kind=wp), intent(out) :: hdiff_hTr_pre (grid%nx_total,grid%ny_total,nz) Caller-owned Jacobi pre-step snapshot scratch. type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_init_tracer (h_layer, hTr_layer, tr_init, grid, nz) Initialise hTr = h_k * tr_init for all layers Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_init type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_init_tracer_stratified (h_layer, hTr_layer, tr_bottom, tr_surface, grid, nz) Seed a tracer with a linear vertical profile: tr_bottom at k=1\n(bed) to tr_surface at k=nz (surface), per the bottom-up layer\nconvention.  The profile is computed inline from the two scalars\n(no host-side per-layer array) so the seed runs correctly on the\ndevice after enter_data .  Caller guarantees nz > 1.  Mirrors the\nunstructured ml_init_tracer_stratified_unstr .\n  hTr_k = h_layer_k * [tr_bottom + dtr*(k - 1)] Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_bottom real(kind=wp), intent(in) :: tr_surface type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_rk2_average_tracer (hTr_layer, hTr_layer0, grid, nz) SSP-RK2 averaging for a tracer: hTr = 0.5*(hTr0 + hTr).\nClamps the result to >= 0 inline; additional bounds (upper and/or\ntracer-specific lower) are enforced by ml_clamp_tracer if called\nafter this kernel. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hTr_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_save_tracer (hTr_layer, hTr_layer0, grid, nz) Save tracer field for RK2 averaging Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_seed_tracer (h_layer, hTr_layer, tr_uniform, tr_bottom, tr_surface, grid, nz) Seed one tracer’s hTr field, dispatching between the uniform and\nthe linear-stratified profile from the tracer’s IC scalars.  When\nboth tr_bottom and tr_surface are set (non-zero) and nz > 1 a\nlinear profile is laid down from tr_bottom at the bed (k=1) to tr_surface at the surface (k=nz); otherwise every layer is filled\nwith tr_uniform .  This is the single stratified-vs-uniform gate\nshared by all IC seed sites (rki_init, rki_api), so the polarity\nconvention lives in exactly one place.  Mirrors ml_seed_tracer_unstr . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_uniform real(kind=wp), intent(in) :: tr_bottom real(kind=wp), intent(in) :: tr_surface type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_settling_tracer (h_layer, hTr_layer, bed, w_s, grid, nz, dt) Constant-velocity downward settling of one tracer (e.g. suspended\nsediment), conservative + positivity-preserving.  Bottom-up\nconvention: k=1 is the bed layer, k=nz the surface.  The whole\nsuspended profile sinks at w_s ; whatever crosses the bed deposits\ninto the 2D bed reservoir, so total sum_k hTr + bed is conserved. Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: bed (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: w_s type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_vertical_diffusion_tracer (h_layer, hu_layer, hv_layer, hTr_layer, rho_layer, rho_0, nu_max, kappa_bg, ri_alpha, grid, nz, dt) Ri-dependent vertical diffusion of a scalar tracer (Pacanowski-Philander 1981).\nUses stronger Ri suppression for tracers: kappa_t = nu_max / (1 + alpha*Ri)&#94;3 + kappa_bg. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 Reference density (kg/m&#94;3) real(kind=wp), intent(in) :: nu_max Maximum turbulent viscosity (m&#94;2/s) real(kind=wp), intent(in) :: kappa_bg Background tracer diffusivity (m&#94;2/s) real(kind=wp), intent(in) :: ri_alpha Richardson number scaling coefficient type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_vertical_exchange_tracer (h_layer, hTr_layer, w, grid, nz, dt) Vertical tracer exchange using upwind advection at interfaces. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: w (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public  subroutine tracer_scratch_destroy (scratch) Detach and deallocate every allocated scratch group.  Called by\nthe solver at simulation end (mirror of tracer_scratch_ensure ). Arguments Type Intent Optional Attributes Name type( tracer_scratch_t ), intent(inout) :: scratch public  subroutine tracer_scratch_ensure (scratch, nx, ny, nz, want_ppm, want_upwind, want_hdiff, want_weno) Allocate (or resize) the caller-owned tracer-kernel scratch and\nattach it to the GPU.  Idempotent: a no-op once each requested\ngroup exists at the requested size; resizes if (nx,ny,nz) changes\n(e.g. a unit test re-running at a different grid size).  Each\ngroup is guarded so only the kernels actually in use allocate\n(PPM-only run skips the upwind snapshot and vice-versa). Read more… Arguments Type Intent Optional Attributes Name type( tracer_scratch_t ), intent(inout) :: scratch integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz logical, intent(in) :: want_ppm logical, 