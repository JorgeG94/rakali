k ) + hTr_layer ( i , j , k )) if ( hTr_layer ( i , j , k ) < 0.0_wp ) hTr_layer ( i , j , k ) = 0.0_wp end do end subroutine ml_rk2_average_tracer","tags":"","url":"proc/ml_rk2_average_tracer.html"},{"title":"ml_save_tracer – Rakali","text":"public pure subroutine ml_save_tracer(hTr_layer, hTr_layer0, grid, nz) Save tracer field for RK2 averaging Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Called by proc~~ml_save_tracer~~CalledByGraph proc~ml_save_tracer ml_save_tracer proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~ml_save_tracer proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: j integer, private :: k integer, private :: nx integer, private :: ny Source Code pure subroutine ml_save_tracer ( hTr_layer , hTr_layer0 , grid , nz ) !! Save tracer field for RK2 averaging type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: hTr_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( out ) :: hTr_layer0 ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny nx = grid % nx_total ny = grid % ny_total do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) hTr_layer0 ( i , j , k ) = hTr_layer ( i , j , k ) end do end subroutine ml_save_tracer","tags":"","url":"proc/ml_save_tracer.html"},{"title":"ml_seed_tracer – Rakali","text":"public pure subroutine ml_seed_tracer(h_layer, hTr_layer, tr_uniform, tr_bottom, tr_surface, grid, nz) Seed one tracer’s hTr field, dispatching between the uniform and\nthe linear-stratified profile from the tracer’s IC scalars.  When\nboth tr_bottom and tr_surface are set (non-zero) and nz > 1 a\nlinear profile is laid down from tr_bottom at the bed (k=1) to tr_surface at the surface (k=nz); otherwise every layer is filled\nwith tr_uniform .  This is the single stratified-vs-uniform gate\nshared by all IC seed sites (rki_init, rki_api), so the polarity\nconvention lives in exactly one place.  Mirrors ml_seed_tracer_unstr . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: tr_uniform real(kind=wp), intent(in) :: tr_bottom real(kind=wp), intent(in) :: tr_surface type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_seed_tracer~~CallsGraph proc~ml_seed_tracer ml_seed_tracer proc~ml_init_tracer ml_init_tracer proc~ml_seed_tracer->proc~ml_init_tracer proc~ml_init_tracer_stratified ml_init_tracer_stratified proc~ml_seed_tracer->proc~ml_init_tracer_stratified Help Graph Key Nodes of different colours represent the following: Graph Key