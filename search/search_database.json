.0_wp sigma = 0.0_wp end if if ( f_layer > 0.0_wp ) then ! Upwind cell c = j-1 (flowing north) avail_up = j - nghost ! avail_south(j-1) avail_down = ny - nghost - j + 2 ! avail_north(j-1) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i , j - 5 , k ), tr_snap ( i , j - 4 , k ), & tr_snap ( i , j - 3 , k ), tr_snap ( i , j - 2 , k ), & tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 3 , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i , j - 4 , k ), tr_snap ( i , j - 3 , k ), & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j + 2 , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i , j - 3 , k ), tr_snap ( i , j - 2 , k ), & tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j + 1 , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), sigma ) case default tr_face_val = tr_snap ( i , j - 1 , k ) ! donor end select flux_bot = f_layer * tr_face_val else if ( f_layer < 0.0_wp ) then ! Upwind cell c = j (flowing south — flip stencil) avail_up = ny - nghost - j + 2 ! avail_north(j-1) avail_down = j - nghost ! avail_south(j-1) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i , j + 4 , k ), tr_snap ( i , j + 3 , k ), & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), & tr_snap ( i , j - 1 , k ), tr_snap ( i , j - 2 , k ), & tr_snap ( i , j - 3 , k ), tr_snap ( i , j - 4 , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 1 , k ), tr_snap ( i , j , k ), & tr_snap ( i , j - 1 , k ), tr_snap ( i , j - 2 , k ), & tr_snap ( i , j - 3 , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), & tr_snap ( i , j - 1 , k ), tr_snap ( i , j - 2 , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i , j + 1 , k ), tr_snap ( i , j , k ), & tr_snap ( i , j - 1 , k ), sigma ) case default tr_face_val = tr_snap ( i , j , k ) ! donor end select flux_bot = f_layer * tr_face_val else flux_bot = 0.0_wp end if ! ---- y-direction: TOP face (between j and j+1) ---- f_layer = v_yT ( k ) + hf_yT ( k ) * inv_H_yT * corr_yT h_face = 0.5_wp * ( h_layer ( i , j , k ) + h_layer ( i , j + 1 , k )) if ( h_face > DRY_TOLERANCE ) then u_eff = f_layer / h_face sigma = min ( abs ( u_eff ) * dt * inv_dy , 1.0_wp ) else u_eff = 0.0_wp sigma = 0.0_wp end if if ( f_layer > 0.0_wp ) then ! Upwind cell c = j (flowing north) avail_up = j - nghost + 1 ! avail_south(j) avail_down = ny - nghost - j + 1 ! avail_north(j) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i , j - 4 , k ), tr_snap ( i , j - 3 , k ), & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), & tr_snap ( i , j + 1 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 4 , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i , j - 3 , k ), tr_snap ( i , j - 2 , k ), & tr_snap ( i , j - 1 , k ), tr_snap ( i , j , k ), & tr_snap ( i , j + 1 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 3 , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j , k ), & tr_snap ( i , j + 1 , k ), tr_snap ( i , j + 2 , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i , j - 1 , k ), tr_snap ( i , j , k ), & tr_snap ( i , j + 1 , k ), sigma ) case default tr_face_val = tr_snap ( i , j , k ) ! donor end select flux_top = f_layer * tr_face_val else if ( f_layer < 0.0_wp ) then ! Upwind cell c = j+1 (flowing south — flip stencil) avail_up = ny - nghost - j + 1 ! avail_north(j) avail_down = j - nghost + 1 ! avail_south(j) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i , j + 5 , k ), tr_snap ( i , j + 4 , k ), & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 3 , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i , j + 4 , k ), tr_snap ( i , j + 3 , k ), & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j - 2 , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), sigma ) case default tr_face_val = tr_snap ( i , j + 1 , k ) ! donor end select flux_top = f_layer * tr_face_val else flux_top = 0.0_wp end if ! Conservative update hTr_layer ( i , j , k ) = hTr_layer ( i , j , k ) & - dt * (( flux_right - flux_left ) * inv_dx & + ( flux_top - flux_bot ) * inv_dy ) end do ! k loop end if ! h_col > ML_MIN_DEPTH end do ! do concurrent(j, i) end associate end subroutine ml_advect_tracer_weno","tags":"","url":"proc/ml_advect_tracer_weno.html"},{"title":"protect_unstr – Rakali","text":"public  subroutine protect_unstr(state, mesh) Apply the negative-depth and shallow-cell guards. Adds the\nclipped negative mass to state%mass_error (does not reset). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh Calls proc~~protect_unstr~~CallsGraph proc~protect_unstr protect_unstr local local proc~protect_unstr->local reduce reduce proc~protect_unstr->reduce Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: eps4 real(kind=wp), private :: fr_max_sq real(kind=wp), private :: fr_scale real(kind=wp), private :: h real(kind=wp), private :: h4 integer, private :: k real(kind=wp), private :: mass_error_local real(kind=wp), private :: speed_sq real(kind=wp), private :: u_ds real(kind=wp), private :: v_ds Source Code subroutine protect_unstr ( state , mesh ) !! Apply the negative-depth and shallow-cell guards. Adds the !! clipped negative mass to `state%mass_error` (does not reset). type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: k real ( wp ) :: h real ( wp ) :: eps4 , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale real ( wp ) :: mass_error_local mass_error_local = 0.0_wp eps4 = DESING_EPS ** 4 do concurrent ( k = 1 : mesh % ncells_owned ) & local ( h , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale ) & reduce ( + : mass_error_local ) h = state % barotropic % stage_cv ( k ) - state % barotropic % bed_cv ( k ) if ( h < DRY_TOLERANCE ) then ! Dry (or negative) -- no meaningful velocity; zero momentum. state % barotropic % xmom_cv ( k ) = 0.0_wp state % barotropic % ymom_cv ( k ) = 0.0_wp else h4 = h ** 4 if ( h4 < eps4 ) then ! u = sqrt(2) h uh / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)); uh := h*u. ! Identity for h >= eps, so applied only below eps. u_ds = sqrt ( 2.0_wp ) * h * state % barotropic % xmom_cv ( k ) / sqrt ( h4 + eps4 ) v_ds = sqrt ( 2.0_wp ) * h * state % barotropic % ymom_cv ( k ) / sqrt ( h4 + eps4 ) state % barotropic % xmom_cv ( k ) = h * u_ds state % barotropic % ymom_cv ( k ) = h * v_ds end if ! Froude backstop: blowup arrester only (triggers on a TRUE ! comparison, so NaN passes through and fails loudly). speed_sq = ( state % barotropic % xmom_cv ( k ) ** 2 & + state % barotropic % ymom_cv ( k ) ** 2 ) / h ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) state % barotropic % xmom_cv ( k ) = state % barotropic % xmom_cv ( k ) * fr_scale state % barotropic % ymom_cv ( k ) = state % barotropic % ymom_cv ( k ) * fr_scale end if end if if ( h < 0.0_wp ) then ! Strictly negative -- clip stage to bed and remember the ! unphysical mass we just removed. mass_error_local = mass_error_local + ( - h ) * mesh % area ( k ) state % barotropic % stage_cv ( k ) = state % barotropic % bed_cv ( k ) end if end do ! Accumulate into the running mass-error tally on the state. state % mass_error = state % mass_error + mass_error_local end subroutine protect_unstr","tags":"","url":"proc/protect_unstr.html"},{"title":"ml_horizontal_viscosity_biharmonic – Rakali","text":"public  subroutine ml_horizontal_viscosity_biharmonic(h_layer, hu_layer, hv_layer, nu_4, grid, nz, dt) Biharmonic (del&#94;4) lateral viscosity on layer momentum:\nd(hu)/dt = -nu_4 h del&#94;2(del&#94;2 u) in two Laplacian passes (pass 1\nover interior + one ghost ring; pass 2 over the interior).\nScale-selective vs the harmonic Smagorinsky operator. nu_4 capped at the explicit stability limit\nnu_4 dt ((pi/dx)&#94;2+(pi/dy)&#94;2)&#94;2 <= 2.  Assumes nghost >= 2. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: nu_4 type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_horizontal_viscosity_biharmonic~~CallsGraph proc~ml_horizontal_viscosity_biharmonic ml_horizontal_viscosity_biharmonic local local proc~ml_horizontal_viscosity_biharmonic->local proc~bih_workspace_ensure bih_workspace_ensure proc~ml_horizontal_viscosity_biharmonic->proc~bih_workspace_ensure Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_horizontal_viscosity_biharmonic~~CalledByGraph proc~ml_horizontal_viscosity_biharmonic ml_horizontal_viscosity_biharmonic proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_horizontal_viscosity_biharmonic proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_horizontal_viscosity_biharmonic proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: PI = 3.14159265358979323846_wp real(kind=wp), private :: h_k integer, private :: i real(kind=wp), private :: inv_dx2 real(kind=wp), private :: inv_dy2 integer, private :: j integer, private :: k real(kind=wp), private :: lap2_u real(kind=wp), private :: lap2_v real(kind=wp), private :: lu_c real(kind=wp), private :: lu_im real(kind=wp), private :: lu_ip real(kind=wp), private :: lu_jm real(kind=wp), private :: lu_jp real(kind=wp), private :: lv_c real(kind=wp), private :: lv_im real(kind=wp), private :: lv_ip real(kind=wp), private :: lv_jm real(kind=wp), private :: lv_jp integer, private :: nghost real(kind=wp), private :: nu4_eff real(kind=wp), private :: nu4_max integer, private :: nx integer, private :: ny real(kind=wp), private :: u_c real(kind=wp), private :: u_im real(kind=wp), private :: u_ip real(kind=wp), private :: u_jm real(kind=wp), private :: u_jp real(kind=wp), private :: v_c real(kind=wp), private :: v_im real(kind=wp), private :: v_ip real(kind=wp), private :: v_jm real(kind=wp), private :: v_jp Source Code subroutine ml_horizontal_viscosity_biharmonic ( h_layer , hu_layer , hv_layer , & nu_4 , grid , nz , dt ) !! Biharmonic (del&#94;4) lateral viscosity on layer momentum: !! d(hu)/dt = -nu_4*h*del&#94;2(del&#94;2 u) in two Laplacian passes (pass 1 !! over interior + one ghost ring; pass 2 over the interior). !! Scale-selective vs the harmonic Smagorinsky operator.  `nu_4` !! capped at the explicit stability limit !! nu_4*dt*((pi/dx)&#94;2+(pi/dy)&#94;2)&#94;2 <= 2.  Assumes nghost >= 2. real ( wp ), parameter :: PI = 3.14159265358979323846_wp type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: nu_4 , dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: inv_dx2 , inv_dy2 , nu4_max , nu4_eff real ( wp ) :: h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm real ( wp ) :: lu_c , lu_ip , lu_im , lu_jp , lu_jm real ( wp ) :: lv_c , lv_ip , lv_im , lv_jp , lv_jm real ( wp ) :: lap2_u , lap2_v if ( nu_4 <= 0.0_wp ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost inv_dx2 = 1.0_wp / ( grid % dx * grid % dx ) inv_dy2 = 1.0_wp / ( grid % dy * grid % dy ) ! Explicit forward-step stability cap on nu_4. nu4_max = 2.0_wp / ( dt * ( PI * PI * inv_dx2 + PI * PI * inv_dy2 ) ** 2 + 1.0e-30_wp ) nu4_eff = min ( nu_4 , nu4_max ) call bih_workspace_ensure ( nx , ny , nz ) ! ---- Pass 1: L = del&#94;2(u), over interior + one ghost ring ---- do concurrent ( j = nghost : ny - nghost + 1 , i = nghost : nx - nghost + 1 ) & local ( k , h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm ) do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) then bih_lap_u ( i , j , k ) = 0.0_wp bih_lap_v ( i , j , k ) = 0.0_wp cycle end if u_c = hu_layer ( i , j , k ) / h_k v_c = hv_layer ( i , j , k ) / h_k if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_ip = hu_layer ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) v_ip = hv_layer ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) else u_ip = u_c v_ip = v_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_im = hu_layer ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) v_im = hv_layer ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) else u_im = u_c v_im = v_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jp = hu_layer ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) v_jp = hv_layer ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) else u_jp = u_c v_jp = v_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jm = hu_layer ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) v_jm = hv_layer ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) else u_jm = u_c v_jm = v_c end if bih_lap_u ( i , j , k ) = ( u_ip - 2.0_wp * u_c + u_im ) * inv_dx2 & + ( u_jp - 2.0_wp * u_c + u_jm ) * inv_dy2 bih_lap_v ( i , j , k ) = ( v_ip - 2.0_wp * v_c + v_im ) * inv_dx2 & + ( v_jp - 2.0_wp * v_c + v_jm ) * inv_dy2 end do end do ! ---- Pass 2: hu -= dt*h*nu_4*del&#94;2(L), over the interior ---- do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_k , lu_c , lu_ip , lu_im , lu_jp , lu_jm , & lv_c , lv_ip , lv_im , lv_jp , lv_jm , lap2_u , lap2_v ) do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle lu_c = bih_lap_u ( i , j , k ) lv_c = bih_lap_v ( i , j , k ) if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then lu_ip = bih_lap_u ( i + 1 , j , k ) lv_ip = bih_lap_v ( i + 1 , j , k ) else lu_ip = lu_c lv_ip = lv_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then lu_im = bih_lap_u ( i - 1 , j , k ) lv_im = bih_lap_v ( i - 1 , j , k ) else lu_im = lu_c lv_im = lv_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then lu_jp = bih_lap_u ( i , j + 1 , k ) lv_jp = bih_lap_v ( i , j + 1 , k ) else lu_jp = lu_c lv_jp = lv_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then lu_jm = bih_lap_u ( i , j - 1 , k ) lv_jm = bih_lap_v ( i , j - 1 , k ) else lu_jm = lu_c lv_jm = lv_c end if lap2_u = ( lu_ip - 2.0_wp * lu_c + lu_im ) * inv_dx2 & + ( lu_jp - 2.0_wp * lu_c + lu_jm ) * inv_dy2 lap2_v = ( lv_ip - 2.0_wp * lv_c + lv_im ) * inv_dx2 & + ( lv_jp - 2.0_wp * lv_c + lv_jm ) * inv_dy2 hu_layer ( i , j , k ) = hu_layer ( i , j , k ) - dt * h_k * nu4_eff * lap2_u hv_layer ( i , j , k ) = hv_layer ( i , j , k ) - dt * h_k * nu4_eff * lap2_v end do end do end subroutine ml_horizontal_viscosity_biharmonic","tags":"","url":"proc/ml_horizontal_viscosity_biharmonic.html"},{"title":"ml_horizontal_viscosity_cleanup – Rakali","text":"public  subroutine ml_horizontal_viscosity_cleanup() Release the lateral-viscosity persistent workspaces.  Called by the\nsolver at simulation end. Arguments None Called by proc~~ml_horizontal_viscosity_cleanup~~CalledByGraph proc~ml_horizontal_viscosity_cleanup ml_horizontal_viscosity_cleanup proc~horvisc_workspace_ensure horvisc_workspace_ensure proc~horvisc_workspace_ensure->proc~ml_horizontal_viscosity_cleanup proc~solver_exit_data solver_exit_data proc~solver_exit_data->proc~ml_horizontal_viscosity_cleanup proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_exit_data proc~flush_restart flush_restart proc~driver_run_coastal->proc~flush_restart proc~flush_snapshot flush_snapshot proc~driver_run_coastal->proc~flush_snapshot proc~ensure_host~2 ensure_host proc~ensure_host~2->proc~solver_exit_data proc~flush_restart->proc~solver_exit_data proc~flush_snapshot->proc~solver_exit_data proc~ml_horizontal_viscosity_smag ml_horizontal_viscosity_smag proc~ml_horizontal_viscosity_smag->proc~horvisc_workspace_ensure proc~rki_destroy rki_destroy proc~rki_destroy->proc~solver_exit_data proc~rki_sync_from_device rki_sync_from_device proc~rki_sync_from_device->proc~solver_exit_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~rki_get_b_ptr rki_get_b_ptr proc~rki_get_b_ptr->proc~ensure_host~2 proc~rki_get_h0_ptr rki_get_h0_ptr proc~rki_get_h0_ptr->proc~ensure_host~2 proc~rki_get_h_layer_ptr rki_get_h_layer_ptr proc~rki_get_h_layer_ptr->proc~ensure_host~2 proc~rki_get_h_ptr rki_get_h_ptr proc~rki_get_h_ptr->proc~ensure_host~2 proc~rki_get_hu0_ptr rki_get_hu0_ptr proc~rki_get_hu0_ptr->proc~ensure_host~2 proc~rki_get_hu_layer_ptr rki_get_hu_layer_ptr proc~rki_get_hu_layer_ptr->proc~ensure_host~2 proc~rki_get_hu_ptr rki_get_hu_ptr proc~rki_get_hu_ptr->proc~ensure_host~2 proc~rki_get_hv0_ptr rki_get_hv0_ptr proc~rki_get_hv0_ptr->proc~ensure_host~2 proc~rki_get_hv_layer_ptr rki_get_hv_layer_ptr proc~rki_get_hv_layer_ptr->proc~ensure_host~2 proc~rki_get_hv_ptr rki_get_hv_ptr proc~rki_get_hv_ptr->proc~ensure_host~2 proc~rki_get_salinity_ptr rki_get_salinity_ptr proc~rki_get_salinity_ptr->proc~ensure_host~2 proc~rki_get_temperature_ptr rki_get_temperature_ptr proc~rki_get_temperature_ptr->proc~ensure_host~2 proc~rki_set_bathymetry rki_set_bathymetry proc~rki_set_bathymetry->proc~ensure_host~2 proc~rki_set_initial_h rki_set_initial_h proc~rki_set_initial_h->proc~ensure_host~2 proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_horizontal_viscosity_smag proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_horizontal_viscosity_smag proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine ml_horizontal_viscosity_cleanup () !! Release the lateral-viscosity persistent workspaces.  Called by the !! solver at simulation end. if ( allocated ( horvisc_hu_pre )) then !$acc exit data delete(horvisc_hu_pre, horvisc_hv_pre) deallocate ( horvisc_hu_pre , horvisc_hv_pre ) end if if ( allocated ( bih_lap_u )) then !$acc exit data delete(bih_lap_u, bih_lap_v) deallocate ( bih_lap_u , bih_lap_v ) end if end subroutine ml_horizontal_viscosity_cleanup","tags":"","url":"proc/ml_horizontal_viscosity_cleanup.html"},{"title":"ml_horizontal_viscosity_smag – Rakali","text":"public  subroutine ml_horizontal_viscosity_smag(h_layer, hu_layer, hv_layer, cs, grid, nz, dt) Smagorinsky (1963) horizontal viscosity for layer momentum:\nnu_h = (Cs delta)&#94;2 |S| Laplacian diffusion, delta=sqrt(dx*dy). Read-write hazard: the update reads neighbour velocities while\nwriting the own cell. do concurrent is Jacobi on GPU but\nsequential (Gauss-Seidel) on CPU, so we snapshot hu/hv_layer into\nfrozen scratch and read neighbours from it for bit-identical\nresults across backends. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: cs type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_horizontal_viscosity_smag~~CallsGraph proc~ml_horizontal_viscosity_smag ml_horizontal_viscosity_smag local local proc~ml_horizontal_viscosity_smag->local proc~horvisc_workspace_ensure horvisc_workspace_ensure proc~ml_horizontal_viscosity_smag->proc~horvisc_workspace_ensure proc~ml_horizontal_viscosity_cleanup ml_horizontal_viscosity_cleanup proc~horvisc_workspace_ensure->proc~ml_horizontal_viscosity_cleanup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_horizontal_viscosity_smag~~CalledByGraph proc~ml_horizontal_viscosity_smag ml_horizontal_viscosity_smag proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_horizontal_viscosity_smag proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_horizontal_viscosity_smag proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: delta2 real(kind=wp), private :: dudx real(kind=wp), private :: dudy real(kind=wp), private :: dvdx real(kind=wp), private :: dvdy real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: h_col real(kind=wp), private :: h_k integer, private :: i real(kind=wp), private :: inv_2dx real(kind=wp), private :: inv_2dy real(kind=wp), private :: inv_dx real(kind=wp), private :: inv_dy integer, private :: j integer, private :: k integer, private :: kk real(kind=wp), private :: lap_u real(kind=wp), private :: lap_v integer, private :: nghost real(kind=wp), private :: nu_h real(kind=wp), private :: nu_max integer, private :: nx integer, private :: ny real(kind=wp), private :: strain real(kind=wp), private :: u_c real(kind=wp), private :: u_im real(kind=wp), private :: u_ip real(kind=wp), private :: u_jm real(kind=wp), private :: u_jp real(kind=wp), private :: v_c real(kind=wp), private :: v_im real(kind=wp), private :: v_ip real(kind=wp), private :: v_jm real(kind=wp), private :: v_jp Source Code subroutine ml_horizontal_viscosity_smag ( h_layer , hu_layer , hv_layer , & cs , grid , nz , dt ) !! Smagorinsky (1963) horizontal viscosity for layer momentum: !! nu_h = (Cs*delta)&#94;2*|S| Laplacian diffusion, delta=sqrt(dx*dy). !! !! Read-write hazard: the update reads neighbour velocities while !! writing the own cell.  `do concurrent` is Jacobi on GPU but !! sequential (Gauss-Seidel) on CPU, so we snapshot hu/hv_layer into !! frozen scratch and read neighbours from it for bit-identical !! results across backends. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: cs , dt integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: delta2 , inv_dx , inv_dy , inv_2dx , inv_2dy , nu_max , h_col real ( wp ) :: h_k , u_c , v_c real ( wp ) :: u_ip , u_im , u_jp , u_jm , v_ip , v_im , v_jp , v_jm real ( wp ) :: dudx , dvdy , dudy , dvdx real ( wp ) :: strain , nu_h , lap_u , lap_v nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy if ( cs <= 0.0_wp ) return delta2 = cs * cs * dx * dy inv_dx = 1.0_wp / dx inv_dy = 1.0_wp / dy inv_2dx = 0.5_wp * inv_dx inv_2dy = 0.5_wp * inv_dy ! Stability: nu_h * dt * (1/dx&#94;2 + 1/dy&#94;2) <= 0.5 nu_max = 0.5_wp / ( dt * ( inv_dx * inv_dx + inv_dy * inv_dy ) + 1.0e-30_wp ) call horvisc_workspace_ensure ( nx , ny , nz ) associate ( hu_pre => horvisc_hu_pre , hv_pre => horvisc_hv_pre ) ! Snapshot the input momentum so neighbour reads come from the ! pre-update image on every backend. do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) hu_pre ( i , j , k ) = hu_layer ( i , j , k ) hv_pre ( i , j , k ) = hv_layer ( i , j , k ) end do do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_k , u_c , v_c , u_ip , u_im , u_jp , u_jm , & v_ip , v_im , v_jp , v_jm , dudx , dvdy , dudy , dvdx , & strain , nu_h , lap_u , lap_v , h_col ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col < ML_MIN_DEPTH ) cycle do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k < THIN_LAYER_THRESHOLD ) cycle ! Centre velocity u_c = hu_pre ( i , j , k ) / h_k v_c = hv_pre ( i , j , k ) / h_k ! Neighbour velocities (zero-gradient at dry cells) if ( h_layer ( i + 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_ip = hu_pre ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) v_ip = hv_pre ( i + 1 , j , k ) / h_layer ( i + 1 , j , k ) else u_ip = u_c v_ip = v_c end if if ( h_layer ( i - 1 , j , k ) > THIN_LAYER_THRESHOLD ) then u_im = hu_pre ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) v_im = hv_pre ( i - 1 , j , k ) / h_layer ( i - 1 , j , k ) else u_im = u_c v_im = v_c end if if ( h_layer ( i , j + 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jp = hu_pre ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) v_jp = hv_pre ( i , j + 1 , k ) / h_layer ( i , j + 1 , k ) else u_jp = u_c v_jp = v_c end if if ( h_layer ( i , j - 1 , k ) > THIN_LAYER_THRESHOLD ) then u_jm = hu_pre ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) v_jm = hv_pre ( i , j - 1 , k ) / h_layer ( i , j - 1 , k ) else u_jm = u_c v_jm = v_c end if ! Strain rate components (central differences) dudx = ( u_ip - u_im ) * inv_2dx dvdy = ( v_jp - v_jm ) * inv_2dy dudy = ( u_jp - u_jm ) * inv_2dy dvdx = ( v_ip - v_im ) * inv_2dx ! |S| = sqrt( (du/dx - dv/dy)&#94;2 + (du/dy + dv/dx)&#94;2 ) strain = sqrt (( dudx - dvdy ) ** 2 + ( dudy + dvdx ) ** 2 ) ! Smagorinsky viscosity with stability limiter nu_h = min ( delta2 * strain , nu_max ) ! Laplacian of velocity lap_u = ( u_ip - 2.0_wp * u_c + u_im ) * inv_dx * inv_dx & + ( u_jp - 2.0_wp * u_c + u_jm ) * inv_dy * inv_dy lap_v = ( v_ip - 2.0_wp * v_c + v_im ) * inv_dx * inv_dx & + ( v_jp - 2.0_wp * v_c + v_jm ) * inv_dy * inv_dy ! Update momentum -- read from the frozen pre-image, write ! to the live array so later iterations see the old state. hu_layer ( i , j , k ) = hu_pre ( i , j , k ) + dt * h_k * nu_h * lap_u hv_layer ( i , j , k ) = hv_pre ( i , j , k ) + dt * h_k * nu_h * lap_v end do end do end associate end subroutine ml_horizontal_viscosity_smag","tags":"","url":"proc/ml_horizontal_viscosity_smag.html"},{"title":"bih_workspace_ensure – Rakali","text":"private  subroutine bih_workspace_ensure(nx, ny, nz) Lazy-allocate the biharmonic intermediate-Laplacian scratch. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz Called by proc~~bih_workspace_ensure~~CalledByGraph proc~bih_workspace_ensure bih_workspace_ensure proc~ml_horizontal_viscosity_biharmonic ml_horizontal_viscosity_biharmonic proc~ml_horizontal_viscosity_biharmonic->proc~bih_workspace_ensure proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_horizontal_viscosity_biharmonic proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_horizontal_viscosity_biharmonic proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: need_alloc Source Code subroutine bih_workspace_ensure ( nx , ny , nz ) !! Lazy-allocate the biharmonic intermediate-Laplacian scratch. integer , intent ( in ) :: nx , ny , nz logical :: need_alloc need_alloc = . false . if (. not . allocated ( bih_lap_u )) then need_alloc = . true . else if ( size ( bih_lap_u , 1 ) /= nx . or . & size ( bih_lap_u , 2 ) /= ny . or . & size ( bih_lap_u , 3 ) /= nz ) then !$acc exit data delete(bih_lap_u, bih_lap_v) deallocate ( bih_lap_u , bih_lap_v ) need_alloc = . true . end if if ( need_alloc ) then allocate ( bih_lap_u ( nx , ny , nz ), bih_lap_v ( nx , ny , nz )) !$acc enter data create(bih_lap_u, bih_lap_v) end if end subroutine bih_workspace_ensure","tags":"","url":"proc/bih_workspace_ensure.html"},{"title":"horvisc_workspace_ensure – Rakali","text":"private  subroutine horvisc_workspace_ensure(nx, ny, nz) Lazy-allocate the Smagorinsky momentum-snapshot scratch. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: nz Calls proc~~horvisc_workspace_ensure~~CallsGraph proc~horvisc_workspace_ensure horvisc_workspace_ensure proc~ml_horizontal_viscosity_cleanup ml_horizontal_viscosity_cleanup proc~horvisc_workspace_ensure->proc~ml_horizontal_viscosity_cleanup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program Th