ule. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: nc integer, private :: ncc Source Code recursive subroutine agglom_vcycle ( this , l ) !! One V(nu_pre,nu_post) cycle solving Ahat*e = r on level l from ZERO. !! On entry lev(l)%r holds the RHS; on exit lev(l)%e holds the solution. class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this integer , intent ( in ) :: l integer :: nc , ncc nc = this % lev ( l )% nc call agglom_zero ( this % lev ( l )% e , nc ) if ( l == this % n_levels ) then call agglom_jacobi_sweeps ( this % lev ( l )% e , this % lev ( l )% r , this % lev ( l )% tmp , & this % lev ( l )% nbr , this % lev ( l )% ke , & this % lev ( l )% diag , this % lev ( l )% dinv , & this % lev ( l )% mv , nc , & AGGLOM_OMEGA , AGGLOM_COARSE_SWEEPS ) return end if call agglom_jacobi_sweeps ( this % lev ( l )% e , this % lev ( l )% r , this % lev ( l )% tmp , & this % lev ( l )% nbr , this % lev ( l )% ke , & this % lev ( l )% diag , this % lev ( l )% dinv , & this % lev ( l )% mv , nc , & AGGLOM_OMEGA , AGGLOM_NU_PRE ) call agglom_residual ( this % lev ( l )% e , this % lev ( l )% r , this % lev ( l )% tmp , & this % lev ( l )% nbr , this % lev ( l )% ke , this % lev ( l )% diag , & this % lev ( l )% mv , nc ) ncc = this % lev ( l + 1 )% nc call agglom_restrict ( this % lev ( l )% tmp , this % lev ( l + 1 )% r , & this % lev ( l + 1 )% mstart , this % lev ( l + 1 )% mlist , ncc , nc ) call agglom_vcycle ( this , l + 1 ) call agglom_prolong_add ( this % lev ( l + 1 )% e , this % lev ( l )% e , & this % lev ( l )% agg_of , nc , ncc ) call agglom_jacobi_sweeps ( this % lev ( l )% e , this % lev ( l )% r , this % lev ( l )% tmp , & this % lev ( l )% nbr , this % lev ( l )% ke , & this % lev ( l )% diag , this % lev ( l )% dinv , & this % lev ( l )% mv , nc , & AGGLOM_OMEGA , AGGLOM_NU_POST ) end subroutine agglom_vcycle","t