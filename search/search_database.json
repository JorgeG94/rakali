p real(kind=wp), private, parameter :: NUT_MAX = 10.0_wp real(kind=wp), private, parameter :: NUT_MIN = 1.0e-6_wp real(kind=wp), private, parameter :: PR_T = 1.0_wp real(kind=wp), private, parameter :: SIG_E = 1.3_wp real(kind=wp), private, parameter :: SIG_K = 1.0_wp real(kind=wp), private, parameter :: Z0_BED = 0.01_wp real(kind=wp), private, parameter :: Z0_SURF = 0.01_wp Subroutines public pure subroutine ml_keps_apply_diffusion_tracer (h_layer, hTr, kt, kappa_bg, grid, nz, dt) Implicit (Thomas) vertical diffusion of one tracer using k-eps\ndiffusivity kt (interface-shaped) plus background floor kappa_bg .\nNo-flux at bed/surface (surface tracer fluxes are a separate kernel);\nconserves column tracer content sum_k hTr_k exactly. Implicit (not\nexplicit PP81) because kt can reach NUT_MAX. Pass tracers(it)%hTr . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hTr (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: kt (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(in) :: kappa_bg type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_keps_apply_momentum (h_layer, hu_layer, hv_layer, nut, grid, nz, dt) Apply k-epsilon eddy viscosity nut (interface-shaped nz+1, from ml_keps_update ) to layer momentum via an implicit (Thomas) vertical-\ndiffusion sweep. No-flux at bed/surface (wind stress and bottom drag\nare separate kernels); conserves column total sum_k h_k u_k exactly.\nImplicit (not explicit PP81) because nu_t can reach NUT_MAX. One do concurrent over columns; shared matrix, two RHS (u, v). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: nut (grid%nx_total,grid%ny_total,nz+1) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt public pure subroutine ml_keps_friction_velocities (wind_x, wind_y, h_layer, hu_layer, hv_layer, manning_n, use_linear_drag, drag_r, rho_0, ustar_s, ustar_b, grid, nz) Per-column surface and bed friction velocities feeding the k-eps\nwall functions ( ml_keps_update ).\n  surface: u_ s = sqrt(|tau_wind| / rho_0), tau_wind = (wind_x,\n           wind_y) the wind-stress components (Pa).\n  bed:     from the active bottom-drag law — quadratic Manning\n           u_ b = sqrt(C_d) |u_b|, C_d = g n&#94;2 / H&#94;(1/3); or linear\n           (Rayleigh) u_ b = sqrt(r * h_b * |u_b|).\nBottom velocity is the k=1 (bed) layer; H is the column depth. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: manning_n logical, intent(in) :: use_linear_drag real(kind=wp), intent(in) :: drag_r real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(out) :: ustar_s (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: ustar_b (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz public pure subroutine ml_keps_update (h_layer, hu_layer, hv_layer, rho_layer, tke, eps, nut, kt, rho_0, dt, grid, nz, ustar_b, ustar_s, scheme) Advance k and eps one step per column and recover nu_t / kappa_t. tke , eps , nut , kt are interface-shaped (nz+1); tke / eps / nut carry state across steps (the diffusion reads the old nut ). Read more… Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: tke (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(inout) :: eps (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(inout) :: nut (grid%nx_total,grid%ny_total,nz+1) real(kind=wp), intent(inout) :: kt (grid%nx_total,grid%ny_total,nz+1) Scalar diffusivity, carried across steps: the buoyancy term reads\nthe old value, so a stratification-aware scheme stays consistent. real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: dt type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in), optional :: ustar_b (grid%nx_total,grid%ny_total) Bed friction velocity sqrt(|tau_b|/rho_0) (m/s), per column. real(kind=wp), intent(in), optional :: ustar_s (grid%nx_total,grid%ny_total) Surface friction velocity sqrt(|tau_wind|/rho_0) (m/s), per column. integer, intent(in), optional :: scheme Stability-function scheme (KEPS_STAB_*): absent / CONSTANT -> the\nstandard constant c_mu = 0.09 (bit-identical to the original);\nGALPERIN -> stratification-aware quasi-equilibrium. private pure subroutine keps_tridiag_solve (a, b, c, rhs, cp, ni) In-place Thomas solve over interfaces 1..ni with zero-gradient\n(no-flux) boundary rows. rhs returns the solution; cp scratch. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: a (ni) real(kind=wp), intent(inout) :: b (ni) real(kind=wp), intent(inout) :: c (ni) real(kind=wp), intent(inout) :: rhs (ni) real(kind=wp), intent(inout) :: cp (ni) integer, intent(in) :: ni private pure subroutine keps_tridiag_solve_noflux (a, b, c, rhs, cp, n) In-place Thomas solve over rows 1..n with the boundary closure\nalready baked into a/b/c by the caller (no row override, unlike keps_tridiag_solve ). rhs returns the solution; cp scratch.\na/b/c are read-only so one factorisation can serve multiple RHS. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: a (n) real(kind=wp), intent(in) :: b (n) real(kind=wp), intent(in) :: c (n) real(kind=wp), intent(inout) :: rhs (n) real(kind=wp), intent(inout) :: cp (n) integer, intent(in) :: n","tags":"","url":"module/rki_ml_keps.html"},{"title":"rki_si_unstr_closures – Rakali","text":"Q1 (SI vertical-mixing closures) for the unstructured backend.\nThe SI column solve consumes ANY interface viscosity through state%si%nu_iface ; closures are pure FILLS of that slot.  This module\nholds the flat explicit-shape fill kernels on the (nz, ncells) layout: si_unstr_fill_nu_iface_from_keps — copy the k-epsilon keps_nut (interface-shaped (nz+1, n), advanced by the UNCHANGED ml_keps_update_unstr at SI cadence — the explicit kernel is already\n  backward-Euler/Patankar) into nu_iface , with the SI convention’s\n  bed/surface zero rows and the vanished-layer decoupling gate. si_unstr_keps_copy_iface — interface-array copy for the optional keps_si_picard > 1 save/restore of the pre-step k / eps. si_unstr_build_nu_interface_kpp — PP81 interior viscosity with the\n  KPP (LMD94) shape-function overlay MAX’d in, written to nu_iface for\n  the IMPLICIT column tridiagonal.  NO explicit-flux CFL clamp — the\n  coastal explicit ml_kpp_viscosity_unstr clamp would strangle the\n  overlay at SI step sizes (dt = 120-480 s); the implicit solve is\n  unconditionally stable at any nu. si_unstr_kpp_diffusion_tracers — S/T IMPLICIT (Thomas) vertical\n  diffusion with the PP81-cubic + KPP-overlay diffusivity, plus the\n  LMD94 non-local counter-gradient transport applied after the diffusion\n  (the coastal explicit order: vdiff-then-nonlocal), reading the\n  post-diffusion surface salinity for F_S.  Conserves column tracer\n  content (no-flux tridiagonal, conservative nonlocal divergence). Layer convention (load-bearing): BOTTOM-UP — k=1 bed, k=nz surface;\ninterface m sits BELOW layer m (m=1 bed, m=nz+1 surface).  Cell-centric do concurrent over cells; per-column serial work in-body with\nNZ_STACK_MAX locals; explicit-shape dummies throughout (NVHPC rule). Uses rki_constants rki_ml_common_unstr module~~rki_si_unstr_closures~~UsesGraph module~rki_si_unstr_closures rki_si_unstr_closures module~rki_constants rki_constants module~rki_si_unstr_closures->module~rki_constants module~rki_ml_common_unstr rki_ml_common_unstr module~rki_si_unstr_closures->module~rki_ml_common_unstr pic_types pic_types module~rki_constants->pic_types module~rki_ml_common_unstr->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_si_unstr_closures~~UsedByGraph module~rki_si_unstr_closures rki_si_unstr_closures module~rki_si_unstr_step_ml rki_si_unstr_step_ml module~rki_si_unstr_step_ml->module~rki_si_unstr_closures module~rki_solver_unstr rki_solver_unstr module~rki_solver_unstr->module~rki_si_unstr_step_ml module~rki_api_unstr rki_api_unstr module~rki_api_unstr->module~rki_solver_unstr module~rki_driver rki_driver module~rki_driver->module~rki_solver_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: SHEAR2_EPS = 1.0e-20_wp Shear&#94;2 floor in the interior gradient-Ri (matches PP81 + kpp kernels). Subroutines public pure subroutine si_unstr_build_nu_interface_kpp (nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, rho_layer, rho_0, nu_max, nu_bg, ri_alpha, u_star, buoy_flux, bl_depth, nu_iface) PP81 interior interface viscosity with the KPP (LMD94) surface-\nboundary-layer overlay MAX’d in, for the SI implicit column solve:\n  nu = max( nu_max/(1+ri_alpha Ri)&#94;2 + nu_bg,\n            h_b * w_s * G(sigma) )        for interfaces inside h_b\nwith G(sigma) = sigma(1-sigma)&#94;2, sigma = d_iface/h_b, and the\nvelocity scale w_s = sqrt(u_ &#94;2 + w_ &#94;2), w_ &#94;3 = max(0,-B_0)*h_b.\nNO dt clamp: the consumer is the unconditionally-stable implicit\ntridiagonal.  Where the overlay is inactive (w_s = 0 / below the\nBL) the result is EXACTLY the PP81 si_unstr_build_nu_interface value. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up. real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s]. real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(in) :: rho_layer (nz,nct) Layer densities [kg/m&#94;3]. real(kind=wp), intent(in) :: rho_0 Reference density [kg/m&#94;3]. real(kind=wp), intent(in) :: nu_max PP81 maximum turbulent viscosity [m&#94;2/s]. real(kind=wp), intent(in) :: nu_bg Background viscosity floor [m&#94;2/s]. real(kind=wp), intent(in) :: ri_alpha PP81 Richardson tuning coefficient. real(kind=wp), intent(in) :: u_star (nct) Surface friction velocity [m/s] (from ml_kpp_boundary_layer_unstr). real(kind=wp), intent(in) :: buoy_flux (nct) Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real(kind=wp), intent(in) :: bl_depth (nct) Diagnosed boundary-layer depth [m]. real(kind=wp), intent(out) :: nu_iface (nzp1,nct) Interface viscosity [m&#94;2/s], vdiff convention (bed/surface 0). public pure subroutine si_unstr_fill_nu_iface_from_keps (nz, nzp1, nct, nco, h_layer, keps_nut, nu_iface) Copy the k-epsilon interface viscosity into the SI column-solve slot. keps_nut and nu_iface share the interface convention (m=1 bed,\nm=nz+1 surface); interior interfaces copy 1:1; bed and surface rows\nare forced to 0 (no flux through bed/surface — wind and drag enter\nthe column solve separately), and an interface bounded by a vanished\nlayer decouples (nu = 0), mirroring si_unstr_build_nu_interface so the closure swap changes ONLY the viscosity values. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up (k=1 bed). real(kind=wp), intent(in) :: keps_nut (nzp1,nct) k-epsilon interface eddy viscosity [m&#94;2/s] (from ml_keps_update_unstr). real(kind=wp), intent(out) :: nu_iface (nzp1,nct) SI interface viscosity [m&#94;2/s], vdiff convention. public pure subroutine si_unstr_keps_copy_iface (nzp1, nct, nco, src, dst) Interface-array copy (nzp1, nct) for the keps_si_picard > 1 save/restore: the Picard loop re-runs ml_keps_update_unstr from\nthe SAME pre-step k / eps with the refreshed nu_t production\ncoefficient (see local_archive/prototypes/si_closures/DISCRETIZATION_SPEC.md\nsection 3). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nzp1 Interface count (nz + 1). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: src (nzp1,nct) Source interface array. real(kind=wp), intent(out) :: dst (nzp1,nct) Destination interface array. public pure subroutine si_unstr_kpp_diffusion_tracers (nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, hS_layer, hT_layer, rho_layer, rho_0, nu_max, kappa_S_bg, kappa_T_bg, ri_alpha, cs_nonlocal, heat_flux, evap_minus_precip, cp, u_star, buoy_flux, bl_depth, dt) S/T vertical diffusion with the KPP overlay for the SI step:\nIMPLICIT (Thomas) column solve with the PP81-CUBIC interior\ndiffusivity + the KPP shape-function overlay MAX’d in (same\noverlay as momentum; no dt clamp — implicit), then the LMD94\nnon-local counter-gradient transport applied as a conservative\ninterface divergence AFTER the diffusion (the coastal explicit\norder: vdiff-then-nonlocal), reading the post-diffusion surface\nsalinity for F_S.  gamma = 0 at bed and surface => the divergence\nconserves the column integral exactly.  Conserves column tracer\ncontent (no-flux tridiagonal). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up. real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s] (shear for the PP81 Ri). real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(inout) :: hS_layer (nz,nct) Salinity content [PSU m], updated in place. real(kind=wp), intent(inout) :: hT_layer (nz,nct) Temperature content [degC m], updated in place. real(kind=wp), intent(in) :: rho_layer (nz,nct) Layer densities [kg/m&#94;3]. real(kind=wp), intent(in) :: rho_0 Reference density [kg/m&#94;3]. real(kind=wp), intent(in) :: nu_max PP81 maximum turbulent diffusivity scale [m&#94;2/s]. real(kind=wp), intent(in) :: kappa_S_bg Background salinity diffusivity [m&#94;2/s]. real(kind=wp), intent(in) :: kappa_T_bg Background temperature diffusivity [m&#94;2/s]. real(kind=wp), intent(in) :: ri_alpha PP81 Richardson tuning coefficient. real(kind=wp), intent(in) :: cs_nonlocal Non-local transport coefficient C_s (LMD94 eq 20). real(kind=wp), intent(in) :: heat_flux (nct) Surface heat flux [W/m&#94;2] (positive warms), per cell. real(kind=wp), intent(in) :: evap_minus_precip (nct) Net evaporation [m/s], per cell. real(kind=wp), intent(in) :: cp Specific heat of water [J/(kg K)]. real(kind=wp), intent(in) :: u_star (nct) Surface friction velocity [m/s]. real(kind=wp), intent(in) :: buoy_flux (nct) Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real(kind=wp), intent(in) :: bl_depth (nct) Diagnosed boundary-layer depth [m]. real(kind=wp), intent(in) :: dt Time step [s]. private pure subroutine si_unstr_tridiag_noflux (a, b, c, rhs, cpv, n) In-place Thomas solve over rows 1..n with the boundary closure\nbaked into a/b/c by the caller (the no-flux tridiagonal closure). rhs returns the solution. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: a (n) real(kind=wp), intent(in) :: b (n) real(kind=wp), intent(in) :: c (n) real(kind=wp), intent(inout) :: rhs (n) real(kind=wp), intent(inout) :: cpv (n) integer, intent(in) :: n","tags":"","url":"module/rki_si_unstr_closures.html"},{"title":"rki_kernel_timestep – Rakali","text":"Maximum stable timestep from the CFL condition:\ndt = cfl * min(dx, dy) / max_wavespeed,\nmax_wavespeed = max(|u| + sqrt(g h), |v| + sqrt(g h)). Uses rki_grid rki_constants module~~rki_kernel_timestep~~UsesGraph module~rki_kernel_timestep rki_kernel_timestep module~rki_constants rki_constants module~rki_kernel_timestep->module~rki_constants module~rki_grid rki_grid module~rki_kernel_timestep->module~rki_grid pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_kernel_timestep~~UsedByGraph module~rki_kernel_timestep rki_kernel_timestep module~rki_solver rki_solver module~rki_solver->module~rki_kernel_timestep module~rki_api rki_api module~rki_api->module~rki_solver module~rki_driver rki_driver module~rki_driver->module~rki_solver Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Subroutines public  subroutine compute_timestep (h, hu, hv, grid, cfl, dt) Maximum stable timestep: reduces over interior cells for the max\nwave speed, then dt = cfl * min(dx,dy) / max_wavespeed. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: cfl CFL number real(kind=wp), intent(out) :: dt Computed timestep (s) public  subroutine compute_timestep_baroclinic (h, u_layer, v_layer, dsig, grid, nz, cfl, dt) Baroclinic timestep from the internal-wave CFL:\nmax(|u_layer_k| + c_int)/dx, c_int = sqrt(g*H/nz) (uniform sigma). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: cfl real(kind=wp), intent(out) :: dt","tags":"","url":"module/rki_kernel_timestep.html"},{"title":"rki_kernel_flux_unstr – Rakali","text":"Net flux divergence at every owned cell via the\nKurganov-Noelle-Petrova central-upwind scheme on triangles. Cell-centric: each triangle loops its three edges, computes the\ncentral-upwind flux from both sides, and accumulates ONLY into its\nown update arrays. Each interior edge is visited twice (once per\nneighbour) – no scatter, no race, no atomics – which is what\nmakes the kernel safe for do concurrent on GPU. Boundary edges\n( mesh%neighbours(i, k) < 0 ) dispatch per-edge BC state; group 0\nfalls through to BC_WALL (normal-momentum mirror). The\nwell-balanced gravity bed-slope source is added per cell, then\naccumulators are normalised by area to flux divergence (per unit\narea), ready to be multiplied by dt in the update step. Uses rki_mesh_unstr rki_boundary_unstr rki_state_unstr rki_constants module~~rki_kernel_flux_unstr~~UsesGraph module~rki_kernel_flux_unstr rki_kernel_flux_unstr module~rki_boundary_unstr rki_boundary_unstr module~rki_kernel_flux_unstr->module~rki_boundary_unstr module~rki_constants rki_constants module~rki_kernel_flux_unstr->module~rki_constants module~rki_mesh_unstr rki_mesh_unstr module~rki_kernel_flux_unstr->module~rki_mesh_unstr module~rki_state_unstr rki_state_unstr module~rki_kernel_flux_unstr->module~rki_state_unstr pic_types pic_types module~rki_constants->pic_types module~rki_mesh_unstr->module~rki_constants pic_io pic_io module~rki_mesh_unstr->pic_io pic_logger pic_logger module~rki_mesh