=wp), private :: flux_right real(kind=wp), private :: flux_top real(kind=wp), private :: h_col real(kind=wp), private :: h_face real(kind=wp), private :: h_iL real(kind=wp), private :: h_iR real(kind=wp), private :: h_jB real(kind=wp), private :: h_jT real(kind=wp), private :: h_val real(kind=wp), private :: hf_xL (NZ_STACK_MAX) real(kind=wp), private :: hf_xR (NZ_STACK_MAX) real(kind=wp), private :: hf_yB (NZ_STACK_MAX) real(kind=wp), private :: hf_yT (NZ_STACK_MAX) integer, private :: i real(kind=wp), private :: inv_H_xL real(kind=wp), private :: inv_H_xR real(kind=wp), private :: inv_H_yB real(kind=wp), private :: inv_H_yT real(kind=wp), private :: inv_dx real(kind=wp), private :: inv_dy integer, private :: j integer, private :: k integer, private :: kk integer, private :: nghost integer, private :: nx integer, private :: ny integer, private :: rung integer, private :: rung_max_int real(kind=wp), private :: sigma real(kind=wp), private :: tr_face_val real(kind=wp), private :: u_eff real(kind=wp), private :: v_xL (NZ_STACK_MAX) real(kind=wp), private :: v_xR (NZ_STACK_MAX) real(kind=wp), private :: v_yB (NZ_STACK_MAX) real(kind=wp), private :: v_yT (NZ_STACK_MAX) Source Code pure subroutine ml_advect_tracer_weno ( h_layer , hu_layer , hv_layer , & mass_flux_x , mass_flux_y , & hTr_layer , weno_tr_snap , & grid , nz , dt , recon ) !! Per-layer WENO horizontal advection of a scalar tracer hTr = h*Tr. !! !! Rung-adaptive: near boundaries the stencil automatically degrades !! from the requested scheme down to PLM or donor-cell so that every !! interior cell is always updated. !! !! Mass-flux split uses the same vanishing-layer-gated centred CWC !! as ml_advect_tracer_ppm — see that kernel's docstring for the !! algebra. !! !! Only called when recon /= TRACER_RECON_PPM (1=WENO5, 2=WENO7, !! 3=WENO9). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz !! Number of vertical layers. real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer depths (m), bottom-up: k=1 bed, k=nz surface. real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer x-momentum flux (m&#94;2/s). real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) !! Layer y-momentum flux (m&#94;2/s). real ( wp ), intent ( in ) :: mass_flux_x ( grid % nx_total , grid % ny_total ) !! Barotropic x mass flux (m&#94;2/s). real ( wp ), intent ( in ) :: mass_flux_y ( grid % nx_total , grid % ny_total ) !! Barotropic y mass flux (m&#94;2/s). real ( wp ), intent ( inout ) :: hTr_layer ( grid % nx_total , grid % ny_total , nz ) !! Tracer h*Tr (m*[units]), updated in-place. real ( wp ), intent ( out ) :: weno_tr_snap ( grid % nx_total , grid % ny_total , nz ) !! Caller-owned concentration-snapshot scratch (Tr = hTr/h); filled !! then read here.  Passed in (not module state) to keep this `pure`. real ( wp ), intent ( in ) :: dt !! Timestep (s). integer , intent ( in ) :: recon !! TRACER_RECON_WENO5/7/9 code. integer :: nx , ny , nghost , k , kk , i , j real ( wp ) :: dx , dy , inv_dx , inv_dy real ( wp ) :: h_val , h_col , h_face , f_layer , u_eff , sigma real ( wp ) :: flux_left , flux_right , flux_bot , flux_top real ( wp ) :: tr_face_val real ( wp ) :: corr_xL , corr_xR , corr_yB , corr_yT real ( wp ) :: H_active_xL , H_active_xR , H_active_yB , H_active_yT real ( wp ) :: inv_H_xL , inv_H_xR , inv_H_yB , inv_H_yT real ( wp ) :: h_iL , h_iR , h_jB , h_jT real ( wp ) :: v_xL ( NZ_STACK_MAX ), v_xR ( NZ_STACK_MAX ) real ( wp ) :: v_yB ( NZ_STACK_MAX ), v_yT ( NZ_STACK_MAX ) real ( wp ) :: hf_xL ( NZ_STACK_MAX ), hf_xR ( NZ_STACK_MAX ) real ( wp ) :: hf_yB ( NZ_STACK_MAX ), hf_yT ( NZ_STACK_MAX ) integer :: rung_max_int , rung integer :: avail_up , avail_down nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy inv_dx = 1.0_wp / dx inv_dy = 1.0_wp / dy ! Map public TRACER_RECON_* to internal rung_max: !   WENO5(1) -> 2, WENO7(2) -> 3, WENO9(3) -> 4 rung_max_int = recon + 1 associate ( tr_snap => weno_tr_snap ) ! ---- Phase 0: concentration snapshot ---- do concurrent ( j = 1 : ny , i = 1 : nx ) local ( k , h_val ) do k = 1 , nz h_val = h_layer ( i , j , k ) if ( h_val > DRY_TOLERANCE ) then tr_snap ( i , j , k ) = hTr_layer ( i , j , k ) / h_val else tr_snap ( i , j , k ) = 0.0_wp end if end do end do ! ---- Phase 1+2: combined flux + update ---- do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_val , h_col , h_face , f_layer , u_eff , sigma , & flux_left , flux_right , flux_bot , flux_top , tr_face_val , & corr_xL , corr_xR , corr_yB , corr_yT , & H_active_xL , H_active_xR , H_active_yB , H_active_yT , & inv_H_xL , inv_H_xR , inv_H_yB , inv_H_yT , & h_iL , h_iR , h_jB , h_jT , & rung , avail_up , avail_down , & v_xL , v_xR , v_yB , v_yT , & hf_xL , hf_xR , hf_yB , hf_yT ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col > ML_MIN_DEPTH ) then ! Vanishing-layer-gated centred CWC (same as ml_advect_tracer_ppm). corr_xL = mass_flux_x ( i - 1 , j ) corr_xR = mass_flux_x ( i , j ) corr_yB = mass_flux_y ( i , j - 1 ) corr_yT = mass_flux_y ( i , j ) H_active_xL = 0.0_wp H_active_xR = 0.0_wp H_active_yB = 0.0_wp H_active_yT = 0.0_wp do k = 1 , nz h_val = h_layer ( i , j , k ) h_iL = h_layer ( i - 1 , j , k ) h_iR = h_layer ( i + 1 , j , k ) h_jB = h_layer ( i , j - 1 , k ) h_jT = h_layer ( i , j + 1 , k ) if ( h_val > VANISHING_LAYER_TOL . and . h_iL > VANISHING_LAYER_TOL ) then v_xL ( k ) = 0.5_wp * ( hu_layer ( i - 1 , j , k ) + hu_layer ( i , j , k )) hf_xL ( k ) = 0.5_wp * ( h_iL + h_val ) else v_xL ( k ) = 0.0_wp hf_xL ( k ) = 0.0_wp end if if ( h_val > VANISHING_LAYER_TOL . and . h_iR > VANISHING_LAYER_TOL ) then v_xR ( k ) = 0.5_wp * ( hu_layer ( i , j , k ) + hu_layer ( i + 1 , j , k )) hf_xR ( k ) = 0.5_wp * ( h_val + h_iR ) else v_xR ( k ) = 0.0_wp hf_xR ( k ) = 0.0_wp end if if ( h_val > VANISHING_LAYER_TOL . and . h_jB > VANISHING_LAYER_TOL ) then v_yB ( k ) = 0.5_wp * ( hv_layer ( i , j - 1 , k ) + hv_layer ( i , j , k )) hf_yB ( k ) = 0.5_wp * ( h_jB + h_val ) else v_yB ( k ) = 0.0_wp hf_yB ( k ) = 0.0_wp end if if ( h_val > VANISHING_LAYER_TOL . and . h_jT > VANISHING_LAYER_TOL ) then v_yT ( k ) = 0.5_wp * ( hv_layer ( i , j , k ) + hv_layer ( i , j + 1 , k )) hf_yT ( k ) = 0.5_wp * ( h_val + h_jT ) else v_yT ( k ) = 0.0_wp hf_yT ( k ) = 0.0_wp end if corr_xL = corr_xL - v_xL ( k ) corr_xR = corr_xR - v_xR ( k ) corr_yB = corr_yB - v_yB ( k ) corr_yT = corr_yT - v_yT ( k ) H_active_xL = H_active_xL + hf_xL ( k ) H_active_xR = H_active_xR + hf_xR ( k ) H_active_yB = H_active_yB + hf_yB ( k ) H_active_yT = H_active_yT + hf_yT ( k ) end do if ( H_active_xL > 0.0_wp ) then inv_H_xL = 1.0_wp / H_active_xL else inv_H_xL = 0.0_wp end if if ( H_active_xR > 0.0_wp ) then inv_H_xR = 1.0_wp / H_active_xR else inv_H_xR = 0.0_wp end if if ( H_active_yB > 0.0_wp ) then inv_H_yB = 1.0_wp / H_active_yB else inv_H_yB = 0.0_wp end if if ( H_active_yT > 0.0_wp ) then inv_H_yT = 1.0_wp / H_active_yT else inv_H_yT = 0.0_wp end if ! Availability counts for the rung ladder.  Stencils may use at ! most ONE ghost row beyond the physical interior: ghost rows are ! zero-gradient copies of the first interior cell, so deeper rows ! carry no information and would bias the smoothness indicators ! (this also matches PPM, whose edge interpolation at the first ! interior cell reads one ghost row).  For the face between cells ! c and c+1 along x (interior cells span [nghost+1, nx-nghost]): !   avail_west(c) = c - nghost + 1         (cells nghost .. c) !   avail_east(c) = nx - nghost - c + 1    (cells c+1 .. nx-nghost+1) ! upwind/downwind assignment follows the flux sign; the y-faces ! use the same formulas with (j, ny).  Bounds safety: rung R ! engages only when avail_up/down cover its reach, so the deepest ! read is >= ghost row nghost (one row in) and <= nx-nghost+1 — ! in-array for any nghost >= the configure-enforced minimum. do k = 1 , nz ! ---- x-direction: LEFT face (between i-1 and i) ---- f_layer = v_xL ( k ) + hf_xL ( k ) * inv_H_xL * corr_xL h_face = 0.5_wp * ( h_layer ( i - 1 , j , k ) + h_layer ( i , j , k )) if ( h_face > DRY_TOLERANCE ) then u_eff = f_layer / h_face sigma = min ( abs ( u_eff ) * dt * inv_dx , 1.0_wp ) else u_eff = 0.0_wp sigma = 0.0_wp end if if ( f_layer > 0.0_wp ) then ! Upwind cell c = i-1 (flowing right) avail_up = i - nghost ! avail_west(i-1) avail_down = nx - nghost - i + 2 ! avail_east(i-1) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i - 5 , j , k ), tr_snap ( i - 4 , j , k ), & tr_snap ( i - 3 , j , k ), tr_snap ( i - 2 , j , k ), & tr_snap ( i - 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i + 1 , j , k ), & tr_snap ( i + 2 , j , k ), tr_snap ( i + 3 , j , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i - 4 , j , k ), tr_snap ( i - 3 , j , k ), & tr_snap ( i - 2 , j , k ), tr_snap ( i - 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i + 1 , j , k ), & tr_snap ( i + 2 , j , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i - 3 , j , k ), tr_snap ( i - 2 , j , k ), & tr_snap ( i - 1 , j , k ), & tr_snap ( i , j , k ), tr_snap ( i + 1 , j , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i - 2 , j , k ), tr_snap ( i - 1 , j , k ), & tr_snap ( i , j , k ), sigma ) case default tr_face_val = tr_snap ( i - 1 , j , k ) ! donor end select flux_left = f_layer * tr_face_val else if ( f_layer < 0.0_wp ) then ! Upwind cell c = i (flowing left — flip stencil) avail_up = nx - nghost - i + 2 ! avail_east(i-1) avail_down = i - nghost ! avail_west(i-1) rung = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i + 4 , j , k ), tr_snap ( i + 3 , j , k ), & tr_snap ( i + 2 , j , k ), tr_s