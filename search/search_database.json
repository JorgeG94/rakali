eger, private :: bc_kind real(kind=wp), private :: bc_un_ext real(kind=wp), private :: edgeflux (3) real(kind=wp), private :: h_left real(kind=wp), private :: h_right real(kind=wp), private :: hc real(kind=wp), private :: hle real(kind=wp), private :: hre integer, private :: i real(kind=wp), private :: inv_area real(kind=wp), private :: length integer, private :: m real(kind=wp), private :: max_speed_local real(kind=wp), private :: n1 real(kind=wp), private :: n2 integer, private :: neighbour real(kind=wp), private :: pressure_flux real(kind=wp), private :: pressuregrad_work real(kind=wp), private :: q_left (3) real(kind=wp), private :: q_right (3) real(kind=wp), private :: speed_max_last real(kind=wp), private :: stage_eu_acc real(kind=wp), private :: xmom_eu_acc real(kind=wp), private :: ymom_eu_acc real(kind=wp), private :: z_half real(kind=wp), private :: zc real(kind=wp), private :: zl real(kind=wp), private :: zr Source Code pure subroutine flux_one_cell ( state , mesh , k ) !! Per-cell body of the flux pass. Pure: never writes to any cell !! other than `k`. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: k integer :: i , neighbour , m integer :: bc_group , bc_kind real ( wp ) :: bc_eta_ext , bc_un_ext , bc_h_ext , bc_Qn_ext real ( wp ) :: q_left ( 3 ), q_right ( 3 ) real ( wp ) :: edgeflux ( 3 ) real ( wp ) :: hc , zc , hle , hre , zl , zr , h_left , h_right , z_half real ( wp ) :: n1 , n2 , length real ( wp ) :: max_speed_local , pressure_flux , speed_max_last real ( wp ) :: pressuregrad_work real ( wp ) :: stage_eu_acc , xmom_eu_acc , ymom_eu_acc real ( wp ) :: inv_area ! Centroid values for this cell -- needed by the bed-slope source. hc = state % barotropic % height_cv ( k ) zc = state % barotropic % bed_cv ( k ) ! Loop-private accumulators; avoid touching state%*_eu in the inner ! loop so the writes coalesce. stage_eu_acc = 0.0_wp xmom_eu_acc = 0.0_wp ymom_eu_acc = 0.0_wp speed_max_last = 0.0_wp do i = 1 , 3 ! Left state (this cell's edge values from the extrapolation pass). q_left ( 1 ) = state % barotropic % stage_ev ( i , k ) q_left ( 2 ) = state % barotropic % xmom_ev ( i , k ) q_left ( 3 ) = state % barotropic % ymom_ev ( i , k ) zl = state % barotropic % bed_ev ( i , k ) hle = state % barotropic % height_ev ( i , k ) ! Edge geometry. length = mesh % edge_len ( i , k ) n1 = mesh % edge_n1 ( i , k ) n2 = mesh % edge_n2 ( i , k ) neighbour = mesh % neighbours ( i , k ) if ( neighbour < 0 ) then ! Boundary edge -- dispatch the edge's BC group. Group <= 0 ! falls through to BC_WALL (inline wall mirror). bc_group = mesh % bc_group ( i , k ) if ( bc_group <= 0 ) then bc_kind = BC_WALL bc_eta_ext = 0.0_wp bc_un_ext = 0.0_wp bc_h_ext = 0.0_wp bc_Qn_ext = 0.0_wp else bc_kind = state % bc_type ( bc_group ) bc_eta_ext = state % bc_eta_ext ( bc_group ) bc_un_ext = state % bc_un_ext ( bc_group ) bc_h_ext = state % bc_h_ext ( bc_group ) bc_Qn_ext = state % bc_Qn_ext ( bc_group ) end if if ( bc_kind == BC_CHAPMAN ) then ! Orlanski radiation: advect the persistent eta_old(i, k) ! along the estimated outward phase speed, then dispatch ! through the BC_TIDAL/Flather algebra with that ghost ! target. call compute_chapman_eta_target ( state , mesh , k , i , & hle , bc_eta_ext ) bc_kind = BC_TIDAL end if call compute_boundary_state_impl ( q_left , n1 , n2 , zl , hle , bc_kind , & bc_eta_ext , bc_un_ext , bc_h_ext , & bc_Qn_ext , q_right , zr , hre ) else ! Interior edge -- read the matching edge of the neighbour. m = mesh % neighbour_edges ( i , k ) q_right ( 1 ) = state % barotropic % stage_ev ( m , neighbour ) q_right ( 2 ) = state % barotropic % xmom_ev ( m , neighbour ) q_right ( 3 ) = state % barotropic % ymom_ev ( m , neighbour ) zr = state % barotropic % bed_ev ( m , neighbour ) hre = state % barotropic % height_ev ( m , neighbour ) end if ! KP draining: shared edge bed is the higher of the two sides; ! effective heights clipped at zero from below. z_half = max ( zl , zr ) h_left = max ( hle + zl - z_half , 0.0_wp ) h_right = max ( hre + zr - z_half , 0.0_wp ) if ( h_left == 0.0_wp . and . h_right == 0.0_wp ) then ! Both sides dry -- no flux, no pressure contribution. edgeflux ( 1 ) = 0.0_wp edgeflux ( 2 ) = 0.0_wp edgeflux ( 3 ) = 0.0_wp max_speed_local = 0.0_wp pressure_flux = 0.0_wp else call cu_flux_pointwise_impl ( q_left , q_right , & h_left , h_right , & hle , hre , & n1 , n2 , & state % low_froude_mode , & edgeflux , max_speed_local , pressure_flux ) end if ! Edge length * negate: accumulate -div(F) so the update reads ! `Q&#94;{n+1} = Q&#94;n + dt * stage_eu`. edgeflux ( 1 ) = - length * edgeflux ( 1 ) edgeflux ( 2 ) = - length * edgeflux ( 2 ) edgeflux ( 3 ) = - length * edgeflux ( 3 ) ! Stash the barotropic mass flux (net inflow into cell `k` ! across edge `i`, m&#94;3/s, positive = gaining) for the tracer ! advection kernel to reuse (consistent-with-continuity). state % barotropic % mass_flux_e ( i , k ) = edgeflux ( 1 ) stage_eu_acc = stage_eu_acc + edgeflux ( 1 ) xmom_eu_acc = xmom_eu_acc + edgeflux ( 2 ) ymom_eu_acc = ymom_eu_acc + edgeflux ( 3 ) speed_max_last = max ( speed_max_last , max_speed_local ) ! Well-balanced bed-slope source: discrete hydrostatic-pressure ! work plus centroid-to-edge bed-slope term, plus `pressure_flux` ! from the central-upwind helper; telescopes to zero for lake at ! rest. pressuregrad_work = length * ( - GRAVITY * 0.5_wp * & ( h_left * h_left - hle * hle & - ( hle + hc ) * ( zl - zc )) & + pressure_flux ) xmom_eu_acc = xmom_eu_acc - n1 * pressuregrad_work ymom_eu_acc = ymom_eu_acc - n2 * pressuregrad_work end do ! Normalise by cell area so the accumulators hold flux divergence ! per unit area, ready for the explicit update step. if ( mesh % area ( k ) > 0.0_wp ) then inv_area = 1.0_wp / mesh % area ( k ) else inv_area = 0.0_wp end if state % barotropic % stage_eu ( k ) = stage_eu_acc * inv_area state % barotropic % xmom_eu ( k ) = xmom_eu_acc * inv_area state % barotropic % ymom_eu ( k ) = ymom_eu_acc * inv_area state % barotropic % max_speed ( k ) = speed_max_last end subroutine flux_one_cell","tags":"","url":"proc/flux_one_cell.html"},{"title":"rotate_to_normal_impl – Rakali","text":"private pure subroutine rotate_to_normal_impl(q, n1, n2) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: q (3) real(kind=wp), intent(in) :: n1 real(kind=wp), intent(in) :: n2 Called by proc~~rotate_to_normal_impl~~CalledByGraph proc~rotate_to_normal_impl rotate_to_normal_impl proc~cu_flux_pointwise_impl cu_flux_pointwise_impl proc~cu_flux_pointwise_impl->proc~rotate_to_normal_impl proc~flux_one_cell flux_one_cell proc~flux_one_cell->proc~cu_flux_pointwise_impl proc~compute_fluxes_central_unstr compute_fluxes_central_unstr proc~compute_fluxes_central_unstr->proc~flux_one_cell proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~compute_fluxes_central_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step->proc~compute_fluxes_central_unstr proc~solver_unstr_step_generic solver_unstr_step_generic proc~solver_unstr_step->proc~solver_unstr_step_generic proc~solver_unstr_step_generic->proc~compute_fluxes_central_unstr proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include th