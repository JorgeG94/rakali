forcing variable IDs, tolerating missing variables type ( forcing_t ), intent ( inout ) :: forc integer , intent ( in ) :: ncid integer :: status ! Wind components status = nf90_inq_varid ( ncid , \"u10\" , forc % varid_u10 ) if ( status /= nf90_noerr ) forc % varid_u10 = - 1 status = nf90_inq_varid ( ncid , \"v10\" , forc % varid_v10 ) if ( status /= nf90_noerr ) forc % varid_v10 = - 1 ! Pressure: try \"msl\" first, then \"sp\" status = nf90_inq_varid ( ncid , \"msl\" , forc % varid_msl ) if ( status /= nf90_noerr ) then status = nf90_inq_varid ( ncid , \"sp\" , forc % varid_msl ) if ( status /= nf90_noerr ) forc % varid_msl = - 1 end if ! Precipitation status = nf90_inq_varid ( ncid , \"tp\" , forc % varid_tp ) if ( status /= nf90_noerr ) forc % varid_tp = - 1 if ( forc % varid_u10 >= 0 ) then call logger % info ( \"  Found wind component: u10\" ) end if if ( forc % varid_v10 >= 0 ) then call logger % info ( \"  Found wind component: v10\" ) end if if ( forc % varid_msl >= 0 ) then call logger % info ( \"  Found pressure variable\" ) end if if ( forc % varid_tp >= 0 ) then call logger % info ( \"  Found precipitation: tp\" ) end if end subroutine find_forcing_vars","tags":"","url":"proc/find_forcing_vars.html"},{"title":"load_snapshot – Rakali","text":"private  subroutine load_snapshot(forc, ncid, tidx, u10, v10, msl, tp) Read one time snapshot of all forcing fields from NetCDF Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(in) :: forc integer, intent(in) :: ncid integer, intent(in) :: tidx 1-based time index to read real(kind=wp), intent(out) :: u10 (:,:) real(kind=wp), intent(out) :: v10 (:,:) real(kind=wp), intent(out) :: msl (:,:) real(kind=wp), intent(out) :: tp (:,:) Calls proc~~load_snapshot~~CallsGraph proc~load_snapshot load_snapshot nf90_get_var nf90_get_var proc~load_snapshot->nf90_get_var proc~nc_check nc_check proc~load_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_st