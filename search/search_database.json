ile~rki_solver_unstr.f90->sourcefile~rki_ml_truncate_unstr.f90 sourcefile~rki_ml_vertical_viscosity_unstr.f90 rki_ml_vertical_viscosity_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_ml_vertical_viscosity_unstr.f90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_multilayer_state_unstr.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_gauges_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_kernel_timestep_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_output_unstr.f90 sourcefile~rki_restart_unstr.f90 rki_restart_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_restart_unstr.f90 sourcefile~rki_gauges_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_extrapolate_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_flux_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_friction_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_fused_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_protect_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_sponge_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_timestep_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_kernel_update_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_eos_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_friction_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_horizontal_viscosity_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_keps_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_kpp_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_pressure_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_pressure_unstr.f90->sourcefile~rki_ml_eos_unstr.f90 sourcefile~rki_ml_tracers_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_truncate_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_ml_vertical_viscosity_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_output_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_restart_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_state_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Vertical coordinate type for hybrid z-sigma and ALE support module rki_vcoord !! Defines `vcoord_t`, a lightweight config type for the vertical coordinate. !! Type-bound procedures dispatch via `select case` on an integer enum (no !! runtime polymorphism) so the type is GPU-safe. !! !! Implemented (`VCOORD_*`): !!   - SIGMA       — pure terrain-following (no remap). !!   - ZSIGMA      — smoothstep blend sigma (shallow) → fixed z-levels (deep); !!                   reduces sigma PGE on steep bathymetry. Conservative remap. !!   - ZSTAR       — z*-lite SSH-tracking: a global `z_ref` stretched per column !!                   by H/z_ref(nz) so sum(dz)=H, relative spacing preserved as !!                   η changes (no sigma distortion at large SSH). !!   - ZSTAR_FULL  — per-column z_ref from local bathymetry (vanishing layers). !!   - ZSTAR_SIGMA — smoothstep blend of sigma (shallow) and z*-lite (deep). #ifdef LFORTRAN_PASSING use rki_constants , only : wp , & nz_stack_required , nz_stack_is_sufficient , & VCOORD_LAGRANGIAN , VCOORD_EULERIAN_Z , & VCOORD_SIGMA , VCOORD_ZSIGMA , & VCOORD_ZSTAR , VCOORD_ZSTAR_FULL , VCOORD_ZSTAR_SIGMA , & VCOORD_Z_FIXED , VCOORD_RHO , VCOORD_HYCOM , & REMAP_PCM , REMAP_PLM , REMAP_PPM , REMAP_PPM_H4 , REMAP_PQM #else use rki_constants , only : NZ_STACK_MAX , wp , & nz_stack_required , nz_stack_is_sufficient , & VCOORD_LAGRANGIAN , VCOORD_EULERIAN_Z , & VCOORD_SIGMA , VCOORD_ZSIGMA , & VCOORD_ZSTAR , VCOORD_ZSTAR_FULL , VCOORD_ZSTAR_SIGMA , & VCOORD_Z_FIXED , VCOORD_RHO , VCOORD_HYCOM , & REMAP_PCM , REMAP_PLM , REMAP_PPM , REMAP_PPM_H4 , REMAP_PQM #endif use pic_logger , only : logger => global_logger use pic_strings , only : to_string implicit none private #ifdef LFORTRAN_PASSING integer , parameter :: NZ_STACK_MAX = 64 !! LFortran 0.64 workaround: module-local copy of the rki_constants value !! (an imported parameter used as an explicit-shape dummy bound inside a !! PURE call becomes an impure getter under LFortran). Keep in sync (=64). #endif public :: vcoord_t public :: vcoord_target_dz_column public :: vcoord_target_dz_column_zstar_full public :: zstar_full_build_column public :: parse_vcoord_type public :: parse_remap_method public :: parse_stretching_mode integer , parameter , public :: STRETCH_UNIFORM = 0 integer , parameter , public :: STRETCH_LOG = 1 type :: vcoord_t integer :: coord_type = VCOORD_SIGMA !! Vertical coordinate type (VCOORD_SIGMA, VCOORD_ZSIGMA, etc.) integer :: remap_method = REMAP_PPM !! Remap reconstruction order (REMAP_PCM/PLM/PPM/PPM_H4/PQM). Default PPM. !! PQM falls back to PPM for nz < 5 (see `remap_column_pqm`). integer :: nz = 0 !! Number of vertical layers real ( wp ), allocatable :: dsig_target (:) !! (nz) Target sigma-like layer fractions, sum = 1.0 real ( wp ), allocatable :: z_ref (:) !! (nz+1) Reference interface depths for z-levels (m, positive down). !! Only allocated for coord types that use z-levels. ! z-sigma hybrid parameters real ( wp ) :: depth_transition = 10 0.0_wp !! Depth (m) where sigma-to-z blending begins real ( wp ) :: blend_width = 5 0.0_wp !! Width of the blending zone (m) ! Full MOM6 z* parameters (VCOORD_ZSTAR_FULL) real ( wp ) :: zstar_h_surf_target = 0.0_wp !! Target physical thickness of the surface layer (m). !! 0 => auto: uniform per-column (falls back to lite behaviour !! per column).  Set > 0 to anchor the surface layer at a !! fixed thickness regardless of total depth H. real ( wp ) :: zstar_h_min = 1.0e-4_wp !! Vanishing-layer floor (m).  Layers that would land below the !! local bed get clipped to this thickness rather than going to zero. integer :: zstar_stretching = 1 !! Surface-concentration stretching: 1=log, 0=uniform integer :: zstar_n_surf = 0 !! Number of \"fine\" near-surface layers using stretching. !! 0 => auto (use max(1, nz/3)) contains procedure , non_overridable :: init => vcoord_init procedure , non_overridable :: needs_remap => vcoord_needs_remap procedure , non_overridable :: enter_data => vcoord_enter_data procedure , non_overridable :: exit_data => vcoord_exit_data procedure , non_overridable :: cleanup => vcoord_cleanup end type vcoord_t contains subroutine vcoord_init ( self , nz , coord_type , remap_method ) !! Initialise a vertical coordinate definition. Allocates + populates !! `dsig_target` for the given type. Unknown types: error stop. class ( vcoord_t ), intent ( inout ) :: self integer , intent ( in ) :: nz !! Number of vertical layers integer , intent ( in ) :: coord_type !! Coordinate type constant (VCOORD_SIGMA, etc.) integer , intent ( in ) :: remap_method !! Remapping method constant (REMAP_PLM, etc.) self % nz = nz self % coord_type = coord_type self % remap_method = remap_method ! (Re)allocate target distribution if ( allocated ( self % dsig_target )) deallocate ( self % dsig_target ) allocate ( self % dsig_target ( nz )) ! (Re)allocate z_ref if needed if ( allocated ( self % z_ref )) deallocate ( self % z_ref ) select case ( coord_type ) case ( VCOORD_SIGMA ) self % dsig_target = 1.0_wp / real ( nz , wp ) case ( VCOORD_ZSIGMA ) ! z-sigma hybrid: dsig_target is used for the sigma component, ! z_ref defines the reference z-level interfaces. self % dsig_target = 1.0_wp / real ( nz , wp ) allocate ( self % z_ref ( 0 : nz )) ! Reference z-levels: uniform spacing over the blending depth. ! Columns shallower than depth_transition use pure sigma. ! Columns deeper blend toward these fixed horizontal levels. block real ( wp ) :: h_ref integer :: kk h_ref = self % depth_transition + self % blend_width self % z_ref ( 0 ) = 0.0_wp do kk = 1 , nz self % z_ref ( kk ) = real ( kk , wp ) * h_ref / real ( nz , wp ) end do end block case ( VCOORD_ZSTAR_FULL ) ! Per-column z_ref built later by zstar_full_build_column from local ! bathymetry; this uniform template keeps allocated(z_ref) checks valid. self % dsig_target = 1.0_wp / real ( nz , wp ) allocate ( self % z_ref ( 0 : nz )) block real ( wp ) :: h_ref integer :: kk h_ref = self % depth_transition + self % blend_width self % z_ref ( 0 ) = 0.0_wp do kk = 1 , nz self % z_ref ( kk ) = real ( kk , wp ) * h_ref / real ( nz , wp ) end do end block case ( VCOORD_ZSTAR_SIGMA ) ! z*/sigma hybrid: same template as VCOORD_ZSTAR / VCOORD_ZSIGMA. ! The blend is applied per-column in `vcoord_target_dz_column` ! based on the local H vs depth_transition / blend_width. self % dsig_target = 1.0_wp / real ( nz , wp ) allocate ( self % z_ref ( 0 : nz )) block real ( wp ) :: h_ref integer :: kk h_ref = self % depth_transition + self % blend_width self % z_ref ( 0 ) = 0.0_wp do kk = 1 , nz self % z_ref ( kk ) = real ( kk , wp ) * h_ref / real ( nz , wp ) end do end block case ( VCOORD_ZSTAR ) ! z*-lite: uniform reference spacing over depth_transition+blend_width; ! stretched per column by H/z_ref(nz) in vcoord_target_dz_column. self % dsig_target = 1.0_wp / real ( nz , wp ) allocate ( self % z_ref ( 0 : nz )) block real ( wp ) :: h_ref integer :: kk h_ref = self % depth_transition + self % blend_width self % z_ref ( 0 ) = 0.0_wp do kk = 1 , nz self % z_ref ( kk ) = real ( kk , wp ) * h_ref / real ( nz , wp ) end do end block case default call logger % error ( \"vcoord_init: unknown coord_type \" // to_string ( coord_type ) // & \". Valid options are 'sigma', 'zsigma', and 'zstar'.\" ) error stop \"vcoord_init: unknown coord_type\" end select ! Defence in depth.  `validate_config` refuses this outright, so a ! namelist-driven run never reaches here; this catches the FFI / ! two-phase `rki_create` paths that build a vcoord without going ! through config validation.  Threshold is `nz + 1` — see ! `nz_stack_required`. if (. not . nz_stack_is_sufficient ( nz )) then call logger % warning ( \"nz = \" // to_string ( nz ) // \" needs NZ_STACK_MAX >= \" // & to_string ( nz_stack_required ( nz )) // \" but this binary was \" // & \"compiled with NZ_STACK_MAX = \" // to_string ( NZ_STACK_MAX ) // & \". Per-column stack kernels (BPG, remap) will overrun \" // & \"thread-local storage and silently produce wrong answers. \" // & \"Rebuild with -DRAKALI_NZ_STACK_MAX=\" // & to_string ( nz_stack_required ( nz )) // \" (or larger).\" ) end if end subroutine vcoord_init pure logical function vcoord_needs_remap ( self ) result ( needs_remap ) !! Returns `.true.` if this coordinate type requires conservative !! vertical remapping after the barotropic step.  Pure sigma does !! not — layers are simply rescaled by dsig(k) * H. class ( vcoord_t ), intent ( in ) :: self needs_remap = ( self % coord_type /= VCOORD_SIGMA ) end function vcoord_needs_remap subroutine vcoord_enter_data ( self ) !! Map read-only coordinate arrays to GPU. class ( vcoord_t ), intent ( inout ) :: self if ( allocated ( self % dsig_target )) then !$acc enter data copyin(self%dsig_target) end if if ( allocated ( self % z_ref )) then !$acc enter data copyin(self%z_ref) end if end subroutine vcoord_enter_data subroutine vcoord_exit_data ( self ) !! Unmap coordinate arrays from GPU. class ( vcoord_t ), intent ( inout ) :: self if ( allocated ( self % dsig_target )) then !$acc exit data delete(self%dsig_target) end if if ( allocated ( self % z_ref )) then !$acc exit data delete(self%z_ref) end if end subroutine vcoord_exit_data subroutine vcoord_cleanup ( self ) !! Deallocate all arrays.  Safe to call on uninitialised instances. class ( vcoord_t ), intent ( inout ) :: self if ( allocated ( self % dsig_target )) deallocate ( self % dsig_target ) if ( allocated ( self % z_ref )) deallocate ( self % z_ref ) self % nz = 0 end subroutine vcoord_cleanup ! ---- Per-column target thickness computation ---- pure subroutine vcoord_target_dz_column ( coord_type , nz , H , dsig , z_ref , & depth_transition , blend_width , dz ) !$acc routine seq !! Compute target layer thicknesses for a single water column. !! Pure, called from `do concurrent` (one thread per column). !! !! Output `dz` is bottom-up (ROMS): dz(1) = BOTTOM, dz(nz) = SURFACE; !! matches the solvers' `h_layer` indexing (consumers write !! h_layer(k,...) = dz(k) with no reversal). sum(dz) = H in all cases. !!   SIGMA:       dz(k) = dsig(k)*H (terrain-following). !!   ZSIGMA:      smooth blend sigma (shallow) → fixed z-levels (deep). !!   ZSTAR:       z*-lite, dz(k) = (z_ref(nz-k+1)-z_ref(nz-k))*H/z_ref(nz); !!                interfaces stay at fixed relative position as η changes. !!   ZSTAR_SIGMA: smoothstep blend of sigma (shallow) and z*-lite (deep); !!                each branch sums to H so no surface trim needed. integer , intent ( in ) :: coord_type integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: H !! Total water depth at this column (m) real ( wp ), intent ( in ) :: dsig ( nz ) !! Reference sigma fractions (sum = 1), ROMS-ordered: dsig(1) bottom, !! dsig(nz) surface. Currently uniform 1/nz. real ( wp ), intent ( in ) :: z_ref ( 0 : nz ) !! Reference z-level interface depths (m, positive down). !! `z_ref(0) = 0` is the surface; `z_ref(nz)` is the deepest !! reference interface.  Used for VCOORD_ZSIGMA and VCOORD_ZSTAR. real ( wp ), intent ( in ) :: depth_transition !! Depth (m) below which blending begins real ( wp ), intent ( in ) :: blend_width !! Width of the blending zone (m) real ( wp ), intent ( out ) :: dz ( nz ) !! Output target layer thicknesses, ROMS-ordered (sum = H, !! `dz(1)` = bottom, `dz(nz)` = surface) real ( wp ) :: alpha , x , z_top_k , z_bot_k , dz_z , dz_sum , deficit integer :: k select case ( coord_type ) case ( VCOORD_SIGMA ) ! Pure terrain-following.  Uniform dsig means orientation is ! immaterial — the output is the same in either direction. do k = 1 , nz dz ( k ) = dsig ( k ) * H end do case ( VCOORD_ZSTAR ) ! z*-lite: stretch the global reference pattern uniformly so ! sum(dz) = H (H = h_bed + η). ROMS-ordered: dz(1) deepest, dz(nz) ! surface. Reduces to uniform sigma for uniform z_ref. if ( z_ref ( nz ) > 0.0_wp ) then do k = 1 , nz dz_z = z_ref ( nz - k + 1 ) - z_ref ( nz - k ) dz ( k ) = dz_z * H / z_ref ( nz ) end do else ! Degenerate z_ref — fall back to uniform sigma do k = 1 , nz dz ( k ) = dsig ( k ) * H end do end if case ( VCOORD_ZSIGMA ) ! Smooth blend sigma↔z-levels: alpha=0 shallow (H<=depth_transition, ! pure sigma) → alpha=1 deep (H>=depth_transition+blend_width, z-levels). ! ROMS order: layer k spans z_ref(nz-k)..z_ref(nz-k+1). if ( H <= depth_transition ) then ! Pure sigma — uniform dsig, orientation immaterial do k = 1 , nz dz ( k ) = dsig ( k ) * H end do else ! Compute blending factor if ( blend_width > 0.0_wp ) then x = ( H - depth_transition ) / blend_width x = max ( 0.0_wp , min ( 1.0_wp , x )) alpha = x * x * ( 3.0_wp - 2.0_wp * x ) ! smoothstep else alpha = 1.0_wp end if ! Compute z-level thicknesses (clip to column depth) dz_sum = 0.0_wp do k = 1 , nz z_top_k = min ( z_ref ( nz - k ), H ) ! shallower interface z_bot_k = min ( z_ref ( nz - k + 1 ), H ) ! deeper interface dz_z = max ( z_bot_k - z_top_k , 0.0_wp ) ! Blend: (1-alpha)*sigma + alpha*z-level dz ( k ) = ( 1.0_wp - alpha ) * dsig ( k ) * H + alpha * dz_z dz_sum = dz_sum + dz ( k ) end do ! When H is shallower than the deepest z_ref, layers near the ! bottom (k=1 under ROMS) get clipped to zero.  Put the ! deficit back into the bottom layer so sum(dz) = H. deficit = H - dz_sum if ( abs ( deficit ) > 0.0_wp ) then dz ( 1 ) = dz ( 1 ) + deficit end if end if case ( VCOORD_ZSTAR_SIGMA ) ! z*/sigma smoothstep blend: alpha=0 shallow (pure sigma) → alpha=1 deep ! (pure z*-lite). Both branches sum to H so the blend does, no trim. if ( H <= depth_transition . or . z_ref ( nz ) <= 0.0_wp ) then ! Pure sigma — including the degenerate-z_ref fallback so ! mass conservation holds without an extra dz_sum fix-up. do k = 1 , nz dz ( k ) = dsig ( k ) * H end do else if ( blend_width > 0.0_wp ) then x = ( H - depth_transition ) / blend_width x = max ( 0.0_wp , min ( 1.0_wp , x )) alpha = x * x * ( 3.0_wp - 2.0_wp * x ) ! smoothstep else alpha = 1.0_wp end if ! z*-lite contribution: dz_z = (z_ref(nz-k+1)-z_ref(nz-k)) * H/z_ref(nz) do k = 1 , nz dz_z = ( z_ref ( nz - k + 1 ) - z_ref ( nz - k )) * H / z_ref ( nz ) dz ( k ) = ( 1.0_wp - alpha ) * dsig ( k ) * H + alpha * dz_z end do end if case default ! Fallback to sigma (uniform, orientation immaterial) do k = 1 , nz dz ( k ) = dsig ( k ) * H end do end select end subroutine vcoord_target_dz_column ! ---- Full MOM6 z* per-column reference builder ---- pure subroutine zstar_full_build_column ( nz , h_bed , h_surf_target , & n_surf , stretching , & z_ref_col ) !! Build a per-column reference z-level pattern for VCOORD_ZSTAR_FULL. !! Output `z_ref_col(0:nz)` monotonically increasing (positive-down), !! z_ref_col(0)=0 surface, z_ref_col(nz)=h_bed. Built top-down; the caller !! handles ROMS ordering. Top `n_surf_use` layers use the stretching mode !! (log/uniform) toward h_surf_target; below that uniform to the bed; !! degenerate (h_bed≤0, nz≤0) ⇒ uniform. integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_bed !! Local bed depth (m, positive down).  Must be > 0 in normal use. real ( wp ), intent ( in ) :: h_surf_target !! Target thickness of the surface layer (m).  ≤ 0 means \"auto\" !! and falls back to uniform spacing. integer , intent ( in ) :: n_surf !! Number of fine near-surface layers.  ≤ 0 means auto. integer , intent ( in ) :: stretching !! STRETCH_LOG or STRETCH_UNIFORM real ( wp ), intent ( out ) :: z_ref_col ( 0 : nz ) integer :: k , n_surf_use , n_coarse real ( wp ) :: h_fine , h_coarse , dz_uniform , r , base , w if ( nz <= 0 ) return ! Degenerate / dry column: output zeros (never negative interfaces, which ! would propagate as negative dz_new and crash the solver via NaN CFL). if ( h_bed <= 0.0_wp ) then do k = 0 , nz z_ref_col ( k ) = 0.0_wp end do return end if ! Auto n_surf: 1/3 of layers, at least 1, at most nz-1. if ( n_surf <= 0 ) then n_surf_use = max ( 1 , nz / 3 ) else n_surf_use = max ( 1 , min ( nz - 1 , n_surf )) end if ! If no surface target requested, just uniform. if ( h_surf_target <= 0.0_wp . or . nz == 1 ) then z_ref_col ( 0 ) = 0.0_wp do k = 1 , nz z_ref_col ( k ) = h_bed * real ( k , wp ) / real ( nz , wp ) end do return end if n_coarse = nz - n_surf_use z_ref_col ( 0 ) = 0.0_wp select case ( stretching ) case ( STRETCH_LOG ) ! Geometric fine zone: layer k thickness = h_surf_target*r&#94;(k-1). Pick r ! (bisection, monotonic) so the bottom fine layer matches the coarse ! thickness and fine+coarse sums = h_bed. if ( n_surf_use == 1 . or . n_coarse == 0 ) then ! Single fine layer or no coarse — fall through to UNIFORM behaviour r = 1.0_wp else block real ( wp ) :: r_lo , r_hi , r_mid , f_mid , target_ratio integer :: it target_ratio = h_bed / h_surf_target r_lo = 1.000001_wp r_hi = 1 0.0_wp do it = 1 , 60 r_mid = 0.5_wp * ( r_lo + r_hi ) ! f(r) = (r&#94;n - 1)/(r - 1) + r&#94;(n-1) * n_coarse f_mid = ( r_mid ** n_surf_use - 1.0_wp ) / ( r_mid - 1.0_wp ) & + r_mid ** ( n_surf_use - 1 ) * real ( n_coarse , wp ) if ( f_mid > target_ratio ) then r_hi = r_mid else r_lo = r_mid end if if ( r_hi - r_lo < 1.0e-9_wp ) exit end do r = 0.5_wp * ( r_lo + r_hi ) end block end if w = 1.0_wp base = 0.0_wp do k = 1 , n_surf_use base = base + h_surf_target * w z_ref_col ( k ) = base w = w * r end do ! Coarse zone: continue with dz = h_surf_target * r&#94;(n_surf-1) dz_uniform = h_surf_target * r ** ( n_surf_use - 1 ) do k = n_surf_use + 1 , nz z_ref_col ( k ) = z_ref_col ( k - 1 ) + dz_uniform end do case default ! STRETCH_UNIFORM ! Fine zone: n_surf_use layers each of thickness h_surf_target. ! Coarse zone: uniform fill of the remainder. h_fine = h_surf_target * real ( n_surf_use , wp ) if ( h_fine >= h_bed ) then ! Column too shallow to honour h_surf_target for all fine layers ! — fall back to uniform spacing across the whole column. do k = 1 , nz z_ref_col ( k ) = h_bed * real ( k , wp ) / real ( nz , wp ) end do return end if h_coarse = h_bed - h_fine do k = 1 , n_surf_use z_ref_col ( k ) = h_surf_target * real ( k , wp ) end do if ( n_coarse > 0 ) then dz_uniform = h_coarse / real ( n_coarse , wp ) do k = n_surf_use + 1 , nz z_ref_col ( k ) = h_fine + dz_uniform * real ( k - n_surf_use , wp ) end do end if end select ! Lock the bed interface exactly to h_bed (in case of round-off). z_ref_col ( nz ) = h_bed end subroutine zstar_full_build_column ! ---- Full MOM6 z* per-step dz builder (called per column on GPU) ---- pure subroutine vcoord_target_dz_column_zstar_full ( nz , H , z_ref_col , & h_min , dz ) !$acc routine seq !! Compute target layer thicknesses for VCOORD_ZSTAR_FULL. !! Inputs: z_ref_col(0:nz) local reference (top-down, 0=surface, nz=h_bed); !! H current total depth (m) = h_bed + η; h_min vanishing-layer floor (m). !! Output: dz(1:nz) ROMS-ordered (dz(1) bottom, dz(nz) surface), !! sum(dz) = H exactly, vanishing rows set to h_min. !! Surface layer absorbs η; if H < h_bed the deepest layers clip to h_min !! and the surface is trimmed to keep sum = H. integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: H real ( wp ), intent ( in ) :: z_ref_col ( 0 : nz ) real ( wp ), intent ( in ) :: h_min real ( wp ), intent ( out ) :: dz ( nz ) real ( wp ) :: dz_top_kt , z_upper , z_lower , H_eff , h_bed_ref , eta real ( wp ) :: sum_dz , deficit integer :: kt , k h_bed_ref = z_ref_col ( nz ) eta = H - h_bed_ref H_eff = max ( H , 0.0_wp ) if ( eta >= 0.0_wp ) then ! Column at or above reference depth.  Subsurface layers keep ! their reference thicknesses; the surface layer absorbs the ! SSH offset.  sum(dz) = h_bed_ref + eta = H exactly. do kt = 1 , nz k = nz - kt + 1 dz_top_kt = max ( z_ref_col ( kt ) - z_ref_col ( kt - 1 ), 0.0_wp ) if ( kt == 1 ) then dz ( k ) = dz_top_kt + eta ! ROMS surface gets +η else dz ( k ) = dz_top_kt end if end do else ! Column shallower than reference (H < h_bed_ref). Walk top-down: ! layer above bed keeps full thickness; straddling layer gets ! H_eff - z_upper; below-bed layer is vanishing (h_min). Then trim the ! surface so sum = H exactly (remap mass conservation needs this). do kt = 1 , nz k = nz - kt + 1 z_upper = z_ref_col ( kt - 1 ) z_lower = z_ref_col ( kt ) if ( z_lower <= H_eff ) then dz ( k ) = z_lower - z_upper else if ( z_upper < H_eff ) then dz ( k ) = H_eff - z_upper else dz ( k ) = h_min end if end do ! Re-balance via the surface layer. sum_dz = 0.0_wp do k = 1 , nz sum_dz = sum_dz + dz ( k ) end do deficit = sum_dz - H_eff if ( deficit > 0.0_wp ) then if ( dz ( nz ) - deficit >= h_min ) then dz ( nz ) = dz ( nz ) - deficit else ! Too thin for the floor — set surface to h_min, let downstream ! physics guards (DRY_TOLERANCE) handle it; sum = H not enforced. dz ( nz ) = h_min end if end if end if end subroutine vcoord_target_dz_column_zstar_full ! ---- String-to-enum parsers for namelist config ---- pure integer function parse_vcoord_type ( str , default_code ) result ( coord_type ) !! Convert a namelist string to a `VCOORD_*` constant (shared by coastal !! and ocean backends). Unrecognised ⇒ `default_code` if given, else !! `VCOORD_SIGMA`. Ocean callers pass `default_code = VCOORD_EULERIAN_Z`. character ( len =* ), intent ( in ) :: str integer , intent ( in ), optional :: default_code integer :: fallback fallback = VCOORD_SIGMA if ( present ( default_code )) fallback = default_code select case ( trim ( adjustl ( str ))) case ( \"lagrangian\" , \"LAGRANGIAN\" , \"isopycnal\" , \"ISOPYCNAL\" ) coord_type = VCOORD_LAGRANGIAN case ( \"eulerian_z\" , \"EULERIAN_Z\" , \"z\" , \"Z\" ) coord_type = VCOORD_EULERIAN_Z case ( \"sigma\" , \"SIGMA\" ) coord_type = VCOORD_SIGMA case ( \"zsigma\" , \"ZSIGMA\" , \"z-sigma\" , \"z_sigma\" ) coord_type = VCOORD_ZSIGMA case ( \"zstar\" , \"ZSTAR\" , \"z-star\" , \"z_star\" , \"zstar_lite\" , \"ZSTAR_LITE\" ) coord_type = VCOORD_ZSTAR case ( \"zstar_full\" , \"ZSTAR_FULL\" , \"z-star-full\" , \"z_star_full\" , \"zstarfull\" ) coord_type = VCOORD_ZSTAR_FULL case ( \"zstar_sigma\" , \"ZSTAR_SIGMA\" , \"z-star-sigma\" , \"z_star_sigma\" , \"zstarsigma\" ) coord_type = VCOORD_ZSTAR_SIGMA case ( \"z_fixed\" , \"Z_FIXED\" , \"z_levels\" , \"Z_LEVELS\" , \"gprime\" , \"GPRIME\" ) coord_type = VCOORD_Z_FIXED case ( \"rho\" , \"RHO\" , \"isopycnic\" , \"ISOPYCNIC\" , \"rho_target\" , \"RHO_TARGET\" ) coord_type = VCOORD_RHO case ( \"hycom\" , \"HYCOM\" , \"hybrid\" , \"HYBRID\" ) coord_type = VCOORD_HYCOM case default coord_type = fallback end select end function parse_vcoord_type pure integer function parse_stretching_mode ( str ) result ( mode ) !! Convert a namelist string to a STRETCH_* constant. character ( len =* ), intent ( in ) :: str select case ( trim ( adjustl ( str ))) case ( \"log\" ) mode = STRETCH_LOG case ( \"uniform\" ) mode = STRETCH_UNIFORM case default mode = STRETCH_LOG end select end function parse_stretching_mode pure integer function parse_remap_method ( str ) result ( method ) !! Convert a namelist string to a REMAP_* constant. character ( len =* ), intent ( in ) :: str select case ( trim ( adjustl ( str ))) case ( \"pcm\" ) method = REMAP_PCM case ( \"plm\" ) method = REMAP_PLM case ( \"ppm\" ) method = REMAP_PPM case ( \"ppm_h4\" ) method = REMAP_PPM_H4 case ( \"pqm\" ) method = REMAP_PQM case default method = REMAP_PLM end select end function parse_remap_method end module rki_vcoord","tags":"","url":"sourcefile/rki_vcoord.f90.html"},{"title":"rki_ml_keps.F90 – Rakali","text":"Two-equation k-epsilon vertical-mixing closure (structured multilayer). This file depends on sourcefile~~rki_ml_keps.f90~~EfferentGraph sourcefile~rki_ml_keps.f90 rki_ml_keps.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_ml_keps.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_ml_keps.f90->sourcefile~rki_grid.f90 sourcefile~rki_keps_stability.f90 rki_keps_stability.F90 sourcefile~rki_ml_keps.f90->sourcefile~rki_keps_stability.f90 sourcefile~rki_ml_common.f90 rki_ml_common.F90 sourcefile~rki_ml_keps.f90->sourcefile~rki_ml_common.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_keps_stability.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_ml_keps.f90~~AfferentGraph sourcefile~rki_ml_keps.f90 rki_ml_keps.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_ml_keps.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Two-equation k-epsilon vertical-mixing closure (structured multilayer). module rki_ml_keps !! Standard two-equation k-epsilon model (Launder & Spalding 1974; constants !! per Rodi 1987 / Warner et al. 2005): !!   dk/dt   = d/dz(nu_t/sig_k dk/dz) + P + B - eps !!   deps/dt = d/dz(nu_t/sig_e deps/dz) + (eps/k)(ce1 P + ce3 B - ce2 eps) !!   nu_t = c_mu k&#94;2/eps,  kappa_t = nu_t/Pr_t,  P = nu_t S&#94;2,  B = -kappa_t N&#94;2 !! !! Staggering (bottom-up): velocity/density at layer centres (1..nz); !! k, eps, nu_t, kappa_t at interfaces (1..nz+1, 1=bed, nz+1=surface). !! Diffusion implicit (Thomas), dissipation sinks semi-implicit (Patankar) !! for positivity. One `do concurrent` over columns; sequential vertical !! sweep with NZ_STACK_MAX stack workspace. #ifdef LFORTRAN_PASSING use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE , & KEPS_STAB_CONSTANT #else use rki_constants , only : NZ_STACK_MAX , wp , GRAVITY , DRY_TOLERANCE , & KEPS_STAB_CONSTANT #endif use rki_grid , only : hgrid_t use rki_ml_common , only : ML_MIN_DEPTH , VANISHING_LAYER_TOL use rki_keps_stability , only : keps_stability_funcs implicit none private #ifdef LFORTRAN_PASSING integer , parameter :: NZ_STACK_MAX = 64 !! LFortran 0.64 workaround: module-local copy of the rki_constants value !! (an imported parameter used as an explicit-shape dummy bound inside a !! PURE call becomes an impure getter under LFortran). Keep in sync (=64). #endif public :: ml_keps_update public :: ml_keps_apply_momentum public :: ml_keps_apply_diffusion_tracer public :: ml_keps_friction_velocities ! Standard k-epsilon constants. real ( wp ), parameter :: CMU = 0.09_wp real ( wp ), parameter :: CE1 = 1.44_wp , CE2 = 1.92_wp , CE3 = - 0.4_wp real ( wp ), parameter :: SIG_K = 1.0_wp , SIG_E = 1.3_wp real ( wp ), parameter :: PR_T = 1.0_wp real ( wp ), parameter :: K_MIN = 1.0e-8_wp , EPS_MIN = 1.0e-12_wp real ( wp ), parameter :: NUT_MIN = 1.0e-6_wp , NUT_MAX = 1 0.0_wp ! Wall-function constants.  KAPPA_EFF is the effective von Karman constant ! implied by the k-eps constants, sqrt(SIG_E*(CE2-CE1)*sqrt(CMU)) = 0.4327 ! (hardcoded — sqrt() is not a standard constant-expression intrinsic). ! Z0_* are log-law roughness lengths (m) at the bed / surface. real ( wp ), parameter :: KAPPA_EFF = 0.4327_wp real ( wp ), parameter :: Z0_BED = 0.01_wp , Z0_SURF = 0.01_wp contains pure subroutine ml_keps_update ( h_layer , hu_layer , hv_layer , rho_layer , & tke , eps , nut , kt , rho_0 , dt , grid , nz , & ustar_b , ustar_s , scheme ) !! Advance k and eps one step per column and recover nu_t / kappa_t. !! `tke`, `eps`, `nut`, `kt` are interface-shaped (nz+1); `tke`/`eps`/ !! `nut` carry state across steps (the diffusion reads the old `nut`). !! !! Boundary closure: if the optional friction velocities `ustar_b` !! (bed) and `ustar_s` (surface) are present, Dirichlet log-law wall !! functions are imposed at the first interior interfaces (interface 2 !! above the bed, interface nz below the surface): !!   k = u_*&#94;2 / sqrt(c_mu),   eps = u_*&#94;3 / (kappa_eff*(z + z0)) !! with z the interface distance from the wall (= the adjacent layer !! thickness).  Absent both, the boundary interfaces fall back to the !! zero-gradient (no-flux) closure (used by the standalone unit tests). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: tke ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: eps ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: nut ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: kt ( grid % nx_total , grid % ny_total , nz + 1 ) !! Scalar diffusivity, carried across steps: the buoyancy term reads !! the old value, so a stratification-aware scheme stays consistent. real ( wp ), intent ( in ) :: rho_0 , dt real ( wp ), intent ( in ), optional :: ustar_b ( grid % nx_total , grid % ny_total ) !! Bed friction velocity sqrt(|tau_b|/rho_0) (m/s), per column. real ( wp ), intent ( in ), optional :: ustar_s ( grid % nx_total , grid % ny_total ) !! Surface friction velocity sqrt(|tau_wind|/rho_0) (m/s), per column. integer , intent ( in ), optional :: scheme !! Stability-function scheme (KEPS_STAB_*): absent / CONSTANT -> the !! standard constant c_mu = 0.09 (bit-identical to the original); !! GALPERIN -> stratification-aware quasi-equilibrium. integer :: i , j , m , nx , ny , nghost , ni , scheme_eff real ( wp ) :: h_col , u_dn , u_up , v_dn , v_up , dudz , dvdz , drho real ( wp ) :: prod , buoy , ktx , dd , du , denom , sink , src , eok real ( wp ) :: k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m logical :: walls real ( wp ) :: S2 ( NZ_STACK_MAX ), N2 ( NZ_STACK_MAX ), dz_if ( NZ_STACK_MAX ) real ( wp ) :: a ( NZ_STACK_MAX ), b ( NZ_STACK_MAX ), c ( NZ_STACK_MAX ) real ( wp ) :: rhs ( NZ_STACK_MAX ), cp ( NZ_STACK_MAX ) if ( nz < 2 ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost ni = nz + 1 walls = present ( ustar_b ) . and . present ( ustar_s ) scheme_eff = KEPS_STAB_CONSTANT if ( present ( scheme )) scheme_eff = scheme do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( m , h_col , u_dn , u_up , v_dn , v_up , dudz , dvdz , drho , & prod , buoy , ktx , dd , du , denom , sink , src , eok , & k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m , & S2 , N2 , dz_if , a , b , c , rhs , cp ) h_col = 0.0_wp do m = 1 , nz h_col = h_col + h_layer ( i , j , m ) end do if ( h_col > ML_MIN_DEPTH ) then ! ---- interface metrics, shear S&#94;2 and buoyancy N&#94;2 ---- dz_if ( 1 ) = 0.5_wp * h_layer ( i , j , 1 ) dz_if ( ni ) = 0.5_wp * h_layer ( i , j , nz ) S2 ( 1 ) = 0.0_wp N2 ( 1 ) = 0.0_wp S2 ( ni ) = 0.0_wp N2 ( ni ) = 0.0_wp do m = 2 , nz dz_if ( m ) = 0.5_wp * ( h_layer ( i , j , m - 1 ) + h_layer ( i , j , m )) u_dn = hu_layer ( i , j , m - 1 ) / max ( h_layer ( i , j , m - 1 ), DRY_TOLERANCE ) u_up = hu_layer ( i , j , m ) / max ( h_layer ( i , j , m ), DRY_TOLERANCE ) v_dn = hv_layer ( i , j , m - 1 ) / max ( h_layer ( i , j , m - 1 ), DRY_TOLERANCE ) v_up = hv_layer ( i , j , m ) / max ( h_layer ( i , j , m ), DRY_TOLERANCE ) dudz = ( u_up - u_dn ) / dz_if ( m ) dvdz = ( v_up - v_dn ) / dz_if ( m ) S2 ( m ) = dudz * dudz + dvdz * dvdz drho = rho_layer ( i , j , m ) - rho_layer ( i , j , m - 1 ) ! above - below N2 ( m ) = - GRAVITY * drho / rho_0 / dz_if ( m ) end do ! ---- log-law wall values (Dirichlet) when friction velocities !      are supplied; z = adjacent-layer thickness ---- if ( walls ) then k_wb = max ( ustar_b ( i , j ) * ustar_b ( i , j ) / sqrt ( CMU ), K_MIN ) e_wb = max ( ustar_b ( i , j ) ** 3 / ( KAPPA_EFF * ( h_layer ( i , j , 1 ) + Z0_BED )), EPS_MIN ) k_ws = max ( ustar_s ( i , j ) * ustar_s ( i , j ) / sqrt ( CMU ), K_MIN ) e_ws = max ( ustar_s ( i , j ) ** 3 / ( KAPPA_EFF * ( h_layer ( i , j , nz ) + Z0_SURF )), EPS_MIN ) end if ! ---- TKE: implicit diffusion + production - dissipation ---- ! At the near-wall interfaces (2 = bed, nz = surface) the wall ! functions pin k by Dirichlet; interfaces 1 / nz+1 then copy ! the wall value via the zero-gradient rows in the tridiag solve. do m = 2 , nz if ( walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = k_ws else rhs ( m ) = k_wb end if else ktx = kt ( i , j , m ) prod = nut ( i , j , m ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( i , j , m - 1 ) + nut ( i , j , m )) / SIG_K ! layer m-1 du = 0.5_wp * ( nut ( i , j , m ) + nut ( i , j , m + 1 )) / SIG_K ! layer m a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( i , j , m - 1 ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( i , j , m ) sink = eps ( i , j , m ) / max ( tke ( i , j , m ), K_MIN ) b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( prod + buoy , 0.0_wp ) rhs ( m ) = tke ( i , j , m ) + dt * src end if end do call keps_tridiag_solve ( a , b , c , rhs , cp , ni ) do m = 1 , ni tke ( i , j , m ) = max ( rhs ( m ), K_MIN ) end do ! ---- eps: implicit diffusion + (eps/k)(ce1 P + ce3 B - ce2 eps) ---- do m = 2 , nz if ( walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = e_ws else rhs ( m ) = e_wb end if else ktx = kt ( i , j , m ) prod = nut ( i , j , m ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( i , j , m - 1 ) + nut ( i , j , m )) / SIG_E du = 0.5_wp * ( nut ( i , j , m ) + nut ( i , j , m + 1 )) / SIG_E a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( i , j , m - 1 ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( i , j , m ) eok = eps ( i , j , m ) / max ( tke ( i , j , m ), K_MIN ) ! tke is NEW sink = CE2 * eok b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( eok * ( CE1 * prod + CE3 * buoy ), 0.0_wp ) rhs ( m ) = eps ( i , j , m ) + dt * src end if end do call keps_tridiag_solve ( a , b , c , rhs , cp , ni ) do m = 1 , ni eps ( i , j , m ) = max ( rhs ( m ), EPS_MIN ) end do ! ---- recover nu_t, kappa_t (constant or stratification-aware) ---- do m = 1 , ni call keps_stability_funcs ( scheme_eff , S2 ( m ), N2 ( m ), tke ( i , j , m ), & eps ( i , j , m ), cmu_m , cmup_m ) nut ( i , j , m ) = min ( max ( cmu_m * tke ( i , j , m ) * tke ( i , j , m ) & / max ( eps ( i , j , m ), EPS_MIN ), NUT_MIN ), NUT_MAX ) kt ( i , j , m ) = min ( max ( cmup_m * tke ( i , j , m ) * tke ( i , j , m ) & / max ( eps ( i , j , m ), EPS_MIN ), NUT_MIN ), NUT_MAX ) end do end if end do end subroutine ml_keps_update pure subroutine keps_tridiag_solve ( a , b , c , rhs , cp , ni ) !$acc routine seq !! In-place Thomas solve over interfaces 1..ni with zero-gradient !! (no-flux) boundary rows.  `rhs` returns the solution; `cp` scratch. integer , intent ( in ) :: ni real ( wp ), intent ( inout ) :: a ( ni ), b ( ni ), c ( ni ), rhs ( ni ), cp ( ni ) integer :: m real ( wp ) :: denom ! Zero-gradient closure: var(1)=var(2), var(ni)=var(ni-1). a ( 1 ) = 0.0_wp b ( 1 ) = 1.0_wp c ( 1 ) = - 1.0_wp rhs ( 1 ) = 0.0_wp a ( ni ) = - 1.0_wp b ( ni ) = 1.0_wp c ( ni ) = 0.0_wp rhs ( ni ) = 0.0_wp cp ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , ni denom = b ( m ) - a ( m ) * cp ( m - 1 ) cp ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = ni - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cp ( m ) * rhs ( m + 1 ) end do end subroutine keps_tridiag_solve pure subroutine ml_keps_apply_momentum ( h_layer , hu_layer , hv_layer , nut , & grid , nz , dt ) !! Apply k-epsilon eddy viscosity `nut` (interface-shaped nz+1, from !! `ml_keps_update`) to layer momentum via an implicit (Thomas) vertical- !! diffusion sweep. No-flux at bed/surface (wind stress and bottom drag !! are separate kernels); conserves column total sum_k h_k u_k exactly. !! Implicit (not explicit PP81) because nu_t can reach NUT_MAX. One !! `do concurrent` over columns; shared matrix, two RHS (u, v). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: nut ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_col , h_k , h_dn , h_up , dz_dn , dz_up , cd , cu real ( wp ) :: a ( NZ_STACK_MAX ), b ( NZ_STACK_MAX ), c ( NZ_STACK_MAX ) real ( wp ) :: ru ( NZ_STACK_MAX ), rv ( NZ_STACK_MAX ), cp ( NZ_STACK_MAX ) if ( nz < 2 ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_col , h_k , h_dn , h_up , dz_dn , dz_up , cd , cu , & a , b , c , ru , rv , cp ) h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( i , j , k ) end do if ( h_col > ML_MIN_DEPTH ) then ! Build the tridiagonal.  Row k couples to k-1 across interface ! k and to k+1 across interface k+1; cd / cu are the implicit ! coupling coefficients dt*nu_t/(h_k * dz_interface).  A ! vanishing layer on either side drops that coupling (no-flux), ! so dividing by a near-zero thickness can't blow up (same guard ! philosophy as ml_vertical_viscosity). do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k > VANISHING_LAYER_TOL ) then cd = 0.0_wp if ( k > 1 ) then h_dn = h_layer ( i , j , k - 1 ) dz_dn = 0.5_wp * ( h_dn + h_k ) if ( h_dn > VANISHING_LAYER_TOL ) then cd = dt * nut ( i , j , k ) / ( h_k * dz_dn ) end if end if cu = 0.0_wp if ( k < nz ) then h_up = h_layer ( i , j , k + 1 ) dz_up = 0.5_wp * ( h_k + h_up ) if ( h_up > VANISHING_LAYER_TOL ) then cu = dt * nut ( i , j , k + 1 ) / ( h_k * dz_up ) end if end if a ( k ) = - cd c ( k ) = - cu b ( k ) = 1.0_wp + cd + cu ru ( k ) = hu_layer ( i , j , k ) / h_k rv ( k ) = hv_layer ( i , j , k ) / h_k else ! Vanishing / dry layer: decouple, leave momentum unchanged. a ( k ) = 0.0_wp c ( k ) = 0.0_wp b ( k ) = 1.0_wp if ( h_k > 0.0_wp ) then ru ( k ) = hu_layer ( i , j , k ) / h_k rv ( k ) = hv_layer ( i , j , k ) / h_k else ru ( k ) = 0.0_wp rv ( k ) = 0.0_wp end if end if end do call keps_tridiag_solve_noflux ( a , b , c , ru , cp , nz ) call keps_tridiag_solve_noflux ( a , b , c , rv , cp , nz ) do k = 1 , nz hu_layer ( i , j , k ) = ru ( k ) * h_layer ( i , j , k ) hv_layer ( i , j , k ) = rv ( k ) * h_layer ( i , j , k ) end do end if end do end subroutine ml_keps_apply_momentum pure subroutine ml_keps_apply_diffusion_tracer ( h_layer , hTr , kt , kappa_bg , & grid , nz , dt ) !! Implicit (Thomas) vertical diffusion of one tracer using k-eps !! diffusivity `kt` (interface-shaped) plus background floor `kappa_bg`. !! No-flux at bed/surface (surface tracer fluxes are a separate kernel); !! conserves column tracer content sum_k hTr_k exactly. Implicit (not !! explicit PP81) because kt can reach NUT_MAX. Pass `tracers(it)%hTr`. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hTr ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: kt ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( in ) :: kappa_bg , dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_col , h_k , h_dn , h_up , dz_dn , dz_up , cd , cu real ( wp ) :: a ( NZ_STACK_MAX ), b ( NZ_STACK_MAX ), c ( NZ_STACK_MAX ) real ( wp ) :: r ( NZ_STACK_MAX ), cp ( NZ_STACK_MAX ) if ( nz < 2 ) return nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_col , h_k , h_dn , h_up , dz_dn , dz_up , cd , cu , a , b , c , r , cp ) h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( i , j , k ) end do if ( h_col > ML_MIN_DEPTH ) then ! Same tridiagonal as ml_keps_apply_momentum, but with the ! scalar diffusivity kt + kappa_bg and a single RHS (the tracer ! concentration hTr/h).  Vanishing layers drop the coupling. do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k > VANISHING_LAYER_TOL ) then cd = 0.0_wp if ( k > 1 ) then h_dn = h_layer ( i , j , k - 1 ) dz_dn = 0.5_wp * ( h_dn + h_k ) if ( h_dn > VANISHING_LAYER_TOL ) then cd = dt * ( kt ( i , j , k ) + kappa_bg ) / ( h_k * dz_dn ) end if end if cu = 0.0_wp if ( k < nz ) then h_up = h_layer ( i , j , k + 1 ) dz_up = 0.5_wp * ( h_k + h_up ) if ( h_up > VANISHING_LAYER_TOL ) then cu = dt * ( kt ( i , j , k + 1 ) + kappa_bg ) / ( h_k * dz_up ) end if end if a ( k ) = - cd c ( k ) = - cu b ( k ) = 1.0_wp + cd + cu r ( k ) = hTr ( i , j , k ) / h_k else a ( k ) = 0.0_wp c ( k ) = 0.0_wp b ( k ) = 1.0_wp if ( h_k > 0.0_wp ) then r ( k ) = hTr ( i , j , k ) / h_k else r ( k ) = 0.0_wp end if end if end do call keps_tridiag_solve_noflux ( a , b , c , r , cp , nz ) do k = 1 , nz hTr ( i , j , k ) = r ( k ) * h_layer ( i , j , k ) end do end if end do end subroutine ml_keps_apply_diffusion_tracer pure subroutine ml_keps_friction_velocities ( wind_x , wind_y , h_layer , & hu_layer , hv_layer , manning_n , & use_linear_drag , drag_r , rho_0 , & ustar_s , ustar_b , grid , nz ) !! Per-column surface and bed friction velocities feeding the k-eps !! wall functions (`ml_keps_update`). !!   surface: u_*s = sqrt(|tau_wind| / rho_0), tau_wind = (wind_x, !!            wind_y) the wind-stress components (Pa). !!   bed:     from the active bottom-drag law — quadratic Manning !!            u_*b = sqrt(C_d)*|u_b|, C_d = g n&#94;2 / H&#94;(1/3); or linear !!            (Rayleigh) u_*b = sqrt(r * h_b * |u_b|). !! Bottom velocity is the k=1 (bed) layer; H is the column depth. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: manning_n , drag_r , rho_0 logical , intent ( in ) :: use_linear_drag real ( wp ), intent ( out ) :: ustar_s ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: ustar_b ( grid % nx_total , grid % ny_total ) integer :: i , j , m , nx , ny , nghost real ( wp ) :: h_col , h_b , u_b , v_b , speed_b , cf nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( m , h_col , h_b , u_b , v_b , speed_b , cf ) ! surface: wind-stress magnitude -> u_*s = sqrt(|tau|/rho_0) ustar_s ( i , j ) = sqrt ( sqrt ( wind_x ( i , j ) * wind_x ( i , j ) & + wind_y ( i , j ) * wind_y ( i , j )) / rho_0 ) ! bed: bottom-layer (k=1) speed + column depth h_col = 0.0_wp do m = 1 , nz h_col = h_col + h_layer ( i , j , m ) end do h_b = h_layer ( i , j , 1 ) if ( h_b > DRY_TOLERANCE . and . h_col > ML_MIN_DEPTH ) then u_b = hu_layer ( i , j , 1 ) / h_b v_b = hv_layer ( i , j , 1 ) / h_b speed_b = sqrt ( u_b * u_b + v_b * v_b ) if ( use_linear_drag ) then ustar_b ( i , j ) = sqrt ( drag_r * h_b * speed_b ) else cf = GRAVITY * manning_n * manning_n / ( h_col ** ( 1.0_wp / 3.0_wp )) ustar_b ( i , j ) = sqrt ( cf ) * speed_b end if else ustar_b ( i , j ) = 0.0_wp end if end do end subroutine ml_keps_friction_velocities pure subroutine keps_tridiag_solve_noflux ( a , b , c , rhs , cp , n ) !$acc routine seq !! In-place Thomas solve over rows 1..n with the boundary closure !! already baked into a/b/c by the caller (no row override, unlike !! `keps_tridiag_solve`).  `rhs` returns the solution; `cp` scratch. !! a/b/c are read-only so one factorisation can serve multiple RHS. integer , intent ( in ) :: n real ( wp ), intent ( in ) :: a ( n ), b ( n ), c ( n ) real ( wp ), intent ( inout ) :: rhs ( n ), cp ( n ) integer :: m real ( wp ) :: denom cp ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , n denom = b ( m ) - a ( m ) * cp ( m - 1 ) cp ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = n - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cp ( m ) * rhs ( m + 1 ) end do end subroutine keps_tridiag_solve_noflux end module rki_ml_keps","tags":"","url":"sourcefile/rki_ml_keps.f90.html"},{"title":"rki_si_unstr_closures.F90 – Rakali","text":"Closure -> SI seam kernels: k-epsilon / KPP interface viscosity fills for\nthe semi-implicit multilayer step (unstructured). This file depends on sourcefile~~rki_si_unstr_closures.f90~~EfferentGraph sourcefile~rki_si_unstr_closures.f90 rki_si_unstr_closures.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_si_unstr_closures.f90->sourcefile~rki_constants.f90 sourcefile~rki_ml_common_unstr.f90 rki_ml_common_unstr.F90 sourcefile~rki_si_unstr_closures.f90->sourcefile~rki_ml_common_unstr.f90 sourcefile~rki_ml_common_unstr.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_si_unstr_closures.f90~~AfferentGraph sourcefile~rki_si_unstr_closures.f90 rki_si_unstr_closures.F90 sourcefile~rki_si_unstr_step_ml.f90 rki_si_unstr_step_ml.F90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_closures.f90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step_ml.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Closure -> SI seam kernels: k-epsilon / KPP interface viscosity fills for !! the semi-implicit multilayer step (unstructured). module rki_si_unstr_closures !! Q1 (SI vertical-mixing closures) for the unstructured backend. !! The SI column solve consumes ANY interface viscosity through !! `state%si%nu_iface`; closures are pure FILLS of that slot.  This module !! holds the flat explicit-shape fill kernels on the `(nz, ncells)` layout: !! !! * `si_unstr_fill_nu_iface_from_keps` — copy the k-epsilon `keps_nut` !!   (interface-shaped (nz+1, n), advanced by the UNCHANGED !!   `ml_keps_update_unstr` at SI cadence — the explicit kernel is already !!   backward-Euler/Patankar) into `nu_iface`, with the SI convention's !!   bed/surface zero rows and the vanished-layer decoupling gate. !! * `si_unstr_keps_copy_iface` — interface-array copy for the optional !!   `keps_si_picard > 1` save/restore of the pre-step k / eps. !! * `si_unstr_build_nu_interface_kpp` — PP81 interior viscosity with the !!   KPP (LMD94) shape-function overlay MAX'd in, written to `nu_iface` for !!   the IMPLICIT column tridiagonal.  NO explicit-flux CFL clamp — the !!   coastal explicit `ml_kpp_viscosity_unstr` clamp would strangle the !!   overlay at SI step sizes (dt = 120-480 s); the implicit solve is !!   unconditionally stable at any nu. !! * `si_unstr_kpp_diffusion_tracers` — S/T IMPLICIT (Thomas) vertical !!   diffusion with the PP81-cubic + KPP-overlay diffusivity, plus the !!   LMD94 non-local counter-gradient transport applied after the diffusion !!   (the coastal explicit order: vdiff-then-nonlocal), reading the !!   post-diffusion surface salinity for F_S.  Conserves column tracer !!   content (no-flux tridiagonal, conservative nonlocal divergence). !! !! Layer convention (load-bearing): BOTTOM-UP — k=1 bed, k=nz surface; !! interface m sits BELOW layer m (m=1 bed, m=nz+1 surface).  Cell-centric !! `do concurrent` over cells; per-column serial work in-body with !! NZ_STACK_MAX locals; explicit-shape dummies throughout (NVHPC rule). #ifdef LFORTRAN_PASSING use rki_constants , only : wp , GRAVITY , H_VANISHED , DRY_TOLERANCE #else use rki_constants , only : NZ_STACK_MAX , wp , GRAVITY , H_VANISHED , DRY_TOLERANCE #endif use rki_ml_common_unstr , only : ML_MIN_DEPTH_UNSTR implicit none private #ifdef LFORTRAN_PASSING integer , parameter :: NZ_STACK_MAX = 64 !! LFortran 0.64 workaround: module-local copy of the rki_constants value !! (an imported parameter used as an explicit-shape dummy bound inside a !! PURE call becomes an impure getter under LFortran). Keep in sync (=64). #endif public :: si_unstr_fill_nu_iface_from_keps public :: si_unstr_keps_copy_iface public :: si_unstr_build_nu_interface_kpp public :: si_unstr_kpp_diffusion_tracers real ( wp ), parameter :: SHEAR2_EPS = 1.0e-20_wp !! Shear&#94;2 floor in the interior gradient-Ri (matches PP81 + kpp kernels). contains pure subroutine si_unstr_fill_nu_iface_from_keps ( nz , nzp1 , nct , nco , & h_layer , keps_nut , nu_iface ) !! Copy the k-epsilon interface viscosity into the SI column-solve slot. !! `keps_nut` and `nu_iface` share the interface convention (m=1 bed, !! m=nz+1 surface); interior interfaces copy 1:1; bed and surface rows !! are forced to 0 (no flux through bed/surface — wind and drag enter !! the column solve separately), and an interface bounded by a vanished !! layer decouples (nu = 0), mirroring `si_unstr_build_nu_interface` !! so the closure swap changes ONLY the viscosity values. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up (k=1 bed). real ( wp ), intent ( in ) :: keps_nut ( nzp1 , nct ) !! k-epsilon interface eddy viscosity [m&#94;2/s] (from ml_keps_update_unstr). real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! SI interface viscosity [m&#94;2/s], vdiff convention. integer :: c , k real ( wp ) :: hk , hkp1 do concurrent ( c = 1 : nco ) local ( k , hk , hkp1 ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) if ( hk <= H_VANISHED . or . hkp1 <= H_VANISHED ) then nu_iface ( k + 1 , c ) = 0.0_wp else nu_iface ( k + 1 , c ) = keps_nut ( k + 1 , c ) end if end do end do end subroutine si_unstr_fill_nu_iface_from_keps pure subroutine si_unstr_keps_copy_iface ( nzp1 , nct , nco , src , dst ) !! Interface-array copy (nzp1, nct) for the `keps_si_picard > 1` !! save/restore: the Picard loop re-runs `ml_keps_update_unstr` from !! the SAME pre-step k / eps with the refreshed nu_t production !! coefficient (see local_archive/prototypes/si_closures/DISCRETIZATION_SPEC.md !! section 3). integer , intent ( in ) :: nzp1 !! Interface count (nz + 1). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: src ( nzp1 , nct ) !! Source interface array. real ( wp ), intent ( out ) :: dst ( nzp1 , nct ) !! Destination interface array. integer :: c , m do concurrent ( m = 1 : nzp1 , c = 1 : nco ) dst ( m , c ) = src ( m , c ) end do end subroutine si_unstr_keps_copy_iface pure subroutine si_unstr_build_nu_interface_kpp ( nz , nzp1 , nct , nco , & h_layer , hu_layer , hv_layer , & rho_layer , rho_0 , nu_max , & nu_bg , ri_alpha , u_star , & buoy_flux , bl_depth , nu_iface ) !! PP81 interior interface viscosity with the KPP (LMD94) surface- !! boundary-layer overlay MAX'd in, for the SI implicit column solve: !!   nu = max( nu_max/(1+ri_alpha*Ri)&#94;2 + nu_bg, !!             h_b * w_s * G(sigma) )        for interfaces inside h_b !! with G(sigma) = sigma(1-sigma)&#94;2, sigma = d_iface/h_b, and the !! velocity scale w_s = sqrt(u_*&#94;2 + w_*&#94;2), w_*&#94;3 = max(0,-B_0)*h_b. !! NO dt clamp: the consumer is the unconditionally-stable implicit !! tridiagonal.  Where the overlay is inactive (w_s = 0 / below the !! BL) the result is EXACTLY the PP81 `si_unstr_build_nu_interface` value. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! PP81 maximum turbulent viscosity [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_bg !! Background viscosity floor [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! PP81 Richardson tuning coefficient. real ( wp ), intent ( in ) :: u_star ( nct ) !! Surface friction velocity [m/s] (from ml_kpp_boundary_layer_unstr). real ( wp ), intent ( in ) :: buoy_flux ( nct ) !! Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real ( wp ), intent ( in ) :: bl_depth ( nct ) !! Diagnosed boundary-layer depth [m]. real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s], vdiff convention (bed/surface 0). integer :: c , k real ( wp ) :: h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , ri_num , denom_ri , nu_t real ( wp ) :: h_b , b_0 , us , wstar3_val , w_star , w_s real ( wp ) :: d_below , d_iface , sig , g_shape , nu_kpp do concurrent ( c = 1 : nco ) & local ( k , h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , & du , dv , drho , ri_num , denom_ri , nu_t , & h_b , b_0 , us , wstar3_val , w_star , w_s , & d_below , d_iface , sig , g_shape , nu_kpp ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( k , c ) end do if ( h_col > ML_MIN_DEPTH_UNSTR ) then h_b = bl_depth ( c ) b_0 = buoy_flux ( c ) us = u_star ( c ) wstar3_val = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3_val ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) h_avg = 0.5_wp * ( hk + hkp1 ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED ) then uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + SHEAR2_EPS ) if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom_ri = 1.0_wp + ri_alpha * ri_num nu_t = nu_max / ( denom_ri * denom_ri ) + nu_bg ! KPP overlay inside the boundary layer (max, LMD94). if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) nu_kpp = h_b * w_s * g_shape if ( nu_kpp > nu_t ) nu_t = nu_kpp end if nu_iface ( k + 1 , c ) = nu_t else nu_iface ( k + 1 , c ) = 0.0_wp end if end do else do k = 1 , nz - 1 nu_iface ( k + 1 , c ) = 0.0_wp end do end if end do end subroutine si_unstr_build_nu_interface_kpp pure subroutine si_unstr_kpp_diffusion_tracers ( nz , nzp1 , nct , nco , h_layer , & hu_layer , hv_layer , hS_layer , & hT_layer , rho_layer , rho_0 , & nu_max , kappa_S_bg , kappa_T_bg , & ri_alpha , cs_nonlocal , heat_flux , & evap_minus_precip , cp , u_star , & buoy_flux , bl_depth , dt ) !! S/T vertical diffusion with the KPP overlay for the SI step: !! IMPLICIT (Thomas) column solve with the PP81-CUBIC interior !! diffusivity + the KPP shape-function overlay MAX'd in (same !! overlay as momentum; no dt clamp — implicit), then the LMD94 !! non-local counter-gradient transport applied as a conservative !! interface divergence AFTER the diffusion (the coastal explicit !! order: vdiff-then-nonlocal), reading the post-diffusion surface !! salinity for F_S.  gamma = 0 at bed and surface => the divergence !! conserves the column integral exactly.  Conserves column tracer !! content (no-flux tridiagonal). integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s] (shear for the PP81 Ri). real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( inout ) :: hS_layer ( nz , nct ) !! Salinity content [PSU m], updated in place. real ( wp ), intent ( inout ) :: hT_layer ( nz , nct ) !! Temperature content [degC m], updated in place. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! PP81 maximum turbulent diffusivity scale [m&#94;2/s]. real ( wp ), intent ( in ) :: kappa_S_bg !! Background salinity diffusivity [m&#94;2/s]. real ( wp ), intent ( in ) :: kappa_T_bg !! Background temperature diffusivity [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! PP81 Richardson tuning coefficient. real ( wp ), intent ( in ) :: cs_nonlocal !! Non-local transport coefficient C_s (LMD94 eq 20). real ( wp ), intent ( in ) :: heat_flux ( nct ) !! Surface heat flux [W/m&#94;2] (positive warms), per cell. real ( wp ), intent ( in ) :: evap_minus_precip ( nct ) !! Net evaporation [m/s], per cell. real ( wp ), intent ( in ) :: cp !! Specific heat of water [J/(kg K)]. real ( wp ), intent ( in ) :: u_star ( nct ) !! Surface friction velocity [m/s]. real ( wp ), intent ( in ) :: buoy_flux ( nct ) !! Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real ( wp ), intent ( in ) :: bl_depth ( nct ) !! Diagnosed boundary-layer depth [m]. real ( wp ), intent ( in ) :: dt !! Time step [s]. integer :: c , k real ( wp ) :: h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , ri_num , denom_ri , kap real ( wp ) :: h_b , b_0 , us , wstar3_val , w_star , w_s real ( wp ) :: d_below , d_iface , sig , g_shape , nu_kpp real ( wp ) :: h_top , s_top , f_t_kin , f_s_kin , gamma_t , gamma_s real ( wp ) :: cd_val , cu_val , dz_dn , dz_up ! Per-site gfortran 15.1 gotcha: use separate locals for each write site ! inside do concurrent to avoid the \"local reassigned across if/else\" ! corruption bug. real ( wp ) :: kapS_k , kapT_k real ( wp ) :: kapS ( NZ_STACK_MAX ), kapT ( NZ_STACK_MAX ) real ( wp ) :: aa ( NZ_STACK_MAX ), bb ( NZ_STACK_MAX ), cc ( NZ_STACK_MAX ) real ( wp ) :: rS ( NZ_STACK_MAX ), rT ( NZ_STACK_MAX ), cpv ( NZ_STACK_MAX ) logical :: destabilizing if ( nz < 2 ) return do concurrent ( c = 1 : nco ) & local ( k , h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , & du , dv , drho , ri_num , denom_ri , kap , & h_b , b_0 , us , wstar3_val , w_star , w_s , & d_below , d_iface , sig , g_shape , nu_kpp , & h_top , s_top , f_t_kin , f_s_kin , gamma_t , gamma_s , & cd_val , cu_val , dz_dn , dz_up , kapS_k , kapT_k , & kapS , kapT , aa , bb , cc , rS , rT , cpv , destabilizing ) h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( k , c ) end do if ( h_col > ML_MIN_DEPTH_UNSTR ) then h_b = bl_depth ( c ) b_0 = buoy_flux ( c ) us = u_star ( c ) wstar3_val = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3_val ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) destabilizing = ( b_0 < 0.0_wp ) ! ---- interface diffusivities: PP81 cubic + KPP overlay ---- ! kapS/kapT(m): interface m convention (1 = bed = 0 flux). kapS ( 1 ) = 0.0_wp kapT ( 1 ) = 0.0_wp kapS ( nz + 1 ) = 0.0_wp kapT ( nz + 1 ) = 0.0_wp d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) h_avg = 0.5_wp * ( hk + hkp1 ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED ) then uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + SHEAR2_EPS ) if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom_ri = 1.0_wp + ri_alpha * ri_num kap = nu_max / ( denom_ri * denom_ri * denom_ri ) nu_kpp = 0.0_wp if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) nu_kpp = h_b * w_s * g_shape end if kapS_k = max ( kap + kappa_S_bg , nu_kpp ) kapT_k = max ( kap + kappa_T_bg , nu_kpp ) else kapS_k = 0.0_wp kapT_k = 0.0_wp end if kapS ( k + 1 ) = kapS_k kapT ( k + 1 ) = kapT_k end do ! ---- implicit (Thomas) diffusion of S concentration ---- do k = 1 , nz hk = h_layer ( k , c ) if ( hk > H_VANISHED ) then cd_val = 0.0_wp if ( k > 1 ) then if ( h_layer ( k - 1 , c ) > H_VANISHED ) then dz_dn = 0.5_wp * ( h_layer ( k - 1 , c ) + hk ) cd_val = dt / ( hk * dz_dn ) end if end if cu_val = 0.0_wp if ( k < nz ) then if ( h_layer ( k + 1 , c ) > H_VANISHED ) then dz_up = 0.5_wp * ( hk + h_layer ( k + 1 , c )) cu_val = dt / ( hk * dz_up ) end if end if aa ( k ) = - cd_val * kapS ( k ) cc ( k ) = - cu_val * kapS ( k + 1 ) bb ( k ) = 1.0_wp + cd_val * kapS ( k ) + cu_val * kapS ( k + 1 ) rS ( k ) = hS_layer ( k , c ) / hk else aa ( k ) = 0.0_wp cc ( k ) = 0.0_wp bb ( k ) = 1.0_wp if ( hk > 0.0_wp ) then rS ( k ) = hS_layer ( k , c ) / hk else rS ( k ) = 0.0_wp end if end if end do call si_unstr_tridiag_noflux ( aa , bb , cc , rS , cpv , nz ) do k = 1 , nz hS_layer ( k , c ) = rS ( k ) * h_layer ( k , c ) end do ! ---- implicit (Thomas) diffusion of T concentration ---- do k = 1 , nz hk = h_layer ( k , c ) if ( hk > H_VANISHED ) then cd_val = 0.0_wp if ( k > 1 ) then if ( h_layer ( k - 1 , c ) > H_VANISHED ) then dz_dn = 0.5_wp * ( h_layer ( k - 1 , c ) + hk ) cd_val = dt / ( hk * dz_dn ) end if end if cu_val = 0.0_wp if ( k < nz ) then if ( h_layer ( k + 1 , c ) > H_VANISHED ) then dz_up = 0.5_wp * ( hk + h_layer ( k + 1 , c )) cu_val = dt / ( hk * dz_up ) end if end if aa ( k ) = - cd_val * kapT ( k ) cc ( k ) = - cu_val * kapT ( k + 1 ) bb ( k ) = 1.0_wp + cd_val * kapT ( k ) + cu_val * kapT ( k + 1 ) rT ( k ) = hT_layer ( k , c ) / hk else aa ( k ) = 0.0_wp cc ( k ) = 0.0_wp bb ( k ) = 1.0_wp if ( hk > 0.0_wp ) then rT ( k ) = hT_layer ( k , c ) / hk else rT ( k ) = 0.0_wp end if end if end do call si_unstr_tridiag_noflux ( aa , bb , cc , rT , cpv , nz ) do k = 1 , nz hT_layer ( k , c ) = rT ( k ) * h_layer ( k , c ) end do ! ---- non-local counter-gradient transport (post-diffusion) ---- if ( destabilizing . and . w_s > 0.0_wp . and . h_b > 0.0_wp ) then h_top = h_layer ( nz , c ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( nz , c ) / h_top else s_top = 0.0_wp end if f_t_kin = heat_flux ( c ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( c ) * s_top d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED . and . & d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) gamma_t = cs_nonlocal * g_shape * f_t_kin gamma_s = cs_nonlocal * g_shape * f_s_kin hT_layer ( k , c ) = hT_layer ( k , c ) + dt * gamma_t hT_layer ( k + 1 , c ) = hT_layer ( k + 1 , c ) - dt * gamma_t hS_layer ( k , c ) = hS_layer ( k , c ) + dt * gamma_s hS_layer ( k + 1 , c ) = hS_layer ( k + 1 , c ) - dt * gamma_s end if end do end if end if end do end subroutine si_unstr_kpp_diffusion_tracers pure subroutine si_unstr_tridiag_noflux ( a , b , c , rhs , cpv , n ) !$acc routine seq !! In-place Thomas solve over rows 1..n with the boundary closure !! baked into a/b/c by the caller (the no-flux tridiagonal closure). !! `rhs` returns the solution. integer , intent ( in ) :: n real ( wp ), intent ( in ) :: a ( n ), b ( n ), c ( n ) real ( wp ), intent ( inout ) :: rhs ( n ), cpv ( n ) integer :: m real ( wp ) :: denom cpv ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , n denom = b ( m ) - a ( m ) * cpv ( m - 1 ) cpv ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = n - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cpv ( m ) * rhs ( m + 1 ) end do end subroutine si_unstr_tridiag_noflux end module rki_si_unstr_closures","tags":"","url":"sourcefile/rki_si_unstr_closures.f90.html"},{"title":"rki_kernel_timestep.F90 – Rakali","text":"CFL-based adaptive timestep computation kernel This file depends on sourcefile~~rki_kernel_timestep.f90~~EfferentGraph sourcefile~rki_kernel_timestep.f90 rki_kernel_timestep.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_timestep.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_kernel_timestep.f90->sourcefile~rki_grid.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_kernel_timestep.f90~~AfferentGraph sourcefile~rki_kernel_timestep.f90 rki_kernel_timestep.F90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_solver.f90->sourcefile~rki_kernel_timestep.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! CFL-based adaptive timestep computation kernel module rki_kernel_timestep !! Maximum stable timestep from the CFL condition: !! dt = cfl * min(dx, dy) / max_wavespeed, !! max_wavespeed = max(|u| + sqrt(g*h), |v| + sqrt(g*h)). use rki_constants , only : wp , GRAVITY , DRY_TOLERANCE , DESING_EPS use rki_grid , only : hgrid_t implicit none private public :: compute_timestep public :: compute_timestep_baroclinic contains subroutine compute_timestep ( h , hu , hv , grid , cfl , dt ) !! Maximum stable timestep: reduces over interior cells for the max !! wave speed, then dt = cfl * min(dx,dy) / max_wavespeed. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: cfl !! CFL number real ( wp ), intent ( out ) :: dt !! Computed timestep (s) integer :: i , j , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: max_speed , speed_x , speed_y , u_abs , v_abs , wave_speed real ( wp ) :: h4 , eps4 , denom , eps nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy ! Desingularization parameter (Kurganov & Petrova, 2007): the SAME ! eps as the update kernels' thin-cell desingularization, so the dt ! bound and the update agree about what \"thin\" means.  (The old ! `max(eps, 0.01*min(dx,dy))` grid term is gone: on coarse grids it ! made this estimator blind to real velocities in cells shallower ! than 1% of the cell width — a latent CFL bug.)  The denominator ! here omits the KP07 `max(h&#94;4, eps&#94;4)`, so the speed estimated ! below is >= the desingularized velocity the update kernels produce ! for every h (by up to sqrt(2) in deep water) — a strict, mildly ! conservative upper bound on the CFL. eps = DESING_EPS eps4 = eps ** 4 max_speed = 0.0_wp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( wave_speed , h4 , denom , u_abs , v_abs , speed_x , speed_y ) & reduce ( max : max_speed ) if ( h ( i , j ) > DRY_TOLERANCE ) then wave_speed = sqrt ( GRAVITY * h ( i , j )) ! Desingularized velocity (Kurganov & Petrova, 2007): !   u = sqrt(2)*h*hu / sqrt(h&#94;4 + eps&#94;4) h4 = h ( i , j ) ** 4 denom = sqrt ( h4 + eps4 ) u_abs = abs ( hu ( i , j )) * sqrt ( 2.0_wp ) * h ( i , j ) / denom v_abs = abs ( hv ( i , j )) * sqrt ( 2.0_wp ) * h ( i , j ) / denom speed_x = u_abs + wave_speed speed_y = v_abs + wave_speed max_speed = max ( max_speed , speed_x / dx , speed_y / dy ) end if end do if ( max_speed > 0.0_wp ) then dt = cfl / max_speed else dt = cfl * min ( dx , dy ) / sqrt ( GRAVITY * DRY_TOLERANCE ) end if end subroutine compute_timestep subroutine compute_timestep_baroclinic ( h , u_layer , v_layer , dsig , & grid , nz , cfl , dt ) !! Baroclinic timestep from the internal-wave CFL: !! max(|u_layer_k| + c_int)/dx, c_int = sqrt(g*H/nz) (uniform sigma). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: cfl real ( wp ), intent ( out ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: max_speed , c_int , speed_x , speed_y nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy max_speed = 0.0_wp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( c_int , speed_x , speed_y , k ) & reduce ( max : max_speed ) if ( h ( i , j ) > DRY_TOLERANCE ) then c_int = sqrt ( GRAVITY * h ( i , j ) / real ( nz , wp )) do k = 1 , nz speed_x = ( abs ( u_layer ( i , j , k )) + c_int ) / dx speed_y = ( abs ( v_layer ( i , j , k )) + c_int ) / dy max_speed = max ( max_speed , speed_x , speed_y ) end do end if end do if ( max_speed > 0.0_wp ) then dt = cfl / max_speed else dt = cfl * min ( dx , dy ) / sqrt ( GRAVITY * DRY_TOLERANCE / real ( nz , wp )) end if end subroutine compute_timestep_baroclinic end module rki_kernel_timestep","tags":"","url":"sourcefile/rki_kernel_timestep.f90.html"},{"title":"rki_kernel_flux_unstr.F90 – Rakali","text":"Central-upwind flux kernel for the unstructured solver This file depends on sourcefile~~rki_kernel_flux_unstr.f90~~EfferentGraph sourcefile~rki_kernel_flux_unstr.f90 rki_kernel_flux_unstr.F90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_kernel_flux_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_flux_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_kernel_flux_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_kernel_flux_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_un