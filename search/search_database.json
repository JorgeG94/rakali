e, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial type( console_stats_t ), private :: console_stats Persistent MOM6-style console reporter (latches the t=0\nreference for the drift columns). type( forcing_t ), private :: forc type( gauge_output_t ), private :: gauges real(kind=wp), private :: mcells_per_sec integer, private :: n_snapshots integer, private :: n_steps type( nesting_t ), private :: nest real(kind=wp), private :: next_gauge_time real(kind=wp), private :: next_output_time real(kind=wp), private :: next_restart_time real(kind=wp), private :: next_status_time type( output_state_t ), private :: ostate character(len=512), private :: rank_filename integer(kind=int64), private :: rss0 integer(kind=int64), private :: rss1 type(timer_type), private :: setup_timer type( state_t ), private :: state real(kind=wp), private :: t_current real(kind=wp), private :: total_mass_final real(kind=wp), private :: total_mass_initial logical, private :: use_async_output logical, private :: use_netcdf_output logical, private :: use_restart_output real(kind=wp), private :: wall_elapsed type(timer_type), private :: wall_timer Source Code subroutine driver_run_coastal ( cfg ) !! Run the full lifecycle for the structured coastal regime. !! !! Allocates and initialises state, configures BCs / forcing / nesting / output / gauges, places !! data on GPU, runs the time-stepping loop with periodic !! diagnostics and output, then finalises (D2H, final snapshot, !! diagnostics, profiler, resource cleanup). type ( config_t ), intent ( in ) :: cfg type ( state_t ) :: state type ( forcing_t ) :: forc type ( nesting_t ) :: nest type ( output_state_t ) :: ostate type ( timer_type ) :: wall_timer , setup_timer type ( gauge_output_t ) :: gauges type ( console_stats_t ) :: console_stats !! Persistent MOM6-style console reporter (latches the t=0 !! reference for the drift columns). character ( len = 512 ) :: rank_filename real ( wp ) :: t_current , total_mass_initial , total_mass_final real ( wp ) :: next_output_time , next_restart_time , next_status_time real ( wp ) :: next_gauge_time real ( wp ) :: wall_elapsed , mcells_per_sec integer :: n_steps , n_snapshots integer ( int64 ) :: rss0 , rss1 logical :: use_netcdf_output , use_restart_output logical :: use_async_output call setup_timer % start () ! Host RSS before state allocation — the growth across init is an ! ADVISORY host-side figure + a conservative upper bound for the ! pre-flight OOM warning; the true device footprint is measured ! across enter_data (see rki_mem_report). rss0 = mem_host_rss_bytes () call init_local_state ( cfg , state , t_current , total_mass_initial ) ! Set boundary condition parameters and allocate Chapman arrays call init_bc_from_config ( state , cfg ) call init_bc_chapman ( state ) ! Initialise atmospheric forcing from NetCDF (if configured) call forcing_init_from_config ( forc , cfg , state ) state % forcing % active = forc % active ! Initialise one-way nesting from parent domain (if configured) call nesting_init_from_config ( nest , cfg , state ) ! Initialise NetCDF output use_netcdf_output = cfg % output_to_file . and . & trim ( cfg % output_format ) == \"netcdf\" if ( use_netcdf_output ) then rank_filename = output_rank_filename ( trim ( cfg % output_dir ), \"output\" , 0 ) call output_init ( ostate , trim ( rank_filename ), state , cfg ) end if if ( use_netcdf_output ) then next_output_time = t_current + cfg % output_interval end if ! Initialise gauge point output (high-frequency time series) call gauges_init ( gauges , cfg , state , 0 ) if ( gauges % active ) then if ( cfg % gauge_output_interval > 0.0_wp ) then next_gauge_time = t_current + cfg % gauge_output_interval else next_gauge_time = t_current end if end if use_async_output = . false . ! Restart output scheduling use_restart_output = ( cfg % restart_interval > 0.0_wp ) if ( use_restart_output ) then next_restart_time = t_current + cfg % restart_interval end if ! Status output scheduling if ( cfg % status_interval > 0.0_wp ) then next_status_time = t_current + cfg % status_interval end if ! Initialise profiler (NVTX annotations + wall-clock timers) call profiler_init () ! Memory budget: host growth since rss0 is the upper-bound estimate ! of what enter_data will map.  Log it (+ device free/total compare) ! BEFORE the mapping so an over-budget run reports a readable line ! instead of dying opaquely inside the CUDA runtime. rss1 = mem_host_rss_bytes () if ( rss0 >= 0_int64 . and . rss1 >= 0_int64 ) then call mem_log_state_budget ( \"coastal state\" , max ( rss1 - rss0 , 0_int64 )) end if ! Latch the counted state-array footprint for the enter_data ! reconciliation (mem_log_device_actuals reads it); the human-readable ! budget prints in the run-header banner (log_run_header). call mem_set_counted_budget ( state % bytes ()) ! Place data on GPU call profiler_start ( \"coastal_enter_data\" ) call solver_enter_data ( state ) call profiler_stop ( \"coastal_enter_data\" ) call mem_log_device_actuals ( \"coastal state mapped\" ) call setup_timer % stop () call logger % info ( \"Setup time: \" // to_string ( setup_timer % get_elapsed_time ()) // \" s\" ) ! Warmup step to trigger lazy GPU initialisation (JIT, context setup) if ( t_current < cfg % t_end ) then call solver_step ( state , dt_max = ( cfg % t_end - t_current ), time = t_current ) t_current = t_current + state % dt end if ! Banner before time evolution call log_time_evolution_banner ( cfg , use_netcdf_output ) ! Salt / Temp columns + drift lines only make sense with the ! multilayer tracers; a 2D-barotropic run reports Mass + En only. console_stats % report_thermodynamics = state % use_multilayer ! Coastal stability is gravity-wave-limited, so a high *advective* ! CFL is normal — keep the NaN guard, drop the CFL panic. console_stats % panic_on_cfl = . false . ! Main time-stepping loop n_steps = 1 n_snapshots = 0 call wall_timer % start () call profiler_start ( \"time_loop\" ) do while ( t_current < cfg % t_end ) ! Update atmospheric forcing arrays for current time if ( forc % active ) then call forcing_update ( forc , state , t_current ) !$acc update device(state%forcing%wind_x, state%forcing%wind_y, & !$acc&              state%forcing%atm_pressure, & !$acc&              state%forcing%precipitation, & !$acc&              state%forcing%heat_flux, & !$acc&              state%forcing%evap_minus_precip) end if ! Update nested boundary ghost cells from parent domain if ( nest % active ) then !$acc update self(state%barotropic%h, state%barotropic%hu, state%barotropic%hv) call nesting_update ( nest , state , t_current ) !$acc update device(state%barotropic%h, state%barotropic%hu, state%barotropic%hv) end if call profiler_start ( \"solver_step\" ) call solver_step ( state , dt_max = ( cfg % t_end - t_current ), time = t_current ) call profiler_stop ( \"solver_step\" ) t_current = t_current + state % dt n_steps = n_steps + 1 ! Periodic status output (table format) if ( cfg % status_interval > 0.0_wp ) then if ( t_current >= next_status_time ) then call emit_periodic_status ( state , cfg , n_steps , t_current , & real ( wall_timer % get_elapsed_time (), wp ), & console_stats ) ! Quiet drift check: one-shot warning if device memory grew ! > 15% past the post-enter_data baseline (lazy workspaces / ! leak) — no info lines at status cadence. call mem_log_device_growth ( \"coastal status\" , quiet = . true .) next_status_time = next_status_time + cfg % status_interval end if else if ( mod ( n_steps , 100 ) == 0 ) then call print_status_line ( n_steps , t_current , state % dt , & real ( wall_timer % get_elapsed_time (), wp ), cfg % t_end ) end if ! NetCDF snapshot output if ( use_netcdf_output . and . t_current >= next_output_time ) then call flush_snapshot ( state , ostate , cfg , t_current , next_output_time , & n_snapshots ) end if ! Restart file output if ( use_restart_output . and . t_current >= next_restart_time ) then call flush_restart ( state , cfg , t_current , next_restart_time ) end if ! Gauge point output (high-frequency time series) if ( gauges % active ) then if ( cfg % gauge_output_interval <= 0.0_wp . or . t_current >= next_gauge_time ) then call write_gauges ( gauges , state , cfg , t_current , next_gauge_time ) end if end if end do call profiler_stop ( \"time_loop\" ) wall_elapsed = wall_timer % get_elapsed_time () call logger % info ( \"\" ) call logger % info ( \"Solver complete: \" // to_string ( n_steps ) // \" steps in \" // & to_string ( wall_elapsed ) // \" s\" ) call report_throughput ( real ( cfg % nx , wp ) * real ( cfg % ny , wp ), n_steps , & wall_elapsed , mcells_per_sec ) ! End-of-run device-memory truth: state is still device-resident ! here (exit_data below) — the growth since enter_data attributes ! the lazily allocated kernel workspaces even on short runs. call mem_log_device_growth ( \"coastal end of run\" ) ! --- Finalisation (output flush, D2H, gather, diagnostics) --- call setup_timer % start () ! Compute final mass on device (GPU reduction, transfers only 1 scalar) total_mass_final = compute_total_mass ( state ) ! Retrieve data from GPU call profiler_start ( \"coastal_exit_data\" ) call solver_exit_data ( state ) call profiler_stop ( \"coastal_exit_data\" ) ! Write the final snapshot call finalize_output ( state , ostate , t_current , use_netcdf_output ) call setup_timer % stop () call logger % info ( \"Finalisation time: \" // to_string ( setup_timer % get_elapsed_time ()) // \" s\" ) ! Final diagnostics call wall_timer % stop () call log_final_diagnostics ( state , cfg , n_steps , wall_elapsed , & real ( wall_timer % get_elapsed_time (), wp ), & mcells_per_sec , total_mass_final , & total_mass_initial , use_netcdf_output ) ! Print profiling summary call profiler_report ( \"Compute\" , root_region = \"time_loop\" ) call profiler_end () call get_knowledge () call nesting_destroy ( nest ) call forcing_destroy ( forc ) call gauges_destroy ( gauges ) call state % destroy () end subroutine driver_run_coastal","tags":"","url":"proc/driver_run_coastal.html"},{"title":"driver_run_coastal_unstr – Rakali","text":"private  subroutine driver_run_coastal_unstr(cfg) Uses rki_ml_eos proc~~driver_run_coastal_unstr~~UsesGraph proc~driver_run_coastal_unstr driver_run_coastal_unstr module~rki_ml_eos rki_ml_eos proc~driver_run_coastal_unstr->module~rki_ml_eos module~rki_constants rki_constants module~rki_ml_eos->module~rki_constants module~rki_eos rki_eos module~rki_ml_eos->module~rki_eos module~rki_grid rki_grid module~rki_ml_eos->module~rki_grid module~rki_ml_common rki_ml_common module~rki_ml_eos->module~rki_ml_common pic_types pic_types module~rki_constants->pic_types module~rki_eos->module~rki_constants module~rki_eos->module~rki_grid module~rki_grid->module~rki_constants module~rki_ml_common->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. End-to-end unstructured coastal run on a native regular-triangulation\nmesh (Python-free).  Routed from driver_run when grid_type==\"unstructured\" ; reuses &grid_nml (nx,ny,dx,dy) for the\nmesh and nz_layers for the column.  Flat bed, lake at rest,\nhorizontally-uniform IC. Arguments Type Intent Optional Attributes Name type( config_t ), intent(inout) :: cfg Calls proc~~driver_run_coastal_unstr~~CallsGraph proc~driver_run_coastal_unstr driver_run_coastal_unstr get_elapsed_time get_elapsed_time proc~driver_run_coastal_unstr->get_elapsed_time info info proc~driver_run_coastal_unstr->info proc~gen_delaunay_