onnecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha real(kind=wp), private :: cd integer, private :: i integer, private :: i0 integer, private :: i0p integer, private :: j integer, private :: j0 integer, private :: j0p real(kind=wp), private :: msl_val integer, private :: ng integer, private :: nx integer, private :: ny real(kind=wp), private :: tau_x real(kind=wp), private :: tau_y real(kind=wp), private :: tp_val real(kind=wp), private :: u10_val real(kind=wp), private :: v10_val real(kind=wp), private :: w00 real(kind=wp), private :: w01 real(kind=wp), private :: w10 real(kind=wp), private :: w11 real(kind=wp), private :: wind_speed Source Code subroutine forcing_update ( forc , state , sim_time ) !! Interpolate forcing to `sim_time` and fill state%forcing%wind_x, !! wind_y, atm_pressure, precipitation (advances time bracket as needed). type ( forcing_t ), intent ( inout ) :: forc !! Forcing state type ( state_t ), intent ( inout ) :: state !! Model state with forcing arrays to fill real ( wp ), intent ( in ) :: sim_time !! Current simulation time (s) real ( wp ) :: alpha integer :: i , j , i0 , j0 real ( wp ) :: w00 , w10 , w01 , w11 real ( wp ) :: u10_val , v10_val , msl_val , tp_val real ( wp ) :: wind_speed , cd , tau_x , tau_y integer :: nx , ny , ng integer :: i0p , j0p if (. not . forc % active ) return ! Advance time bracket if needed call advance_bracket ( forc , sim_time ) ! Compute temporal interpolation weight if ( forc % idx_lo == forc % idx_hi ) then alpha = 0.0_wp else alpha = ( sim_time - forc % time ( forc % idx_lo )) / & ( forc % time ( forc % idx_hi ) - forc % time ( forc % idx_lo )) alpha = max ( 0.0_wp , min ( 1.0_wp , alpha )) end if nx = state % grid % nx_total ny = state % grid % ny_total ng = state % grid % nghost do j = ng + 1 , ny - ng do i = ng + 1 , nx - ng i0 = forc % ix0 ( i , j ) j0 = forc % iy0 ( i , j ) i0p = min ( i0 + 1 , forc % nlon ) j0p = min ( j0 + 1 , forc % nlat ) ! Bilinear weights w00 = ( 1.0_wp - forc % wx ( i , j )) * ( 1.0_wp - forc % wy ( i , j )) w10 = forc % wx ( i , j ) * ( 1.0_wp - forc % wy ( i , j )) w01 = ( 1.0_wp - forc % wx ( i , j )) * forc % wy ( i , j ) w11 = forc % wx ( i , j ) * forc % wy ( i , j ) ! Interpolate u10 in space, then time u10_val = bilinear_time ( forc % u10_lo , forc % u10_hi , & i0 , j0 , i0p , j0p , & w00 , w10 , w01 , w11 , alpha ) v10_val = bilinear_time ( forc % v10_lo , forc % v10_hi , & i0 , j0 , i0p , j0p , & w00 , w10 , w01 , w11 , alpha ) msl_val = bilinear_time ( forc % msl_lo , forc % msl_hi , & i0 , j0 , i0p , j0p , & w00 , w10 , w01 , w11 , alpha ) tp_val = bilinear_time ( forc % tp_lo , forc % tp_hi , & i0 , j0 , i0p , j0p , & w00 , w10 , w01 , w11 , alpha ) ! Convert 10m wind to stress: tau = rho_air * C_d * |W| * W wind_speed = sqrt ( u10_val * u10_val + v10_val * v10_val ) cd = drag_coefficient ( wind_speed ) tau_x = RHO_AIR * cd * wind_speed * u10_val tau_y = RHO_AIR * cd * wind_speed * v10_val state % forcing % wind_x ( i , j ) = tau_x state % forcing % wind_y ( i , j ) = tau_y state % forcing % atm_pressure ( i , j ) = msl_val state % forcing % precipitation ( i , j ) = tp_val end do end do end subroutine forcing_update","tags":"","url":"proc/forcing_update.html"},{"title":"advance_bracket – Rakali","text":"private  subroutine advance_bracket(forc, sim_time) Advance the time bracket so that time(idx_lo) <= sim_time < time(idx_hi) Reads new snapshots from disk as needed. Arguments Type Intent Optional Attributes Name type( forcing_t ), intent(inout) :: forc real(kind=wp), intent(in) :: sim_time Calls proc~~advance_bracket~~CallsGraph proc~advance_bracket advance_bracket proc~load_snapshot load_snapshot proc~advance_bracket->proc~load_snapshot nf90_get_var nf90_get_var proc~load_snapshot->nf90_get_var proc~nc_check nc_check proc~load_snapshot->proc~nc_check error error proc~nc_check->error nf90_strerror 