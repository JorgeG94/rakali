e-valence Helmholtz !! operator (symmetric Ahat) on `nc` cells + the V-cycle work buffers + !! the aggregation map to the next coarser level.  Structure arrays !! (nbr / n_nbr / agg_of / member CSR) are STATIC (built once); the !! coefficient arrays (ke / diag / dinv) are refreshed per step.  All !! arrays explicit-shape; the level loop dereferences on the HOST and !! passes flat args to the device kernels. integer :: nc = 0 !! Cells on this level. integer :: mv = 0 !! Max valence (fixed leading dim of nbr/ke; unused slots padded !! nbr=1, ke=0 so the apply loop is branchless). ! --- STATIC operator STRUCTURE (built once at init) --- integer , allocatable :: n_nbr (:) !! Valence per cell, shape (nc). integer , allocatable :: nbr (:, :) !! Neighbour cell id on THIS level, shape (mv, nc); padded slots = 1. integer , allocatable :: agg_of (:) !! Aggregate id in the NEXT COARSER level for each of this level's !! cells, shape (nc).  Drives prolongation (fine cell reads its !! parent).  Unallocated on the coarsest level. ! Member CSR: which cells of the NEXT FINER level belong to each of THIS ! level's cells (this level is the coarse side).  Drives restriction (a ! coarse cell sums its own members) + the host Galerkin build. integer , allocatable :: mstart (:) !! Member CSR offsets, shape (nc+1).  Unallocated on the finest level. integer , allocatable :: mlist (:) !! Member cell ids on the finer level, shape (n_finer). ! --- PER-STEP coefficients (host + device; refreshed each step) --- real ( wp ), allocatable :: ke (:, :) !! Transmissibility coef*K_e per edge, shape (mv, nc); off-diag = -ke. real ( wp ), allocatable :: diag (:) !! Operator diagonal, shape (nc). real ( wp ), allocatable :: dinv (:) !! 1/diag (Jacobi), shape (nc). ! --- V-cycle work buffers (device) --- real ( wp ), allocatable :: e (:) !! Error iterate, shape (nc). real ( wp ), allocatable :: r (:) !! Level RHS / residual, shape (nc). real ( wp ), allocatable :: tmp (:) !! Jacobi ping-pong / residual scratch, shape (nc). contains procedure , non_overridable :: enter_data => agglom_level_enter_data procedure , non_overridable :: exit_data => agglom_level_exit_data procedure , non_overridable :: destroy => agglom_level_destroy end type agglom_level_unstr_t","tags":"","url":"type/agglom_level_unstr_t.html"},{"title":"output_state_t – Rakali ","text":"type, public :: output_state_t Tracks the state of an open output NetCDF file Components Type Visibility Attributes Name Initial integer, public :: bed_sediment_varid = -1 Bed sediment mass reservoir variable ID (set only with sediment on)\nCached sigma layer thicknesses for vorticity computation real(kind=wp), public, allocatable :: dsig (:) integer, public :: h_varid = -1 Water depth variable ID logical, public :: has_ml = .false. Whether multilayer fields are present logical, public :: has_nh = .false. Whether NH fields are present integer, public :: hu_varid = -1 x-momentum variable ID integer, public :: hv_varid = -1 y-momentum variable ID integer, public :: ml_h_layer_varid = -1 Layer thickness variable ID integer, public :: ml_rho_varid = -1 Layer density variable ID integer, public, allocatable :: ml_tracer_varids (:) Per-tracer NetCDF variable IDs, one entry per state%multilayer%tracers(:) slot.  Set to -1 for\ntracers whose output is gated off; otherwise carries the\nvarid of the corresponding NetCDF variable.  Replaces the\nhistorical ml_salinity_varid / ml_temperature_varid pair so adding a passive tracer requires no I/O changes. integer, public :: ml_u_varid = -1 Layer x-velocity variable ID integer, public :: ml_v_varid = -1 Layer y-velocity variable ID integer, public :: ml_w_varid = -1 Vertical velocity at interfaces variable ID integer, public :: ncid = -1 NetCDF file ID (-1 = not open) integer, public :: nz = 0 Number of sigma layers (cached for output) integer, public :: nz_ml = 0 Number of multilayer sigma layers integer, public :: q_nh_varid = -1 NH pressure variable ID integer, public :: time_dimid = -1 Time dimension ID integer, public :: time_index = 0 Current time record index integer, public :: time_varid = -1 Time variable ID integer, public :: u_layer_varid = -1 Per-layer x-velocity variable ID integer, public :: v_layer_varid = -1 Per-layer y-velocity variable ID integer, public :: vort_x_varid = -1 x-vorticity (dw/dy - dv/dz) variable ID integer, public :: vort_y_varid = -1 y-vorticity (du/dz - dw/dx) variable ID integer, public :: w_varid = -1 Vertical velocity variable ID Source Code type :: output_state_t !! Tracks the state of an open output NetCDF file integer :: ncid = - 1 !! NetCDF file ID (-1 = not open) integer :: time_dimid = - 1 !! Time dimension ID integer :: time_varid = - 1 !! Time variable ID integer :: h_varid = - 1 !! Water depth variable ID integer :: hu_varid = - 1 !! x-momentum variable ID integer :: hv_varid = - 1 !! y-momentum variable ID integer :: time_index = 0 !! Current time record index ! Non-hydrostatic output logical :: has_nh = . false . !! Whether NH fields are present integer :: nz = 0 !! Number of sigma layers (cached for output) integer :: u_layer_varid = - 1 !! Per-layer x-velocity variable ID integer :: v_layer_varid = - 1 !! Per-layer y-velocity variable ID integer :: w_varid = - 1 !! Vertical velocity variable ID integer :: q_nh_varid = - 1 !! NH pressure variable ID integer :: vort_x_varid = - 1 !! x-vorticity (dw/dy - dv/dz) variable ID integer :: vort_y_varid = - 1 !! y-vorticity (du/dz - dw/dx) variable ID real ( wp ), allocatable :: dsig (:) ! Multilayer output logical :: has_ml = . false . !! Whether multilayer fields are present integer :: nz_ml = 0 !! Number of multilayer sigma layers integer :: ml_h_layer_varid = - 1 !! Layer thickness variable ID integer :: ml_u_varid = - 1 !! Layer x-velocity variable ID integer :: ml_v_varid = - 1 !! Layer y-velocity variable ID integer , allocatable :: ml_tracer_varids (:) !! Per-tracer NetCDF variable IDs, one entry per !! `state%multilayer%tracers(:)` slot.  Set to `-1` for !! tracers whose output is gated off; otherwise carries the !! varid of the corresponding NetCDF variable.  Replaces the !! historical `ml_salinity_varid` / `ml_temperature_varid` !! pair so adding a passive tracer requires no I/O changes. integer :: ml_rho_varid = - 1 !! Layer density variable ID integer :: ml_w_varid = - 1 !! Vertical velocity at interfaces variable ID integer :: bed_sediment_varid = - 1 !! Bed sediment mass reservoir variable ID (set only with sediment on) !! Cached sigma layer thicknesses for vorticity computation end type output_state_t","tags":"","url":"type/output_state_t.html"},{"title":"profiler_state – Rakali ","text":"type, private :: profiler_state Inherits type~~profiler_state~~InheritsGraph type~profiler_state profiler_state type~tracked_region tracked_region type~profiler_state->type~tracked_region regions Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial logical, public :: enabled = .true. logical, public :: initialized = .false. integer, public :: num_regions = 0 type( tracked_region ), public :: regions (MAX_REGIONS) Source Code type :: profiler_state logical :: initialized = . false . logical :: enabled = . true . integer :: num_regions = 0 type ( tracked_region ) :: regions ( MAX_REGIONS ) end type profiler_state","tags":"","url":"type/profiler_state.html"},{"title":"tracked_region – Rakali ","text":"type, private :: tracked_region Inherited by type~~tracked_region~~InheritedByGraph type~tracked_region tracked_region type~profiler_state profiler_state type~profi