on the device under NVHPC stdpar. type ( unstr_state_t ), intent ( inout ) :: state if (. not . state % use_multilayer ) return if ( state % multilayer % eos_use_shared ) then ! Opt-in shared nonlinear EOS (`&tracer_nml eos_form`).  All ! unstructured EOS consumers reach the EOS through this one ! entry, so the dispatch here covers the explicit RK2 path, ! the semi-implicit path, and solver init alike. call ml_equation_of_state_shared_unstr ( state % multilayer % h_layer , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % rho_layer , & state % multilayer % eos , & state % multilayer % nz_ml , state % ncells_total ) else call ml_equation_of_state_impl ( state % multilayer % h_layer , & state % multilayer % tracers ( state % multilayer % idx_salinity )% hTr , & state % multilayer % tracers ( state % multilayer % idx_temperature )% hTr , & state % multilayer % rho_layer , & state % multilayer % S_ref , state % multilayer % T_ref , & state % multilayer % rho_0 , state % multilayer % beta_S , state % multilayer % alpha_T , & state % multilayer % nz_ml , state % ncells_total ) end if end subroutine ml_equation_of_state_unstr","tags":"","url":"proc/ml_equation_of_state_unstr.html"},{"title":"ml_equation_of_state_impl – Rakali","text":"private pure subroutine ml_equation_of_state_impl(h_layer, hS_layer, hT_layer, rho_layer, S_ref, T_ref, rho_0, beta_S, alpha_T, nz, n) Inner kernel — flat-array dummies so the device-side do concurrent doesn’t chase the tracer-registry indirection. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (nz,n) real(kind=wp), intent(in) :: hS_layer (nz,n) real(kind=wp), intent(in) :: hT_layer (nz,n) real(kind=wp), intent(out) :: rho_layer (nz,n) real(kind=wp), intent(in) :: S_ref real(kind=wp), intent(in) :: T_ref real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: beta_S real(k