 ) :: d_below , d_iface , sigma , g_shape , nu_kpp real ( wp ) :: flux_u_iface ( BPG_NZ_MAX ), flux_v_iface ( BPG_NZ_MAX ) if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = state % ncells_owned if ( nz < 2 ) return do concurrent ( cell = 1 : n ) & local ( k , h_k , h_k1 , h_avg , u_k , v_k , u_k1 , v_k1 , du , dv , drho , & Ri , denom , nu_t , h_col , h_b , b_0 , us , wstar3 , w_star , w_s , & d_below , d_iface , sigma , g_shape , nu_kpp , & flux_u_iface , flux_v_iface ) if ( state % barotropic % height_cv ( cell ) < ML_MIN_DEPTH_UNSTR ) cycle h_col = 0.0_wp do k = 1 , nz h_col = h_col + state % multilayer % h_layer ( k , cell ) end do h_b = state % multilayer % kpp_bl_depth ( cell ) b_0 = state % multilayer % kpp_buoy_flux ( cell ) us = state % multilayer % kpp_u_star ( cell ) wstar3 = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3 ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) ! Pass 1: interface fluxes (PP81 + KPP overlay) d_below = 0.0_wp do k = 1 , nz - 1 h_k = state % multilayer % h_layer ( k , cell ) h_k1 = state % multilayer % h_layer ( k + 1 , cell ) h_avg = 0.5_wp * ( h_k + h_k1 ) d_below = d_below + h_k d_iface = h_col - d_below flux_u_iface ( k ) = 0.0_wp flux_v_iface ( k ) = 0.0_wp if ( h_avg > VANISHING_LAYER_TOL_UNSTR . and . & h_k > VANISHING_LAYER_TOL_UNSTR . and . & h_k1 > VANISHING_LAYER_TOL_UNSTR ) then if ( h_k > DRY_TOLERANCE ) then u_k = state % multilayer % hu_layer ( k , cell ) / h_k v_k = state % multilayer % hv_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if if ( h_k1 > DRY_TOLERANCE ) then u_k1 = state % multilayer % hu_layer ( k + 1 , cell ) / h_k1 v_k1 = state % multilayer % hv_layer ( k + 1 , cell ) / h_k1 else u_k1 = 0.0_wp v_k1 = 0.0_wp end if du = u_k1 - u_k dv = v_k1 - v_k drho = state % multilayer % rho_layer ( k , cell ) - state % multilayer % rho_layer ( k + 1 , cell ) Ri = GRAVITY * ( drho / state % multilayer % rho_0 ) * h_avg / ( du * du + dv * dv + EPS ) if ( Ri < 0.0_wp ) Ri = 0.0_wp denom = 1.0_wp + state % multilayer % vmix_ri_alpha * Ri nu_t = state % multilayer % vmix_nu_max / ( denom * denom ) + state % multilayer % vmix_nu_bg ! KPP overlay (g_shape = 0 outside the BL ⇒ no-op). g_shape = 0.0_wp if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sigma = d_iface / h_b g_shape = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) end if nu_kpp = h_b * w_s * g_shape nu_t = max ( nu_t , nu_kpp ) if ( nu_t * dt > 0.5_wp * h_avg * h_avg ) nu_t = 0.5_wp * h_avg * h_avg / dt flux_u_iface ( k ) = nu_t * du / h_avg * dt flux_v_iface ( k ) = nu_t * dv / h_avg * dt end if end do ! Pass 2: apply interface fluxes to layers. state % multilayer % hu_layer ( 1 , cell ) = state % multilayer % hu_layer ( 1 , cell ) + flux_u_iface ( 1 ) state % multilayer % hv_layer ( 1 , cell ) = state % multilayer % hv_layer ( 1 , cell ) + flux_v_iface ( 1 ) do k = 2 , nz - 1 state % multilayer % hu_layer ( k , cell ) = state % multilayer % hu_layer ( k , cell ) & + ( flux_u_iface ( k ) - flux_u_iface ( k - 1 )) state % multilayer % hv_layer ( k , cell ) = state % multilayer % hv_layer ( k , cell ) & + ( flux_v_iface ( k ) - flux_v_iface ( k - 1 )) end do state % multilayer % hu_layer ( nz , cell ) = state % multilayer % hu_layer ( nz , cell ) - flux_u_iface ( nz - 1 ) state % multilayer % hv_layer ( nz , cell ) = state % multilayer % hv_layer ( nz , cell ) - flux_v_iface ( nz - 1 ) end do end subroutine ml_kpp_viscosity_unstr","tags":"","url":"proc/ml_kpp_viscosity_unstr.html"},{"title":"compute_timestep_unstr – Rakali","text":"public  subroutine compute_timestep_unstr(state, mesh) Compute the CFL-limited timestep and store it in state%dt .\nReads max_speed , state%cfl , mesh%radius only. Must run\nafter the flux kernel; before any flux pass it returns cfl * TIMESTEP_LARGE (all max_speed still 0). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh Calls proc~~c