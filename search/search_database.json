0 = nest % we_iy0 ( j ) wy_j = nest % we_wy ( j ) ! Interpolate parent values at west edge h_ext = interp_parent ( nest % h_lo , nest % h_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & nest % ix_west , iy0 , nest % wx_west , wy_j , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i_first , j ) ! Interior values h_int = state % barotropic % h ( i_first , j ) eta_int = h_int + state % barotropic % b ( i_first , j ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) ! Fill ghost cells with Flather BC do k = 1 , ng state % barotropic % h ( i_first - k , j ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i_first - k , j )) state % barotropic % hu ( i_first - k , j ) = state % barotropic % h ( i_first - k , j ) * & ( hu_ext / max ( h_ext , 1.0e-6_wp ) - & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) state % barotropic % hv ( i_first - k , j ) = hv_ext end do end do end subroutine apply_nested_west","tags":"","url":"proc/apply_nested_west.html"},{"title":"compute_edge_weights – Rakali","text":"private  subroutine compute_edge_weights(nest, state) Precompute interpolation weights mapping child edge cells to parent grid Arguments Type Intent Optional Attributes Name type( nesting_t ), intent(inout) :: nest type( state_t ), intent(in) :: state Calls proc~~compute_edge_weights~~CallsGraph proc~compute_edge_weights compute_edge_weights proc~find_bracket_1d find_bracket_1d proc~compute_edge_weights->proc~find_bracket_1d Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_edge_weights~~CalledByGraph proc~compute_edge_weights compute_edge_weights proc~nesting_init nesting_init proc~nesting_init->proc~compute_edge_weights proc~nesting_init_from_config nesting_init_from_config proc~nesting_init_from_config->proc~nesting_init proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~nesting_init_from_config proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: j integer, private :: ng integer, private :: nx integer, private :: ny real(kind=wp), private :: x_child real(kind=wp), private :: y_child Source Code subroutine compute_edge_weights ( nest , state ) !! Precompute interpolation weights mapping child edge cells to parent grid type ( nesting_t ), intent ( inout ) :: nest type ( state_t ), intent ( in ) :: state integer :: i , j , nx , ny , ng real ( wp ) :: x_child , y_child nx = state % grid % nx_total ny = state % grid % ny_total ng = state % grid % nghost ! West/East edges: need y-interpolation along j, and x-position for the edge allocate ( nest % we_iy0 ( ny ), source = 1 ) allocate ( nest % we_wy ( ny ), source = 0.0_wp ) do j = 1 , ny y_child = nest % y_origin + ( real ( j - ng , wp ) - 0.5_wp ) * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % we_iy0 ( j ), nest % we_wy ( j )) end do ! x-position for west edge (first physical cell centre) x_child = nest % x_origin + 0.5_wp * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % ix_west , nest % wx_west ) ! x-position for east edge (last physical cell centre) x_child = nest % x_origin + ( real ( state % grid % nx_phys , wp ) - 0.5_wp ) * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % ix_east , nest % wx_east ) ! South/North edges: need x-interpolation along i, and y-position for the edge allocate ( nest % sn_ix0 ( nx ), source = 1 ) allocate ( nest % sn_wx ( nx ), source = 0.0_wp ) do i = 1 , nx x_child = nest % x_origin + ( real ( i - ng , wp ) - 0.5_wp ) * state % grid % dx call find_bracket_1d ( nest % p_x , nest % p_nx , x_child , & nest % sn_ix0 ( i ), nest % sn_wx ( i )) end do ! y-position for south edge y_child = nest % y_origin + 0.5_wp * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % iy_south , nest % wy_south ) ! y-position for north edge y_child = nest % y_origin + ( real ( state % grid % ny_phys , wp ) - 0.5_wp ) * state % grid % dy call find_bracket_1d ( nest % p_y , nest % p_ny , y_child , & nest % iy_north , nest % wy_north ) end subroutine compute_edge_weights","tags":"","url":"proc/compute_edge_weights.html"},{"title":"find_bracket_1d – Rakali","text":"private pure subroutine find_bracket_1d(coords, n, val, idx, frac) Find bracketing interval: coords(idx) <= val < coords(idx+1) Arguments Type Intent 