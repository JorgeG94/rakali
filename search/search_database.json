 ), intent ( inout ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_val , du , dv nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , du , dv , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then du = ( hu ( i , j ) - hu_pre ( i , j )) / h_val dv = ( hv ( i , j ) - hv_pre ( i , j )) / h_val do k = 1 , nz u_layer ( i , j , k ) = u_layer ( i , j , k ) + du v_layer ( i , j , k ) = v_layer ( i , j , k ) + dv end do else do k = 1 , nz u_layer ( i , j , k ) = 0.0_wp v_layer ( i , j , k ) = 0.0_wp end do end if end do end subroutine compute_layer_from_barotropic","tags":"","url":"proc/compute_layer_from_barotropic.html"},{"title":"compute_nh_baro_tendency – Rakali","text":"public pure subroutine compute_nh_baro_tendency(h, q_nh, dsig, tend_x, tend_y, grid, nz) Compute depth-averaged NH pressure gradient for barotropic forcing tend_x(i,j) = -sum_k(dsig_k * dq_nh_k/dx)\ntend_y(i,j) = -sum_k(dsig_k * dq_nh_k/dy) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: q_nh (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: tend_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: tend_y (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~compute_nh_baro_tendency~~CallsGraph proc~compute_nh_baro_tendency compute_nh_baro_tendency local local proc~compute_nh_baro_tendency->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unkno