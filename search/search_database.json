ep_split_impl->proc~solver_baroclinic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_split_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha real(kind=wp), private :: beta real(kind=wp), private :: dx real(kind=wp), private :: dy integer, private :: i real(kind=wp), private :: inv_dx2 real(kind=wp), private :: inv_dy2 integer, private :: iter integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: pAp real(kind=wp), private :: rr real(kind=wp), private :: rz real(kind=wp), private :: rz_new real(kind=wp), private :: tol2 logical, private :: use_pc real(kind=wp), private :: vhi (nz) real(kind=wp), private :: vlo (nz) Source Code subroutine solve_nh_pressure ( h , u_layer , v_layer , w , q_nh , dsig , & cg_r , cg_p , cg_Ap , cg_z , & grid , nz , dt , & max_iter , tol , iter_out , & use_preconditioner ) !! Conjugate Gradient solver for the NH Poisson equation !! !! Warm-started from previous q_nh. !! Optionally uses vertical-line preconditioner (Thomas algorithm per column). !! Solves A * q = rhs where A is the Poisson operator and !! rhs comes from the velocity divergence. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) real ( wp ), intent ( inout ) :: q_nh ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( inout ) :: cg_r ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_p ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_Ap ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: cg_z ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dt integer , intent ( in ) :: max_iter real ( wp ), intent ( in ) :: tol integer , intent ( out ) :: iter_out logical , intent ( in ), optional :: use_preconditioner logical :: use_pc integer :: i , j , k , iter , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: rz , rz_new , rr , pAp , alpha , beta real ( wp ) :: tol2 , inv_dx2 , inv_dy2 real ( wp ) :: vlo ( nz ), vhi ( nz ) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy use_pc = . false . if ( present ( use_preconditioner )) use_pc = use_preconditioner tol2 = tol * tol iter_out = 0 ! Pre-compute vertical coefficients and horizontal inverses once call compute_vert_coefficients ( dsig , nz , dt , vlo , vhi ) inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) ! Compute RHS into cg_r call compute_nh_rhs ( h , w , dsig , cg_r , nx , ny , nz , nghost , dx , dy , dt ) ! r = rhs - A*q_nh (warm start: q_nh retains previous solution) call apply_poisson_operator_fast ( h , q_nh , cg_Ap , nx , ny , nz , nghost , & inv_dx2 , inv_dy2 , vlo , vhi ) do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_r ( i , j , k ) = cg_r ( i , j , k ) - cg_Ap ( i , j , k ) end do ! Check if already converged (unpreconditioned residual) rr = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rr ) rr = rr + cg_r ( i , j , k ) * cg_r ( i , j , k ) end do if ( rr < tol2 ) return if ( use_pc ) then ! PCG: z = M&#94;{-1} r, p = z call apply_vertical_preconditioner ( h , dsig , cg_r , cg_z , nx , ny , nz , nghost , dx , dy , dt ) do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_z ( i , j , k ) end do ! rz = dot(r, z) rz = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rz ) rz = rz + cg_r ( i , j , k ) * cg_z ( i , j , k ) end do else ! Plain CG: p = r, rz = rr do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_r ( i , j , k ) end do rz = rr end if do iter = 1 , max_iter ! Ap = A * p call apply_poisson_operator_fast ( h , cg_p , cg_Ap , nx , ny , nz , nghost , & inv_dx2 , inv_dy2 , vlo , vhi ) ! pAp = dot(p, Ap) pAp = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : pAp ) pAp = pAp + cg_p ( i , j , k ) * cg_Ap ( i , j , k ) end do if ( abs ( pAp ) < 1.0e-30_wp ) exit alpha = rz / pAp ! q_nh += alpha * p ! r -= alpha * Ap do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) q_nh ( i , j , k ) = q_nh ( i , j , k ) + alpha * cg_p ( i , j , k ) cg_r ( i , j , k ) = cg_r ( i , j , k ) - alpha * cg_Ap ( i , j , k ) end do ! Convergence check on unpreconditioned residual rr = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rr ) rr = rr + cg_r ( i , j , k ) * cg_r ( i , j , k ) end do iter_out = iter if ( rr < tol2 ) exit if ( use_pc ) then ! PCG: z = M&#94;{-1} r, rz_new = dot(r, z) call apply_vertical_preconditioner ( h , dsig , cg_r , cg_z , nx , ny , nz , nghost , dx , dy , dt ) rz_new = 0.0_wp do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) reduce ( + : rz_new ) rz_new = rz_new + cg_r ( i , j , k ) * cg_z ( i , j , k ) end do beta = rz_new / rz rz = rz_new ! p = z + beta * p do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_z ( i , j , k ) + beta * cg_p ( i , j , k ) end do else ! Plain CG: rz_new = rr beta = rr / rz rz = rr ! p = r + beta * p do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) cg_p ( i , j , k ) = cg_r ( i , j , k ) + beta * cg_p ( i , j , k ) end do end if end do end subroutine solve_nh_pressure","tags":"","url":"proc/solve_nh_pressure.html"},{"title":"ml_fused_post_update – Rakali","text":"public pure subroutine ml_fused_post_update(h, hu, hv, h_layer, hu_layer, hv_layer, h0, hu0, hv0, h_layer0, hu_layer0, hv_layer0, flux_h, flux_hu, flux_hv, dsig, wind_x, wind_y, atm_pressure, precipitation, grid, nz, dt, manning_n, use_linear_drag, drag_r, coriolis_f, forcing_active, do_save) Single fused kernel covering compute_update through coriolis. Manning friction is applied only to the bottom layer (k=nz),\nmirroring ml_apply_bottom_friction . The depth-averaged Manning\npass that the un-fused path does inside apply_friction is\nomitted intentionally: per-layer friction already accounts for\nit. Wind, pressure-gradient, and precipitation forcing are still\napplied to the depth-averaged state. Pre-update barotropic momentum is captured in registers at the\ntop of each (i,j) iteration, so the un-fused path’s separate hu_ml_pre / hv_ml_pre copies are not needed. When do_save is true (RK stage 1), absorbs the work that solver_save_state and ml_save_layer_state would have done:\nwrites pre-update h, hu, hv to h0, hu0, hv0 and pre-update h_layer, hu_layer, hv_layer to the corresponding *0 arrays.\nTracer save is still a separate kernel (it has to run before\nthe tracer pipeline, which precedes this kernel). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n logical, intent(in) :: use_linear_drag real(kind=wp), intent(in) :: drag_r real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active logical, intent(in) :: do_save Calls proc~~ml_fused_post_update~~CallsGraph proc~ml_fused_post_update ml_fused_post_update local local proc~ml_fused_post_update->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_fused_post_update~~CalledByGraph proc~ml_fused_post_update ml_fused_post_update proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_fused_post_update proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: cf real(kind=wp), private :: cosf real(kind=wp), private :: denom real(kind=wp), private :: dpdx real(kind=wp), private :: dpdy real(kind=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: eps4 real(kind=wp), private :: fr_max_sq real(kind=wp), private :: fr_scale real(kind=wp), private :: h4 real(kind=wp), private :: h_k real(kind=wp), private :: h_k_new real(kind=wp), private :: h_new logical, private :: has_coriolis logical, private :: has_friction real(kind=wp), private :: hu_new real(kind=wp), private :: hu_old real(kind=wp), private :: hu_pre real(kind=wp), private :: hu_sum real(kind=wp), private :: hv_new real(kind=wp), private :: hv_old real(kind=wp), private :: hv_pre real(kind=wp), private :: hv_sum integer, private :: i integer, private :: j integer, private :: k real(kind=wp), private :: n_sq integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: sinf real(kind=wp), private :: speed_b real(kind=wp), private :: speed_sq real(kind=wp), private :: u_abs real(kind=wp), private :: u_b real(kind=wp), private :: u_ds real(kind=wp), private :: u_k real(kind=wp), private :: v_abs real(kind=wp), private :: v_b real(kind=wp), private :: v_ds real(kind=wp), private :: v_k real(kind=wp), private :: vel_max_x real(kind=wp), private :: vel_max_y Source Code pure subroutine ml_fused_post_update ( h , hu , hv , & h_layer , hu_layer , hv_layer , & h0 , hu0 , hv0 , & h_layer0 , hu_layer0 , hv_layer0 , & flux_h , flux_hu , flux_hv , & dsig , & wind_x , wind_y , & atm_pressure , precipitation , & grid , nz , dt , & manning_n , use_linear_drag , drag_r , coriolis_f , & forcing_active , do_save ) !! Single fused kernel covering compute_update through coriolis. !! !! Manning friction is applied *only* to the bottom layer (k=nz), !! mirroring `ml_apply_bottom_friction`. The depth-averaged Manning !! pass that the un-fused path does inside `apply_friction` is !! omitted intentionally: per-layer friction already accounts for !! it. Wind, pressure-gradient, and precipitation forcing are still !! applied to the depth-averaged state. !! !! Pre-update barotropic momentum is captured in registers at the !! top of each (i,j) iteration, so the un-fused path's separate !! `hu_ml_pre` / `hv_ml_pre` copies are not needed. !! !! When `do_save` is true (RK stage 1), absorbs the work that !! `solver_save_state` and `ml_save_layer_state` would have done: !! writes pre-update `h, hu, hv` to `h0, hu0, hv0` and pre-update !! `h_layer, hu_layer, hv_layer` to the corresponding `*0` arrays. !! Tracer save is still a separate kernel (it has to run before !! the tracer pipeline, which precedes this kernel). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) ! intent(inout) so that when do_save=.false. we can leave these ! arrays untouched (intent(out) would require full assignment). real ( wp ), intent ( inout ) :: h0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv0 ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: flux_h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: atm_pressure ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: precipitation ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt , manning_n logical , intent ( in ) :: use_linear_drag real ( wp ), intent ( in ) :: drag_r real ( wp ), intent ( in ) :: coriolis_f logical , intent ( in ) :: forcing_active , do_save integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: h_new , hu_new , hv_new , hu_pre , hv_pre real ( wp ) :: eps4 , h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale real ( wp ) :: du , dv , h_k , h_k_new , u_k , v_k real ( wp ) :: u_b , v_b , speed_b , cf , denom real ( wp ) :: u_abs , v_abs , vel_max_x , vel_max_y real ( wp ) :: hu_sum , hv_sum real ( wp ) :: dpdx , dpdy , hu_old , hv_old real ( wp ) :: n_sq , cosf , sinf logical :: has_friction , has_coriolis nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy n_sq = manning_n * manning_n has_friction = ( manning_n > 0.0_wp ) . or . ( use_linear_drag . and . drag_r > 0.0_wp ) has_coriolis = ( abs ( coriolis_f ) > 1.0e-20_wp ) if ( has_coriolis ) then cosf = cos ( coriolis_f * dt ) sinf = sin ( coriolis_f * dt ) end if vel_max_x = 0.9_wp * 0.8_wp * dx / max ( dt , 1.0e-10_wp ) vel_max_y = 0.9_wp * 0.8_wp * dy / max ( dt , 1.0e-10_wp ) ! KP07 desingularization length for the barotropic clamp, shared ! convention with compute_update / the CFL timestep estimator. eps4 = DESING_EPS ** 4 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_new , hu_new , hv_new , hu_pre , hv_pre , & h4 , u_ds , v_ds , speed_sq , fr_max_sq , fr_scale , & du , dv , h_k , h_k_new , u_k , v_k , & u_b , v_b , speed_b , cf , denom , & u_abs , v_abs , hu_sum , hv_sum , & dpdx , dpdy , hu_old , hv_old ) ! ---- Capture pre-update barotropic momentum in registers ---- hu_pre = hu ( i , j ) hv_pre = hv ( i , j ) ! ---- Save pre-update barotropic state (RK stage 1 only) ---- if ( do_save ) then h0 ( i , j ) = h ( i , j ) hu0 ( i , j ) = hu_pre hv0 ( i , j ) = hv_pre end if ! ---- Euler update for the barotropic state ---- h_new = h ( i , j ) + dt * flux_h ( i , j ) hu_new = hu_pre + dt * flux_hu ( i , j ) hv_new = hv_pre + dt * flux_hv ( i , j ) ! ---- Negative-depth clamp + KP07 desingularization ---- ! (mirrors compute_update) if ( h_new < 0.0_wp ) then h_new = 0.0_wp hu_new = 0.0_wp hv_new = 0.0_wp else if ( h_new < DRY_TOLERANCE ) then hu_new = 0.0_wp hv_new = 0.0_wp else h4 = h_new ** 4 if ( h4 < eps4 ) then ! u = sqrt(2) h hu / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)); hu := h*u. ! Identity for h >= eps, so applied only below eps. u_ds = sqrt ( 2.0_wp ) * h_new * hu_new / sqrt ( h4 + eps4 ) v_ds = sqrt ( 2.0_wp ) * h_new * hv_new / sqrt ( h4 + eps4 ) hu_new = h_new * u_ds hv_new = h_new * v_ds end if ! Froude backstop: blowup arrester only (triggers on a TRUE ! comparison, so NaN passes through and fails loudly). speed_sq = ( hu_new ** 2 + hv_new ** 2 ) / h_new ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h_new if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) hu_new = hu_new * fr_scale hv_new = hv_new * fr_scale end if end if ! ---- Distribute barotropic acceleration to layers ---- ! du = (hu_new - hu_pre) / h_new is the depth-averaged acceleration ! Per-layer u_k retains the existing baroclinic anomaly. if ( h_new > DRY_TOLERANCE ) then du = ( hu_new - hu_pre ) / h_new dv = ( hv_new - hv_pre ) / h_new else du = 0.0_wp dv = 0.0_wp end if do k = 1 , nz h_k = h_layer ( i , j , k ) ! Save OLD layer state into *_0 arrays before we overwrite ! (RK stage 1 only — absorbs `ml_save_layer_state`). if ( do_save ) then h_layer0 ( i , j , k ) = h_k hu_layer0 ( i , j , k ) = hu_layer ( i , j , k ) hv_layer0 ( i , j , k ) = hv_layer ( i , j , k ) end if if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if h_k_new = dsig ( k ) * h_new h_layer ( i , j , k ) = h_k_new if ( h_k_new < THIN_LAYER_THRESHOLD ) then hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp else hu_layer ( i , j , k ) = h_k_new * ( u_k + du ) hv_layer ( i , j , k ) = h_k_new * ( v_k + dv ) end if end do ! ---- Bottom friction on layer 1 (semi-implicit) ---- ! k=1 is the bottom layer under bottom-up ROMS indexing (matches ! BPG / rho_ref / NH init / standalone ml_apply_bottom_friction). ! Linear (Rayleigh) or quadratic Manning, mirroring the un-fused path. if ( has_friction ) then h_k = h_layer ( i , j , 1 ) if ( h_k >= THIN_LAYER_THRESHOLD . and . h_new >= THIN_LAYER_THRESHOLD ) then if ( use_linear_drag ) then denom = 1.0_wp + dt * drag_r else u_b = hu_layer ( i , j , 1 ) / h_k v_b = hv_layer ( i , j , 1 ) / h_k speed_b = sqrt ( u_b * u_b + v_b * v_b ) cf = GRAVITY * n_sq / ( h_new ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed_b / h_k end if hu_layer ( i , j , 1 ) = hu_layer ( i , j , 1 ) / denom hv_layer ( i , j , 1 ) = hv_layer ( i , j , 1 ) / denom end if end if ! ---- CFL-based velocity truncation (MOM6-style, cfl_trunc=0.8) ---- do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k >= THIN_LAYER_THRESHOLD ) then u_abs = abs ( hu_layer ( i , j , k )) / h_k v_abs = abs ( hv_layer ( i , j , k )) / h_k if ( u_abs > vel_max_x ) then hu_layer ( i , j , k ) = sign ( vel_max_x * h_k , hu_layer ( i , j , k )) end if if ( v_abs > vel_max_y ) then hv_layer ( i , j , k ) = sign ( vel_max_y * h_k , hv_layer ( i , j , k )) end if end if end do ! ---- Recompute depth-integrated momentum from layers ---- hu_sum = 0.0_wp hv_sum = 0.0_wp do k = 1 , nz hu_sum = hu_sum + hu_layer ( i , j , k ) hv_sum = hv_sum + hv_layer ( i , j , k ) end do hu_new = hu_sum hv_new = hv_sum ! ---- Wind / atmospheric pressure / precipitation on barotropic ---- ! (Manning was applied per-layer above so we skip it here.) if ( forcing_active . and . h_new > DRY_TOLERANCE ) then hu_new = hu_new + dt * wind_x ( i , j ) / RHO_WATER hv_new = hv_new + dt * wind_y ( i , j ) / RHO_WATER dpdx = ( atm_pressure ( i + 1 , j ) - atm_pressure ( i - 1 , j )) / ( 2.0_wp * dx ) dpdy = ( atm_pressure ( i , j + 1 ) - atm_pressure ( i , j - 1 )) / ( 2.0_wp * dy ) hu_new = hu_new - dt * h_new * dpdx / RHO_WATER hv_new = hv_new - dt * h_new * dpdy / RHO_WATER end if ! ---- Coriolis rotation ---- if ( has_coriolis . and . h_new > DRY_TOLERANCE ) then hu_old = hu_new hv_old = hv_new hu_new = hu_old * cosf + hv_old * sinf hv_new = - hu_old * sinf + hv_old * cosf end if ! ---- Precipitation on barotropic h (all cells) ---- if ( forcing_active ) then h_new = h_new + dt * precipitation ( i , j ) end if ! ---- Write back ---- h ( i , j ) = h_new hu ( i , j ) = hu_new hv ( i , j ) = hv_new end do end subroutine ml_fused_post_update","tags":"","url":"proc/ml_fused_post_update.html"},{"title":"ml_fused_rk2_finalise – Rakali","text":"public pure subroutine ml_fused_rk2_finalise(h, hu, hv, h_layer, hu_layer, hv_layer, h_layer0, hu_layer0, hv_layer0, hS_layer, hT_layer, hS_layer0, hT_layer0, grid, nz) End-of-step fused kernel: RK2-averages all layer arrays with their *_0 counterparts and accumulates the depth-integrated h, hu, hv in one inner k-loop. No neighbour reads. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(out) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hT_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_fused_rk2_finalise~~CallsGraph proc~ml_fused_rk2_finalise ml_fused_rk2_finalise local local proc~ml_fused_rk2_finalise->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_fused_rk2_finalise~~CalledByGraph proc~ml_fused_rk2_finalise ml_fused_rk2_finalise proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~ml_fused_rk2_finalise proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: h_k real(kind=wp), private :: h_sum real(kind=wp), private :: hs_k real(kind=wp), private :: ht_k real(kind=wp), private :: hu_k real(kind=wp), private :: hu_sum real(kind=wp), private :: hv_k real(kind=wp), private :: hv_sum integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny Source Code pure subroutine ml_fused_rk2_finalise ( h , hu , hv , & h_layer , hu_layer , hv_layer , & h_layer0 , hu_layer0 , hv_layer0 , & hS_layer , hT_layer , & hS_layer0 , hT_layer0 , & grid , nz ) !! End-of-step fused kernel: RK2-averages all layer arrays with their !! `*_0` counterparts and accumulates the depth-integrated `h, hu, hv` !! in one inner k-loop. No neighbour reads. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( out ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( out ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: h_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hS_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hT_layer0 ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_k , hu_k , hv_k real ( wp ) :: hs_k , ht_k real ( wp ) :: h_sum , hu_sum , hv_sum nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_k , hu_k , hv_k , hs_k , ht_k , h_sum , hu_sum , hv_sum ) h_sum = 0.0_wp hu_sum = 0.0_wp hv_sum = 0.0_wp do k = 1 , nz ! ---- RK2 average of layer state ---- h_k = 0.5_wp * ( h_layer0 ( i , j , k ) + h_layer ( i , j , k )) hu_k = 0.5_wp * ( hu_layer0 ( i , j , k ) + hu_layer ( i , j , k )) hv_k = 0.5_wp * ( hv_layer0 ( i , j , k ) + hv_layer ( i , j , k )) ! Wet-cell guard, mirrors ml_rk2_average_layers if ( h_k < 0.0_wp ) then h_k = 0.0_wp hu_k = 0.0_wp hv_k = 0.0_wp else if ( h_k < THIN_LAYER_THRESHOLD ) then hu_k = 0.0_wp hv_k = 0.0_wp end if h_layer ( i , j , k ) = h_k hu_layer ( i , j , k ) = hu_k hv_layer ( i , j , k ) = hv_k ! Accumulate barotropic quantities h_sum = h_sum + h_k hu_sum = hu_sum + hu_k hv_sum = hv_sum + hv_k ! ---- Tracer RK2 average ---- hs_k = 0.5_wp * ( hS_layer0 ( i , j , k ) + hS_layer ( i , j , k )) ht_k = 0.5_wp * ( hT_layer0 ( i , j , k ) + hT_layer ( i , j , k )) if ( hs_k < 0.0_wp ) hs_k = 0.0_wp if ( ht_k < 0.0_wp ) ht_k = 0.0_wp hS_layer ( i , j , k ) = hs_k hT_layer ( i , j , k ) = ht_k end do h ( i , j ) = h_sum hu ( i , j ) = hu_sum hv ( i , j ) = hv_sum end do end subroutine ml_fused_rk2_finalise","tags":"","url":"proc/ml_fused_rk2_finalise.html"},{"title":"ml_fused_tracer_post – Rakali","text":"public pure subroutine ml_fused_tracer_post(hS_layer, hT_layer, h_layer, hu_layer, hv_layer, h_bt, hu_bt, hv_bt, heat_flux, evap_minus_precip, evap_mass_sink, evap_latent_cooling, S_min, S_max, T_min, T_max, rho_0, cp, min_depth, grid, nz, dt) Fuses surface tracer fluxes + per-layer clamp (S, T) into one\nper-(i,j)-column kernel (no horizontal neighbour reads). Surface flux (top layer k=nz, wet column only):\n- evap_mass_sink=.false. (default): virtual salt flux\n    hT(top) += dt * heat_flux / (rho_0 * cp);  hS(top) += dt * (E-P) * S_top\n- evap_mass_sink=.true.: real water-mass sink — dh = E*dt removed\n  COLUMN-PROPORTIONALLY (h, hu, hv, hT scale by 1 - dh/h_col; hS\n  held), so S concentrates while T, u, v are exactly invariant.\n  With evap_latent_cooling, the evaporated mass ALSO withdraws its\n  latent heat from the top layer (additive surface cooling; distinct\n  from the sensible heat carried away by the fac-scaled hT — no\n  double-count).  Removal clamps to the water available above\n  min_depth; the unsatisfied fraction is dropped honestly.  Precipitation\n  (evap_minus_precip < 0) is NOT added — that is the barotropic\n  precipitation field’s job.  See ml_apply_surface_tracer_fluxes\n  for the full derivation. Clamp: bounds [tr_min, tr_max] per layer where h_layer > DRY_TOLERANCE,\nelse zeroes the column tracer mass. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: h_bt (grid%nx_total,grid%ny_total) Barotropic depth — the nz=1 fast path maintains h_bt == h_layer\nBY CONSTRUCTION (no recompute-from-layers), so the mass sink\nmust update both or the next stage rebuilds the pre-sink depth. real(kind=wp), intent(inout) :: hu_bt (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv_bt (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) logical, intent(in) :: evap_mass_sink logical, intent(in) :: evap_latent_cooling real(kind=wp), intent(in) :: S_min real(kind=wp), intent(in) :: S_max real(kind=wp), intent(in) :: T_min real(kind=wp), intent(in) :: T_max real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: min_depth type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_fused_tracer_post~~CallsGraph proc~ml_fused_tracer_post ml_fused_tracer_post local local proc~ml_fused_tracer_post->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_fused_tracer_post~~CalledByGraph proc~ml_fused_tracer_post ml_fused_tracer_post proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~ml_fused_tracer_post proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: S_top logical, private :: column_wet real(kind=wp), private :: dh_eff real(kind=wp), private :: dh_req real(kind=wp), private :: fac real(kind=wp), private :: h_col real(kind=wp), private :: h_k real(kind=wp), private :: h_top real(kind=wp), private :: hs_k real(kind=wp), private :: ht_k integer, private :: i real(kind=wp), private :: inv_rho0cp integer, private :: j integer, private :: k real(kind=wp), private :: kin_heat_flux real(kind=wp), private :: latent_gain integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: s_val real(kind=wp), private :: t_val Source Code pure subroutine ml_fused_tracer_post ( hS_layer , hT_layer , h_layer , & hu_layer , hv_layer , & h_bt , hu_bt , hv_bt , & heat_flux , evap_minus_precip , & evap_mass_sink , evap_latent_cooling , & S_min , S_max , T_min , T_max , & rho_0 , cp , min_depth , & grid , nz , dt ) !! Fuses surface tracer fluxes + per-layer clamp (S, T) into one !! per-(i,j)-column kernel (no horizontal neighbour reads). !! !! Surface flux (top layer k=nz, wet column only): !! - evap_mass_sink=.false. (default): virtual salt flux !!     hT(top) += dt * heat_flux / (rho_0 * cp);  hS(top) += dt * (E-P) * S_top !! - evap_mass_sink=.true.: real water-mass sink — dh = E*dt removed !!   COLUMN-PROPORTIONALLY (h, hu, hv, hT scale by 1 - dh/h_col; hS !!   held), so S concentrates while T, u, v are exactly invariant. !!   With evap_latent_cooling, the evaporated mass ALSO withdraws its !!   latent heat from the top layer (additive surface cooling; distinct !!   from the sensible heat carried away by the fac-scaled hT — no !!   double-count).  Removal clamps to the water available above !!   min_depth; the unsatisfied fraction is dropped honestly.  Precipitation !!   (evap_minus_precip < 0) is NOT added — that is the barotropic !!   precipitation field's job.  See ml_apply_surface_tracer_fluxes !!   for the full derivation. !! !! Clamp: bounds [tr_min, tr_max] per layer where h_layer > DRY_TOLERANCE, !! else zeroes the column tracer mass. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hT_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: h_bt ( grid % nx_total , grid % ny_total ) !! Barotropic depth — the nz=1 fast path maintains h_bt == h_layer !! BY CONSTRUCTION (no recompute-from-layers), so the mass sink !! must update both or the next stage rebuilds the pre-sink depth. real ( wp ), intent ( inout ) :: hu_bt ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv_bt ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) logical , intent ( in ) :: evap_mass_sink logical , intent ( in ) :: evap_latent_cooling real ( wp ), intent ( in ) :: S_min , S_max , T_min , T_max real ( wp ), intent ( in ) :: rho_0 , cp , dt , min_depth integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_col , h_top , S_top , kin_heat_flux , inv_rho0cp real ( wp ) :: h_k , hs_k , ht_k , s_val , t_val real ( wp ) :: dh_req , dh_eff , fac , latent_gain logical :: column_wet nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost inv_rho0cp = 1.0_wp / ( rho_0 * cp ) ! Kinematic latent-heat withdrawal per metre of evaporated water ! (0 unless the knob is on -> default bit-identical). latent_gain = 0.0_wp if ( evap_latent_cooling ) latent_gain = RHO_WATER * LATENT_HEAT_VAPORIZATION * inv_rho0cp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , h_col , h_top , S_top , kin_heat_flux , h_k , hs_k , ht_k , & s_val , t_val , column_wet , dh_req , dh_eff , fac ) ! ---- Total column depth (surface-flux wet gate) ---- h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( i , j , k ) end do column_wet = ( h_col > min_depth ) ! ---- Surface flux (top layer, k=nz under bottom-up ROMS indexing) ---- if ( column_wet ) then h_top = h_layer ( i , j , nz ) if ( h_top > THIN_LAYER_THRESHOLD ) then ! Thermal (unchanged in both modes): dt * Q_net / (rho_0 * cp) kin_heat_flux = heat_flux ( i , j ) * inv_rho0cp hT_layer ( i , j , nz ) = hT_layer ( i , j , nz ) + dt * kin_heat_flux if ( evap_mass_sink ) then ! Column-proportional water-mass sink (see ! ml_apply_surface_tracer_fluxes).  hS held; h, hu, hv, ! hT scale so S concentrates while T, u, v stay invariant. dh_req = dt * max ( evap_minus_precip ( i , j ), 0.0_wp ) dh_eff = min ( dh_req , max ( h_col - min_depth , 0.0_wp )) if ( dh_eff > 0.0_wp ) then fac = 1.0_wp - dh_eff / h_col do k = 1 , nz h_layer ( i , j , k ) = h_layer ( i , j , k ) * fac hu_layer ( i , j , k ) = hu_layer ( i , j , k ) * fac hv_layer ( i , j , k ) = hv_layer ( i , j , k ) * fac hT_layer ( i , j , k ) = hT_layer ( i , j , k ) * fac ! hS_layer held -> concentration rises naturally. end do ! Keep the barotropic state consistent with the layers ! (the nz=1 path never recomputes it from the layers). h_bt ( i , j ) = h_bt ( i , j ) * fac hu_bt ( i , j ) = hu_bt ( i , j ) * fac hv_bt ( i , j ) = hv_bt ( i , j ) * fac ! Latent-heat cooling (additive, top layer; not scaled ! by fac).  latent_gain == 0 when off -> bit-identical. hT_layer ( i , j , nz ) = hT_layer ( i , j , nz ) - latent_gain * dh_eff end if else ! Legacy virtual salt flux (bit-identical default). S_top = hS_layer ( i , j , nz ) / h_top hS_layer ( i , j , nz ) = hS_layer ( i , j , nz ) & + dt * evap_minus_precip ( i , j ) * S_top end if end if end if ! ---- Clamp every layer to physical bounds ---- do k = 1 , nz h_k = h_layer ( i , j , k ) if ( h_k > DRY_TOLERANCE ) then hs_k = hS_layer ( i , j , k ) ht_k = hT_layer ( i , j , k ) s_val = hs_k / h_k s_val = max ( S_min , min ( S_max , s_val )) hS_layer ( i , j , k ) = h_k * s_val t_val = ht_k / h_k t_val = max ( T_min , min ( T_max , t_val )) hT_layer ( i , j , k ) = h_k * t_val else hS_layer ( i , j , k ) = 0.0_wp hT_layer ( i , j , k ) = 0.0_wp end if end do end do end subroutine ml_fused_tracer_post","tags":"","url":"proc/ml_fused_tracer_post.html"},{"title":"ml_kpp_boundary_layer_unstr – Rakali","text":"public pure subroutine ml_kpp_boundary_layer_unstr(state, hS_layer) Pass 1: per-cell u_ , B_0, and the bulk-Ri boundary-layer depth.\nMirrors ml_kpp_boundary_layer (structured) on the cell-centric\nlayout.  u_ uses the uniform barotropic wind stress; B_0 uses\nthe per-cell surface heat / virtual-salt fluxes. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: hS_layer (:,:) Calls proc~~ml_kpp_boundary_layer_unstr~~CallsGraph proc~ml_kpp_boundary_layer_unstr ml_kpp_boundary_layer_unstr local local proc~ml_kpp_boundary_layer_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_kpp_boundary_layer_unstr~~CalledByGraph proc~ml_kpp_boundary_layer_unstr ml_kpp_boundary_layer_unstr proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~ml_kpp_boundary_layer_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_kpp_boundary_layer_unstr proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha_T real(kind=wp), private :: b_0 real(kind=wp), private :: b_k real(kind=wp), private :: b_ref real(kind=wp), private :: beta_S real(kind=wp), private :: c_vt2 integer, private :: cell logical, private :: crossing_found real(kind=wp), private :: d_centre_k real(kind=wp), private :: d_centre_ref real(kind=wp), private :: d_prev real(kind=wp), private :: delta_b real(kind=wp), private :: delta_d real(kind=wp), private :: denom real(kind=wp), private :: f_s_kin real(kind=wp), private :: f_t_kin real(kind=wp), private :: frac real(kind=wp), private :: h_b real(kind=wp), private :: h_b_lagged real(kind=wp), private :: h_col real(kind=wp), private :: h_k real(kind=wp), private :: h_k1 real(kind=wp), private :: h_top integer, private :: k integer, private :: n real(kind=wp), private :: n_brunt integer, private :: nz real(kind=wp), private :: rho_0 real(kind=wp), private :: ri_bulk real(kind=wp), private :: ri_crit real(kind=wp), private :: ri_prev real(kind=wp), private :: s_top real(kind=wp), private :: shear2 real(kind=wp), private :: tau_x real(kind=wp), private :: tau_y real(kind=wp), private :: u_k real(kind=wp), private :: u_ref real(kind=wp), private :: us real(kind=wp), private :: v_k real(kind=wp), private :: v_ref real(kind=wp), private :: vt2 real(kind=wp), private :: w_s_col real(kind=wp), private :: wstar3_lagged Source Code pure subroutine ml_kpp_boundary_layer_unstr ( state , hS_layer ) !! Pass 1: per-cell u_*, B_0, and the bulk-Ri boundary-layer depth. !! Mirrors `ml_kpp_boundary_layer` (structured) on the cell-centric !! layout.  u_* uses the uniform barotropic wind stress; B_0 uses !! the per-cell surface heat / virtual-salt fluxes. type ( unstr_state_t ), intent ( inout ) :: state ! assumed-shape-ok: unstructured outer-shim — caller host-dereferences ! state%multilayer%tracers(idx)%hTr_layer; ncells varies per mesh partition. real ( wp ), intent ( in ) :: hS_layer (:, :) integer :: cell , k , nz , n real ( wp ) :: h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us real ( wp ) :: tau_x , tau_y , rho_0 , alpha_T , beta_S , ri_crit , c_vt2 real ( wp ) :: u_ref , v_ref , b_ref , d_centre_ref real ( wp ) :: h_b_lagged , wstar3_lagged , w_s_col real ( wp ) :: u_k , v_k , b_k , d_centre_k , delta_d , delta_b real ( wp ) :: n_brunt , vt2 , shear2 , ri_bulk , ri_prev , d_prev real ( wp ) :: denom , frac , h_b , h_k , h_k1 logical :: crossing_found if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = state % ncells_owned if ( nz < 2 ) return rho_0 = state % multilayer % rho_0 alpha_T = state % multilayer % alpha_T beta_S = state % multilayer % beta_S ri_crit = state % multilayer % kpp_ri_crit c_vt2 = state % multilayer % kpp_c_vt2 tau_x = state % barotropic % wind_tau_x tau_y = state % barotropic % wind_tau_y do concurrent ( cell = 1 : n ) & local ( k , h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us , & u_ref , v_ref , b_ref , d_centre_ref , h_b_lagged , & wstar3_lagged , w_s_col , u_k , v_k , b_k , d_centre_k , & delta_d , delta_b , n_brunt , vt2 , shear2 , ri_bulk , ri_prev , & d_prev , denom , frac , h_b , h_k , h_k1 , crossing_found ) h_col = 0.0_wp do k = 1 , nz h_col = h_col + state % multilayer % h_layer ( k , cell ) end do if ( h_col <= ML_MIN_DEPTH_UNSTR ) then state % multilayer % kpp_u_star ( cell ) = 0.0_wp state % multilayer % kpp_buoy_flux ( cell ) = 0.0_wp state % multilayer % kpp_bl_depth ( cell ) = 0.0_wp cycle end if ! Surface friction velocity from the uniform wind stress (Pa). us = sqrt ( sqrt ( tau_x * tau_x + tau_y * tau_y ) / rho_0 ) ! Surface buoyancy flux (dimensional EOS coefficients ⇒ the ! 1/rho_0 factor is explicit; see the structured kernel). h_top = state % multilayer % h_layer ( nz , cell ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( nz , cell ) / h_top u_ref = state % multilayer % hu_layer ( nz , cell ) / h_top v_ref = state % multilayer % hv_layer ( nz , cell ) / h_top else s_top = 0.0_wp u_ref = 0.0_wp v_ref = 0.0_wp end if f_t_kin = state % forcing % heat_flux ( cell ) / ( rho_0 * CP_WATER ) f_s_kin = state % forcing % evap_minus_precip ( cell ) * s_top b_0 = ( GRAVITY / rho_0 ) * ( alpha_T * f_t_kin - beta_S * f_s_kin ) state % multilayer % kpp_u_star ( cell ) = us state % multilayer % kpp_buoy_flux ( cell ) = b_0 b_ref = - GRAVITY * state % multilayer % rho_layer ( nz , cell ) / rho_0 d_centre_ref = 0.5_wp * h_top h_b_lagged = state % multilayer % kpp_bl_depth ( cell ) wstar3_lagged = max ( 0.0_wp , - b_0 ) * h_b_lagged w_s_col = sqrt ( us * us + wstar3_lagged ** ( 2.0_wp / 3.0_wp )) ri_prev = 0.0_wp d_prev = d_centre_ref h_b = 0.0_wp crossing_found = . false . d_centre_k = d_centre_ref do k = nz - 1 , 1 , - 1 if (. not . crossing_found ) then h_k = state % multilayer % h_layer ( k , cell ) h_k1 = state % multilayer % h_layer ( k + 1 , cell ) d_centre_k = d_centre_k + 0.5_wp * ( h_k1 + h_k ) if ( h_k > DRY_TOLERANCE ) then u_k = state % multilayer % hu_layer ( k , cell ) / h_k v_k = state % multilayer % hv_layer ( k , cell ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if b_k = - GRAVITY * state % multilayer % rho_layer ( k , cell ) / rho_0 delta_d = d_centre_k - d_centre_ref delta_b = b_ref - b_k n_brunt = sqrt ( max ( 0.0_wp , delta_b / delta_d )) vt2 = ( c_vt2 / ri_crit ) * d_centre_k * n_brunt * w_s_col shear2 = max (( u_k - u_ref ) * ( u_k - u_ref ) + & ( v_k - v_ref ) * ( v_k - v_ref ) + vt2 , SHEAR2_FLOOR ) ri_bulk = delta_b * delta_d / shear2 if ( ri_bulk >= ri_crit ) then denom = ri_bulk - ri_prev if ( abs ( denom ) > 1.0e-12_wp ) then frac = ( ri_crit - ri_prev ) / denom else frac = 0.5_wp end if h_b = d_prev + frac * ( d_centre_k - d_prev ) crossing_found = . true . end if ri_prev = ri_bulk d_prev = d_centre_k end if end do if (. not . crossing_found ) h_b = h_col state % multilayer % kpp_bl_depth ( cell ) = h_b end do end subroutine ml_kpp_boundary_layer_unstr","tags":"","url":"proc/ml_kpp_boundary_layer_unstr.html"},{"title":"ml_kpp_diffusion_tracers_unstr – Rakali","text":"public pure subroutine ml_kpp_diffusion_tracers_unstr(state, hS_layer, hT_layer, kappa_S_bg, kappa_T_bg, dt) Pass 2 (tracers): PP81 cubic interior diffusivity with the KPP\noverlay max’d in, plus the non-local counter-gradient transport\nfolded into the interface flux, applied two-pass on salinity +\ntemperature.  Fuses the two ml_vertical_diffusion_tracer_unstr calls; bit-identical to them where the overlay + non-local\nterms vanish. The non-local term gamma(iface) = cs·G(sigma)·F_kin is a\ndownward flux; adding dt·gamma to the diffusive interface\ntransfer makes the shared apply pass produce its divergence.\ngamma = 0 at the bed and free surface (no iface there), so the\ncolumn integral is conserved. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state rea