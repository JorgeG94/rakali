ps advance on flat explicit-shape arrays.  One !! `do concurrent` over cells (thread-per-cell — full occupancy for the !! short vertical dimension); sequential vertical sweep per cell with !! BPG_NZ_MAX stack workspace, same pattern as the unstructured PP81/KPP. integer , intent ( in ) :: nz , n , scheme real ( wp ), intent ( in ) :: h_layer ( nz , n ), hu_layer ( nz , n ) real ( wp ), intent ( in ) :: hv_layer ( nz , n ), rho_layer ( nz , n ) real ( wp ), intent ( inout ) :: tke ( nz + 1 , n ), eps ( nz + 1 , n ) real ( wp ), intent ( inout ) :: nut ( nz + 1 , n ), kt ( nz + 1 , n ) real ( wp ), intent ( in ) :: ustar_s ( n ), ustar_b ( n ), height_cv ( n ) real ( wp ), intent ( in ) :: rho_0 , dt logical , intent ( in ) :: use_walls integer :: cell , m , ni real ( wp ) :: u_dn , u_up , v_dn , v_up , dudz , dvdz , drho real ( wp ) :: prod , buoy , ktx , dd , du , sink , src , eok real ( wp ) :: k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m real ( wp ) :: S2 ( BPG_NZ_MAX ), N2 ( BPG_NZ_MAX ), dz_if ( BPG_NZ_MAX ) real ( wp ) :: a ( BPG_NZ_MAX ), b ( BPG_NZ_MAX ), c ( BPG_NZ_MAX ) real ( wp ) :: rhs ( BPG_NZ_MAX ), cp ( BPG_NZ_MAX ) ni = nz + 1 do concurrent ( cell = 1 : n ) & local ( m , u_dn , u_up , v_dn , v_up , dudz , dvdz , drho , & prod , buoy , ktx , dd , du , sink , src , eok , & k_wb , k_ws , e_wb , e_ws , cmu_m , cmup_m , & S2 , N2 , dz_if , a , b , c , rhs , cp ) if ( height_cv ( cell ) >= ML_MIN_DEPTH_UNSTR ) then ! ---- interface metrics, shear S&#94;2 and buoyancy N&#94;2 ---- dz_if ( 1 ) = 0.5_wp * h_layer ( 1 , cell ) dz_if ( ni ) = 0.5_wp * h_layer ( nz , cell ) S2 ( 1 ) = 0.0_wp N2 ( 1 ) = 0.0_wp S2 ( ni ) = 0.0_wp N2 ( ni ) = 0.0_wp do m = 2 , nz dz_if ( m ) = 0.5_wp * ( h_layer ( m - 1 , cell ) + h_layer ( m , cell )) u_dn = hu_layer ( m - 1 , cell ) / max ( h_layer ( m - 1 , cell ), DRY_TOLERANCE ) u_up = hu_layer ( m , cell ) / max ( h_layer ( m , cell ), DRY_TOLERANCE ) v_dn = hv_layer ( m - 1 , cell ) / max ( h_layer ( m - 1 , cell ), DRY_TOLERANCE ) v_up = hv_layer ( m , cell ) / max ( h_layer ( m , cell ), DRY_TOLERANCE ) dudz = ( u_up - u_dn ) / dz_if ( m ) dvdz = ( v_up - v_dn ) / dz_if ( m ) S2 ( m ) = dudz * dudz + dvdz * dvdz drho = rho_layer ( m , cell ) - rho_layer ( m - 1 , cell ) ! above - below N2 ( m ) = - GRAVITY * drho / rho_0 / dz_if ( m ) end do ! ---- log-law wall values (Dirichlet) when use_walls ---- k_wb = K_MIN e_wb = EPS_MIN k_ws = K_MIN e_ws = EPS_MIN if ( use_walls ) then k_wb = max ( ustar_b ( cell ) * ustar_b ( cell ) / sqrt ( CMU ), K_MIN ) e_wb = max ( ustar_b ( cell ) ** 3 / ( KAPPA_EFF * ( h_layer ( 1 , cell ) + Z0_BED )), EPS_MIN ) k_ws = max ( ustar_s ( cell ) * ustar_s ( cell ) / sqrt ( CMU ), K_MIN ) e_ws = max ( ustar_s ( cell ) ** 3 / ( KAPPA_EFF * ( h_layer ( nz , cell ) + Z0_SURF )), EPS_MIN ) end if ! ---- TKE: implicit diffusion + production - dissipation ---- do m = 2 , nz if ( use_walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = k_ws else rhs ( m ) = k_wb end if else ktx = kt ( m , cell ) prod = nut ( m , cell ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( m - 1 , cell ) + nut ( m , cell )) / SIG_K du = 0.5_wp * ( nut ( m , cell ) + nut ( m + 1 , cell )) / SIG_K a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( m - 1 , cell ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( m , cell ) sink = eps ( m , cell ) / max ( tke ( m , cell ), K_MIN ) b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( prod + buoy , 0.0_wp ) rhs ( m ) = tke ( m , cell ) + dt * src end if end do call keps_tridiag_solve_u ( a , b , c , rhs , cp , ni ) do m = 1 , ni tke ( m , cell ) = max ( rhs ( m ), K_MIN ) end do ! ---- eps: implicit diffusion + (eps/k)(ce1 P + ce3 B - ce2 eps) ---- do m = 2 , nz if ( use_walls . and . ( m == 2 . or . m == nz )) then a ( m ) = 0.0_wp c ( m ) = 0.0_wp b ( m ) = 1.0_wp if ( m == nz ) then rhs ( m ) = e_ws else rhs ( m ) = e_wb end if else ktx = kt ( m , cell ) prod = nut ( m , cell ) * S2 ( m ) buoy = - ktx * N2 ( m ) dd = 0.5_wp * ( nut ( m - 1 , cell ) + nut ( m , cell )) / SIG_E du = 0.5_wp * ( nut ( m , cell ) + nut ( m + 1 , cell )) / SIG_E a ( m ) = - dt / dz_if ( m ) * dd / h_layer ( m - 1 , cell ) c ( m ) = - dt / dz_if ( m ) * du / h_layer ( m , cell ) eok = eps ( m , cell ) / max ( tke ( m , cell ), K_MIN ) ! tke is NEW sink = CE2 * eok b ( m ) = 1.0_wp - a ( m ) - c ( m ) + dt * sink src = max ( eok * ( CE1 * prod + CE3 * buoy ), 0.0_wp ) rhs ( m ) = eps ( m , cell ) + dt * src end if end do call keps_tridiag_solve_u ( a , b , c , rhs , cp , ni ) do m = 1 , ni eps ( m , cell ) = max ( rhs ( m ), EPS_MIN ) end do ! ---- recover nu_t, kappa_t ---- do m = 1 , ni call keps_stability_funcs ( scheme , S2 ( m ), N2 ( m ), tke ( m , cell ), & eps ( m , cell ), cmu_m , cmup_m ) nut ( m , cell ) = min ( max ( cmu_m * tke ( m , cell ) * tke ( m , cell ) & / max ( eps ( m , cell ), EPS_MIN ), NUT_MIN ), NUT_MAX ) kt ( m , cell ) = min ( max ( cmup_m * tke ( m , cell ) * tke ( m , cell ) & / max ( eps ( m , cell ), EPS_MIN ), NUT_MIN ), NUT_MAX ) end do end if end do end subroutine ml_keps_update_unstr_impl","tags":"","url":"proc/ml_keps_update_unstr_impl.html"},{"title":"keps_tridiag_solve_noflux_u – Rakali","text":"private pure subroutine keps_tridiag_solve_noflux_u(a, b, c, rhs, cp, nn) In-place Thomas solve over rows 1..nn with the boundary closure already\nbaked into a/b/c by the caller (no row override, unlike keps_tridiag_solve_u ).  a/b/c read-only so one factorisation serves\nmultiple RHS.  Duplicate of the structured keps_tridiag_solve_noflux,\nkept same-module so it inlines in the per-cell apply loop. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: a (nn) real(kind=wp), intent(in) :: b (nn) real(kind=wp), intent(in) :: c (nn) real(kind=wp), intent(inout) :: rhs (nn) real(kind=wp), intent(inout) :: cp (nn) integer, intent(in) :: nn Called by proc~~keps_tridiag_solve_noflux_u~~CalledByGraph pr