state%barotropic%max_speed(k)`. Per cell !!   dt_k = mesh%radius(k) / max_speed(k) !! where `radius(k)` is the min centroid-to-edge-midpoint distance !! (ANUGA `radii`); global `dt = cfl * min_k dt_k`. Cells with !! `max_speed` below `epsilon` are skipped. Reduction via !! `!$acc parallel loop reduction(min:..)`. use rki_constants , only : wp use rki_mesh_unstr , only : mesh_unstr_t use rki_state_unstr , only : unstr_state_t implicit none private public :: compute_timestep_unstr public :: TIMESTEP_LARGE real ( wp ), parameter :: TIMESTEP_EPSILON = 1.0e-15_wp !! Cells with `max_speed` below this contribute nothing to the !! timestep reduction (no characteristic to constrain). real ( wp ), parameter :: TIMESTEP_LARGE = huge ( 1.0_wp ) !! Initial running minimum (effectively infinity); `huge` fits !! either precision (`1.0e+100_wp` overflows `real32`). contains subroutine compute_timestep_unstr ( state , mesh ) !! Compute the CFL-limited timestep and store it in `state%dt`. !! Reads `max_speed`, `state%cfl`, `mesh%radius` only. Must run !! after the flux kernel; before any flux pass it returns !! `cfl * TIMESTEP_LARGE` (all max_speed still 0). type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: k real ( wp ) :: dt_local , cell_dt dt_local = TIMESTEP_LARGE do concurrent ( k = 1 : mesh % ncells_owned ) reduce ( min : dt_local ) if ( state % barotropic % max_speed ( k ) > TIMESTEP_EPSILON ) then cell_dt = mesh % radius ( k ) / state % barotropic % max_speed ( k ) if ( cell_dt < dt_local ) dt_local = cell_dt end if end do ! Clamp +inf back to TIMESTEP_LARGE: NVHPC's reduction(min:..) can ! return +inf when the loop never updates the accumulator (all ! max_speed = 0), so the \"no characteristics => dt = cfl * ! TIMESTEP_LARGE\" contract holds bit-exactly. if (. not . ( dt_local <= TIMESTEP_LARGE )) dt_local = TIMESTEP_LARGE state % dt = state % cfl * dt_local end subroutine compute_timestep_unstr end module rki_kernel_timestep_unstr","tags":"","url":"sourcefile/rki_kernel_timestep_unstr.f90.html"},{"title":"rki_kernel_fused_unstr.F90 – Rakali","text":"Fused update kernels for the unstructured solver: merge save +\nupdate + friction + wind + protect into one kernel launch per RK\nstage, keeping state in registers across the sequence. Entry points:\n  fused_update_stage1_unstr — save U&#94;n + Euler + friction + protect\n  fused_update_stage2_unstr — Euler + friction + protect + RK2 avg + protect This file depends on sourcefile~~rki_kernel_fused_unstr.f90~~EfferentGraph sourcefile~rki_kernel_fused_unstr.f90 rki_kernel_fused_unstr.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_fused_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_kernel_fused_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_kernel_fused_unstr.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_barotropic_state_unstr.f90 rki_barotropic_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_barotropic_state_unstr.f90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_multilayer_state_unstr.f90 rki_multilayer_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_multilayer_state_unstr.f90 sourcefile~rki_si_common.f90 rki_si_common.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_si_common.f90 sourcefile~rki_si_unstr_state.f90 rki_si_unstr_state.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_surface_forcing_unstr.f90 rki_surface_forcing_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_surface_forcing_unstr.f90 sourcefile~rki_timestepper.f90 rki_timestepper.