ibility Attributes Name Initial integer, private :: dlev integer, private :: n Source Code subroutine output_unstr_init ( ostate , filename , state , mesh , deflate_level ) !! Create a CF UGRID 1.0 NetCDF file from mesh + state objects. type ( output_unstr_state_t ), intent ( out ) :: ostate character ( len =* ), intent ( in ) :: filename type ( unstr_state_t ), intent ( in ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ), optional :: deflate_level integer :: dlev , n dlev = 0 if ( present ( deflate_level )) dlev = deflate_level n = mesh % ncells_owned if ( allocated ( mesh % cell_global_id )) then call create_ugrid_file ( ostate , filename , mesh % nverts , n , & mesh % vert_x ( 1 : mesh % nverts ), & mesh % vert_y ( 1 : mesh % nverts ), & mesh % tri_v (:, 1 : n ), & mesh % centroid_x ( 1 : n ), mesh % centroid_y ( 1 : n ), & mesh % area ( 1 : n ), state % barotropic % bed_cv ( 1 : n ), & cell_global_id = mesh % cell_global_id ( 1 : n ), & dlev = dlev , state = state ) else call create_ugrid_file ( ostate , filename , mesh % nverts , n , & mesh % vert_x ( 1 : mesh % nverts ), & mesh % vert_y ( 1 : mesh % nverts ), & mesh % tri_v (:, 1 : n ), & mesh % centroid_x ( 1 : n ), mesh % centroid_y ( 1 : n ), & mesh % area ( 1 : n ), state % barotropic % bed_cv ( 1 : n ), & dlev = dlev , state = state ) end if end subroutine output_unstr_init","tags":"","url":"proc/output_unstr_init.html"},{"title":"output_unstr_init_from_arrays – Rakali","text":"public  subroutine output_unstr_init_from_arrays(ostate, filename, nverts, ncells, vert_x, vert_y, tri_v, centroid_x, centroid_y, area, bed, cell_global_id, deflate_level) Create a CF UGRID 1.0 NetCDF file from raw arrays.\nFor callers that hold raw topology arrays instead of a mesh. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(out) :: ostate character(len=*), intent(in) :: filename integer, intent(in) :: nverts integer, intent(in) :: ncells real(kind=wp), intent