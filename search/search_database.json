ut) :: state real(kind=wp), intent(in) :: dt public pure subroutine ml_apply_coriolis_unstr (state, dt) Rotate every wet layer’s (hu_k, hv_k) through angle f*dt with\nthe closed-form rotation matrix (energy-conserving, det = 1).\nSkips layers thinner than THIN_LAYER_THRESHOLD (already zeroed by\nthe distribute / friction kernels). Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt","tags":"","url":"module/rki_ml_friction_unstr.html"},{"title":"rki_kernel_fused – Rakali","text":"Uses rki_grid rki_constants module~~rki_kernel_fused~~UsesGraph module~rki_kernel_fused rki_kernel_fused module~rki_constants rki_constants module~rki_kernel_fused->module~rki_constants module~rki_grid rki_grid module~rki_kernel_fused->module~rki_grid pic_types pic_types module~rki_constants->pic_types module~rki_grid->module~rki_constants Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_kernel_fused~~UsedByGraph module~rki_kernel_fused rki_kernel_fused module~rki_solver rki_solver module~rki_solver->module~rki_kernel_fused module~rki_api rki_api module~rki_api->module~rki_solver module~rki_driver rki_driver module~rki_driver->module~rki_solver Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Subroutines public pure subroutine fused_update_stage1 (h, hu, hv, h0, hu0, hv0, flux_h, flux_hu, flux_hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, coriolis_f, forcing_active) Stage 1: save + Euler update + clamp + friction + coriolis Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active public pure subroutine fused_update_stage2 (h, hu, hv, h0, hu0, hv0, flux_h, flux_hu, flux_hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, coriolis_f, forcing_active) Stage 2: Euler update + clamp + friction + coriolis + RK2 average + clamp Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: h0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hu0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: hv0 (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active public pure subroutine fused_update_stage_generic (h, hu, hv, flux_h, flux_hu, flux_hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, coriolis_f, forcing_active) One forward-Euler stage for the selectable-integrator path:\nEuler update + clamp/desingularization + friction + wind + pressure +\nprecipitation + coriolis, all scaled by the per-stage dt ( beta(i)*dt_step ).  No state save and no RK2 average — the\nstart-of-step backup is taken once by solver_save_state and the\nconvex blend is a separate compute_ssp_combine call.  The body is\nidentical to fused_update_stage1 minus the h0/hu0/hv0 writes so\nevery scheme shares one source-term implementation. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active","tags":"","url":"module/rki_kernel_fused.html"},{"title":"rki_multilayer_state_unstr – Rakali","text":"Per-layer prognostic arrays ( (nz_ml, ncells_total) axis order —\nlayer index fastest, matching column-stencil kernels), vcoord\ndefinition + GPU mirror, diagnostic vertical velocity, EOS density\n+ reference profile, tracer registry, per-step Jacobi/gradient\nworkspaces, and the scalar physics parameters the kernels read. Lives at state%multilayer . Allocated by state_unstr_init when nz_ml is passed. Mirrors structured multilayer_state_t with the\ncell-centric axis order swapped. Uses rki_eos pic_logger rki_mesh_unstr rki_vcoord rki_constants rki_boundary_unstr rki_tracer_unstr module~~rki_multilayer_state_unstr~~UsesGraph module~rki_multilayer_state_unstr rki_multilayer_state_unstr module~rki_boundary_unstr rki_boundary_unstr module~rki_multilayer_state_unstr->module~rki_boundary_unstr module~rki_constants rki_constants module~rki_multilayer_state_unstr->module~rki_constants module~rki_eos rki_eos module~rki_multilayer_state_unstr->module~rki_eos module~rki_mesh_unstr rki_mesh_unstr module~rki_multilayer_state_unstr->module~rki_mesh_unstr module~rki_tracer_unstr rki_tracer_unstr module~rki_multilayer_state_unstr->module~rki_tracer_unstr module~rki_vcoord rki_vcoord module~rki_multilayer_state_unstr->module~rki_vcoord pic_logger pic_logger module~rki_multilayer_state_unstr->pic_logger pic_types pic_types module~rki_constants->pic_types module~rki_eos->module~rki_constants module~rki_grid rki_grid module~rki_eos->module~rk