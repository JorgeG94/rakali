ent ( in ) :: k real ( wp ), intent ( in ) :: dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 real ( wp ), intent ( out ) :: stage_ev_local ( 3 ) real ( wp ), intent ( out ) :: xmom_ev_local ( 3 ) real ( wp ), intent ( out ) :: ymom_ev_local ( 3 ) real ( wp ), intent ( out ) :: height_ev_local ( 3 ) integer :: k0 , k1 , k2 real ( wp ) :: x0 , y0 , x1 , y1 , x2 , y2 real ( wp ) :: dx1 , dy1 , dx2 , dy2 , area2 , inv_area2 real ( wp ) :: hfactor real ( wp ) :: beta_stage , beta_xmom , beta_ymom k0 = mesh % surrogate_neighbours ( 1 , k ) k1 = mesh % surrogate_neighbours ( 2 , k ) k2 = mesh % surrogate_neighbours ( 3 , k ) x0 = mesh % centroid_x ( k0 ) y0 = mesh % centroid_y ( k0 ) x1 = mesh % centroid_x ( k1 ) y1 = mesh % centroid_y ( k1 ) x2 = mesh % centroid_x ( k2 ) y2 = mesh % centroid_y ( k2 ) dx1 = x1 - x0 dy1 = y1 - y0 dx2 = x2 - x0 dy2 = y2 - y0 area2 = dy2 * dx1 - dy1 * dx2 ! Collinear/coincident neighbours -> area2 vanishes; fall back to ! constant edge values. if ( abs ( area2 ) <= 1.0e-30_wp ) then call set_constant_edge_values_impl ( state % barotropic % stage_cv ( k ), stage_ev_local ) call set_constant_edge_values_impl ( state % barotropic % xmom_cv ( k ), xmom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % ymom_cv ( k ), ymom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % height_cv ( k ), height_ev_local ) return end if inv_area2 = 1.0_wp / area2 hfactor = compute_hfactor_impl ( state % barotropic % height_cv ( k ), & state % barotropic % height_cv ( k0 ), & state % barotropic % height_cv ( k1 ), & state % barotropic % height_cv ( k2 ), & state % minimum_allowed_height ) beta_stage = state % beta_w_dry + ( state % beta_w - state % beta_w_dry ) * hfactor beta_xmom = state % beta_uh_dry + ( state % beta_uh - state % beta_uh_dry ) * hfactor beta_ymom = state % beta_vh_dry + ( state % beta_vh - state % beta_vh_dry ) * hfactor call calc_edge_values_three_neighbours_impl ( & state % barotropic % stage_cv ( k ), state % barotropic % stage_cv ( k0 ), state % barotropic % stage_cv ( k1 ), state % barotropic % stage_cv ( k2 ), & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & dx1 , dx2 , dy1 , dy2 , inv_area2 , & beta_stage , stage_ev_local ) call calc_edge_values_three_neighbours_impl ( & state % barotropic % height_cv ( k ), state % barotropic % height_cv ( k0 ), state % barotropic % height_cv ( k1 ), state % barotropic % height_cv ( k2 ), & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & dx1 , dx2 , dy1 , dy2 , inv_area2 , & beta_stage , height_ev_local ) call calc_edge_values_three_neighbours_impl ( & state % barotropic % xmom_cv ( k ), state % barotropic % xmom_cv ( k0 ), state % barotropic % xmom_cv ( k1 ), state % barotropic % xmom_cv ( k2 ), & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & dx1 , dx2 , dy1 , dy2 , inv_area2 , & beta_xmom , xmom_ev_local ) call calc_edge_values_three_neighbours_impl ( & state % barotropic % ymom_cv ( k ), state % barotropic % ymom_cv ( k0 ), state % barotropic % ymom_cv ( k1 ), state % barotropic % ymom_cv ( k2 ), & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & dx1 , dx2 , dy1 , dy2 , inv_area2 , & beta_ymom , ymom_ev_local ) end subroutine extrapolate_three_neighbour_branch","tags":"","url":"proc/extrapolate_three_neighbour_branch.html"},{"title":"limit_gradient_impl – Rakali","text":"private pure subroutine limit_gradient_impl(dqv, qmin, qmax, beta) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: dqv (3) real(kind=wp), intent(in) :: qmin real(kind=wp), intent(in) :: qmax real(kind=wp), intent(in) :: beta Called by proc~~limit_gradient_impl~~CalledByGraph proc~limit_gradient_impl limit_gradient_impl proc~calc_edge_values_three_neighbours_impl calc_edge_values_three_neighbours_impl proc~calc_edge_values_three_neighbours_impl->proc~limit_gradient_impl proc~extrapolate_one_neighbour_branch extrapolate_one_neighbour_branch proc~extrapolate_one_neighbour_branch->proc~limit_gradient_impl proc~extrapolate_one_cell extrapolate_one_cell pr