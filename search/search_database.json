=wp), private :: du real(kind=wp), private :: dv real(kind=wp), private :: g_shape real(kind=wp), private :: h_avg real(kind=wp), private :: h_b real(kind=wp), private :: h_col real(kind=wp), private :: hk real(kind=wp), private :: hkp1 integer, private :: k real(kind=wp), private :: nu_kpp real(kind=wp), private :: nu_t real(kind=wp), private :: ri_num real(kind=wp), private :: sig real(kind=wp), private :: uk real(kind=wp), private :: ukp1 real(kind=wp), private :: us real(kind=wp), private :: vk real(kind=wp), private :: vkp1 real(kind=wp), private :: w_s real(kind=wp), private :: w_star real(kind=wp), private :: wstar3_val Source Code pure subroutine si_unstr_build_nu_interface_kpp ( nz , nzp1 , nct , nco , & h_layer , hu_layer , hv_layer , & rho_layer , rho_0 , nu_max , & nu_bg , ri_alpha , u_star , & buoy_flux , bl_depth , nu_iface ) !! PP81 interior interface viscosity with the KPP (LMD94) surface- !! boundary-layer overlay MAX'd in, for the SI implicit column solve: !!   nu = max( nu_max/(1+ri_alpha*Ri)&#94;2 + nu_bg, !!             h_b * w_s * G(sigma) )        for interfaces inside h_b !! with G(sigma) = sigma(1-sigma)&#94;2, sigma = d_iface/h_b, and the !! velocity scale w_s = sqrt(u_*&#94;2 + w_*&#94;2), w_*&#94;3 = max(0,-B_0)*h_b. !! NO dt clamp: the consumer is the unconditionally-stable implicit !! tridiagonal.  Where the overlay is inactive (w_s = 0 / below the !! BL) the result is EXACTLY the PP81 `si_unstr_build_nu_interface` value. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! PP81 maximum turbulent viscosity [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_bg !! Background viscosity floor [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! PP81 Richardson tuning coefficient. real ( wp ), intent ( in ) :: u_star ( nct ) !! Surface friction velocity [m/s] (from ml_kpp_boundary_layer_unstr). real ( wp ), intent ( in ) :: buoy_flux ( nct ) !! Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real ( wp ), intent ( in ) :: bl_depth ( nct ) !! Diagnosed boundary-layer depth [m]. real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s], vdiff convention (bed/surface 0). integer :: c , k real ( wp ) :: h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , ri_num , denom_ri , nu_t real ( wp ) :: h_b , b_0 , us , wstar3_val , w_star , w_s real ( wp ) :: d_below , d_iface , sig , g_shape , nu_kpp do concurrent ( c = 1 : nco ) & local ( k , h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , & du , dv , drho , ri_num , denom_ri , nu_t , & h_b , b_0 , us , wstar3_val , w_star , w_s , & d_below , d_iface , sig , g_shape , nu_kpp ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( k , c ) end do if ( h_col > ML_MIN_DEPTH_UNSTR ) then h_b = bl_depth ( c ) b_0 = buoy_flux ( c ) us = u_star ( c ) wstar3_val = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3_val ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) h_avg = 0.5_wp * ( hk + hkp1 ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED ) then uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + SHEAR2_EPS ) if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom_ri = 1.0_wp + ri_alpha * ri_num nu_t = nu_max / ( denom_ri * denom_ri ) + nu_bg ! KPP overlay inside the boundary layer (max, LMD94). if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) nu_kpp = h_b * w_s * g_shape if ( nu_kpp > nu_t ) nu_t = nu_kpp end if nu_iface ( k + 1 , c ) = nu_t else nu_iface ( k + 1 , c ) = 0.0_wp end if end do else do k = 1 , nz - 1 nu_iface ( k + 1 , c ) = 0.0_wp end do end if end do end subroutine si_unstr_build_nu_interface_kpp","tags":"","url":"proc/si_unstr_build_nu_interface_kpp.html"},{"title":"si_unstr_fill_nu_iface_from_keps – Rakali","text":"public pure subroutine si_unstr_fill_nu_iface_from_keps(nz, nzp1, nct, nco, h_layer, keps_nut, nu_iface) Copy the k-epsilon interface viscosity into the SI column-solve slot. keps_nut and nu_iface share the interface convention (m=1 bed,\nm=nz+1 surface); interior interfaces copy 1:1; bed and surface rows\nare forced to 0 (no flux through bed/surface — wind and drag enter\nthe column solve separately), and an interface bounded by a vanished\nlayer decouples (nu = 0), mirroring si_unstr_build_nu_interface so the closure swap changes ONLY the viscosity values. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up (k=1 bed). real(kind=wp), intent(in) :: keps_nut (nzp1,nct) k-epsilon interface eddy viscosity [m&#94;2/s] (from ml_keps_update_unstr). real(kind=wp), intent(out) :: nu_iface (nzp1,nct) SI interface viscosity [m&#94;2/s], vdiff convention. Calls proc~~si_unstr_fill_nu_iface_from_keps~~CallsGraph proc~si_unstr_fill_nu_iface_from_keps si_unstr_fill_nu_iface_from_keps local local proc~si_unstr_fill_nu_iface_from_keps->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_fill_nu_iface_from_keps~~CalledByGraph proc~si_unstr_fill_nu_iface_from_keps si_unstr_fill_nu_iface_from_keps proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_fill_nu_iface_from_keps proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c real(kind=wp), private :: hk real(kind=wp), private :: hkp1 integer, private :: k Source Code pure subroutine si_unstr_fill_nu_iface_from_keps ( nz , nzp1 , nct , nco , & h_layer , keps_nut , nu_iface ) !! Copy the k-epsilon interface viscosity into the SI column-solve slot. !! `keps_nut` and `nu_iface` share the interface convention (m=1 bed, !! m=nz+1 surface); interior interfaces copy 1:1; bed and surface rows !! are forced to 0 (no flux through bed/surface — wind and drag enter !! the column solve separately), and an interface bounded by a vanished !! layer decouples (nu = 0), mirroring `si_unstr_build_nu_interface` !! so the closure swap changes ONLY the viscosity values. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up (k=1 bed). real ( wp ), intent ( in ) :: keps_nut ( nzp1 , nct ) !! k-epsilon interface eddy viscosity [m&#94;2/s] (from ml_keps_update_unstr). real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! SI interface viscosity [m&#94;2/s], vdiff convention. integer :: c , k real ( wp ) :: hk , hkp1 do concurrent ( c = 1 : nco ) local ( k , hk , hkp1 ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) if ( hk <= H_VANISHED . or . hkp1 <= H_VANISHED ) then nu_iface ( k + 1 , c ) = 0.0_wp else nu_iface ( k + 1 , c ) = keps_nut ( k + 1 , c ) end if end do end do end subroutine si_unstr_fill_nu_iface_from_keps","tags":"","url":"proc/si_unstr_fill_nu_iface_from_keps.html"},{"title":"si_unstr_keps_copy_iface – Rakali","text":"public pure subroutine si_unstr_keps_copy_iface(nzp1, nct, nco, src, dst) Interface-array copy (nzp1, nct) for the keps_si_picard > 1 save/restore: the Picard loop re-runs ml_keps_update_unstr from\nthe SAME pre-step k / eps with the refreshed nu_t production\ncoefficient (see local_archive/prototypes/si_closures/DISCRETIZATION_SPEC.md\nsection 3). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nzp1 Interface count (nz + 1). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: src (nzp1,nct) Source interface array. real(kind=wp), intent(out) :: dst (nzp1,nct) Destination interface array. Called by proc~~si_unstr_keps_copy_iface~~CalledByGraph proc~si_unstr_keps_copy_iface si_unstr_keps_copy_iface proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_keps_copy_iface proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c integer, private :: m Source Code pure subroutine si_unstr_keps_copy_iface ( nzp1 , nct , nco , src , dst ) !! Interface-array copy (nzp1, nct) for the `keps_si_picard > 1` !! save/restore: the Picard loop re-runs `ml_keps_update_unstr` from !! the SAME pre-step k / eps with the refreshed nu_t production !! coefficient (see local_archive/prototypes/si_closures/DISCRETIZATION_SPEC.md !! section 3). integer , intent ( in ) :: nzp1 !! Interface count (nz + 1). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: src ( nzp1 , nct ) !! Source interface array. real ( wp ), intent ( out ) :: dst ( nzp1 , nct ) !! Destination interface array. integer :: c , m do concurrent ( m = 1 : nzp1 , c = 1 : nco ) dst ( m , c ) = src ( m , c ) end do end subroutine si_unstr_keps_copy_iface","tags":"","url":"proc/si_unstr_keps_copy_iface.html"},{"title":"si_unstr_kpp_diffusion_tracers – Rakali","text":"public pure subroutine si_unstr_kpp_diffusion_tracers(nz, nzp1, nct, nco, h_layer, hu_layer, hv_layer, hS_layer, hT_layer, rho_layer, rho_0, nu_max, kappa_S_bg, kappa_T_bg, ri_alpha, cs_nonlocal, heat_flux, evap_minus_precip, cp, u_star, buoy_flux, bl_depth, dt) S/T vertical diffusion with the KPP overlay for the SI step:\nIMPLICIT (Thomas) column solve with the PP81-CUBIC interior\ndiffusivity + the KPP shape-function overlay MAX’d in (same\noverlay as momentum; no dt clamp — implicit), then the LMD94\nnon-local counter-gradient transport applied as a conservative\ninterface divergence AFTER the diffusion (the coastal explicit\norder: vdiff-then-nonlocal), reading the post-diffusion surface\nsalinity for F_S.  gamma = 0 at bed and surface => the divergence\nconserves the column integral exactly.  Conserves column tracer\ncontent (no-flux tridiagonal). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nz Number of layers. integer, intent(in) :: nzp1 nz + 1 (leading dim of interface arrays). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: h_layer (nz,nct) Layer thicknesses [m], bottom-up. real(kind=wp), intent(in) :: hu_layer (nz,nct) Layer x-transports [m&#94;2/s] (shear for the PP81 Ri). real(kind=wp), intent(in) :: hv_layer (nz,nct) Layer y-transports [m&#94;2/s]. real(kind=wp), intent(inout) :: hS_layer (nz,nct) Salinity content [PSU m], updated in place. real(kind=wp), intent(inout) :: hT_layer (nz,nct) Temperature content [degC m], updated in place. real(kind=wp), intent(in) :: rho_layer (nz,nct) Layer densities [kg/m&#94;3]. real(kind=wp), intent(in) :: rho_0 Reference density [kg/m&#94;3]. real(kind=wp), intent(in) :: nu_max PP81 maximum turbulent diffusivity scale [m&#94;2/s]. real(kind=wp), intent(in) :: kappa_S_bg Background salinity diffusivity [m&#94;2/s]. real(kind=wp), intent(in) :: kappa_T_bg Background temperature diffusivity [m&#94;2/s]. real(kind=wp), intent(in) :: ri_alpha PP81 Richardson tuning coefficient. real(kind=wp), intent(in) :: cs_nonlocal Non-local transport coefficient C_s (LMD94 eq 20). real(kind=wp), intent(in) :: heat_flux (nct) Surface heat flux [W/m&#94;2] (positive warms), per cell. real(kind=wp), intent(in) :: evap_minus_precip (nct) Net evaporation [m/s], per cell. real(kind=wp), intent(in) :: cp Specific heat of water [J/(kg K)]. real(kind=wp), intent(in) :: u_star (nct) Surface friction velocity [m/s]. real(kind=wp), intent(in) :: buoy_flux (nct) Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real(kind=wp), intent(in) :: bl_depth (nct) Diagnosed boundary-layer depth [m]. real(kind=wp), intent(in) :: dt Time step [s]. Calls proc~~si_unstr_kpp_diffusion_tracers~~CallsGraph proc~si_unstr_kpp_diffusion_tracers si_unstr_kpp_diffusion_tracers local local proc~si_unstr_kpp_diffusion_tracers->local proc~si_unstr_tridiag_noflux si_unstr_tridiag_noflux proc~si_unstr_kpp_diffusion_tracers->proc~si_unstr_tridiag_noflux Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_kpp_diffusion_tracers~~CalledByGraph proc~si_unstr_kpp_diffusion_tracers si_unstr_kpp_diffusion_tracers proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_kpp_diffusion_tracers proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~dr