) deallocate ( this % precipitation ) if ( allocated ( this % heat_flux )) deallocate ( this % heat_flux ) if ( allocated ( this % evap_minus_precip )) deallocate ( this % evap_minus_precip ) this % active = . false . end subroutine surface_forcing_destroy","tags":"","url":"proc/surface_forcing_destroy.html"},{"title":"surface_forcing_init – Rakali","text":"private  subroutine surface_forcing_init(this, grid) Allocate the surface-forcing arrays sized to the grid, zero-filled.\nUniform fallbacks (wind_stress_x/y) are set by the caller from config. Type Bound surface_forcing_t Arguments Type Intent Optional Attributes Name class( surface_forcing_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid Variables Type Visibility Attributes Name Initial integer, private :: nx integer, private :: ny Source Code subroutine surface_forcing_init ( this , grid ) !! Allocate the surface-forcing arrays sized to the grid, zero-filled. !! Uniform fallbacks (wind_stress_x/y) are set by the caller from config. class ( surface_forcing_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid integer :: nx , ny nx = grid % nx_total ny = grid % ny_total allocate ( this % wind_x ( nx , ny ), source = 0.0_wp ) allocate ( this % wind_y ( nx , ny ), source = 0.0_wp ) allocate ( this % atm_pressure ( nx , ny ), source = 0.0_wp ) allocate ( this % precipitation ( nx , ny ), source = 0.0_wp ) allocate ( this % heat_flux ( nx , ny ), source = 0.0_wp ) allocate ( this % evap_minus_precip ( nx , ny ), source = 0.0_wp ) end subroutine surface_forcing_init","tags":"","url":"proc/surface_forcing_init.html"},{"title":"ml_set_min_depth – Rakali","text":"public  subroutine ml_set_min_depth(depth) Set the minimum total water depth for vertical layer operations.\nCall once at startup from config. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: depth Called by proc~~ml_set_min_depth~~CalledByGraph proc~ml_set_min_depth ml_set_min_depth proc~init_multilayer_f