ule. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dist2 real(kind=wp), private :: dq1 real(kind=wp), private :: dqv (3) real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: grad_dx2 real(kind=wp), private :: grad_dy2 integer, private :: i integer, private :: kn real(kind=wp), private :: qmax real(kind=wp), private :: qmin Source Code pure subroutine extrapolate_one_neighbour_branch ( & state , mesh , k , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , & stage_ev_local , xmom_ev_local , ymom_ev_local , height_ev_local ) !! Two-boundary fallback: gradient taken toward the single internal !! neighbour, displacement normalised by squared distance: !! `dq * (dx, dy)/|dx,dy|&#94;2 . (xv, yv)`. type ( unstr_state_t ), intent ( in ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: k real ( wp ), intent ( in ) :: dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 real ( wp ), intent ( out ) :: stage_ev_local ( 3 ) real ( wp ), intent ( out ) :: xmom_ev_local ( 3 ) real ( wp ), intent ( out ) :: ymom_ev_local ( 3 ) real ( wp ), intent ( out ) :: height_ev_local ( 3 ) integer :: i , kn real ( wp ) :: dx , dy , dist2 real ( wp ) :: grad_dx2 , grad_dy2 real ( wp ) :: dq1 , qmin , qmax real ( wp ) :: dqv ( 3 ) ! Find the single internal neighbour. kn = k do i = 1 , 3 if ( mesh % surrogate_neighbours ( i , k ) /= k ) then kn = mesh % surrogate_neighbours ( i , k ) exit end if end do if ( kn == k ) then ! Should not happen for n_boundaries == 2, but be defensive. call set_constant_edge_values_impl ( state % barotropic % stage_cv ( k ), stage_ev_local ) call set_constant_edge_values_impl ( state % barotropic % xmom_cv ( k ), xmom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % ymom_cv ( k ), ymom_ev_local ) call set_constant_edge_values_impl ( state % barotropic % height_cv ( k ), height_ev_local ) return end if dx = mesh % centroid_x ( kn ) - mesh % centroid_x ( k ) dy = mesh % centroid_y ( kn ) - mesh % centroid_y ( k ) dist2 = dx * dx + dy * dy if ( dist2 > 0.0_wp ) then grad_dx2 = dx / dist2 grad_dy2 = dy / dist2 else grad_dx2 = 0.0_wp grad_dy2 = 0.0_wp end if ! Stage dq1 = state % barotropic % stage_cv ( kn ) - state % barotropic % stage_cv ( k ) call calc_dqv_one_neighbour_impl ( dq1 , grad_dx2 , grad_dy2 , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , dqv ) call qrange_one_diff_impl ( dq1 , qmin , qmax ) call limit_gradient_impl ( dqv , qmin , qmax , state % beta_w ) stage_ev_local ( 1 ) = state % barotropic % stage_cv ( k ) + dqv ( 1 ) stage_ev_local ( 2 ) = state % barotropic % stage_cv ( k ) + dqv ( 2 ) stage_ev_local ( 3 ) = state % barotropic % stage_cv ( k ) + dqv ( 3 ) ! Height dq1 = state % barotropic % height_cv ( kn ) - state % barotropic % height_cv ( k ) call calc_dqv_one_neighbour_impl ( dq1 , grad_dx2 , grad_dy2 , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , dqv ) call qrange_one_diff_impl ( dq1 , qmin , qmax ) call limit_gradient_impl ( dqv , qmin , qmax , state % beta_w ) height_ev_local ( 1 ) = state % barotropic % height_cv ( k ) + dqv ( 1 ) height_ev_local ( 2 ) = state % barotropic % height_cv ( k ) + dqv ( 2 ) height_ev_local ( 3 ) = state % barotropic % height_cv ( k ) + dqv ( 3 ) ! x-momentum dq1 = state % barotropic % xmom_cv ( kn ) - state % barotropic % xmom_cv ( k ) call calc_dqv_one_neighbour_impl ( dq1 , grad_dx2 , grad_dy2 , & dxv0 , dxv1 , dxv2 , dyv0 , dyv1 , dyv2 , dqv ) call qrange_one_diff_impl ( dq1 , qmin , qmax ) call limit_gradient_impl ( dqv , qmin , qmax , state % beta_uh ) xmom_ev_local ( 1 ) = state % barotropic % xmom_cv ( k ) + dqv ( 1 ) xmom_ev_local ( 2 ) = state % barotropic % xmom_cv ( k ) + dqv ( 2 ) xmom_ev_local ( 3 ) = state % barotropic % xmom_cv ( k ) + dqv ( 3 ) ! y-momentum dq1 = state % barotropic % ymom_cv ( kn ) - state % barotropic % ymom_cv ( k ) call calc_dqv_o