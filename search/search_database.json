ent that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial type( nml_group_t ), private :: g integer, private, pointer :: pi logical, private, pointer :: pl real(kind=wp), private, pointer :: pr character(len=:), private, pointer :: ps Source Code subroutine register_output ( cfg , schema ) !! `&output_nml`: file output + I/O + forcing/restart/gauge files. type ( config_t ), target , intent ( in ) :: cfg type ( nml_schema_t ), intent ( inout ) :: schema type ( nml_group_t ) :: g real ( wp ), pointer :: pr integer , pointer :: pi logical , pointer :: pl character ( len = :), pointer :: ps g % name = \"output\" g % doc = \"File output, forcing/restart/gauge files.\" pl => cfg % output_to_file call g % add ( nml_logical ( \"output_to_file\" , pl , \"Enable file output (NetCDF snapshots)\" )) ps => cfg % output_dir call g % add ( nml_string ( \"output_dir\" , ps , \"Directory for output files\" )) pr => cfg % output_interval call g % add ( nml_real ( \"output_interval\" , pr , \"Time between output snapshots\" , units = \"s\" )) ps => cfg % output_format call g % add ( nml_enum ( \"output_format\" , ps , \"Output format\" , & allowed = [ character ( len = 6 ) :: \"ascii\" , \"netcdf\" ])) pr => cfg % restart_interval call g % add ( nml_real ( \"restart_interval\" , pr , \"Time between restart writes (0 = none)\" , units = \"s\" )) pl => cfg % async_output call g % add ( nml_logical ( \"async_output\" , pl , \"Async ring-buffered output (CUDA Fortran)\" )) pi => cfg % async_buffer_slots call g % add ( nml_int ( \"async_buffer_slots\" , pi , \"Async ring-buffer slot count\" , min = 1 )) pl => cfg % compress_output call g % add ( nml_logical ( \"compress_output\" , pl , \"Deflate-compress NetCDF output\" ))