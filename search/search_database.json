dvance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: c_int real(kind=wp), private :: dx real(kind=wp), private :: dy integer, private :: i integer, private :: j integer, private :: k real(kind=wp), private :: max_speed integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: speed_x real(kind=wp), private :: speed_y Source Code subroutine compute_timestep_baroclinic ( h , u_layer , v_layer , dsig , & grid , nz , cfl , dt ) !! Baroclinic timestep from the internal-wave CFL: !! max(|u_layer_k| + c_int)/dx, c_int = sqrt(g*H/nz) (uniform sigma). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: cfl real ( wp ), intent ( out ) :: dt integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: max_speed , c_int , speed_x , speed_y nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy max_speed = 0.0_wp do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( c_int , speed_x , speed_y , k ) & reduce ( max : max_speed ) if ( h ( i , j ) > DRY_TOLERANCE ) then c_int = sqrt ( GRAVITY * h ( i , j ) / real ( nz , wp )) do k = 1 , nz speed_x = ( abs ( u_layer ( i , j , k )) + c_int ) / dx speed_y = ( abs ( v_layer ( i , j , k )) + c_int ) / dy max_speed = max ( max_speed , speed_x , speed_y ) end do end if end do if ( max_speed > 0.0_wp ) then dt = cfl / max_speed else dt = cfl * min ( dx , dy ) / sqrt ( GRAVITY * DRY_TOLERANCE / real ( nz , wp )) end if end subroutine compute_timestep_baroclinic","tags":"","url":"proc/compute_timestep_baroclinic.html"},{"title":"compute_local_froude_impl – Rakali","text":"private pure function compute_local_froude_impl(low_froude_mode, u_left, u_right, v_left, v_right, c_left, c_right) result(fr) Arguments Type Intent Optional Attributes Name integer, intent(in) :: low_froude_mode real(kind=wp), intent(in) :: u_left real(kind=wp), intent(in) :: u_right real(kind=wp), intent(in) :: v_left real(kind=wp), intent(in) :: v_right real(kind=wp), intent(in) :: c_left real(kind=wp), intent(in) :: c_right Return Value real(kind=wp) Called by proc~~compute_local_froude_impl~~CalledByGraph proc~compute_local_froude_impl compute_local_froude_impl proc~cu_flux_pointwise_impl cu_flux_pointwise_impl proc~cu_flux_pointwise_impl->proc~compute_local_froude_impl proc~flux_one_cell flux_one_cell proc~flux_one_cell->proc~cu_flux_pointwise_impl proc~compute_fluxes_central_unstr compute_fluxes_central_unstr proc~compute_fluxes_central_unstr->proc~flux_one_cell proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~compute_fluxes_central_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step->proc~compute_fluxes_central_unstr proc~solver_uns