) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( out ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny nx = grid % nx_total ny = grid % ny_total do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) h_layer ( i , j , k ) = dsig ( k ) * h ( i , j ) hu_layer ( i , j , k ) = dsig ( k ) * hu ( i , j ) hv_layer ( i , j , k ) = dsig ( k ) * hv ( i , j ) end do end subroutine ml_init_layers_from_barotropic","tags":"","url":"proc/ml_init_layers_from_barotropic.html"},{"title":"ml_remap_tracer – Rakali","text":"public  subroutine ml_remap_tracer(hTr, h, remap_method, h_layer, grid, nz) Conservatively remap ONE tracer from the saved pre-update layer\nthicknesses ( remap_dz_old ) onto the current h_layer (new vcoord\ntarget): scale dz_old to sum to H_new, column-mean fallback at\nvanishing layers, conservative remap_column . Looped over the\ntracer registry by the solver. Must run AFTER the dynamics remap\n(which writes remap_dz_old and the new h_layer ). Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) integer, intent(in) :: remap_method real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_remap_tracer~~CallsGraph proc~ml_remap_tracer ml_remap_tracer proc~remap_column remap_column proc~ml_remap_tracer->proc~remap_column proc~remap_column_pcm remap_column_pcm proc~remap_column->proc~remap_column_pcm proc~remap_column_plm remap_column_plm proc~remap_column->proc~remap_column_plm proc~remap_column_ppm remap_column_ppm proc~remap_column->proc~remap_column_ppm proc~remap_column_ppm_h4 remap_column_ppm_h4 proc~remap_column->proc~remap_column_ppm_h4 proc~remap_column_pqm remap_column_pqm proc~remap_column->proc~remap_column_pqm proc~remap_column_ppm->proc~remap_column_plm proc~remap_column_ppm_h4->proc~remap_column_plm proc~remap_column_pqm->proc~remap_column_ppm proc~pqm_end_value_h4 pqm_end_value_h4 proc~remap_column_pqm->proc~pqm_end_value_h4 proc~pqm_solve_diag_dominant pqm_solve_diag_dominant proc~remap_column_pqm->proc~pqm_solve_diag_dominant Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_remap_tracer~~CalledByGraph proc~ml_remap_tracer ml_remap_tracer proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~ml_remap_tracer proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_multilayer_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dz_new_col (NZ_STACK_MAX) real(kind=wp), private :: dz_old_col (NZ_STACK_MAX) real(kind=wp), private :: h_old_total real(kind=wp), private :: h_val integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: scale_old real(kind=wp), private :: tr_col_mean real(kind=wp), private :: tr_col_sum real(kind=wp), private :: tr_new (NZ_STACK_MAX) real(kind=wp), private :: tr_old (NZ_STACK_MAX) Source Code subroutine ml_remap_tracer ( hTr , h , remap_method , h_layer , grid , nz ) !! Conservatively remap ONE tracer from the saved pre-update layer !! thicknesses (`remap_dz_old`) onto the current `h_layer` (new vcoord !! target): scale dz_old to sum to H_new, column-mean fallback at !! vanishing layers, conservative `remap_column`. Looped over the !! tracer registry by the solver. Must run AFTER the dynamics remap !! (which writes `remap_dz_old` and the new `h_layer`). type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: hTr ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) integer , intent ( in ) :: remap_method real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: h_val , h_old_total , scale_old , tr_col_sum , tr_col_mean real ( wp ) :: dz_old_col ( NZ_STACK_MAX ), dz_new_col ( NZ_STACK_MAX ) real ( wp ) :: tr_old ( NZ_STACK_MAX ), tr_new ( NZ_STACK_MAX ) nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost !$acc parallel loop collapse(2) & !$acc&   present(hTr, h, h_layer, remap_dz_old) & !$acc&   private(k, h_val, h_old_total, scale_old, tr_col_sum, & !$acc&           tr_col_mean, dz_old_col, dz_new_col, tr_old, tr_new) do j = nghost + 1 , ny - nghost do i = nghost + 1 , nx - nghost h_val = h ( i , j ) ! Scale dz_old uniformly to H_new so remap_column's ! `sum dz_old == sum dz_new` conservation guarantee holds. h_old_total = 0.0_wp do k = 1 , nz h_old_total = h_old_total + remap_dz_old ( i , j , k ) end do if ( h_old_total > DRY_TOLERANCE ) then scale_old = h_val / h_old_total else scale_old = 1.0_wp end if ! Column-mean concentration as the vanishing-layer fallback ! (falling back to 0 leaks tracer through PPM over pinch cycles). tr_col_sum = 0.0_wp do k = 1 , nz tr_col_sum = tr_col_sum + hTr ( i , j , k ) end do if ( h_val > DRY_TOLERANCE ) then tr_col_mean = tr_col_sum / h_val else tr_col_mean = 0.0_wp end if do k = 1 , nz dz_old_col ( k ) = remap_dz_old ( i , j , k ) * scale_old dz_new_col ( k ) = h_layer ( i , j , k ) if ( dz_old_col ( k ) > DRY_TOLERANCE ) then tr_old ( k ) = hTr ( i , j , k ) / dz_old_col ( k ) else tr_old ( k ) = tr_col_mean end if end do call remap_column ( remap_method , nz , dz_old_col , dz_new_col , tr_old , tr_new ) do k = 1 , nz hTr ( i , j , k ) = dz_new_col ( k ) * tr_new ( k ) end do end do end do end subroutine ml_remap_tracer","tags":"","url":"proc/ml_remap_tracer.html"},{"title":"ml_rk2_average_layers – Rakali","text":"public pure subroutine ml_rk2_average_layers(h_layer, hu_layer, hv_layer, h_layer0, hu_layer0, hv_layer0, grid, nz) SSP-RK2 averaging: U&#94;{n+1} = 0.5 (U&#94;n + U *) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: h_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer0 (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny Source Code pure subroutine ml_rk2_average_layers ( h_layer , hu_layer , hv_layer , & h_layer0 , hu_layer0 , hv_layer0 , & grid , nz ) !! SSP-RK2 averaging: U&#94;{n+1} = 0.5*(U&#94;n + U**) type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( inout ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( inout ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: h_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer0 ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer0 ( grid % nx_total , grid % ny_total , nz ) integer :: i , j , k , nx , ny , nghost nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost do concurrent ( k = 1 : nz , j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) h_layer ( i , j , k ) = 0.5_wp * ( h_layer0 ( i , j , k ) + h_layer ( i , j , k )) hu_layer ( i , j , k ) = 0.5_wp * ( hu_layer0 ( i , j , k ) + hu_layer ( i , j , k )) hv_layer ( i , j , k ) = 0.5_wp * ( hv_layer0 ( i , j , k ) + hv_layer ( i , j , k )) if ( h_layer ( i , j , k ) < 0.0_wp ) then h_layer ( i , j , k ) = 0.0_wp hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp else if ( h_layer ( i , j , k ) < THIN_LAYER_THRESHOLD ) then hu_layer ( i , j , k ) = 0.0_wp hv_layer ( i , j , k ) = 0.0_wp end if end do end subroutine ml_rk2_average_layers","tags":"","url":"proc/ml_rk2_average_layers.html"},{"title":"ml_save_layer_stat