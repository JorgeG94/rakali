 the !! unstructured semi-implicit solver. module rki_si_common !! Sub-bottom fill modes for the Casulli wet/dry subgrid volume !! (`&si_nml wetdry_bsub_fill`), their parser, and the conservation !! conflict predicate used by the state-enable guards. use pic_logger , only : global_logger implicit none private public :: parse_si_bsub_fill public :: si_bsub_ml_conflict public :: SI_BSUB_FILL_FLAT , SI_BSUB_FILL_LINEAR integer , parameter :: SI_BSUB_FILL_FLAT = 0 !! Sub-bottom fill: all sub-bottoms = the plain bed `b` (bit-identical !! to n_sub=1 regardless of n_sub).  The default. integer , parameter :: SI_BSUB_FILL_LINEAR = 1 !! Sub-bottom fill: an analytic per-cell linear sub-cell bed ramp !! across `[b-half, b+half]`, `half = 0.5*max` neighbour bed diff. contains function parse_si_bsub_fill ( tag ) result ( mode ) !! Map the `&si_nml wetdry_bsub_fill` string to its `SI_BSUB_FILL_*` !! enum.  Fail-loud allowlist (shared by both backends). character ( len =* ), intent ( in ) :: tag integer :: mode select case ( trim ( adjustl ( tag ))) case ( \"flat\" , \"FLAT\" , \"\" ) mode = SI_BSUB_FILL_FLAT case ( \"linear\" , \"LINEAR\" ) mode = SI_BSUB_FILL_LINEAR case default call global_logger % error ( \"si_wetdry_bsub_fill: unknown fill mode '\" // & trim ( adjustl ( tag )) // \"' (allowed: flat, linear)\" ) error stop \"si_wetdry_bsub_fill: unknown fill mode\" end select end function parse_si_bsub_fill pure function si_bsub_ml_conflict ( bsub_fill , n_sub , use_multilayer , nz ) & result ( conflict ) !! The CONSERVATION conflict predicate (shared by both backends' enable !! guards): the `linear` subgrid b_sub fill (n_sub >= 2) is incompatible !! with the multilayer (nz > 1) wet/dry step.  The free-surface solve !! conserves the subgrid wetted volume v_cell(eta) = mean_s !! max(eta - b_sub_s, 0), but the ML thickness update + recovery !! Dirichlet ghost consume max(eta - b, 0) on the PLAIN bed; under !! `linear` these diverge across the partial-flooding band => mass leaks !! at the wet/dry front.  `flat + ML` (b_sub == b, conservative) and !! `linear + 2D` (barotropic uses v_cell throughout) both return !! .false.  A v_cell-consistent ML update is a documented deferred !! limitation; until then callers must reject a .true. combination !! fail-loud.  Pure so tests can assert it directly (the enable path !! error-stops, which cannot be caught in-process). integer , intent ( in ) :: bsub_fill !! `SI_BSUB_FILL_*` fill mode. integer , intent ( in ) :: n_sub !! Subgrid sub-bottoms per cell. logical , intent ( in ) :: use_multilayer !! Multilayer (3D) mode on. integer , intent ( in ) :: nz !! Layer count (only matters together with use_multilayer). logical :: conflict conflict = ( bsub_fill == SI_BSUB_FILL_LINEAR ) . and . ( n_sub >= 2 ) . and . & use_multilayer . and . ( nz > 1 ) end function si_bsub_ml_conflict end module rki_si_common","tags":"","url":"sourcefile/rki_si_common.f90.html"},{"title":"rki_barotropic_state.F90 – Rakali","text":"Barotropic (depth-integrated) solution state for the structured solver. This file depends on sourcefile~~rki_barotropic_state.f90~~EfferentGraph sourcefile~rki_barotropic_state.f90 rki_barotropic_state.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_barotropic_state.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_barotropic_state.f90->sourcefile~rki_grid.f90 sourcefile~rki_mem_report.f90 rki_mem_report.F90 sourcefile~rki_barotropic_state.f90->sourcefile~rki_mem_report.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 sourcefile~rki_mem_report.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_barotropic_state.f90~~AfferentGraph sourcefile~rki_barotropic_state.f90 rki_barotropic_state.F90 sourcefile~rki_multilayer_state.f90 rki_multilayer_state.F90 sourcefile~rki_multilayer_state.f90->sourcefile~rki_barotropic_state.f90 sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_state.f90->sourcefile~rki_barotropic_state.f90 sourcefile~rki_state.f90->sourcefile~rki_multilayer_state.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90 rki_handle.F90 sourcefile~rki_api.f90->sourcefile~rki_handle.f90 sourcefile~rki_init.f90 rki_init.F90 sourcefile~rki_api.f90->sourcefile~rki_init.f90 sourcefile~rki_output.f90 rki_output.F90 sourcefile~rki_api.f90->sourcefile~rki_output.f90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_coastal_console_stats.f90 rki_coastal_console_stats.F90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_init.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_state.f90 sourcefile~rki_driver.f90->sourcefile~rki_coastal_console_stats.f90 sourcefile~rki_forcing.f90 rki_forcing.F90 sourcefile~rki_driver.f90->sourcefile~rki_forcing.f90 sourcefile~rki_gauges.f90 rki_gauges.F90 sourcefile~rki_driver.f90->sourcefile~rki_gauges.f90 sourcefile~rki_driver.f90->sourcefile~rki_init.f90 sourcefile~rki_nesting.f90 rki_nesting.F90 sourcefile~rki_driver.f90->sourcefile~rki_nesting.f90 sourcefile~rki_driver.f90->sourcefile~rki_output.f90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_forcing.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges.f90->sourcefile~rki_state.f90 sourcefile~rki_handle.f90->sourcefile~rki_state.f90 sourcefile~rki_init.f90->sourcefile~rki_state.f90 sourcefile~rki_nesting.f90->sourcefile~rki_state.f90 sourcefile~rki_output.f90->sourcefile~rki_state.f90 sourcefile~rki_solver.f90->sourcefile~rki_state.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Barotropic (depth-integrated) solution state for the structured solver. module rki_barotropic_state !! Depth-integrated conserved variables, bathymetry, flux-divergence !! and per-face mass-flux scratch, RK2 save buffers, and the scalar !! physics params the barotropic kernels read (Manning `n`, Coriolis !! `f`).  Lives at `state%barotropic`; multilayer code reads `h, hu, !! hv` and `mass_flux_x/y` from here (produced by the barotropic step, !! consumed by layer-distribute + CWC tracer advection). use , intrinsic :: iso_fortran_env , only : int64 use rki_constants , only : wp use rki_grid , only : hgrid_t use rki_mem_report , only : arr_bytes implicit none private public :: barotropic_state_t type :: barotropic_state_t !! Depth-integrated conserved variables and the workspace they !! produce / consume each step. ! Conserved variables -- SoA layout: (nx_total, ny_total) real ( wp ), allocatable :: h (:, :) !! Water depth (m) real ( wp ), allocatable :: hu (:, :) !! x-momentum, h * u (m&#94;2/s) real ( wp ), allocatable :: hv (:, :) !! y-momentum, h * v (m&#94;2/s) ! Bathymetry (static after initialisation) real ( wp ), allocatable :: b (:, :) !! Bottom elevation (m, positive up) ! Flux divergence (workspace, recomputed each step) real ( wp ), allocatable :: flux_h (:, :) !! Net flux divergence for h real ( wp ), allocatable :: flux_hu (:, :) !! Net flux divergence for hu real ( wp ), allocatable :: flux_hv (:, :) !! Net flux divergence for hv ! Per-face HLL mass flux (workspace).  mass_flux_x(i, j) is the ! HLL h-flux at the right face of cell (i, j) -- i.e. between ! cells (i, j) and (i+1, j).  mass_flux_y(i, j) is the top-face ! flux between cells (i, j) and (i, j+1).  Reused by the tracer ! advection kernels to enforce consistency-with-continuity (CWC). real ( wp ), allocatable :: mass_flux_x (:, :) real ( wp ), allocatable :: mass_flux_y (:, :) ! RK2 storage (saves U&#94;n for the averaging step) real ( wp ), allocatable :: h0 (:, :) !! Saved h at start of RK step real ( wp ), allocatable :: hu0 (:, :) !! Saved hu at start of RK step real ( wp ), allocatable :: hv0 (:, :) !! Saved hv at start of RK step ! Physics scalars used by the barotropic friction / Coriolis ! kernels.  Multilayer-side per-layer bottom-friction (when ! enabled) reads `manning_n` from here too. real ( wp ) :: manning_n = 0.0_wp !! Manning roughness coefficient (s/m&#94;{1/3}) logical :: use_linear_bottom_drag = . false . !! Use linear (Rayleigh) bottom drag instead of quadratic Manning. real ( wp ) :: bottom_drag_r = 0.0_wp !! Linear bottom-drag rate (1/s); used when use_linear_bottom_drag. logical :: wind_surface_layer = . false . !! Apply wind stress to the top layer (surface-concentrated) instead !! of the depth-uniform barotropic mode.  Multilayer only. real ( wp ) :: coriolis_f = 0.0_wp !! Coriolis parameter f (1/s), typically 2*Omega*sin(lat) ! Conservation-budget accumulators (host scalars; not device-mapped). real ( wp ) :: mass_out = 0.0_wp !! Cumulative net volume that has left the domain through its !! boundaries since t=0 (m³, positive = outflow), accumulated per !! RK stage from the scheme's own flux divergence so the console !! conservation `Error` closes to round-off even with open BCs. !! See `rki_console_stats` / the driver's budget wiring. real ( wp ) :: mass_src = 0.0_wp !! Cumulative volume ADDED to the domain by surface sources since !! t=0 (m³, positive = added), accumulated per RK stage from !! precipitation (`h += dt·P`), the evaporative mass sink !! (`evap_mass_sink=.true.`; negative contribution), and the sponge !! h-relaxation Δh.  Feeds `budget%mass_src` in `rki_console_stats` !! so the residual `(total−ref) + out − src` stays ~round-off on !! forced runs instead of growing monotonically with the forcing. logical :: mass_out_tracked = . false . !! Set `.true.` once the solver has accumulated `mass_out`. !! Covered paths: 2D-barotropic SSP-RK2 fused path + coastal !! multilayer nz>1.  Not set by: nz=1 ML fused fast path (safe !! raw-drift fallback — see solver note), semi-implicit, generic-RK. logical :: mass_src_tracked = . false . !! Set `.true.` once the solver has accumulated `mass_src` for the !! current run.  Same coverage as `mass_out_tracked`: 2D-barotropic !! fused path + coastal multilayer nz>1.  The closed budget !! (`budget%mass_active`) is enabled in the console only when BOTH !! flags are set. ! Scheme flags logical :: use_hllc = . false . !! Use HLLC (with contact wave for transverse momentum) instead !! of HLL for the barotropic Riemann flux.  Structured-only — !! the unstructured solver always uses KNP central-upwind, which !! resolves contact discontinuities natively.  Default `.false.`. contains procedure , non_overridable :: init => barotropic_state_init procedure , non_overridable :: destroy => barotropic_state_destroy procedure , non_overridable :: bytes => barotropic_state_bytes end type barotropic_state_t contains subroutine barotropic_state_init ( this , grid ) !! Allocate all arrays at the grid size, zero-filled.  Scalars !! (`manning_n`, `coriolis_f`) are populated by `state_init_from_config` !! from the namelist after this routine returns. class ( barotropic_state_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid integer :: nx , ny nx = grid % nx_total ny = grid % ny_total allocate ( this % h ( nx , ny ), source = 0.0_wp ) allocate ( this % hu ( nx , ny ), source = 0.0_wp ) allocate ( this % hv ( nx , ny ), source = 0.0_wp ) allocate ( this % b ( nx , ny ), source = 0.0_wp ) allocate ( this % flux_h ( nx , ny ), source = 0.0_wp ) allocate ( this % flux_hu ( nx , ny ), source = 0.0_wp ) allocate ( this % flux_hv ( nx , ny ), source = 0.0_wp ) allocate ( this % mass_flux_x ( nx , ny ), source = 0.0_wp ) allocate ( this % mass_flux_y ( nx , ny ), source = 0.0_wp ) allocate ( this % h0 ( nx , ny ), source = 0.0_wp ) allocate ( this % hu0 ( nx , ny ), source = 0.0_wp ) allocate ( this % hv0 ( nx , ny ), source = 0.0_wp ) end subroutine barotropic_state_init subroutine barotropic_state_destroy ( this ) class ( barotropic_state_t ), intent ( inout ) :: this if ( allocated ( this % h )) deallocate ( this % h ) if ( allocated ( this % hu )) deallocate ( this % hu ) if ( allocated ( this % hv )) deallocate ( this % hv ) if ( allocated ( this % b )) deallocate ( this % b ) if ( allocated ( this % flux_h )) deallocate ( this % flux_h ) if ( allocated ( this % flux_hu )) deallocate ( this % flux_hu ) if ( allocated ( this % flux_hv )) deallocate ( this % flux_hv ) if ( allocated ( this % mass_flux_x )) deallocate ( this % mass_flux_x ) if ( allocated ( this % mass_flux_y )) deallocate ( this % mass_flux_y ) if ( allocated ( this % h0 )) deallocate ( this % h0 ) if ( allocated ( this % hu0 )) deallocate ( this % hu0 ) if ( allocated ( this % hv0 )) deallocate ( this % hv0 ) this % manning_n = 0.0_wp this % use_linear_bottom_drag = . false . this % bottom_drag_r = 0.0_wp this % wind_surface_layer = . false . this % coriolis_f = 0.0_wp end subroutine barotropic_state_destroy pure function barotropic_state_bytes ( this ) result ( nbytes ) !! Counted allocatable footprint of the barotropic slot (0 for any !! unallocated array).  One `arr_bytes` term per allocatable — add a !! term here whenever a new array joins the type. class ( barotropic_state_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = arr_bytes ( this % h ) + arr_bytes ( this % hu ) + arr_bytes ( this % hv ) & + arr_bytes ( this % b ) + arr_bytes ( this % flux_h ) + arr_bytes ( this % flux_hu ) & + arr_bytes ( this % flux_hv ) + arr_bytes ( this % mass_flux_x ) & + arr_bytes ( this % mass_flux_y ) + arr_bytes ( this % h0 ) & + arr_bytes ( this % hu0 ) + arr_bytes ( this % hv0 ) end function barotropic_state_bytes end module rki_barotropic_state","tags":"","url":"sourcefile/rki_barotropic_state.f90.html"},{"title":"rki_si_unstr_step.F90 – Rakali","text":"Semi-implicit free-surface time step (unstructured 2D barotropic). This file depends on sourcefile~~rki_si_unstr_step.f90~~EfferentGraph sourcefile~rki_si_unstr_step.f90 rki_si_unstr_step.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_unstr_helmholtz.f90 rki_si_unstr_helmholtz.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_helmholtz.f90 sourcefile~rki_si_unstr_mg.f90 rki_si_unstr_mg.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_state.f90 rki_si_unstr_state.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_si_unstr_wetdry.f90 rki_si_unstr_wetdry.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_wetdry.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_boundary_unstr.f90 rki_boundary_unstr.F90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_unstr_state.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_state.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_unstr_state.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_constants.f90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_si_common.f90 rki_si_common.F90 sourcefile~rki_si_unstr_wetdry.f90->sourcefile~rki_si_common.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_barotropic_state_unstr.f90 rki_barotropic_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_barotropic_state_unstr.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_multilayer_state_unstr.f90 rki_multilayer_state_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_multilayer_state_unstr.f90 sourcefile~rki_state_unstr.f90->sourcefile~rki_si_common.f90 sourcefile~rki_surface_forcing_unstr.f90 rki_surface_forcing_unstr.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_surface_forcing_unstr.f90 sourcefile~rki_timestepper.f90 rki_timestepper.F90 sourcefile~rki_state_unstr.f90->sourcefile~rki_timestepper.f90 sourcefile~rki_barotropic_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_barotropic_state_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_eos.f90 rki_eos.F90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_eos.f90 sourcefile~rki_tracer_unstr.f90 rki_tracer_unstr.F90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_tracer_unstr.f90 sourcefile~rki_vcoord.f90 rki_vcoord.F90 sourcefile~rki_multilayer_state_unstr.f90->sourcefile~rki_vcoord.f90 sourcefile~rki_surface_forcing_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_surface_forcing_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_timestepper.f90->sourcefile~rki_constants.f90 sourcefile~rki_eos.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90 rki_grid.F90 sourcefile~rki_eos.f90->sourcefile~rki_grid.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_tracer_unstr.f90->sourcefile~rki_boundary_unstr.f90 sourcefile~rki_vcoord.f90->sourcefile~rki_constants.f90 sourcefile~rki_grid.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_si_unstr_step.f90~~AfferentGraph sourcefile~rki_si_unstr_step.f90 rki_si_unstr_step.F90 sourcefile~rki_si_unstr_step_ml.f90 rki_si_unstr_step_ml.F90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_step.f90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step.f90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step_ml.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Semi-implicit free-surface time step (unstructured 2D barotropic). module rki_si_unstr_step !! One semi-implicit (Casulli) step for the 2D barotropic free surface on !! the UNSTRUCTURED (triangular) backend — the TPFA / edge-transport !! scheme.  INTERNALLY STAGGERED: the predictor / back-sub !! transports live on EDGES (per-cell double-visit `u_edge(3,ncell)`, !! transport along each edge's outward normal), matching Casulli's !! staggered scheme, so the eta update is an exact edge-flux !! finite-volume continuity step (mass conserved to CG tolerance + !! round-off).  eta lives at the triangle CIRCUMCENTRE.  The step: !! !!   1. save U&#94;n (u_edge -> u_n_edge) and form eta&#94;n = stage_cv at !!      circumcentres (stage = h + b already; eta == stage); !!   2. build per-edge frozen effective depths Hf (wall edges 0, Dirichlet !!      edges real) + the per-edge Dirichlet ghost eta; !!   3. EDGE predictor U*_e = U&#94;n_e - g(1-theta)*dt*edge_flux(Hf,eta&#94;n) !!      + wind, gated on Hf>0 (dead edges => exactly 0); !!   4. theta-blend RHS from the edge transports (+ Dirichlet ghost fold); !!   5. area-weighted CG solve of the SPD TPFA Helmholtz for eta&#94;{n+1} !!      (warm-started from eta&#94;n; the load-bearing area weight); !!   6. EDGE back-substitution U&#94;{n+1}_e = U*_e - g*theta*dt*edge_flux(Hf, !!      eta&#94;{n+1}) — the identical frozen Hf the operator used, so the !!      edge transports satisfy discrete continuity EXACTLY; !!   7. reconstruct the A-grid cell momenta (Green-Gauss from the edge !!      normals) for the KNP seam + recover h&#94;{n+1} = eta&#94;{n+1} - b. !! !! Single-rank, owned-cell loops (no per-CG-iteration halo).  The step !! ends with barotropic stage_cv/xmom_cv/ymom_cv/height_cv valid, so BCs, !! diagnostics, output, gauges work unchanged. use rki_constants , only : wp , GRAVITY , RHO_WATER use rki_mesh_unstr , only : mesh_unstr_t use rki_state_unstr , only : unstr_state_t use rki_si_unstr_helmholtz , only : si_unstr_edge_flux , si_unstr_face_depths , & si_unstr_compute_rhs , si_unstr_cg_solve , & si_unstr_apply_helmholtz use rki_si_unstr_mg , only : agglom_hierarchy_unstr_t , & agglom_hierarchy_unstr_refresh use rki_si_unstr_state , only : SI_PRECOND_MG use rki_si_unstr_wetdry , only : si_unstr_wetdry_fill_bsub , & si_unstr_wetdry_volume , & si_unstr_wetdry_wetfrac , & si_unstr_wetdry_mass_diag , & si_unstr_wetdry_face_depths , & si_unstr_wetdry_newton_residual , & si_unstr_wetdry_wetcount use pic_logger , only : global_logger implicit none private public :: si_unstr_step public :: si_unstr_reconstruct_cell_momenta public :: SI_UNSTR_THETA public :: SI_UNSTR_NEWTON_MAX , SI_UNSTR_NEWTON_TOL integer , parameter :: EDGES_PER_TRI = 3 !! Triangles only. real ( wp ), parameter :: SI_UNSTR_THETA = 0.6_wp !! Implicitness parameter.  theta >= 0.5 => unconditionally stable for !! the gravity wave; theta > 0.5 adds damping ~(theta-0.5). real ( wp ), parameter :: DELTA_EPS = 1.0e-30_wp !! 1/0 armour on the circumcentre-line distance. integer , parameter :: SI_UNSTR_NEWTON_MAX = 10 !! Cap on the wet/dry Newton outer iterations per step (prototype !! measured 1-3 outer/step on triangles, max 5; fail-loud ceiling). real ( wp ), parameter :: SI_UNSTR_NEWTON_TOL = 1.0e-11_wp !! Newton convergence tolerance on the relative nonlinear residual, !! combined with a frozen wet active set (matches structured). contains subroutine si_unstr_step ( state , mesh , dt , iter_out ) !! Advance the 2D barotropic free surface one semi-implicit step on the !! triangulation.  Reads the frozen Hf / ghost from the current !! surface, solves the Helmholtz eta-system, and back-substitutes the !! edge transports.  `iter_out` returns the CG iteration count (summed !! over the Newton outers in wet/dry mode). type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer , intent ( out ) :: iter_out integer :: nct , nco , n_bc real ( wp ) :: theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt integer :: cg_it real ( wp ) :: mass_res nct = state % ncells_total nco = state % ncells_owned n_bc = size ( state % bc_type ) theta = SI_UNSTR_THETA g_theta2_dt2 = GRAVITY * theta * theta * dt * dt gtheta_dt = GRAVITY * theta * dt g_omtheta_dt = GRAVITY * ( 1.0_wp - theta ) * dt if ( state % si % wetdry ) then call si_unstr_advance_wetdry ( state , mesh , nct , nco , n_bc , dt , theta , & g_theta2_dt2 , gtheta_dt , g_omtheta_dt , & cg_it ) mass_res = state % si % mass_res else call si_unstr_advance ( mesh , nct , nco , n_bc , & state % barotropic % stage_cv , state % barotropic % xmom_cv , & state % barotropic % ymom_cv , state % barotropic % bed_cv , & state % barotropic % height_cv , & state % si % eta , state % si % eta_r , state % si % eta_p , & state % si % eta_Ap , state % si % eta_z , state % si % eta_diag , & state % si % u_edge , state % si % u_star , state % si % Hf_edge , & state % si % eta_ghost_edge , state % si % u_n_edge , & state % bc_type , state % bc_eta_ext , & state % barotropic % wind_tau_x , state % barotropic % wind_tau_y , & dt , theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt , & state % si % precond , state % si % rtol , cg_it , mass_res , & mg = state % si % mg ) state % si % mass_res = mass_res end if state % si % cg_iters = cg_it state % time = state % time + dt state % step_count = state % step_count + 1 state % dt = dt iter_out = cg_it end subroutine si_unstr_step subroutine si_unstr_advance ( mesh , nct , nco , n_bc , stage , xmom , ymom , bed , & height , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , u_edge , u_star , Hf_edge , & eta_ghost_edge , u_n_edge , bc_type , & bc_eta_ext , wind_tau_x , wind_tau_y , & dt , theta , g_theta2_dt2 , gtheta_dt , & g_omtheta_dt , precond , rtol , iter_out , & mass_res_out , mg ) !! Flat-impl core: explicit-shape state arrays only (NVHPC device !! codegen — assumed-shape dummies in do-concurrent kernels emit !! per-launch descriptor-walk memcpys).  The edge workspaces !! `eta_ghost_edge` / `u_n_edge` are persistent slots on the SI state !! (mapped in its enter_data — no per-step allocation). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct !! Cell array extent (ncells_total) — the explicit-shape dim. integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size (`MAX_BC_GROUPS`). real ( wp ), intent ( inout ) :: stage ( nct ), xmom ( nct ), ymom ( nct ), height ( nct ) real ( wp ), intent ( in ) :: bed ( nct ) real ( wp ), intent ( inout ) :: eta ( nct ), eta_r ( nct ), eta_p ( nct ), eta_Ap ( nct ) real ( wp ), intent ( inout ) :: eta_z ( nct ), eta_diag ( nct ) real ( wp ), intent ( inout ) :: u_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: u_star ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: u_n_edge ( EDGES_PER_TRI , nct ) integer , intent ( in ) :: bc_type ( n_bc ) real ( wp ), intent ( in ) :: bc_eta_ext ( n_bc ) real ( wp ), intent ( in ) :: wind_tau_x , wind_tau_y integer , intent ( in ) :: precond real ( wp ), intent ( in ) :: dt , theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt , rtol integer , intent ( out ) :: iter_out real ( wp ), intent ( out ) :: mass_res_out type ( agglom_hierarchy_unstr_t ), intent ( inout ), optional :: mg !! Aggregation-MG hierarchy (present iff precond == MG); its operator !! is refreshed here for this step's frozen Hf before the solve. integer :: k , i , kn real ( wp ) :: inv_delta , dgdn , un_e , tau_n ! ---- 1. Save U&#94;n; refresh height h = max(stage - b, 0); eta&#94;n = stage !         at circumcentres (stage = h + b already, so eta == stage) ---- do concurrent ( k = 1 : nco ) do i = 1 , EDGES_PER_TRI u_n_edge ( i , k ) = u_edge ( i , k ) end do height ( k ) = max ( stage ( k ) - bed ( k ), 0.0_wp ) eta ( k ) = stage ( k ) end do ! ---- 2. Frozen Hf + per-edge Dirichlet ghost eta ---- call si_unstr_face_depths ( mesh , nct , nco , n_bc , height , bed , bc_type , & bc_eta_ext , Hf_edge , eta_ghost_edge ) ! ---- 2b. Refresh the aggregation-MG operator for this step's frozen Hf !          (host build from the live Hf; structures static).  Once per !          step, NOT per V-cycle. ---- if ( precond == SI_PRECOND_MG . and . present ( mg )) then !$acc update self(Hf_edge) call agglom_hierarchy_unstr_refresh ( mg , mesh , nco , g_theta2_dt2 , & Hf_edge (:, 1 : nco )) end if ! ---- 3. EDGE predictor U*_e (dead edges => 0) + wind ---- ! U&#94;n_e = the saved edge transport; the wind stress projects onto the ! outward edge-normal.  Wall edges (Hf=0) stay exactly 0. do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn , un_e , tau_n ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), eta ( kn ), inv_delta ) else ! Dirichlet edge: gradient against the seeded ghost surface. dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), & eta_ghost_edge ( i , k ), inv_delta ) end if un_e = u_n_edge ( i , k ) ! Wind stress projected onto the outward edge-normal (Pa/rho). tau_n = ( wind_tau_x * mesh % edge_n1 ( i , k ) & + wind_tau_y * mesh % edge_n2 ( i , k )) / RHO_WATER u_star ( i , k ) = un_e - g_omtheta_dt * dgdn + dt * tau_n else u_star ( i , k ) = 0.0_wp u_n_edge ( i , k ) = 0.0_wp ! R3: dead edge carries no U&#94;n flux end if end do end do ! ---- 4. theta-blend RHS (+ Dirichlet ghost fold) ---- call si_unstr_compute_rhs ( mesh , nct , nco , eta , u_star , u_n_edge , eta_r , & dt , theta , Hf_edge , eta_ghost_edge , g_theta2_dt2 ) ! ---- 5. area-weighted CG solve for eta&#94;{n+1} (warm start eta&#94;n) ---- if ( present ( mg )) then call si_unstr_cg_solve ( mesh , nct , nco , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , Hf_edge , g_theta2_dt2 , precond , rtol , & iter_out , mass_res_out , mg = mg ) else call si_unstr_cg_solve ( mesh , nct , nco , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , Hf_edge , g_theta2_dt2 , precond , rtol , & iter_out , mass_res_out ) end if ! ---- 6. EDGE back-substitution with the SAME frozen Hf ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), & eta_ghost_edge ( i , k ), inv_delta ) end if u_edge ( i , k ) = u_star ( i , k ) - gtheta_dt * dgdn else u_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 7. Reconstruct A-grid cell momenta + recover h&#94;{n+1} ---- call si_unstr_reconstruct_cell_momenta ( mesh , nct , nco , u_edge , xmom , ymom ) do concurrent ( k = 1 : nco ) stage ( k ) = eta ( k ) height ( k ) = max ( eta ( k ) - bed ( k ), 0.0_wp ) end do end subroutine si_unstr_advance subroutine si_unstr_advance_wetdry ( state , mesh , nct , nco , n_bc , dt , theta , & g_theta2_dt2 , gtheta_dt , g_omtheta_dt , & iter_out ) !! One Casulli wetting/drying SI step on the triangulation — the !! Newton wrapper around the area-weighted TPFA CG (the structured !! `si_advance_wetdry`, edge-wise; V/a/Newton per-cell, prototype- !! confirmed mesh-agnostic).  The nonlinear system is !!   F(eta) = v(eta) + T*eta - rhs_d = 0,  J = diag(a+floor) + T !! with T the SAME frozen-Hf stiffness the linear code has (gated-mean !! edge depths — all-wet reduces exactly to the linear edge depth) and !! the constant mass `1` replaced per cell by the wet fraction a. !! V convex => plain Newton converges monotonically (no line search). !! !! The FROZEN-Hf step (rules R1-R5): !!   0. fill b_sub/b_min from bed; save U&#94;n; eta&#94;n = stage; !!   1. freeze Hf by the gated-mean/sill rule (+ Dirichlet ghost); !!   2. edge predictor U* (dead edges => exactly 0; U&#94;n zeroed on dead !!      edges — R3 is STRUCTURAL here: the RHS consumes per-edge !!      transports directly, so no reconstruction masking is needed); !!   3. rhs_d = v(eta&#94;n) - dt*div[theta*U* + (1-theta)*U&#94;n] (+ ghost); !!   4. Newton: a,v,F at eta&#94;k; converged (frozen active set + small !!      residual)? else CG-solve J*dz = -F from zero, eta += dz !!      (dry cells settle below bed — never clamped); !!   5. back-sub with the SAME frozen Hf (R2); !!   6. stage = eta; h = max(eta - b, 0); cell momenta. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct , nco , n_bc real ( wp ), intent ( in ) :: dt , theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt integer , intent ( out ) :: iter_out !! Inner CG iterations summed over the Newton outers. integer :: k , i , kn , nit , cg_it , cg_it_total , wetcount , wetcount_prev real ( wp ) :: inv_delta , dgdn , tau_n real ( wp ) :: rhs2 , f2 , tol2 , mass_res logical :: converged associate ( si => state % si , baro => state % barotropic ) ! ---- 0. Sub-bottom table; save U&#94;n; eta&#94;n = stage; height ---- call si_unstr_wetdry_fill_bsub ( mesh , si % n_sub , nct , nco , baro % bed_cv , & si % bsub_fill , si % b_sub , si % b_min ) do concurrent ( k = 1 : nco ) local ( i ) do i = 1 , EDGES_PER_TRI si % u_n_edge ( i , k ) = si % u_edge ( i , k ) end do baro % height_cv ( k ) = max ( baro % stage_cv ( k ) - baro % bed_cv ( k ), 0.0_wp ) si % eta ( k ) = baro % stage_cv ( k ) end do ! ---- 1. Freeze Hf (gated-mean/sill rule) + Dirichlet ghost ---- call si_unstr_wetdry_face_depths ( mesh , nct , nco , n_bc , si % eta , & si % b_min , state % bc_type , & state % bc_eta_ext , si % Hf_edge , & si % eta_ghost_edge ) ! ---- 2. EDGE predictor (dead edges => exactly 0) + wind (R3) ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn , tau_n ) do i = 1 , EDGES_PER_TRI if ( si % Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta_ghost_edge ( i , k ), inv_delta ) end if tau_n = ( baro % wind_tau_x * mesh % edge_n1 ( i , k ) & + baro % wind_tau_y * mesh % edge_n2 ( i , k )) / RHO_WATER si % u_star ( i , k ) = si % u_n_edge ( i , k ) - g_omtheta_dt * dgdn & + dt * tau_n else si % u_star ( i , k ) = 0.0_wp si % u_n_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 3. rhs_d = v(eta&#94;n) - dt*div[blend] (+ Dirichlet fold) ---- ! Reuse the linear RHS (leading eta&#94;n + ghost fold via the frozen ! Hf) then swap the leading term for v(eta&#94;n). call si_unstr_compute_rhs ( mesh , nct , nco , si % eta , si % u_star , & si % u_n_edge , si % eta_r , dt , theta , & si % Hf_edge , si % eta_ghost_edge , g_theta2_dt2 ) call si_unstr_wetdry_volume ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % v_cell ) do concurrent ( k = 1 : nco ) si % rhs_d ( k ) = si % eta_r ( k ) + ( si % v_cell ( k ) - si % eta ( k )) end do ! ---- 4. Newton outer loop ---- rhs2 = 0.0_wp do concurrent ( k = 1 : nco ) reduce ( + : rhs2 ) rhs2 = rhs2 + si % rhs_d ( k ) * si % rhs_d ( k ) end do tol2 = max ( SI_UNSTR_NEWTON_TOL * SI_UNSTR_NEWTON_TOL * rhs2 , 1.0e-60_wp ) cg_it_total = 0 cg_it = 0 mass_res = 0.0_wp wetcount_prev = - 1 converged = . false . do nit = 1 , SI_UNSTR_NEWTON_MAX call si_unstr_wetdry_wetfrac ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % a_wet ) call si_unstr_wetdry_volume ( si % n_sub , nct , nco , si % eta , si % b_sub , & si % v_cell ) call si_unstr_wetdry_mass_diag ( nct , nco , si % a_wet , si % Hf_edge , & si % mass_diag ) call si_unstr_apply_helmholtz ( mesh , nct , nco , si % eta , si % newton_Jeta , & si % Hf_edge , g_theta2_dt2 , & mass_diag = si % mass_diag ) call si_unstr_wetdry_newton_residual ( nct , nco , si % eta , si % newton_Jeta , & si % mass_diag , si % v_cell , & si % rhs_d , si % newton_F , f2 ) call si_unstr_wetdry_wetcount ( si % n_sub , nct , nco , si % eta , si % b_sub , & wetcount ) if ( nit > 1 . and . wetcount == wetcount_prev . and . f2 < tol2 ) then converged = . true . exit end if wetcount_prev = wetcount ! Solve J*dz = -F from zero (full-array zero so the ghost band ! of the search space stays 0); eta += dz. do concurrent ( k = 1 : nct ) si % newton_dz ( k ) = 0.0_wp end do do concurrent ( k = 1 : nco ) si % eta_r ( k ) = - si % newton_F ( k ) end do call si_unstr_cg_solve ( mesh , nct , nco , si % newton_dz , si % eta_r , & si % eta_p , si % eta_Ap , si % eta_z , si % eta_diag , & si % Hf_edge , g_theta2_dt2 , si % precond , & si % rtol , cg_it , mass_res , & mass_diag = si % mass_diag ) cg_it_total = cg_it_total + cg_it do concurrent ( k = 1 : nco ) si % eta ( k ) = si % eta ( k ) + si % newton_dz ( k ) end do end do si % newton_iters = min ( nit , SI_UNSTR_NEWTON_MAX ) si % mass_res = mass_res if (. not . converged ) then call global_logger % warning ( \"si_unstr_advance_wetdry: Newton did \" // & \"not converge in the iteration cap; last ||F||&#94;2 above tol.\" ) end if ! ---- 5. EDGE back-substitution with the SAME frozen Hf (R2) ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn ) do i = 1 , EDGES_PER_TRI if ( si % Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( si % Hf_edge ( i , k ), si % eta ( k ), & si % eta_ghost_edge ( i , k ), inv_delta ) end if si % u_edge ( i , k ) = si % u_star ( i , k ) - gtheta_dt * dgdn else si % u_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 6. Cell momenta + thickness (dry cells clamp h to 0) ---- call si_unstr_reconstruct_cell_momenta ( mesh , nct , nco , si % u_edge , & baro % xmom_cv , baro % ymom_cv ) do concurrent ( k = 1 : nco ) baro % stage_cv ( k ) = si % eta ( k ) baro % height_cv ( k ) = max ( si % eta ( k ) - baro % bed_cv ( k ), 0.0_wp ) end do end associate iter_out = cg_it_total end subroutine si_unstr_advance_wetdry pure subroutine si_unstr_reconstruct_cell_momenta ( mesh , nct , nco , u_edge , & xmom , ymom ) !! Least-squares reconstruction of the cell-centre transport vector !! (hu, hv) from the three edge-normal transports U_e = (hu,hv)·n_e: !!   M = sum_e len_e * n_e n_e&#94;T,   rhs = sum_e len_e * U_e * n_e, !!   (hu, hv) = M&#94;{-1} rhs. !! Exact for a constant transport field (the three normals span R&#94;2 on !! a non-degenerate triangle => M SPD, invertible).  The KNP seam only !! needs a diagnostic cell momentum; eta/mass already closed on the !! edges.  Shared by the 2D step and (per layer) the ML step. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct !! Cell array extent (ncells_total) — the explicit-shape dim. integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: u_edge ( EDGES_PER_TRI , nct ) !! Edge-normal transports (m&#94;2/s), + along the outward normal. real ( wp ), intent ( out ) :: xmom ( nct ), ymom ( nct ) !! Reconstructed cell transport vector (m&#94;2/s). integer :: k , i real ( wp ) :: m11 , m12 , m22 , rx , ry , det , wlen , enx , eny , ue do concurrent ( k = 1 : nco ) & local ( i , m11 , m12 , m22 , rx , ry , det , wlen , enx , eny , ue ) m11 = 0.0_wp m12 = 0.0_wp m22 = 0.0_wp rx = 0.0_wp ry = 0.0_wp do i = 1 , EDGES_PER_TRI wlen = mesh % edge_len ( i , k ) enx = mesh % edge_n1 ( i , k ) eny = mesh % edge_n2 ( i , k ) ue = u_edge ( i , k ) m11 = m11 + wlen * enx * enx m12 = m12 + wlen * enx * eny m22 = m22 + wlen * eny * eny rx = rx + wlen * ue * enx ry = ry + wlen * ue * eny end do det = m11 * m22 - m12 * m12 ! det ~ 0 only for a degenerate cell (collinear edge normals) — ! excluded by the fail-loud mesh quality gate at enable_si; the ! zero fallback is 1/0 armour for a diagnostic-only quantity ! (mass/eta close on the edges regardless). if ( abs ( det ) > tiny ( 1.0_wp )) then xmom ( k ) = ( m22 * rx - m12 * ry ) / det ymom ( k ) = ( m11 * ry - m12 * rx ) / det else xmom ( k ) = 0.0_wp ymom ( k ) = 0.0_wp end if end do end subroutine si_unstr_reconstruct_cell_momenta end module rki_si_unstr_step","tags":"","url":"sourcefile/rki_si_unstr_step.f90.html"},{"title":"rki_si_unstr_column.F90 – Rakali","text":"Per-column + per-edge-layer kernels for the unstructured 3-D SI step. This file depends on sourcefile~~rki_si_unstr_column.f90~~EfferentGraph sourcefile~rki_si_unstr_column.f90 rki_si_unstr_column.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_si_unstr_column.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_si_unstr_column.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_si_unstr_column.f90~~AfferentGraph sourcefile~rki_si_unstr_column.f90 rki_si_unstr_column.F90 sourcefile~rki_si_unstr_step_ml.f90 rki_si_unstr_step_ml.F90 sourcefile~rki_si_unstr_step_ml.f90->sourcefile~rki_si_unstr_column.f90 sourcefile~rki_solver_unstr.f90 rki_solver_unstr.F90 sourcefile~rki_solver_unstr.f90->sourcefile~rki_si_unstr_step_ml.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_solver_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_solver_unstr.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Per-column + per-edge-layer kernels for the unstructured 3-D SI step. module rki_si_unstr_column !! The SCHISM-inspired (Casulli 1990; Casulli & Cattani 1994; Zhang & !! Baptista 2008) per-column algebra of the 3D semi-implicit multilayer !! step, ported per-cell to the `(nz, ncells)` axis layout (k FIRST, !! cell LAST — the unstructured convention, OPPOSITE of the structured !! `(nx,ny,nz)`), plus the edge-wise recovery / tracer kernels that !! replace the structured face kernels: !! !! 1. `si_unstr_build_nu_interface` — PP81 Richardson interface viscosity. !! 2. `si_unstr_column_solve` — plain-u&#94;n predictor responses G_k/R_k !!    (face/edge-based PGF split: the predictor carries NO surface PGF), !!    Thomas factorisation, three-RHS back-solve, Hhat/Gbar integrals. !!    Bottom drag: Manning quadratic on the bed row (the unstructured !!    barotropic state carries no linear-drag knob — Manning-only, !!    documented deviation from the structured `use_linear_drag` option). !! 3. `si_unstr_fill_predictor_edges` — the theta-blend RHS edge !!    predictor U*_e from the face-averaged Gbar (vector projected on !!    the outward edge-normal) minus the explicit (1-theta) surface PGF. !! 4. `si_unstr_recover_edge_layers` — post-CG per-layer EDGE transport !!    recovery; column sums telescope EXACTLY to the 2D back-substituted !!    edge transport (the mass-consistency invariant).  Dirichlet !!    boundary edges use the structured mouth-consistency seeds inline: !!    ghost G = 0, ghost R = -1, ghost h_k = dsig_k*max(eta_bc - b_c, 0). !! 5. `si_unstr_fill_mass_flux_edges` — the blended column edge flux the !!    eta update used (drives the dsig tracer split + next step's U&#94;n). !! 6. `si_unstr_advect_tracer_dsig` — depth-proportional, race-free, !!    first-order-upwind tracer advection: per-layer edge flux EXACTLY !!    `dsig_k * mass_flux_e` (the only split consistent with the !!    dsig-slaved thickness update => uniform tracers invariant per !!    layer); upwind values read from the PRE-STEP snapshot only. !!    FLAT-IMPL: called per registry tracer through the outer shim in !!    the step module (the array-of-derived-types device rule). !! 7. `si_unstr_edge_layers_to_cells` — per-layer least-squares A-grid !!    cell-momentum reconstruction (the 2D reconstruction, per layer). !! 8. `si_unstr_update_thickness_ml` — h&#94;{n+1} = eta&#94;{n+1} - b and the !!    sigma slaving h_k = dsig_k*h. !! 9. `si_unstr_apply_wind_top_layer` — dt*tau/rho on the surface layer !!    (k = nz) transport; the uniform-scalar unstructured wind. !! !! Layer convention (load-bearing): BOTTOM-UP — k=1 bed, k=nz surface. !! Cell-centric double-visit throughout (each cell owns its 3 edge !! values; interior edges computed twice, bit-exactly antisymmetric — !! no scatter, no atomics).  Explicit-shape dummies in every DC kernel !! (NVHPC descriptor-walk rule); fixed-size local columns `NZ_STACK_MAX`. #ifdef LFORTRAN_PASSING use rki_constants , only : wp , GRAVITY , H_VANISHED , DRY_TOLERANCE , & RHO_WATER #else use rki_constants , only : NZ_STACK_MAX , wp , GRAVITY , H_VANISHED , DRY_TOLERANCE , & RHO_WATER #endif use rki_mesh_unstr , only : mesh_unstr_t implicit none private #ifdef LFORTRAN_PASSING integer , parameter :: NZ_STACK_MAX = 64 !! LFortran 0.64 workaround: module-local copy of the rki_constants value !! (an imported parameter used as an explicit-shape dummy bound inside a !! PURE call becomes an impure getter under LFortran). Keep in sync (=64). #endif public :: si_unstr_build_nu_interface public :: si_unstr_column_solve public :: si_unstr_fill_predictor_edges public :: si_unstr_recover_edge_layers public :: si_unstr_fill_mass_flux_edges public :: si_unstr_advect_tracer_dsig public :: si_unstr_edge_layers_to_cells public :: si_unstr_update_thickness_ml public :: si_unstr_apply_wind_top_layer integer , parameter :: EDGES_PER_TRI = 3 !! Triangles only. real ( wp ), parameter :: DELTA_EPS = 1.0e-30_wp !! 1/0 armour on the circumcentre-line distance (gated mesh => never !! fires). contains pure subroutine si_unstr_build_nu_interface ( nz , nzp1 , nct , nco , h_layer , & hu_layer , hv_layer , rho_layer , & rho_0 , nu_max , nu_bg , ri_alpha , & nu_iface ) !! PP81 Richardson-number interface viscosity, per cell (mirror of the !! structured `si_build_nu_interface`, `(nz, ncells)` order): !!   nu_iface(1, c)      = 0   (bed interface) !!   nu_iface(k+1, c)    = nu between layers k and k+1 !!   nu_iface(nz+1, c)   = 0   (surface interface) !! Ri = g*(drho/rho_0)*h_avg / |du|&#94;2 (floored at 0); !! nu = nu_max/(1 + ri_alpha*Ri)&#94;2 + nu_bg; vanished layers decouple. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (the interface-array leading dim, explicit-shape). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up (k=1 bed). real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! Maximum (convective) eddy viscosity [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_bg !! Background viscosity floor [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! Richardson tuning coefficient (PP81: 5.0). real ( wp ), intent ( out ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s], vdiff convention. integer :: c , k real ( wp ) :: hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , shear2 , ri_num , denom , nu_t do concurrent ( c = 1 : nco ) & local ( k , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , du , dv , drho , & shear2 , ri_num , denom , nu_t ) nu_iface ( 1 , c ) = 0.0_wp nu_iface ( nz + 1 , c ) = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) if ( hk <= H_VANISHED . or . hkp1 <= H_VANISHED ) then nu_iface ( k + 1 , c ) = 0.0_wp else h_avg = 0.5_wp * ( hk + hkp1 ) uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) shear2 = du * du + dv * dv + 1.0e-20_wp ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / shear2 if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom = 1.0_wp + ri_alpha * ri_num nu_t = nu_max / ( denom * denom ) + nu_bg nu_iface ( k + 1 , c ) = nu_t end if end do end do end subroutine si_unstr_build_nu_interface pure subroutine si_unstr_column_solve ( nz , nzp1 , nct , nco , h_layer , hu_layer , & hv_layer , nu_iface , manning_n , dt , & g_col_u , g_col_v , r_col , Hhat_cell , & Gbar_cell_x , Gbar_cell_y ) !! Per-column semi-implicit solve — the structured `si_column_solve` !! ported per-cell (`(nz, ncells)` order).  Predictor: PLAIN old-time !! velocity u&#94;n_k = hu_k/max(h_k, H_VANISHED) — NO surface PGF (the !! edge-based PGF split: by linearity of the tridiagonal, all surface !! PGF applies at edges via the -1 response R_k).  Bottom drag: !! Manning quadratic on the bed row (the unstructured barotropic !! state carries no linear-drag knob): !!   cf = g*n&#94;2 / H_total&#94;{1/3};  lambda = cf*|u_bed| / h_1 !! folded into the bed diagonal as +dt*lambda.  Tridiagonal, Thomas !! factorisation, three back-solves (u&#94;n, v&#94;n, -1), then !!   Gbar = sum_k h_k G_k,  Hhat = -sum_k h_k R_k  (>= 0). !! R_k is axis-independent (u and v share the matrix). integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (the interface-array leading dim, explicit-shape). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s] (predictor tendencies already folded). real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( in ) :: nu_iface ( nzp1 , nct ) !! Interface viscosity [m&#94;2/s] (vdiff convention). real ( wp ), intent ( in ) :: manning_n !! Manning roughness n [s/m&#94;{1/3}]; <= 0 disables bottom drag. real ( wp ), intent ( in ) :: dt !! Time step [s]. real ( wp ), intent ( out ) :: g_col_u ( nz , nct ) !! Column velocity response to u&#94;n (G_k&#94;u) [m/s]. real ( wp ), intent ( out ) :: g_col_v ( nz , nct ) !! Column velocity response to v&#94;n (G_k&#94;v) [m/s]. real ( wp ), intent ( out ) :: r_col ( nz , nct ) !! Column velocity response to -1 (R_k) [m/s] (<= 0). real ( wp ), intent ( out ) :: Hhat_cell ( nct ) !! Effective column depth Hhat = -sum_k h_k R_k [m] (>= 0). real ( wp ), intent ( out ) :: Gbar_cell_x ( nct ) !! Column-integrated predictor transport sum_k h_k G_k&#94;u [m&#94;2/s]. real ( wp ), intent ( out ) :: Gbar_cell_y ( nct ) !! Column-integrated y predictor transport [m&#94;2/s]. integer :: c , k real ( wp ) :: hk_col ( NZ_STACK_MAX ) real ( wp ) :: ak_col ( NZ_STACK_MAX ) real ( wp ) :: bk_col ( NZ_STACK_MAX ) real ( wp ) :: ck_col ( NZ_STACK_MAX ) real ( wp ) :: rhs_u ( NZ_STACK_MAX ) real ( wp ) :: rhs_v ( NZ_STACK_MAX ) real ( wp ) :: rhs_r ( NZ_STACK_MAX ) real ( wp ) :: hc , hm , hp , dz_bot , dz_top real ( wp ) :: alph , beta_k , denom_k real ( wp ) :: lambda_drag , h_total , u_bed , v_bed , cf real ( wp ) :: gx_sum , gy_sum , hhat_sum do concurrent ( c = 1 : nco ) & local ( k , hk_col , ak_col , bk_col , ck_col , rhs_u , rhs_v , rhs_r , & hc , hm , hp , dz_bot , dz_top , alph , beta_k , denom_k , & lambda_drag , h_total , u_bed , v_bed , cf , gx_sum , gy_sum , hhat_sum ) ! ---- Floored thicknesses + plain u&#94;n/v&#94;n predictors (no PGF) ---- do k = 1 , nz hc = max ( h_layer ( k , c ), H_VANISHED ) hk_col ( k ) = hc rhs_u ( k ) = hu_layer ( k , c ) / hc rhs_v ( k ) = hv_layer ( k , c ) / hc rhs_r ( k ) = - 1.0_wp end do ! ---- Manning bottom drag on the bed row ---- lambda_drag = 0.0_wp if ( manning_n > 0.0_wp ) then h_total = 0.0_wp do k = 1 , nz h_total = h_total + hk_col ( k ) end do cf = GRAVITY * manning_n * manning_n / ( h_total ** ( 1.0_wp / 3.0_wp )) u_bed = hu_layer ( 1 , c ) / hk_col ( 1 ) v_bed = hv_layer ( 1 , c ) / hk_col ( 1 ) lambda_drag = cf * sqrt ( u_bed * u_bed + v_bed * v_bed ) / hk_col ( 1 ) end if ! ---- Tridiagonal build (bottom-up; vanished layers decouple) ---- hc = hk_col ( 1 ) if ( nz > 1 ) then hp = hk_col ( 2 ) dz_top = 0.5_wp * ( hc + hp ) alph = dt * nu_iface ( 2 , c ) / ( hc * dz_top ) if ( h_layer ( 1 , c ) <= H_VANISHED . or . h_layer ( 2 , c ) <= H_VANISHED ) then alph = 0.0_wp end if else alph = 0.0_wp end if ak_col ( 1 ) = 0.0_wp ck_col ( 1 ) = - alph bk_col ( 1 ) = 1.0_wp + alph + dt * lambda_drag do k = 2 , nz - 1 hc = hk_col ( k ) hm = hk_col ( k - 1 ) hp = hk_col ( k + 1 ) dz_bot = 0.5_wp * ( hm + hc ) dz_top = 0.5_wp * ( hc + hp ) beta_k = dt * nu_iface ( k , c ) / ( hc * dz_bot ) alph = dt * nu_iface ( k + 1 , c ) / ( hc * dz_top ) if ( h_layer ( k , c ) <= H_VANISHED . or . h_layer ( k - 1 , c ) <= H_VANISHED ) then beta_k = 0.0_wp end if if ( h_layer ( k , c ) <= H_VANISHED . or . h_layer ( k + 1 , c ) <= H_VANISHED ) then alph = 0.0_wp end if ak_col ( k ) = - beta_k ck_col ( k ) = - alph bk_col ( k ) = 1.0_wp + alph + beta_k end do if ( nz > 1 ) then hc = hk_col ( nz ) hm = hk_col ( nz - 1 ) dz_bot = 0.5_wp * ( hm + hc ) beta_k = dt * nu_iface ( nz , c ) / ( hc * dz_bot ) if ( h_layer ( nz , c ) <= H_VANISHED . or . h_layer ( nz - 1 , c ) <= H_VANISHED ) then beta_k = 0.0_wp end if ak_col ( nz ) = - beta_k ck_col ( nz ) = 0.0_wp bk_col ( nz ) = 1.0_wp + beta_k end if ! ---- Thomas factorisation + three-RHS sweep ---- ck_col ( 1 ) = ck_col ( 1 ) / bk_col ( 1 ) do k = 2 , nz denom_k = bk_col ( k ) - ak_col ( k ) * ck_col ( k - 1 ) ck_col ( k ) = ck_col ( k ) / denom_k bk_col ( k ) = denom_k end do rhs_u ( 1 ) = rhs_u ( 1 ) / bk_col ( 1 ) rhs_v ( 1 ) = rhs_v ( 1 ) / bk_col ( 1 ) rhs_r ( 1 ) = rhs_r ( 1 ) / bk_col ( 1 ) do k = 2 , nz rhs_u ( k ) = ( rhs_u ( k ) - ak_col ( k ) * rhs_u ( k - 1 )) / bk_col ( k ) rhs_v ( k ) = ( rhs_v ( k ) - ak_col ( k ) * rhs_v ( k - 1 )) / bk_col ( k ) rhs_r ( k ) = ( rhs_r ( k ) - ak_col ( k ) * rhs_r ( k - 1 )) / bk_col ( k ) end do ! Back-substitution (in place: rhs_* become the solutions x_*). do k = nz - 1 , 1 , - 1 rhs_u ( k ) = rhs_u ( k ) - ck_col ( k ) * rhs_u ( k + 1 ) rhs_v ( k ) = rhs_v ( k ) - ck_col ( k ) * rhs_v ( k + 1 ) rhs_r ( k ) = rhs_r ( k ) - ck_col ( k ) * rhs_r ( k + 1 ) end do ! ---- Cell integrals + store responses ---- ! RAW h_layer in the integrals (NOT the floored hk_col): the floor's ! only job is arming the tridiagonal 1/h — a vanished layer carries ! no transport, so it must contribute 0 to the column conveyance. ! The per-layer recovery telescopes with raw h_k*R_k / h_k*G_k, so ! floored integrals would make the eta-solve's face conveyance ! DISAGREE with the recovered transports by up to nz*H_VANISHED at ! dry/thin columns — measured as a ~1e-3 m/step mass<->tracer ! closure breach at the wet/dry front (water moving without salt, ! ~1.7 PSU freshening over a flood; the Q8 ML+wet/dry lesson). ! For any layer with h > H_VANISHED raw == floored, so columns where ! EVERY layer exceeds H_VANISHED are bit-identical (a genuinely wet ! but sub-H_VANISHED-thin layer is wet yet floored — NOT ! bit-identical). gx_sum = 0.0_wp gy_sum = 0.0_wp hhat_sum = 0.0_wp do k = 1 , nz gx_sum = gx_sum + h_layer ( k , c ) * rhs_u ( k ) gy_sum = gy_sum + h_layer ( k , c ) * rhs_v ( k ) hhat_sum = hhat_sum - h_layer ( k , c ) * rhs_r ( k ) g_col_u ( k , c ) = rhs_u ( k ) g_col_v ( k , c ) = rhs_v ( k ) r_col ( k , c ) = rhs_r ( k ) end do Gbar_cell_x ( c ) = gx_sum Gbar_cell_y ( c ) = gy_sum Hhat_cell ( c ) = hhat_sum end do end subroutine si_unstr_column_solve pure subroutine si_unstr_fill_predictor_edges ( mesh , nz , nct , nco , & Gbar_cell_x , Gbar_cell_y , & hu_layer0 , hv_layer0 , & u_n_edge , eta , Hf_edge , & eta_ghost_edge , u_star , & g_omtheta_dt ) !! EDGE predictor for the theta-blend RHS — ANCHOR + INCREMENT form: !! !!   U*_e = U&#94;n_e + 0.5*((Gbar - X0)_c + (Gbar - X0)_nbr)·n_e !!               - g(1-theta)*dt*Hf*(deta&#94;n/dn) !! !! where U&#94;n_e is the PERSISTED per-edge column transport (the 2D !! prognostic — full edge-local fidelity, no cell round-trip) and !! `Gbar - X0` is the column-integrated IMPLICIT-MIXING + explicit- !! tendency INCREMENT (X0 = sum_k hu0_k, the PRE-tendency saved !! transport), cell-averaged onto the edge.  This differs from the !! structured `si_ml_fill_predictor_faces` (which cell-averages the !! WHOLE Gbar — consistent there because the structured 2D predictor !! also rebuilds faces from cell momenta) precisely so that the !! uniform-density inviscid limit (Gbar == X0) reduces EXACTLY to the !! edge-persistent 2D unstructured predictor — the baroclinic-limit !! gate.  Mixing / drag / wind / BPG enter through the increment with !! the same cell-average quality as the structured path. !! !! GATED on Hf > 0 (dead edges exactly 0; U&#94;n_e already dead-zeroed, !! R3).  Dirichlet boundary edge: ghost increment = 0 (the Dirichlet !! DOF has no solved column response and no saved momentum) and the !! eta gradient reads the seeded ghost surface. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: Gbar_cell_x ( nct ), Gbar_cell_y ( nct ) real ( wp ), intent ( in ) :: hu_layer0 ( nz , nct ), hv_layer0 ( nz , nct ) !! PRE-tendency saved layer transports (the X0 columns). real ( wp ), intent ( in ) :: u_n_edge ( EDGES_PER_TRI , nct ) !! Persisted U&#94;n edge transports (dead edges zeroed). real ( wp ), intent ( in ) :: eta ( nct ) !! eta&#94;n at circumcentres. real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( in ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( out ) :: u_star ( EDGES_PER_TRI , nct ) real ( wp ), intent ( in ) :: g_omtheta_dt !! g*(1-theta)*dt. integer :: c , i , k , kn real ( wp ) :: inv_delta , dgdn , inc_n , enx , eny real ( wp ) :: x0x_c , x0y_c , x0x_n , x0y_n do concurrent ( c = 1 : nco ) & local ( i , k , kn , inv_delta , dgdn , inc_n , enx , eny , & x0x_c , x0y_c , x0x_n , x0y_n ) ! Own-cell pre-tendency column transport X0 (hoisted out of edges). x0x_c = 0.0_wp x0y_c = 0.0_wp do k = 1 , nz x0x_c = x0x_c + hu_layer0 ( k , c ) x0y_c = x0y_c + hv_layer0 ( k , c ) end do do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , c ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , c ), DELTA_EPS ) enx = mesh % edge_n1 ( i , c ) eny = mesh % edge_n2 ( i , c ) kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then x0x_n = 0.0_wp x0y_n = 0.0_wp do k = 1 , nz x0x_n = x0x_n + hu_layer0 ( k , kn ) x0y_n = x0y_n + hv_layer0 ( k , kn ) end do inc_n = 0.5_wp * ((( Gbar_cell_x ( c ) - x0x_c ) & + ( Gbar_cell_x ( kn ) - x0x_n )) * enx & + (( Gbar_cell_y ( c ) - x0y_c ) & + ( Gbar_cell_y ( kn ) - x0y_n )) * eny ) dgdn = Hf_edge ( i , c ) * ( eta ( kn ) - eta ( c )) * inv_delta else ! Dirichlet edge: ghost increment 0; gradient vs ghost eta. inc_n = 0.5_wp * (( Gbar_cell_x ( c ) - x0x_c ) * enx & + ( Gbar_cell_y ( c ) - x0y_c ) * eny ) dgdn = Hf_edge ( i , c ) * ( eta_ghost_edge ( i , c ) - eta ( c )) * inv_delta end if u_star ( i , c ) = u_n_edge ( i , c ) + inc_n - g_omtheta_dt * dgdn else u_star ( i , c ) = 0.0_wp end if end do end do end subroutine si_unstr_fill_predictor_edges pure subroutine si_unstr_recover_edge_layers ( mesh , nz , nct , nco , h_layer , & hu_layer0 , hv_layer0 , dsig , & bed , g_col_u , g_col_v , & r_col , eta_n , eta_np1 , Hf_edge , & eta_ghost_edge , dt , theta , & u_edge_layer ) !! Recover the per-layer EDGE transports after the eta solve — the !! structured `si_recover_face_transports` in the ANCHOR + INCREMENT !! form matching `si_unstr_fill_predictor_edges`.  Per edge i of cell !! c (gated Hf > 0; dead edges stay exactly 0) and layer k: !! !!   anchor_k = u_edge_layer(k,i,c)                (the PERSISTED !!              per-layer edge transport — read before overwrite; !!              own-entry read/write only, race-free) !!   inc_k = 0.5*((h_k*G_k - hu0_k)_c·n_e + (h_k*G_k - hu0_k)_nbr·n_e) !!   hhf_k = 0.5*(h_k(c)*R_k(c) + h_k(nbr)*R_k(nbr))          (<= 0) !!   grad_blend = ((1-theta)*deta&#94;n + theta*deta&#94;{n+1})/delta_e !!   u_edge_layer(k,i,c) = anchor_k + inc_k + g*dt*grad_blend*hhf_k !! !! MASS-CONSISTENCY INVARIANT: sum_k anchor_k = U&#94;n_e (the persisted !! column total), sum_k inc_k = the predictor's increment, and !! sum_k hhf_k = -Hf, so the column sum telescopes EXACTLY to !! U*_e - g*theta*dt*Hf*grad(eta&#94;{n+1}) — the 2D back-substitution. !! In the uniform-density inviscid limit inc_k = 0 and !! hhf_k = -dsig_k*Hf, so every layer is EXACTLY dsig_k times the 2D !! edge update (the baroclinic-limit gate); sheared columns keep !! their per-layer structure in the anchor (no cell-average !! flattening — the reason for this form over the structured pure !! cell-average, whose 2D twin averages cells too).  `h_layer` MUST !! be the SAME time-n field that fed the tridiagonal. !! !! DIRICHLET boundary edge (the structured estuary-mouth lesson, !! applied inline): the ghost is a Dirichlet DOF with NO solved !! column response and no saved momentum, so ghost increment = 0, !! ghost R = -1 exactly, and the ghost per-layer thickness is the !! sigma split of the prescribed column h_ghost = max(eta_bc - b_c, !! 0): h_k_ghost = dsig_k*h_ghost.  Then sum_k hhf = -0.5*(Hhat_c + !! h_ghost) = -Hf exactly — the recovered open-edge transport matches !! the Helmholtz flux, so continuity and tracers share the mouth flux !! and uniform tracers stay invariant (the freshening-defect guard). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m] at time n (the tridiagonal's field). real ( wp ), intent ( in ) :: hu_layer0 ( nz , nct ), hv_layer0 ( nz , nct ) !! PRE-tendency saved layer transports (the increment reference). real ( wp ), intent ( in ) :: dsig ( nz ) !! Sigma layer fractions (sum = 1). real ( wp ), intent ( in ) :: bed ( nct ) !! Bed elevation [m] (the Dirichlet ghost column depth). real ( wp ), intent ( in ) :: g_col_u ( nz , nct ), g_col_v ( nz , nct ) real ( wp ), intent ( in ) :: r_col ( nz , nct ) real ( wp ), intent ( in ) :: eta_n ( nct ) !! Old-time surface eta&#94;n at circumcentres. real ( wp ), intent ( in ) :: eta_np1 ( nct ) !! New-time surface eta&#94;{n+1} (the CG solution). real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( in ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) !! Seeded Dirichlet ghost surface (frozen over the step — used for !! BOTH the eta&#94;n and eta&#94;{n+1} gradients, as on the structured !! path where the ghost persists across the interior-only CG). real ( wp ), intent ( in ) :: dt , theta real ( wp ), intent ( inout ) :: u_edge_layer ( nz , EDGES_PER_TRI , nct ) !! Per-layer edge transports [m&#94;2/s], + outward normal: the !! persisted anchor on entry, the recovered U&#94;{n+1} on exit. integer :: c , i , k , kn real ( wp ) :: inv_delta , grad_blend , inc_k , hhf , enx , eny real ( wp ) :: h_ghost , hk_ghost do concurrent ( c = 1 : nco ) & local ( i , k , kn , inv_delta , grad_blend , inc_k , hhf , enx , eny , & h_ghost , hk_ghost ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , c ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , c ), DELTA_EPS ) enx = mesh % edge_n1 ( i , c ) eny = mesh % edge_n2 ( i , c ) kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then grad_blend = (( 1.0_wp - theta ) * ( eta_n ( kn ) - eta_n ( c )) & + theta * ( eta_np1 ( kn ) - eta_np1 ( c ))) * inv_delta do k = 1 , nz inc_k = 0.5_wp * (( h_layer ( k , c ) * g_col_u ( k , c ) - hu_layer0 ( k , c ) & + h_layer ( k , kn ) * g_col_u ( k , kn ) - hu_layer0 ( k , kn )) * enx & + ( h_layer ( k , c ) * g_col_v ( k , c ) - hv_layer0 ( k , c ) & + h_layer ( k , kn ) * g_col_v ( k , kn ) - hv_layer0 ( k , kn )) * eny ) hhf = 0.5_wp * ( h_layer ( k , c ) * r_col ( k , c ) & + h_layer ( k , kn ) * r_col ( k , kn )) u_edge_layer ( k , i , c ) = u_edge_layer ( k , i , c ) + inc_k & + GRAVITY * dt * grad_blend * hhf end do else ! Dirichlet edge: frozen ghost eta for both time levels; ! ghost increment = 0, ghost R = -1, h_k = dsig_k*h_ghost. grad_blend = (( 1.0_wp - theta ) * ( eta_ghost_edge ( i , c ) - eta_n ( c )) & + theta * ( eta_ghost_edge ( i , c ) - eta_np1 ( c ))) * inv_delta h_ghost = max ( eta_ghost_edge ( i , c ) - bed ( c ), 0.0_wp ) do k = 1 , nz hk_ghost = dsig ( k ) * h_ghost inc_k = 0.5_wp * (( h_layer ( k , c ) * g_col_u ( k , c ) - hu_layer0 ( k , c )) * enx & + ( h_layer ( k , c ) * g_col_v ( k , c ) - hv_layer0 ( k , c )) * eny ) hhf = 0.5_wp * ( h_layer ( k , c ) * r_col ( k , c ) & + hk_ghost * ( - 1.0_wp )) u_edge_layer ( k , i , c ) = u_edge_layer ( k , i , c ) + inc_k & + GRAVITY * dt * grad_blend * hhf end do end if else do k = 1 , nz u_edge_layer ( k , i , c ) = 0.0_wp end do end if end do end do end subroutine si_unstr_recover_edge_layers pure subroutine si_unstr_fill_mass_flux_edges ( nz , nct , nco , u_edge_layer , & u_n_edge , Hf_edge , theta , & mass_flux_edge , u_edge ) !! The blended column edge flux the eta update used: !!   F_e = theta*sum_k u_edge_layer_k + (1-theta)*U&#94;n_e !! (gated Hf > 0; dead edges exactly 0) — feeds the dsig tracer split !! so continuity and tracers share edge fluxes exactly.  Also stores !! the NEW column-total edge transport U&#94;{n+1}_e = sum_k u_edge_layer !! into `u_edge` (the 2D prognostic the next step's (1-theta) side !! reads — the telescoped 2D back-substitution). integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: u_edge_layer ( nz , EDGES_PER_TRI , nct ) real ( wp ), intent ( in ) :: u_n_edge ( EDGES_PER_TRI , nct ) !! Saved U&#94;n edge transports (dead edges already zeroed, R3). real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( in ) :: theta real ( wp ), intent ( out ) :: mass_flux_edge ( EDGES_PER_TRI , nct ) !! Blended column edge flux [m&#94;2/s]. real ( wp ), intent ( out ) :: u_edge ( EDGES_PER_TRI , nct ) !! New column-total edge transport [m&#94;2/s]. integer :: c , i , k real ( wp ) :: fsum do concurrent ( c = 1 : nco ) local ( i , k , fsum ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , c ) > 0.0_wp ) then fsum = 0.0_wp do k = 1 , nz fsum = fsum + u_edge_layer ( k , i , c ) end do u_edge ( i , c ) = fsum mass_flux_edge ( i , c ) = theta * fsum + ( 1.0_wp - theta ) * u_n_edge ( i , c ) else u_edge ( i , c ) = 0.0_wp mass_flux_edge ( i , c ) = 0.0_wp end if end do end do end subroutine si_unstr_fill_mass_flux_edges pure subroutine si_unstr_advect_tracer_dsig ( mesh , nz , nct , nco , n_bc , dsig , & h_layer , mass_flux_edge , & tr_bc_ext , hTr_old , hTr , dt ) !! Depth-proportional, race-free, first-order-upwind tracer advection !! for the sigma SI path — the structured `si_ml_advect_tracer_dsig`, !! edge-wise (cell-centric double-visit).  The per-layer edge flux is !! EXACTLY `dsig_k * mass_flux_e * len_e * T_upwind` — the only split !! consistent with the dsig-slaved thickness update, so a uniform !! tracer stays uniform PER LAYER to CG tolerance and total tracer is !! conserved to round-off (interior edge fluxes are bit-exactly !! antisymmetric between the two visits; dead edges carry 0). !! !! Upwind values read the PRE-STEP snapshot `hTr_old` + the pre-update !! `h_layer` ONLY (no read-neighbour/write-own hazard — the explicit !! path's in-place update leaks conservation on sequential backends at !! SI step sizes).  Outflow (flux > 0, leaving the cell) upwinds the !! OWN cell; inflow through a Dirichlet boundary edge carries the !! per-group external tracer `tr_bc_ext(group)` (the clamped-inflow !! convention of the explicit unstructured path). !! !! FLAT-IMPL for the registry outer shim: `hTr_old`/`hTr` are plain !! explicit-shape arrays — the step module loops `tracers(:)` on the !! host and passes `tracers(it)%hTr` etc. (array-of-derived-types !! device rule). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size. real ( wp ), intent ( in ) :: dsig ( nz ) !! Sigma layer fractions. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! PRE-update layer thicknesses (time n) — upwind T denominators. real ( wp ), intent ( in ) :: mass_flux_edge ( EDGES_PER_TRI , nct ) !! Blended column edge flux [m&#94;2/s], + outward. real ( wp ), intent ( in ) :: tr_bc_ext ( n_bc ) !! Per-group external tracer value for Dirichlet inflow. real ( wp ), intent ( in ) :: hTr_old ( nz , nct ) !! Pre-step tracer snapshot (upwind source; never written here). real ( wp ), intent ( inout ) :: hTr ( nz , nct ) !! Tracer field updated in place (each cell writes only itself). real ( wp ), intent ( in ) :: dt integer :: c , i , k , kn , g real ( wp ) :: flux_c , tr_up , h_up , h_dn , div_sum , inv_area ! WET-SIDE FALLBACK at dry edges (the Q8 ML+wet/dry front lesson): a ! freshly-flooded edge can carry a transient REVERSED theta-blend flux ! whose upwind layer was EMPTY at time n (the just-wetted cell sloshing ! back).  A bare tr_up = 0 there moves real water with no tracer — ! measured ~1.7 PSU freshening over a flood tide.  When the upwind ! layer is empty the water physically originates from the SAME-step ! inflow off the wet side, so the DOWNWIND side's concentration is the ! consistent value.  Both double-visits of the edge then read the SAME ! (wet-side) tr_up — antisymmetry and conservation hold exactly, a ! uniform tracer stays uniform, and any resolved upwind layer ! (h > DRY_TOLERANCE) is bit-identical to plain upwinding. do concurrent ( c = 1 : nco ) & local ( i , k , kn , g , flux_c , tr_up , h_up , h_dn , div_sum , inv_area ) inv_area = 1.0_wp / mesh % area ( c ) do k = 1 , nz div_sum = 0.0_wp do i = 1 , EDGES_PER_TRI flux_c = dsig ( k ) * mass_flux_edge ( i , c ) * mesh % edge_len ( i , c ) if ( flux_c > 0.0_wp ) then ! Outflow: upwind the OWN cell; empty own => the downwind ! (neighbour / Dirichlet reservoir) concentration. h_up = h_layer ( k , c ) if ( h_up > DRY_TOLERANCE ) then tr_up = hTr_old ( k , c ) / h_up else kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then h_dn = h_layer ( k , kn ) tr_up = merge ( hTr_old ( k , kn ) / h_dn , 0.0_wp , & h_dn > DRY_TOLERANCE ) else g = mesh % bc_group ( i , c ) if ( g >= 1 . and . g <= n_bc ) then tr_up = tr_bc_ext ( g ) else tr_up = 0.0_wp end if end if end if else if ( flux_c < 0.0_wp ) then kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then ! Inflow: upwind the neighbour; empty neighbour => the ! downwind (own) concentration. h_up = h_layer ( k , kn ) if ( h_up > DRY_TOLERANCE ) then tr_up = hTr_old ( k , kn ) / h_up else h_dn = h_layer ( k , c ) tr_up = merge ( hTr_old ( k , c ) / h_dn , 0.0_wp , & h_dn > DRY_TOLERANCE ) end if else ! Dirichlet inflow: the per-group external tracer. g = mesh % bc_group ( i , c ) if ( g >= 1 . and . g <= n_bc ) then tr_up = tr_bc_ext ( g ) else tr_up = 0.0_wp end if end if else tr_up = 0.0_wp end if div_sum = div_sum + flux_c * tr_up end do hTr ( k , c ) = hTr_old ( k , c ) - dt * div_sum * inv_area end do end do end subroutine si_unstr_advect_tracer_dsig pure subroutine si_unstr_edge_layers_to_cells ( mesh , nz , nct , nco , & u_edge_layer , hu_layer , hv_layer ) !! Per-layer least-squares A-grid cell-momentum reconstruction from !! the three per-layer edge-normal transports — the 2D !! `si_unstr_reconstruct_cell_momenta`, per layer (the documented !! reconstruction compromise; restart round-trips through the cell !! layer momenta). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: u_edge_layer ( nz , EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: hu_layer ( nz , nct ), hv_layer ( nz , nct ) !! Cell layer momenta [m&#94;2/s]; owned cells overwritten. integer :: c , i , k real ( wp ) :: m11 , m12 , m22 , rx , ry , det , wlen , enx , eny , ue do concurrent ( c = 1 : nco ) & local ( i , k , m11 , m12 , m22 , rx , ry , det , wlen , enx , eny , ue ) ! The 2x2 normal matrix is layer-independent (mesh only). m11 = 0.0_wp m12 = 0.0_wp m22 = 0.0_wp do i = 1 , EDGES_PER_TRI wlen = mesh % edge_len ( i , c ) enx = mesh % edge_n1 ( i , c ) eny = mesh % edge_n2 ( i , c ) m11 = m11 + wlen * enx * enx m12 = m12 + wlen * enx * eny m22 = m22 + wlen * eny * eny end do det = m11 * m22 - m12 * m12 do k = 1 , nz rx = 0.0_wp ry = 0.0_wp do i = 1 , EDGES_PER_TRI wlen = mesh % edge_len ( i , c ) enx = mesh % edge_n1 ( i , c ) eny = mesh % edge_n2 ( i , c ) ue = u_edge_layer ( k , i , c ) rx = rx + wlen * ue * enx ry = ry + wlen * ue * eny end do ! det ~ 0 only for a degenerate cell (collinear edge normals) — ! excluded by the fail-loud mesh quality gate at enable_si; the ! zero fallback is 1/0 armour for a diagnostic-only quantity ! (mass/eta close on the edges regardless). if ( abs ( det ) > tiny ( 1.0_wp )) then hu_layer ( k , c ) = ( m22 * rx - m12 * ry ) / det hv_layer ( k , c ) = ( m11 * ry - m12 * rx ) / det else hu_layer ( k , c ) = 0.0_wp hv_layer ( k , c ) = 0.0_wp end if end do end do end subroutine si_unstr_edge_layers_to_cells pure subroutine si_unstr_update_thickness_ml ( nz , nct , nco , eta , bed , dsig , & stage , height , h_layer ) !! h&#94;{n+1} = max(eta&#94;{n+1} - b, 0) (exactly the edge-flux continuity !! update) + the sigma slaving h_layer_k = dsig_k*h, and the stage !! refresh stage = eta. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( nct ) real ( wp ), intent ( in ) :: bed ( nct ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( inout ) :: stage ( nct ), height ( nct ) real ( wp ), intent ( inout ) :: h_layer ( nz , nct ) integer :: c , k do concurrent ( c = 1 : nco ) local ( k ) stage ( c ) = eta ( c ) height ( c ) = max ( eta ( c ) - bed ( c ), 0.0_wp ) do k = 1 , nz h_layer ( k , c ) = dsig ( k ) * height ( c ) end do end do end subroutine si_unstr_update_thickness_ml pure subroutine si_unstr_apply_wind_top_layer ( nz , nct , nco , h_layer , & hu_layer , hv_layer , & wind_tau_x , wind_tau_y , dt ) !! Surface wind stress into the TOP layer (k = nz) transport: !! dt*tau/RHO_WATER — the explicit forcing that rides the pure-u&#94;n !! predictor into G_k (by linearity R_k / Hhat / the Helmholtz !! operator are untouched; zero wind => bit-identical).  The !! unstructured wind is the uniform scalar pair on the barotropic !! state (`wind_tau_x/y`), so this is a trivially cheap kernel. !! Gated on a wet surface layer. integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) real ( wp ), intent ( inout ) :: hu_layer ( nz , nct ), hv_layer ( nz , nct ) real ( wp ), intent ( in ) :: wind_tau_x , wind_tau_y !! Uniform surface wind stress [Pa]. real ( wp ), intent ( in ) :: dt integer :: c do concurrent ( c = 1 : nco ) if ( h_layer ( nz , c ) > H_VANISHED ) then hu_layer ( nz , c ) = hu_layer ( nz , c ) + dt * wind_tau_x / RHO_WATER hv_layer ( nz , c ) = hv_layer ( nz , c ) + dt * wind_tau_y / RHO_WATER end if end do end subroutine si_unstr_apply_wind_top_layer end module rki_si_unstr_column","tags":"","url":"sourcefile/rki_si_unstr_column.f90.html"},{"title":"rki_constants.F90 – Rakali","text":"Physical constants and working precision for the tidal solver Files dependent on this one sourcefile~~rki_constants.f90~~AfferentGraph sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_constants.f90 sourcefil