hv , state % barotropic % b , & state % grid , state % bc ) call apply_nh_boundary_conditions ( state % nh % q_nh , state % nh % u_layer , & state % nh % v_layer , state % nh % w , & state % barotropic % h , state % barotropic % b , & state % grid , nz , state % bc ) call compute_depth_averaged_momentum ( state % barotropic % h , state % nh % u_layer , & state % nh % v_layer , state % nh % dsig , & state % barotropic % hu , state % barotropic % hv , & state % grid , nz ) if ( state % dt_fixed > 0.0_wp ) then dt_slow = state % dt_fixed dt_fast = state % dt_fixed if ( present ( dt_max )) then dt_slow = min ( dt_slow , dt_max ) dt_fast = min ( dt_fast , dt_max ) end if else if ( mod ( state % step_count , state % cfl_interval ) == 0 . or . state % dt <= 0.0_wp ) then call compute_timestep ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % grid , state % cfl , dt_fast ) call compute_timestep_baroclinic ( state % barotropic % h , state % nh % u_layer , & state % nh % v_layer , state % nh % dsig , & state % grid , nz , state % cfl , dt_slow ) if ( present ( dt_max )) then dt_slow = min ( dt_slow , dt_max ) dt_fast = min ( dt_fast , dt_max ) end if else dt_fast = state % dt dt_slow = state % dt if ( present ( dt_max )) then dt_slow = min ( dt_slow , dt_max ) dt_fast = min ( dt_fast , dt_max ) end if end if state % step_count = state % step_count + 1 ! Compute split ratio if ( state % nh % split_ratio > 1 ) then n_split = state % nh % split_ratio else n_split = max ( 1 , ceiling ( dt_slow / dt_fast )) end if if ( n_split > 1 ) then dt_fast = dt_slow / real ( n_split , wp ) else dt_slow = dt_fast end if state % dt = dt_slow state % bc % dt = dt_fast ! ---- Compute NH barotropic tendency ---- call compute_nh_baro_tendency ( state % barotropic % h , state % nh % q_nh , state % nh % dsig , & state % nh % baro_tend_x , state % nh % baro_tend_y , & state % grid , nz ) ! ---- Save full state ---- call solver_save_state ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % barotropic % h0 , state % barotropic % hu0 , state % barotropic % hv0 , state % grid ) call solver_save_state_layers ( state % nh % u_layer , state % nh % v_layer , state % nh % w , & state % nh % u_layer0 , state % nh % v_layer0 , state % nh % w0 , & state % grid , nz ) ! ---- Zero accumulators ---- call solver_zero_2d ( state % nh % h_avg , state % grid ) call solver_zero_2d ( state % nh % hu_avg , state % grid ) call solver_zero_2d ( state % nh % hv_avg , state % grid ) ! ============================================================ ! BAROTROPIC SUBCYCLING ! ============================================================ do n_sub = 1 , n_split call solver_save_state ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % nh % h_bt0 , state % nh % hu_bt0 , state % nh % hv_bt0 , state % grid ) ! RK2 Stage 1 call solver_barotropic_rk_stage ( state , dt_fast ) ! RK2 Stage 2 state % bc % time = state % bc % time + dt_fast call solver_barotropic_rk_stage ( state , dt_fast ) ! RK2 average call compute_rk2_average ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % nh % h_bt0 , state % nh % hu_bt0 , state % nh % hv_bt0 , & state % grid ) ! Accumulate call solver_accumulate_2d ( state % nh % h_avg , state % barotropic % h , state % grid ) call solver_accumulate_2d ( state % nh % hu_avg , state % barotropic % hu , state % grid ) call solver_accumulate_2d ( state % nh % hv_avg , state % barotropic % hv , state % grid ) end do ! Finalize time average if ( state % nh % split_averaging . and . n_split > 1 ) then inv_n = 1.0_wp / real ( n_split , wp ) call solver_scale_2d ( state % nh % h_avg , inv_n , state % grid ) call solver_scale_2d ( state % nh % hu_avg , inv_n , state % grid ) call solver_scale_2d ( state % nh % hv_avg , inv_n , state % grid ) else call solver_copy_2d ( state % nh % h_avg , state % barotropic % h , state % grid ) call solver_copy_2d ( state % nh % hu_avg , state % barotropic % hu , state % grid ) call solver_copy_2d ( state % nh % hv_avg , state % barotropic % hv , state % grid ) end if ! ============================================================ ! BAROCLINIC STEP ! ============================================================ ! Restore layer state from beginning-of-step save (swap src/dst) call solver_save_state_layers ( state % nh % u_layer0 , state % nh % v_layer0 , state % nh % w0 , & state % nh % u_layer , state % nh % v_layer , state % nh % w , & state % grid , nz ) ! Single baroclinic fractional step at dt_slow call solver_baroclinic_rk_stage ( state , nz , dt_slow ) ! ============================================================ ! RECONCILIATION ! ============================================================ call solver_copy_2d ( state % barotropic % h , state % nh % h_avg , state % grid ) call reconcile_barotropic ( state % barotropic % h , state % barotropic % hu , state % barotropic % hv , & state % nh % u_layer , state % nh % v_layer , state % nh % dsig , & state % grid , nz ) end subroutine solver_step_split_impl","tags":"","url":"proc/solver_step_split_impl.html"},{"title":"solver_tracers_enter_data – Rakali","text":"private  subroutine solver_tracers_enter_data(state) Map state%multilayer%tracers(:) into device memory. Two-step:\ncopyin the array descriptor first (so the device sees the shape of tracers(:) ), then per-element hTr / hTr0 . Without the parent\nmap, NVHPC stdpar can’t dereference tracers(it)%hTr from a\ndo-concurrent body (CUDA_ERROR_ILLEGAL_ADDRESS). Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state Called by proc~~solver_tracers_enter_data~~CalledByGraph proc~solver_tracers_enter_data solver_tracers_enter_data proc~solver_enter_data solver_enter_data proc~solver_enter_data->proc~solver_tracers_enter_data proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_enter_data proc~flush_restart flush_restart proc~driver_run_coastal->proc~flush_restart proc~flush_snapshot flush_snapshot proc~driver_run_coastal->proc~flush_snapshot proc~ensure_device ensure_device proc~ensure_device->proc~solver_enter_data proc~flush_restart->proc~solver_enter_data proc~flush_snapshot->proc~solver_enter_data proc~rki_finalize rki_finalize proc~rki_finalize->proc~solver_enter_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~rki_advance rki_advance proc~rki_advance->proc~ensure_device proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_finalize proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_finalize proc~rki_step rki_step proc~rki_step->proc~ensure_device Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it Source Code subroutine solver_tracers_enter_data ( state ) !! Map state%multilayer%tracers(:) into device memory. Two-step: !! copyin the array descriptor first (so the device sees the shape of !! `tracers(:)`), then per-element `hTr`/`hTr0`. Without the parent !! map, NVHPC stdpar can't dereference `tracers(it)%hTr` from a !! do-concurrent body (CUDA_ERROR_ILLEGAL_ADDRESS). type ( state_t ), intent ( inout ) :: state integer :: it !$acc enter data copyin(state%multilayer%tracers) do it = 1 , size ( state % multilayer % tracers ) !$acc enter data copyin(state%multilayer%tracers(it)%hTr, & !$acc&                  state%multilayer%tracers(it)%hTr0) end do ! The device map above is an element-by-element snapshot: growing ! the registry after this point would strand every mapping. ! register_passive_tracer refuses while locked. state % multilayer % registry_locked = . true . end subroutine solver_tracers_enter_data","tags":"","url":"proc/solver_tracers_enter_data.html"},{"title":"solver_tracers_exit_data – Rakali","text":"private  subroutine solver_tracers_exit_data(state) Release the tracer registry from device memory (reverse of\nsolver_tracers_enter_data: per-element first, then the array\ndescriptor). Copies hTr back for diagnostics/tests; hTr0 (RK2\nworkspace) is dropped. Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state Called by proc~~solver_tracers_exit_data~~CalledByGraph proc~solver_tracers_exit_data solver_tracers_exit_data proc~solver_exit_data solver_exit_data proc~solver_exit_data->proc~solver_tracers_exit_data proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_exit_data proc~flush_restart flush_restart proc~driver_run_coastal->proc~flush_restart proc~flush_snapshot flush_snapshot proc~driver_run_coastal->proc~flush_snapshot proc~ensure_host~2 ensure_host proc~ensure_host~2->proc~solver_exit_data proc~flush_restart->proc~solver_exit_data proc~flush_snapshot->proc~solver_exit_data proc~rki_destroy rki_destroy proc~rki_destroy->proc~solver_exit_data proc~rki_sync_from_device rki_sync_from_device proc~rki_sync_from_device->proc~solver_exit_data proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~rki_get_b_ptr rki_get_b_ptr proc~rki_get_b_ptr->proc~ensure_host~2 proc~rki_get_h0_ptr rki_get_h0_ptr proc~rki_get_h0_ptr->proc~ensure_host~2 proc~rki_get_h_layer_ptr rki_get_h_layer_ptr proc~rki_get_h_layer_ptr->proc~ensure_host~2 proc~rki_get_h_ptr rki_get_h_ptr proc~rki_get_h_ptr->proc~ensure_host~2 proc~rki_get_hu0_ptr rki_get_hu0_ptr proc~rki_get_hu0_ptr->proc~ensure_host~2 proc~rki_get_hu_layer_ptr rki_get_hu_layer_ptr proc~rki_get_hu_layer_ptr->proc~ensure_host~2 proc~rki_get_hu_ptr rki_get_hu_ptr proc~rki_get_hu_ptr->proc~ensure_host~2 proc~rki_get_hv0_ptr rki_get_hv0_ptr proc~rki_get_hv0_ptr->proc~ensure_host~2 proc~rki_get_hv_layer_ptr rki_get_hv_layer_ptr proc~rki_get_hv_layer_ptr->proc~ensure_host~2 proc~rki_get_hv_ptr rki_get_hv_ptr proc~rki_get_hv_ptr->proc~ensure_host~2 proc~rki_get_salinity_ptr rki_get_salinity_ptr proc~rki_get_salinity_ptr->proc~ensure_host~2 proc~rki_get_temperature_ptr rki_get_temperature_ptr proc~rki_get_temperature_ptr->proc~ensure_host~2 proc~rki_set_bathymetry rki_set_bathymetry proc~rki_set_bathymetry->proc~ensure_host~2 proc~rki_set_initial_h rki_set_initial_h proc~rki_set_initial_h->proc~ensure_host~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it Source Code subroutine solver_tracers_exit_data ( state ) !! Release the tracer registry from device memory (reverse of !! solver_tracers_enter_data: per-element first, then the array !! descriptor). Copies hTr back for diagnostics/tests; hTr0 (RK2 !! workspace) is dropped. type ( state_t ), intent ( inout ) :