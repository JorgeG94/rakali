oc~rki_get_h0_ptr->proc~ensure_host~2 proc~rki_get_h_layer_ptr rki_get_h_layer_ptr proc~rki_get_h_layer_ptr->proc~ensure_host~2 proc~rki_get_h_ptr rki_get_h_ptr proc~rki_get_h_ptr->proc~ensure_host~2 proc~rki_get_hu0_ptr rki_get_hu0_ptr proc~rki_get_hu0_ptr->proc~ensure_host~2 proc~rki_get_hu_layer_ptr rki_get_hu_layer_ptr proc~rki_get_hu_layer_ptr->proc~ensure_host~2 proc~rki_get_hu_ptr rki_get_hu_ptr proc~rki_get_hu_ptr->proc~ensure_host~2 proc~rki_get_hv0_ptr rki_get_hv0_ptr proc~rki_get_hv0_ptr->proc~ensure_host~2 proc~rki_get_hv_layer_ptr rki_get_hv_layer_ptr proc~rki_get_hv_layer_ptr->proc~ensure_host~2 proc~rki_get_hv_ptr rki_get_hv_ptr proc~rki_get_hv_ptr->proc~ensure_host~2 proc~rki_get_salinity_ptr rki_get_salinity_ptr proc~rki_get_salinity_ptr->proc~ensure_host~2 proc~rki_get_temperature_ptr rki_get_temperature_ptr proc~rki_get_temperature_ptr->proc~ensure_host~2 proc~rki_set_bathymetry rki_set_bathymetry proc~rki_set_bathymetry->proc~ensure_host~2 proc~rki_set_initial_h rki_set_initial_h proc~rki_set_initial_h->proc~ensure_host~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine solver_exit_data ( state ) !! Copy state arrays back from GPU device. Called once at simulation !! end or for final output. type ( state_t ), intent ( inout ) :: state !! Solution state to retrieve from device !$acc exit data copyout(state%barotropic%h, state%barotropic%hu, state%barotropic%hv) ! The Chapman BC's eta_old_* is PERSISTENT state (the previous step's ! boundary surface); it must round-trip, or every snapshot / restart ! write (which exits and re-enters the device data) would re-enter with ! a stale host copy. !$acc exit data copyout(state%bc%eta_old_west, state%bc%eta_old_east, & !$acc&                  state%bc%eta_old_south, state%bc%eta_old_north) !$acc exit data delete(state%barotropic%b, state%barotropic%flux_h, state%barotropic%flux_hu, state%barotropic%flux_hv, & !$acc&                 state%barotropic%mass_flux_x, state%barotropic%mass_flux_y, & !$acc&                 state%barotropic%h0, state%barotropic%hu0, state%barotropic%hv0) ! Surface forcing: only the allocatable arrays need detaching; the ! value-type forcing struct drops with the parent below. !$acc exit data delete(state%forcing%wind_x, state%forcing%wind_y, & !$acc&                 state%forcing%atm_pressure, & !$acc&                 state%forcing%precipitation, & !$acc&                 state%forcing%heat_flux, & !$acc&                 state%forcing%evap_minus_precip) ! Coupled hydrostatic multi-layer arrays if ( state % use_multilayer ) then !$acc exit data copyout(state%multilayer%h_layer, state%multilayer%hu_layer, state%multilayer%hv_layer, & !$acc&                 state%multilayer%w_ml, state%multilayer%rho_layer) !$acc exit data delete(state%multilayer%dsig_ml, state%multilayer%vcoord_z_ref, & !$acc&                 state%multilayer%h_layer0, state%multilayer%hu_layer0, state%multilayer%hv_layer0, & !$acc&                 state%multilayer%hu_ml_pre, state%multilayer%hv_ml_pre, state%multilayer%rho_ref) if ( allocated ( state % multilayer % vcoord_z_ref_col )) then associate ( vref_col => state % multilayer % vcoord_z_ref_col ) !$acc exit data delete(vref_col) end associate end if if ( allocated ( state % multilayer % kpp_bl_depth )) then associate ( kpp_bl => state % multilayer % kpp_bl_depth , & kpp_us => state % multilayer % kpp_u_star , & kpp_bf => state % multilayer % kpp_buoy_flux ) !$acc exit data copyout(kpp_bl, kpp_us, kpp_bf) end associate end if if ( allocated ( state % multilayer % keps_tke )) then associate ( ke_tke => state % multilayer % keps_tke , & ke_eps => state % multilayer % keps_eps , & ke_nut => state % multilayer % keps_nut , & ke_kt => state % multilayer % keps_kt , & ke_usb => state % multilayer % keps_ustar_b , & ke_uss => state % multilayer % keps_ustar_s ) ! copyout, not delete: k and epsilon are prognostic and nu_t / ! kappa_t carry the previous step's value, so they must survive ! the exit/enter round trip around a snapshot or restart write. !$acc exit data copyout(ke_tke, ke_eps, ke_nut, ke_kt, ke_usb, ke_uss) end associate end if if ( allocated ( state % multilayer % bed_sediment )) then associate ( bed_sed => state % multilayer % bed_sediment ) !$acc exit data copyout(bed_sed) end associate end if ! Generic tracer registry: per-element components first, then ! the array descriptor (mirror of the enter_data order). if ( allocated ( state % multilayer % tracers )) then call solver_tracers_exit_data ( state ) end if end if ! Persistent multilayer kernel workspaces (PPM, hdiff, Smagorinsky, ! vcoord remap), lazy-allocated on first call; released here so ! re-running at a different grid size in the same process resizes. call tracer_scratch_destroy ( tracer_scratch ) call ml_horizontal_viscosity_cleanup () call ml_dynamics_workspaces_cleanup () ! Non-hydrostatic arrays if ( state % use_nonhydrostatic ) then !$acc exit data copyout(state%nh%u_layer, state%nh%v_layer, state%nh%w, state%nh%q_nh) if ( state % nh % nh_preconditioner ) then !$acc exit data delete(state%nh%cg_z) end if !$acc exit data delete(state%nh%dsig, & !$acc&                 state%nh%u_layer0, state%nh%v_layer0, state%nh%w0, & !$acc&                 state%nh%cg_r, state%nh%cg_p, state%nh%cg_Ap, & !$acc&                 state%nh%hu_pre, state%nh%hv_pre) end if ! Mode splitting arrays if ( allocated ( state % nh % h_avg )) then !$acc exit data delete(state%nh%h_avg, state%nh%hu_avg, state%nh%hv_avg, & !$acc&                 state%nh%h_bt0, state%nh%hu_bt0, state%nh%hv_bt0, & !$acc&                 state%nh%baro_tend_x, state%nh%baro_tend_y) end if ! Parent state struct last (mirror of enter_data order). !$acc exit data delete(state) end subroutine solver_exit_data","tags":"","url":"proc/solver_exit_data.html"},{"title":"solver_step – Rakali","text":"public  subroutine solver_step(state, dt_max, time) Advance the solution by one timestep using SSP-RK2 Apply BCs, compute timestep (CFL) Save U&#94;n Stage 1: Euler step U* = U&#94;n + dt * L(U&#94;n) Apply BCs to U* Stage 2: Euler step U = U + dt * L(U ) Average: U&#94;{n+1} = 0.5 * (U&#94;n + U**) Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: state Solution state to advance real(kind=wp), intent(in), optional :: dt_max Maximum timestep cap (e.g. t_end - t_current) real(kind=wp), intent(in), optional :: time Current simulation time (s), needed for tidal BCs Calls proc~~solver_step~~CallsGraph proc~solver_step solver_step proc~solver_step_impl solver_step_impl proc~solver_step->proc~solver_step_impl proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step->proc~solver_step_multilayer_impl proc~solver_step_split_impl solver_step_split_impl proc~solver_step->proc~solver_step_split_impl proc~accumulate_boundary_mass_out accumulate_boundary_mass_out proc~solver_step_impl->proc~accumulate_boundary_mass_out proc~accumulate_mass_src accumulate_mass_src proc~solver_step_impl->proc~accumulate_mass_src proc~accumulate_sponge_mass_src accumulate_sponge_mass_src proc~solver_step_impl->proc~accumulate_sponge_mass_src proc~apply_boundary_conditions apply_boundary_conditions proc~solver_step_impl->proc~apply_boundary_conditions proc~apply_nh_boundary_conditions apply_nh_boundary_conditions proc~solver_step_impl->proc~apply_nh_boundary_conditions proc~com