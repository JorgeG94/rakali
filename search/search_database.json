ate :: ng integer, private :: nx integer, private :: ny integer, private :: pnx integer, private :: pny real(kind=wp), private :: speed real(kind=wp), private :: wy_j Source Code subroutine apply_nested_east ( nest , state , alpha ) !! Fill east ghost cells using Flather with parent values type ( nesting_t ), intent ( in ) :: nest type ( state_t ), intent ( inout ) :: state real ( wp ), intent ( in ) :: alpha integer :: j , k , ng , ny , nx , i_last integer :: iy0 , pnx , pny real ( wp ) :: wy_j , h_ext , hu_ext , hv_ext , eta_ext real ( wp ) :: h_int , eta_int , speed ng = state % grid % nghost nx = state % grid % nx_total ny = state % grid % ny_total i_last = nx - ng pnx = nest % p_nx pny = nest % p_ny do j = 1 , ny iy0 = nest % we_iy0 ( j ) wy_j = nest % we_wy ( j ) h_ext = interp_parent ( nest % h_lo , nest % h_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) hu_ext = interp_parent ( nest % hu_lo , nest % hu_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) hv_ext = interp_parent ( nest % hv_lo , nest % hv_hi , & nest % ix_east , iy0 , nest % wx_east , wy_j , & alpha , pnx , pny ) eta_ext = h_ext + state % barotropic % b ( i_last , j ) h_int = state % barotropic % h ( i_last , j ) eta_int = h_int + state % barotropic % b ( i_last , j ) speed = sqrt ( GRAVITY * max ( h_int , 1.0e-6_wp )) do k = 1 , ng state % barotropic % h ( i_last + k , j ) = max ( 0.0_wp , & eta_ext - state % barotropic % b ( i_last + k , j )) state % barotropic % hu ( i_last + k , j ) = state % barotropic % h ( i_last + k , j ) * & ( hu_ext / max ( h_ext , 1.0e-6_wp ) + & speed * ( eta_int - eta_ext ) / max ( h_int , 1.0e-6_wp )) state % barotropic % hv ( i_last + k , j ) = hv_ext end do end do end subroutine apply_nested_east","tags":"","url":"proc/apply_nested_east.html"},{"title":"apply_nested_north – Rakali","text":"private  subroutine apply_nested_north(nest, state, alpha) Fill north ghost cells using Flather with parent values Argumen