ccess, 1 = cell count mismatch integer :: ncid , varid , file_ncells , n , sc , att_stat real ( wp ), allocatable :: tmp (:) n = state % ncells_owned call nc_open_read ( trim ( filename ), ncid ) ! Validate cell count call nc_get_dim_len ( ncid , \"face\" , file_ncells ) if ( file_ncells /= n ) then call logger % error ( \"Restart cell count mismatch: file has \" // & to_string ( file_ncells ) // \" but state expects \" // & to_string ( n )) call nc_close ( ncid ) ierr = 1 return end if ! Read time from global attribute call nc_check ( nf90_get_att ( ncid , nf90_global , \"time\" , time ), & \"reading time attribute\" ) ! Read step_count if present att_stat = nf90_inquire_attribute ( ncid , nf90_global , \"step_count\" ) if ( att_stat == nf90_noerr ) then call nc_check ( nf90_get_att ( ncid , nf90_global , \"step_count\" , sc ), & \"reading step_count\" ) state % step_count = sc end if ! Read fields allocate ( tmp ( n )) call nc_get_varid ( ncid , \"stage\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , tmp ), \"reading stage\" ) state % barotropic % stage_cv ( 1 : n ) = tmp call nc_get_varid ( ncid , \"xmom\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , tmp ), \"reading xmom\" ) state % barotropic % xmom_cv ( 1 : n ) = tmp call nc_get_varid ( ncid , \"ymom\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , tmp ), \"reading ymom\" ) state % barotropic % ymom_cv ( 1 : n ) = tmp call nc_get_varid ( ncid , \"bed\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , tmp ), \"reading bed\" ) state % barotropic % bed_cv ( 1 : n ) = tmp deallocate ( tmp ) call nc_close ( ncid ) state % time = time ierr = 0 call logger % info ( \"Restart loaded: \" // trim ( filename ) // & \" (t = \" // to_string ( time ) // \" s, \" // & to_string ( n ) // \" cells)\" ) end subroutine restart_read_unstr","tags":"","url":"proc/restart_read_unstr.html"},{"title":"restart_write_unstr – Rakali","text":"public  subroutine restart_write_unstr(filename, state, mesh