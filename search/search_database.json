( k = 1 : nc ) a ( k ) = 0.0_wp end do end subroutine agglom_zero","tags":"","url":"proc/agglom_zero.html"},{"title":"aggregate_and_build_coarse – Rakali","text":"private  subroutine aggregate_and_build_coarse(this, l, strength) Greedy pairwise aggregation of level l (strongest-transmissibility\npartner), then build level l+1’s static structure: nc, member CSR,\ncoarse adjacency (nbr / n_nbr / mv). strength(mv,nc) = |ke| per\nedge on level l. Arguments Type Intent Optional Attributes Name class( agglom_hierarchy_unstr_t ), intent(inout) :: this integer, intent(in) :: l real(kind=wp), intent(in) :: strength (:,:) Calls proc~~aggregate_and_build_coarse~~CallsGraph proc~aggregate_and_build_coarse aggregate_and_build_coarse cursor cursor proc~aggregate_and_build_coarse->cursor proc~build_coarse_adjacency build_coarse_adjacency proc~aggregate_and_build_coarse->proc~build_coarse_adjacency proc~push_unique push_unique proc~build_coarse_adjacency->proc~push_unique Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~aggregate_and_build_coarse~~CalledByGraph proc~aggregate_and_build_coarse aggregate_and_build_coarse proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~aggregate_and_build_coarse proc~si_unstr_state_build_mg semi_implicit_state_unstr_t%si_unstr_state_build_mg proc~si_unstr_state_build_mg->proc~agglom_hierarchy_unstr_build proc~state_unstr_enable_si state_unstr_enable_si proc~state_unstr_enable_si->proc~si_unstr_state_build_mg proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~state_unstr_enable_si proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private, allocatable :: aggof (:) integer, private :: best real(kind=wp), private :: bw integer, private :: i integer, private :: j integer, private :: k integer, private :: nc integer, private :: nf integer, private :: s real(kind=wp), private :: w Source Code subroutine aggregate_and_build_coarse ( this , l , strength ) !! Greedy pairwise aggregation of level l (strongest-transmissibility !! partner), then build level l+1's static structure: nc, member CSR, !! coarse adjacency (nbr / n_nbr / mv).  `strength(mv,nc)` = |ke| per !! edge on level l. class ( agglom_hierarchy_unstr_t ), intent ( inout ) :: this integer , intent ( in ) :: l real ( wp ), intent ( in ) :: strength (:, :) integer :: nf , k , s , j , best , nc , i real ( wp ) :: bw , w integer , allocatable :: aggof (:) nf = this % lev ( l )% nc allocate ( aggof ( nf ), source = 0 ) nc = 0 do k = 1 , nf if ( aggof ( k ) /= 0 ) cycle best = - 1 bw = 0.0_wp do s = 1 , this % lev ( l )% n_nbr ( k ) j = this % lev ( l )% nbr ( s , k ) if ( aggof ( j ) /= 0 ) cycle w = strength ( s , k ) if ( w > bw ) then bw = w best = j end if end do nc = nc + 1 aggof ( k ) = nc if ( best > 0 ) aggof ( best ) = nc end do ! Store agg_of on level l (drives prolongation). allocate ( this % lev ( l )% agg_of ( nf )) this % lev ( l )% agg_of = aggof ! Level l+1 skeleton. this % lev ( l + 1 )% nc = nc ! Member CSR (which level-l cells belong to each coarse cell), STANDARD ! 1-based: members of coarse cell I are mlist(mstart(I):mstart(I+1)-1). allocate ( this % lev ( l + 1 )% mstart ( nc + 1 ), source = 0 ) do k = 1 , nf this % lev ( l + 1 )% mstart ( aggof ( k ) + 1 ) = & this % lev ( l + 1 )% mstart ( aggof ( k ) + 1 ) + 1 ! count(I) into slot I+1 end do this % lev ( l + 1 )% mstart ( 1 ) = 1 do i = 1 , nc this % lev ( l + 1 )% mstart ( i + 1 ) = this % lev ( l + 1 )% mstart ( i ) & + this % lev ( l + 1 )% mstart ( i + 1 ) end do allocate ( this % lev ( l + 1 )% mlist ( nf )) block integer , allocatable :: cursor (:) allocate ( cursor ( nc )) cursor = this % lev ( l + 1 )% mstart ( 1 : nc ) ! cursor(I) = mstart(I) do k = 1 , nf i = aggof ( k ) this % lev ( l + 1 )% mlist ( cursor ( i )) = k cursor ( i ) = cursor ( i ) + 1 end do deallocate ( cursor ) end block call build_coarse_adjacency ( this % lev ( l ), this % lev ( l + 1 ), aggof ) deallocate ( aggof ) end subroutine aggregate_and_build_coarse","tags":"","url":"proc/aggregate_and_build_coarse.html"},{"title":"alloc_level_coeffs – Rakali","text":"private  subroutine alloc_level_coeffs(lev) Allocate the per-step coefficient + V-cycle work arrays of a level. Arguments Type Intent Optional Attributes Name type( agglom_level_unstr_t ), intent(inout) :: lev Called by proc~~alloc_level_coeffs~~CalledByGraph proc~alloc_level_coeffs alloc_level_coeffs proc~agglom_hierarchy_unstr_build agglom_hierarchy_unstr_build proc~agglom_hierarchy_unstr_build->proc~alloc_level_coeffs proc~si_unstr_