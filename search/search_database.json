 rows.  `rhs` returns the solution; `cp` scratch. !! (Duplicate of the structured keps_tridiag_solve; tiny standard !! algorithm — can be consolidated into a shared module later.) integer , intent ( in ) :: ni real ( wp ), intent ( inout ) :: a ( ni ), b ( ni ), c ( ni ), rhs ( ni ), cp ( ni ) integer :: m real ( wp ) :: denom a ( 1 ) = 0.0_wp b ( 1 ) = 1.0_wp c ( 1 ) = - 1.0_wp rhs ( 1 ) = 0.0_wp a ( ni ) = - 1.0_wp b ( ni ) = 1.0_wp c ( ni ) = 0.0_wp rhs ( ni ) = 0.0_wp cp ( 1 ) = c ( 1 ) / b ( 1 ) rhs ( 1 ) = rhs ( 1 ) / b ( 1 ) do m = 2 , ni denom = b ( m ) - a ( m ) * cp ( m - 1 ) cp ( m ) = c ( m ) / denom rhs ( m ) = ( rhs ( m ) - a ( m ) * rhs ( m - 1 )) / denom end do do m = ni - 1 , 1 , - 1 rhs ( m ) = rhs ( m ) - cp ( m ) * rhs ( m + 1 ) end do end subroutine keps_tridiag_solve_u","tags":"","url":"proc/keps_tridiag_solve_u.html"},{"title":"apply_sponge_unstr – Rakali","text":"public pure subroutine apply_sponge_unstr(state, mesh, dt) Apply sponge relaxation to all owned cells adjacent to a BC_SPONGE edge. Relaxes h = stage_cv - bed_cv toward bc_sponge_h_ref(g) and xmom_cv / ymom_cv toward 0.  No-op when no sponge edges exist or\nall sponge strengths are 0. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~apply_sponge_unstr~~CallsGraph proc~apply_sponge_unstr apply_sponge_unstr local local proc~apply_sponge_unstr->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_sponge_unstr~~CalledByGraph proc~apply_sponge_unstr apply_sponge_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~apply_sponge_unstr proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha integer, private :: cell integer, private :: e integer, private :: g real(kind=wp), private :: h_new real(kind=wp), private :: h_ref_best real(kind=wp), private :: h_water Source Code pure subroutine apply_sponge_unstr ( state , mesh , dt ) !! Apply sponge relaxation to all owned cells adjacent to a BC_SPONGE edge. !! !! Relaxes `h = stage_cv - bed_cv` toward `bc_sponge_h_ref(g)` and !! `xmom_cv`/`ymom_cv` toward 0.  No-op when no sponge edges exist or !! all sponge strengths are 0. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer :: cell , e , g real ( wp ) :: alpha , h_ref_best , h_water , h_new do concurrent ( cell = 1 : state % ncells_owned ) & local ( e , g , alpha , h_ref_best , h_water , h_new ) ! Scan all three edges for the highest-strength sponge group. alpha = 0.0_wp h_ref_best = 0.0_wp do e = 1 , 3 if ( mesh % neighbours ( e , cell ) < 0 ) then g = mesh % bc_group ( e , cell ) if ( g > 0 ) then if ( state % bc_type ( g ) == BC_SPONGE . and . & state % bc_sponge_strength ( g ) > alpha ) then alpha = state % bc_sponge_strength ( g ) h_ref_best = state % bc_sponge_h_ref ( g ) end if end if end if end do if ( alpha > 0.0_wp ) then h_water = state % barotropic % stage_cv ( cell ) - state % barotropic % bed_cv ( cell ) h_new = h_water - dt * alpha * ( h_water - h_ref_best ) state % barotropic % stage_cv ( cell ) = h_new + state % barotropic % bed_cv ( cell ) state % barotropic % xmom_cv ( cell ) = state % barotropic % xmom_cv ( cell ) * ( 1.0_wp - dt * alpha ) state % barotropic % ymom_cv ( cell ) = state % barotropic % ymom_cv ( cell ) * ( 1.0_wp - dt * alpha ) end if end do end subroutine apply_sponge_unstr","tags":"","url":"proc/apply_sponge_unstr.html"},{"title":"si_unstr_edge_flux – Rakali","text":"public pure function si_unstr_edge_flux(hf, eta_c, eta_nbr, inv_delta) result(flux) The single discrete edge-normal transport used by the TPFA\noperator’s div(Hf grad eta) , the edge predictor’s explicit PGF,\nand the edge back-substitution:\n  flux = Hf * (eta_nbr - eta_c) / delta   (along the outward normal)\nSharing ONE flux function across the operator/back-sub is what makes\nthe back-substituted edge transports satisfy discrete continuity\nidentically (mass consistency). !$acc routine seq for device\ndo-concurrent bodies. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: hf Frozen edge effective depth Hf_e. real(kind=wp), intent(in) :: eta_c eta at this cell / the across-edge neighbour (or Dirichlet ghost). real(kind=wp), intent(in) :: eta_nbr eta at this cell / the across-edge neighbour (or Dirichlet ghost). real(kind=wp), intent(in) :: inv_delta 1/delta_e (circumcentre-line distance reciprocal). Return Value real(kind=wp) Called by proc~~si_unstr_edge_flux~~CalledByGraph proc~si_unstr_edge_flux si_unstr_edge_flux proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_edge_flux proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_edge_flux proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function si_unstr_edge_flux ( hf , eta_c , eta_nbr , inv_delta ) result ( flux ) !! The single discrete edge-normal transport used by the TPFA !! operator's `div(Hf grad eta)`, the edge predictor's explicit PGF, !! and the edge back-substitution: !!   flux = Hf * (eta_nbr - eta_c) / delta   (along the outward normal) !! Sharing ONE flux function across the operator/back-sub is what makes !! the back-substituted edge transports satisfy discrete continuity !! identically (mass consistency).  `!$acc routine seq` for device !! do-concurrent bodies. !$acc routine seq real ( wp ), intent ( in ) :: hf !! Frozen edge effective depth Hf_e. real ( wp ), intent ( in ) :: eta_c , eta_nbr !! eta at this cell / the across-edge neighbour (or Dirichlet ghost). real ( wp ), intent ( in ) :: inv_delta !! 1/delta_e (circumcentre-line distance reciprocal). real ( wp ) :: flux flux = hf * ( eta_nbr - eta_c ) * inv_delta end function si_unstr_edge_flux","tags":"","url":"proc/si_unstr_edge_flux.html"},{"title":"si_unstr_face_depth_linear – Rakali","text":"private pure function si_unstr_face_depth_linear(h_c, h_nbr) result(hf) All-wet (2D barotropic) edge effective depth: the arithmetic mean of\nthe two cells’ still-water depths, Hf = 0.5*(h_c + h_nbr) .  This is\nthe gated-mean rule ( face_depth_wetdry ) in its\nall-wet limit — it reduces EXACTLY to the linear edge depth.  Wall edges never call\nthis (Hf stays 0); Dirichlet edges pass the ghost h . Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_c real(kind=wp), intent(in) :: h_nbr Return Value real(kind=wp) Called by proc~~si_unstr_face_depth_linear~~CalledByGraph proc~si_unstr_face_depth_linear si_unstr_face_depth_linear proc~si_unstr_face_depths si_unstr_face_depths proc~si_unstr_face_depths->proc~si_unstr_face_depth_linear proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_face_depths proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_face_depths proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function si_unstr_face_depth_linear ( h_c , h_nbr ) result ( hf ) !! All-wet (2D barotropic) edge effective depth: the arithmetic mean of !! the two cells' still-water depths, `Hf = 0.5*(h_c + h_nbr)`.  This is !! the gated-mean rule (`face_depth_wetdry`) in its !! all-wet limit — it reduces EXACTLY to the linear edge depth.  Wall edges never call !! this (Hf stays 0); Dirichlet edges pass the ghost `h`. !$acc routine seq real ( wp ), intent ( in ) :: h_c , h_nbr real ( wp ) :: hf hf = 0.5_wp * ( h_c + h_nbr ) end function si_unstr_face_depth_linear","tags":"","url":"proc/si_unstr_face_depth_linear.html"},{"title":"si_unstr_apply_helmholtz – Rakali","text":"public pure subroutine si_unstr_apply_helmholtz(mesh, ncell_total, ncell_owned, eta, Ap, Hf_edge, g_theta2_dt2, mass_diag) Matrix-free apply Ap = A*eta for the SPD TPFA Helmholtz operator: Ap_c = M_c eta_c - (g theta&#94;2*dt&#94;2/area_c) *\n           sum_{e in c} sign_e * K_e * (eta_nbr - eta_c) with sign_e = +1 (flux LEAVES the cell along the outward normal),\nK_e = Hf_e*len_e/delta_e, and the divergence in depth units (÷area).\nWall edges carry Hf=0 => no coupling (no-flux Neumann).  Dirichlet\nedges read the ghost eta the caller seeded into eta(kn) — the\ncoefficient-space route (no separate elimination pass). M_c is the cell mass: absent mass_diag => M=1 (the linear\nall-wet operator); present => the wet/dry Newton diagonal a+floor. Cell-centric double-visit: reads neighbour eta, writes own Ap. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total Cell array extent (owned + halo) — the explicit-shape dim. integer, intent(in) :: ncell_owned Owned-cell loop bound. real(kind=wp), intent(in) :: eta (ncell_total) real(kind=wp), intent(out) :: Ap (ncell_total) real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(in) :: g_theta2_dt2 real(kind=wp), intent(in), optional :: mass_diag (ncell_total) Per-cell Newton mass diagonal (wet/dry); absent => 1.0. Calls proc~~si_unstr_apply_helmholtz~~CallsGraph proc~si_unstr_apply_helmholtz si_unstr_apply_helmholtz local local proc~si_unstr_apply_helmholtz->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_apply_helmholtz~~CalledByGraph proc~si_unstr_apply_helmholtz si_unstr_apply_helmholtz proc~si_ml_wetdry_newton si_ml_wetdry_newton proc~si_ml_wetdry_newton->proc~si_unstr_apply_helmholtz proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_ml_wetdry_newton->proc~si_unstr_cg_solve proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_apply_helmholtz proc~si_unstr_advance_wetdry->proc~si_unstr_cg_solve proc~si_unstr_cg_solve->proc~si_unstr_apply_helmholtz proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_cg_solve proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_ml_wetdry_newton proc~si_unstr_step_ml->proc~si_unstr_cg_solve proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: div_flux logical, private :: have_mass integer, private :: i integer, private :: k real(kind=wp), private :: ke integer, private :: kn real(kind=wp), private :: mass_k Source Code pure subroutine si_unstr_apply_helmholtz ( mesh , ncell_total , ncell_owned , & eta , Ap , Hf_edge , g_theta2_dt2 , & mass_diag ) !! Matrix-free apply `Ap = A*eta` for the SPD TPFA Helmholtz operator: !! !!   Ap_c = M_c*eta_c - (g*theta&#94;2*dt&#94;2/area_c) * !!            sum_{e in c} sign_e * K_e * (eta_nbr - eta_c) !! !! with sign_e = +1 (flux LEAVES the cell along the outward normal), !! K_e = Hf_e*len_e/delta_e, and the divergence in depth units (÷area). !! Wall edges carry Hf=0 => no coupling (no-flux Neumann).  Dirichlet !! edges read the ghost eta the caller seeded into eta(kn) — the !! coefficient-space route (no separate elimination pass). !! !! `M_c` is the cell mass: absent `mass_diag` => M=1 (the linear !! all-wet operator); present => the wet/dry Newton diagonal a+floor. !! !! Cell-centric double-visit: reads neighbour eta, writes own Ap. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: ncell_total !! Cell array extent (owned + halo) — the explicit-shape dim. integer , intent ( in ) :: ncell_owned !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta ( ncell_total ) real ( wp ), intent ( out ) :: Ap ( ncell_total ) real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( in ) :: g_theta2_dt2 real ( wp ), intent ( in ), optional :: mass_diag ( ncell_total ) !! Per-cell Newton mass diagonal (wet/dry); absent => 1.0. integer :: k , i , kn real ( wp ) :: div_flux , ke , mass_k logical :: have_mass have_mass = present ( mass_diag ) do concurrent ( k = 1 : ncell_owned ) local ( i , kn , div_flux , ke , mass_k ) div_flux = 0.0_wp do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then ke = Hf_edge ( i , k ) * mesh % edge_len ( i , k ) & / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then ! Interior edge: read the neighbour eta. div_flux = div_flux + ke * ( eta ( kn ) - eta ( k )) else ! Dirichlet boundary edge (Hf>0 <=> tidal/clamped): the ! FIXED ghost eta is NOT a CG unknown, so it reads as 0 in ! the operator (A*p) — this stiffens the diagonal; the ! ghost's real value is folded into the RHS (coefficient- ! space Dirichlet route).  Contribution: ke*(0 - eta(k)). div_flux = div_flux - ke * eta ( k ) end if end if end do if ( have_mass ) then mass_k = mass_diag ( k ) else mass_k = 1.0_wp end if Ap ( k ) = mass_k * eta ( k ) - g_theta2_dt2 * div_flux / mesh % area ( k ) end do end subroutine si_unstr_apply_helmholtz","tags":"","url":"proc/si_unstr_apply_helmholtz.html"},{"title":"si_unstr_cg_solve – Rakali","text":"public  subroutine si_unstr_cg_solve(mesh, ncell_total, ncell_owned, eta, cg_r, cg_p, cg_Ap, cg_z, eta_diag, Hf_edge, g_theta2_dt2, precond, rtol, iter_out, mass_res_out, mass_diag, mg) Uses rki_si_unstr_state proc~~si_unstr_cg_solve~~UsesGraph proc~si_unstr_cg_solve si_unstr_cg_solve module~rki_si_unstr_state rki_si_unstr_state proc~si_unstr_cg_solve->module~rki_si_unstr_state module~rki_constants rki_constants module~rki_si_unstr_state->module~rki_constants module~rki_mesh_unstr rki_mesh_unstr module~rki_si_unstr_state->module~rki_mesh_unstr module~rki_si_unstr_mg rki_si_unstr_mg module~rki_si_unstr_state->module~rki_si_unstr_mg pic_logger pic_logger module~rki_si_unstr_state->pic_logger pic_types pic_types module~rki_constants->pic_types module~rki_mesh_unstr->module~rki_constants module~rki_mesh_unstr->pic_logger pic_io pic_io module~rki_mesh_unstr->pic_io module~rki_mesh_unstr->pic_types module~rki_si_unstr_mg->module~rki_constants module~rki_si_unstr_mg->module~rki_mesh_unstr module~rki_si_unstr_mg->pic_logger Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Area-weighted (optionally preconditioned) CG for the TPFA Helmholtz\neta-solve, warm-started from eta&#94;n.  On entry cg_r holds the RHS and eta the warm start.  EVERY dot product carries the mesh%area weight (the operator is self-adjoint in _A only — prototype\n§7.5); the convergence gate is the area-weighted relative residual ||r||_A&#94;2 < rtol&#94;2 ||rhs||_A&#94;2 on the UNPRECONDITIONED residual in\nevery mode (comparable iteration counts).  Preconditioners:\nNONE (plain), JACOBI ( z = eta_diag*r ), MG (aggregation-multigrid\nV-cycle via mg , z = Vcycle_Ahat(area*r) — the same area*r symmetric-space RHS the Jacobi apply implicitly uses). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total Cell array extent (owned + halo) — the explicit-shape dim. integer, intent(in) :: ncell_owned Owned-cell loop bound. real(kind=wp), intent(inout) :: eta (ncell_total) real(kind=wp), intent(inout) :: cg_r (ncell_total) real(kind=wp), intent(inout) :: cg_p (ncell_total) real(kind=wp), intent(inout) :: cg_Ap (ncell_total) real(kind=wp), intent(inout) :: cg_z (ncell_total) real(kind=wp), intent(inout) :: eta_diag (ncell_total) real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(in) :: g_theta2_dt2 integer, intent(in) :: precond real(kind=wp), intent(in) :: rtol integer, intent(out) :: iter_out real(kind=wp), intent(out) :: mass_res_out Area-weighted interior residual sum at solve end (mass diagnostic). real(kind=wp), intent(in), optional :: mass_diag (ncell_total) type( agglom_hierarchy_unstr_t ), intent(inout), optional :: mg Aggregation-MG hierarchy (required when precond == MG); its\noperator must already be refreshed for this step’s frozen Hf. Calls proc~~si_unstr_cg_solve~~CallsGraph proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_unstr_apply_helmholtz si_unstr_apply_helmholtz proc~si_unstr_cg_solve->proc~si_unstr_apply_helmholtz proc~si_unstr_compute_diag si_unstr_compute_diag proc~si_unstr_cg_solve->proc~si_unstr_compute_diag proc~si_unstr_precond_apply si_unstr_precond_apply proc~si_unstr_cg_solve->proc~si_unstr_precond_apply reduce reduce proc~si_unstr_cg_solve->reduce local local proc~si_unstr_apply_helmholtz->local proc~si_unstr_compute_diag->local proc~agglom_unstr_vcycle_precond agglom_unstr_vcycle_precond proc~si_unstr_precond_apply->proc~agglom_unstr_vcycle_precond proc~agglom_copy_out agglom_copy_out proc~agglom_unstr_vcycle_precond->proc~agglom_copy_out proc~agglom_scale_into_shim agglom_scale_into_shim proc~agglom_unstr_vcycle_precond->proc~agglom_scale_into_shim proc~agglom_vcycle agglom_vcycle proc~agglom_unstr_vcycle_precond->proc~agglom_vcycle proc~agglom_vcycle->proc~agglom_vcycle proc~agglom_jacobi_sweeps agglom_jacobi_sweeps proc~agglom_vcycle->proc~agglom_jacobi_sweeps proc~agglom_prolong_add agglom_prolong_add proc~agglom_vcycle->proc~agglom_prolong_add proc~agglom_residual agglom_residual proc~agglom_vcycle->proc~agglom_residual proc~agglom_restrict agglom_restrict proc~agglom_vcycle->proc~agglom_restrict proc~agglom_zero agglom_zero proc~agglom_vcycle->proc~agglom_zero proc~agglom_copy agglom_copy proc~agglom_jacobi_sweeps->proc~agglom_copy proc~agglom_jacobi_one agglom_jacobi_one proc~agglom_jacobi_sweeps->proc~agglom_jacobi_one proc~agglom_residual->local proc~agglom_restrict->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_cg_solve~~CalledByGraph proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_ml_wetdry_newton si_ml_wetdry_newton proc~si_ml_wetdry_newton->proc~si_unstr_cg_solve proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_cg_solve proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_cg_solve proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_cg_solve proc~si_unstr_step_ml->proc~si_ml_wetdry_newton proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha real(kind=wp), private :: beta logical, private :: have_mass integer, private :: iter integer, private :: k real(kind=wp), private :: pAp real(kind=wp), private :: res_sum real(kind=wp), private :: rhs2 real(kind=wp), private :: rr real(kind=wp), private :: rz real(kind=wp), private :: rz_new real(kind=wp), private :: tol2 logical, private :: use_mg logical, private :: use_pc Source Code subroutine si_unstr_cg_solve ( mesh , ncell_total , ncell_owned , & eta , cg_r , cg_p , cg_Ap , cg_z , eta_diag , & Hf_edge , g_theta2_dt2 , precond , rtol , & iter_out , mass_res_out , mass_diag , mg ) !! Area-weighted (optionally preconditioned) CG for the TPFA Helmholtz !! eta-solve, warm-started from eta&#94;n.  On entry `cg_r` holds the RHS and !! `eta` the warm start.  EVERY dot product carries the `mesh%area` !! weight (the operator is self-adjoint in <x,y>_A only — prototype !! §7.5); the convergence gate is the area-weighted relative residual !! `||r||_A&#94;2 < rtol&#94;2 ||rhs||_A&#94;2` on the UNPRECONDITIONED residual in !! every mode (comparable iteration counts).  Preconditioners: !! NONE (plain), JACOBI (`z = eta_diag*r`), MG (aggregation-multigrid !! V-cycle via `mg`, `z = Vcycle_Ahat(area*r)` — the same `area*r` !! symmetric-space RHS the Jacobi apply implicitly uses). use rki_si_unstr_state , only : SI_PRECOND_NONE , SI_PRECOND_JACOBI , & SI_PRECOND_MG type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: ncell_total !! Cell array extent (owned + halo) — the explicit-shape dim. integer , intent ( in ) :: ncell_owned !! Owned-cell loop bound. real ( wp ), intent ( inout ) :: eta ( ncell_total ) real ( wp ), intent ( inout ) :: cg_r ( ncell_total ), cg_p ( ncell_total ) real ( wp ), intent ( inout ) :: cg_Ap ( ncell_total ), cg_z ( ncell_total ) real ( wp ), intent ( inout ) :: eta_diag ( ncell_total ) real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( in ) :: g_theta2_dt2 , rtol integer , intent ( in ) :: precond integer , intent ( out ) :: iter_out real ( wp ), intent ( out ) :: mass_res_out !! Area-weighted interior residual sum at solve end (mass diagnostic). real ( wp ), intent ( in ), optional :: mass_diag ( ncell_total ) type ( agglom_hierarchy_unstr_t ), intent ( inout ), optional :: mg !! Aggregation-MG hierarchy (required when precond == MG); its !! operator must already be refreshed for this step's frozen Hf. integer :: k , iter real ( wp ) :: rz , rr , rz_new , pAp , alpha , beta , tol2 , rhs2 , res_sum logical :: use_pc , use_mg , have_mass iter_out = 0 mass_res_out = 0.0_wp use_mg = ( precond == SI_PRECOND_MG ) use_pc = ( precond == SI_PRECOND_JACOBI ) . or . use_mg have_mass = present ( mass_diag ) ! Jacobi needs the operator diagonal; MG carries its own per-level diag ! (under MG `eta_diag` stays STALE and is threaded through ! si_unstr_precond_apply UNREAD — do not consume it on that branch). if ( precond == SI_PRECOND_JACOBI ) then if ( have_mass ) then call si_unstr_compute_diag ( mesh , ncell_total , ncell_owned , Hf_edge , & eta_diag , g_theta2_dt2 , mass_diag = mass_diag ) else call si_unstr_compute_diag ( mesh , ncell_total , ncell_owned , Hf_edge , & eta_diag , g_theta2_dt2 ) end if end if ! ||rhs||_A&#94;2 for the relative test (cg_r still holds the RHS). rhs2 = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : rhs2 ) rhs2 = rhs2 + mesh % area ( k ) * cg_r ( k ) * cg_r ( k ) end do tol2 = max ( rtol * rtol * rhs2 , 1.0e-60_wp ) ! Zero the full search direction (ghost/halo band stays 0 so a ! Dirichlet ghost is never a CG unknown). do concurrent ( k = 1 : ncell_total ) cg_p ( k ) = 0.0_wp end do ! r = rhs - A*eta (warm start eta = eta&#94;n). if ( have_mass ) then call si_unstr_apply_helmholtz ( mesh , ncell_total , ncell_owned , eta , & cg_Ap , Hf_edge , g_theta2_dt2 , & mass_diag = mass_diag ) else call si_unstr_apply_helmholtz ( mesh , ncell_total , ncell_owned , eta , & cg_Ap , Hf_edge , g_theta2_dt2 ) end if do concurrent ( k = 1 : ncell_owned ) cg_r ( k ) = cg_r ( k ) - cg_Ap ( k ) end do rr = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : rr ) rr = rr + mesh % area ( k ) * cg_r ( k ) * cg_r ( k ) end do if ( rr < tol2 ) then res_sum = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : res_sum ) res_sum = res_sum + mesh % area ( k ) * cg_r ( k ) end do mass_res_out = res_sum return end if if ( use_pc ) then call si_unstr_precond_apply ( mesh , ncell_total , ncell_owned , cg_r , cg_z , & eta_diag , use_mg , mg ) do concurrent ( k = 1 : ncell_owned ) cg_p ( k ) = cg_z ( k ) end do rz = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : rz ) rz = rz + mesh % area ( k ) * cg_r ( k ) * cg_z ( k ) end do else do concurrent ( k = 1 : ncell_owned ) cg_p ( k ) = cg_r ( k ) end do rz = rr end if do iter = 1 , SI_MAX_ITER if ( have_mass ) then call si_unstr_apply_helmholtz ( mesh , ncell_total , ncell_owned , cg_p , & cg_Ap , Hf_edge , g_theta2_dt2 , & mass_diag = mass_diag ) else call si_unstr_apply_helmholtz ( mesh , ncell_total , ncell_owned , cg_p , & cg_Ap , Hf_edge , g_theta2_dt2 ) end if pAp = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : pAp ) pAp = pAp + mesh % area ( k ) * cg_p ( k ) * cg_Ap ( k ) end do if ( abs ( pAp ) < 1.0e-30_wp ) exit alpha = rz / pAp do concurrent ( k = 1 : ncell_owned ) eta ( k ) = eta ( k ) + alpha * cg_p ( k ) cg_r ( k ) = cg_r ( k ) - alpha * cg_Ap ( k ) end do rr = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : rr ) rr = rr + mesh % area ( k ) * cg_r ( k ) * cg_r ( k ) end do iter_out = iter if ( rr < tol2 ) exit if ( use_pc ) then call si_unstr_precond_apply ( mesh , ncell_total , ncell_owned , cg_r , & cg_z , eta_diag , use_mg , mg ) rz_new = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : rz_new ) rz_new = rz_new + mesh % area ( k ) * cg_r ( k ) * cg_z ( k ) end do beta = rz_new / rz rz = rz_new do concurrent ( k = 1 : ncell_owned ) cg_p ( k ) = cg_z ( k ) + beta * cg_p ( k ) end do else beta = rr / rz rz = rr do concurrent ( k = 1 : ncell_owned ) cg_p ( k ) = cg_r ( k ) + beta * cg_p ( k ) end do end if end do res_sum = 0.0_wp do concurrent ( k = 1 : ncell_owned ) reduce ( + : res_sum ) res_sum = res_sum + mesh % area ( k ) * cg_r ( k ) end do mass_res_out = res_sum end subroutine si_unstr_cg_solve","tags":"","url":"proc/si_unstr_cg_solve.html"},{"title":"si_unstr_compute_diag – Rakali","text":"public pure subroutine si_unstr_compute_diag(mesh, ncell_total, ncell_owned, Hf_edge, eta_diag, g_theta2_dt2, mass_diag) Precompute the reciprocal of the TPFA Helmholtz operator diagonal\n(Jacobi preconditioner):\n  diag_c = M_c + (g theta&#94;2 dt&#94;2/area_c) * sum_{e in c} K_e\nstored as 1/diag.  M_c = 1 (linear) or a+floor (wet/dry, present mass_diag ).  Wall edges (Hf=0) drop out => diag -> M there. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total Cell array extent (owned + halo) — the explicit-shape dim. integer, intent(in) :: ncell_owned Owned-cell loop bound. real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(out) :: eta_diag (ncell_total) real(kind=wp), intent(in) :: g_theta2_dt2 real(kind=wp), intent(in), optional :: mass_diag (ncell_total) Calls proc~~si_unstr_compute_diag~~CallsGraph proc~si_unstr_compute_diag si_unstr_compute_diag local local proc~si_unstr_compute_diag->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_compute_diag~~CalledByGraph proc~si_unstr_compute_diag si_unstr_compute_diag proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_unstr_cg_solve->proc~si_unstr_compute_diag proc~si_ml_wetdry_newton si_ml_wetdry_newton proc~si_ml_wetdry_newton->proc~si_unstr_cg_solve proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_cg_solve proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_cg_solve proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_cg_solve proc~si_unstr_step_ml->proc~si_ml_wetdry_newton proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: diag_k logical, private :: have_mass integer, private :: i integer, private :: k real(kind=wp), private :: ke real(kind=wp), private :: ksum real(kind=wp), private :: mass_k Source Code pure subroutine si_unstr_compute_diag ( mesh , ncell_total , ncell_owned , & Hf_edge , eta_diag , g_theta2_dt2 , & mass_diag ) !! Precompute the reciprocal of the TPFA Helmholtz operator diagonal !! (Jacobi preconditioner): !!   diag_c = M_c + (g*theta&#94;2*dt&#94;2/area_c) * sum_{e in c} K_e !! stored as 1/diag.  M_c = 1 (linear) or a+floor (wet/dry, present !! `mass_diag`).  Wall edges (Hf=0) drop out => diag -> M there. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: ncell_total !! Cell array extent (owned + halo) — the explicit-shape dim. integer , intent ( in ) :: ncell_owned !! Owned-cell loop bound. real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( out ) :: eta_diag ( ncell_total ) real ( wp ), intent ( in ) :: g_theta2_dt2 real ( wp ), intent ( in ), optional :: mass_diag ( ncell_total ) integer :: k , i real ( wp ) :: ksum , ke , mass_k , diag_k logical :: have_mass have_mass = present ( mass_diag ) do concurrent ( k = 1 : ncell_owned ) local ( i , ksum , ke , mass_k , diag_k ) ksum = 0.0_wp do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then ke = Hf_edge ( i , k ) * mesh % edge_len ( i , k ) & / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) ksum = ksum + ke end if end do if ( have_mass ) then mass_k = mass_diag ( k ) else mass_k = 1.0_wp end if diag_k = mass_k + g_theta2_dt2 * ksum / mesh % area ( k ) eta_diag ( k ) = 1.0_wp / diag_k end do end subroutine si_unstr_compute_diag","tags":"","url":"proc/si_unstr_compute_diag.html"},{"title":"si_unstr_compute_rhs – Rakali","text":"public  subroutine si_unstr_compute_rhs(mesh, ncell_total, ncell_owned, eta_n, u_star, u_n, rhs, dt, theta, Hf_edge, eta_ghost_edge, g_theta2_dt2) Assemble the theta-blend RHS from the CELL edge transports:\n  RHS_c = eta&#94;n_c - (dt/area_c) * sum_{e in c} sign_e *\n            [theta U _e + (1-theta) U&#94;n_e] * len_e\n            + (coef/area_c) * sum_{Dirichlet e in c} K_e * eta_ghost_e\nU _e / U&#94;n_e are per-edge transports (double-visit (3,ncell)); the\nblend flux telescopes over interior edges (each shared by 2 cells\nwith opposite outward normals) and every wall edge carries 0\n(Hf=0 kills the predictor PGF, and U&#94;n is zeroed on dead edges), so\ntotal mass is conserved to CG tolerance + round-off by construction.\nThe Dirichlet term is the coefficient-space route: the operator\n( si_unstr_apply_helmholtz ) treats the fixed ghost eta as 0, so its\nreal value is carried here. The theta-blend is a STABILITY condition (not accuracy): bare\ndiv(U*) over-weights the explicit Laplacian by 1/theta and diverges\nat large Courant (structured proto A/B: ~1e11x growth) — same trap\nedge-wise. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total Cell array extent (owned + halo) — the explicit-shape dim. integer, intent(in) :: ncell_owned Owned-cell loop bound. real(kind=wp), intent(in) :: eta_n (ncell_total) real(kind=wp), intent(in) :: u_star (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(in) :: u_n (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(out) :: rhs (ncell_total) real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: theta real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(in) :: eta_ghost_edge (EDGES_PER_TRI,ncell_total) real(kind=wp), intent(in) :: g_theta2_dt2 Calls proc~~si_unstr_compute_rhs~~CallsGraph proc~si_unstr_compute_rhs si_unstr_compute_rhs local local proc~si_unstr_compute_rhs->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_compute_rhs~~CalledByGraph proc~si_unstr_compute_rhs si_unstr_compute_rhs proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_compute_rhs proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_compute_rhs proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_compute_rhs proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: divU real(kind=wp), private :: flux_e real(kind=wp), private :: ghost_sum integer, private :: i integer, private :: k real(kind=wp), private :: ke integer, private :: kn real(kind=wp), private :: one_m_theta Source Code subroutine si_unstr_compute_rhs ( mesh , ncell_total , ncell_owned , & eta_n , u_star , u_n , rhs , dt , theta , & Hf_edge , eta_ghost_edge , g_theta2_dt2 ) !! Assemble the theta-blend RHS from the CELL edge transports: !!   RHS_c = eta&#94;n_c - (dt/area_c) * sum_{e in c} sign_e * !!             [theta*U*_e + (1-theta)*U&#94;n_e] * len_e !!             + (coef/area_c) * sum_{Dirichlet e in c} K_e * eta_ghost_e !! U*_e / U&#94;n_e are per-edge transports (double-visit (3,ncell)); the !! blend flux telescopes over interior edges (each shared by 2 cells !! with opposite outward normals) and every wall edge carries 0 !! (Hf=0 kills the predictor PGF, and U&#94;n is zeroed on dead edges), so !! total mass is conserved to CG tolerance + round-off by construction. !! The Dirichlet term is the coefficient-space route: the operator !! (`si_unstr_apply_helmholtz`) treats the fixed ghost eta as 0, so its !! real value is carried here. !! !! The theta-blend is a STABILITY condition (not accuracy): bare !! div(U*) over-weights the explicit Laplacian by 1/theta and diverges !! at large Courant (structured proto A/B: ~1e11x growth) — same trap !! edge-wise. type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: ncell_total !! Cell array extent (owned + halo) — the explicit-shape dim. integer , intent ( in ) :: ncell_owned !! Owned-cell loop bound. real ( wp ), intent ( in ) :: eta_n ( ncell_total ) real ( wp ), intent ( in ) :: u_star ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( in ) :: u_n ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( out ) :: rhs ( ncell_total ) real ( wp ), intent ( in ) :: dt , theta real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( in ) :: eta_ghost_edge ( EDGES_PER_TRI , ncell_total ) real ( wp ), intent ( in ) :: g_theta2_dt2 integer :: k , i , kn real ( wp ) :: one_m_theta , divU , flux_e , ghost_sum , ke one_m_theta = 1.0_wp - theta do concurrent ( k = 1 : ncell_owned ) local ( i , kn , divU , flux_e , ghost_sum , ke ) divU = 0.0_wp ghost_sum = 0.0_wp do i = 1 , EDGES_PER_TRI ! Blended edge transport (m&#94;2/s); U&#94;n already zeroed on dead ! edges by the caller (R3).  +sign: leaves the cell. flux_e = theta * u_star ( i , k ) + one_m_theta * u_n ( i , k ) divU = divU + flux_e * mesh % edge_len ( i , k ) ! Dirichlet ghost coupling (boundary edge with Hf>0). kn = mesh % neighbours ( i , k ) if ( kn < 0 . and . Hf_edge ( i , k ) > 0.0_wp ) then ke = Hf_edge ( i , k ) * mesh % edge_len ( i , k ) & / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) ghost_sum = ghost_sum + ke * eta_ghost_edge ( i , k ) end if end do rhs ( k ) = eta_n ( k ) - dt * divU / mesh % area ( k ) & + g_theta2_dt2 * ghost_sum / mesh % area ( k ) end do end subroutine si_unstr_compute_rhs","tags":"","url":"proc/si_unstr_compute_rhs.html"},{"title":"si_unstr_face_depths – Rakali","text":"public pure subroutine si_unstr_face_depths(mesh, ncell_total, ncell_owned, n_bc, height, bed, bc_type, bc_eta_ext, Hf_edge, eta_ghost_edge) Uses rki_boundary_unstr proc~~si_unstr_face_depths~~UsesGraph proc~si_unstr_face_depths si_unstr_face_depths module~rki_boundary_unstr rki_boundary_unstr proc~si_unstr_face_depths->module~rki_boundary_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Build the per-edge frozen effective depth Hf_e (2D all-wet path) AND\nthe per-edge Dirichlet ghost surface eta_ghost_edge :\n  interior/partition edge: Hf = 0.5 (h_c + h_nbr); ghost unused (0).\n  WALL edge: Hf = 0 (no coupling — no-flux Neumann in the coeffs).\n  TIDAL/CLAMPED (Dirichlet) edge: the ghost surface is the prescribed\n    eta_bc; the ghost bed mirrors the cell bed so the ghost depth is\n    h_ghost = eta_bc - b_c, and Hf = 0.5 (h_c + h_ghost).  The ghost\n    eta is stashed in eta_ghost_edge(i,k) for the operator + RHS +\n    back-sub (the coefficient-space Dirichlet route). Cell-centric double-visit (3, ncell) : each cell fills its own 3\nedge values from its own height / bed + the neighbour’s height (read-only); interior edges are visited twice with the same result. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: ncell_total Cell array extent (owned + halo) — the explicit-shape dim. integer, intent(in) :: ncell_owned Owned-cell loop bound. integer, intent(in) :: n_bc BC group table size ( MAX_BC_GROUPS ). real(kind=wp), intent(in) :: height (ncell_total) Still-water depth h at cells (m). real(kind=wp), intent(in) :: bed (ncell_total) Bed elevation b at cells (m). integer, intent(in) :: bc_type (n_bc) Per-group BC type ( state%bc_type ), the boundary lookup. real(kind=wp), intent(in) :: bc_eta_ext (n_bc) Per-group Dirichlet external surface eta (m) ( state%bc_eta_ext ). real(kind=wp), intent(out) :: Hf_edge (EDGES_PER_TRI,ncell_total) Edge effective depth (m). real(kind=wp), intent(out) :: eta_ghost_edge (EDGES_PER_TRI,ncell_total) Dirichlet ghost surface eta (m) on Dirichlet boundary edges;\n0 elsewhere (unread — Hf=0 there). Calls proc~~si_unstr_face_depths~~CallsGraph proc~si_unstr_face_depths si_unstr_face_depths local local proc~si_unstr_face_depths->local proc~si_unstr_face_depth_linear si_unstr_face_depth_linear proc~si_unstr_face_depths->proc~si_unstr_face_depth_linear Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_face_depths~~CalledByGraph proc~si_unstr_face_depths si_unstr_face_depths proc~si_unstr_advance si_unstr_advance proc~si_unstr_advance->proc~si_unstr_face_depths proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_face_depths proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver