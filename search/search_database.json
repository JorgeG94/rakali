here possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private, parameter :: NZ_MAX = 64 real(kind=wp), private :: a_k real(kind=wp), private :: c_k real(kind=wp), private :: cp (NZ_MAX) real(kind=wp), private :: d_k real(kind=wp), private :: dp (NZ_MAX) real(kind=wp), private :: h_diag real(kind=wp), private :: h_val integer, private :: i real(kind=wp), private :: inv_dt2 real(kind=wp), private :: inv_dx2 real(kind=wp), private :: inv_dy2 integer, private :: j integer, private :: k Source Code pure subroutine apply_vertical_preconditioner ( h , dsig , r , z , nx , ny , nz , nghost , dx , dy , dt ) !! Public only for the unit-test suite (no production module imports it). !! Vertical-line preconditioner: solve M*z = r per (i,j) column !! !! M is the vertical tridiagonal part of the Poisson operator plus !! the horizontal diagonal contribution. Thomas algorithm per column !! (serial in k, parallel over i,j via do concurrent). integer , intent ( in ) :: nx , ny , nz , nghost real ( wp ), intent ( in ) :: h ( nx , ny ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( in ) :: r ( nx , ny , nz ) real ( wp ), intent ( out ) :: z ( nx , ny , nz ) real ( wp ), intent ( in ) :: dx , dy , dt integer , parameter :: NZ_MAX = 64 integer :: i , j , k real ( wp ) :: inv_dx2 , inv_dy2 , inv_dt2 real ( wp ) :: h_val , h_diag , a_k , c_k , d_k real ( wp ) :: cp ( NZ_MAX ), dp ( NZ_MAX ) inv_dx2 = 1.0_wp / ( dx * dx ) inv_dy2 = 1.0_wp / ( dy * dy ) inv_dt2 = 1.0_wp / ( dt * dt ) ! Horizontal diagonal contribution (same for all layers) h_diag = 2.0_wp * inv_dx2 + 2.0_wp * inv_dy2 do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , a_k , c_k , d_k , cp , dp , k ) h_val = h ( i , j ) if ( h_val > NH_MIN_DEPTH ) then ! Forward sweep (Thomas algorithm) ! k = 1: a_k = 0 (no layer below) if ( nz > 1 ) then c_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( 1 ) + dsig ( 2 )) * dsig ( 1 )) else c_k = 0.0_wp end if d_k = - ( c_k + h_val * h_diag ) cp ( 1 ) = c_k / d_k dp ( 1 ) = r ( i , j , 1 ) / d_k do k = 2 , nz ! Sub-diagonal: coupling to k-1 a_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k - 1 )) * dsig ( k )) ! Super-diagonal: coupling to k+1 if ( k < nz ) then c_k = 2.0_wp * inv_dt2 / ( h_val * ( dsig ( k ) + dsig ( k + 1 )) * dsig ( k )) else c_k = 0.0_wp end if ! Modified diagonal and RHS d_k = - ( a_k + c_k + h_val * h_diag ) - a_k * cp ( k - 1 ) cp ( k ) = c_k / d_k dp ( k ) = ( r ( i , j , k ) - a_k * dp ( k - 1 )) / d_k end do ! Back substitution z ( i , j , nz ) = dp ( nz ) do k = nz - 1 , 1 , - 1 z ( i , j , k ) = dp ( k ) - cp ( k ) * z ( i , j , k + 1 ) end do else do k = 1 , nz z ( i , j , k ) = 0.0_wp end do end if end do end subroutine apply_vertical_preconditioner","tags":"","url":"proc/apply_vertical_preconditioner.html"},{"title":"compute_depth_averaged_momentum – Rakali","text":"public pure subroutine compute_depth_averaged_momentum(h, u_layer, v_layer, dsig, hu, hv, grid, nz) Compute depth-integrated momentum from per-layer velocities\nhu = h * sum(dsig_k * u_k), hv = h * sum(dsig_k * v_k) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~compute_depth_averaged_momentum~~CallsGraph proc~compute_depth_averaged_momentum compute_depth_averaged_momentum local local proc~compute_depth_averaged_momentum->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function In