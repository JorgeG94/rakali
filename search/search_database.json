e, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: need_alloc Source Code subroutine horvisc_workspace_ensure ( nx , ny , nz ) !! Lazy-allocate the Smagorinsky momentum-snapshot scratch. integer , intent ( in ) :: nx , ny , nz logical :: need_alloc need_alloc = . false . if (. not . allocated ( horvisc_hu_pre )) then need_alloc = . true . else if ( size ( horvisc_hu_pre , 1 ) /= nx . or . & size ( horvisc_hu_pre , 2 ) /= ny . or . & size ( horvisc_hu_pre , 3 ) /= nz ) then call ml_horizontal_viscosity_cleanup () need_alloc = . true . end if if ( need_alloc ) then allocate ( horvisc_hu_pre ( nx , ny , nz ), horvisc_hv_pre ( nx , ny , nz )) !$acc enter data create(horvisc_hu_pre, horvisc_hv_pre) end if end subroutine horvisc_workspace_ensure","tags":"","url":"proc/horvisc_workspace_ensure.html"},{"title":"make_timestepper – Rakali","text":"public pure function make_timestepper(scheme) result(ts) Build the coefficient table for a scheme tag. Arguments Type Intent Optional Attributes Name integer, intent(in) :: scheme Return Value type( timestepper_t ) Called by proc~~make_timestepper~~CalledByGraph proc~make_timestepper make_timestepper proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~make_timestepper proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~make_timestepper proc~solver_unstr_step solver_unstr_step proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step_generic solver_unstr_step_generic proc~solver_unstr_step_generic->proc~make_timestepper proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_unstr_step->proc~solver_unstr_step_generic proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~driver_run_coastal driver_run_coastal proc~driver_run->proc~driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function make_timestepper ( scheme ) result ( ts ) !! Build the coefficient table for a scheme tag. integer , intent ( in ) :: scheme type ( timestepper_t ) :: ts ts % scheme = scheme select case ( scheme ) case ( TIME_EULER ) ts % n_stages = 1 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 ) = 0.0_wp ts % beta ( 1 ) = 1.0_wp ts % c ( 1 ) = 0.0_wp case ( TIME_RK3 ) ts % n_stages = 3 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 : 3 ) = [ 0.0_wp , 0.75_wp , 1.0_wp / 3.0_wp ] ts % beta ( 1 : 3 ) = [ 1.0_wp , 1.0_wp , 1.0_wp ] ts % c ( 1 : 3 ) = [ 0.0_wp , 1.0_wp , 0.5_wp ] case ( TIME_RK43 ) ts % n_stages = 4 ts % ssp_coeff = 2.0_wp ts % alpha ( 1 : 4 ) = [ 0.0_wp , 0.0_wp , 2.0_wp / 3.0_wp , 0.0_wp ] ts % beta ( 1 : 4 ) = [ 0.5_wp , 0.5_wp , 0.5_wp , 0.5_wp ] ts % c ( 1 : 4 ) = [ 0.0_wp , 0.5_wp , 1.0_wp , 0.5_wp ] case ( TIME_SEMI_IMPLICIT ) ! Semi-implicit has NO SSP stage table — solver_step dispatches it ! to si_step before any coefficient table is consulted.  Reaching ! here means a new call site asked for stage coefficients that do ! not exist; fail loud rather than silently handing back RK2. error stop \"make_timestepper: time_scheme='semi_implicit' is not \" // & \"stage-table-driven; it dispatches in solver_step (si_step).\" case default ! TIME_RK2 (Heun) ts % scheme = TIME_RK2 ts % n_stages = 2 ts % ssp_coeff = 1.0_wp ts % alpha ( 1 : 2 ) = [ 0.0_wp , 0.5_wp ] ts % beta ( 1 : 2 ) = [ 1.0_wp , 1.0_wp ] ts % c ( 1 : 2 ) = [ 0.0_wp , 1.0_wp ] end select end function make_timestepper","tags":"","url":"proc/make_timestepper.html"},{"title":"parse_time_scheme – Rakali","text":"public pure function parse_time_scheme(name) result(scheme) Map a namelist string to a TIME_* tag.  Unrecognised -> TIME_RK2. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Return Value integer Called by proc~~parse_time_scheme~~CalledByGraph proc~parse_time_scheme parse_time_scheme proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~parse_time_scheme proc~rki_unstr_set_time_scheme rki_unstr_set_time_scheme proc~rki_unstr_set_time_scheme->proc~parse_time_scheme proc~state_init_from_config state_t%state_init_from_config proc~state_init_from_config->proc~parse_time_scheme proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr proc~driver_run_coastal driver_run_coastal proc~driver_run->proc~driver_run_coastal proc~init_local_state init_local_state proc~init_local_state->proc~state_init_from_config proc~rki_create rki_create proc~rki_create->proc~state_init_from_config proc~rki_create_from_string rki_create_from_string proc~rki_create_from_string->proc~state_init_from_config proc~driver_run_coastal->proc~init_local_state proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_create proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_create_from_string Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function parse_time_scheme ( name ) result ( scheme ) !! Map a namelist string to a `TIME_*` tag.  Unrecognised -> TIME_RK2. character ( len =* ), intent ( in ) :: name integer :: scheme select case ( trim ( adjustl ( name ))) case ( \"euler\" ) scheme = TIME_EULER case ( \"rk3\" ) scheme = TIME_RK3 case ( \"rk43\" ) scheme = TIME_RK43 case ( \"semi_implicit\" ) scheme = TIME_SEMI_IMPLICIT case default ! \"rk2\" and anything unrecognised scheme = TIME_RK2 end select end function parse_time_scheme","tags":"","url":"proc/parse_time_scheme.html"},{"title":"dump_flux_io – Rakali","text":"public  subroutine dump_flux_io(filename, state) Public only for the unit-test suite (no production module imports it);\nignore when developing production code in other modules.\nSnapshot the flux-kernel inputs and outputs from state to a\nNetCDF file at filename . Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename type( state_t ), intent(in) :: state Simulation state with the flux arrays already populated by solver_compute_barotropic_flux . Calls proc~~dump_flux_io~~CallsGraph proc~dump_flux_io dump_flux_io info info proc~dump_flux_io->info proc~nc_close nc_close proc~dump_flux_io->proc~nc_close proc~nc_create_file nc_create_file proc~dump_flux_io->proc~nc_create_file proc~nc_def_dim nc_def_dim proc~dump_flux_io->proc~nc_def_dim proc~nc_def_var_2d nc_def_var_2d proc~dump_flux_io->proc~nc_def_var_2d proc~nc_enddef nc_enddef proc~dump_flux_io->proc~nc_enddef proc~nc_put_att nc_put_att proc~dump_flux_io->proc~nc_put_att proc~nc_put_att_global nc_put_att_global proc~dump_flux_io->proc~nc_put_att_global proc~nc_put_att_global_int nc_put_att_global_int proc~dump_flux_io->proc~nc_put_att_global_int proc~nc_put_var_2d nc_put_var_2d proc~dump_flux_io->proc~nc_put_var_2d proc~rki_def_var_1d rki_def_var_1d proc~dump_flux_io->proc~rki_def_var_1d proc~rki_put_var_1d rki_put_var_1d proc~dump_flux_io->proc~rki_put_var_1d nf90_close nf90_close proc~nc_close->nf90_close proc~nc_check nc_check proc~nc_close->proc~nc_check nf90_create nf90_create proc~nc_create_file->nf90_create proc~nc_create_file->proc~nc_check nf90_def_dim nf90_def_dim proc~nc_def_dim->nf90_def_dim proc~nc_def_dim->proc~nc_check nf90_def_var nf90_def_var proc~nc_def_var_2d->nf90_def_var nf90_def_var_deflate nf90_def_var_deflate proc~nc_def_var_2d->nf90_def_var_deflate proc~nc_def_var_2d->proc~nc_check nf90_enddef nf90_enddef proc~nc_enddef->nf90_enddef proc~nc_enddef->proc~nc_check nf90_put_att nf90_put_att proc~nc_put_att->nf90_put_att proc~nc_put_att->proc~nc_check proc~nc_put_att_global->nf90_put_att proc~nc_put_att_global->proc~nc_check proc~nc_put_att_global_int->nf90_put_att proc~nc_put_att_global_int->proc~nc_check nf90_put_var nf90_put_var proc~nc_put_var_2d->nf90_put_var proc~nc_put_var_2d->proc~nc_check proc~rki_def_var_1d->nf90_def_var proc~rki_def_var_1d->nf90_def_var_deflate proc~rki_def_var_1d->proc~nc_check proc~rki_put_var_1d->nf90_put_var proc~rki_put_var_1d->proc~nc_check error error proc~nc_check->error nf90_strerror nf90_strerror proc~nc_check->nf90_strerror Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: b_varid integer, private :: fh_varid integer, private :: fhu_varid integer, private :: fhv_varid integer, private :: h_varid integer, private :: hi_i integer, private :: hi_j integer, private :: hu_varid integer, private :: hv_varid integer, private :: i integer, private :: j integer, private :: lo_i integer, private :: lo_j integer, private :: mx_varid integer, private :: my_varid integer, private :: ncid integer, private :: ng integer, private :: nx integer, private :: ny integer, private :: x_int_dimid integer, private :: x_int_varid integer, private :: x_tot_dimid integer, private :: x_tot_varid real(kind=wp), private, allocatable :: x_total (:) integer, private :: y_int_dimid integer, private :: y_int_varid integer, private :: y_tot_dimid integer, private :: y_tot_varid real(kind=wp), private, allocatable :: y_total (:) Source Code subroutine dump_flux_io ( filename , state ) !! Public only for the unit-test suite (no production module imports it); !! ignore when developing production code in other modules. !! Snapshot the flux-kernel inputs and outputs from `state` to a !! NetCDF file at `filename`. character ( len =* ), intent ( in ) :: filename type ( state_t ), intent ( in ) :: state !! Simulation state with the flux arrays already populated by !! `solver_compute_barotropic_flux`. real ( wp ), allocatable :: x_total (:), y_total (:) integer :: ncid integer :: x_tot_dimid , y_tot_dimid , x_int_dimid , y_int_dimid integer :: x_tot_varid , y_tot_varid , x_int_varid , y_int_varid integer :: h_varid , hu_varid , hv_varid , b_varid integer :: fh_varid , fhu_varid , fhv_varid , mx_varid , my_varid integer :: i , j , lo_i , hi_i , lo_j , hi_j integer :: nx , ny , ng nx = state % grid % nx_total ny = state % grid % ny_total ng = state % grid % nghost lo_i = ng + 1 hi_i = nx - ng lo_j = ng + 1 hi_j = ny - ng ! Pull the slices we are about to write back from device.  No ! data region is opened — the state arrays remain device-resident ! after this call.  `if_present` makes the routine usable on a ! host-only state too (e.g. in unit tests where the caller never ! enters a data region). !$acc update self(state%barotropic%h, state%barotropic%hu, & !$acc&            state%barotropic%hv, state%barotropic%b) if_present !$acc update self(state%barotropic%flux_h(lo_i:hi_i, lo_j:hi_j), & !$acc&            state%barotropic%flux_hu(lo_i:hi_i, lo_j:hi_j), & !$acc&            state%barotropic%flux_hv(lo_i:hi_i, lo_j:hi_j), & !$acc&            state%barotropic%mass_flux_x(lo_i:hi_i, lo_j:hi_j), & !$acc&            state%barotropic%mass_flux_y(lo_i:hi_i, lo_j:hi_j)) if_present ! Cell-centre coordinates with the interior origin at x=y=0; ghost ! cells land at negative indices. allocate ( x_total ( nx ), y_total ( ny )) do i = 1 , nx x_total ( i ) = ( real ( i - ng , wp ) - 0.5_wp ) * state % grid % dx end do do j = 1 , ny y_total ( j ) = ( real ( j - ng , wp ) - 0.5_wp ) * state % grid % dy end do call logger % info ( \"Writing flux I/O dump: \" // trim ( filename )) call nc_create_file ( filename , ncid ) call nc_def_dim ( ncid , \"x_total\" , nx , x_tot_dimid ) call nc_def_dim ( ncid , \"y_total\" , ny , y_tot_dimid ) call nc_def_dim ( ncid , \"x\" , state % grid % nx_phys , x_int_dimid ) call nc_def_dim ( ncid , \"y\" , state % grid % ny_phys , y_int_dimid ) call rki_def_var_1d ( ncid , \"x_total\" , x_tot_dimid , x_tot_varid ) call nc_put_att ( ncid , x_tot_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , x_tot_varid , \"long_name\" , & \"cell-centre x including ghost layers\" ) call rki_def_var_1d ( ncid , \"y_total\" , y_tot_dimid , y_tot_varid ) call nc_put_att ( ncid , y_tot_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , y_tot_varid , \"long_name\" , & \"cell-centre y including ghost layers\" ) call rki_def_var_1d ( ncid , \"x\" , x_int_dimid , x_int_varid ) call nc_put_att ( ncid , x_int_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , x_int_varid , \"long_name\" , & \"cell-centre x of interior cells\" ) call nc_put_att ( ncid , x_int_varid , \"axis\" , \"X\" ) call rki_def_var_1d ( ncid , \"y\" , y_int_dimid , y_int_varid ) call nc_put_att ( ncid , y_int_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , y_int_varid , \"long_name\" , & \"cell-centre y of interior cells\" ) call nc_put_att ( ncid , y_int_varid , \"axis\" , \"Y\" ) ! Inputs: full ghost-padded arrays. Each interior cell (i, j) reads ! the 9-point cross stencil (i-2..i+2, j) and (i, j-2..j+2). call nc_def_var_2d ( ncid , \"h\" , [ x_tot_dimid , y_tot_dimid ], h_varid ) call nc_put_att ( ncid , h_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , h_varid , \"long_name\" , \"input water depth\" ) call nc_def_var_2d ( ncid , \"hu\" , [ x_tot_dimid , y_tot_dimid ], hu_varid ) call nc_put_att ( ncid , hu_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , hu_varid , \"long_name\" , \"input x-momentum (h*u)\" ) call nc_def_var_2d ( ncid , \"hv\" , [ x_tot_dimid , y_tot_dimid ], hv_varid ) call nc_put_att ( ncid , hv_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , hv_varid , \"long_name\" , \"input y-momentum (h*v)\" ) call nc_def_var_2d ( ncid , \"b\" , [ x_tot_dimid , y_tot_dimid ], b_varid ) call nc_put_att ( ncid , b_varid , \"units\" , \"m\" ) call nc_put_att ( ncid , b_varid , \"long_name\" , & \"input bottom elevation (positive up)\" ) ! Outputs: interior only. call nc_def_var_2d ( ncid , \"flux_h\" , [ x_int_dimid , y_int_dimid ], fh_varid ) call nc_put_att ( ncid , fh_varid , \"units\" , \"m s-1\" ) call nc_put_att ( ncid , fh_varid , \"long_name\" , & \"net flux divergence of h\" ) call nc_def_var_2d ( ncid , \"flux_hu\" , [ x_int_dimid , y_int_dimid ], fhu_varid ) call nc_put_att ( ncid , fhu_varid , \"units\" , \"m2 s-2\" ) call nc_put_att ( ncid , fhu_varid , \"long_name\" , & \"net flux divergence of hu (with well-balanced correction)\" ) call nc_def_var_2d ( ncid , \"flux_hv\" , [ x_int_dimid , y_int_dimid ], fhv_varid ) call nc_put_att ( ncid , fhv_varid , \"units\" , \"m2 s-2\" ) call nc_put_att ( ncid , fhv_varid , \"long_name\" , & \"net flux divergence of hv (with well-balanced correction)\" ) call nc_def_var_2d ( ncid , \"mass_flux_x\" , [ x_int_dimid , y_int_dimid ], mx_varid ) call nc_put_att ( ncid , mx_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , mx_varid , \"long_name\" , & \"HLL h-flux at right face (i+1/2)\" ) call nc_def_var_2d ( ncid , \"mass_flux_y\" , [ x_int_dimid , y_int_dimid ], my_varid ) call nc_put_att ( ncid , my_varid , \"units\" , \"m2 s-1\" ) call nc_put_att ( ncid , my_varid , \"long_name\" , & \"HLL h-flux at top face (j+1/2)\" ) call nc_put_att_global ( ncid , \"title\" , & \"Per-interior-cell I/O snapshot for the barotropic flux kernel\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali rki_flux_dump\" ) if ( state % barotropic % use_hllc ) then call nc_put_att_global ( ncid , \"solver\" , \"HLLC\" ) else call nc_put_att_global ( ncid , \"solver\" , \"HLL\" ) end if call nc_put_att_global_int ( ncid , \"nghost\" , ng ) call nc_put_att_global_int ( ncid , \"nx_phys\" , state % grid % nx_phys ) call nc_put_att_global_int ( ncid , \"ny_phys\" , state % grid % ny_phys ) call nc_enddef ( ncid ) call rki_put_var_1d ( ncid , x_tot_varid , x_total ) call rki_put_var_1d ( ncid , y_tot_varid , y_total ) call rki_put_var_1d ( ncid , x_int_varid , x_total ( lo_i : hi_i )) call rki_put_var_1d ( ncid , y_int_varid , y_total ( lo_j : hi_j )) call nc_put_var_2d ( ncid , h_varid , state % barotropic % h ) call nc_put_var_2d ( ncid , hu_varid , state % barotropic % hu ) call nc_put_var_2d ( ncid , hv_varid , state % barotropic % hv ) call nc_put_var_2d ( ncid , b_varid , state % barotropic % b ) call nc_put_var_2d ( ncid , fh_varid , & state % barotropic % flux_h ( lo_i : hi_i , lo_j : hi_j )) call nc_put_var_2d ( ncid , fhu_varid , & state % barotropic % flux_hu ( lo_i : hi_i , lo_j : hi_j )) call nc_put_var_2d ( ncid , fhv_varid , & state % barotropic % flux_hv ( lo_i : hi_i , lo_j : hi_j )) call nc_put_var_2d ( ncid , mx_varid , & state % barotropic % mass_flux_x ( lo_i : hi_i , lo_j : hi_j )) call nc_put_var_2d ( ncid , my_varid , & state % barotropic % mass_flux_y ( lo_i : hi_i , lo_j : hi_j )) call nc_close ( ncid ) end subroutine dump_flux_io","tags":"","url":"proc/dump_flux_io.html"},{"title":"compute_total_mass – Rakali","text":"public  function compute_total_mass(s) result(mass) Sum h * dx * dy over interior cells via OpenACC reduction (only\nthe scalar crosses the PCIe bus). Runs on host or device; NaN /\ndry-cell garbage is filtered. Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s Return Value real(kind=wp) Calls proc~~compute_total_mass~~CallsGraph proc~compute_total_mass compute_total_mass local local proc~compute_total_mass->local reduce reduce proc~compute_total_mass->reduce Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_total_mass~~CalledByGraph proc~compute_total_mass compute_total_mass proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~compute_total_mass proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~compute_total_mass proc~init_local_state init_local_state proc~driver_run_coastal->proc~init_local_state proc~emit_periodic_status emit_periodic_status proc~driver_run_coastal->proc~emit_periodic_status proc~init_local_state->proc~compute_total_mass proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal proc~emit_periodic_status->proc~coastal_console_stats_report Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: acc real(kind=wp), private :: cell_area real(kind=wp), private :: h_ij integer, private :: i integer, private :: i_hi integer, private :: i_lo integer, private :: j integer, private :: j_hi integer, private :: j_lo integer, private :: ng Source Code function compute_total_mass ( s ) result ( mass ) !! Sum h * dx * dy over interior cells via OpenACC reduction (only !! the scalar crosses the PCIe bus). Runs on host or device; NaN / !! dry-cell garbage is filtered. type ( state_t ), intent ( inout ) :: s real ( wp ) :: mass integer :: i , j , ng , i_lo , i_hi , j_lo , j_hi real ( wp ) :: cell_area , h_ij , acc ng = s % grid % nghost i_lo = ng + 1 i_hi = s % grid % nx_total - ng j_lo = ng + 1 j_hi = s % grid % ny_total - ng cell_area = s % grid % dx * s % grid % dy acc = 0.0_wp ! present_or_copyin makes this runnable in production (s mapped via ! solver_enter_data) and in standalone unit tests (nothing mapped): ! OpenMP target is strict and demands explicit map() when the data ! isn't already on device, unlike OpenACC's implicit copy. do concurrent ( j = j_lo : j_hi , i = i_lo : i_hi ) local ( h_ij ) reduce ( + : acc ) h_ij = s % barotropic % h ( i , j ) if ( h_ij > 0.0_wp . and . h_ij < 1.0e6_wp ) then acc = acc + h_ij * cell_area end if end do mass = acc end function compute_total_mass","tags":"","url":"proc/compute_total_mass.html"},{"title":"compute_layer_sums – Rakali","text":"public  subroutine compute_layer_sums(s, sum_h, sum_hS, sum_hT) Sum h_layer, hS_layer, hT_layer over interior wet cells and layers,\nreducing on device (three scalars cross the PCIe bus). Caller forms\nsum_hS/sum_h and sum_hT/sum_h for volume-weighted mean S and T. Outer shim: dereferences the tracer registry on host and hands flat\n3D arrays to the inner impl — accessing s%multilayer%tracers(it)%hTr(i,j,k) inside the kernel triggers\nCUDA_ERROR_ILLEGAL_ADDRESS on NVHPC (array-of-derived-types\ndescriptor not reachable device-side). Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s real(kind=wp), intent(out) :: sum_h real(kind=wp), intent(out) :: sum_hS real(kind=wp), intent(out) :: sum_hT Calls proc~~compute_layer_sums~~CallsGraph proc~compute_layer_sums compute_layer_sums proc~compute_layer_sums_impl compute_layer_sums_impl proc~compute_layer_sums->proc~compute_layer_sums_impl local local proc~compute_layer_sums_impl->local reduce reduce proc~compute_layer_sums_impl->reduce Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~compute_layer_sums~~CalledByGraph proc~compute_layer_sums compute_layer_sums proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~compute_layer_sums proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine compute_layer_sums ( s , sum_h , sum_hS , sum_hT ) !! Sum h_layer, hS_layer, hT_layer over interior wet cells and layers, !! reducing on device (three scalars cross the PCIe bus). Caller forms !! sum_hS/sum_h and sum_hT/sum_h for volume-weighted mean S and T. !! !! Outer shim: dereferences the tracer registry on host and hands flat !! 3D arrays to the inner impl — accessing !! `s%multilayer%tracers(it)%hTr(i,j,k)` inside the kernel triggers !! CUDA_ERROR_ILLEGAL_ADDRESS on NVHPC (array-of-derived-types !! descriptor not reachable device-side). type ( state_t ), intent ( inout ) :: s real ( wp ), intent ( out ) :: sum_h , sum_hS , sum_hT sum_h = 0.0_wp sum_hS = 0.0_wp sum_hT = 0.0_wp if (. not . s % use_multilayer ) return call compute_layer_sums_impl ( s % multilayer % h_layer , & s % multilayer % tracers ( s % multilayer % idx_salinity )% hTr , & s % multilayer % tracers ( s % multilayer % idx_temperature )% hTr , & s % grid , s % multilayer % nz_ml , & sum_h , sum_hS , sum_hT ) end subroutine compute_layer_sums","tags":"","url":"proc/compute_layer_sums.html"},{"title":"diagnose_bathymetry – Rakali","text":"public  subroutine diagnose_bathymetry(s, cfg) Report bathymetry diagnostics and warn about potential CFL issues:\nextreme depths, steep wet-to-wet gradients, shallow-next-to-deep\ncells (velocity blowup risk), and the estimated CFL timestep. Arguments Type Intent Optional Attributes Name type( state_t ), intent(in) :: s type( config_t ), intent(in) :: cfg Calls proc~~diagnose_bathymetry~~CallsGraph proc~diagnose_bathymetry diagnose_bathymetry info info proc~diagnose_bathymetry->info to_string to_string proc~diagnose_bathymetry->to_string warning warning proc~diagnose_bathymetry->warning Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~diagnose_bathymetry~~CalledByGraph proc~diagnose_bathymetry diagnose_bathymetry proc~init_local_state init_local_state proc~init_local_state->proc~diagnose_bathymetry proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: DEPTH_RATIO_WARN = 20.0_wp dimensionless real(kind=wp), private, parameter :: STEEP_THRESHOLD = 10.0_wp m/cell real(kind=wp), private :: b_max real(kind=wp), private :: b_min real(kind=wp), private :: depth_ratio real(kind=wp), private :: dt_est real(kind=wp), private :: dx_min real(kind=wp), private :: grad real(kind=wp), private :: h_here real(kind=wp), private :: h_max real(kind=wp), private :: h_nbr integer, private :: i integer, private :: j real(kind=wp), private :: max_grad_i real(kind=wp), private :: max_grad_j integer, private :: n_shallow_deep integer, private :: n_steep integer, private :: n_wet integer, private :: ng integer, private :: ratio_i integer, private :: ratio_j integer, private :: steep_i integer, private :: steep_j real(kind=wp), private :: worst_ratio Source Code subroutine diagnose_bathymetry ( s , cfg ) !! Report bathymetry diagnostics and warn about potential CFL issues: !! extreme depths, steep wet-to-wet gradients, shallow-next-to-deep !! cells (velocity blowup risk), and the estimated CFL timestep. type ( state_t ), intent ( in ) :: s type ( config_t ), intent ( in ) :: cfg integer :: i , j , ng real ( wp ) :: b_min , b_max , h_max , dt_est , dx_min real ( wp ) :: grad , max_grad_i , max_grad_j real ( wp ) :: h_here , h_nbr , depth_ratio , worst_ratio integer :: n_wet , n_steep , n_shallow_deep integer :: steep_i , steep_j , ratio_i , ratio_j real ( wp ), parameter :: STEEP_THRESHOLD = 1 0.0_wp !! m/cell real ( wp ), parameter :: DEPTH_RATIO_WARN = 2 0.0_wp !! dimensionless ng = s % grid % nghost b_min = huge ( 1.0_wp ) b_max = - huge ( 1.0_wp ) h_max = 0.0_wp n_wet = 0 n_steep = 0 n_shallow_deep = 0 max_grad_i = 0.0_wp max_grad_j = 0.0_wp steep_i = 0 steep_j = 0 worst_ratio = 0.0_wp ratio_i = 0 ratio_j = 0 do j = ng + 1 , s % grid % ny_total - ng do i = ng + 1 , s % grid % nx_total - ng ! Basic stats if ( s % barotropic % b ( i , j ) < b_min ) b_min = s % barotropic % b ( i , j ) if ( s % barotropic % b ( i , j ) > b_max ) b_max = s % barotropic % b ( i , j ) if ( s % barotropic % h ( i , j ) > h_max ) h_max = s % barotropic % h ( i , j ) if ( s % barotropic % h ( i , j ) > 0.0_wp ) n_wet = n_wet + 1 ! Wet-to-wet gradient in i-direction if ( s % barotropic % h ( i , j ) > 0.0_wp . and . i < s % grid % nx_total - ng ) then if ( s % barotropic % h ( i + 1 , j ) > 0.0_wp ) then grad = abs ( s % barotropic % b ( i + 1 , j ) - s % barotropic % b ( i , j )) if ( grad > max_grad_i ) then max_grad_i = grad steep_i = i - ng steep_j = j - ng end if if ( grad > STEEP_THRESHOLD ) n_steep = n_steep + 1 end if end if ! Wet-to-wet gradient in j-direction if ( s % barotropic % h ( i , j ) > 0.0_wp . and . j < s % grid % ny_total - ng ) then if ( s % barotropic % h ( i , j + 1 ) > 0.0_wp ) then grad = abs ( s % barotropic % b ( i , j + 1 ) - s % barotropic % b ( i , j )) if ( grad > max_grad_j ) then max_grad_j = grad end if if ( grad > STEEP_THRESHOLD ) n_steep = n_steep + 1 end if end if ! Shallow cell next to deep cell (velocity blowup risk) h_here = s % barotropic % h ( i , j ) if ( h_here > 0.01_wp . and . h_here < 2.0_wp ) then ! Check all 4 neighbours if ( i > ng + 1 ) then h_nbr = s % barotropic % h ( i - 1 , j ) if ( h_nbr > 0.01_wp ) then depth_ratio = h_nbr / h_here if ( depth_ratio > DEPTH_RATIO_WARN ) then n_shallow_deep = n_shallow_deep + 1 if ( depth_ratio > worst_ratio ) then worst_ratio = depth_ratio ratio_i = i - ng ratio_j = j - ng end if end if end if end if if ( i < s % grid % nx_total - ng ) then h_nbr = s % barotropic % h ( i + 1 , j ) if ( h_nbr > 0.01_wp ) then depth_ratio = h_nbr / h_here if ( depth_ratio > DEPTH_RATIO_WARN ) then n_shallow_deep = n_shallow_deep + 1 if ( depth_ratio > worst_ratio ) then worst_ratio = depth_ratio ratio_i = i - ng ratio_j = j - ng end if end if end if end if end if end do end do ! Report call logger % info ( \"  Bathymetry diagnostics:\" ) call logger % info ( \"    Elevation: [\" // to_string ( b_min ) // \", \" // & to_string ( b_max ) // \"] m\" ) call logger % info ( \"    Wet cells: \" // to_string ( n_wet ) // \" / \" // & to_string (( s % grid % nx_total - 2 * ng ) * ( s % grid % ny_total - 2 * ng ))) call logger % info ( \"    Max water depth: \" // to_string ( h_max ) // \" m\" ) ! Estimated CFL timestep dx_min = min ( cfg % dx , cfg % dy ) if ( h_max > 0.0_wp ) then dt_est = cfg % cfl * dx_min / sqrt ( GRAVITY * h_max ) call logger % info ( \"    Est. CFL dt (from depth alone): \" // & to_string ( dt_est ) // \" s\" ) end if ! Gradient warnings if ( max_grad_i > STEEP_THRESHOLD . or . max_grad_j > STEEP_THRESHOLD ) then call logger % warning ( \"    Steep wet-to-wet bathymetry gradient detected!\" ) call logger % warning ( \"      Max i-gradient: \" // to_string ( max_grad_i ) // & \" m/cell at (\" // to_string ( steep_i ) // \", \" // & to_string ( steep_j ) // \")\" ) call logger % warning ( \"      Max j-gradient: \" // to_string ( max_grad_j ) // \" m/cell\" ) call logger % warning ( \"      Total cells > \" // to_string ( STEEP_THRESHOLD ) // & \" m/cell: \" // to_string ( n_steep )) else call logger % info ( \"    Max gradient: \" // to_string ( max ( max_grad_i , max_grad_j )) // & \" m/cell (OK)\" ) end if ! Shallow-deep warnings if ( n_shallow_deep > 0 ) then call logger % warning ( \"    Shallow cells adjacent to deep cells: \" // & to_string ( n_shallow_deep )) call logger % warning ( \"      Worst depth ratio: \" // to_string ( worst_ratio ) // & \":1 at (\" // to_string ( ratio_i ) // \", \" // & to_string ( ratio_j ) // \")\" ) call logger % warning ( \"      This can cause extreme velocities and tiny timesteps\" ) end if end subroutine diagnose_bathymetry","tags":"","url":"proc/diagnose_bathymetry.html"},{"title":"init_castro_dam_break – Rakali","text":"public  subroutine init_castro_dam_break(s) Initialise the circular dam break from Castro et al. (2011):\ndomain [-5,5]&#94;2, Gaussian bump bathymetry, circular water column\n(r <= 0.6: eta = 3, else eta = 1). Public only for the unit-test suite. Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s Called by proc~~init_castro_dam_break~~CalledByGraph proc~init_castro_dam_break init_castro_dam_break proc~init_from_config init_from_config proc~init_from_config->proc~init_castro_dam_break proc~rki_finalize rki_finalize proc~rki_finalize->proc~init_from_config proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_finalize proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_finalize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: h_depth integer, private :: i integer, private :: j real(kind=wp), private :: r2 real(kind=wp), private :: x real(kind=wp), private :: x0 real(kind=wp), private :: y real(kind=wp), private :: y0 Source Code subroutine init_castro_dam_break ( s ) !! Initialise the circular dam break from Castro et al. (2011): !! domain [-5,5]&#94;2, Gaussian bump bathymetry, circular water column !! (r <= 0.6: eta = 3, else eta = 1). Public only for the unit-test suite. type ( state_t ), intent ( inout ) :: s integer :: i , j real ( wp ) :: x , y , r2 , h_depth , x0 , y0 ! Domain origin: cell centres span [-5, 5] in both directions x0 = - 0.5_wp * real ( s % grid % nx_phys , wp ) * s % grid % dx y0 = - 0.5_wp * real ( s % grid % ny_phys , wp ) * s % grid % dy do j = 1 , s % grid % ny_total do i = 1 , s % grid % nx_total ! Cell centre coordinates x = x0 + ( real ( i - s % grid % nghost , wp ) - 0.5_wp ) * s % grid % dx y = y0 + ( real ( j - s % grid % nghost , wp ) - 0.5_wp ) * s % grid % dy ! Castro's depth function: H = 1 - 0.4 * exp(-x&#94;2 - y&#94;2) h_depth = 1.0_wp - 0.4_wp * exp ( - x * x - y * y ) ! Tidal bathymetry: B = -H (positive up convention) s % barotropic % b ( i , j ) = - h_depth ! Radial distance squared from origin r2 = x * x + y * y ! Initial water depth: h = eta - B if ( r2 <= 0.36_wp ) then ! Inside circle (r <= 0.6): free surface eta = 3.0 s % barotropic % h ( i , j ) = 3.0_wp - s % barotropic % b ( i , j ) else ! Outside circle: free surface eta = 1.0 s % barotropic % h ( i , j ) = 1.0_wp - s % barotropic % b ( i , j ) end if ! Zero initial momentum s % barotropic % hu ( i , j ) = 0.0_wp s % barotropic % hv ( i , j ) = 0.0_wp end do end do end subroutine init_castro_dam_break","tags":"","url":"proc/init_castro_dam_break.html"},{"title":"init_dam_break – Rakali","text":"public  subroutine init_dam_break(s) Initialise a 1D dam break (left half h=2m, right half h=1m, no\nvelocity). Bathymetry preserved if already loaded, else zeroed.\nPublic only for the unit-test suite. Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s Called by proc~~init_dam_break~~CalledByGraph proc~init_dam_break init_dam_break proc~init_from_config init_from_config proc~init_from_config->proc~init_dam_break proc~rki_finalize rki_finalize proc~rki_finalize->proc~init_from_config proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_finalize proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_finalize Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private, parameter :: H_LEFT = 2.0_wp real(kind=wp), private, parameter :: H_RIGHT = 1.0_wp logical, private :: has_bathymetry integer, private :: i integer, private :: j integer, private :: mid_x Source Code subroutine init_dam_break ( s ) !! Initialise a 1D dam break (left half h=2m, right half h=1m, no !! velocity). Bathymetry preserved if already loaded, else zeroed. !! Public only for the unit-test suite. type ( state_t ), intent ( inout ) :: s integer :: i , j , mid_x real ( wp ), parameter :: H_LEFT = 2.0_wp real ( wp ), parameter :: H_RIGHT = 1.0_wp logical :: has_bathymetry mid_x = s % grid % nghost + s % grid % nx_phys / 2 ! Check if bathymetry was already loaded (non-zero values present) has_bathymetry = any ( s % barotropic % b /= 0.0_wp ) do j = 1 , s % grid % ny_total do i = 1 , s % grid % nx_total if (. not . has_bathymetry ) s % barotropic % b ( i , j ) = 0.0_wp s % barotropic % hu ( i , j ) = 0.0_wp s % barotropic % hv ( i , j ) = 0.0_wp if ( i <= mid_x ) then s % barotropic % h ( i , j ) = H_LEFT else s % barotropic % h ( i , j ) = H_RIGHT end if end do end do end subroutine init_dam_break","tags":"","url":"proc/init_dam_break.html"},{"title":"init_from_config – Rakali","text":"public  subroutine init_from_config(s, cfg) Select and apply initial condition based on config Arguments Type Intent Optional Attributes Name type( state_t ), intent(inout) :: s type( config_t ), intent(in) :: cfg Calls proc~~init_from_config~~CallsGraph proc~init_from_config init_from_config proc~init_castro_dam_break init_castro_dam_break proc~init_from_config->proc~init_castro_dam_break proc~init_dam_break init_dam_break proc~init_from_config->proc~init_dam_break proc~init_gaussian_hump init_gaussian_hump proc~init_from_config->proc~init_gaussian_hump proc~init_multilayer_from_barotropic init_multilayer_from_barotropic proc~init_from_config->proc~init_multilayer_from_barotropic proc~init_still_water init_still_water proc~init_from_config->proc~init_still_water info info proc