llowing: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: varid Source Code subroutine read_parent_grid ( nest , ncid ) type ( nesting_t ), intent ( inout ) :: nest integer , intent ( in ) :: ncid integer :: varid call nc_get_dim_len ( ncid , \"x\" , nest % p_nx ) call nc_get_dim_len ( ncid , \"y\" , nest % p_ny ) call nc_get_dim_len ( ncid , \"time\" , nest % p_nt ) allocate ( nest % p_x ( nest % p_nx )) allocate ( nest % p_y ( nest % p_ny )) allocate ( nest % p_time ( nest % p_nt )) call nc_get_varid ( ncid , \"x\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_x ), \"reading parent x\" ) call nc_get_varid ( ncid , \"y\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_y ), \"reading parent y\" ) call nc_get_varid ( ncid , \"time\" , varid ) call nc_check ( nf90_get_var ( ncid , varid , nest % p_time ), \"reading parent time\" ) end subroutine read_parent_grid","tags":"","url":"proc/read_parent_grid.html"},{"title":"kpp_shape – Rakali","text":"public pure function kpp_shape(sigma) result(g) KPP cubic shape function G(sigma) = sigma·(1-sigma)² (LMD94), valid for\n0 <= sigma <= 1. Exposed only for unit tests; hot kernels inline the\none-line form to avoid a device cross-call. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: sigma Return Value real(kind=wp) Source Code pure function kpp_shape ( sigma ) result ( g ) !! KPP cubic shape function G(sigma) = sigma·(1-sigma)² (LMD94), valid for !! 0 <= sigma <= 1. Exposed only for unit tests; hot kernels inline the !! one-line form to avoid a device cross-call. real ( wp ), intent ( in ) :: sigma real ( wp ) :: g g = sigma * ( 1.0_wp - sigma ) * ( 1.0_wp - sigma ) end function kpp_shape","tags":"","url":"proc/kpp_shape.html"},{"title":"ml_kpp_boundary_layer – Rakali","text":"public pure subroutine ml_kpp_boundary_layer(h_layer, hu_layer, hv_layer, rho_layer, hS_layer, rho_0, alpha_T, beta_S, cp, wind_x, wind_y, heat_flux, evap_minus_precip, ri_crit, c_vt2, u_star, buoy_flux, bl_depth, grid, nz) Pass 1: per-column u_ , B_0, and bulk-Ri boundary-layer depth h_b.\n  u_ = sqrt(|tau|/rho_0), tau = surface wind stress (Pa).\n  B_0 = g·(alpha_T·F_T - beta_S·F_S), kinematic fluxes\n        F_T = Q_heat/(rho_0·cp), F_S = (E-P)·S_top; B_0 < 0 destabilizing.\n  h_b : top-down bulk-Ri sweep; crossing of ri_crit interpolated.\n        V_t²(d) = (c_vt2/ri_crit)·d·N(d)·w_s uses lagged bl_depth (zero on first call ⇒ self-bootstrapping). No crossing ⇒ h_b = H. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: alpha_T real(kind=wp), intent(in) :: beta_S real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: ri_crit real(kind=wp),