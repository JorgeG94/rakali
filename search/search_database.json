r use pic_strings , only : to_string implicit none private public :: gauge_unstr_t public :: gauges_unstr_init public :: gauges_unstr_write public :: gauges_unstr_close integer , parameter :: MAX_GAUGES = 200 real ( wp ), parameter :: MIN_DEPTH = 1.0e-6_wp type :: gauge_unstr_t !! Manages gauge point output integer :: n_gauges = 0 !! total number of gauges requested integer :: n_local = 0 !! gauges on this rank integer , allocatable :: cell_id (:) !! triangle containing each local gauge real ( wp ), allocatable :: lam1 (:) !! barycentric weight for vertex 1 real ( wp ), allocatable :: lam2 (:) !! barycentric weight for vertex 2 real ( wp ), allocatable :: lam3 (:) !! barycentric weight for vertex 3 real ( wp ), allocatable :: gauge_x (:) !! x-coordinate of local gauges real ( wp ), allocatable :: gauge_y (:) !! y-coordinate of local gauges ! NetCDF state integer :: ncid = - 1 integer :: time_varid = - 1 integer :: eta_varid = - 1 integer :: u_varid = - 1 integer :: v_varid = - 1 integer :: time_index = 0 end type gauge_unstr_t contains ! ================================================================ ! Geometry helpers ! ================================================================ pure function point_in_triangle ( px , py , x1 , y1 , x2 , y2 , x3 , y3 ) result ( inside ) !! Test if point (px,py) is inside triangle (x1,y1)-(x2,y2)-(x3,y3). !! Uses sign-of-cross-product method. real ( wp ), intent ( in ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 logical :: inside real ( wp ) :: d1 , d2 , d3 logical :: has_neg , has_pos d1 = ( px - x2 ) * ( y1 - y2 ) - ( x1 - x2 ) * ( py - y2 ) d2 = ( px - x3 ) * ( y2 - y3 ) - ( x2 - x3 ) * ( py - y3 ) d3 = ( px - x1 ) * ( y3 - y1 ) - ( x3 - x1 ) * ( py - y1 ) has_neg = ( d1 < 0.0_wp ) . or . ( d2 < 0.0_wp ) . or . ( d3 < 0.0_wp ) has_pos = ( d1 > 0.0_wp ) . or . ( d2 > 0.0_wp ) . or . ( d3 > 0.0_wp ) inside = . not . ( has_neg . and . has_pos ) end function point_in_triangle pure subroutine barycentric_weights ( px , py , x1 , y1 , x2 , y2 , x3 , y3 , & l1 , l2 , l3 ) !! Compute barycentric coordinates of (px,py) in triangle !! (x1,y1)-(x2,y2)-(x3,y3). real ( wp ), intent ( in ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 real ( wp ), intent ( out ) :: l1 , l2 , l3 real ( wp ) :: det det = ( y2 - y3 ) * ( x1 - x3 ) + ( x3 - x2 ) * ( y1 - y3 ) if ( abs ( det ) < 1.0e-30_wp ) then l1 = 1.0_wp / 3.0_wp l2 = 1.0_wp / 3.0_wp l3 = 1.0_wp / 3.0_wp return end if l1 = (( y2 - y3 ) * ( px - x3 ) + ( x3 - x2 ) * ( py - y3 )) / det l2 = (( y3 - y1 ) * ( px - x3 ) + ( x1 - x3 ) * ( py - y3 )) / det l3 = 1.0_wp - l1 - l2 end subroutine barycentric_weights ! ================================================================ ! Init: locate gauges + create NetCDF file ! ================================================================ subroutine gauges_unstr_init ( gauges , filename , mesh , n_gauges , gx , gy ) !! Initialise gauge output. !! !! Searches owned triangles for each gauge point, computes !! barycentric weights, and creates the output NetCDF file. !! Gauges not found in any owned triangle are skipped. type ( gauge_unstr_t ), intent ( out ) :: gauges character ( len =* ), intent ( in ) :: filename type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: n_gauges real ( wp ), intent ( in ) :: gx ( n_gauges ) !! gauge x-coordinates real ( wp ), intent ( in ) :: gy ( n_gauges ) !! gauge y-coordinates integer :: ig , k , v1 , v2 , v3 , n_local real ( wp ) :: px , py , x1 , y1 , x2 , y2 , x3 , y3 , l1 , l2 , l3 integer :: local_cell ( n_gauges ) real ( wp ) :: local_l1 ( n_gauges ), local_l2 ( n_gauges ), local_l3 ( n_gauges ) real ( wp ) :: local_gx ( n_gauges ), local_gy ( n_gauges ) logical :: found gauges % n_gauges = n_gauges ! Brute-force point-in-triangle search (runs once at init) n_local = 0 do ig = 1 , n_gauges px = gx ( ig ) py = gy ( ig ) found = . false . do k = 1 , mesh % ncells_owned v1 = mesh % tri_v ( 1 , k ) v2 = mesh % tri_v ( 2 , k ) v3 = mesh % tri_v ( 3 , k ) x1 = mesh % vert_x ( v1 ) y1 = mesh % vert_y ( v1 ) x2 = mesh % vert_x ( v2 ) y2 = mesh % vert_y ( v2 ) x3 = mesh % vert_x ( v3 ) y3 = mesh % vert_y ( v3 ) if ( point_in_triangle ( px , py , x1 , y1 , x2 , y2 , x3 , y3 )) then n_local = n_local + 1 local_cell ( n_local ) = k call barycentric_weights ( px , py , x1 , y1 , x2 , y2 , x3 , y3 , & l1 , l2 , l3 ) local_l1 ( n_local ) = l1 local_l2 ( n_local ) = l2 local_l3 ( n_local ) = l3 local_gx ( n_local ) = px local_gy ( n_local ) = py found = . true . exit end if end do if (. not . found ) then call logger % debug ( \"Gauge \" // to_string ( ig ) // \" at (\" // & to_string ( px ) // \", \" // to_string ( py ) // & \") not in owned cells — skipped\" ) end if end do gauges % n_local = n_local if ( n_local == 0 ) then call logger % info ( \"No gauges on this rank\" ) return end if ! Store local gauge data allocate ( gauges % cell_id ( n_local )) allocate ( gauges % lam1 ( n_local ), gauges % lam2 ( n_local ), gauges % lam3 ( n_local )) allocate ( gauges % gauge_x ( n_local ), gauges % gauge_y ( n_local )) gauges % cell_id = local_cell ( 1 : n_local ) gauges % lam1 = local_l1 ( 1 : n_local ) gauges % lam2 = local_l2 ( 1 : n_local ) gauges % lam3 = local_l3 ( 1 : n_local ) gauges % gauge_x = local_gx ( 1 : n_local ) gauges % gauge_y = local_gy ( 1 : n_local ) ! Create NetCDF output file call create_gauge_netcdf ( gauges , filename , mesh ) call logger % info ( \"Gauges initialised: \" // to_string ( n_local ) // \" of \" // & to_string ( n_gauges ) // \" on this rank → \" // trim ( filename )) end subroutine gauges_unstr_init subroutine create_gauge_netcdf ( gauges , filename , mesh ) !! Create CF-1.8 station NetCDF file for gauge output. type ( gauge_unstr_t ), intent ( inout ) :: gauges character ( len =* ), intent ( in ) :: filename type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: ncid , station_dimid , time_dimid integer :: sx_varid , sy_varid , sb_varid integer :: time_varid , eta_varid , u_varid , v_varid integer :: ig , k real ( wp ) :: bed_interp ( gauges % n_local ) call nc_create_file ( trim ( filename ), ncid ) call nc_put_att_global ( ncid , \"Conventions\" , \"CF-1.8\" ) call nc_put_att_global ( ncid , \"title\" , \"Rakali unstructured gauge time series\" ) call nc_put_att_global ( ncid , \"source\" , \"Rakali\" ) call nc_def_dim ( ncid , \"station\" , gauges % n_local , station_dimid ) call nc_def_dim ( ncid , \"time\" , nf90_unlimited , time_dimid ) ! Station coordinates call rki_def_var_1d ( ncid , \"station_x\" , station_dimid , sx_varid ) call nc_put_att ( ncid , sx_varid , \"long_name\" , \"Gauge x-coordinate\" ) call nc_put_att ( ncid , sx_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"station_y\" , station_dimid , sy_varid ) call nc_put_att ( ncid , sy_varid , \"long_name\" , \"Gauge y-coordinate\" ) call nc_put_att ( ncid , sy_varid , \"units\" , \"m\" ) call rki_def_var_1d ( ncid , \"station_b\" , station_dimid , sb_varid ) call nc_put_att ( ncid , sb_varid , \"long_name\" , \"Interpolated bed elevation\" ) call nc_put_att ( ncid , sb_varid , \"units\" , \"m\" ) ! Time call rki_def_var_1d ( ncid , \"time\" , time_dimid , time_varid ) call nc_put_att ( ncid , time_varid , \"units\" , \"seconds since simulation start\" ) call nc_put_att ( ncid , time_varid , \"calendar\" , \"none\" ) call nc_put_att ( ncid , time_varid , \"axis\" , \"T\" ) ! Time-varying fields (station, time) call nc_def_var_2d ( ncid , \"eta\" , [ station_dimid , time_dimid ], eta_varid ) call nc_put_att ( ncid , eta_varid , \"long_name\" , \"Water surface elevation\" ) call nc_put_att ( ncid , eta_varid , \"units\" , \"m\" ) call nc_def_var_2d ( ncid , \"u\" , [ station_dimid , time_dimid ], u_varid ) call nc_put_att ( ncid , u_varid , \"long_name\" , \"Depth-averaged x-velocity\" ) call nc_put_att ( ncid , u_varid , \"units\" , \"m/s\" ) call nc_def_var_2d ( ncid , \"v\" , [ station_dimid , time_dimid ], v_varid ) call nc_put_att ( ncid , v_varid , \"long_name\" , \"Depth-averaged y-velocity\" ) call nc_put_att ( ncid , v_varid , \"units\" , \"m/s\" ) call nc_enddef ( ncid ) ! Write static fields call rki_put_var_1d ( ncid , sx_varid , gauges % gauge_x ) call rki_put_var_1d ( ncid , sy_varid , gauges % gauge_y ) ! Interpolate bed at gauge locations (centroid value of containing cell) do ig = 1 , gauges % n_local k = gauges % cell_id ( ig ) bed_interp ( ig ) = gauges % lam1 ( ig ) * mesh % vert_x ( 1 ) ! placeholder end do ! Actually just use the centroid bed value — simpler and consistent ! with what the solver sees do ig = 1 , gauges % n_local bed_interp ( ig ) = 0.0_wp ! will be set from state in first write end do call rki_put_var_1d ( ncid , sb_varid , bed_interp ) gauges % ncid = ncid gauges % time_varid = time_varid gauges % eta_varid = eta_varid gauges % u_varid = u_varid gauges % v_varid = v_varid gauges % time_index = 0 end subroutine create_gauge_netcdf ! ================================================================ ! Write: interpolate and append ! ================================================================ subroutine gauges_unstr_write ( gauges , state , time ) !! Interpolate (eta, u, v) at gauge locations and write to file. !! !! Uses centroid values of the containing triangle (no barycentric !! interpolation of vertices needed since the solver stores !! cell-centred values). The barycentric weights are available !! for future vertex-based interpolation if needed. type ( gauge_unstr_t ), intent ( inout ) :: gauges type ( unstr_state_t ), intent ( in ) :: state real ( wp ), intent ( in ) :: time integer :: ig , k , ti real ( wp ) :: eta_vals ( gauges % n_local ) real ( wp ) :: u_vals ( gauges % n_local ) real ( wp ) :: v_vals ( gauges % n_local ) real ( wp ) :: h , hu , hv , stage_k , bed_k if ( gauges % n_local == 0 . or . gauges % ncid < 0 ) return ! Interpolate at each gauge (cell-centred values) do ig = 1 , gauges % n_local k = gauges % cell_id ( ig ) stage_k = state % barotropic % stage_cv ( k ) bed_k = state % barotropic % bed_cv ( k ) h = max ( stage_k - bed_k , 0.0_wp ) hu = state % barotropic % xmom_cv ( k ) hv = state % barotropic % ymom_cv ( k ) eta_vals ( ig ) = stage_k if ( h > MIN_DEPTH ) then u_vals ( ig ) = hu / h v_vals ( ig ) = hv / h else u_vals ( ig ) = 0.0_wp v_vals ( ig ) = 0.0_wp end if end do ! Write to NetCDF gauges % time_index = gauges % time_index + 1 ti = gauges % time_index call nc_check ( nf90_put_var ( gauges % ncid , gauges % time_varid , time , & start = [ ti ]), \"writing gauge time\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % eta_varid , eta_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge eta\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % u_varid , u_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge u\" ) call nc_check ( nf90_put_var ( gauges % ncid , gauges % v_varid , v_vals , & start = [ 1 , ti ], count = [ gauges % n_local , 1 ]), & \"writing gauge v\" ) call nc_check ( nf90_sync ( gauges % ncid ), \"syncing gauge file\" ) end subroutine gauges_unstr_write ! ================================================================ ! Cleanup ! ================================================================ subroutine gauges_unstr_close ( gauges ) !! Close the gauge output file and deallocate. type ( gauge_unstr_t ), intent ( inout ) :: gauges if ( gauges % ncid >= 0 ) then call nc_close ( gauges % ncid ) call logger % info ( \"Gauge output closed (\" // & to_string ( gauges % time_index ) // \" records, \" // & to_string ( gauges % n_local ) // \" stations)\" ) gauges % ncid = - 1 end if if ( allocated ( gauges % cell_id )) deallocate ( gauges % cell_id ) if ( allocated ( gauges % lam1 )) deallocate ( gauges % lam1 ) if ( allocated ( gauges % lam2 )) deallocate ( gauges % lam2 ) if ( allocated ( gauges % lam3 )) deallocate ( gauges % lam3 ) if ( allocated ( gauges % gauge_x )) deallocate ( gauges % gauge_x ) if ( allocated ( gauges % gauge_y )) deallocate ( gauges % gauge_y ) end subroutine gauges_unstr_close end module rki_gauges_unstr","tags":"","url":"sourcefile/rki_gauges_unstr.f90.html"},{"title":"rki_io_netcdf.F90 – Rakali","text":"Thin wrapper around netcdf-fortran (nf90_*) with error checking This file depends on sourcefile~~rki_io_netcdf.f90~~EfferentGraph sourcefile~rki_io_netcdf.f90 rki_io_netcdf.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_io_netcdf.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_io_netcdf.f90~~AfferentGraph sourcefile~rki_io_netcdf.f90 rki_io_netcdf.F90 sourcefile~rki_bathymetry.f90 rki_bathymetry.F90 sourcefile~rki_bathymetry.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_flux_dump.f90 rki_flux_dump.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_state.f90 rki_state.F90 sourcefile~rki_flux_dump.f90->sourcefile~rki_state.f90 sourcefile~rki_forcing.f90 rki_forcing.F90 sourcefile~rki_forcing.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_forcing.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges.f90 rki_gauges.F90 sourcefile~rki_gauges.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_gauges.f90->sourcefile~rki_state.f90 sourcefile~rki_gauges_unstr.f90 rki_gauges_unstr.F90 sourcefile~rki_gauges_unstr.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_nesting.f90 rki_nesting.F90 sourcefile~rki_nesting.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_nesting.f90->sourcefile~rki_state.f90 sourcefile~rki_output.f90 rki_output.F90 sourcefile~rki_output.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_output.f90->sourcefile~rki_state.f90 sourcefile~rki_output_unstr.f90 rki_output_unstr.F90 sourcefile~rki_output_unstr.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_restart_unstr.f90 rki_restart_unstr.F90 sourcefile~rki_restart_unstr.f90->sourcefile~rki_io_netcdf.f90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_output.f90 sourcefile~rki_handle.f90 rki_handle.F90 sourcefile~rki_api.f90->sourcefile~rki_handle.f90 sourcefile~rki_api.f90->sourcefile~rki_state.f90 sourcefile~rki_init.f90 rki_init.F90 sourcefile~rki_api.f90->sourcefile~rki_init.f90 sourcefile~rki_solver.f90 rki_solver.F90 sourcefile~rki_api.f90->sourcefile~rki_solver.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_gauges_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_output_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_restart_unstr.f90 sourcefile~rki_api_unstr.f90->sourcefile~rki_handle.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_forcing.f90 sourcefile~rki_driver.f90->sourcefile~rki_gauges.f90 sourcefile~rki_driver.f90->sourcefile~rki_nesting.f90 sourcefile~rki_driver.f90->sourcefile~rki_output.f90 sourcefile~rki_driver.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90 rki_coastal_console_stats.F90 sourcefile~rki_driver.f90->sourcefile~rki_coastal_console_stats.f90 sourcefile~rki_driver.f90->sourcefile~rki_init.f90 sourcefile~rki_driver.f90->sourcefile~rki_solver.f90 sourcefile~rki_handle.f90->sourcefile~rki_gauges_unstr.f90 sourcefile~rki_handle.f90->sourcefile~rki_output_unstr.f90 sourcefile~rki_handle.f90->sourcefile~rki_state.f90 sourcefile~rki_state.f90->sourcefile~rki_bathymetry.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_state.f90 sourcefile~rki_coastal_console_stats.f90->sourcefile~rki_init.f90 sourcefile~rki_init.f90->sourcefile~rki_state.f90 sourcefile~rki_solver.f90->sourcefile~rki_state.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! Thin wrapper around netcdf-fortran (nf90_*) with error checking module rki_io_netcdf !! Provides NetCDF read/write primitives and an error-checking helper. !! Used by bathymetry loader and output writer. use , intrinsic :: iso_fortran_env , only : real32 use netcdf , only : nf90_noerr , nf90_strerror , nf90_create , nf90_open , & nf90_close , nf90_def_dim , nf90_def_var , nf90_put_att , nf90_enddef , & nf90_put_var , nf90_get_var , nf90_inq_dimid , nf90_inquire_dimension , & nf90_inq_varid , nf90_get_att , nf90_def_var_deflate , & nf90_clobber , nf90_netcdf4 , nf90_nowrite , nf90_write , & nf90_unlimited , nf90_double , nf90_float , nf90_int , nf90_global , & nf90_redef , nf90_sync use rki_constants , only : wp use pic_logger , only : logger => global_logger implicit none private public :: nc_check public :: nc_create_file public :: nc_open_read public :: nc_open_write public :: nc_close public :: nc_def_dim public :: nc_def_var_2d public :: nc_def_var_3d public :: nc_put_att public :: nc_put_att_real public :: nc_put_att_int public :: nc_put_att_global public :: nc_put_att_global_int public :: nc_get_att_int public :: nc_enddef public :: nc_put_var_2d public :: nc_put_var_3d_slice public :: nc_get_var_2d public :: nc_get_var_3d public :: nc_get_var_1d public :: nc_get_dim_len public :: nc_get_varid public :: rki_def_var_1d public :: rki_put_var_1d public :: rki_put_var_2d_slice public :: nc_def_var_4d public :: nc_put_var_4d_slice public :: nc_get_var_slab_3d public :: nc_get_att_text public :: nc_put_att_real_r4 public :: nc_put_var_3d_slice_r4 public :: nc_put_var_4d_slice_r4 public :: NC_WP public :: NC_R4 #ifdef RAKALI_DOUBLE_PRECISION integer , parameter :: NC_WP = nf90_double !! NetCDF type matching working precision #else integer , parameter :: NC_WP = nf90_float !! NetCDF type matching working precision #endif integer , parameter :: NC_R4 = nf90_float !! Explicit 32-bit NetCDF element type.  Used ONLY by the ocean !! diagnostic stream when `&ocean_diag_nml output_precision=\"single\"` !! asks for a halved-width output file.  Restarts, gauges, coastal !! output and console/conservation totals stay on `NC_WP` — a lossy !! restart must not be requestable.  The 64-bit counterpart is !! `NC_WP` itself — deliberately NOT given an `NC_R8` alias, so !! \"double\" has exactly one spelling and cannot drift away from the !! build's working precision. contains subroutine nc_check ( status , context ) !! Check NetCDF return status and log error if it failed integer , intent ( in ) :: status !! Return code from nf90_* call character ( len =* ), intent ( in ) :: context !! Description of what was being attempted if ( status /= nf90_noerr ) then call logger % error ( \"NetCDF error in \" // trim ( context ) // \": \" // & trim ( nf90_strerror ( status ))) error stop \"NetCDF operation failed\" end if end subroutine nc_check subroutine nc_create_file ( filename , ncid ) !! Create a new NetCDF-4 file (overwrites if exists) character ( len =* ), intent ( in ) :: filename integer , intent ( out ) :: ncid call nc_check ( nf90_create ( trim ( filename ), & ior ( nf90_clobber , nf90_netcdf4 ), ncid ), & \"creating \" // trim ( filename )) end subroutine nc_create_file subroutine nc_open_read ( filename , ncid ) !! Open an existing NetCDF file for reading character ( len =* ), intent ( in ) :: filename integer , intent ( out ) :: ncid call nc_check ( nf90_open ( trim ( filename ), nf90_nowrite , ncid ), & \"opening \" // trim ( filename )) end subroutine nc_open_read subroutine nc_open_write ( filename , ncid ) !! Open an existing NetCDF file for writing character ( len =* ), intent ( in ) :: filename integer , intent ( out ) :: ncid call nc_check ( nf90_open ( trim ( filename ), nf90_write , ncid ), & \"opening for write \" // trim ( filename )) end subroutine nc_open_write subroutine nc_close ( ncid ) !! Close a NetCDF file integer , intent ( in ) :: ncid call nc_check ( nf90_close ( ncid ), \"closing file\" ) end subroutine nc_close subroutine nc_def_dim ( ncid , name , length , dimid ) !! Define a dimension (use nf90_unlimited for unlimited) integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: length integer , intent ( out ) :: dimid call nc_check ( nf90_def_dim ( ncid , name , length , dimid ), & \"defining dimension \" // trim ( name )) end subroutine nc_def_dim subroutine rki_def_var_1d ( ncid , name , dimid , varid , deflate_level ) !! Define a 1D variable with working precision type integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: dimid integer , intent ( out ) :: varid integer , intent ( in ), optional :: deflate_level !! Compression level (0=none, 1-9=deflate). Enables shuffle when > 0. call nc_check ( nf90_def_var ( ncid , name , NC_WP , [ dimid ], varid ), & \"defining variable \" // trim ( name )) if ( present ( deflate_level )) then if ( deflate_level > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , varid , & shuffle = 1 , deflate = 1 , deflate_level = deflate_level ), & \"enabling compression for \" // trim ( name )) end if end if end subroutine rki_def_var_1d subroutine rki_put_var_1d ( ncid , varid , data ) !! Write a full 1D array integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( in ) :: data (:) call nc_check ( nf90_put_var ( ncid , varid , data ), \"writing 1D variable\" ) end subroutine rki_put_var_1d subroutine rki_put_var_2d_slice ( ncid , varid , data , time_index ) !! Write a 1D slice into a 2D variable at a given time index integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( in ) :: data (:) integer , intent ( in ) :: time_index call nc_check ( nf90_put_var ( ncid , varid , data , & start = [ 1 , time_index ], & count = [ size ( data ), 1 ]), & \"writing 2D slice\" ) end subroutine rki_put_var_2d_slice subroutine nc_def_var_2d ( ncid , name , dimids , varid , deflate_level ) !! Define a 2D variable with working precision type integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: dimids ( 2 ) integer , intent ( out ) :: varid integer , intent ( in ), optional :: deflate_level !! Compression level (0=none, 1-9=deflate). Enables shuffle when > 0. call nc_check ( nf90_def_var ( ncid , name , NC_WP , dimids , varid ), & \"defining variable \" // trim ( name )) if ( present ( deflate_level )) then if ( deflate_level > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , varid , & shuffle = 1 , deflate = 1 , deflate_level = deflate_level ), & \"enabling compression for \" // trim ( name )) end if end if end subroutine nc_def_var_2d subroutine nc_def_var_3d ( ncid , name , dimids , varid , deflate_level , xtype ) !! Define a 3D variable (x, y, time) with working precision type integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: dimids ( 3 ) integer , intent ( out ) :: varid integer , intent ( in ), optional :: deflate_level !! Compression level (0=none, 1-9=deflate). Enables shuffle when > 0. integer , intent ( in ), optional :: xtype !! NetCDF element type.  Absent => `NC_WP` (working precision), so !! every legacy call site is unchanged.  The ocean diagnostic !! stream passes `NC_R4` when single-precision output is requested; !! the caller is then responsible for handing `nf90_put_var` real32 !! data (see `nc_put_var_3d_slice_r4`). integer :: xt xt = NC_WP if ( present ( xtype )) xt = xtype call nc_check ( nf90_def_var ( ncid , name , xt , dimids , varid ), & \"defining variable \" // trim ( name )) if ( present ( deflate_level )) then if ( deflate_level > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , varid , & shuffle = 1 , deflate = 1 , deflate_level = deflate_level ), & \"enabling compression for \" // trim ( name )) end if end if end subroutine nc_def_var_3d subroutine nc_put_att ( ncid , varid , name , value ) !! Write a character attribute to a variable integer , intent ( in ) :: ncid integer , intent ( in ) :: varid character ( len =* ), intent ( in ) :: name character ( len =* ), intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , varid , name , value ), & \"writing attribute \" // trim ( name )) end subroutine nc_put_att subroutine nc_put_att_real ( ncid , varid , name , value ) !! Write a real-valued attribute to a variable integer , intent ( in ) :: ncid integer , intent ( in ) :: varid character ( len =* ), intent ( in ) :: name real ( wp ), intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , varid , name , value ), & \"writing attribute \" // trim ( name )) end subroutine nc_put_att_real subroutine nc_put_att_real_r4 ( ncid , varid , name , value ) !! Write a 32-bit real attribute to a variable.  NetCDF rejects a !! `_FillValue` whose type differs from the variable's, so a variable !! defined with `NC_R4` must have its `_FillValue` / `missing_value` !! written through here, not through `nc_put_att_real` (real64). integer , intent ( in ) :: ncid integer , intent ( in ) :: varid character ( len =* ), intent ( in ) :: name real ( real32 ), intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , varid , name , value ), & \"writing real32 attribute \" // trim ( name )) end subroutine nc_put_att_real_r4 subroutine nc_put_att_global ( ncid , name , value ) !! Write a global character attribute integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name character ( len =* ), intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , nf90_global , name , value ), & \"writing global attribute \" // trim ( name )) end subroutine nc_put_att_global subroutine nc_put_att_int ( ncid , varid , name , value ) !! Write an integer attribute to a variable integer , intent ( in ) :: ncid integer , intent ( in ) :: varid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , varid , name , value ), & \"writing attribute \" // trim ( name )) end subroutine nc_put_att_int subroutine nc_put_att_global_int ( ncid , name , value ) !! Write a global integer attribute integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: value call nc_check ( nf90_put_att ( ncid , nf90_global , name , value ), & \"writing global attribute \" // trim ( name )) end subroutine nc_put_att_global_int subroutine nc_get_att_int ( ncid , name , value ) !! Read a global integer attribute integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( out ) :: value call nc_check ( nf90_get_att ( ncid , nf90_global , name , value ), & \"reading global attribute \" // trim ( name )) end subroutine nc_get_att_int subroutine nc_enddef ( ncid ) !! End define mode, switch to data mode integer , intent ( in ) :: ncid call nc_check ( nf90_enddef ( ncid ), \"ending define mode\" ) end subroutine nc_enddef subroutine nc_put_var_2d ( ncid , varid , data ) !! Write a full 2D array integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( in ) :: data (:, :) call nc_check ( nf90_put_var ( ncid , varid , data ), \"writing 2D variable\" ) end subroutine nc_put_var_2d subroutine nc_put_var_3d_slice ( ncid , varid , data , time_index ) !! Write a 2D slice into a 3D variable at a given time index integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( in ) :: data (:, :) integer , intent ( in ) :: time_index call nc_check ( nf90_put_var ( ncid , varid , data , & start = [ 1 , 1 , time_index ], & count = [ size ( data , 1 ), size ( data , 2 ), 1 ]), & \"writing 3D slice\" ) end subroutine nc_put_var_3d_slice subroutine nc_put_var_3d_slice_r4 ( ncid , varid , data , time_index ) !! Write a 32-bit 2D slice into a 3D variable at a given time index. !! The real32 twin of `nc_put_var_3d_slice`: handing real64 data to !! an `NF90_FLOAT` variable is legal (netcdf converts) but writes the !! same bytes at twice the host->library traffic, so the diag writer !! stages the conversion itself and calls this. integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( real32 ), intent ( in ) :: data (:, :) integer , intent ( in ) :: time_index call nc_check ( nf90_put_var ( ncid , varid , data , & start = [ 1 , 1 , time_index ], & count = [ size ( data , 1 ), size ( data , 2 ), 1 ]), & \"writing 3D slice (real32)\" ) end subroutine nc_put_var_3d_slice_r4 subroutine nc_put_var_4d_slice_r4 ( ncid , varid , data , time_index ) !! Write a 32-bit 3D slice into a 4D variable at a given time index. !! The real32 twin of `nc_put_var_4d_slice`. integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( real32 ), intent ( in ) :: data (:, :, :) integer , intent ( in ) :: time_index call nc_check ( nf90_put_var ( ncid , varid , data , & start = [ 1 , 1 , 1 , time_index ], & count = [ size ( data , 1 ), size ( data , 2 ), size ( data , 3 ), 1 ]), & \"writing 4D slice (real32)\" ) end subroutine nc_put_var_4d_slice_r4 subroutine nc_get_var_2d ( ncid , varid , data ) !! Read a full 2D array integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( inout ) :: data (:, :) call nc_check ( nf90_get_var ( ncid , varid , data ), \"reading 2D variable\" ) end subroutine nc_get_var_2d subroutine nc_get_var_3d ( ncid , varid , data ) !! Read a full 3D array.  Mirrors `nc_get_var_2d`; the target's !! shape must match the file variable's Fortran storage order !! (the caller handles any C/Fortran dimension reversal, as !! `rki_bathymetry` does for 2D). integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( inout ) :: data (:, :, :) call nc_check ( nf90_get_var ( ncid , varid , data ), \"reading 3D variable\" ) end subroutine nc_get_var_3d subroutine nc_get_var_1d ( ncid , varid , data ) !! Read a full 1D array (the read sibling of `rki_put_var_1d`). integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( inout ) :: data (:) call nc_check ( nf90_get_var ( ncid , varid , data ), \"reading 1D variable\" ) end subroutine nc_get_var_1d subroutine nc_get_dim_len ( ncid , name , length ) !! Get the length of a named dimension integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( out ) :: length integer :: dimid call nc_check ( nf90_inq_dimid ( ncid , name , dimid ), & \"finding dimension \" // trim ( name )) call nc_check ( nf90_inquire_dimension ( ncid , dimid , len = length ), & \"querying dimension \" // trim ( name )) end subroutine nc_get_dim_len subroutine nc_def_var_4d ( ncid , name , dimids , varid , deflate_level , xtype ) !! Define a 4D variable (x, y, z, time) with working precision type integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( in ) :: dimids ( 4 ) integer , intent ( out ) :: varid integer , intent ( in ), optional :: deflate_level !! Compression level (0=none, 1-9=deflate). Enables shuffle when > 0. integer , intent ( in ), optional :: xtype !! NetCDF element type.  Absent => `NC_WP` (working precision). !! See `nc_def_var_3d` — same contract, 4D shape. integer :: xt xt = NC_WP if ( present ( xtype )) xt = xtype call nc_check ( nf90_def_var ( ncid , name , xt , dimids , varid ), & \"defining variable \" // trim ( name )) if ( present ( deflate_level )) then if ( deflate_level > 0 ) then call nc_check ( nf90_def_var_deflate ( ncid , varid , & shuffle = 1 , deflate = 1 , deflate_level = deflate_level ), & \"enabling compression for \" // trim ( name )) end if end if end subroutine nc_def_var_4d subroutine nc_put_var_4d_slice ( ncid , varid , data , time_index ) !! Write a 3D slice into a 4D variable at a given time index integer , intent ( in ) :: ncid integer , intent ( in ) :: varid real ( wp ), intent ( in ) :: data (:, :, :) integer , intent ( in ) :: time_index call nc_check ( nf90_put_var ( ncid , varid , data , & start = [ 1 , 1 , 1 , time_index ], & count = [ size ( data , 1 ), size ( data , 2 ), size ( data , 3 ), 1 ]), & \"writing 4D slice\" ) end subroutine nc_put_var_4d_slice subroutine nc_get_var_slab_3d ( ncid , varid , start , count , data ) !! Strided slab read: `start`/`count` are the NetCDF start/count !! vectors in FORTRAN dimension order, with length matching the !! target variable's rank (3 for a 2D-field-plus-time variable, 4 !! for a 3D-field-plus-time variable).  `data` is always a plain !! 3D Fortran array; for the 2D-plus-time case pass a target with !! a trailing singleton extent (`data(:,:,1)`) — the netcdf-fortran !! generic interface dispatches on the array RANK of `data`, not !! the length of `start`/`count`, so one routine covers both !! shapes. This is the first strided (non-full-variable) read in !! the tree — mirrors `nc_put_var_4d_slice` for the start/count !! shape, on the read side. integer , intent ( in ) :: ncid , varid integer , intent ( in ) :: start (:), count (:) real ( wp ), intent ( inout ) :: data (:, :, :) call nc_check ( nf90_get_var ( ncid , varid , data , start = start , count = count ), & \"reading NetCDF slab\" ) end subroutine nc_get_var_slab_3d subroutine nc_get_att_text ( ncid , varid , name , value , ok ) !! Read a character (text) attribute from a variable — used for the !! CF `units` attribute on a time axis.  Non-fail-loud: `ok` is !! `.false.` (and `value` blank) when the attribute is absent or the !! wrong type, so callers can fall back to a default rather than !! aborting on a missing/optional attribute. integer , intent ( in ) :: ncid , varid character ( len =* ), intent ( in ) :: name character ( len = :), allocatable , intent ( out ) :: value !! Deferred-length (not assumed-length `intent(out)`, which risks !! silent truncation — fortitude C072): filled from a fixed local !! buffer sized for a CF `units` string. logical , intent ( out ) :: ok integer :: status character ( len = 1024 ) :: buf buf = \"\" status = nf90_get_att ( ncid , varid , name , buf ) ok = ( status == nf90_noerr ) if ( ok ) then value = trim ( buf ) else value = \"\" end if end subroutine nc_get_att_text subroutine nc_get_varid ( ncid , name , varid ) !! Get the variable ID for a named variable integer , intent ( in ) :: ncid character ( len =* ), intent ( in ) :: name integer , intent ( out ) :: varid call nc_check ( nf90_inq_varid ( ncid , name , varid ), & \"finding variable \" // trim ( name )) end subroutine nc_get_varid end module rki_io_netcdf","tags":"","url":"sourcefile/rki_io_netcdf.f90.html"},{"title":"rki_banner.F90 – Rakali","text":"This file contains the cute banner we will print when a simulation is run Files dependent on this one sourcefile~~rki_banner.f90~~AfferentGraph sourcefile~rki_banner.f90 rki_banner.F90 sourcefile~rki_api.f90 rki_api.F90 sourcefile~rki_api.f90->sourcefile~rki_banner.f90 sourcefile~rki_api_unstr.f90 rki_api_unstr.F90 sourcefile~rki_api_unstr.f90->sourcefile~rki_banner.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefile~rki_banner.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code !! This file contains the cute banner we will print when a simulation is run module rki_banner use pic_logger , only : logger => global_logger use pic_knowledge , only : get_knowledge implicit none private public :: print_banner contains subroutine print_banner ( sim_type ) !! Print a cute banner to the console when the simulation starts. !! `sim_type` is accepted (and ignored) so callers can pass the !! configured regime tag without branching. character ( len =* ), intent ( in ), optional :: sim_type character ( len = 54 ) :: subtitle ! 54 = interior box width (the ═ border) subtitle = \"       2D/3D Coastal Hydrodynamics Model\" if ( present ( sim_type )) continue ! single-regime build: no variants call logger % info ( \"\" ) call logger % info ( \"  ╔══════════════════════════════════════════════════════╗\" ) call logger % info ( \"  ║                                                      ║\" ) call logger % info ( \"  ║    ██████╗  █████╗ ██╗  ██╗ █████╗ ██╗     ██╗       ║\" ) call logger % info ( \"  ║    ██╔══██╗██╔══██╗██║ ██╔╝██╔══██╗██║     ██║       ║\" ) call logger % info ( \"  ║    ██████╔╝███████║█████╔╝ ███████║██║     ██║       ║\" ) call logger % info ( \"  ║    ██╔══██╗██╔══██║██╔═██╗ ██╔══██║██║     ██║       ║\" ) call logger % info ( \"  ║    ██║  ██║██║  ██║██║  ██╗██║  ██║███████╗██║       ║\" ) call logger % info ( \"  ║    ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚═╝       ║\" ) call logger % info ( \"  ║                                                      ║\" ) call logger % info ( \"  ║        A GPU accelerated, Fortran native             ║\" ) call logger % info ( \"  ║\" // subtitle // \"║\" ) call logger % info ( \"  ║                                                      ║\" ) call logger % info ( \"  ║                                                      ║\" ) call logger % info ( \"  ╚══════════════════════════════════════════════════════╝\" ) call logger % info ( \"\" ) call logger % info ( \"  Contributors:\" ) call logger % info ( \"    Jorge Luis Galvez Vallejo\" ) call logger % info ( \"    Albert Sietze Thie\" ) ! add your name here after you've contributed! call logger % info ( \"\" ) call get_knowledge () end subroutine print_banner end module rki_banner","tags":"","url":"sourcefile/rki_banner.f90.html"},{"title":"rki_si_unstr_mg.F90 – Rakali","text":"Agglomeration-multigrid V-cycle preconditioner for the unstructured SI\neta-solve. This file depends on sourcefile~~rki_si_unstr_mg.f90~~EfferentGraph sourcefile~rki_si_unstr_mg.f90 rki_si_unstr_mg.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_si_unstr_mg.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_mesh_unstr.f90->sourcefile~rki_constants.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~rki_si_unstr_mg.f90~~AfferentGraph sourcefile~rki_si_unstr_mg.f90 rki_si_unstr_mg.F90 sourcefile~rki_si_unstr_helmholtz.f90 rki_si_unstr_helmholtz.F90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_state.f90 rki_si_unstr_state.F90 sourcefile~rki_si_unstr_helmholtz.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_si_unstr_state.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_step.f90 rki_si_unstr_step.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_mg.f90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_helmholtz.f90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_si_unstr_state.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90 sourcefile~rki_si_unstr_step.f90->sourcefile~rki_state_unstr.f90 sourcefile~rki_driver.f90 rki_driver.F90 sourcefile~rki_driver.f90->sourcefi