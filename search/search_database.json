parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~apply_sponge~~CalledByGraph proc~apply_sponge apply_sponge proc~accumulate_sponge_mass_src accumulate_sponge_mass_src proc~accumulate_sponge_mass_src->proc~apply_sponge proc~solver_advance_2d_generic solver_advance_2d_generic proc~solver_advance_2d_generic->proc~apply_sponge proc~solver_barotropic_rk_stage solver_barotropic_rk_stage proc~solver_barotropic_rk_stage->proc~apply_sponge proc~solver_multilayer_rk_stage_nz1 solver_multilayer_rk_stage_nz1 proc~solver_multilayer_rk_stage_nz1->proc~apply_sponge proc~solver_nh_rk_stage solver_nh_rk_stage proc~solver_nh_rk_stage->proc~apply_sponge proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver_multilayer_rk_stage->proc~accumulate_sponge_mass_src proc~solver_multilayer_rk_stage->proc~solver_multilayer_rk_stage_nz1 proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~accumulate_sponge_mass_src proc~solver_step_impl->proc~solver_advance_2d_generic proc~solver_step_impl->proc~solver_nh_rk_stage proc~solver_step_split_impl solver_step_split_impl proc~solver_step_split_impl->proc~solver_barotropic_rk_stage proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~solver_step->proc~solver_step_split_impl proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step->proc~solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~solver_multilayer_rk_stage proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: alpha integer, private :: d_east integer, private :: d_min integer, private :: d_north integer, private :: d_south integer, private :: d_west real(kind=wp), private :: h_ref logical, private :: has_east logical, private :: has_north logical, private :: has_south logical, private :: has_west integer, private :: i integer, private :: i_first integer, private :: i_last integer, private :: j integer, private :: j_first integer, private :: j_last integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: ratio real(kind=wp), private :: strength integer, private :: sw Source Code pure subroutine apply_sponge ( h , hu , hv , grid , dt , bc ) !! Apply sponge layer relaxation to h, hu, hv !! !! Cells within sponge_width of a sponge boundary are relaxed toward !! h_ref with hu_ref = hv_ref = 0. No-op when sponge_width <= 0. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt !! Timestep (s) type ( bc_params_t ), intent ( in ) :: bc !! Boundary condition parameters (sponge config) integer :: i , j , i_first , i_last , j_first , j_last integer :: nx , ny , nghost integer :: sw , d_west , d_east , d_south , d_north , d_min real ( wp ) :: alpha , ratio , h_ref , strength logical :: has_west , has_east , has_south , has_north nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost sw = bc % sponge_width if ( sw <= 0 ) return strength = bc % sponge_strength h_ref = bc % sponge_h_ref if ( strength <= 0.0_wp ) return i_first = nghost + 1 i_last = nx - nghost j_first = nghost + 1 j_last = ny - nghost has_west = ( bc % west == BC_SPONGE ) has_east = ( bc % east == BC_SPONGE ) has_south = ( bc % south == BC_SPONGE ) has_north = ( bc % north == BC_SPONGE ) do concurrent ( j = j_first : j_last , i = i_first : i_last ) & local ( d_west , d_east , d_south , d_north , d_min , alpha , ratio ) ! Compute distance from each sponge boundary (in cells) d_min = sw + 1 ! Start beyond sponge width (no damping) if ( has_west ) then d_west = i - i_first if ( d_west < sw ) d_min = min ( d_min , d_west ) end if if ( has_east ) then d_east = i_last - i if ( d_east < sw ) d_min = min ( d_min , d_east ) end if if ( has_south ) then d_south = j - j_first if ( d_south < sw ) d_min = min ( d_min , d_south ) end if if ( has_north ) then d_north = j_last - j if ( d_north < sw ) d_min = min ( d_min , d_north ) end if if ( d_min < sw ) then ratio = real ( sw - d_min , wp ) / real ( sw , wp ) alpha = strength * ratio * ratio h ( i , j ) = h ( i , j ) - dt * alpha * ( h ( i , j ) - h_ref ) hu ( i , j ) = hu ( i , j ) - dt * alpha * hu ( i , j ) hv ( i , j ) = hv ( i , j ) - dt * alpha * hv ( i , j ) end if end do end subroutine apply_sponge","tags":"","url":"proc/apply_sponge.html"},{"title":"parse_si_precond_unstr – Rakali","text":"public  function parse_si_precond_unstr(tag) result(precond) Map the &si_nml precond string to its SI_PRECOND_* enum on the\nunstructured path.  Fail-loud allowlist: an unknown tag aborts.  MG is\naggregation (agglomeration) multigrid here ( rki_si_unstr_mg ) — the\ntriangle plateau-breaker — NOT the structured geometric MG. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: 