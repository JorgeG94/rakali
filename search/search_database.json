n Derived Types type, public :: output_state_t Tracks the state of an open output NetCDF file Components Type Visibility Attributes Name Initial integer, public :: bed_sediment_varid = -1 Bed sediment mass reservoir variable ID (set only with sediment on)\nCached sigma layer thicknesses for vorticity computation real(kind=wp), public, allocatable :: dsig (:) integer, public :: h_varid = -1 Water depth variable ID logical, public :: has_ml = .false. Whether multilayer fields are present logical, public :: has_nh = .false. Whether NH fields are present integer, public :: hu_varid = -1 x-momentum variable ID integer, public :: hv_varid = -1 y-momentum variable ID integer, public :: ml_h_layer_varid = -1 Layer thickness variable ID integer, public :: ml_rho_varid = -1 Layer density variable ID integer, public, allocatable :: ml_tracer_varids (:) Per-tracer NetCDF variable IDs, one entry per state%multilayer%tracers(:) slot.  Set to -1 for\ntracers whose output is gated off; otherwise carries the\nvarid of the corresponding NetCDF variable.  Replaces the\nhistorical ml_salinity_varid / ml_temperature_varid pair so adding a passive tracer requires no I/O changes. integer, public :: ml_u_varid = -1 Layer x-velocity variable ID integer, public :: ml_v_varid = -1 Layer y-velocity variable ID integer, public :: ml_w_varid = -1 Vertical velocity at interfaces variable ID integer, public :: ncid = -1 NetCDF file ID (-1 = not open) integer, public :: nz = 0 Number of sigma layers (cached for output) integer, public :: nz_ml = 0 Number of multilayer sigma layers integer, public :: q_nh_varid = -1 NH pressure variable ID integer, public :: time_dimid = -1 Time dimension ID integer, public :: time_index = 0 Current time record index integer, public :: time_varid = -1 Time variable ID integer, public :: u_layer_varid = -1 Per-layer x-velocity variable ID integer, public :: v_layer_varid = -1 Per-layer y-velocity variable ID integer, public :: vort_x_varid = -1 x-vorticity (dw/dy - dv/dz) variable ID integer, public :: vort_y_varid = -1 y-vorticity (du/dz - dw/dx) variable ID integer, public :: w_varid = -1 Vertical velocity variable ID Functions public  function output_rank_filename (base_dir, prefix, rank) result(fname) Generate a filename: / _rank_NNNNNN.nc (the rank\nsuffix is a leftover of the removed MPI support; callers pass 0) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: base_dir Output directory character(len=*), intent(in) :: prefix File prefix (e.g. “output” or “restart”) integer, intent(in) :: rank Rank suffix (always 0) Return Value character(len=512) Subroutines public  subroutine output_close (ostate) Close the output NetCDF file Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate public  subroutine output_init (ostate, filename, state, cfg) Create and initialise a NetCDF output file with CF conventions Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state (populated on return) character(len=*), intent(in) :: filename Path to output file type( state_t ), intent(in) :: state Simulation state (for grid metadata) type( config_t ), intent(in) :: cfg Runtime configuration (for CF metadata) public  subroutine output_write_snapshot (ostate, state, time) Write a solution snapshot at the current time Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state type( state_t ), intent(in) :: state Current simulation state real(kind=wp), intent(in) :: time Current simulation time (s) public  subroutine output_write_snapshot_from_arrays (ostate, h, hu, hv, b, time) Write a solution snapshot from pre-copied host arrays Read more… Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate Output file state real(kind=wp), intent(in) :: h (:,:) Water depth (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: hu (:,:) x-momentum (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: hv (:,:) y-momentum (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: b (:,:) Bathymetry (nx_phys, ny_phys) — interior only real(kind=wp), intent(in) :: time Current simulation time (s) public  subroutine restart_read (filename, state, time, ierr, loaded_multilayer) Read a restart file and restore the simulation state Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to restart file type( state_t ), intent(inout) :: state Simulation state (arrays must be pre-allocated) real(kind=wp), intent(out) :: time Simulation time from the restart file (s) integer, intent(out), optional :: ierr 0 on success, non-zero on failure (currently: 1 = grid mismatch) logical, intent(out), optional :: loaded_multilayer .true. iff multilayer fields were actually populated from\nthe file.  Callers that auto-initialise layers from the\nbarotropic state should skip that step when this is true. public  subroutine restart_write (filename, state, time) Write a restart file containing full state for later continuation Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to restart file type( state_t ), intent(in) :: state Current simulation state real(kind=wp), intent(in) :: time Current simulation time (s) public  subroutine write_ascii_output (s, output_dir) Write the final water depth field to an ASCII file Arguments Type Intent Optional Attributes Name type( state_t ), intent(in) :: s character(len=*), intent(in) :: output_dir private  subroutine define_tracer_outputs (ostate, state, cfg, dimids_4d, dlevel) Define one NetCDF variable per entry in state%multilayer%tracers(:) , using each tracer’s identity\nstrings ( name , long_name , units , standard_name ) so\nthe registry alone determines what gets written.  Sets ostate%ml_tracer_varids(it) to -1 when the tracer is\ngated off (the legacy cfg%out_salinity / cfg%out_temperature switches still apply for those two\nbuilt-in tracers; new tracers default to write-enabled). Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate type( state_t ), intent(in) :: state type( config_t ), intent(in) :: cfg integer, intent(in) :: dimids_4d (4) integer, intent(in) :: dlevel private  subroutine write_tracer_snapshots (ostate, state, nx, ny, ng, nz_ml, buf3d) Per-tracer host-side write loop.  Divides the conserved tracers(it)%hTr (= h * Tr) by h_layer to recover the\nprimitive variable, then writes through ostate%ml_tracer_varids(it) for each tracer that has output\nenabled. Arguments Type Intent Optional Attributes Name type( output_state_t ), intent(inout) :: ostate type( state_t ), intent(in) :: state integer, intent(in) :: nx integer, intent(in) :: ny integer, intent(in) :: ng integer, intent(in) :: nz_ml real(kind=wp), intent(inout) :: buf3d (nx,ny,nz_ml)","tags":"","url":"module/rki_output.html"},{"title":"rki_profiler – Rakali","text":"Uses pic_logger iso_fortran_env module~~rki_profiler~~UsesGraph module~rki_profiler rki_profiler iso_fortran_env iso_fortran_env module~rki_profiler->iso_fortran_env pic_logger pic_logger module~rki_profiler->pic_logger Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Used by module~~rki_profiler~~UsedByGraph module~rki_profiler rki_profiler module~rki_driver rki_driver module~rki_driver->module~rki_profiler module~rki_solver rki_solver module~rki_driver->module~rki_solver module~rki_solver->module~rki_profiler modul