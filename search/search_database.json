practical salinity !! `S_sp` PSU, pressure `p` Pa).  Returns specific volume `sv` !! (m&#94;3/kg) and the analytic sensitivities w.r.t. the MODEL !! variables (`dsv_dt_model` = dSV/dPT, `dsv_ds_model` = dSV/dSP) !! so the variant-agnostic consumers (which work in PT, SP) get the !! correct chain-ruled derivatives. !! !! Convention (pinned 2026-06-16 — see EOS_VARIANT_ROQUET_SPV): !!   SR = S_sp * (35.16504/35)         [Reference Salinity, g/kg] !!   CT = ct_from_pt(SR, T_pt)         [Conservative Temperature] !! The polynomial is fit in (CT, SA, p); we feed SR for SA (bounded !! anomaly deviation) and CT via the local conversion poly. !! !! Chain rule back to the model variables.  CT = ct_from_pt(SR, PT) !! depends on BOTH PT and SR (= SP·factor), so the SP derivative !! carries TWO routes into SV — the direct SA route AND the !! CT-via-SR route: !!   dSV/dPT = (dSV/dCT) · (dCT/dPT) !!   dSV/dSP = [ (dSV/dSA) + (dSV/dCT)·(dCT/dSR) ] · (35.16504/35) !! The CT-via-SR term is ~0.5 % of dSV/dSP (dCT/dSR ≈ −0.02 degC per !! g/kg); dropping it (the simplified spec formula) leaves a real !! ~5e-3 relative error against the true total derivative, so we !! keep the full chain — this is what the FD regression locks. !! !! dCT/dPT and dCT/dSR are analytic derivatives of the ct_from_pt !! poly: with yy = 0.025·PT, x2 = sfac·SR, xx = sqrt(x2), each !! yy-coefficient c_k(xx) = A + B·xx² + C·xx³ + D·xx⁴ + E·xx⁵, so !!   dCT/dPT = 0.025·(dhh/dyy)/cp0 !!   dCT/dSR = (dhh/dxx)·(sfac/(2·xx))/cp0. !! !! Transcribed from the verified prototype roquet_spv_eos.py.  One !! sqrt for zs (shared by SV and both derivatives) + one sqrt for !! the ct_from_pt poly normalisation. !$acc routine seq real ( wp ), intent ( in ) :: T_pt , S_sp , p real ( wp ), intent ( out ) :: sv , dsv_dt_model , dsv_ds_model real ( wp ) :: SR , CT , dct_dpt , dct_dsr real ( wp ) :: zt , zs , zp real ( wp ) :: sv_ts0 , sv_ts1 , sv_ts2 , sv_ts3 , sv_0s0 , sv_00p real ( wp ) :: dvdzt0 , dvdzt1 , dvdzt2 , dvdzt3 , dsv_dct real ( wp ) :: dvdzs0 , dvdzs1 , dvdzs2 , dvdzs3 , dsv_dsa real ( wp ) :: x2 , xx , yy , hh , dh_dy , dh_dx real ( wp ) :: c0 , c1 , c2 , c3 , c4 , c5 , c6 , c7 real ( wp ) :: d0 , d1 , d2 , d3 , d4 , d5 , d6 , d7 SR = S_sp * ROQ_SR_FACTOR ! CT = ct_from_pt(SR, PT): the 7-term gsw surface poly is degree 7 in ! yy = 0.025*PT.  Each yy-coefficient c_k is a polynomial in xx = ! sqrt(sfac*SR): c_k = A + B*xx&#94;2 + C*xx&#94;3 + D*xx&#94;4 + E*xx&#94;5 (x2 = xx&#94;2). ! Building c_k and dc_k/dxx (= d_k) gives exact analytic dCT/dPT and ! dCT/dSR by Horner — no risk of mis-differentiating the published ! nesting. ! Floor x2 to a tiny positive so the `dct_dsr = dh_dx/(2*xx)` below ! never hits 0/0 at SP=0 (fresh water): dh_dx is itself proportional ! to xx (lowest term 2B*xx), so dh_dx/xx has a finite limit — the ! floor reproduces it (xx tiny-but-nonzero) instead of NaN.  The ! floor only bites at SP < ~1e-9 PSU, so it is bit-identical for any ! real-ocean salinity. x2 = max ( ROQ_CT_SFAC * SR , 1.0e-20_wp ) xx = sqrt ( x2 ) yy = T_pt * 0.025_wp c0 = 6 1.01362420681071_wp & + x2 * ( 26 8.5520265845071_wp & + xx * ( 93 7.2099110620707_wp & + xx * ( - 168 7.914374187449_wp + xx * 24 6.9598888781377_wp ))) c1 = 16877 6.46138048015_wp & + x2 * ( - 1201 9.028203559312_wp & + xx * ( 58 8.1802812170108_wp & + xx * ( 93 6.3206544460336_wp + xx * 12 3.59576582457964_wp ))) c2 = - 273 5.2785605119625_wp & + x2 * ( 373 4.858026725145_wp & + xx * ( 24 8.39476522971285_wp & + xx * ( - 94 2.7827304544439_wp + xx * ( - 4 8.5891069025409_wp )))) c3 = 257 4.2164453821433_wp & + x2 * ( - 204 6.7671145057618_wp & + xx * ( - 3.871557904936333_wp + xx * 36 9.4389437509002_wp )) c4 = - 153 6.6644434977543_wp & + x2 * ( 46 5.28655623126450_wp + xx * ( - 2.6268019854268356_wp + xx * ( - 3 3.83664947895248_wp ))) c5 = 54 5.7340497931629_wp & + x2 * ( - 0.6370820302831379_wp + xx * ( - 9.987880382780322_wp )) c6 = - 5 0.91091728474331_wp + x2 * ( - 1 0.650848542359153_wp ) c7 = - 1 8.30489878927802_wp ! dc_k/dxx = 2B*xx + 3C*xx&#94;2 + 4D*xx&#94;3 + 5E*xx&#94;4 (A and the xx&#94;0/xx&#94;1 ! terms vanish; B,C,D,E read off the c_k expansions above). d0 = xx * ( 2.0_wp * 26 8.5520265845071_wp & + xx * ( 3.0_wp * 93 7.2099110620707_wp & + xx * ( 4.0_wp * ( - 168 7.914374187449_wp ) + xx * 5.0_wp * 24 6.9598888781377_wp ))) d1 = xx * ( 2.0_wp * ( - 1201 9.028203559312_wp ) & + xx * ( 3.0_wp * 58 8.1802812170108_wp & + xx * ( 4.0_wp * 93 6.3206544460336_wp + xx * 5.0_wp * 12 3.59576582457964_wp ))) d2 = xx * ( 2.0_wp * 373 4.858026725145_wp & + xx * ( 3.0_wp * 24 8.39476522971285_wp & + xx * ( 4.0_wp * ( - 94 2.7827304544439_wp ) + xx * 5.0_wp * ( - 4 8.5891069025409_wp )))) d3 = xx * ( 2.0_wp * ( - 204 6.7671145057618_wp ) & + xx * ( 3.0_wp * ( - 3.871557904936333_wp ) + xx * 4.0_wp * 36 9.4389437509002_wp )) d4 = xx * ( 2.0_wp * 46 5.28655623126450_wp & + xx * ( 3.0_wp * ( - 2.6268019854268356_wp ) + xx * 4.0_wp * ( - 3 3.83664947895248_wp ))) d5 = xx * ( 2.0_wp * ( - 0.6370820302831379_wp ) + xx * 3.0_wp * ( - 9.987880382780322_wp )) d6 = xx * 2.0_wp * ( - 1 0.650848542359153_wp ) d7 = 0.0_wp hh = c0 + yy * ( c1 + yy * ( c2 + yy * ( c3 + yy * ( c4 + yy * ( c5 + yy * ( c6 + yy * c7 )))))) dh_dy = c1 + yy * ( 2.0_wp * c2 + yy * ( 3.0_wp * c3 + yy * ( 4.0_wp * c4 & + yy * ( 5.0_wp * c5 + yy * ( 6.0_wp * c6 + yy * 7.0_wp * c7 ))))) dh_dx = d0 + yy * ( d1 + yy * ( d2 + yy * ( d3 + yy * ( d4 + yy * ( d5 + yy * ( d6 + yy * d7 )))))) CT = hh / ROQ_CP0 dct_dpt = 0.025_wp * dh_dy / ROQ_CP0 dct_dsr = dh_dx * ( ROQ_CT_SFAC / ( 2.0_wp * xx )) / ROQ_CP0 zt = CT zs = sqrt ( abs ( S_sp * ROQ_SR_FACTOR + ROQ_RDELTAS ) * ROQ_R1_S0 ) zp = p ! --- specific volume SV(zs, zt, zp) --- sv_ts3 = SPV003 + ( zs * SPV103 + zt * SPV013 ) sv_ts2 = SPV002 + ( zs * ( SPV102 + zs * SPV202 ) & + zt * ( SPV012 + ( zs * SPV112 + zt * SPV022 ))) sv_ts1 = SPV001 + ( zs * ( SPV101 + zs * ( SPV201 + zs * ( SPV301 + zs * SPV401 ))) & + zt * ( SPV011 + ( zs * ( SPV111 + zs * ( SPV211 + zs * SPV311 )) & + zt * ( SPV021 + ( zs * ( SPV121 + zs * SPV221 ) & + zt * ( SPV031 + ( zs * SPV131 + zt * SPV041 ))))))) sv_ts0 = zt * ( SPV010 & + ( zs * ( SPV110 + zs * ( SPV210 + zs * ( SPV310 + zs * ( SPV410 + zs * SPV510 )))) & + zt * ( SPV020 + ( zs * ( SPV120 + zs * ( SPV220 + zs * ( SPV320 + zs * SPV420 ))) & + zt * ( SPV030 + ( zs * ( SPV130 + zs * ( SPV230 + zs * SPV330 )) & + zt * ( SPV040 + ( zs * ( SPV140 + zs * SPV240 ) & + zt * ( SPV050 + ( zs * SPV150 + zt * SPV060 )))))))))) sv_0s0 = SPV000 + zs * ( SPV100 + zs * ( SPV200 + zs * ( SPV300 + zs * ( SPV400 & + zs * ( SPV500 + zs * SPV600 ))))) sv_00p = zp * ( ROQ_V00 + zp * ( ROQ_V01 + zp * ( ROQ_V02 + zp * ( ROQ_V03 & + zp * ( ROQ_V04 + zp * ROQ_V05 ))))) sv = (( sv_ts0 + sv_0s0 ) + zp * ( sv_ts1 + zp * ( sv_ts2 + zp * sv_ts3 ))) + sv_00p ! --- dSV/dCT --- dvdzt3 = ALP003 dvdzt2 = ALP002 + ( zs * ALP102 + zt * ALP012 ) dvdzt1 = ALP001 + ( zs * ( ALP101 + zs * ( ALP201 + zs * ALP301 )) & + zt * ( ALP011 + ( zs * ( ALP111 + zs * ALP211 ) & + zt * ( ALP021 + ( zs * ALP121 + zt * ALP031 ))))) dvdzt0 = ALP000 + ( zs * ( ALP100 + zs * ( ALP200 + zs * ( ALP300 + zs * ( ALP400 + zs * ALP500 )))) & + zt * ( ALP010 + ( zs * ( ALP110 + zs * ( ALP210 + zs * ( ALP310 + zs * ALP410 ))) & + zt * ( ALP020 + ( zs * ( ALP120 + zs * ( ALP220 + zs * ALP320 )) & + zt * ( ALP030 + ( zt * ( ALP040 + ( zs * ALP140 + zt * ALP050 )) & + zs * ( ALP130 + zs * ALP230 )))))))) dsv_dct = dvdzt0 + zp * ( dvdzt1 + zp * ( dvdzt2 + zp * dvdzt3 )) ! --- dSV/dSA (per-coef 0.5*r1_S0 folded into BET; residual /zs here) --- dvdzs3 = BET003 dvdzs2 = BET002 + ( zs * BET102 + zt * BET012 ) dvdzs1 = BET001 + ( zs * ( BET101 + zs * ( BET201 + zs * BET301 )) & + zt * ( BET011 + ( zs * ( BET111 + zs * BET211 ) & + zt * ( BET021 + ( zs * BET121 + zt * BET031 ))))) dvdzs0 = BET000 + ( zs * ( BET100 + zs * ( BET200 + zs * ( BET300 + zs * ( BET400 + zs * BET500 )))) & + zt * ( BET010 + ( zs * ( BET110 + zs * ( BET210 + zs * ( BET310 + zs * BET410 ))) & + zt * ( BET020 + ( zs * ( BET120 + zs * ( BET220 + zs * BET320 )) & + zt * ( BET030 + ( zt * ( BET040 + ( zs * BET140 + zt * BET050 )) & + zs * ( BET130 + zs * BET230 )))))))) dsv_dsa = ( dvdzs0 + zp * ( dvdzs1 + zp * ( dvdzs2 + zp * dvdzs3 ))) / zs ! Chain rule to the model variables (PT, SP).  The SP route includes ! the CT-via-SR coupling (CT depends on SR = SP·factor). dsv_dt_model = dsv_dct * dct_dpt dsv_ds_model = ( dsv_dsa + dsv_dct * dct_dsr ) * ROQ_SR_FACTOR end subroutine roquet_spv_point","tags":"","url":"proc/roquet_spv_point.html"},{"title":"ml_baroclinic_pressure_gradient_jacobian_unstr – Rakali","text":"public pure subroutine ml_baroclinic_pressure_gradient_jacobian_unstr(state, mesh, dt) Apply the Jacobian (Shchepetkin-McWilliams 2003) baroclinic\npressure gradient as an explicit momentum source. Per cell, per layer k:\n  1. z_mid_c = depth of layer k centre in the centre column\n  2. p_here  = integrated density anomaly from surface to z_mid_c\n  3. For each of 3 edges:\n       - interior with wet neighbour whose column reaches z_mid_c:\n         build the neighbour’s (zn_if, pn_if) column and\n         linear-interpolate p to z_mid_c.\n       - else (dry/missing neighbour, OR z_mid_c below the\n         neighbour’s bed at a shelf break): p_nbr = p_here\n         (reflective wall) – avoids the spurious horizontal\n         gradient from clamping to neighbour-bed pressure.\n  4. p_edge = 0.5 * (p_here + p_nbr); accumulate\n       dp_dx += p_edge * n1 * L_e\n       dp_dy += p_edge * n2 * L_e\n  5. (dp_dx, dp_dy) = 1/area; multiply by g/rho_0; cap by\n     sqrt(g’ H)/dt; subtract dt h acc from layer momentum. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~ml_baroclinic_pressure_gradient_jacobian_unstr~~CallsGraph proc~ml_baroclinic_pressure_gradient_jacobian_unstr ml_baroclinic_pressure_gradient_jacobian_unstr local local proc~ml_baroclinic_pressure_gradient_jacobian_unstr->local proc~rho_ref_at rho_ref_at proc~ml_baroclinic_pressure_gradient_jacobian_unstr->proc~rho_ref_at Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_baroclinic_pressure_gradient_jacobian_unstr~~CalledByGraph proc~ml_baroclinic_pressure_gradient_jacobian_unstr ml_baroclinic_pressure_gradient_jacobian_unstr proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_jacobian_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_baroclinic_pressure_gradient_jacobian_unstr proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: H_col real(kind=wp), private :: L_e real(kind=wp), private :: bpg_mag real(kind=wp), private :: bpg_max real(kind=wp), private :: bpg_scale integer, private :: cell real(kind=wp), private :: dp_dx real(kind=wp), private :: dp_dy integer, private :: e real(kind=wp), private :: frac real(kind=wp), private :: g_prime real(kind=wp), private :: inv_area real(kind=wp), private :: inv_rho0 integer, private :: k integer, private :: kn integer, private :: n real(kind=wp), private :: n1 real(kind=wp), private :: n2 integer, private :: nbr integer, private :: nbr_idx (3) logical, private :: nbr_valid (3) integer, private :: nz integer, private :: nz_ref real(kind=wp), private :: p_edge real(kind=wp), private :: p_here real(kind=wp), private :: p_if (BPG_NZ_MAX+1) real(kind=wp), private :: p_nbr real(kind=wp), private :: pn_if_e (BPG_NZ_MAX+1,3) real(kind=wp), private :: rho_0 real(kind=wp), private :: rho_ref_dz real(kind=wp), private :: z_if (BPG_NZ_MAX+1) real(kind=wp), private :: z_mid real(kind=wp), private :: z_mid_lay real(kind=wp), private :: zn_if_e (BPG_NZ_MAX+1,3) Source Code pure subroutine ml_baroclinic_pressure_gradient_jacobian_unstr ( state , mesh , dt ) !! Apply the Jacobian (Shchepetkin-McWilliams 2003) baroclinic !! pressure gradient as an explicit momentum source. !! !! Per cell, per layer k: !!   1. z_mid_c = depth of layer k centre in the centre column !!   2. p_here  = integrated density anomaly from surface to z_mid_c !!   3. For each of 3 edges: !!        - interior with wet neighbour whose column reaches z_mid_c: !!          build the neighbour's (zn_if, pn_if) column and !!          linear-interpolate p to z_mid_c. !!        - else (dry/missing neighbour, OR z_mid_c below the !!          neighbour's bed at a shelf break): p_nbr = p_here !!          (reflective wall) -- avoids the spurious horizontal !!          gradient from clamping to neighbour-bed pressure. !!   4. p_edge = 0.5 * (p_here + p_nbr); accumulate !!        dp_dx += p_edge * n1 * L_e !!        dp_dy += p_edge * n2 * L_e !!   5. (dp_dx, dp_dy) *= 1/area; multiply by g/rho_0; cap by !!      sqrt(g'*H)/dt; subtract dt*h*acc from layer momentum. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer :: cell , k , kn , e , nbr , nz , n , nz_ref real ( wp ) :: inv_area , inv_rho0 , H_col , rho_ref_dz , rho_0 real ( wp ) :: z_if ( BPG_NZ_MAX + 1 ), p_if ( BPG_NZ_MAX + 1 ) ! Per-edge neighbour columns. Built once per cell in the prepass ! and then reused for every layer's search/interpolate. Hoisting ! these out of the inner `k` loop is what cuts BPG runtime in ! half: the column data is independent of `z_mid`, only the ! query into it depends on `k`. real ( wp ) :: zn_if_e ( BPG_NZ_MAX + 1 , 3 ), pn_if_e ( BPG_NZ_MAX + 1 , 3 ) integer :: nbr_idx ( 3 ) logical :: nbr_valid ( 3 ) real ( wp ) :: z_mid , z_mid_lay , p_here , p_nbr , p_edge , frac real ( wp ) :: dp_dx , dp_dy , n1 , n2 , L_e real ( wp ) :: g_prime , bpg_max , bpg_mag , bpg_scale if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = mesh % ncells_owned ! Defence-in-depth only: validate_config (bpg_nz_is_sufficient in ! rki_ml_common_unstr) refuses nz + 1 > BPG_NZ_MAX up front, so ! this cannot fire on a validated run; reaching it would silently ! skip the whole baroclinic pressure gradient. if ( nz > BPG_NZ_MAX ) return inv_rho0 = 1.0_wp / state % multilayer % rho_0 rho_0 = state % multilayer % rho_0 rho_ref_dz = state % multilayer % rho_ref_dz nz_ref = state % multilayer % nz_ref do concurrent ( cell = 1 : n ) local ( k , kn , e , nbr , inv_area , H_col , & z_if , p_if , zn_if_e , pn_if_e , & nbr_idx , nbr_valid , & z_mid , z_mid_lay , p_here , p_nbr , p_edge , frac , & dp_dx , dp_dy , n1 , n2 , L_e , & g_prime , bpg_max , bpg_mag , bpg_scale ) H_col = state % barotropic % height_cv ( cell ) if ( H_col < ML_MIN_DEPTH_UNSTR ) cycle inv_area = 1.0_wp / mesh % area ( cell ) ! --- Centre column: interface depths and integrated pressure --- ! z_if(k) = depth from surface to the LOWER interface of layer k ! (z_if(nz+1) = 0 at surface, z_if(1) = bed depth). ! p_if(k) = integral of (rho - rho_ref(z)) * dz from surface to ! z_if(k). rho_ref(z) is the horizontally-uniform reference ! profile (Phase B2); when unset (rho_ref_dz==0) the helper ! returns rho_0, recovering the pre-B2 anomaly. z_if ( nz + 1 ) = 0.0_wp p_if ( nz + 1 ) = 0.0_wp do k = nz , 1 , - 1 z_if ( k ) = z_if ( k + 1 ) + state % multilayer % h_layer ( k , cell ) z_mid_lay = 0.5_wp * ( z_if ( k ) + z_if ( k + 1 )) p_if ( k ) = p_if ( k + 1 ) & + ( state % multilayer % rho_layer ( k , cell ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , rho_ref_dz , & nz_ref , rho_0 )) & * state % multilayer % h_layer ( k , cell ) end do ! --- Build the 3 neighbour columns ONCE per cell (was: nz times) --- ! Each column is independent of `k`; the per-layer work in the ! inner loop is just a search/interpolate against these columns. ! Edges that are boundaries or face a thin neighbour are ! flagged invalid so the inner loop falls through to the ! reflective-wall fallback (`p_nbr = p_here`) without searching. do e = 1 , 3 nbr = mesh % neighbours ( e , cell ) nbr_idx ( e ) = nbr if ( nbr > 0 ) then if ( state % barotropic % height_cv ( nbr ) >= ML_MIN_DEPTH_UNSTR ) then nbr_valid ( e ) = . true . zn_if_e ( nz + 1 , e ) = 0.0_wp pn_if_e ( nz + 1 , e ) = 0.0_wp do kn = nz , 1 , - 1 zn_if_e ( kn , e ) = zn_if_e ( kn + 1 , e ) + state % multilayer % h_layer ( kn , nbr ) z_mid_lay = 0.5_wp * ( zn_if_e ( kn , e ) + zn_if_e ( kn + 1 , e )) pn_if_e ( kn , e ) = pn_if_e ( kn + 1 , e ) & + ( state % multilayer % rho_layer ( kn , nbr ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , & rho_ref_dz , nz_ref , rho_0 )) & * state % multilayer % h_layer ( kn , nbr ) end do else nbr_valid ( e ) = . false . end if else nbr_valid ( e ) = . false . end if end do do k = 1 , nz ! Centre column's layer k centre depth and p there. z_mid = 0.5_wp * ( z_if ( k ) + z_if ( k + 1 )) p_here = p_if ( k + 1 ) & + 0.5_wp * ( state % multilayer % rho_layer ( k , cell ) & - rho_ref_at ( z_mid , state % multilayer % rho_ref , rho_ref_dz , & nz_ref , rho_0 )) & * state % multilayer % h_layer ( k , cell ) dp_dx = 0.0_wp dp_dy = 0.0_wp do e = 1 , 3 n1 = mesh % edge_n1 ( e , cell ) n2 = mesh % edge_n2 ( e , cell ) L_e = mesh % edge_len ( e , cell ) if ( nbr_valid ( e )) then nbr = nbr_idx ( e ) ! Default: z_mid below neighbour's bed -> shelf-break wall ! (treat the edge as reflective so no spurious gradient is ! generated by clamping to neighbour-bed pressure). p_nbr = p_here do kn = 1 , nz if ( z_mid >= zn_if_e ( kn + 1 , e ) . and . z_mid <= zn_if_e ( kn , e )) then if ( state % multilayer % h_layer ( kn , nbr ) > DRY_TOLERANCE ) then frac = ( z_mid - zn_if_e ( kn + 1 , e )) / state % multilayer % h_layer ( kn , nbr ) else frac = 0.0_wp end if z_mid_lay = 0.5_wp * ( zn_if_e ( kn , e ) + zn_if_e ( kn + 1 , e )) p_nbr = pn_if_e ( kn + 1 , e ) + frac & * ( state % multilayer % rho_layer ( kn , nbr ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , & rho_ref_dz , nz_ref , rho_0 )) & * state % multilayer % h_layer ( kn , nbr ) exit end if end do else ! Boundary edge or thin neighbour column: reflective wall. p_nbr = p_here end if p_edge = 0.5_wp * ( p_here + p_nbr ) dp_dx = dp_dx + p_edge * n1 * L_e dp_dy = dp_dy + p_edge * n2 * L_e end do dp_dx = dp_dx * inv_area dp_dy = dp_dy * inv_area ! Convert from integrated-density-anomaly to acceleration: !   a = -(g/rho_0) * dp/dx  (and likewise y) dp_dx = GRAVITY * inv_rho0 * dp_dx dp_dy = GRAVITY * inv_rho0 * dp_dy ! Reduced-gravity CFL cap (same as the sigma kernel). g_prime = GRAVITY * abs ( state % multilayer % rho_layer ( nz , cell ) - state % multilayer % rho_layer ( 1 , cell )) & * inv_rho0 g_prime = max ( g_prime , 1.0e-6_wp ) bpg_max = sqrt ( g_prime * H_col ) / max ( dt , 1.0e-10_wp ) bpg_mag = sqrt ( dp_dx * dp_dx + dp_dy * dp_dy ) if ( bpg_mag > bpg_max . and . bpg_mag > 0.0_wp ) then bpg_scale = bpg_max / bpg_mag dp_dx = dp_dx * bpg_scale dp_dy = dp_dy * bpg_scale end if ! VCOORD_ZSTAR_FULL: vanishing layers carry no momentum. if ( state % multilayer % h_layer ( k , cell ) > VANISHING_LAYER_TOL_UNSTR ) then state % multilayer % hu_layer ( k , cell ) = state % multilayer % hu_layer ( k , cell ) & - dt * state % multilayer % h_layer ( k , cell ) * dp_dx state % multilayer % hv_layer ( k , cell ) = state % multilayer % hv_layer ( k , cell ) & - dt * state % multilayer % h_layer ( k , cell ) * dp_dy else state % multilayer % hu_layer ( k , cell ) = 0.0_wp state % multilayer % hv_layer ( k , cell ) = 0.0_wp end if end do end do end subroutine ml_baroclinic_pressure_gradient_jacobian_unstr","tags":"","url":"proc/ml_baroclinic_pressure_gradient_jacobian_unstr.html"},{"title":"ml_baroclinic_pressure_gradient_unstr – Rakali","text":"public pure subroutine ml_baroclinic_pressure_gradient_unstr(state, mesh, dt) Apply baroclinic pressure gradient as explicit source term. The hydrostatic internal pressure anomaly at layer k center is:\n  p_int(k) = g * [sum_{j=k+1}&#94;{nz} (rho_j - rho_0) * h_j\n                  + 0.5 * (rho_k - rho_0) * h_k] The baroclinic PGF for layer k is:\n  BPG_k = -(1/rho_0) * grad(p_int(k)) Applied as:\n  hu_k += dt * h_k * BPG_k&#94;x\n  hv_k += dt * h_k * BPG_k&#94;y Uses Green-Gauss for the gradient on triangles:\n  grad(p) = (1/A) * sum_e p_edge * n_e * L_e Includes a reduced-gravity acceleration cap: sqrt(g’*H)/dt\nto prevent sigma PGE from creating supersonic velocities. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~ml_baroclinic_pressure_gradient_unstr~~CallsGraph proc~ml_baroclinic_pressure_gradient_unstr ml_baroclinic_pressure_gradient_unstr local local proc~ml_baroclinic_pressure_gradient_unstr->local proc~rho_ref_at rho_ref_at proc~ml_baroclinic_pressure_gradient_unstr->proc~rho_ref_at Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_baroclinic_pressure_gradient_unstr~~CalledByGraph proc~ml_baroclinic_pressure_gradient_unstr ml_baroclinic_pressure_gradient_unstr proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_unstr proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~ml_baroclinic_pressure_gradient_unstr proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: H_col real(kind=wp), private :: L_e real(kind=wp), private :: acc real(kind=wp), private :: bpg_mag real(kind=wp), private :: bpg_max real(kind=wp), private :: bpg_scale integer, private :: cell real(kind=wp), private :: dp_dx real(kind=wp), private :: dp_dy integer, private :: e real(kind=wp), private :: g_prime real(kind=wp), private :: inv_area real(kind=wp), private :: inv_rho0 integer, private :: k integer, private :: kn integer, private :: n real(kind=wp), private :: n1 real(kind=wp), private :: n2 integer, private :: nbr integer, private :: nz integer, private :: nz_ref real(kind=wp), private :: p_edge real(kind=wp), private :: p_here real(kind=wp), private :: p_int (BPG_NZ_MAX) real(kind=wp), private :: p_int_nbr (BPG_NZ_MAX) real(kind=wp), private :: p_nbr real(kind=wp), private :: rho_0 real(kind=wp), private :: rho_ref_dz real(kind=wp), private :: z_bot real(kind=wp), private :: z_mid_lay real(kind=wp), private :: z_top Source Code pure subroutine ml_baroclinic_pressure_gradient_unstr ( state , mesh , dt ) !! Apply baroclinic pressure gradient as explicit source term. !! !! The hydrostatic internal pressure anomaly at layer k center is: !!   p_int(k) = g * [sum_{j=k+1}&#94;{nz} (rho_j - rho_0) * h_j !!                   + 0.5 * (rho_k - rho_0) * h_k] !! !! The baroclinic PGF for layer k is: !!   BPG_k = -(1/rho_0) * grad(p_int(k)) !! !! Applied as: !!   hu_k += dt * h_k * BPG_k&#94;x !!   hv_k += dt * h_k * BPG_k&#94;y !! !! Uses Green-Gauss for the gradient on triangles: !!   grad(p) = (1/A) * sum_e p_edge * n_e * L_e !! !! Includes a reduced-gravity acceleration cap: sqrt(g'*H)/dt !! to prevent sigma PGE from creating supersonic velocities. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer :: cell , k , kn , e , nbr , nz , n , nz_ref real ( wp ) :: inv_area , inv_rho0 , rho_ref_dz , rho_0 real ( wp ) :: acc , p_here , p_nbr , p_edge real ( wp ) :: dp_dx , dp_dy , n1 , n2 , L_e real ( wp ) :: g_prime , H_col , bpg_max , bpg_mag , bpg_scale real ( wp ) :: z_top , z_bot , z_mid_lay ! Stack workspace for internal pressure (nz values per cell) real ( wp ) :: p_int ( BPG_NZ_MAX ) real ( wp ) :: p_int_nbr ( BPG_NZ_MAX ) if (. not . state % use_multilayer ) return nz = state % multilayer % nz_ml n = mesh % ncells_owned if ( nz > BPG_NZ_MAX ) then ! Defence-in-depth only: validate_config refuses unstructured ! multilayer configs with nz + 1 > BPG_NZ_MAX up front ! (bpg_nz_is_sufficient in rki_ml_common_unstr), so this cannot ! fire on a validated run.  Kept so a caller that bypasses ! config validation overruns nothing — but note the cost of ! reaching it is silently skipping the whole baroclinic ! pressure gradient. return end if inv_rho0 = 1.0_wp / state % multilayer % rho_0 rho_0 = state % multilayer % rho_0 rho_ref_dz = state % multilayer % rho_ref_dz nz_ref = state % multilayer % nz_ref do concurrent ( cell = 1 : n ) local ( k , kn , e , nbr , inv_area , acc , p_here , p_nbr , & p_edge , dp_dx , dp_dy , n1 , n2 , L_e , & g_prime , H_col , bpg_max , bpg_mag , bpg_scale , & z_top , z_bot , z_mid_lay , & p_int , p_int_nbr ) ! Skip thin columns H_col = state % barotropic % height_cv ( cell ) if ( H_col < ML_MIN_DEPTH_UNSTR ) cycle inv_area = 1.0_wp / mesh % area ( cell ) ! ---- Compute internal pressure at this cell's layer centers ---- ! Integrate from surface (k = nz) downward to bed (k = 1) using ! the density anomaly `(rho - rho_ref(z))` (Phase B2). When the ! reference profile is unset (rho_ref_dz==0) the helper returns ! `rho_0`, recovering the pre-B2 anomaly. acc = 0.0_wp z_top = 0.0_wp do k = nz , 1 , - 1 z_bot = z_top + state % multilayer % h_layer ( k , cell ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( state % multilayer % rho_layer ( k , cell ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , rho_ref_dz , & nz_ref , rho_0 )) & * state % multilayer % h_layer ( k , cell ) p_int ( k ) = acc - 0.5_wp * ( state % multilayer % rho_layer ( k , cell ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , & rho_ref_dz , nz_ref , rho_0 )) & * state % multilayer % h_layer ( k , cell ) z_top = z_bot end do ! ---- Compute gradient using Green-Gauss ---- ! dp/dx = (1/A) * sum_e p_edge * n1 * L ! dp/dy = (1/A) * sum_e p_edge * n2 * L do k = 1 , nz dp_dx = 0.0_wp dp_dy = 0.0_wp p_here = p_int ( k ) do e = 1 , 3 nbr = mesh % neighbours ( e , cell ) n1 = mesh % edge_n1 ( e , cell ) n2 = mesh % edge_n2 ( e , cell ) L_e = mesh % edge_len ( e , cell ) if ( nbr > 0 ) then ! Interior edge: compute neighbour's internal pressure ! We need p_int at layer k for the neighbour if ( state % barotropic % height_cv ( nbr ) >= ML_MIN_DEPTH_UNSTR ) then acc = 0.0_wp z_top = 0.0_wp do kn = nz , 1 , - 1 z_bot = z_top + state % multilayer % h_layer ( kn , nbr ) z_mid_lay = 0.5_wp * ( z_top + z_bot ) acc = acc + ( state % multilayer % rho_layer ( kn , nbr ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , & rho_ref_dz , nz_ref , rho_0 )) & * state % multilayer % h_layer ( kn , nbr ) if ( kn == k ) then p_nbr = acc - 0.5_wp * ( state % multilayer % rho_layer ( k , nbr ) & - rho_ref_at ( z_mid_lay , state % multilayer % rho_ref , & rho_ref_dz , nz_ref , rho_0 )) & * state % multilayer % h_layer ( k , nbr ) end if z_top = z_bot end do else p_nbr = p_here ! Dry neighbour: no gradient end if p_edge = 0.5_wp * ( p_here + p_nbr ) else ! Boundary edge: extrapolate (use cell value) p_edge = p_here end if ! Green-Gauss contribution dp_dx = dp_dx + p_edge * n1 * L_e dp_dy = dp_dy + p_edge * n2 * L_e end do dp_dx = dp_dx * inv_area dp_dy = dp_dy * inv_area ! Apply acceleration: a = -(g/rho_0) * dp/dx ! Momentum: hu += dt * h * a = -dt * h * (g/rho_0) * dp/dx ! But p_int already has g factored in? No - p_int = (rho-rho_0)*h ! So we need to multiply by g: a = -(g/rho_0) * g * dp/dx = -g²/rho_0 * dp/dx ! Wait, let me check the structured code... ! p_int(k) = acc - 0.5*(rho-rho_0)*h  (units: kg/m² = pressure/g) ! dp_dx has units kg/m³ ! Then: GRAVITY * inv_rho0 * dp_dx gives acceleration (m/s²) ! So we multiply dp by GRAVITY to get pressure gradient, then by 1/rho_0 dp_dx = GRAVITY * inv_rho0 * dp_dx dp_dy = GRAVITY * inv_rho0 * dp_dy ! Limiter: cap BPG acceleration to sqrt(g'*H)/dt ! g' = g * (rho_bot - rho_top) / rho_0 g_prime = GRAVITY * abs ( state % multilayer % rho_layer ( nz , cell ) - state % multilayer % rho_layer ( 1 , cell )) & * inv_rho0 g_prime = max ( g_prime , 1.0e-6_wp ) ! Floor to avoid sqrt(0) bpg_max = sqrt ( g_prime * H_col ) / max ( dt , 1.0e-10_wp ) bpg_mag = sqrt ( dp_dx * dp_dx + dp_dy * dp_dy ) if ( bpg_mag > bpg_max . and . bpg_mag > 0.0_wp ) then bpg_scale = bpg_max / bpg_mag dp_dx = dp_dx * bpg_scale dp_dy = dp_dy * bpg_scale end if ! Apply to layer momentum. ! VCOORD_ZSTAR_FULL: vanishing layers carry no momentum. if ( state % multilayer % h_layer ( k , cell ) > VANISHING_LAYER_TOL_UNSTR ) then state % multilayer % hu_layer ( k , cell ) = state % multilayer % hu_layer ( k , cell ) & - dt * state % multilayer % h_layer ( k , cell ) * dp_dx state % multilayer % hv_layer ( k , cell ) = state % multilayer % hv_layer ( k , cell ) & - dt * state % multilayer % h_layer ( k , cell ) * dp_dy else state % multilayer % hu_layer ( k , cell ) = 0.0_wp state % multilayer % hv_layer ( k , cell ) = 0.0_wp end if end do end do end subroutine ml_baroclinic_pressure_gradient_unstr","tags":"","url":"proc/ml_baroclinic_pressure_gradient_unstr.html"},{"title":"unstr_surface_forcing_destroy – Rakali","text":"private  subroutine unstr_surface_forcing_destroy(this) Type Bound unstr_surface_forcing_t Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this Called by proc~~unstr_surface_forcing_destroy~~CalledByGraph proc~unstr_surface_forcing_destroy unstr_surface_forcing_t%unstr_surface_forcing_destroy proc~unstr_surface_forcing_init unstr_surface_forcing_t%unstr_surface_forcing_init proc~unstr_surface_forcing_init->proc~unstr_surface_forcing_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine unstr_surface_forcing_destroy ( this ) class ( unstr_surface_forcing_t ), intent ( inout ) :: this if ( allocated ( this % heat_flux )) deallocate ( this % heat_flux ) if ( allocated ( this % evap_minus_precip )) deallocate ( this % evap_minus_precip ) if ( allocated ( this % wind_x )) deallocate ( this % wind_x ) if ( allocated ( this % wind_y )) deallocate ( this % wind_y ) this % active = . false . this % wind_active = . false . end subroutine unstr_surface_forcing_destroy","tags":"","url":"proc/unstr_surface_forcing_destroy.html"},{"title":"unstr_surface_forcing_enter_data – Rakali","text":"private  subroutine unstr_surface_forcing_enter_data(this) Map the forcing allocatables onto the device.  The parent unstr_state_t%forcing value-type member rides over with the\nparent copyin(state) ; only the inner allocatable arrays need\nexplicit attaches.  Both fields are read-only in the kernel\nand updated from host via set_* setters, so copyin is the\nright initial direction. Type Bound unstr_surface_forcing_t Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this Source Code subroutine unstr_surface_forcing_enter_data ( this ) !! Map the forcing allocatables onto the device.  The parent !! `unstr_state_t%forcing` value-type member rides over with the !! parent `copyin(state)`; only the inner allocatable arrays need !! explicit attaches.  Both fields are read-only in the kernel !! and updated from host via `set_*` setters, so `copyin` is the !! right initial direction. class ( unstr_surface_forcing_t ), intent ( inout ) :: this !$acc enter data copyin(this%heat_flux, this%evap_minus_precip, & !$acc&                  this%wind_x, this%wind_y) end subroutine unstr_surface_forcing_enter_data","tags":"","url":"proc/unstr_surface_forcing_enter_data.html"},{"title":"unstr_surface_forcing_exit_data – Rakali","text":"private  subroutine unstr_surface_forcing_exit_data(this) Counterpart to enter_data .  No copy-out: forcing is set from\nhost, never produced on device, so the device copies have no\ninformation the host doesn’t already have. Type Bound unstr_surface_forcing_t Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this Source Code subroutine unstr_surface_forcing_exit_data ( this ) !! Counterpart to `enter_data`.  No copy-out: forcing is set from !! host, never produced on device, so the device copies have no !! information the host doesn't already have. class ( unstr_surface_forcing_t ), intent ( inout ) :: this !$acc exit data delete(this%heat_flux, this%evap_minus_precip, & !$acc&                 this%wind_x, this%wind_y) end subroutine unstr_surface_forcing_exit_data","tags":"","url":"proc/unstr_surface_forcing_exit_data.html"},{"title":"unstr_surface_forcing_init – Rakali","text":"private  subroutine unstr_surface_forcing_init(this, mesh) Allocate the surface-forcing arrays sized to the mesh,\nzero-initialised.  Always safe to call – destroys first. Type Bound unstr_surface_forcing_t Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh Calls proc~~unstr_surface_forcing_init~~CallsGraph proc~unstr_surface_forcing_init unstr_surface_forcing_t%unstr_surface_forcing_init proc~unstr_surface_forcing_destroy unstr_surface_forcing_t%unstr_surface_forcing_destroy proc~unstr_surface_forcing_init->proc~unstr_surface_forcing_destroy Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: n Source Code subroutine unstr_surface_forcing_init ( this , mesh ) !! Allocate the surface-forcing arrays sized to the mesh, !! zero-initialised.  Always safe to call -- destroys first. class ( unstr_surface_forcing_t ), intent ( inout ) :: this type ( mesh_unstr_t ), intent ( in ) :: mesh integer :: n call this % destroy () n = mesh % ncells_total allocate ( this % heat_flux ( n ), source = 0.0_wp ) allocate ( this % evap_minus_precip ( n ), source = 0.0_wp ) allocate ( this % wind_x ( n ), source = 0.0_wp ) allocate ( this % wind_y ( n ), source = 0.0_wp ) end subroutine unstr_surface_forcing_init","tags":"","url":"proc/unstr_surface_forcing_init.html"},{"title":"efp_bin1_within_transport_bound – Rakali","text":"public pure function efp_bin1_within_transport_bound(a, nranks) result(ok) Bin 1 is NOT bounded by efp_carry (only bins 2..6 are – see the\nmodule docstring), so the double-precision transport needs its\nown guard: after summing nranks local values, the partial sum\nin bin 1 must stay <= 2**53 / nranks for the MPI_SUM-on-doubles\ncombine to remain exact (the analogue of MOM6’s prec_error = huge(1_int64) / num_PEs , but for the int64-as-\ndouble transport rather than int64 transport). .false. ⇒ the\ncaller must error stop , never silently proceed. Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: a integer, intent(in) :: nranks Return Value logical Variables Type Visibility Attributes Name Initial integer(kind=int64), private :: bound Source Code pure function efp_bin1_within_transport_bound ( a , nranks ) result ( ok ) !! Bin 1 is NOT bounded by `efp_carry` (only bins 2..6 are -- see the !! module docstring), so the double-precision transport needs its !! own guard: after summing `nranks` local values, the partial sum !! in bin 1 must stay `<= 2**53 / nranks` for the MPI_SUM-on-doubles !! combine to remain exact (the analogue of MOM6's !! `prec_error = huge(1_int64) / num_PEs`, but for the int64-as- !! double transport rather than int64 transport).  `.false.` ⇒ the !! caller must `error stop`, never silently proceed. type ( efp_t ), intent ( in ) :: a integer , intent ( in ) :: nranks logical :: ok integer ( int64 ) :: bound if ( nranks <= 0 ) then ok = . true . return end if bound = ( 2_int64 ** 53 ) / int ( nranks , int64 ) ok = abs ( a % v ( 1 )) <= bound end function efp_bin1_within_transport_bound","tags":"","url":"proc/efp_bin1_within_transport_bound.html"},{"title":"efp_from_real – Rakali","text":"public pure function efp_from_real(r) result(a) real64 -> efp_t .  Wraps efp_decompose , discarding the NaN /\noverflow flags (callers needing them should call efp_decompose directly). Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: r Return Value type( efp_t ) Calls proc~~efp_from_real~~CallsGraph proc~efp_from_real efp_from_real proc~efp_decompose efp_decompose proc~efp_from_real->proc~efp_decompose Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial logical, private :: is_nan logical, private :: is_ovf Source Code pure function efp_from_real ( r ) result ( a ) !! `real64 -> efp_t`.  Wraps `efp_decompose`, discarding the NaN / !! overflow flags (callers needing them should call `efp_decompose` !! directly). real ( real64 ), intent ( in ) :: r type ( efp_t ) :: a logical :: is_nan , is_ovf call efp_decompose ( r , a % v , is_nan , is_ovf ) end function efp_from_real","tags":"","url":"proc/efp_from_real.html"},{"title":"efp_minus – Rakali","text":"public pure function efp_minus(a, b) result(c) Exact bin-wise integer subtraction, regularised.  See efp_plus for why regularisation (not mere carry) is required for\nbit-for-bit order invariance. Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: a type( efp_t ), intent(in) :: b Return Value type( efp_t ) Calls proc~~efp_minus~~CallsGraph proc~efp_minus efp_minus proc~efp_regularize efp_regularize proc~efp_minus->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~efp_minus~~CalledByGraph proc~efp_minus efp_minus proc~efp_real_diff efp_real_diff proc~efp_real_diff->proc~efp_minus proc~console_stats_report console_stats_report proc~console_stats_report->proc~efp_real_diff proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~console_stats_report proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function efp_minus ( a , b ) result ( c ) !! Exact bin-wise integer subtraction, regularised.  See `efp_plus` !! for why regularisation (not mere carry) is required for !! bit-for-bit order invariance. type ( efp_t ), intent ( in ) :: a , b type ( efp_t ) :: c c % v = a % v - b % v call efp_regularize ( c % v ) end function efp_minus","tags":"","url":"proc/efp_minus.html"},{"title":"efp_plus – Rakali","text":"public pure function efp_plus(a, b) result(c) Exact bin-wise integer addition, REGULARISED (not merely\ncarried).  Order-invariant BIT-FOR-BIT: efp_plus(a,b)%v == efp_plus(b,a)%v , and a running fold acc = efp_plus(acc, x_i) over any permutation of the x_i converges to the SAME raw bins (not merely the same reconstructed\nreal) – test_efp_order_invariant asserts this on %v(:) directly, per the plan’s §9.2. efp_carry alone is NOT sufficient here: it only bounds each\nbin’s MAGNITUDE ( |e(n)| < 2**P ), and a magnitude-bounded but\nmixed-sign bin vector is a REDUNDANT (non-unique) representation\nof a given value – e.g. [e2=1, e3=-(2**P-100)] and [e2=0, e3=100] both represent the value 100 , but differ\nbit-for-bit.  Two different accumulation orders can land on\ndifferent members of that redundant family even though the\nrepresented value is identical. efp_regularize additionally\nforces every bin to share the overall sign, which – like\nordinary sign-magnitude fixed-radix representations – IS\nunique for a given value, closing that gap. Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: a type( efp_t ), intent(in) :: b Return Value type( efp_t ) Calls proc~~efp_plus~~CallsGraph proc~efp_plus efp_plus proc~efp_regularize efp_regularize proc~efp_plus->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function efp_plus ( a , b ) result ( c ) !! Exact bin-wise integer addition, REGULARISED (not merely !! carried).  Order-invariant BIT-FOR-BIT: !! `efp_plus(a,b)%v == efp_plus(b,a)%v`, and a running fold !! `acc = efp_plus(acc, x_i)` over any permutation of the `x_i` !! converges to the SAME raw bins (not merely the same reconstructed !! real) -- `test_efp_order_invariant` asserts this on `%v(:)` !! directly, per the plan's §9.2. !! !! `efp_carry` alone is NOT sufficient here: it only bounds each !! bin's MAGNITUDE (`|e(n)| < 2**P`), and a magnitude-bounded but !! mixed-sign bin vector is a REDUNDANT (non-unique) representation !! of a given value -- e.g. `[e2=1, e3=-(2**P-100)]` and !! `[e2=0, e3=100]` both represent the value `100`, but differ !! bit-for-bit.  Two different accumulation orders can land on !! different members of that redundant family even though the !! represented value is identical.  `efp_regularize` additionally !! forces every bin to share the overall sign, which -- like !! ordinary sign-magnitude fixed-radix representations -- IS !! unique for a given value, closing that gap. type ( efp_t ), intent ( in ) :: a , b type ( efp_t ) :: c c % v = a % v + b % v call efp_regularize ( c % v ) end function efp_plus","tags":"","url":"proc/efp_plus.html"},{"title":"efp_real_diff – Rakali","text":"public pure function efp_real_diff(a, b) result(r) real64 = efp_to_real(efp_minus(a, b)) – the difference of two\n~1e21-scale EFP totals resolved to the EFP quantum ( 2**-3P ), NOT\nto ulp(1e21) as a double subtraction would give.  This is the\nfix documented in the plan’s SS2.2: an implementer who converts\nboth operands to real64 FIRST and subtracts loses the whole\nbenefit of this module. Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: a type( efp_t ), intent(in) :: b Return Value real(kind=real64) Calls proc~~efp_real_diff~~CallsGraph proc~efp_real_diff efp_real_diff proc~efp_minus efp_minus proc~efp_real_diff->proc~efp_minus proc~efp_to_real efp_to_real proc~efp_real_diff->proc~efp_to_real proc~efp_regularize efp_regularize proc~efp_minus->proc~efp_regularize proc~efp_to_real->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~efp_real_diff~~CalledByGraph proc~efp_real_diff efp_real_diff proc~console_stats_report console_stats_report proc~console_stats_report->proc~efp_real_diff proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~console_stats_report proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function efp_real_diff ( a , b ) result ( r ) !! `real64 = efp_to_real(efp_minus(a, b))` -- the difference of two !! ~1e21-scale EFP totals resolved to the EFP quantum (`2**-3P`), NOT !! to `ulp(1e21)` as a double subtraction would give.  This is the !! fix documented in the plan's SS2.2: an implementer who converts !! both operands to `real64` FIRST and subtracts loses the whole !! benefit of this module. type ( efp_t ), intent ( in ) :: a , b real ( real64 ) :: r r = efp_to_real ( efp_minus ( a , b )) end function efp_real_diff","tags":"","url":"proc/efp_real_diff.html"},{"title":"efp_to_real – Rakali","text":"public pure function efp_to_real(a) result(r) efp_t -> real64 .  Regularises a LOCAL COPY of a (never mutates\nthe argument) – pure with intent(in) , per FORTRAN_STYLE.md ’s “default new procedures to pure” (MOM6’s EFP_to_real instead mutates its intent(inout) argument). Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: a Return Value real(kind=real64) Calls proc~~efp_to_real~~CallsGraph proc~efp_to_real efp_to_real proc~efp_regularize efp_regularize proc~efp_to_real->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~efp_to_real~~CalledByGraph proc~efp_to_real efp_to_real proc~efp_real_diff efp_real_diff proc~efp_real_diff->proc~efp_to_real proc~console_stats_report console_stats_report proc~console_stats_report->proc~efp_real_diff proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~console_stats_report proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~emit_periodic_status Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=int64), private :: e (EFP_DIGITS) Source Code pure function efp_to_real ( a ) result ( r ) !! `efp_t -> real64`.  Regularises a LOCAL COPY of `a` (never mutates !! the argument) -- `pure` with `intent(in)`, per !! `FORTRAN_STYLE.md`'s \"default new procedures to pure\" (MOM6's !! `EFP_to_real` instead mutates its `intent(inout)` argument). type ( efp_t ), intent ( in ) :: a real ( real64 ) :: r integer ( int64 ) :: e ( EFP_DIGITS ) e = a % v call efp_regularize ( e ) r = real ( e ( 1 ), real64 ) * EFP_PR1 + real ( e ( 2 ), real64 ) * EFP_PR2 & + real ( e ( 3 ), real64 ) * EFP_PR3 + real ( e ( 4 ), real64 ) * EFP_PR4 & + real ( e ( 5 ), real64 ) * EFP_PR5 + real ( e ( 6 ), real64 ) * EFP_PR6 end function efp_to_real","tags":"","url":"proc/efp_to_real.html"},{"title":"efp_carry – Rakali","text":"public pure subroutine efp_carry(e) Renormalise bins 6..2 into (-2**P, 2**P) , propagating the excess\ninto the next-more-significant bin, without changing the\nrepresented value.  Bin 1 is left untouched (unbounded by\nconstruction; see the module docstring on EFP_MAX_RANKS ).\nMirrors MOM6 carry_overflow , which loops EFP_DIGITS..2 for the same reason. Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(inout) :: e (EFP_DIGITS) Called by proc~~efp_carry~~CalledByGraph proc~efp_carry efp_carry proc~efp_regularize efp_regularize proc~efp_regularize->proc~efp_carry proc~efp_from_transport efp_from_transport proc~efp_from_transport->proc~efp_regularize proc~efp_minus efp_minus proc~efp_minus->proc~efp_regularize proc~efp_plus efp_plus proc~efp_plus->proc~efp_regularize proc~efp_to_real efp_to_real proc~efp_to_real->proc~efp_regularize proc~efp_real_diff efp_real_diff proc~efp_real_diff->proc~efp_minus proc~efp_real_diff->proc~efp_to_real proc~console_stats_report console_stats_report proc~console_stats_report->proc~efp_real_diff proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~console_stats_report Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer(kind=int64), private :: carry_amt integer, private :: n Source Code pure subroutine efp_carry ( e ) !! Renormalise bins 6..2 into `(-2**P, 2**P)`, propagating the excess !! into the next-more-significant bin, without changing the !! represented value.  Bin 1 is left untouched (unbounded by !! construction; see the module docstring on `EFP_MAX_RANKS`). !! Mirrors MOM6 `carry_overflow`, which loops !! `EFP_DIGITS..2` for the same reason. integer ( int64 ), intent ( inout ) :: e ( EFP_DIGITS ) integer :: n integer ( int64 ) :: carry_amt do n = EFP_DIGITS , 2 , - 1 if ( e ( n ) >= EFP_PREC_I64 . or . e ( n ) <= - EFP_PREC_I64 ) then carry_amt = e ( n ) / EFP_PREC_I64 e ( n ) = e ( n ) - carry_amt * EFP_PREC_I64 e ( n - 1 ) = e ( n - 1 ) + carry_amt end if end do end subroutine efp_carry","tags":"","url":"proc/efp_carry.html"},{"title":"efp_decompose – Rakali","text":"public pure subroutine efp_decompose(r, e, is_nan, is_ovf) Greedy sign-magnitude fixed-point decomposition of r into six int64 bins of weight pr(n) , n = 1..6 .  Unrolled (no loop, no\narray indexing over pr / I_pr ) so this is a template a !$acc routine seq in-module duplicate can mirror exactly (see rki_ocean_console_stats::efp_decompose_impl , which pins against\nthis procedure in test_efp_impl_matches_canonical ). is_nan is set (and e = 0 ) for a NaN input, using ieee_is_nan -equivalent structural comparison so the module stays\nindependent of ieee_arithmetic ’s import list elsewhere. is_ovf is set when |r| >= pr(1) * huge(1_int64) – the largest\nmagnitude bin 1 can represent – and e is truncated to that\nbound rather than silently wrapping. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: r integer(kind=int64), intent(out) :: e (EFP_DIGITS) logical, intent(out) :: is_nan logical, intent(out) :: is_ovf Called by proc~~efp_decompose~~CalledByGraph proc~efp_decompose efp_decompose proc~efp_from_real efp_from_real proc~efp_from_real->proc~efp_decompose Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=real64), private, parameter :: MAX_E1 = real(huge(0_int64), real64) huge(1_int64) widened to real64 (rounds to the nearest\nrepresentable double, ~9.223372036854776e18) – the largest\nmagnitude bin 1 can safely hold; used as the overflow ceiling\nbelow. real(kind=real64), private :: rs real(kind=real64), private :: s Source Code pure subroutine efp_decompose ( r , e , is_nan , is_ovf ) !! Greedy sign-magnitude fixed-point decomposition of `r` into six !! `int64` bins of weight `pr(n)`, `n = 1..6`.  Unrolled (no loop, no !! array indexing over `pr`/`I_pr`) so this is a template a !! `!$acc routine seq` in-module duplicate can mirror exactly (see !! `rki_ocean_console_stats::efp_decompose_impl`, which pins against !! this procedure in `test_efp_impl_matches_canonical`). !! !! `is_nan` is set (and `e = 0`) for a NaN input, using !! `ieee_is_nan`-equivalent structural comparison so the module stays !! independent of `ieee_arithmetic`'s import list elsewhere. !! `is_ovf` is set when `|r| >= pr(1) * huge(1_int64)` -- the largest !! magnitude bin 1 can represent -- and `e` is truncated to that !! bound rather than silently wrapping. real ( real64 ), intent ( in ) :: r integer ( int64 ), intent ( out ) :: e ( EFP_DIGITS ) logical , intent ( out ) :: is_nan logical , intent ( out ) :: is_ovf real ( real64 ) :: rs , s real ( real64 ), parameter :: MAX_E1 = real ( huge ( 0_int64 ), real64 ) !! `huge(1_int64)` widened to real64 (rounds to the nearest !! representable double, ~9.223372036854776e18) -- the largest !! magnitude bin 1 can safely hold; used as the overflow ceiling !! below. is_nan = ieee_is_nan ( r ) is_ovf = . false . e = 0_int64 if ( is_nan ) return s = 1.0_real64 rs = r if ( rs < 0.0_real64 ) then s = - 1.0_real64 rs = - rs end if if ( rs * EFP_IPR1 >= MAX_E1 ) then is_ovf = . true . e ( 1 ) = int ( sign ( MAX_E1 , s ), int64 ) return end if e ( 1 ) = int ( s * aint ( rs * EFP_IPR1 ), int64 ) rs = rs - real ( abs ( e ( 1 )), real64 ) * EFP_PR1 e ( 2 ) = int ( s * aint ( rs * EFP_IPR2 ), int64 ) rs = rs - real ( abs ( e ( 2 )), real64 ) * EFP_PR2 e ( 3 ) = int ( s * aint ( rs * EFP_IPR3 ), int64 ) rs = rs - real ( abs ( e ( 3 )), real64 ) * EFP_PR3 e ( 4 ) = int ( s * aint ( rs * EFP_IPR4 ), int64 ) rs = rs - real ( abs ( e ( 4 )), real64 ) * EFP_PR4 e ( 5 ) = int ( s * aint ( rs * EFP_IPR5 ), int64 ) rs = rs - real ( abs ( e ( 5 )), real64 ) * EFP_PR5 e ( 6 ) = int ( s * aint ( rs * EFP_IPR6 ), int64 ) ! Remainder `rs - |e(6)|*pr(6)` is the deterministic dropped quantum, ! `0 <= remainder < pr(6) = 2**-3P` -- not retained (matches MOM6: ! only six bins are kept). end subroutine efp_decompose","tags":"","url":"proc/efp_decompose.html"},{"title":"efp_from_transport – Rakali","text":"public pure subroutine efp_from_transport(buf, list, ok) Inverse of efp_to_transport : unpack a flat real64(6*n) buffer\n(post-collective, still exact integers as doubles) back into efp_t values, converting each bin back to int64 and carrying. ok = .false. iff any unpacked double is not an exact integer\n(would indicate the transport-exactness bound was violated) –\nthe caller ( halo_allreduce_efp_list ) turns that into a fail-loud error stop , never a silent truncation. Arguments Type Intent Optional Attributes Name real(kind=real64), intent(in) :: buf (:) type( efp_t ), intent(out) :: list (:) logical, intent(out) :: ok Calls proc~~efp_from_transport~~CallsGraph proc~efp_from_transport efp_from_transport proc~efp_regularize efp_regularize proc~efp_from_transport->proc~efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: n real(kind=real64), private :: val Source Code pure subroutine efp_from_transport ( buf , list , ok ) !! Inverse of `efp_to_transport`: unpack a flat `real64(6*n)` buffer !! (post-collective, still exact integers as doubles) back into !! `efp_t` values, converting each bin back to `int64` and carrying. !! `ok = .false.` iff any unpacked double is not an exact integer !! (would indicate the transport-exactness bound was violated) -- !! the caller (`halo_allreduce_efp_list`) turns that into a fail-loud !! `error stop`, never a silent truncation. real ( real64 ), intent ( in ) :: buf (:) type ( efp_t ), intent ( out ) :: list (:) logical , intent ( out ) :: ok integer :: i , n real ( real64 ) :: val ok = . true . do i = 1 , size ( list ) do n = 1 , EFP_DIGITS val = buf (( i - 1 ) * EFP_DIGITS + n ) if ( val /= aint ( val )) ok = . false . list ( i )% v ( n ) = int ( val , int64 ) end do ! Regularise (not merely carry) so the post-combine bins are the ! SAME canonical representation a single-rank EFP sum of the ! whole field would produce -- see `efp_plus`'s docstring for why ! carry alone is not bit-for-bit order-invariant. call efp_regularize ( list ( i )% v ) end do end subroutine efp_from_transport","tags":"","url":"proc/efp_from_transport.html"},{"title":"efp_regularize – Rakali","text":"public pure subroutine efp_regularize(e) efp_carry plus: force every bin to share the overall sign, so a\nsingle well-conditioned FP accumulation ( efp_to_real ) can form Sum pr(n)*e(n) without alternating-sign cancellation error.\nMirrors MOM6 regularize_ints . After efp_carry , bins 2..6 satisfy |e(n)| < 2**P .  The overall\nsign is that of the first (most-significant) nonzero bin.  A\nsingle descending pass then borrows/carries any bin of the\nopposite sign into [0, 2**P) (or (-2**P, 0] ) from its\nnext-more-significant neighbour – exact, since e(n-1)*2**P + e(n) is invariant under (e(n-1) -+ 1, e(n) +- 2**P) – and cascades: a neighbour driven negative/positive by one\nborrow is itself fixed on the next loop iteration. Arguments Type Intent Optional Attributes Name integer(kind=int64), intent(inout) :: e (EFP_DIGITS) Calls proc~~efp_regularize~~CallsGraph proc~efp_regularize efp_regularize proc~efp_carry efp_carry proc~efp_regularize->proc~efp_carry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~efp_regularize~~CalledByGraph proc~efp_regularize efp_regularize proc~efp_from_transport efp_from_transport proc~efp_from_transport->proc~efp_regularize proc~efp_minus efp_minus proc~efp_minus->proc~efp_regularize proc~efp_plus efp_plus proc~efp_plus->proc~efp_regularize proc~efp_to_real efp_to_real proc~efp_to_real->proc~efp_regularize proc~efp_real_diff efp_real_diff proc~efp_real_diff->proc~efp_minus proc~efp_real_diff->proc~efp_to_real proc~console_stats_report console_stats_report proc~console_stats_report->proc~efp_real_diff proc~coastal_console_stats_report coastal_console_stats_report proc~coastal_console_stats_report->proc~console_stats_report proc~emit_periodic_status emit_periodic_status proc~emit_periodic_status->proc~coastal_console_stats_report Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: n logical, private :: positive Source Code pure subroutine efp_regularize ( e ) !! `efp_carry` plus: force every bin to share the overall sign, so a !! single well-conditioned FP accumulation (`efp_to_real`) can form !! `Sum pr(n)*e(n)` without alternating-sign cancellation error. !! Mirrors MOM6 `regularize_ints`. !! !! After `efp_carry`, bins 2..6 satisfy `|e(n)| < 2**P`.  The overall !! sign is that of the first (most-significant) nonzero bin.  A !! single descending pass then borrows/carries any bin of the !! opposite sign into `[0, 2**P)` (or `(-2**P, 0]`) from its !! next-more-significant neighbour -- exact, since !! `e(n-1)*2**P + e(n)` is invariant under `(e(n-1) -+ 1, e(n) +- 2**P)` !! -- and cascades: a neighbour driven negative/positive by one !! borrow is itself fixed on the next loop iteration. integer ( int64 ), intent ( inout ) :: e ( EFP_DIGITS ) integer :: n logical :: positive call efp_carry ( e ) positive = . true . do n = 1 , EFP_DIGITS if ( e ( n ) /= 0_int64 ) then positive = e ( n ) > 0_int64 exit end if end do if ( positive ) then do n = EFP_DIGITS , 2 , - 1 if ( e ( n ) < 0_int64 ) then e ( n ) = e ( n ) + EFP_PREC_I64 e ( n - 1 ) = e ( n - 1 ) - 1_int64 end if end do else do n = EFP_DIGITS , 2 , - 1 if ( e ( n ) > 0_int64 ) then e ( n ) = e ( n ) - EFP_PREC_I64 e ( n - 1 ) = e ( n - 1 ) + 1_int64 end if end do end if end subroutine efp_regularize","tags":"","url":"proc/efp_regularize.html"},{"title":"efp_to_transport – Rakali","text":"public pure subroutine efp_to_transport(list, buf) Pack a list of efp_t values into a flat real64(6*n) buffer for\na single collective ( halo_allreduce_efp_list ).  Each bin is\ntransported as an EXACTLY-representable double (see EFP_MAX_RANKS ): buf((i-1)*EFP_DIGITS + n) = real(list(i)%v(n)) . Arguments Type Intent Optional Attributes Name type( efp_t ), intent(in) :: list (:) real(kind=real64), intent(out) :: buf (:) Variables Type Visibility Attributes Name Initial integer, private :: i integer, private :: n Source Code pure subroutine efp_to_transport ( list , buf ) !! Pack a list of `efp_t` values into a flat `real64(6*n)` buffer for !! a single collective (`halo_allreduce_efp_list`).  Each bin is !! transported as an EXACTLY-representable double (see !! `EFP_MAX_RANKS`): `buf((i-1)*EFP_DIGITS + n) = real(list(i)%v(n))`. type ( efp_t ), intent ( in ) :: list (:) real ( real64 ), intent ( out ) :: buf (:) integer :: i , n do i = 1 , size ( list ) do n = 1 , EFP_DIGITS buf (( i - 1 ) * EFP_DIGITS + n ) = real ( list ( i )% v ( n ), real64 ) end do end do end subroutine efp_to_transport","tags":"","url":"proc/efp_to_transport.html"},{"title":"interp_parent – Rakali","text":"private pure function interp_parent(fld_lo, fld_hi, ix, iy, wx, wy, alpha, pnx, pny) result(val) Bilinear spatial + linear temporal interpolation of parent field Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: fld_lo (:,:) real(kind=wp), intent(in) :: fld_hi (:,:) integer, intent(in) :: ix integer, intent(in) :: iy real(kind=wp), intent(in) :: wx real(kind=wp), int