tep proc~si_unstr_step->proc~si_unstr_advance proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dgdn integer, private :: i real(kind=wp), private :: inv_delta integer, private :: k integer, private :: kn real(kind=wp), private :: tau_n real(kind=wp), private :: un_e Source Code subroutine si_unstr_advance ( mesh , nct , nco , n_bc , stage , xmom , ymom , bed , & height , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , u_edge , u_star , Hf_edge , & eta_ghost_edge , u_n_edge , bc_type , & bc_eta_ext , wind_tau_x , wind_tau_y , & dt , theta , g_theta2_dt2 , gtheta_dt , & g_omtheta_dt , precond , rtol , iter_out , & mass_res_out , mg ) !! Flat-impl core: explicit-shape state arrays only (NVHPC device !! codegen — assumed-shape dummies in do-concurrent kernels emit !! per-launch descriptor-walk memcpys).  The edge workspaces !! `eta_ghost_edge` / `u_n_edge` are persistent slots on the SI state !! (mapped in its enter_data — no per-step allocation). type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct !! Cell array extent (ncells_total) — the explicit-shape dim. integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size (`MAX_BC_GROUPS`). real ( wp ), intent ( inout ) :: stage ( nct ), xmom ( nct ), ymom ( nct ), height ( nct ) real ( wp ), intent ( in ) :: bed ( nct ) real ( wp ), intent ( inout ) :: eta ( nct ), eta_r ( nct ), eta_p ( nct ), eta_Ap ( nct ) real ( wp ), intent ( inout ) :: eta_z ( nct ), eta_diag ( nct ) real ( wp ), intent ( inout ) :: u_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: u_star ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( inout ) :: u_n_edge ( EDGES_PER_TRI , nct ) integer , intent ( in ) :: bc_type ( n_bc ) real ( wp ), intent ( in ) :: bc_eta_ext ( n_bc ) real ( wp ), intent ( in ) :: wind_tau_x , wind_tau_y integer , intent ( in ) :: precond real ( wp ), intent ( in ) :: dt , theta , g_theta2_dt2 , gtheta_dt , g_omtheta_dt , rtol integer , intent ( out ) :: iter_out real ( wp ), intent ( out ) :: mass_res_out type ( agglom_hierarchy_unstr_t ), intent ( inout ), optional :: mg !! Aggregation-MG hierarchy (present iff precond == MG); its operator !! is refreshed here for this step's frozen Hf before the solve. integer :: k , i , kn real ( wp ) :: inv_delta , dgdn , un_e , tau_n ! ---- 1. Save U&#94;n; refresh height h = max(stage - b, 0); eta&#94;n = stage !         at circumcentres (stage = h + b already, so eta == stage) ---- do concurrent ( k = 1 : nco ) do i = 1 , EDGES_PER_TRI u_n_edge ( i , k ) = u_edge ( i , k ) end do height ( k ) = max ( stage ( k ) - bed ( k ), 0.0_wp ) eta ( k ) = stage ( k ) end do ! ---- 2. Frozen Hf + per-edge Dirichlet ghost eta ---- call si_unstr_face_depths ( mesh , nct , nco , n_bc , height , bed , bc_type , & bc_eta_ext , Hf_edge , eta_ghost_edge ) ! ---- 2b. Refresh the aggregation-MG operator for this step's frozen Hf !          (host build from the live Hf; structures static).  Once per !          step, NOT per V-cycle. ---- if ( precond == SI_PRECOND_MG . and . present ( mg )) then !$acc update self(Hf_edge) call agglom_hierarchy_unstr_refresh ( mg , mesh , nco , g_theta2_dt2 , & Hf_edge (:, 1 : nco )) end if ! ---- 3. EDGE predictor U*_e (dead edges => 0) + wind ---- ! U&#94;n_e = the saved edge transport; the wind stress projects onto the ! outward edge-normal.  Wall edges (Hf=0) stay exactly 0. do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn , un_e , tau_n ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), eta ( kn ), inv_delta ) else ! Dirichlet edge: gradient against the seeded ghost surface. dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), & eta_ghost_edge ( i , k ), inv_delta ) end if un_e = u_n_edge ( i , k ) ! Wind stress projected onto the outward edge-normal (Pa/rho). tau_n = ( wind_tau_x * mesh % edge_n1 ( i , k ) & + wind_tau_y * mesh % edge_n2 ( i , k )) / RHO_WATER u_star ( i , k ) = un_e - g_omtheta_dt * dgdn + dt * tau_n else u_star ( i , k ) = 0.0_wp u_n_edge ( i , k ) = 0.0_wp ! R3: dead edge carries no U&#94;n flux end if end do end do ! ---- 4. theta-blend RHS (+ Dirichlet ghost fold) ---- call si_unstr_compute_rhs ( mesh , nct , nco , eta , u_star , u_n_edge , eta_r , & dt , theta , Hf_edge , eta_ghost_edge , g_theta2_dt2 ) ! ---- 5. area-weighted CG solve for eta&#94;{n+1} (warm start eta&#94;n) ---- if ( present ( mg )) then call si_unstr_cg_solve ( mesh , nct , nco , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , Hf_edge , g_theta2_dt2 , precond , rtol , & iter_out , mass_res_out , mg = mg ) else call si_unstr_cg_solve ( mesh , nct , nco , eta , eta_r , eta_p , eta_Ap , eta_z , & eta_diag , Hf_edge , g_theta2_dt2 , precond , rtol , & iter_out , mass_res_out ) end if ! ---- 6. EDGE back-substitution with the SAME frozen Hf ---- do concurrent ( k = 1 : nco ) local ( i , kn , inv_delta , dgdn ) do i = 1 , EDGES_PER_TRI if ( Hf_edge ( i , k ) > 0.0_wp ) then inv_delta = 1.0_wp / max ( mesh % edge_delta ( i , k ), DELTA_EPS ) kn = mesh % neighbours ( i , k ) if ( kn > 0 ) then dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), eta ( kn ), inv_delta ) else dgdn = si_unstr_edge_flux ( Hf_edge ( i , k ), eta ( k ), & eta_ghost_edge ( i , k ), inv_delta ) end if u_edge ( i , k ) = u_star ( i , k ) - gtheta_dt * dgdn else u_edge ( i , k ) = 0.0_wp end if end do end do ! ---- 7. Reconstruct A-grid cell momenta + recover h&#94;{n+1} ---- call si_unstr_reconstruct_cell_momenta ( mesh , nct , nco , u_edge , xmom , ymom ) do concurrent ( k = 1 : nco ) stage ( k ) = eta ( k ) height ( k ) = max ( eta ( k ) - bed ( k ), 0.0_wp ) end do end subroutine si_unstr_advance","tags":"","url":"proc/si_unstr_advance.html"},{"title":"si_unstr_advance_wetdry – Rakali","text":"private  subroutine si_unstr_advance_wetdry(state, mesh, nct, nco, n_bc, dt, theta, g_theta2_dt2, gtheta_dt, g_omtheta_dt, iter_out) One Casulli wetting/drying SI step on the triangulation — the\nNewton wrapper around the area-weighted TPFA CG (the structured si_advance_wetdry , edge-wise; V/a/Newton per-cell, prototype-\nconfirmed mesh-agnostic).  The nonlinear system is\n  F(eta) = v(eta) + T*eta - rhs_d = 0,  J = diag(a+floor) + T\nwith T the SAME frozen-Hf stiffness the linear code has (gated-mean\nedge depths — all-wet reduces exactly to the linear edge depth) and\nthe constant mass 1 replaced per cell by the wet fraction a.\nV convex => plain Newton converges monotonically (no line search). The FROZEN-Hf step (rules R1-R5):\n  0. fill b_sub/b_min from bed; save U&#94;n; eta&#94;n = stage;\n  1. freeze Hf by the gated-mean/sill rule (+ Dirichlet ghost);\n  2. edge predictor U (dead edges => exactly 0; U&#94;n zeroed on dead\n     edges — R3 is STRUCTURAL here: the RHS consumes per-edge\n     transports directly, so no reconstruction masking is needed);\n  3. rhs_d = v(eta&#94;n) - dt div[theta U + (1-theta) U&#94;n] (+ ghost);\n  4. Newton: a,v,F at eta&#94;k; converged (frozen active set + small\n     residual)? else CG-solve J dz = -F from zero, eta += dz\n     (dry cells settle below bed — never clamped);\n  5. back-sub with the SAME frozen Hf (R2);\n  6. stage = eta; h = max(eta - b, 0); cell momenta. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nct integer, intent(in) :: nco integer, intent(in) :: n_bc real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: theta real(kind=wp), intent(in) :: g_theta2_dt2 real(kind=wp), intent(in) :: gtheta_dt real(kind=wp), intent(in) :: g_omtheta_dt integer, intent(out) :: iter_out Inner CG iterations summed over the Newton outers. Calls proc~~si_unstr_advance_wetdry~~CallsGraph proc~si_unstr_advance_wetdry si_unstr_advance_wetdry local local proc~si_unstr_advance_wetdry->local proc~si_unstr_apply_helmholtz si_unstr_apply_helmholtz proc~si_unstr_advance_wetdry->proc~si_unstr_apply_helmholtz proc~si_unstr_cg_solve si_unstr_cg_solve proc~si_unstr_advance_wetdry->proc~si_unstr_cg_solve proc~si_unstr_compute_rhs si_unstr_compute_rhs proc~si_unstr_advance_wetdry->proc~si_unstr_compute_rhs proc~si_unstr_edge_flux si_unstr_edge_flux proc~si_unstr_advance_wetdry->proc~si_unstr_edge_flux proc~si_unstr_reconstruct_cell_momenta si_unstr_reconstruct_cell_momenta proc~si_unstr_advance