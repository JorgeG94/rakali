 = ( hu_val ** 2 + hv_val ** 2 ) / h_val ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h_val if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) hu_val = hu_val * fr_scale hv_val = hv_val * fr_scale end if end if ! ---- Write back ---- h ( i , j ) = h_val hu ( i , j ) = hu_val hv ( i , j ) = hv_val end do end subroutine fused_update_stage2","tags":"","url":"proc/fused_update_stage2.html"},{"title":"fused_update_stage_generic – Rakali","text":"public pure subroutine fused_update_stage_generic(h, hu, hv, flux_h, flux_hu, flux_hv, grid, dt, manning_n, wind_x, wind_y, atm_pressure, precipitation, coriolis_f, forcing_active) One forward-Euler stage for the selectable-integrator path:\nEuler update + clamp/desingularization + friction + wind + pressure +\nprecipitation + coriolis, all scaled by the per-stage dt ( beta(i)*dt_step ).  No state save and no RK2 average — the\nstart-of-step backup is taken once by solver_save_state and the\nconvex blend is a separate compute_ssp_combine call.  The body is\nidentical to fused_update_stage1 minus the h0/hu0/hv0 writes so\nevery scheme shares one source-term implementation. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(inout) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_h (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: flux_hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid real(kind=wp), intent(in) :: dt real(kind=wp), intent(in) :: manning_n real(kind=wp), intent(in) :: wind_x (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: wind_y (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: atm_pressure (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: precipitation (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: coriolis_f logical, intent(in) :: forcing_active Calls proc~~fused_update_stage_generic~~CallsGraph proc~fused_update_stage_generic fused_update_stage_generic local local proc~fused_update_stage_generic->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~fused_update_stage_generic~~CalledByGraph proc~fused_update_stage_generic fused_update_stage_generic proc~solver_advance_2d_generic solver_advance_2d_generic proc~solver_advance_2d_generic->proc~fused_update_stage_generic proc~solver_step_impl solver_step_impl proc~solver_step_impl->proc~solver_advance_2d_generic proc~solver_step solver_step proc~solver_step->proc~solver_step_impl proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~solver_step proc~rki_advance rki_advance proc~rki_advance->proc~solver_step proc~rki_step rki_step proc~rki_step->proc~solver_step proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: cf real(kind=wp), private :: cosf real(kind=wp), private :: denom real(kind=wp), private :: dpdx real(kind=wp), private :: dpdy real(kind=wp), private :: dx real(kind=wp), private :: dy real(kind=wp), private :: eps4 real(kind=wp), private :: fr_max_sq real(kind=wp), private :: fr_scale real(kind=wp), private :: h4 real(kind=wp), private :: h_val logical, private :: has_coriolis logical, private :: has_friction real(kind=wp), private :: hu_old real(kind=wp), private :: hu_val real(kind=wp), private :: hv_old real(kind=wp), private :: hv_val integer, private :: i integer, private :: j real(kind=wp), private :: n_sq integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: sinf real(kind=wp), private :: speed real(kind=wp), private :: speed_sq real(kind=wp), private :: u_val real(kind=wp), private :: v_val Source Code pure subroutine fused_update_stage_generic ( h , hu , hv , & flux_h , flux_hu , flux_hv , & grid , dt , & manning_n , wind_x , wind_y , & atm_pressure , precipitation , & coriolis_f , forcing_active ) !! One forward-Euler stage for the selectable-integrator path: !! Euler update + clamp/desingularization + friction + wind + pressure + !! precipitation + coriolis, all scaled by the per-stage `dt` !! (`beta(i)*dt_step`).  No state save and no RK2 average — the !! start-of-step backup is taken once by solver_save_state and the !! convex blend is a separate compute_ssp_combine call.  The body is !! identical to fused_update_stage1 minus the h0/hu0/hv0 writes so !! every scheme shares one source-term implementation. type ( hgrid_t ), intent ( in ) :: grid real ( wp ), intent ( inout ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hu ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: flux_hv ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dt , manning_n real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: atm_pressure ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: precipitation ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: coriolis_f logical , intent ( in ) :: forcing_active integer :: i , j , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: h_val , hu_val , hv_val real ( wp ) :: eps4 , h4 , speed_sq , fr_max_sq , fr_scale real ( wp ) :: u_val , v_val , speed , cf , denom real ( wp ) :: dpdx , dpdy , hu_old , hv_old real ( wp ) :: n_sq , cosf , sinf logical :: has_friction , has_coriolis nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy ! KP07 desingularization length, shared with the CFL timestep ! estimator (see DESING_EPS). eps4 = DESING_EPS ** 4 n_sq = manning_n * manning_n has_friction = ( manning_n > 0.0_wp ) has_coriolis = ( abs ( coriolis_f ) > 1.0e-20_wp ) if ( has_coriolis ) then cosf = cos ( coriolis_f * dt ) sinf = sin ( coriolis_f * dt ) end if do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( h_val , hu_val , hv_val , h4 , speed_sq , fr_max_sq , fr_scale , & u_val , v_val , speed , cf , denom , dpdx , dpdy , hu_old , hv_old ) ! ---- Read state ---- h_val = h ( i , j ) hu_val = hu ( i , j ) hv_val = hv ( i , j ) ! ---- Euler update ---- h_val = h_val + dt * flux_h ( i , j ) hu_val = hu_val + dt * flux_hu ( i , j ) hv_val = hv_val + dt * flux_hv ( i , j ) ! ---- Clamp + thin-cell desingularization (KP07) ---- if ( h_val < 0.0_wp ) then h_val = 0.0_wp hu_val = 0.0_wp hv_val = 0.0_wp else if ( h_val < DRY_TOLERANCE ) then hu_val = 0.0_wp hv_val = 0.0_wp else h4 = h_val ** 4 if ( h4 < eps4 ) then ! u = sqrt(2) h hu / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)); hu := h*u. ! Identity for h >= eps, so applied only below eps. u_val = sqrt ( 2.0_wp ) * h_val * hu_val / sqrt ( h4 + eps4 ) v_val = sqrt ( 2.0_wp ) * h_val * hv_val / sqrt ( h4 + eps4 ) hu_val = h_val * u_val hv_val = h_val * v_val end if ! Froude backstop: blowup arrester only (triggers on a TRUE ! comparison, so NaN passes through and fails loudly). speed_sq = ( hu_val ** 2 + hv_val ** 2 ) / h_val ** 2 fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h_val if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) hu_val = hu_val * fr_scale hv_val = hv_val * fr_scale end if end if ! ---- Friction + forcing ---- if ( h_val > DRY_TOLERANCE ) then if ( has_friction ) then u_val = hu_val / h_val v_val = hv_val / h_val speed = sqrt ( u_val * u_val + v_val * v_val ) cf = GRAVITY * n_sq / ( h_val ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed / h_val hu_val = hu_val / denom hv_val = hv_val / denom end if if ( forcing_active ) then hu_val = hu_val + dt * wind_x ( i , j ) / RHO_WATER hv_val = hv_val + dt * wind_y ( i , j ) / RHO_WATER dpdx = ( atm_pressure ( i + 1 , j ) - atm_pressure ( i - 1 , j )) / ( 2.0_wp * dx ) dpdy = ( atm_pressure ( i , j + 1 ) - atm_pressure ( i , j - 1 )) / ( 2.0_wp * dy ) hu_val = hu_val - dt * h_val * dpdx / RHO_WATER hv_val = hv_val - dt * h_val * dpdy / RHO_WATER end if ! ---- Coriolis ---- if ( has_coriolis ) then hu_old = hu_val hv_old = hv_val hu_val = hu_old * cosf + hv_old * sinf hv_val = - hu_old * sinf + hv_old * cosf end if end if ! ---- Precipitation (all cells) ---- if ( forcing_active ) then h_val = h_val + dt * precipitation ( i , j ) end if ! ---- Write back ---- h ( i , j ) = h_val hu ( i , j ) = hu_val hv ( i , j ) = hv_val end do end subroutine fused_update_stage_generic","tags":"","url":"proc/fused_update_stage_generic.html"},{"title":"unstr_multilayer_destroy – Rakali","text":"private  subroutine unstr_multilayer_destroy(this) Type Bound unstr_multilayer_state_t Arguments Type Intent Optional Attributes Name class( unstr_multilayer_state_t ), intent(inout) :: this Calls proc~~unstr_multilayer_destroy~~CallsGraph proc~unstr_multilayer_destroy unstr_multilayer_state_t%unstr_multilayer_destroy proc~unstr_tracer_destroy unstr_tracer_t%unstr_tracer_destroy proc~unstr_multilayer_destroy->proc~unstr_tracer_destroy proc~vcoord_cleanup vcoord_t%vcoord_cleanup proc~unstr_multilayer_destroy->proc~vcoord_cleanup Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it Source Code subroutine unstr_multilayer_destroy ( this ) class ( unstr_multilayer_state_t ), intent ( inout ) :: this integer :: it call this % vcoord % cleanup () if ( allocated ( this % vcoord_z_ref )) deallocate ( this % vcoord_z_ref ) if ( allocated ( this % vcoord_z_ref_col )) deallocate ( this % vcoord_z_ref_col ) if ( allocated ( this % dsig_ml )) deallocate ( this % dsig_ml ) if ( allocated ( this % h_layer )) deallocate ( this % h_layer ) if ( allocated ( this % hu_layer )) deallocate ( this % hu_layer ) if ( allocated ( this % hv_layer )) deallocate ( this % hv_layer ) if ( allocated ( this % h_layer0 )) deallocate ( this % h_layer0 ) if ( allocated ( this % hu_layer0 )) deallocate ( this % hu_layer0 ) if ( allocated ( this % hv_layer0 )) deallocate ( this % hv_layer0 ) if ( allocated ( this % rho_layer )) deallocate ( this % rho_layer ) if ( allocated ( this % w_interface )) deallocate ( this % w_interface ) if ( allocated ( this % kpp_bl_depth )) deallocate ( this % kpp_bl_depth ) if ( allocated ( this % kpp_u_star )) deallocate ( this % kpp_u_star ) if ( allocated ( this % kpp_buoy_flux )) deallocate ( this % kpp_buoy_flux ) if ( allocated ( this % keps_tke )) deallocate ( this % keps_tke ) if ( allocated ( this % keps_eps )) deallocate ( this % keps_eps ) if ( allocated ( this % keps_nut )) deallocate ( this % keps_nut ) if ( allocated ( this % keps_kt )) deallocate ( this % keps_kt ) if ( allocated ( this % keps_ustar_s )) deallocate ( this % keps_ustar_s ) if ( allocated ( this % keps_ustar_b )) deallocate ( this % keps_ustar_b ) if ( allocated ( this % keps_tke0 )) deallocate ( this % keps_tke0 ) if ( allocated ( this % keps_eps0 )) deallocate ( this % keps_eps0 ) if ( allocated ( this % rho_ref )) deallocate ( this % rho_ref ) if ( allocated ( this % tracer_advect_scratch )) deallocate ( this % tracer_advect_scratch ) if ( allocated ( this % ml_lgrad_x )) deallocate ( this % ml_lgrad_x ) if ( allocated ( this % ml_lgrad_y )) deallocate ( this % ml_lgrad_y ) if ( allocated ( this % ml_hdiff_hTr_pre )) deallocate ( this % ml_hdiff_hTr_pre ) if ( allocated ( this % ml_horvisc_hu_pre )) deallocate ( this % ml_horvisc_hu_pre ) if ( allocated ( this % ml_horvisc_hv_pre )) deallocate ( this % ml_horvisc_hv_pre ) if ( allocated ( this % xmom_pre )) deallocate ( this % xmom_pre ) if ( allocated ( this % ymom_pre )) deallocate ( this % ymom_pre ) if ( allocated ( this % remap_dz_old )) deallocate ( this % remap_dz_old ) this