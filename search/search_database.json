generic ( state , mesh , dt ) !! Generic N-stage explicit SSP advance for the 2D barotropic !! unstructured path (euler/rk3/rk43).  Loops the same KNP !! forward-Euler stage primitive used by the fused RK2 fast path: !! !!     E      = U&#94;(i-1) + beta(i)*dt * L(U&#94;(i-1))   (fused stage) !!     U&#94;(i)  = alpha(i)*U&#94;n + (1 - alpha(i))*E      (convex blend) !! !! U&#94;n is backed up once; the blend is a per-stage ssp_combine_unstr. !! Both keep the protect (wet/dry positivity) so the SSP guarantee !! carries through.  `dt` already carries any ssp_coeff scaling. type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( inout ) :: mesh real ( wp ), intent ( in ) :: dt type ( timestepper_t ) :: ts integer :: stage real ( wp ) :: dt_stage ts = make_timestepper ( state % time_scheme ) ! Back up U&#94;n once; every stage blends against this start-of-step state. call fused_save_state_unstr ( state , mesh ) do stage = 1 , ts % n_stages dt_stage = ts % beta ( stage ) * dt call extrapolate_second_order_edge_unstr ( state , mesh ) call compute_fluxes_central_unstr ( state , mesh ) call fused_update_stage_generic_unstr ( state , mesh , dt_stage ) ! Convex blend with U&#94;n (skip when alpha == 0: the stage iterate ! IS the new running state, e.g. euler and the first rk43 stages). if ( ts % alpha ( stage ) /= 0.0_wp ) then call ssp_combine_unstr ( state , mesh , ts % alpha ( stage )) end if end do end subroutine solver_unstr_step_generic","tags":"","url":"proc/solver_unstr_step_generic.html"},{"title":"solver_unstr_step_semi_implicit – Rakali","text":"private  subroutine solver_unstr_step_semi_implicit(state, mesh, dt) One semi-implicit (Casulli) free-surface step on the triangulation.\nHands the conserved variables to si_unstr_step , which owns the frozen-Hf predictor ->\nTPFA Helmholtz eta-solve -> edge back-substitution -> A-grid cell\nmomentum reconstruction, plus the time/step bookkeeping.  Open-edge\nDirichlet coupling (tidal / clamped) is read inside the step from state%bc_type / state%bc_eta_ext (the coefficient-space route);\nwall edges get Hf=0 (no-flux Neumann).  The caller sets bc_eta_ext to the prescribed surface (tests evaluate the tide at the\ntheta-weighted time).  The step ends with barotropic stage_cv /\nxmom_cv / ymom_cv / height_cv valid — downstream unchanged. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(inout) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~solver_unstr_step_semi_implicit~~CallsGraph proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~si_unstr_step si_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~si_unstr_step_ml si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~si_unstr_advance si_unstr_advance proc~si_unstr_step->proc~si_unstr_advance proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~ml_apply_coriolis_unstr ml_apply_coriolis_unstr proc~si_unstr_step_ml->proc~ml_apply_coriolis_unstr proc~ml_apply_surface_tracer_fluxes_unstr ml_apply_surface_tracer_fluxes_unstr proc~si_unstr_step_ml->proc~ml_apply_surface_tracer_fluxes_unstr proc~ml_baroclinic_pressure_gradient_jacobian_unstr ml_baroclinic_pressure_gradient_jacobian_unstr proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_jacobian_unstr proc~ml_baroclinic_pressure_gradient_unstr ml_baroclinic_pressure_gradient_unstr proc~si_unstr_step_ml->proc~ml_baroclinic_pressure_gradient_unstr proc~ml_clamp_tracer_unstr ml_clamp_tracer_unstr proc~si_unstr_step_ml->proc~ml_clamp_tracer_unstr proc~ml_compute_barotropic_momentum_unstr ml_compute_barotropic_momentum_unstr proc~si_unstr_step_ml->proc~ml_compute_barotropic_momentum_unstr proc~ml_equation_of_state_unstr ml_equation_of_state_unstr proc~si_unstr_step_ml->proc~ml_equation_of_state_unstr proc~ml_horizontal_viscosity_smag_unstr ml_horizontal_viscosity