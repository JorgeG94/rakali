id = -1 x-momentum variable ID integer, public :: ymom_varid = -1 y-momentum variable ID Subroutines public  subroutine output_unstr_close (ostate) Close the output file. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(inout) :: ostate public  subroutine output_unstr_init (ostate, filename, state, mesh, deflate_level) Create a CF UGRID 1.0 NetCDF file from mesh + state objects. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(out) :: ostate character(len=*), intent(in) :: filename type( unstr_state_t ), intent(in) :: state type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in), optional :: deflate_level public  subroutine output_unstr_init_from_arrays (ostate, filename, nverts, ncells, vert_x, vert_y, tri_v, centroid_x, centroid_y, area, bed, cell_global_id, deflate_level) Create a CF UGRID 1.0 NetCDF file from raw arrays.\nFor callers that hold raw topology arrays instead of a mesh. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(out) :: ostate character(len=*), intent(in) :: filename integer, intent(in) :: nverts integer, intent(in) :: ncells real(kind=wp), intent(in) :: vert_x (nverts) real(kind=wp), intent(in) :: vert_y (nverts) integer, intent(in) :: tri_v (3,ncells) real(kind=wp), intent(in) :: centroid_x (ncells) real(kind=wp), intent(in) :: centroid_y (ncells) real(kind=wp), intent(in) :: area (ncells) real(kind=wp), intent(in) :: bed (ncells) integer(kind=8), intent(in), optional :: cell_global_id (ncells) integer, intent(in), optional :: deflate_level public  subroutine output_unstr_write_snapshot (ostate, state, time) Append a snapshot from state object. Caller must ensure host sync. Arguments Type Intent Optional Attributes Name type( output_unstr_state_t ), intent(inout) :: ostate type( unstr_state_t ), intent(in) :: state real(kind=wp), intent(in) :: time public  subroutine output_unstr_write_snapshot_from_arrays (ostate, stage, xmom, ymom, 