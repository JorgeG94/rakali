x ( - b ( i , j ), 0.0_wp ), & h_surf_target , & n_surf , stretching , & vcoord_z_ref_col (:, i , j )) end do end do !$acc update device(vcoord_z_ref_col) if_present end subroutine ml_build_vcoord_zstar_full","tags":"","url":"proc/ml_build_vcoord_zstar_full.html"},{"title":"ml_compute_barotropic_momentum – Rakali","text":"public pure subroutine ml_compute_barotropic_momentum(h_layer, hu_layer, hv_layer, hu, hv, grid, nz) Compute depth-integrated momentum: hu = sum_k hu_k, hv = sum_k hv_k Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~ml_compute_barotropic_momentum~~CallsGraph proc~ml_compute_barotropic_momentum ml_compute_barotropic_momentum local local proc~ml_compute_barotropic_momentum->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_compute_barotropic_momentum~~CalledByGraph proc~ml_compute_barotropic_momentum ml_compute_barotropic_momentum proc~solver_multilayer_rk_stage solver_multilayer_rk_stage proc~solver