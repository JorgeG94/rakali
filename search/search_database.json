g = recon_rung_for_face ( avail_up , avail_down , rung_max_int ) select case ( rung ) case ( 4 ) tr_face_val = weno9_face_swept ( & tr_snap ( i , j + 5 , k ), tr_snap ( i , j + 4 , k ), & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j - 2 , k ), tr_snap ( i , j - 3 , k ), sigma ) case ( 3 ) tr_face_val = weno7_face_swept ( & tr_snap ( i , j + 4 , k ), tr_snap ( i , j + 3 , k ), & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), & tr_snap ( i , j - 2 , k ), sigma ) case ( 2 ) tr_face_val = weno5_face_swept ( & tr_snap ( i , j + 3 , k ), tr_snap ( i , j + 2 , k ), & tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), tr_snap ( i , j - 1 , k ), sigma ) case ( 1 ) tr_face_val = plm_face_swept ( & tr_snap ( i , j + 2 , k ), tr_snap ( i , j + 1 , k ), & tr_snap ( i , j , k ), sigma ) case default tr_face_val = tr_snap ( i , j + 1 , k ) ! donor end select flux_top = f_layer * tr_face_val else flux_top = 0.0_wp end if ! Conservative update hTr_layer ( i , j , k ) = hTr_layer ( i , j , k ) & - dt * (( flux_right - flux_left ) * inv_dx & + ( flux_top - flux_bot ) * inv_dy ) end do ! k loop end if ! h_col > ML_MIN_DEPTH end do ! do concurrent(j, i) end associate end subroutine ml_advect_tracer_weno end module rki_recon_weno","tags":"","url":"sourcefile/rki_recon_weno.f90.html"},{"title":"rki_kernel_protect_unstr.F90 – Rakali","text":"Protect against negative depths in the unstructured solver This file depends on sourcefile~~rki_kernel_protect_unstr.f90~~EfferentGraph sourcefile~rki_kernel_protect_unstr.f90 rki_kernel_protect_unstr.F90 sourcefile~rki_constants.f90 rki_constants.F90 sourcefile~rki_kernel_protect_unstr.f90->sourcefile~rki_constants.f90 sourcefile~rki_mesh_unstr.f90 rki_mesh_unstr.F90 sourcefile~rki_kernel_protect_unstr.f90->sourcefile~rki_mesh_unstr.f90 sourcefile~rki_state_unstr.f90 rki_state_unstr.F90