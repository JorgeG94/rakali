ivate :: h_col integer, private :: m real(kind=wp), private :: mann integer, private :: n integer, private :: nz real(kind=wp), private :: rho_0 real(kind=wp), private :: speed_b real(kind=wp), private :: tau_x real(kind=wp), private :: tau_y real(kind=wp), private :: u_b real(kind=wp), private :: us_s real(kind=wp), private :: v_b Source Code pure subroutine ml_keps_friction_velocities_unstr ( state ) !! Per-cell surface + bed friction velocities feeding the keps wall !! functions.  Surface: u_*s = sqrt(|tau_wind|/rho_0) from the (uniform) !! unstructured wind stress.  Bed: quadratic Manning u_*b = sqrt(C_d)*|u_b|, !! C_d = g n&#94;2 / H&#94;(1/3), from the bottom (k=1) layer speed.  Writes !! keps_ustar_s/b on the multilayer state. type ( unstr_state_t ), intent ( inout ) :: state integer :: cell , m , nz , n real ( wp ) :: tau_x , tau_y , rho_0 , mann , us_s , h_col , h_b , u_b , v_b , speed_b , cf if (. not . state % use_multilayer ) return if (. not . allocated ( state % multilayer % keps_ustar_s )) return nz = state % multilayer % nz_ml n = state % ncells_owned tau_x = state % barotropic % wind_tau_x tau_y = state % barotropic % wind_tau_y rho_0 = state % multilayer % rho_0 mann = state % barotropic % manning_n us_s = sqrt ( sqrt ( tau_x * tau_x + tau_y * tau_y ) / rho_0 ) ! uniform wind -> per-cell constant do concurrent ( cell = 1 : n ) local ( m , h_col , h_b , u_b , v_b , speed_b , cf ) state % multilayer % keps_ustar_s ( cell ) = us_s h_col = 0.0_wp do m = 1 , nz h_col = h_col + state % multilayer % h_layer ( m , cell ) end do h_b = state % multilayer % h_layer ( 1 , cell ) if ( h_b > DRY_TOLERANCE . and . h_col > ML_MIN_DEPTH_UNSTR ) then u_b = state % multilayer % hu_layer ( 1 , cell ) / h_b v_b = state % multilayer % hv_layer ( 1 , cell ) / h_b speed_b = sqrt ( u_b * u_b + v_b * v_b ) cf = GRAVITY * mann * mann / ( h_col ** ( 1.0_wp / 3.0_wp )) state % multilayer % keps_ustar_b ( cell ) = sqrt ( cf ) * speed_b else state % multilayer % keps_ustar_b ( cell ) = 0.0_wp end if end do end subroutine ml_keps_friction_velocities_unstr","tags":"","url":"proc/ml_keps_friction_velocities_unstr.html"},{"title":"ml_keps_update_unstr – Rakali","text":"public  subroutine ml_keps_update_unstr(state, dt, use_walls) State-passed shim: advance k/eps one step per cell and recover\nnu_t/kappa_t. use_walls imposes the Dirichlet log-law wall functions\n(from keps_ustar_s/b); .false. uses the zero-gradient closure (the\nstandalone unit tests).  Extracts the flat arrays and calls the impl. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state real(kind=wp), intent(in) :: dt logical, intent(in) :: use_walls Calls proc~~ml_keps_update_unstr~~CallsGraph proc~ml_keps_update_unstr ml_keps_update_unstr proc~ml_keps_update_unstr_impl ml_keps_update_unstr_impl proc~ml_keps_update_unstr->proc~ml_keps_update_unstr_impl local local proc~ml_keps_update_unstr_impl->local proc~keps_stability_funcs keps_stability_funcs proc~ml_keps_update_unstr_impl->proc~keps_stability_funcs proc~keps_tridiag_solve_u keps_tridiag_solve_u proc~ml_keps_update_unstr_impl->proc~keps_tridiag_solve_u Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~ml_keps_update_unstr~~CalledByGraph proc~ml_keps_update_unstr ml_keps_update_unstr proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~