proc~rki_create_from_namelist_string->proc~rki_create_from_string proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine state_init_from_config ( this , cfg ) !! Allocate arrays from config class ( state_t ), intent ( inout ) :: this type ( config_t ), intent ( in ) :: cfg !! Configuration parameters ! Set multilayer parameters from config (read by multilayer%init below) this % use_multilayer = cfg % use_multilayer if ( cfg % use_multilayer ) then this % multilayer % nz_ml = cfg % nz_layers ! Vcoord parameters so multilayer%init picks them up this % multilayer % vcoord % coord_type = parse_vcoord_type ( cfg % vcoord_type ) this % multilayer % vcoord % remap_method = parse_remap_method ( cfg % remap_method ) this % multilayer % vcoord % depth_transition = cfg % vcoord_depth_transition this % multilayer % vcoord % blend_width = cfg % vcoord_blend_width this % multilayer % vcoord % zstar_h_surf_target = cfg % zstar_h_surf_target this % multilayer % vcoord % zstar_h_min = cfg % zstar_h_min this % multilayer % vcoord % zstar_stretching = parse_stretching_mode ( cfg % zstar_stretching ) this % multilayer % vcoord % zstar_n_surf = cfg % zstar_n_surf this % multilayer % initial_salinity = cfg % initial_salinity this % multilayer % S_init_surface = cfg % S_init_surface this % multilayer % S_init_bottom = cfg % S_init_bottom this % multilayer % S_ref = cfg % S_ref this % multilayer % beta_S = cfg % beta_S this % multilayer % S_min = cfg % S_min this % multilayer % S_max = cfg % S_max this % multilayer % kappa_S_bg = cfg % kappa_S_bg this % multilayer % initial_temperature = cfg % initial_temperature this % multilayer % T_init_surface = cfg % T_init_surface this % multilayer % T_init_bottom = cfg % T_init_bottom this % multilayer % T_ref = cfg % T_ref this % multilayer % alpha_T = cfg % alpha_T this % multilayer % T_min = cfg % T_min this % multilayer % T_max = cfg % T_max this % multilayer % kappa_T_bg = cfg % kappa_T_bg this % multilayer % rho_0 = cfg % rho_0 ! Coastal EOS selector (&tracer_nml eos_form): default \"linear\" ! keeps the legacy kernel (eos_use_shared = .false.); \"wright\" / ! \"roquet_spv\" opt in to the shared nonlinear EOS.  The handle ! is a flat POD read on the host at dispatch — no device map. block use rki_ml_eos , only : ml_parse_eos_form call ml_parse_eos_form ( cfg % eos_form , & this % multilayer % eos_use_shared , & this % multilayer % eos % variant ) end block this % multilayer % eos % rho0 = cfg % rho_0 this % multilayer % eos % S_ref = cfg % S_ref this % multilayer % eos % T_ref = cfg % T_ref this % multilayer % eos % alpha_T = cfg % alpha_T this % multilayer % eos % beta_S = cfg % beta_S this % multilayer % eos % is_init = . true . this % multilayer % vmix_nu_max = cfg % vmix_nu_max this % multilayer % vmix_nu_bg = cfg % vmix_nu_bg this % multilayer % vmix_ri_alpha = cfg % vmix_ri_alpha this % multilayer % vmix_use_kpp = cfg % vmix_use_kpp this % multilayer % vmix_use_keps = cfg % vmix_use_keps this % multilayer % kpp_ri_crit = cfg % kpp_ri_crit this % multilayer % kpp_cs_nonlocal = cfg % kpp_cs_nonlocal this % multilayer % kpp_c_vt2 = cfg % kpp_c_vt2 this % multilayer % hdiff_kappa = cfg % hdiff_kappa this % multilayer % smagorinsky_cs = cfg % smagorinsky_cs this % multilayer % biharmonic_nu4 = cfg % biharmonic_nu4 this % multilayer % evap_mass_sink = cfg % evap_mass_sink this % multilayer % evap_latent_cooling = cfg % evap_latent_cooling this % multilayer % use_bpg_jacobian = ( trim ( cfg % bpg_method ) == \"jacobian\" ) this % multilayer % keps_stability = KEPS_STAB_CONSTANT if ( trim ( cfg % keps_stability ) == \"galperin\" ) then this % multilayer % keps_stability = KEPS_STAB_GALPERIN else if ( trim ( cfg % keps_stability ) == \"canuto\" ) then this % multilayer % keps_stability = KEPS_STAB_CANUTO end if this % multilayer % use_ppm_tracer = cfg % use_ppm_tracer block use rki_recon_weno , only : parse_tracer_recon this % multilayer % tracer_recon_code = parse_tracer_recon ( trim ( cfg % tracer_recon )) end block ! Sediment (set before this%init so bed_sediment allocates). this % multilayer % use_sediment = cfg % use_sediment this % multilayer % sediment_w_s = cfg % sediment_w_s this % multilayer % sediment_initial_conc = cfg % sediment_initial_conc this % multilayer % sediment_bed_init = cfg % sediment_bed_init this % multilayer % sediment_tau_crit_erosion = cfg % sediment_tau_crit_erosion this % multilayer % sediment_erosion_rate = cfg % sediment_erosion_rate this % multilayer % sediment_porosity = cfg % sediment_porosity end if ! Parse the time-scheme tag up front.  Semi-implicit is unstructured-only; ! a direct-API caller who sets only the string must fail loud here. this % time_scheme = parse_time_scheme ( cfg % time_scheme ) if ( this % time_scheme == TIME_SEMI_IMPLICIT ) then error stop \"time_scheme='semi_implicit' is only supported on \" // & \"unstructured grids\" end if ! Set NH and mode-splitting parameters from config (read by ! nh%init below) this % use_nonhydrostatic = cfg % use_nonhydrostatic this % nh % nz = cfg % nz_layers this % nh % nh_tolerance = cfg % nh_tolerance this % nh % nh_max_iterations = cfg % nh_max_iterations this % nh % nh_preconditioner = cfg % nh_preconditioner this % nh % nh_solve_interval = cfg % nh_solve_interval this % nh % split_ratio = cfg % split_ratio this % nh % split_averaging = cfg % split_averaging ! Delegate to main init (allocates arrays) call this % init ( cfg % nx , cfg % ny , cfg % nghost , cfg % dx , cfg % dy , cfg % cfl ) ! Set physics parameters from config this % barotropic % manning_n = cfg % manning_n this % barotropic % use_linear_bottom_drag = cfg % use_linear_bottom_drag this % barotropic % bottom_drag_r = cfg % bottom_drag_r this % barotropic % wind_surface_layer = cfg % wind_surface_layer this % forcing % wind_stress_x = cfg % wind_stress_x this % forcing % wind_stress_y = cfg % wind_stress_y this % barotropic % coriolis_f = cfg % coriolis_f this % barotropic % use_hllc = cfg % use_hllc this % dt_fixed = cfg % dt_fixed this % cfl_interval = cfg % cfl_interval ! The selectable explicit integrator (euler/rk3/rk43) is wired into ! the 2D barotropic fast path only.  Multilayer + non-hydrostatic ! keep their hard-wired SSP-RK2 (mode-split / pressure stages sit ! between the Euler update and the combine, so they can't share the ! generic N-stage loop yet).  Fail loud rather than silently ignore. ! The selectable explicit integrators (euler/rk3/rk43) are wired into ! the 2D barotropic fast path only.  NH is excluded on all non-rk2 ! schemes. if ( this % time_scheme /= TIME_RK2 . and . this % use_nonhydrostatic ) then error stop \"time_scheme: euler/rk3/rk43 are incompatible \" // & \"with use_nonhydrostatic=.true.; non-hydrostatic runs use rk2.\" end if if ( this % time_scheme /= TIME_RK2 . and . this % use_multilayer ) then error stop \"time_scheme: euler/rk3/rk43 require the 2D barotropic path \" // & \"(use_multilayer=.false.); multilayer runs use rk2.\" end if ! Fill spatially-varying forcing arrays from uniform config values this % forcing % wind_x (:, :) = cfg % wind_stress_x this % forcing % wind_y (:, :) = cfg % wind_stress_y ! Register the prognostic salinity + temperature tracers in the ! generic registry, accessed via tracers(idx_salinity/idx_temperature)%hTr. if ( cfg % use_multilayer ) then call register_default_tracers ( & this % multilayer % tracers ( this % multilayer % idx_salinity ), & this % multilayer % tracers ( this % multilayer % idx_temperature ), & cfg ) ! Register the suspended-sediment tracer (single class) when enabled. ! Horizontal transport / diffusion / clamp ride the registry; settling ! + bed exchange are separate kernels.  eos_coeff = 0 (no density ! feedback); concentration in kg/m&#94;3, clamped >= 0 (no upper bound). if ( cfg % use_sediment ) then call this % multilayer % register_passive_tracer ( this % grid , \"sediment\" , & cfg % sediment_initial_conc , & 0.0_wp , huge ( 1.0_wp ), & cfg % kappa_S_bg , cfg % hdiff_kappa ) this % multilayer % idx_sediment = size ( this % multilayer % tracers ) associate ( tr_sed => this % multilayer % tracers ( this % multilayer % idx_sediment )) tr_sed % long_name = \"Suspended sediment concentration\" tr_sed % units = \"kg m-3\" tr_sed % standard_name = \"mass_concentration_of_suspended_matter_in_sea_water\" end associate end if end if end subroutine state_init_from_config","tags":"","url":"proc/state_init_from_config.html"},{"title":"scratch_3d_buffer_bytes – Rakali","text":"private pure function scratch_3d_buffer_bytes(this) result(nbytes) Counted allocatable footprint of the 3D scratch buffer slot (0 when\nunallocated). Type Bound scratch_3d_buffer_t Arguments Type Intent Optional Attributes Name class( scratch_3d_buffer_t ), intent(in) :: this Return Value integer(kind=int64) Calls proc~~scratch_3d_buffer_bytes~~CallsGraph proc~scratch_3d_buffer_bytes scratch_3d_buffer_t%scratch_3d_buffer_bytes interface~arr_bytes arr_bytes proc~scratch_3d_buffer_bytes->interface~arr_bytes proc~arr_bytes_i1 arr_bytes_i1 interface~arr_bytes->proc~arr_bytes_i1 proc~arr_bytes_i2 arr_bytes_i2 interface~arr_bytes->proc~arr_bytes_i2 proc~arr_bytes_i3 arr_bytes_i3 interface~arr_bytes->proc~arr_bytes_i3 proc~arr_bytes_l1 arr_bytes_l1 interface~arr_bytes->proc~arr_bytes_l1 proc~arr_bytes_l2 arr_bytes_l2 interface~arr_bytes->proc~arr_bytes_l2 proc~arr_bytes_l3 arr_bytes_l3 interface~arr_bytes->proc~arr_bytes_l3 proc~arr_bytes_r1 arr_bytes_r1 interface~arr_bytes->proc~arr_bytes_r1 proc~arr_bytes_r2 arr_bytes_r2 interface~arr_bytes->proc~arr_bytes_r2 proc~arr_bytes_r3 arr_bytes_r3 interface~arr_bytes->proc~arr_bytes_r3 proc~arr_bytes_r4 arr_bytes_r4 interface~arr_bytes->proc~arr_bytes_r4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function scratch_3d_buffer_bytes ( this ) result ( nbytes ) !! Counted allocatable footprint of the 3D scratch buffer slot (0 when !! unallocated). class ( scratch_3d_buffer_t ), intent ( in ) :: this integer ( int64 ) :: nbytes nbytes = arr_bytes ( this % data ) end function scratch_3d_buffer_bytes","tags":"","url":"proc/scratch_3d_buffer_bytes.html"},{"title":"scratch_3d_buffer_enter_data_impl – Rakali","text":"public  subroutine scratch_3d_buffer_enter_data_impl(this) Attach the scratch payload to the device. type(...) (not class ) dummy on purpose: a by-reference non-polymorphic dummy\naliases the heap object, so create(this%data) attaches against\na heap base — no polymorphic stack box for AMD to reject. No-op when the payload was never allocated.  Slots may GATE a\nbuffer’s init on a runtime knob (see ocean_pressure_force_t%scratch_gated ) and still call this\nunconditionally from their enter_data walk; mapping an\nunallocated allocatable is not defined behaviour, so the guard\nlives here rather than at each call site. Arguments Type Intent Optional Attributes Name type( scratch_3d_buffer_t ), intent(inout) :: this Called by proc~~scratch_3d_buffer_enter_data_impl~~CalledByGraph proc~scratch_3d_buffer_enter_data_impl scratch_3d_buffer_enter_data_impl proc~scratch_3d_buffer_enter_data scratch_3d_buffer_t%scratch_3d_buffer_enter_data proc~scratch_3d_buffer_enter_data->proc~scratch_3d_buffer_enter_data_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine scratch_3d_buffer_enter_data_impl ( this ) !! Attach the scratch payload to the device.  `type(...)` (not !! `class`) dummy on purpose: a by-reference non-polymorphic dummy !! aliases the heap object, so `create(this%data)` attaches against !! a heap base — no polymorphic stack box for AMD to reject. !! !! No-op when the payload was never allocated.  Slots may GATE a !! buffer's `init` on a runtime knob (see !! `ocean_pressure_force_t%scratch_gated`) and still call this !! unconditionally from their `enter_data` walk; mapping an !! unallocated allocatable is not defined behaviour, so the guard !! lives here rather than at each call site. type ( scratch_3d_buffer_t ), intent ( inout ) :: this if (. not . allocated ( this % data )) return !$acc enter data create(this%data) end subroutine scratch_3d_buffer_enter_data_impl","tags":"","url":"proc/scratch_3d_buffer_enter_data_impl.html"},{"title":"scratch_3d_buffer_exit_data_impl – Rakali","text":"public  subroutine scratch_3d_buffer_exit_data_impl(this) Release the scratch payload from the device.  No copyout — scratch contents are per-step intermediates with no\nhost-side meaning.  No-op when never allocated (mirrors scratch_3d_buffer_enter_data_impl ’s gate). Arguments Type Intent Optional Attributes Name type( scratch_3d_buffer_t ), intent(inout) :: this Called by proc~~scratch_3d_buffer_exit_data_impl~~CalledByGraph proc~scratch_3d_buffer_exit_data_impl scratch_3d_buffer_exit_data_impl proc~scratch_3d_buffer_exit_data scratch_3d_buffer_t%scratch_3d_buffer_exit_data proc~scratch_3d_buffer_exit_data->proc~scratch_3d_buffer_exit_data_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine scratch_3d_buffer_exit_data_impl ( this ) !! Release the scratch payload from the device.  No `copyout` !! — scratch contents are per-step intermediates with no !! host-side meaning.  No-op when never allocated (mirrors !! `scratch_3d_buffer_enter_data_impl`'s gate). type ( scratch_3d_buffer_t ), intent ( inout ) :: this if (. not . allocated ( this % data )) return !$acc exit data delete(this%data) end subroutine scratch_3d_buffer_exit_data_impl","tags":"","url":"proc/scratch_3d_buffer_exit_data_impl.html"},{"title":"scratch_3d_buffer_destroy – Rakali","text":"private  subroutine scratch_3d_buffer_destroy(this) Type Bound scratch_3d_buffer_t Arguments Type Intent Optional Attributes Name class( scratch_3d_buffer_t ), intent(inout) :: this Source Code subroutine scratch_3d_buffer_destroy ( this ) class ( scratch_3d_buffer_t ), intent ( inout ) :: this this % is_init = . false . if ( allocated ( this % data )) deallocate ( this % data ) this % n1 = 0 this % n2 = 0 this % n3 = 0 this % name = \"\" end subroutine scratch_3d_buffer_destroy","tags":"","url":"proc/scratch_3d_buffer_destroy.html"},{"title":"scratch_3d_buffer_enter_data – Rakali","text":"private  subroutine scratch_3d_buffer_enter_data(this) Type-bound wrapper — keeps buf%enter_data() call sites working.\nDelegates to the non-polymorphic impl so the OpenMP map base is\nthe heap object (see the impl + the public-decl comment above). Type Bound scratch_3d_buffer_t Arguments Type Intent Optional Attributes Name class( scratch_3d_buffer_t ), intent(inout) :: this Calls proc~~scratch_3d_buffer_enter_data~~CallsGraph proc~scratch_3d_buffer_enter_data scratch_3d_buffer_t%scratch_3d_buffer_enter_data proc~scratch_3d_buffer_enter_data_impl scratch_3d_buffer_enter_data_impl proc~scratch_3d_buffer_enter_data->proc~scratch_3d_buffer_enter_data_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine scratch_3d_buffer_enter_data ( this ) !! Type-bound wrapper — keeps `buf%enter_data()` call sites working. !! Delegates to the non-polymorphic impl so the OpenMP map base is !! the heap object (see the impl + the public-decl comment above). class ( scratch_3d_buffer_t ), intent ( inout ) :: this select type ( this ) type is ( scratch_3d_buffer_t ) call scratch_3d_buffer_enter_data_impl ( this ) end select end subroutine scratch_3d_buffer_enter_data","tags":"","url":"proc/scratch_3d_buffer_enter_data.html"},{"title":"scratch_3d_buffer_exit_data – Rakali","text":"private  subroutine scratch_3d_buffer_exit_data(this) Type-bound wrapper — see scratch_3d_buffer_enter_data. Type Bound scratch_3d_buffer_t Arguments Type Intent Optional Attributes Name class( scratch_3d_buffer_t ), intent(inout) :: this Calls proc~~scratch_3d_buffer_exit_data~~CallsGraph proc~scratch_3d_buffer_exit_data scratch_3d_buffer_t%scratch_3d_buffer_exit_data proc~scratch_3d_buffer_exit_data_impl scratch_3d_buffer_exit_data_impl proc~scratch_3d_buffer_exit_data->proc~scratch_3d_buffer_exit_data_impl Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code subroutine scratch_3d_buffer_exit_data ( this ) !! Type-bound wrapper — see scratch_3d_buffer_enter_data