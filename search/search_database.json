 private :: u_val real(kind=wp), private :: v_val real(kind=wp), private :: xmom real(kind=wp), private :: ymom Source Code subroutine fused_update_stage2_unstr ( state , mesh , dt ) !! Stage 2: Euler update + friction/wind + protect + RK2 average + protect type ( unstr_state_t ), intent ( inout ) :: state type ( mesh_unstr_t ), intent ( in ) :: mesh real ( wp ), intent ( in ) :: dt integer :: k , n real ( wp ) :: stage , xmom , ymom , h , eps4 , h4 real ( wp ) :: speed_sq , fr_max_sq , fr_scale real ( wp ) :: u_val , v_val , speed , cf , denom real ( wp ) :: n_sq , min_h , tau_x , tau_y real ( wp ) :: mass_error_local logical :: has_friction , has_wind n = mesh % ncells_owned has_friction = ( state % barotropic % manning_n > 0.0_wp ) has_wind = ( state % barotropic % wind_tau_x /= 0.0_wp ) . or . & ( state % barotropic % wind_tau_y /= 0.0_wp ) . or . & state % forcing % wind_active n_sq = state % barotropic % manning_n * state % barotropic % manning_n min_h = state % minimum_allowed_height eps4 = DESING_EPS ** 4 tau_x = state % barotropic % wind_tau_x / RHO_WATER tau_y = state % barotropic % wind_tau_y / RHO_WATER mass_error_local = 0.0_wp do concurrent ( k = 1 : n ) & local ( stage , xmom , ymom , h , h4 , speed_sq , fr_max_sq , fr_scale , & u_val , v_val , speed , cf , denom ) & reduce ( + : mass_error_local ) ! ---- Read state ---- stage = state % barotropic % stage_cv ( k ) xmom = state % barotropic % xmom_cv ( k ) ymom = state % barotropic % ymom_cv ( k ) ! ---- Euler update ---- stage = stage + dt * state % barotropic % stage_eu ( k ) xmom = xmom + dt * state % barotropic % xmom_eu ( k ) ymom = ymom + dt * state % barotropic % ymom_eu ( k ) ! ---- Friction + wind ---- h = stage - state % barotropic % bed_cv ( k ) if ( h > min_h ) then if ( has_friction ) then u_val = xmom / h v_val = ymom / h speed = sqrt ( u_val * u_val + v_val * v_val ) cf = GRAVITY * n_sq / ( h ** ( 1.0_wp / 3.0_wp )) denom = 1.0_wp + dt * cf * speed / h xmom = xmom / denom ymom = ymom / denom end if if ( has_wind ) then xmom = xmom + dt * ( tau_x + state % forcing % wind_x ( k ) / RHO_WATER ) ymom = ymom + dt * ( tau_y + state % forcing % wind_y ( k ) / RHO_WATER ) end if end if ! ---- Protect (substage 2) ---- if ( h < DRY_TOLERANCE ) then ! Dry (or negative) -- zero momentum. xmom = 0.0_wp ymom = 0.0_wp else ! Thin-but-wet: KP07 desingularized velocity ! u = sqrt(2) h uh / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)), uh := h*u ! (identity for h >= eps, so applied only below eps), then ! the Froude backstop — blowup arrester only (triggers on a ! TRUE comparison, so NaN passes through and fails loudly). h4 = h ** 4 if ( h4 < eps4 ) then xmom = h * ( sqrt ( 2.0_wp ) * h * xmom / sqrt ( h4 + eps4 )) ymom = h * ( sqrt ( 2.0_wp ) * h * ymom / sqrt ( h4 + eps4 )) end if speed_sq = ( xmom ** 2 + ymom ** 2 ) / ( h * h ) fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) xmom = xmom * fr_scale ymom = ymom * fr_scale end if end if if ( h < 0.0_wp ) then stage = state % barotropic % bed_cv ( k ) end if ! ---- RK2 average: 0.5*(U&#94;n + U**) ---- stage = 0.5_wp * stage + 0.5_wp * state % barotropic % stage_backup ( k ) xmom = 0.5_wp * xmom + 0.5_wp * state % barotropic % xmom_backup ( k ) ymom = 0.5_wp * ymom + 0.5_wp * state % barotropic % ymom_backup ( k ) ! ---- Final protect (post-average) ---- h = stage - state % barotropic % bed_cv ( k ) if ( h < DRY_TOLERANCE ) then ! Dry (or negative) -- zero momentum. xmom = 0.0_wp ymom = 0.0_wp else ! Thin-but-wet: KP07 desingularized velocity ! u = sqrt(2) h uh / sqrt(h&#94;4 + max(h&#94;4, eps&#94;4)), uh := h*u ! (identity for h >= eps, so applied only below eps), then ! the Froude backstop — blowup arrester only (triggers on a ! TRUE comparison, so NaN passes through and fails loudly). h4 = h ** 4 if ( h4 < eps4 ) then xmom = h * ( sqrt ( 2.0_wp ) * h * xmom / sqrt ( h4 + eps4 )) ymom = h * ( sqrt ( 2.0_wp ) * h * ymom / sqrt ( h4 + eps4 )) end if speed_sq = ( xmom ** 2 + ymom ** 2 ) / ( h * h ) fr_max_sq = FROUDE_BACKSTOP ** 2 * GRAVITY * h if ( speed_sq > fr_max_sq ) then fr_scale = sqrt ( fr_max_sq / speed_sq ) xmom = xmom * fr_scale ymom = ymom * fr_scale end if end if if ( h < 0.0_wp ) then mass_error_local = mass_error_local + ( - h ) * mesh % area ( k ) stage = state % barotropic % bed_cv ( k ) end if ! ---- Write back ---- state % barotropic % stage_cv ( k ) = stage state % barotropic % xmom_cv ( k ) = xmom state % barotropic % ymom_cv ( k ) = ymom end do state % mass_error = state % mass_error + mass_error_local end subroutine fused_update_stage2_unstr","tags":"","url":"proc/fused_update_stage2_unstr.html"},{"title":"fused_update_stage_generic_unstr – Rakali","text":"public  subroutine fused_update_stage_generic_unstr(state, mesh, dt) One forward-Euler stage for the selectable-integrator path:\nEuler update + friction/wind + protect, scaled by the per-stage dt ( beta(i)*dt_step ).  Identical to fused_update_stage1_unstr\nminus the start-of-step backup writes (taken once by\nfused_save_state_unstr) so every scheme shares one source-term body. Arguments Type Intent Optional Attributes Name type( unstr_state_t ), intent(inout) :: state type( mesh_unstr_t ), intent(in) :: mesh real(kind=wp), intent(in) :: dt Calls proc~~fused_update_stage_generic_unstr~~CallsGraph proc~fused_update_stage_generic_unstr fused_update_stage_generic_unstr local local proc~fused_update_stage_generic_unstr->local reduce reduce proc~fused_update_stage_generic_unstr->reduce Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedu