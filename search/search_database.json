tress_y call g % add ( nml_real ( \"wind_stress_y\" , pr , \"Surface wind stress in y\" , units = \"Pa\" )) pr => cfg % coriolis_f call g % add ( nml_real ( \"coriolis_f\" , pr , \"Coriolis parameter f\" , units = \"1/s\" )) pl => cfg % use_hllc call g % add ( nml_logical ( \"use_hllc\" , pl , \"Use HLLC contact-wave Riemann solver instead of HLL\" )) pl => cfg % use_linear_bottom_drag call g % add ( nml_logical ( \"use_linear_bottom_drag\" , pl , & \"Linear (Rayleigh) bottom drag instead of quadratic Manning\" )) pr => cfg % bottom_drag_r call g % add ( nml_real ( \"bottom_drag_r\" , pr , \"Linear bottom-drag rate\" , units = \"1/s\" )) pl => cfg % wind_surface_layer call g % add ( nml_logical ( \"wind_surface_layer\" , pl , & \"Apply wind stress to the top layer only (multilayer)\" )) call schema % add_group ( g ) end subroutine register_physics","tags":"","url":"proc/register_physics.html"},{"title":"register_si – Rakali","text":"private  subroutine register_si(cfg, schema) &si_nml : semi-implicit free-surface CG-solver controls.  Only\nconsulted when time_scheme=\"semi_implicit\" ; both knobs default\nto the pre-knob plain-CG behaviour (byte-identical). Arguments Type Intent Optional Attributes Name type( config_t ), intent(in), target :: cfg type( nml_schema_t ), intent(inout) :: schema Calls proc~~register_si~~CallsGraph proc~register_si register_si proc~group_add nml_group_t%group_add proc~register_si->proc~group_add proc~nml_enum nml_enum proc~register_si->proc~nml_enum proc~nml_int nml_int proc~register_si->proc~nml_int proc~nml_logical nml_logical proc~register_si->proc~nml_logical proc~nml_real nml_real proc~register_si->proc~nml_real proc~schema_add_group nml_schema_t%schema_add_group proc~register_si->proc~schema_add_group error error proc~group_add->error proc~lower lower proc~group_add->proc~lower proc~schema_add_group->error proc~schema_add_group->proc~lower proc~move_group move_group proc~schema_add_group->proc~move_group Help Graph Key Nodes of dif