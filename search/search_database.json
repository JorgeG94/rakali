tion in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: div_hu real(kind=wp), private :: div_hv real(kind=wp), private :: dx real(kind=wp), private :: dy integer, private :: i integer, private :: j integer, private :: k integer, private :: nghost integer, private :: nx integer, private :: ny Source Code pure subroutine compute_vertical_velocity ( h , u_layer , v_layer , b , dsig , w , & grid , nz ) !! Integrate continuity equation bottom-up to get vertical velocity !! !! w(:,:,1) = 0 at bottom !! w(:,:,k+1) = w(:,:,k) - dsig_k * [d(h*u_k)/dx + d(h*v_k)/dy] !! using central differences for horizontal divergence type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: u_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: v_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: b ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: dsig ( nz ) real ( wp ), intent ( out ) :: w ( grid % nx_total , grid % ny_total , nz + 1 ) integer :: i , j , k , nx , ny , nghost real ( wp ) :: dx , dy real ( wp ) :: div_hu , div_hv nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost dx = grid % dx dy = grid % dy do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( div_hu , div_hv , k ) w ( i , j , 1 ) = 0.0_wp if ( h ( i , j ) > NH_MIN_DEPTH ) then do k = 1 , nz div_hu = ( h ( i + 1 , j ) * u_layer ( i + 1 , j , k ) - & h ( i - 1 , j ) * u_layer ( i - 1 , j , k )) / ( 2.0_wp * dx ) div_hv = ( h ( i , j + 1 ) * v_layer ( i , j + 1 , k ) - & h ( i , j - 1 ) * v_layer ( i , j - 1 , k )) / ( 2.0_wp * dy ) w ( i , j , k + 1 ) = w ( i , j , k ) - dsig ( k ) * ( div_hu + div_hv ) end do else do k = 1 , nz w ( i , j , k + 1 ) = 0.0_wp end do end if end do end subroutine compute_vertical_velocity","tags":"","url":"proc/compute_vertical_velocity.html"},{"title":"reconcile_barotropic – Rakali","text":"public  subroutine reconcile_barotropic(h, hu, hv, u_layer, v_layer, dsig, grid, nz) Recompute barotropic momentum from corrected layer velocities hu = h * sum(dsig_k * u_layer_k)\nhv = h * sum(dsig_k * v_layer_k) Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hu (grid%nx_total,grid%ny_total) real(kind=wp), intent(out) :: hv (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: u_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: v_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: dsig (nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Calls proc~~reconcile_barotropic~~CallsGraph proc~reconcile_barotropic reconcile_barotropic proc~compute_depth_averaged_momentum compute_depth_averaged_momentum proc~reconcile_barotropic->proc~compute_depth_averaged_momentum local local proc~compute_depth_averaged_momentum->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~reconcile_barotropic~~CalledByGraph proc~reconcile_barotropic reconcile_barotropic proc~solver_step_split