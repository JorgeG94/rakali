nknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: b_0 real(kind=wp), private :: b_k real(kind=wp), private :: b_ref logical, private :: crossing_found real(kind=wp), private :: d_centre_k real(kind=wp), private :: d_centre_ref real(kind=wp), private :: d_prev real(kind=wp), private :: delta_b real(kind=wp), private :: delta_d real(kind=wp), private :: denom real(kind=wp), private :: f_s_kin real(kind=wp), private :: f_t_kin real(kind=wp), private :: frac real(kind=wp), private :: h_b real(kind=wp), private :: h_b_lagged real(kind=wp), private :: h_col real(kind=wp), private :: h_k real(kind=wp), private :: h_k1 real(kind=wp), private :: h_top integer, private :: i integer, private :: j integer, private :: k integer, private :: kk real(kind=wp), private :: n_brunt integer, private :: nghost integer, private :: nx integer, private :: ny real(kind=wp), private :: ri_bulk real(kind=wp), private :: ri_prev real(kind=wp), private :: s_top real(kind=wp), private :: shear2 real(kind=wp), private :: u_k real(kind=wp), private :: u_ref real(kind=wp), private :: us real(kind=wp), private :: v_k real(kind=wp), private :: v_ref real(kind=wp), private :: vt2 real(kind=wp), private :: w_s_col real(kind=wp), private :: wstar3_lagged Source Code pure subroutine ml_kpp_boundary_layer ( h_layer , hu_layer , hv_layer , rho_layer , & hS_layer , rho_0 , alpha_T , beta_S , cp , & wind_x , wind_y , heat_flux , evap_minus_precip , & ri_crit , c_vt2 , & u_star , buoy_flux , bl_depth , & grid , nz ) !! Pass 1: per-column u_*, B_0, and bulk-Ri boundary-layer depth h_b. !!   u_* = sqrt(|tau|/rho_0), tau = surface wind stress (Pa). !!   B_0 = g·(alpha_T·F_T - beta_S·F_S), kinematic fluxes !!         F_T = Q_heat/(rho_0·cp), F_S = (E-P)·S_top; B_0 < 0 destabilizing. !!   h_b : top-down bulk-Ri sweep; crossing of `ri_crit` interpolated. !!         V_t²(d) = (c_vt2/ri_crit)·d·N(d)·w_s uses lagged `bl_depth` !!         (zero on first call ⇒ self-bootstrapping). No crossing ⇒ h_b = H. type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hu_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hv_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: hS_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: rho_0 , alpha_T , beta_S , cp real ( wp ), intent ( in ) :: wind_x ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: wind_y ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: heat_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: evap_minus_precip ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( in ) :: ri_crit , c_vt2 real ( wp ), intent ( inout ) :: u_star ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: buoy_flux ( grid % nx_total , grid % ny_total ) real ( wp ), intent ( inout ) :: bl_depth ( grid % nx_total , grid % ny_total ) integer :: i , j , k , kk , nx , ny , nghost real ( wp ) :: h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us real ( wp ) :: u_ref , v_ref , b_ref , d_centre_ref real ( wp ) :: h_b_lagged , wstar3_lagged , w_s_col real ( wp ) :: u_k , v_k , b_k , d_centre_k , delta_d , delta_b real ( wp ) :: n_brunt , vt2 , shear2 , ri_bulk , ri_prev , d_prev real ( wp ) :: denom , frac , h_b , h_k , h_k1 logical :: crossing_found nx = grid % nx_total ny = grid % ny_total nghost = grid % nghost if ( nz < 2 ) return do concurrent ( j = nghost + 1 : ny - nghost , i = nghost + 1 : nx - nghost ) & local ( k , kk , h_col , h_top , s_top , f_t_kin , f_s_kin , b_0 , us , & u_ref , v_ref , b_ref , d_centre_ref , h_b_lagged , & wstar3_lagged , w_s_col , u_k , v_k , b_k , d_centre_k , & delta_d , delta_b , n_brunt , vt2 , shear2 , ri_bulk , ri_prev , & d_prev , denom , frac , h_b , h_k , h_k1 , crossing_found ) h_col = 0.0_wp do kk = 1 , nz h_col = h_col + h_layer ( i , j , kk ) end do if ( h_col <= ML_MIN_DEPTH ) then u_star ( i , j ) = 0.0_wp buoy_flux ( i , j ) = 0.0_wp bl_depth ( i , j ) = 0.0_wp cycle end if ! Surface friction velocity (A-grid wind stress is at the cell ! centre, so no face averaging). us = sqrt ( sqrt ( wind_x ( i , j ) * wind_x ( i , j ) + wind_y ( i , j ) * wind_y ( i , j )) / rho_0 ) ! Surface buoyancy flux. h_top = h_layer ( i , j , nz ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( i , j , nz ) / h_top u_ref = hu_layer ( i , j , nz ) / h_top v_ref = hv_layer ( i , j , nz ) / h_top else s_top = 0.0_wp u_ref = 0.0_wp v_ref = 0.0_wp end if f_t_kin = heat_flux ( i , j ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( i , j ) * s_top ! Buoyancy flux from the *dimensional* coastal EOS derivatives: ! b = -g*rho/rho_0, drho = -alpha_T*dT + beta_S*dS (kg/m&#94;3 per ! degC / PSU), so B_0 = (g/rho_0)*(alpha_T*F_T - beta_S*F_S). ! (The ocean path folds the 1/rho_0 into its expansion ! coefficients; coastal keeps it explicit.) b_0 = ( GRAVITY / rho_0 ) * ( alpha_T * f_t_kin - beta_S * f_s_kin ) u_star ( i , j ) = us buoy_flux ( i , j ) = b_0 ! Reference buoyancy at the surface layer centre. b_ref = - GRAVITY * rho_layer ( i , j , nz ) / rho_0 d_centre_ref = 0.5_wp * h_top ! Lagged convective scale for V_t² (self-bootstraps from 0). h_b_lagged = bl_depth ( i , j ) wstar3_lagged = max ( 0.0_wp , - b_0 ) * h_b_lagged w_s_col = sqrt ( us * us + wstar3_lagged ** ( 2.0_wp / 3.0_wp )) ri_prev = 0.0_wp d_prev = d_centre_ref h_b = 0.0_wp crossing_found = . false . d_centre_k = d_centre_ref do k = nz - 1 , 1 , - 1 if (. not . crossing_found ) then h_k = h_layer ( i , j , k ) h_k1 = h_layer ( i , j , k + 1 ) d_centre_k = d_centre_k + 0.5_wp * ( h_k1 + h_k ) if ( h_k > DRY_TOLERANCE ) then u_k = hu_layer ( i , j , k ) / h_k v_k = hv_layer ( i , j , k ) / h_k else u_k = 0.0_wp v_k = 0.0_wp end if b_k = - GRAVITY * rho_layer ( i , j , k ) / rho_0 delta_d = d_centre_k - d_centre_ref delta_b = b_ref - b_k n_brunt = sqrt ( max ( 0.0_wp , delta_b / delta_d )) vt2 = ( c_vt2 / ri_crit ) * d_centre_k * n_brunt * w_s_col shear2 = max (( u_k - u_ref ) * ( u_k - u_ref ) + & ( v_k - v_ref ) * ( v_k - v_ref ) + vt2 , SHEAR2_FLOOR ) ri_bulk = delta_b * delta_d / shear2 if ( ri_bulk >= ri_crit ) then denom = ri_bulk - ri_prev if ( abs ( denom ) > 1.0e-12_wp ) then frac = ( ri_crit - ri_prev ) / denom else frac = 0.5_wp end if h_b = d_prev + frac * ( d_centre_k - d_prev ) crossing_found = . true . end if ri_prev = ri_bulk d_prev = d_centre_k end if end do if (. not . crossing_found ) h_b = h_col bl_depth ( i , j ) = h_b end do end subroutine ml_kpp_boundary_layer","tags":"","url":"proc/ml_kpp_boundary_layer.html"},{"title":"ml_kpp_diffusion_tracers – Rakali","text":"public pure subroutine ml_kpp_diffusion_tracers(h_layer, hu_layer, hv_layer, hS_layer, hT_layer, rho_layer, rho_0, nu_max, kappa_S_bg, kappa_T_bg, ri_alpha, cs_nonlocal, heat_flux, evap_minus_precip, cp, u_star, buoy_flux, bl_depth, grid, nz, dt) Pass 2 (tracers): PP81 cubic interior diffusivity with the KPP\noverlay max’d in (same overlay as momentum), explicit flux on\nsalinity + temperature, plus the non-local counter-gradient\ntransport under destabilizing forcing.  Fuses the two ml_vertical_diffusion_tracer calls; bit-identical to them\nwhere the overlay + non-local terms vanish. Non-local: gamma(iface) = cs·G(sigma)·F_kin is a downward flux;\nits divergence redistributes the surface flux through the BL.\nApplied in a second column pass so the diffusive flux above is\ncomputed from un-redistributed tracer (matches the ocean order\nof vdiff-then-nonlocal).  gamma = 0 at the bed and free\nsurface ⇒ the divergence conserves the column integral. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: h_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hu_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hv_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hS_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(inout) :: hT_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: rho_0 real(kind=wp), intent(in) :: nu_max real(kind=wp), intent(in) :: kappa_S_bg real(kind=wp), intent(in) :: kappa_T_bg real(kind=wp), intent(in) :: ri_alpha real(kind=wp), intent(in) :: cs_nonlocal real(kind=wp), intent(in) :: heat_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: evap_minus_precip (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: cp real(kind=wp), intent(in) :: u_star (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: buoy_flux (grid%nx_total,grid%ny_total) real(kind=wp), intent(in) :: bl_depth (grid%nx_total,grid%ny_total) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz real(kind=wp), intent(in) :: dt Calls proc~~ml_kpp_diffusion_tracers~~CallsGraph proc~ml_kpp_diffusion_tracers ml_kpp_diffusion_tracers local local proc~ml_kpp_diffusion_tracers->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed