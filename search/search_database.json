( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Called by proc~~ml_init_tracer_stratified~~CalledByGraph proc~ml_init_tracer_stratified ml_init_tracer_stratified proc~ml_seed_tracer ml_seed_tracer proc~ml_seed_tracer->proc~ml_init_tracer_stratified proc~multilayer_seed_tracers multilayer_state_t%multilayer_seed_tracers proc~multilayer_seed_tracers->proc~ml_seed_tracer proc~init_multilayer_from_barotropic init_multilayer_from_barotropic proc~init_multilayer_from_barotropic->proc~multilayer_seed_tracers proc~api_init_multilayer api_init_multilayer proc~api_init_multilayer->proc~init_multilayer_from_barotropic proc~init_from_config init_from_config proc~init_from_config->proc~init_multilayer_from_barotropic proc~init_local_state init_local_state proc~init_local_state->proc~init_multilayer_from_barotropic proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~rki_finalize rki_finalize proc~rki_finalize->proc~api_init_multilayer proc~rki_finalize->proc~init_from_config Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: dtr integer, private :: i integer, private :: j integer, private :: k integer, private :: nx integer, private :: ny Source Code pure subroutine ml_init_tracer_stratified ( h_layer , hTr_layer , tr_bottom , & tr_surface , grid , nz ) !! Seed a tracer with a linear vertical profile: `tr_bottom` at k=1 !! (bed) to `tr_surface` at k=nz (surface), per the bottom-up layer !! convention.  The profile is computed inline from the two scalars !! (no host-side per-layer array) so the seed runs correctly on the !! device after `enter_data`.  Caller guarantees nz > 1.  Mirrors the !! unstructured `ml_init_tracer_stratified_unstr`. !!   hTr_k = h_layer_k * [tr_bottom + dtr*(k - 1)] type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz real ( wp ), intent ( in ) :: h_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( out ) :: hTr_layer ( grid % nx_total , grid % ny_total , nz ) real ( wp ), intent ( in ) :: tr_bottom , tr_surface integer :: i , j , k , nx , ny real ( wp ) :: dtr nx = grid % nx_total ny = grid % ny_total dtr = ( tr_surface - tr_bottom ) / real ( nz - 1 , wp ) do concurrent ( k = 1 : nz , j = 1 : ny , i = 1 : nx ) hTr_layer ( i , j , k ) = h_layer ( i , j , k ) & * ( tr_bottom + dtr * real ( k - 1 , wp )) end do end subroutine ml_init_tracer_stratified","tags":"","url":"proc/ml_init_tracer_stratified.html"},{"title":"ml_rk2_average_tracer – Rakali","text":"public pure subroutine ml_rk2_average_tracer(hTr_layer, hTr_layer0, grid, nz) SSP-RK2 averaging for a tracer: hTr = 0.5*(hTr0 + hTr).\nClamps the result to >= 0 inline; additional bounds (upper and/or\ntracer-specific lower) are enforced by ml_clamp_tracer if called\nafter this kernel. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(inout) :: hTr_layer (grid%nx_total,grid%ny_total,nz) real(kind=wp), intent(in) :: hTr_layer0 (grid%nx_total,grid%ny_total,nz) type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Called by proc~~ml_rk2_average_tracer~~CalledByGraph proc~ml_rk2_average_tracer ml_rk2_average_tracer proc~solver_step_multilayer_impl solver_step_multilayer_impl proc~solver_step_multilayer_impl->proc~ml_rk2_average_tracer proc~solver_step solver_step