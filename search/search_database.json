te  subroutine tracer_init(this, grid, nz) Allocate hTr / hTr0 at the multilayer grid size, zero-filled.\nCaller is responsible for populating the prognostic field\n(e.g. hTr = h_layer * tr_init ) after layer thicknesses are set. Type Bound tracer_t Arguments Type Intent Optional Attributes Name class( tracer_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid integer, intent(in) :: nz Called by proc~~tracer_init~~CalledByGraph proc~tracer_init tracer_t%tracer_init proc~multilayer_register_passive_tracer multilayer_state_t%multilayer_register_passive_tracer proc~multilayer_register_passive_tracer->proc~tracer_init proc~state_init_from_config state_t%state_init_from_config proc~state_init_from_config->proc~multilayer_register_passive_tracer proc~init_local_state init_local_state proc~init_local_state->proc~state_init_from_config proc~rki_create rki_create proc~rki_create->proc~state_init_from_config proc~rki_create_from_string rki_create_from_string proc~rki_create_from_string->proc~state_init_from_config proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_create proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_create_from_string proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: nx integer, private :: ny Source Code subroutine tracer_init ( this , grid , nz ) !! Allocate hTr / hTr0 at the multilayer grid size, zero-filled. !! Caller is responsible for populating the prognostic field !! (e.g. `hTr = h_layer * tr_init`) after layer thicknesses are set. class ( tracer_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid integer , intent ( in ) :: nz integer :: nx , ny nx = grid % nx_total ny = grid % ny_total allocate ( this % hTr ( nx , ny , nz ), source = 0.0_wp ) allocate ( this % hTr0 ( nx , ny , nz ), source = 0.0_wp ) end subroutine tracer_init","tags":"","url":"proc/tracer_init.html"},{"title":"edge_depth_wetdry – Rakali","text":"private pure function edge_depth_wetdry(eta_l, eta_r, b_l, b_r) result(hf) Frozen wet/dry edge conveyance: the arithmetic-mean water depth of\nthe two adjacent cells, gated to 0 by the max-eta/sill wet test. !$acc routine seq so device do-concurrent bodies can call it. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: eta_l real(kind=wp), intent(in) :: eta_r real(kind=wp), intent(in) :: b_l real(kind=wp), intent(in) :: b_r Return Value real(kind=wp) Called by proc~~edge_depth_wetdry~~CalledByGraph proc~edge_depth_wetdry edge_depth_wetdry proc~si_unstr_wetdry_face_depths si_unstr_wetdry_face_depths proc~si_unstr_wetdry_face_depths->proc~edge_depth_wetdry proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_wetdry_face_depths proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Source Code pure function edge_depth_wetdry ( eta_l , eta_r , b_l , b_r ) result ( hf ) !! Frozen wet/dry edge conveyance: the arithmetic-mean water depth of !! the two adjacent cells, gated to 0 by the max-eta/sill wet test. !! `!$acc routine seq` so device do-concurrent bodies can call it. !$acc routine seq real ( wp ), intent ( in ) :: eta_l , eta_r , b_l , b_r real ( wp ) :: hf if ( max ( eta_l , eta_r ) > max ( b_l , b_r )) then hf = 0.5_wp * ( max ( eta_l - b_l , 0.0_wp ) + max ( eta_r - b_r , 0.0_wp )) else hf = 0.0_wp end if end function edge_depth_wetdry","tags":"","url":"proc/edge_depth_wetdry.html"},{"title":"si_unstr_wetdry_face_depths – Rakali","text":"public pure subroutine si_unstr_wetdry_face_depths(mesh, nct, nco, n_bc, eta, b_min, bc_type, bc_eta_ext, Hf_edge, eta_ghost_edge) Uses rki_boundary_unstr proc~~si_unstr_wetdry_face_depths~~UsesGraph proc~si_unstr_wetdry_face_depths si_unstr_wetdry_face_depths module~rki_boundary_unstr rki_boundary_unstr proc~si_unstr_wetdry_face_depths->module~rki_boundary_unstr Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. FROZEN wet/dry edge depths — the GATED-MEAN conveyance rule per\nedge (Casulli rule R1, prototype-verified mesh-agnostic):\n  wet  <=>  max(eta_L, eta_R) > max(b_L, b_R)     (max-eta/sill)\n  Hf   = 0.5 (max(eta_L-b_L,0) + max(eta_R-b_R,0))  where wet\nWhere BOTH cells are wet this is EXACTLY the linear edge depth\n0.5 (h_L+h_R) — an all-wet basin reproduces the linear operator’s\nHf bit-for-bit (NOT a raw max-eta or bare sill depth, which would\nchange the all-wet answer — the load-bearing structured lesson).\nDead edges (higher surface below the higher bed — a wet cell\ncannot “see” through a dry one over the sill) are walls (Hf=0). Boundary edges: WALL => 0; TIDAL/CLAMPED (Dirichlet) => the same\ngated-mean rule against the seeded ghost (ghost bed mirrors the\ncell bed; ghost surface = the prescribed eta_bc, also stashed in eta_ghost_edge for the operator/RHS/back-sub). Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. integer, intent(in) :: n_bc BC group table size. real(kind=wp), intent(in) :: eta (nct) eta&#94;n at circumcentres (the FROZEN surface). real(kind=wp), intent(in) :: b_min (nct) Sill bed elevation (deepest sub-bottom) at cells (m). integer, intent(in) :: bc_type (n_bc) real(kind=wp), intent(in) :: bc_eta_ext (n_bc) real(kind=wp), intent(out) :: Hf_edge (EDGES_PER_TRI,nct) real(kind=wp), intent(out) :: eta_ghost_edge (EDGES_PER_TRI,nct) Calls proc~~si_unstr_wetdry_face_depths~~CallsGraph proc~si_unstr_wetdry_face_depths si_unstr_wetdry_face_depths local local proc~si_unstr_wetdry_face_depths->local proc~edge_depth_wetdry edge_depth_wetdry proc~si_unstr_wetdry_face_depths->proc~edge_depth_wetdry Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_wetdry_face_depths~~CalledByGraph proc~si_unstr_wetdry_face_depths si_unstr_wetdry_face_depths proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_wetdry_face_depths proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: bt integer, private :: c real(kind=wp), private :: eta_bc integer, private :: g integer, private :: i integer, private :: kn Source Code pure subroutine si_unstr_wetdry_face_depths ( mesh , nct , nco , n_bc , eta , & b_min , bc_type , bc_eta_ext , & Hf_edge , eta_ghost_edge ) !! FROZEN wet/dry edge depths — the GATED-MEAN conveyance rule per !! edge (Casulli rule R1, prototype-verified mesh-agnostic): !!   wet  <=>  max(eta_L, eta_R) > max(b_L, b_R)     (max-eta/sill) !!   Hf   = 0.5*(max(eta_L-b_L,0) + max(eta_R-b_R,0))  where wet !! Where BOTH cells are wet this is EXACTLY the linear edge depth !! 0.5*(h_L+h_R) — an all-wet basin reproduces the linear operator's !! Hf bit-for-bit (NOT a raw max-eta or bare sill depth, which would !! change the all-wet answer — the load-bearing structured lesson). !! Dead edges (higher surface below the higher bed — a wet cell !! cannot \"see\" through a dry one over the sill) are walls (Hf=0). !! !! Boundary edges: WALL => 0; TIDAL/CLAMPED (Dirichlet) => the same !! gated-mean rule against the seeded ghost (ghost bed mirrors the !! cell bed; ghost surface = the prescribed eta_bc, also stashed in !! `eta_ghost_edge` for the operator/RHS/back-sub). use rki_boundary_unstr , only : BC_WALL , BC_TIDAL , BC_CLAMPED type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. integer , intent ( in ) :: n_bc !! BC group table size. real ( wp ), intent ( in ) :: eta ( nct ) !! eta&#94;n at circumcentres (the FROZEN surface). real ( wp ), intent ( in ) :: b_min ( nct ) !! Sill bed elevation (deepest sub-bottom) at cells (m). integer , intent ( in ) :: bc_type ( n_bc ) real ( wp ), intent ( in ) :: bc_eta_ext ( n_bc ) real ( wp ), intent ( out ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( out ) :: eta_ghost_edge ( EDGES_PER_TRI , nct ) integer :: c , i , kn , g , bt real ( wp ) :: eta_bc do concurrent ( c = 1 : nco ) local ( i , kn , g , bt , eta_bc ) do i = 1 , EDGES_PER_TRI eta_ghost_edge ( i , c ) = 0.0_wp kn = mesh % neighbours ( i , c ) if ( kn > 0 ) then Hf_edge ( i , c ) = edge_depth_wetdry ( eta ( c ), eta ( kn ), & b_min ( c ), b_min ( kn )) else g = mesh % bc_group ( i , c ) bt = BC_WALL if ( g >= 1 . and . g <= n_bc ) bt = bc_type ( g ) if (( bt == BC_TIDAL . or . bt == BC_CLAMPED ) . and . g >= 1 ) then eta_bc = bc_eta_ext ( g ) Hf_edge ( i , c ) = edge_depth_wetdry ( eta ( c ), eta_bc , & b_min ( c ), b_min ( c )) eta_ghost_edge ( i , c ) = eta_bc else Hf_edge ( i , c ) = 0.0_wp end if end if end do end do end subroutine si_unstr_wetdry_face_depths","tags":"","url":"proc/si_unstr_wetdry_face_depths.html"},{"title":"si_unstr_wetdry_fill_bsub – Rakali","text":"public pure subroutine si_unstr_wetdry_fill_bsub(mesh, nsub, nct, nco, bed, bsub_fill, b_sub, b_min) Uses rki_si_common proc~~si_unstr_wetdry_fill_bsub~~UsesGraph proc~si_unstr_wetdry_fill_bsub si_unstr_wetdry_fill_bsub module~rki_si_common rki_si_common proc~si_unstr_wetdry_fill_bsub->module~rki_si_common pic_logger pic_logger module~rki_si_common->pic_logger Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Fill the per-cell sub-bottom table from the plain bed.  v1\n(n_sub=1): b_sub(1,:) = bed, b_min = bed — always, regardless of\nmode.  Subgrid (n_sub>=2):\n  FLAT (default): all sub-bottoms = bed => BIT-IDENTICAL to n_sub=1.\n  LINEAR: nsub equal-area sub-bottoms evenly spaced across the\n    per-cell relief band [bed-half, bed+half] , half = 0.5*max edge-neighbour |Δbed| (a linear sub-cell bed ramp; Casulli 2009\n    subgrid bathymetry, prototype subgrid_bathy_from_bed ).\n    Sub-bottoms ascending; mean == bed (still-water volume\n    unchanged); wet fraction staircases 1/nsub per breakpoint so a\n    coarse tidal flat drains/floods SMOOTHLY.  Boundary edges (no\n    neighbour) contribute 0 to the relief so a shore cell falls back\n    toward FLAT.  On flat bed (half=0) => == FLAT.  b_min = the\n    deepest (first, sill) sub-bottom. Arguments Type Intent Optional Attributes Name type( mesh_unstr_t ), intent(in) :: mesh integer, intent(in) :: nsub Sub-bottoms per cell (>= 1). integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: bed (nct) integer, intent(in) :: bsub_fill SI_BSUB_FILL_* .  FLAT => flat fill; LINEAR => the ramp. real(kind=wp), intent(out) :: b_sub (nsub,nct) real(kind=wp), intent(out) :: b_min (nct) Calls proc~~si_unstr_wetdry_fill_bsub~~CallsGraph proc~si_unstr_wetdry_fill_bsub si_unstr_wetdry_fill_bsub local local proc~si_unstr_wetdry_fill_bsub->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_wetdry_fill_bsub~~CalledByGraph proc~si_unstr_wetdry_fill_bsub si_unstr_wetdry_fill_bsub proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_wetdry_fill_bsub proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_unstr_wetdry_fill_bsub proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step proc~driver_run_coastal_unstr driver_run_coastal_unstr proc~driver_run_coastal_unstr->proc~solver_unstr_advance proc~rki_unstr_advance rki_unstr_advance proc~rki_unstr_advance->proc~solver_unstr_advance Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial real(kind=wp), private :: b_lo integer, private :: c real(kind=wp), private :: dmax real(kind=wp), private :: frac real(kind=wp), private :: half integer, private :: i integer, private :: kn integer, private :: s real(kind=wp), private :: span Source Code pure subroutine si_unstr_wetdry_fill_bsub ( mesh , nsub , nct , nco , bed , & bsub_fill , b_sub , b_min ) !! Fill the per-cell sub-bottom table from the plain bed.  v1 !! (n_sub=1): b_sub(1,:) = bed, b_min = bed — always, regardless of !! mode.  Subgrid (n_sub>=2): !!   FLAT (default): all sub-bottoms = bed => BIT-IDENTICAL to n_sub=1. !!   LINEAR: `nsub` equal-area sub-bottoms evenly spaced across the !!     per-cell relief band `[bed-half, bed+half]`, `half = 0.5*max` !!     edge-neighbour |Δbed| (a linear sub-cell bed ramp; Casulli 2009 !!     subgrid bathymetry, prototype `subgrid_bathy_from_bed`). !!     Sub-bottoms ascending; mean == bed (still-water volume !!     unchanged); wet fraction staircases 1/nsub per breakpoint so a !!     coarse tidal flat drains/floods SMOOTHLY.  Boundary edges (no !!     neighbour) contribute 0 to the relief so a shore cell falls back !!     toward FLAT.  On flat bed (half=0) => == FLAT.  b_min = the !!     deepest (first, sill) sub-bottom. use rki_si_common , only : SI_BSUB_FILL_LINEAR type ( mesh_unstr_t ), intent ( in ) :: mesh integer , intent ( in ) :: nsub !! Sub-bottoms per cell (>= 1). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: bed ( nct ) integer , intent ( in ) :: bsub_fill !! `SI_BSUB_FILL_*`.  FLAT => flat fill; LINEAR => the ramp. real ( wp ), intent ( out ) :: b_sub ( nsub , nct ) real ( wp ), intent ( out ) :: b_min ( nct ) integer :: c , s , i , kn real ( wp ) :: half , b_lo , span , frac , dmax if ( bsub_fill /= SI_BSUB_FILL_LINEAR . or . nsub < 2 ) then do concurrent ( c = 1 : nco ) local ( s ) do s = 1 , nsub b_sub ( s , c ) = bed ( c ) end do b_min ( c ) = bed ( c ) end do return end if do concurrent ( c = 1 : nco ) local ( s , i , kn , half , b_lo , span , frac , dmax ) dmax = 0.0_wp do i = 1 , EDGES_PER_TRI kn = mesh % neighbours ( i , c ) if ( kn > 0 ) dmax = max ( dmax , abs ( bed ( kn ) - bed ( c ))) end do half = 0.5_wp * dmax b_lo = bed ( c ) - half span = 2.0_wp * half do s = 1 , nsub frac = ( real ( s , wp ) - 0.5_wp ) / real ( nsub , wp ) b_sub ( s , c ) = b_lo + span * frac end do b_min ( c ) = b_lo end do end subroutine si_unstr_wetdry_fill_bsub","tags":"","url":"proc/si_unstr_wetdry_fill_bsub.html"},{"title":"si_unstr_wetdry_mass_diag – Rakali","text":"public pure subroutine si_unstr_wetdry_mass_diag(nct, nco, a_cell, Hf_edge, mass_diag) Assemble the Newton mass diagonal M = a + floor (Casulli R5): the\nwet fraction a plus a +1 identity for a fully-decoupled dry row\n(a <= tol AND all three edge stiffness coefficients Hf <= tol).\nThe +1 matches the linear operator’s constant mass exactly at\nwet cells where a == 1 and no floor fires. Arguments Type Intent Optional Attributes Name integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: a_cell (nct) real(kind=wp), intent(in) :: Hf_edge (EDGES_PER_TRI,nct) real(kind=wp), intent(out) :: mass_diag (nct) Calls proc~~si_unstr_wetdry_mass_diag~~CallsGraph proc~si_unstr_wetdry_mass_diag si_unstr_wetdry_mass_diag local local proc~si_unstr_wetdry_mass_diag->local Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~si_unstr_wetdry_mass_diag~~CalledByGraph proc~si_unstr_wetdry_mass_diag si_unstr_wetdry_mass_diag proc~si_ml_wetdry_newton si_ml_wetdry_newton proc~si_ml_wetdry_newton->proc~si_unstr_wetdry_mass_diag proc~si_unstr_advance_wetdry si_unstr_advance_wetdry proc~si_unstr_advance_wetdry->proc~si_unstr_wetdry_mass_diag proc~si_unstr_step si_unstr_step proc~si_unstr_step->proc~si_unstr_advance_wetdry proc~si_unstr_step_ml si_unstr_step_ml proc~si_unstr_step_ml->proc~si_ml_wetdry_newton proc~solver_unstr_step_semi_implicit solver_unstr_step_semi_implicit proc~solver_unstr_step_semi_implicit->proc~si_unstr_step proc~solver_unstr_step_semi_implicit->proc~si_unstr_step_ml proc~solver_unstr_step solver_unstr_step proc~solver_unstr_step->proc~solver_unstr_step_semi_implicit proc~rki_unstr_step rki_unstr_step proc~rki_unstr_step->proc~solver_unstr_step proc~solver_unstr_advance solver_unstr_advance proc~solver_unstr_advance->proc~solver_unstr_step Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: c real(kind=wp), private :: floor_c integer, private :: i real(kind=wp), private :: stiff_sum Source Code pure subroutine si_unstr_wetdry_mass_diag ( nct , nco , a_cell , Hf_edge , mass_diag ) !! Assemble the Newton mass diagonal M = a + floor (Casulli R5): the !! wet fraction a plus a +1 identity for a fully-decoupled dry row !! (a <= tol AND all three edge stiffness coefficients Hf <= tol). !! The `+1` matches the linear operator's constant mass exactly at !! wet cells where a == 1 and no floor fires. integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: a_cell ( nct ) real ( wp ), intent ( in ) :: Hf_edge ( EDGES_PER_TRI , nct ) real ( wp ), intent ( out ) :: mass_diag ( nct ) integer :: c , i real ( wp ) :: stiff_sum , floor_c do concurrent ( c = 1 : nco ) local ( i , stiff_sum , floor_c ) stiff_sum = 0.0_wp do i = 1 , EDGES_PER_TRI stiff_sum = stiff_sum + Hf_edge ( i , c ) end do if ( a_cell ( c ) <= WETDRY_FLOOR_TOL . and . stiff_sum <= WETDRY_FLOOR_TOL ) then floor_c = 1.0_wp else floor_c = 0.0_wp end if mass_diag ( c ) = a_cell ( c ) + floor_c end do end subroutine si_unstr_wetdry_mass_diag","tags":"","url":"proc/si_unstr_wetdry_mass_diag.html"},{"title":"si_unstr_wetdry_newton_residual – Rakali","text":"public  subroutine si_unstr_wetdry_newton_residual(nct, nco, eta, Jeta, mass_diag, v_cell, rhs, res, res2_out) Form the Newton nonlinear residual and its squared interior norm:\n  F_c = v_c(eta) + [T eta]_c - rhs_c,\nwith the stiffness recovered matmul-free from the full mass-diag\noperator apply:  T eta = Jeta - mass_diag eta.  Returns sum(F&#94;2)\nover the owned cells (the Newton convergence norm — plain, not\narea-weighted, matching the prototype/structured gate; it is a\nconvergence heuristic, not the CG inner product). Arguments Type Intent Optional Attributes Name integer, intent(in) :: nct Cell array extent (ncells_total). integer, intent(in) :: nco Owned-cell loop bound. real(kind=wp), intent(in) :: eta (nct) real(kind=wp), intent(in) :: Jeta (nct) real(kind=wp), intent(in) :: mass_diag (nct) real(kind=wp), intent(in) :: v_cell (nct) real(kind=wp), intent(in) :: rhs (nct) real(kind=wp), intent(out) :: res (nct) real(kind=wp), intent(out) :: res2_out Calls proc~~si_unstr_wetdry_newton_residual~~CallsGraph proc~si_unstr_wetdry_newton_residual si_