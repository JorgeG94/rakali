 /\nTS_CONS_ABS).  Identity for linear + Wright.  This type is\na flat POD — NO allocatable component — so it copies into\nregisters for free when passed by value into the device\npoint routines ( !$acc routine seq ). integer, public :: variant = EOS_VARIANT_LINEAR Active EOS variant.  Defaults to linear two-tracer\n(the simplest implemented branch).  Wright (1997)\nrational EOS is also shipped — opt in by setting variant = EOS_VARIANT_WRIGHT_97 .  TEOS-10 reserved. Type-Bound Procedures procedure, public, non_overridable :: destroy => eos_destroy private  subroutine eos_destroy (this) Arguments Type Intent Optional Attributes Name class( eos_t ), intent(inout) :: this procedure, public, non_overridable :: init => eos_init private  subroutine eos_init (this, grid) Arguments Type Intent Optional Attributes Name class( eos_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid Source Code type :: eos_t logical :: is_init = . false . !! True between `init` and `destroy`.  Prefer this to !! `allocated(...)` — tracks GPU device attachment too. integer :: variant = EOS_VARIANT_LINEAR !! Active EOS variant.  Defaults to linear two-tracer !! (the simplest implemented branch).  Wright (1997) !! rational EOS is also shipped — opt in by setting !! `variant = EOS_VARIANT_WRIGHT_97`.  TEOS-10 reserved. real ( wp ) :: rho0 = 103 5.0_wp !! Boussinesq reference density (kg/m&#94;3). real ( wp ) :: T_ref = 1 0.0_wp !! Reference temperature for linear EOS (degC). real ( wp ) :: S_ref = 3 5.0_wp !! Reference salinity for linear EOS (PSU). real ( wp ) :: alpha_T = 1.7e-4_wp !! Thermal expansion coeff (linear EOS), kg/m&#94;3 per degC. !! NOTE: this default is ~1000× smaller than the standard !! seawater value (~0.17 kg/m³/K).  The small value !! suppresses baroclinic feedback from PPM round-off in !! tests that don't care about realistic density gradients. !! Density-driven tests (e.g. `lock_exchange_2layer`) MUST !! override to the realistic value. real ( wp ) :: beta_S = 7.6e-4_wp !! Haline contraction coeff (linear EOS), kg/m&#94;3 per PSU. !! See `alpha_T` for the rationale on this small default. real ( wp ) :: p_ref = 0.0_wp !! Reference pressure for the Wright EOS evaluation (Pa). !! Phase Tier-1 evaluates ρ at p_ref = 0 (surface) — gives !! the nonlinear-in-(T, S) ρ that cabbeling and densification !! tests need.  The FV-PGF integration path uses the in-situ !! hydrostatic pressure at each layer centre (its own column !! scratch on the PGF state, not an EOS field). integer :: ts_convention = TS_POT_PRAC !! Tracer T/S convention this EOS expects (TS_POT_PRAC / !! TS_CONS_ABS).  Identity for linear + Wright.  This type is !! a flat POD — NO allocatable component — so it copies into !! registers for free when passed by value into the device !! point routines (`!$acc routine seq`). contains procedure , non_overridable :: init => eos_init procedure , non_overridable :: destroy => eos_destroy end type eos_t","tags":"","url":"type/eos_t.html"},{"title":"unstr_surface_forcing_t – Rakali ","text":"type, public :: unstr_surface_forcing_t Surface flux fields applied by the unstructured multilayer\nsurface-flux kernel.  Sized to mesh%ncells_total so halo\ncells carry whatever the user pushed in (forcing is read-only\nfrom the kernel’s perspective and only owned cells are written\ninto tracer fields, so halo content is irrelevant for\ncorrectness – but the allocation matches the rest of the\nstate for consistency). Inherited by type~~unstr_surface_forcing_t~~InheritedByGraph type~unstr_surface_forcing_t unstr_surface_forcing_t type~unstr_state_t unstr_state_t type~unstr_state_t->type~unstr_surface_forcing_t forcing type~solver_handle_unstr_t solver_handle_unstr_t type~solver_handle_unstr_t->type~unstr_state_t state Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial logical, public :: active = .false. True when forcing arrays contain non-zero data.  Currently\nadvisory only – the kernel runs unconditionally because\nzero forcing is a bit-exact no-op. real(kind=wp), public, allocatable :: evap_minus_precip (:) Virtual surface freshwater flux (m/s), positive for net\nevaporation.  Applied as a virtual salt flux on the top\nlayer: hS(1,c) += dt * (E-P) * S_top. real(kind=wp), public, allocatable :: heat_flux (:) Net surface heat flux (W/m&#94;2), positive into ocean.\nApplied to top layer hT only; does not change h_layer. logical, public :: wind_active = .false. True once a non-zero per-cell wind field has been pushed via rki_unstr_set_wind_field .  Gates the per-cell wind read in the\nfused kernel so the no-wind hot path skips it entirely. real(kind=wp), public, allocatable :: wind_x (:) Per-cell surface wind stress, x-component (Pa).  Added to the\nbarotropic momentum (on top of the uniform barotropic%wind_tau_x)\nby the fused update kernel.  Zero => no per-cell contribution. real(kind=wp), public, allocatable :: wind_y (:) Per-cell surface wind stress, y-component (Pa). Type-Bound Procedures procedure, public, non_overridable :: destroy => unstr_surface_forcing_destroy private  subroutine unstr_surface_forcing_destroy (this) Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this procedure, public, non_overridable :: enter_data => unstr_surface_forcing_enter_data private  subroutine unstr_surface_forcing_enter_data (this) Map the forcing allocatables onto the device.  The parent unstr_state_t%forcing value-type member rides over with the\nparent copyin(state) ; only the inner allocatable arrays need\nexplicit attaches.  Both fields are read-only in the kernel\nand updated from host via set_* setters, so copyin is the\nright initial direction. Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this procedure, public, non_overridable :: exit_data => unstr_surface_forcing_exit_data private  subroutine unstr_surface_forcing_exit_data (this) Counterpart to enter_data .  No copy-out: forcing is set from\nhost, never produced on device, so the device copies have no\ninformation the host doesn’t already have. Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this procedure, public, non_overridable :: init => unstr_surface_forcing_init private  subroutine unstr_surface_forcing_init (this, mesh) Allocate the surface-forcing arrays sized to the mesh,\nzero-initialised.  Always safe to call – destroys first. Arguments Type Intent Optional Attributes Name class( unstr_surface_forcing_t ), intent(inout) :: this type( mesh_unstr_t ), intent(in) :: mesh Source Code type :: unstr_surface_forcing_t !! Surface flux fields applied by the unstructured multilayer !! surface-flux kernel.  Sized to `mesh%ncells_total` so halo !! cells carry whatever the user pushed in (forcing is read-only !! from the kernel's perspective and only owned cells are written !! into tracer fields, so halo content is irrelevant for !! correctness -- but the allocation matches the rest of the !! state for consistency). real ( wp ), allocatable :: heat_flux (:) !! Net surface heat flux (W/m&#94;2), positive into ocean. !! Applied to top layer hT only; does not change h_layer. real ( wp ), allocatable :: evap_minus_precip (:) !! Virtual surface freshwater flux (m/s), positive for net !! evaporation.  Applied as a virtual salt flux on the top !! layer: hS(1,c) += dt * (E-P) * S_top. real ( wp ), allocatable :: wind_x (:) !! Per-cell surface wind stress, x-component (Pa).  Added to the !! barotropic momentum (on top of the uniform barotropic%wind_tau_x) !! by the fused update kernel.  Zero => no per-cell contribution. real ( wp ), allocatable :: wind_y (:) !! Per-cell surface wind stress, y-component (Pa). logical :: wind_active = . false . !! True once a non-zero per-cell wind field has been pushed via !! `rki_unstr_set_wind_field`.  Gates the per-cell wind read in the !! fused kernel so the no-wind hot path skips it entirely. logical :: active = . false . !! True when forcing arrays contain non-zero data.  Currently !! advisory only -- the kernel runs unconditionally because !! zero forcing is a bit-exact no-op. contains procedure , non_overridable :: init => unstr_surface_forcing_init procedure , non_overridable :: destroy => unstr_surface_forcing_destroy procedure , non_overridable :: enter_data => unstr_surface_forcing_enter_data procedure , non_overridable :: exit_data => unstr_surface_forcing_exit_data end type unstr_surface_forcing_t","tags":"","url":"type/unstr_surface_forcing_t.html"},{"title":"efp_t – Rakali ","text":"type, public :: efp_t An order-invariant fixed-point value: Sum_n v(n) * pr(n) .  The\ncomponent is PUBLIC (unlike MOM6’s private EFP_type%v ) so the\ncomm facade ( halo_allreduce_efp_list ) can pack/unpack it without\nan accessor procedure – Rakali splits the arithmetic module\n(here) from the collective (in src/comm/ ), so the layering\nrequires v to be reachable from both.  Tests asserting bit-\nidentity compare v(:) directly, never the reconstructed real. Inherited by type~~efp_t~~InheritedByGraph type~efp_t efp_t type~console_stats_t console_stats_t type~console_stats_t->type~efp_t mass0_efp, salt0_efp, heat0_efp Help Graph Key Nodes of different colours represent the following: Graph Key Type Type This Page's Entity This Page's Entity Solid arrows point from a derived type to the parent type which it\nextends. Dashed arrows point from a derived type to the other\ntypes it contains as a components, with a label listing the name(s) of\nsaid component(s). Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Components Type Visibility Attributes Name Initial integer(kind=int64), public :: v (EFP_DIGITS) = 0_int64 Source Code type :: efp_t !! An order-invariant fixed-point value: `Sum_n v(n) * pr(n)`.  The !! component is PUBLIC (unlike MOM6's private `EFP_type%v`) so the !! comm facade (`halo_allreduce_efp_list`) can pack/unpack it without !! an accessor procedure -- Rakali splits the arithmetic module !! (here) from the collective (in `src/comm/`), so the layering !! requires `v` to be reachable from both.  Tests asserting bit- !! identity compare `v(:)` directly, never the reconstructed real. integer ( int64 ) :: v ( EFP_DIGITS ) = 0_int64 end type efp_t","tags":"","url":"type/efp_t.html"},{"title":"nesting_t – Rakali ","text":"type, public :: nesting_t Container for parent domain data and interpolation state Components Type Visibility Attributes Name Initial logical, public :: active = .false. Whether nesting is enabled real(kind=wp), public, allocatable :: h_hi (:,:) real(kind=wp), public, allocatable :: h_lo (:,:) real(kind=wp), public, allocatable :: hu_hi (:,:) real(kind=wp), public, allocatable :: hu_lo (:,:) real(kind=wp), public, allocatable :: hv_hi (:,:) real(kind=wp), public, allocatable :: hv_lo (:,:) integer, public :: idx_hi = 0 integer, public :: idx_lo = 0 integer, public :: ix_east = 1 integer, public :: ix_west = 1 integer, public :: iy_north = 1 integer, public :: iy_south = 1 integer, public :: ncid = -1 NetCDF file ID (kept open for lazy reads) integer, public :: p_nt = 0 Number of time steps in parent file integer, public :: p_nx = 0 Number of x-points in parent file integer, public :: p_ny = 0 Number of y-points in parent file real(kind=wp), public, allocatable :: p_time (:) Parent time coordinates (s) real(kind=wp), public, allocatable :: p_x (:) Parent x-coordinates (m) real(kind=wp), public, allocatable :: p_y (:) Parent y-coordinates (m) integer, public, allocatable :: sn_ix0 (:) Lower parent x-index per child i integer, public, allocatable :: sn_iy0 (:) Parent y-index for south/north edge interpolation real(kind=wp), public, allocatable :: sn_wx (:) Parent x-weight per child i real(kind=wp), public, allocatable :: sn_wy (:) Parent y-weight for south/north edge integer, public :: varid_h = -1 integer, public :: varid_hu = -1 integer, public :: varid_hv = -1 integer, public, allocatable :: we_ix0 (:) Parent x-index for west/east edge interpolation integer, public, allocatable :: we_iy0 (:) Lower parent y-index per child j real(kind=wp), public, allocatable :: we_wx (:) Parent x-weight for west/east edge real(kind=wp), public, allocatable :: we_wy (:) Parent y-weight per child j real(kind=wp), public :: wx_east = 0.0_wp real(kind=wp), public :: wx_west = 0.0_wp real(kind=wp), public :: wy_north = 0.0_wp real(kind=wp), public :: wy_south = 0.0_wp real(kind=wp), public :: x_origin = 0.0_wp Child grid x-origin in parent coordinates real(kind=wp), public :: y_origin = 0.0_wp Child grid y-origin in parent coordinates Source Code type :: nesting_t !! Container for parent domain data and interpolation state ! NetCDF file handle integer :: ncid = - 1 !! NetCDF file ID (kept open for lazy reads) logical :: active = . false . !! Whether nesting is enabled ! Parent grid coordinates integer :: p_nx = 0 !! Number of x-points in parent file integer :: p_ny = 0 !! Number of y-points in parent file integer :: p_nt = 0 !! Number of time steps in parent file real ( wp ), allocatable :: p_x (:) !! Parent x-coordinates (m) real ( wp ), allocatable :: p_y (:) !! Parent y-coordinates (m) real ( wp ), allocatable :: p_time (:) !! Parent time coordinates (s) ! Variable IDs integer :: varid_h = - 1 integer :: varid_hu = - 1 integer :: varid_hv = - 1 ! Two time-bracketing snapshots on parent grid integer :: idx_lo = 0 integer :: idx_hi = 0 real ( wp ), allocatable :: h_lo (:, :), h_hi (:, :) real ( wp ), allocatable :: hu_lo (:, :), hu_hi (:, :) real ( wp ), allocatable :: hv_lo (:, :), hv_hi (:, :) ! Child-to-parent coordinate offset real ( wp ) :: x_origin = 0.0_wp !! Child grid x-origin in parent coordinates real ( wp ) :: y_origin = 0.0_wp !! Child grid y-origin in parent coordinates ! Precomputed interpolation indices and weights for each boundary edge ! West/East edges: indexed by child j (1:ny_total) integer , allocatable :: we_ix0 (:) !! Parent x-index for west/east edge interpolation real ( wp ), allocatable :: we_wx (:) !! Parent x-weight for west/east edge integer , allocatable :: we_iy0 (:) !! Lower parent y-index per child j real ( wp ), allocatable :: we_wy (:) !! Parent y-weight per child j ! South/North edges: indexed by child i (1:nx_total) integer , allocatable :: sn_iy0 (:) !! Parent y-index for south/north edge interpolation real ( wp ), allocatable :: sn_wy (:) !! Parent y-weight for south/north edge integer , allocatable :: sn_ix0 (:) !! Lower parent x-index per child i real ( wp ), allocatable :: sn_wx (:) !! Parent x-weight per child i ! Parent x-indices for west and east edges integer :: ix_west = 1 real ( wp ) :: wx_west = 0.0_wp integer :: ix_east = 1 real ( wp ) :: wx_east = 0.0_wp ! Parent y-indices for south and north edges integer :: iy_south = 1 real ( wp ) :: wy_south = 0.0_wp integer :: iy_north = 1 real ( wp ) :: wy_north = 0.0_wp end type nesting_t","tags":"","url":"type/nesting_t.html"},{"title":"edge_t – Rakali ","text":"type, private :: edge_t Components Type Visibility Attributes Name Initial integer, public :: bc_type BC tag for this edge (bc%west / east / south / north) integer, public :: di_n outward step per ghost layer k integer, public :: di_t step along the edge per tangential index t integer, public :: dj_n outward step per ghost layer k integer, public :: dj_t step along the edge per tangential index t integer, public :: ig0 first ghost cell (k=1, t=1) integer, public :: jg0 first ghost cell (k=1, t=1) integer, public :: n_tan tangential extent (ny on W/E, nx on S/N) logical, public :: normal_is_u normal momentum is hu (W/E) vs hv (S/N) real(kind=wp), public :: nrm_sign +1 on high edges (E/N), -1 on low edges (W/S) Source Code type :: edge_t integer :: bc_type !! BC tag for this edge (bc%west / east / south / north) integer :: n_tan !! tangential extent (ny on W/E, nx on S/N) integer :: ig0 , jg0 !! first ghost cell (k=1, t=1) integer :: di_n , dj_n !! outward step per ghost layer k integer :: di_t , dj_t !! step along the edge per tangential index t real ( wp ) :: nrm_sign !! +1 on high edges (E/N), -1 on low edges (W/S) logical :: normal_is_u !! normal momentum is hu (W/E) vs hv (S/N) end type edge_t","tags":"","url":"type/edge_t.html"},{"title":"gauge_output_t – Rakali ","text":"type, public :: gauge_output_t Manages gauge point output to NetCDF time series Components Type Visibility Attributes Name Initial logical, public :: active = .false. Whether gauge output is enabled integer, public :: eta_varid = -1 Water surface elevation variable ID real(kind=wp), public, allocatable :: gauge_x (:) Gauge x-coordinates (metres, in global domain) real(kind=wp), public, allocatable :: gauge_y (:) Gauge y-coordinates (metres, in global domain) integer, public, allocatable :: ix0 (:) Lower-left cell i-index for each local gauge integer, public, allocatable :: iy0 (:) Lower-left cell j-index for each local gauge integer, public, allocatable :: local_idx (:) Maps local gauge index to global gauge index integer, public :: n_gauges = 0 Number of gauge points integer, public :: n_local = 0 Number of gauges inside the domain character(len=MAX_NAME_LEN), public, allocatable :: names (:) Gauge names integer, public :: ncid = -1 NetCDF file ID integer, public :: time_index = 0 Current time record index integer, public :: time_varid = -1 Time variable ID integer, public :: u_varid = -1 Depth-averaged u-velocity variable ID integer, public :: v_varid = -1 Depth-averaged v-velocity variable ID real(kind=wp), public, allocatable :: wx (:) x-interpolation weight (0-1) real(kind=wp), public, allocatable :: wy (:) y-interpolation weight (0-1) Source Code type :: gauge_output_t !! Manages gauge point output to NetCDF time series logical :: active = . false . !! Whether gauge output is enabled integer :: n_gauges = 0 !! Number of gauge points character ( len = MAX_NAME_LEN ), allocatable :: names (:) !! Gauge names real ( wp ), allocatable :: gauge_x (:) !! Gauge x-coordinates (metres, in global domain) real ( wp ), allocatable :: gauge_y (:) !! Gauge y-coordinates (metres, in global domain) ! Bilinear interpolation (cell indices and weights) integer , allocatable :: ix0 (:) !! Lower-left cell i-index for each local gauge integer , allocatable :: iy0 (:) !! Lower-left cell j-index for each local gauge real ( wp ), allocatable :: wx (:) !! x-interpolation weight (0-1) real ( wp ), allocatable :: wy (:) !! y-interpolation weight (0-1) ! Gauge subset (gauges that fall inside the domain) integer :: n_local = 0 !! Number of gauges inside the domain integer , allocatable :: local_idx (:) !! Maps local gauge index to global gauge index ! NetCDF output state integer :: ncid = - 1 !! NetCDF file ID integer :: time_varid = - 1 !! Time variable ID integer :: eta_varid = - 1 !! Water surface elevation variable ID integer :: u_varid = - 1 !! Depth-averaged u-velocity variable ID integer :: v_varid = - 1 !! Depth-averaged v-velocity variable ID integer :: time_index = 0 !! Current time record index end type gauge_output_t","tags":"","url":"type/gauge_output_t.html"},{"title":"forcing_t – Rakali ","text":"type, public :: forcing_t Container for atmospheric forcing data and interpolation state Components Type Visibility Attributes Name Initial logical, public :: active = .false. Whether forcing is enabled integer, public :: idx_hi = 0 Time index of the later snapshot (1-based) integer, public :: idx_lo = 0 Time index of the earlier snapshot (1-based) integer, public, allocatable :: ix0 (:,:) Lower-left forcing x-index for each model cell integer, public, allocatable :: iy0 (:,:) Lower-left forcing y-index for each model cell real(kind=wp), public, allocatable :: lat (:) Latitude coordinates (degrees or metres) real(kind=wp), public, allocatable :: lon (:) Longitude coordinates (degrees or metres) real(kind=wp), public, allocatable :: msl_hi (:,:) Atmospheric pressure (Pa) real(kind=wp), public, allocatable :: msl_lo (:,:) Atmospheric pressure (Pa) integer, public :: ncid = -1 NetCDF file ID (kept open for lazy reads) integer, public :: nlat = 0 Number of latitude points in forcing file integer, public :: nlon = 0 Number of longitude points in forcing file integer, public :: ntime = 0 Number of time steps in forcing file real(kind=wp), public, allocatable :: time (:) Time coordinates (seconds since reference) real(kind=wp), public, allocatable :: tp_hi (:,:) Precipitation rate (m/s) real(kind=wp), public, allocatable :: tp_lo (:,:) Precipitation rate (m/s) real(kind=wp), public, allocatable :: u10_hi (:,:) 10m wind x-component (m/s) real(kind=wp), public, allocatable :: u10_lo (:,:) 10m wind x-component (m/s) real(kind=wp), public, allocatable :: v10_hi (:,:) 10m wind y-component (m/s) real(kind=wp), public, allocatable :: v10_lo (:,:) 10m wind y-component (m/s) integer, public :: varid_msl = -1 integer, public :: varid_tp = -1 integer, public :: varid_u10 = -1 integer, public :: varid_v10 = -1 real(kind=wp), public, allocatable :: wx (:,:) x-direction weight (0-1) real(kind=wp), public, allocatable :: wy (:,:) y-direction weight (0-1) real(kind=wp), public :: x_origin = 0.0_wp Model grid x-origin (same units as forcing lon) real(kind=wp), public :: y_origin = 0.0_wp Model grid y-origin (same units as forcing lat) Source Code type :: forcing_t !! Container for atmospheric forcing data and interpolation state ! NetCDF file handle integer :: ncid = - 1 !! NetCDF file ID (kept open for lazy reads) logical :: active = . false . !! Whether forcing is enabled ! Forcing grid coordinates integer :: nlon = 0 !! Number of longitude points in forcing file integer :: nlat = 0 !! Number of latitude points in forcing file integer :: ntime = 0 !! Number of time steps in forcing file real ( wp ), allocatable :: lon (:) !! Longitude coordinates (degrees or metres) real ( wp ), allocatable :: lat (:) !! Latitude coordinates (degrees or metres) real ( wp ), allocatable :: time (:) !! Time coordinates (seconds since reference) ! Variable IDs (-1 = not present) integer :: varid_u10 = - 1 integer :: varid_v10 = - 1 integer :: varid_msl = - 1 integer :: varid_tp = - 1 ! Two time-bracketing snapshots on the forcing grid integer :: idx_lo = 0 !! Time index of the earlier snapshot (1-based) integer :: idx_hi = 0 !! Time index of the later snapshot (1-based) real ( wp ), allocatable :: u10_lo (:, :), u10_hi (:, :) !! 10m wind x-component (m/s) real ( wp ), allocatable :: v10_lo (:, :), v10_hi (:, :) !! 10m wind y-component (m/s) real ( wp ), allocatable :: msl_lo (:, :), msl_hi (:, :) !! Atmospheric pressure (Pa) real ( wp ), allocatable :: tp_lo (:, :), tp_hi (:, :) !! Precipitation rate (m/s) ! Precomputed bilinear interpolation indices and weights, per model cell integer , allocatable :: ix0 (:, :) !! Lower-left forcing x-index for each model cell integer , allocatable :: iy0 (:, :) !! Lower-left forcing y-index for each model cell real ( wp ), allocatable :: wx (:, :) !! x-direction weight (0-1) real ( wp ), allocatable :: wy (:, :) !! y-direction weight (0-1) ! Model grid origin (for coordinate mapping) real ( wp ) :: x_origin = 0.0_wp !! Model grid x-origin (same units as forcing lon) real ( wp ) :: y_origin = 0.0_wp !! Model grid y-origin (same units as forcing lat) end type forcing_t","tags":"","url":"type/forcing_t.html"},{"title":"multilayer_state_t – Rakali ","text":"type, public :: multilayer_state_t Per-layer prognostic arrays + multilayer scalar config. Inherits type~~multilayer_state_t~~InheritsGraph type~multilayer_s