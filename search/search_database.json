k real(kind=wp), private :: kapT (NZ_STACK_MAX) real(kind=wp), private :: kapT_k real(kind=wp), private :: nu_kpp real(kind=wp), private :: rS (NZ_STACK_MAX) real(kind=wp), private :: rT (NZ_STACK_MAX) real(kind=wp), private :: ri_num real(kind=wp), private :: s_top real(kind=wp), private :: sig real(kind=wp), private :: uk real(kind=wp), private :: ukp1 real(kind=wp), private :: us real(kind=wp), private :: vk real(kind=wp), private :: vkp1 real(kind=wp), private :: w_s real(kind=wp), private :: w_star real(kind=wp), private :: wstar3_val Source Code pure subroutine si_unstr_kpp_diffusion_tracers ( nz , nzp1 , nct , nco , h_layer , & hu_layer , hv_layer , hS_layer , & hT_layer , rho_layer , rho_0 , & nu_max , kappa_S_bg , kappa_T_bg , & ri_alpha , cs_nonlocal , heat_flux , & evap_minus_precip , cp , u_star , & buoy_flux , bl_depth , dt ) !! S/T vertical diffusion with the KPP overlay for the SI step: !! IMPLICIT (Thomas) column solve with the PP81-CUBIC interior !! diffusivity + the KPP shape-function overlay MAX'd in (same !! overlay as momentum; no dt clamp — implicit), then the LMD94 !! non-local counter-gradient transport applied as a conservative !! interface divergence AFTER the diffusion (the coastal explicit !! order: vdiff-then-nonlocal), reading the post-diffusion surface !! salinity for F_S.  gamma = 0 at bed and surface => the divergence !! conserves the column integral exactly.  Conserves column tracer !! content (no-flux tridiagonal). integer , intent ( in ) :: nz !! Number of layers. integer , intent ( in ) :: nzp1 !! nz + 1 (leading dim of interface arrays). integer , intent ( in ) :: nct !! Cell array extent (ncells_total). integer , intent ( in ) :: nco !! Owned-cell loop bound. real ( wp ), intent ( in ) :: h_layer ( nz , nct ) !! Layer thicknesses [m], bottom-up. real ( wp ), intent ( in ) :: hu_layer ( nz , nct ) !! Layer x-transports [m&#94;2/s] (shear for the PP81 Ri). real ( wp ), intent ( in ) :: hv_layer ( nz , nct ) !! Layer y-transports [m&#94;2/s]. real ( wp ), intent ( inout ) :: hS_layer ( nz , nct ) !! Salinity content [PSU m], updated in place. real ( wp ), intent ( inout ) :: hT_layer ( nz , nct ) !! Temperature content [degC m], updated in place. real ( wp ), intent ( in ) :: rho_layer ( nz , nct ) !! Layer densities [kg/m&#94;3]. real ( wp ), intent ( in ) :: rho_0 !! Reference density [kg/m&#94;3]. real ( wp ), intent ( in ) :: nu_max !! PP81 maximum turbulent diffusivity scale [m&#94;2/s]. real ( wp ), intent ( in ) :: kappa_S_bg !! Background salinity diffusivity [m&#94;2/s]. real ( wp ), intent ( in ) :: kappa_T_bg !! Background temperature diffusivity [m&#94;2/s]. real ( wp ), intent ( in ) :: ri_alpha !! PP81 Richardson tuning coefficient. real ( wp ), intent ( in ) :: cs_nonlocal !! Non-local transport coefficient C_s (LMD94 eq 20). real ( wp ), intent ( in ) :: heat_flux ( nct ) !! Surface heat flux [W/m&#94;2] (positive warms), per cell. real ( wp ), intent ( in ) :: evap_minus_precip ( nct ) !! Net evaporation [m/s], per cell. real ( wp ), intent ( in ) :: cp !! Specific heat of water [J/(kg K)]. real ( wp ), intent ( in ) :: u_star ( nct ) !! Surface friction velocity [m/s]. real ( wp ), intent ( in ) :: buoy_flux ( nct ) !! Surface buoyancy flux B_0 [m&#94;2/s&#94;3]; < 0 destabilizing. real ( wp ), intent ( in ) :: bl_depth ( nct ) !! Diagnosed boundary-layer depth [m]. real ( wp ), intent ( in ) :: dt !! Time step [s]. integer :: c , k real ( wp ) :: h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 real ( wp ) :: du , dv , drho , ri_num , denom_ri , kap real ( wp ) :: h_b , b_0 , us , wstar3_val , w_star , w_s real ( wp ) :: d_below , d_iface , sig , g_shape , nu_kpp real ( wp ) :: h_top , s_top , f_t_kin , f_s_kin , gamma_t , gamma_s real ( wp ) :: cd_val , cu_val , dz_dn , dz_up ! Per-site gfortran 15.1 gotcha: use separate locals for each write site ! inside do concurrent to avoid the \"local reassigned across if/else\" ! corruption bug. real ( wp ) :: kapS_k , kapT_k real ( wp ) :: kapS ( NZ_STACK_MAX ), kapT ( NZ_STACK_MAX ) real ( wp ) :: aa ( NZ_STACK_MAX ), bb ( NZ_STACK_MAX ), cc ( NZ_STACK_MAX ) real ( wp ) :: rS ( NZ_STACK_MAX ), rT ( NZ_STACK_MAX ), cpv ( NZ_STACK_MAX ) logical :: destabilizing if ( nz < 2 ) return do concurrent ( c = 1 : nco ) & local ( k , h_col , hk , hkp1 , h_avg , uk , ukp1 , vk , vkp1 , & du , dv , drho , ri_num , denom_ri , kap , & h_b , b_0 , us , wstar3_val , w_star , w_s , & d_below , d_iface , sig , g_shape , nu_kpp , & h_top , s_top , f_t_kin , f_s_kin , gamma_t , gamma_s , & cd_val , cu_val , dz_dn , dz_up , kapS_k , kapT_k , & kapS , kapT , aa , bb , cc , rS , rT , cpv , destabilizing ) h_col = 0.0_wp do k = 1 , nz h_col = h_col + h_layer ( k , c ) end do if ( h_col > ML_MIN_DEPTH_UNSTR ) then h_b = bl_depth ( c ) b_0 = buoy_flux ( c ) us = u_star ( c ) wstar3_val = max ( 0.0_wp , - b_0 ) * h_b w_star = wstar3_val ** ( 1.0_wp / 3.0_wp ) w_s = sqrt ( us * us + w_star * w_star ) destabilizing = ( b_0 < 0.0_wp ) ! ---- interface diffusivities: PP81 cubic + KPP overlay ---- ! kapS/kapT(m): interface m convention (1 = bed = 0 flux). kapS ( 1 ) = 0.0_wp kapT ( 1 ) = 0.0_wp kapS ( nz + 1 ) = 0.0_wp kapT ( nz + 1 ) = 0.0_wp d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) h_avg = 0.5_wp * ( hk + hkp1 ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED ) then uk = hu_layer ( k , c ) / hk ukp1 = hu_layer ( k + 1 , c ) / hkp1 vk = hv_layer ( k , c ) / hk vkp1 = hv_layer ( k + 1 , c ) / hkp1 du = ukp1 - uk dv = vkp1 - vk drho = rho_layer ( k , c ) - rho_layer ( k + 1 , c ) ri_num = GRAVITY * ( drho / rho_0 ) * h_avg / ( du * du + dv * dv + SHEAR2_EPS ) if ( ri_num < 0.0_wp ) ri_num = 0.0_wp denom_ri = 1.0_wp + ri_alpha * ri_num kap = nu_max / ( denom_ri * denom_ri * denom_ri ) nu_kpp = 0.0_wp if ( w_s > 0.0_wp . and . h_b > 0.0_wp . and . d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) nu_kpp = h_b * w_s * g_shape end if kapS_k = max ( kap + kappa_S_bg , nu_kpp ) kapT_k = max ( kap + kappa_T_bg , nu_kpp ) else kapS_k = 0.0_wp kapT_k = 0.0_wp end if kapS ( k + 1 ) = kapS_k kapT ( k + 1 ) = kapT_k end do ! ---- implicit (Thomas) diffusion of S concentration ---- do k = 1 , nz hk = h_layer ( k , c ) if ( hk > H_VANISHED ) then cd_val = 0.0_wp if ( k > 1 ) then if ( h_layer ( k - 1 , c ) > H_VANISHED ) then dz_dn = 0.5_wp * ( h_layer ( k - 1 , c ) + hk ) cd_val = dt / ( hk * dz_dn ) end if end if cu_val = 0.0_wp if ( k < nz ) then if ( h_layer ( k + 1 , c ) > H_VANISHED ) then dz_up = 0.5_wp * ( hk + h_layer ( k + 1 , c )) cu_val = dt / ( hk * dz_up ) end if end if aa ( k ) = - cd_val * kapS ( k ) cc ( k ) = - cu_val * kapS ( k + 1 ) bb ( k ) = 1.0_wp + cd_val * kapS ( k ) + cu_val * kapS ( k + 1 ) rS ( k ) = hS_layer ( k , c ) / hk else aa ( k ) = 0.0_wp cc ( k ) = 0.0_wp bb ( k ) = 1.0_wp if ( hk > 0.0_wp ) then rS ( k ) = hS_layer ( k , c ) / hk else rS ( k ) = 0.0_wp end if end if end do call si_unstr_tridiag_noflux ( aa , bb , cc , rS , cpv , nz ) do k = 1 , nz hS_layer ( k , c ) = rS ( k ) * h_layer ( k , c ) end do ! ---- implicit (Thomas) diffusion of T concentration ---- do k = 1 , nz hk = h_layer ( k , c ) if ( hk > H_VANISHED ) then cd_val = 0.0_wp if ( k > 1 ) then if ( h_layer ( k - 1 , c ) > H_VANISHED ) then dz_dn = 0.5_wp * ( h_layer ( k - 1 , c ) + hk ) cd_val = dt / ( hk * dz_dn ) end if end if cu_val = 0.0_wp if ( k < nz ) then if ( h_layer ( k + 1 , c ) > H_VANISHED ) then dz_up = 0.5_wp * ( hk + h_layer ( k + 1 , c )) cu_val = dt / ( hk * dz_up ) end if end if aa ( k ) = - cd_val * kapT ( k ) cc ( k ) = - cu_val * kapT ( k + 1 ) bb ( k ) = 1.0_wp + cd_val * kapT ( k ) + cu_val * kapT ( k + 1 ) rT ( k ) = hT_layer ( k , c ) / hk else aa ( k ) = 0.0_wp cc ( k ) = 0.0_wp bb ( k ) = 1.0_wp if ( hk > 0.0_wp ) then rT ( k ) = hT_layer ( k , c ) / hk else rT ( k ) = 0.0_wp end if end if end do call si_unstr_tridiag_noflux ( aa , bb , cc , rT , cpv , nz ) do k = 1 , nz hT_layer ( k , c ) = rT ( k ) * h_layer ( k , c ) end do ! ---- non-local counter-gradient transport (post-diffusion) ---- if ( destabilizing . and . w_s > 0.0_wp . and . h_b > 0.0_wp ) then h_top = h_layer ( nz , c ) if ( h_top > DRY_TOLERANCE ) then s_top = hS_layer ( nz , c ) / h_top else s_top = 0.0_wp end if f_t_kin = heat_flux ( c ) / ( rho_0 * cp ) f_s_kin = evap_minus_precip ( c ) * s_top d_below = 0.0_wp do k = 1 , nz - 1 hk = h_layer ( k , c ) hkp1 = h_layer ( k + 1 , c ) d_below = d_below + hk d_iface = h_col - d_below if ( hk > H_VANISHED . and . hkp1 > H_VANISHED . and . & d_iface < h_b ) then sig = d_iface / h_b g_shape = sig * ( 1.0_wp - sig ) * ( 1.0_wp - sig ) gamma_t = cs_nonlocal * g_shape * f_t_kin gamma_s = cs_nonlocal * g_shape * f_s_kin hT_layer ( k , c ) = hT_layer ( k , c ) + dt * gamma_t hT_layer ( k + 1 , c ) = hT_layer ( k + 1 , c ) - dt * gamma_t hS_layer ( k , c ) = hS_layer ( k , c ) + dt * gamma_s hS_layer ( k + 1 , c ) = hS_layer ( k + 1 , c ) - dt * gamma_s end if end do end if end if end do end subroutine si_unstr_kpp_diffusion_tracers","tags":"","url":"proc/si_unstr_kpp_diffusion_tracers.html"},{"title":"si_unstr_tridiag_noflux – Rakali","text":"private pure subroutine si_unstr_tridiag_noflux(a, b, c, rhs, cpv, n) In-place Thomas solve over rows 1..n with the boundary closure\nbaked into a/b/c by the caller (the no-flux tridiagonal closure). rhs returns the solution. Arguments Type Intent Optional Attributes Name real(kind=wp), intent(in) :: a (n) real(kind=wp), intent(in) :: b (n) real(kind=wp), intent(in) :: c (n) real(kind=wp), intent(inout) :: rhs (n) real(kind=wp), intent(inout) :: cpv (n) integer, intent(in) :: n Called by proc~~si_unstr_tridiag_noflux~~CalledByGraph proc~si_unstr_tridiag_noflux si_unstr_tridiag_noflux proc~si_unstr_kpp_diffusion_tracers si_unstr_kpp_diffusion_tracers proc~si_unstr_kpp_diffusion_tracers->proc~si_unstr_tridiag_noflux proc~si_unstr_step_ml si_unstr_step_m