lass ( multilayer_state_t ), intent ( inout ) :: this type ( barotropic_state_t ), intent ( in ) :: barotropic type ( hgrid_t ), intent ( in ) :: grid call this % build_vcoord_reference ( barotropic , grid ) call ml_init_layers_from_barotropic ( barotropic % h , barotropic % hu , barotropic % hv , & this % dsig_ml , this % h_layer , this % hu_layer , & this % hv_layer , grid , this % nz_ml ) end subroutine multilayer_init_layers","tags":"","url":"proc/multilayer_init_layers.html"},{"title":"multilayer_register_passive_tracer – Rakali","text":"private  subroutine multilayer_register_passive_tracer(this, grid, name, tr_init, tr_min, tr_max, kappa_bg, hdiff_kappa) Append a passive tracer (eos_coeff = 0) to the registry,\ngrowing tracers(:) past the default S/T pair.  Must be called\nAFTER init and BEFORE the solver’s enter_data (so the new hTr gets device-mapped) — enforced via registry_locked :\nonce the solver has mapped the registry the call logs an error\nand returns without touching it.  Caller populates hTr once\nlayer thicknesses are known.  S/T keep their indices. Type Bound multilayer_state_t Arguments Type Intent Optional Attributes Name class( multilayer_state_t ), intent(inout) :: this type( hgrid_t ), intent(in) :: grid character(len=*), intent(in) :: name real(kind=wp), intent(in) :: tr_init real(kind=wp), intent(in) :: tr_min real(kind=wp), intent(in) :: tr_max real(kind=wp), intent(in) :: kappa_bg real(kind=wp), intent(in) :: hdiff_kappa Calls proc~~multilayer_register_passive_tracer~~CallsGraph proc~multilayer_register_passive_tracer multilayer_state_t%multilayer_register_passive_tracer error error proc~multilayer_register_passive_tracer->error proc~tracer_init tracer_t%tracer_init proc~multilayer_register_passive_tracer->proc~tracer_init Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Called by proc~~multilayer_register_passive_tracer~~CalledByGraph proc~multilayer_register_passive_tracer multilayer_state_t%multilayer_register_passive_tracer proc~state_init_from_config state_t%state_init_from_config proc~state_init_from_config->proc~multilayer_register_passive_tracer proc~init_local_state init_local_state proc~init_local_state->proc~state_init_from_config proc~rki_create rki_create proc~rki_create->proc~state_init_from_config proc~rki_create_from_string rki_create_from_string proc~rki_create_from_string->proc~state_init_from_config proc~driver_run_coastal driver_run_coastal proc~driver_run_coastal->proc~init_local_state proc~rki_create_from_namelist rki_create_from_namelist proc~rki_create_from_namelist->proc~rki_create proc~rki_create_from_namelist_string rki_create_from_namelist_string proc~rki_create_from_namelist_string->proc~rki_create_from_string proc~driver_run driver_run proc~driver_run->proc~driver_run_coastal Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Variables Type Visibility Attributes Name Initial integer, private :: it integer, private :: n_old type( tracer_t ), private, allocatable :: tmp (:) Source Code subroutine multilayer_register_passive_tracer ( this , grid , name , tr_init , & tr_min , tr_max , kappa_bg , & hdiff_kappa ) !! Append a passive tracer (eos_coeff = 0) to the registry, !! growing `tracers(:)` past the default S/T pair.  Must be called !! AFTER `init` and BEFORE the solver's `enter_data` (so the new !! `hTr` gets device-mapped) — enforced via `registry_locked`: !! once the solver has mapped the registry the call logs an error !! and returns without touching it.  Caller populates `hTr` once !! layer thicknesses are known.  S/T keep their indices. class ( multilayer_state_t ), intent ( inout ) :: this type ( hgrid_t ), intent ( in ) :: grid character ( len =* ), intent ( in ) :: name real ( wp ), intent ( in ) :: tr_init , tr_min , tr_max , kappa_bg , hdiff_kappa type ( tracer_t ), allocatable :: tmp (:) integer :: n_old , it if ( this % registry_locked ) then call global_logger % error ( \"multilayer_state: register_passive_tracer(\" // & trim ( name ) // \") refused — registry locked by \" // & \"enter_data (growing the registry now would strand \" // & \"every existing tracer's device mapping on the \" // & \"mem:separate GPU build)\" ) return end if n_old = size ( this % tracers ) call move_alloc ( this % tracers , tmp ) allocate ( this % tracers ( n_old + 1 )) ! Deep-copy the existing tracers (intrinsic assignment reallocates ! the allocatable hTr / hTr0 components and copies their data). do it = 1 , n_old this % tracers ( it ) = tmp ( it ) end do it = n_old + 1 call this % tracers ( it )% init ( grid , this % nz_ml ) this % tracers ( it )% name = trim ( name ) this % tracers ( it )% long_name = trim ( name ) this % tracers ( it )% units = \"1\" this % tracers ( it )% standard_name = \"